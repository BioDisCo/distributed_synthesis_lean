import DistributedSynthesis.Formalizations.ComponentTrees.AlgorithmBlocks
import DistributedSynthesis.Formalizations.ComponentTrees.BlockAutomaton

/-! Exact connection to the library's physical executions. Block inputs
and outputs here are generated by the same one-round distributed strategy.
-/
namespace Characterisation.ComponentTrees
open DistributedSynthesis Characterisation Characterisation.PeriodicBlocks
noncomputable section
set_option maxHeartbeats 1800000
variable {H I₁ I₂ O₁ O₂ : Type} {D : Nat}
variable (σ : StrategyPair I₁ I₂ O₁ O₂) (env : EnvironmentSequence I₁ I₂)

private theorem scenario_execution_history (past : H → EnvHistory I₁ I₂)
    (h : H) (base : Nat) (root : past h = branchNode (environmentWord env) base) (n : Nat) :
    closingLayerHistory past n (continuationScenario h (fun k => EnvironmentRound.toProd (env (base+k))) n) =
      branchNode (environmentWord env) (base+n) := by
  rw [continuationScenario_history, root]
  have mapped : (branchNode (fun k => EnvironmentRound.toProd (env (base+k))) n).map
      (fun r => (⟨r.1,r.2.1,r.2.2,(),()⟩ : RoundRecord I₁ I₂ Graph Unit Unit)) =
      List.ofFn (fun i : Fin n => environmentWord env (base+i.val)) := by
    rw [branchNode_eq_ofFn, List.map_ofFn]
    rfl
  rw [mapped]
  exact prefix_append_segment (environmentWord env) base n

private theorem trace_execution (past : H → EnvHistory I₁ I₂)
    (h : H) (base : Nat) (root : past h = branchNode (environmentWord env) base)
    (n : Nat) (within : n ≤ D) :
    closingLayerTrace (strategyPolicy σ past) n within
      (continuationScenario h (fun k => EnvironmentRound.toProd (env (base+k))) n) =
        List.ofFn (fun i : Fin n => recordContinuationLetter (execution σ env (base+i.val))) := by
  induction n with
  | zero => simp only [closingLayerTrace, List.ofFn_zero]
  | succ n ih =>
    change closingLayerTrace (strategyPolicy σ past) n _
      (continuationScenario h (fun k => EnvironmentRound.toProd (env (base+k))) n) ++
      [(EnvironmentRound.toProd (env (base+n)), strategyPolicy σ past ⟨n, by omega⟩
        (continuationScenario h (fun k => EnvironmentRound.toProd (env (base+k))) (n+1)))] = _
    rw [ih (by omega), List.ofFn_succ']
    simp only [Fin.val_castSucc, Fin.val_last, List.concat_eq_append]
    apply congrArg (List.append (List.ofFn (fun i : Fin n => recordContinuationLetter (execution σ env (base+i.val)))))
    apply congrArg List.singleton
    rw [environmentWord_outputs]
    change (EnvironmentRound.toProd (env (base+n)),
      (σ.one (currentView .one (closingLayerHistory past (n+1) _)),
       σ.two (currentView .two (closingLayerHistory past (n+1) _)))) = _
    rw [scenario_execution_history env past h base root (n+1), Nat.add_assoc]
    rfl

theorem strategyBlock_execution (n : Nat) :
    strategyBlock σ (branchNode (environmentWord env) (n*D)) (eventBlock (environmentWord env) D n) =
      groupedWord (fun t => recordContinuationLetter (execution σ env t)) D n := by
  let past : Unit → EnvHistory I₁ I₂ := fun _ => branchNode (environmentWord env) (n*D)
  let scenario := continuationScenario () (fun k => EnvironmentRound.toProd (env (n*D+k))) D
  have same : scenario = wordScenario () (eventBlock (environmentWord env) D n) := by
    apply closingLayerHistory_injective past (fun _ _ _ => rfl) D
    rw [scenario_execution_history env past () (n*D) rfl D, wordScenario_history]
    exact (prefix_append_segment (environmentWord env) (n*D) D).symm
  apply Subtype.ext
  change closingLayerTrace (strategyPolicy σ past) D _ _ = _
  rw [← same]
  exact trace_execution σ env past () (n*D) rfl D (Nat.le_refl _)

/-- Every infinite sequence of complete blocks is an actual environment.
This prevents the equivalence from checking only a special class of runs. -/
theorem exists_environment_blocks (positive : 0 < D) (word : Nat → BlockInput I₁ I₂ D) :
    ∃ env : EnvironmentSequence I₁ I₂, eventBlock (environmentWord env) D = word := by
  let hist n := blockHistory (branchNode word n)
  have lengths n : List.length (hist n) = n*D := by
    rw [blockHistory_length, TreeNonemptiness.branch_length]
  obtain ⟨stream, exactHistory⟩ := exists_word_of_prefix_chain hist
    (fun i j lt => by dsimp only; rw [lengths, lengths]; exact Nat.mul_lt_mul_of_pos_right lt positive)
    (fun n => ⟨(word n).val, (blockHistory_append (branchNode word n) (word n)).symm⟩)
  have exactHist n : branchNode stream (n*D) = hist n := by
    rw [branchNode_eq_ofFn, ← lengths n]
    exact exactHistory n
  refine ⟨wordEnvironment stream, ?_⟩
  rw [environmentWord_wordEnvironment]
  funext n
  apply Subtype.ext
  apply List.append_cancel_left (as := branchNode stream (n*D))
  change branchNode stream (n*D) ++ List.ofFn (fun i : Fin D => stream (n*D+i.val)) = _
  rw [prefix_append_segment, show n*D+D = (n+1)*D by simp [Nat.add_mul], exactHist, exactHist]
  exact blockHistory_append (branchNode word n) (word n)

variable (B : DetParityAutomaton (BlockWord (ContinuationLetter I₁ I₂ O₁ O₂) D))
theorem strategyState_execution (n : Nat) :
    strategyState σ B (branchNode (eventBlock (environmentWord env) D) n) =
      B.run (groupedWord (fun t => recordContinuationLetter (execution σ env t)) D) n := by
  induction n with
  | zero => exact strategyState_nil σ B
  | succ n ih =>
    change strategyState σ B (_ ++ [_]) = _
    rw [strategyState_append, ih, eventBlock_history, strategyBlock_execution]
    rfl

end
end Characterisation.ComponentTrees
