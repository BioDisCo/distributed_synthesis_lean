import DistributedSynthesis.Formalizations.ComponentTrees.UncompressedEquivalence
import DistributedSynthesis.Formalizations.ComponentGames.Objective

/-! The combined automaton's language and finite-prefix liveness at the
original manuscript semantics, for all joint input/output words.
-/
namespace Characterisation.ComponentTrees
open DistributedSynthesis Characterisation Characterisation.PeriodicBlocks
noncomputable section

/-- The language part of `lem:tree-combined-automaton`, for every execution,
including executions not generated by any particular distributed algorithm. -/
theorem synthesisBlockAutomaton_language
    (A : Set (Nat → Graph)) (adversary : DetParityAutomaton Graph)
    (recognizes : ∀ word, word ∈ A ↔ adversary.Accepts word)
    (i : WithInputs.Instance) {D : Nat} (positive : 0 < D)
    (word : Nat → WithInputs.TupleLetter i) :
    (synthesisBlockAutomaton adversary i D).Accepts (groupedWord word D) ↔
      ((fun n => (word n).1.2.2) ∉ A ∨
        LTL.Satisfies (EncodedNoDirect.interp i)
          (OmegaWord.map continuationRecord word) (EncodedFiniteLTL.decode i.formula)) := by
  rw [synthesisBlockAutomaton, blockAutomaton_accepts _ _ _ positive,
    ComponentGames.A_phi_language, recognizes]

/-- The Q_live test at every finite block boundary, including the root. -/
theorem synthesisBlockAutomaton_live
    (A : Set (Nat → Graph)) (adversary : DetParityAutomaton Graph)
    (recognizes : ∀ word, word ∈ A ↔ adversary.Accepts word)
    (i : WithInputs.Instance) (D : Nat) (words : List (BlockWord (WithInputs.TupleLetter i) D)) :
    words.foldl (synthesisBlockAutomaton adversary i D).step (synthesisBlockAutomaton adversary i D).initial ∈
      blockLive (jointRecognizer (prefixRecognizer adversary))
        (WithInputs.guardedInstanceObjective adversary i) D ↔
      LivePrefix A (((words.map Subtype.val).flatten).map (fun a => a.1.2.2)) := by
  change _ ∈ (prefixRecognizer adversary).accept ↔ _
  unfold synthesisBlockAutomaton
  rw [(blockAutomaton_finite_states (jointRecognizer (prefixRecognizer adversary))
    (WithInputs.guardedInstanceObjective adversary i) D words).1, jointRecognizer_eval]
  exact (prefixRecognizer_correct adversary A recognizes _).symm

end
end Characterisation.ComponentTrees
