import DistributedSynthesis.Formalizations.ComponentGames.SimulationLocal
import DistributedSynthesis.Library.Distributed.LeaderPhases.ContinuationParity

/-! Exact block successors of distributed rules, and the copying step in
the reverse tree simulation. Reuses the existing policy and trace types.
-/

namespace Characterisation.ComponentTrees
open DistributedSynthesis Characterisation Characterisation.PeriodicBlocks
open Characterisation.ComponentGames.HistoryGame
set_option maxHeartbeats 1200000

variable {H K I₁ I₂ O₁ O₂ : Type} {D : Nat}

theorem closingLayerTrace_length (out : ClosingPolicy H I₁ I₂ O₁ O₂ D)
    (n : Nat) (within : n ≤ D) (s : ClosingLayer H I₁ I₂ n) :
    (closingLayerTrace out n within s).length = n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [closingLayerTrace, List.length_append, List.length_singleton, ih]

theorem closingLayerTrace_restrict (f : H → K) (out : ClosingPolicy K I₁ I₂ O₁ O₂ D)
    (n : Nat) (within : n ≤ D) (s : ClosingLayer H I₁ I₂ n) :
    closingLayerTrace (restrictClosingPolicy f out) n within s =
      closingLayerTrace out n within (mapClosingLayer f n s) := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [closingLayerTrace, mapClosingLayer, restrictClosingPolicy, ih]

/-- The complete joint input/output word generated by λ on an endpoint. -/
def ruleBlock (out : ClosingPolicy H I₁ I₂ O₁ O₂ D) (s : ClosingLayer H I₁ I₂ D) :
    BlockWord (ContinuationLetter I₁ I₂ O₁ O₂) D :=
  ⟨closingLayerTrace out D (Nat.le_refl _) s, closingLayerTrace_length out D (Nat.le_refl _) s⟩

/-- The manuscript's q_λ(h,u), for its BLOCK automaton B. -/
def blockSuccessor (B : DetParityAutomaton (BlockWord (ContinuationLetter I₁ I₂ O₁ O₂) D))
    (initial : H → B.State) (out : ClosingPolicy H I₁ I₂ O₁ O₂ D)
    (s : ClosingLayer H I₁ I₂ D) : B.State :=
  B.step (initial (closingLayerRoot D s)) (ruleBlock out s)

theorem blockSuccessor_restrict
    (B : DetParityAutomaton (BlockWord (ContinuationLetter I₁ I₂ O₁ O₂) D))
    (f : H → K) (initial : K → B.State) (out : ClosingPolicy K I₁ I₂ O₁ O₂ D)
    (s : ClosingLayer H I₁ I₂ D) :
    blockSuccessor B (initial ∘ f) (restrictClosingPolicy f out) s =
      blockSuccessor B initial out (mapClosingLayer f D s) := by
  unfold blockSuccessor
  rw [closingLayerRoot_map]
  congr 1
  apply Subtype.ext
  exact closingLayerTrace_restrict f out D (Nat.le_refl _) s

/-- Copying λ along a view-preserving simulation preserves distributedness
and the complete block successor, hence liveness and its recorded minimum.
No injectivity or view-reflection hypothesis is imposed on the simulation. -/
theorem copied_block_rule
    [Fintype I₁] [Fintype I₂] [DecidableEq I₁] [DecidableEq I₂]
    (past : H → EnvHistory I₁ I₂) (other : K → EnvHistory I₁ I₂)
    (f : H → K)
    (views : ∀ p h k, currentView p (past h) = currentView p (past k) →
      currentView p (other (f h)) = currentView p (other (f k)))
    (B : DetParityAutomaton (BlockWord (ContinuationLetter I₁ I₂ O₁ O₂) D))
    (old : H → B.State) (initial : K → B.State)
    (states : ∀ h, old h = initial (f h))
    (out : ClosingPolicy K I₁ I₂ O₁ O₂ D)
    (distributed : ClosingPolicyCoherent (extractInputShape other) out) :
    ClosingPolicyCoherent (extractInputShape past) (restrictClosingPolicy f out) ∧
      ∀ s : ClosingLayer H I₁ I₂ D,
        blockSuccessor B old (restrictClosingPolicy f out) s =
          blockSuccessor B initial out (mapClosingLayer f D s) := by
  refine ⟨simulation_rule_coherent past other f views out distributed, ?_⟩
  have eq : old = initial ∘ f := funext states
  rw [eq]
  exact blockSuccessor_restrict B f initial out

end Characterisation.ComponentTrees
