import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledOpenWitnessedPhysicalRoundAdapter

/-!
# Readback directly from a genuinely local finite physical controller

`FinitePairedPhysicalController` already has the exact executable locality
interface of the model, and `finiteEpochPhysicalLocalPresentation` proves its
local presentation definitionally.  This file packages the remaining finite
epoch data and exposes the missing one-arrow adapter to
`∃ M, M.ReadbackUpgrade A`.

The only model-facing residual is acceptance of the explicit global-machine
trace for every environment.  A stronger convenience route replaces that
obligation by pointwise output agreement with the supplied winning strategy.
No executable map added here accepts a graph, orientation, leader bit, hidden
shape, or semantic history: local maps remain exactly the six fields of
`FinitePairedPhysicalController`.
-/

namespace DistributedSynthesis

universe u v x y s w

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable [Fintype In₁] [Fintype In₂]
variable [Inhabited Out₁] [Inhabited Out₂]
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

noncomputable section

/-! ## One finite physical construction -/

/-- All finite data needed to turn a genuinely local physical controller
into the proof-side epoch machine.  The four auxiliary types are internal to
the package, so they may depend on the winning strategy used to construct a
witness while remaining in one fixed universe.

The proof-side query adapter may inspect its finite global coordinates.  It
is never exposed as a local transition; the only executable process maps are
those inside `controller`. -/
structure FiniteEpochPhysicalControllerReadbackData
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y) where
  Branch : Type w
  Bank : Type w
  Query : Type w
  Phase : Type w
  branchFinite : Fintype Branch
  bankFinite : Fintype Bank
  queryFinite : Fintype Query
  phaseFinite : Fintype Phase
  controller :
    FinitePairedPhysicalController.{u, v, x, y, w, w}
      In₁ In₂ Out₁ Out₂
  adapter :
    FiniteEpochQueryAdapter In₁ In₂ Branch Bank Query Phase controller
  initialBranch : Branch
  label : Branch → Option Bank
  branchStep : Branch → Query → Branch

namespace FiniteEpochPhysicalControllerReadbackData

variable
  (data :
    FiniteEpochPhysicalControllerReadbackData.{u, v, x, y, w}
      In₁ In₂ Out₁ Out₂)

/-- The finite global epoch machine generated by the packaged local
controller and proof-side adapter. -/
noncomputable def globalMachine :
    FiniteGlobalRoundMachine.{u, v, w} In₁ In₂ := by
  letI := data.branchFinite
  letI := data.bankFinite
  letI := data.queryFinite
  letI := data.phaseFinite
  exact finiteEpochPhysicalGlobalMachine data.controller data.adapter
    data.initialBranch data.label data.branchStep

/-- Process one's global Moore output is literally its local controller
output. -/
noncomputable def outputOne : data.globalMachine.State → Out₁ := by
  exact finiteEpochPhysicalOutputOne data.controller

/-- Process two's global Moore output is literally its local controller
output. -/
noncomputable def outputTwo : data.globalMachine.State → Out₂ := by
  exact finiteEpochPhysicalOutputTwo data.controller

/-- The packaged controller definitionally presents the global proof
machine by graph-blind local tables. -/
noncomputable def localPresentation :
    data.globalMachine.LocalPresentation data.outputOne data.outputTwo := by
  letI := data.branchFinite
  letI := data.bankFinite
  letI := data.queryFinite
  letI := data.phaseFinite
  simpa only [globalMachine, outputOne, outputTwo] using
    (finiteEpochPhysicalLocalPresentation data.controller data.adapter
      data.initialBranch data.label data.branchStep)

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- Reachable-belief output uniformity is a theorem, not an additional
construction hypothesis. -/
theorem reachableBeliefsUniform :
    data.globalMachine.ReachableBeliefsUniform data.outputOne data.outputTwo :=
  FiniteGlobalRoundMachine.LocalPresentation.reachableBeliefsUniform
    data.globalMachine data.outputOne data.outputTwo data.localPresentation

/-- The exact remaining trace obligation for this finite local controller. -/
def AllEnvironmentAcceptance : Prop :=
  ∀ env : EnvironmentSequence In₁ In₂,
    A.Accepts
      (data.globalMachine.globalMachineTraceWord data.outputOne data.outputTwo
        env)

/-- Stronger, often convenient residual: the explicit physical trace agrees
pointwise with the original distributed strategy. -/
def StrategyOutputAgreement
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂) : Prop :=
  data.globalMachine.StrategyOutputAgreement data.outputOne data.outputTwo
    strategy

omit [Fintype In₁] [Fintype In₂] [Inhabited Out₁] [Inhabited Out₂] in
/-- Pointwise agreement transfers the original winning hypothesis to the
exact global-machine trace. -/
theorem allEnvironmentAcceptance_of_strategyOutputAgreement
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (hagrees : data.StrategyOutputAgreement strategy) :
    data.AllEnvironmentAcceptance A :=
  data.globalMachine.globalMachine_allEnvironment_of_strategyOutputAgreement
    data.outputOne data.outputTwo strategy hagrees A.Accepts hwin

end FiniteEpochPhysicalControllerReadbackData

/-! ## Strategy-indexed extraction and the final adapter -/

/-- For every supplied winning strategy, construct one genuinely local finite
physical controller whose explicit trace is accepting on every environment.
The concrete finite types and maps may depend on that strategy; their
universes are fixed once for the theorem. -/
def PerStrategyWinningFiniteEpochPhysicalController : Prop :=
  ∀ strategy : StrategyPair In₁ In₂ Out₁ Out₂,
    (∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)) →
      ∃ data :
        FiniteEpochPhysicalControllerReadbackData.{u, v, x, y, w}
          In₁ In₂ Out₁ Out₂,
        data.AllEnvironmentAcceptance A

/-- Stronger extraction interface in which acceptance is inherited from
pointwise agreement with the original winning strategy. -/
def PerStrategyWinningFiniteEpochPhysicalControllerAgreement : Prop :=
  ∀ strategy : StrategyPair In₁ In₂ Out₁ Out₂,
    (∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)) →
      ∃ data :
        FiniteEpochPhysicalControllerReadbackData.{u, v, x, y, w}
          In₁ In₂ Out₁ Out₂,
        data.StrategyOutputAgreement strategy

omit [Fintype In₁] [Fintype In₂] [Inhabited Out₁] [Inhabited Out₂] in
/-- The agreement interface supplies the direct trace-acceptance interface. -/
theorem perStrategyWinningFiniteEpochPhysicalController_of_agreement
    (hextract :
      PerStrategyWinningFiniteEpochPhysicalControllerAgreement.{u, v, x, y,
        s, w} A) :
    PerStrategyWinningFiniteEpochPhysicalController.{u, v, x, y,
      s, w} A := by
  intro strategy hwin
  obtain ⟨data, hagrees⟩ := hextract strategy hwin
  exact ⟨data,
    data.allEnvironmentAcceptance_of_strategyOutputAgreement A strategy hwin
      hagrees⟩

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- A strategy-indexed finite local physical controller package supplies the
generic finite-global belief-machine hypothesis.  Locality/uniformity is
discharged automatically; only the explicit trace acceptance field is used. -/
theorem perStrategyWinningFiniteGlobalBeliefMachine_of_finiteEpochController
    (fallback : LocalSummaryAutomaton.{u, v, w} In₁ In₂)
    (hextract :
      PerStrategyWinningFiniteEpochPhysicalController.{u, v, x, y,
        s, w} A) :
    PerStrategyWinningFiniteGlobalBeliefMachine A fallback := by
  intro strategy hwin
  obtain ⟨data, haccepts⟩ := hextract strategy hwin
  exact ⟨data.globalMachine, data.outputOne, data.outputTwo,
    data.reachableBeliefsUniform, haccepts⟩

/-- Smallest direct endpoint: genuinely local finite physical controllers
plus acceptance of their actual traces yield one finite summary automaton
with `ReadbackUpgrade`. -/
theorem exists_readbackUpgrade_of_finiteEpochPhysicalController
    (fallback : LocalSummaryAutomaton.{u, v, w} In₁ In₂)
    (hextract :
      PerStrategyWinningFiniteEpochPhysicalController.{u, v, x, y,
        s, w} A) :
    ∃ M : LocalSummaryAutomaton.{u, v, w} In₁ In₂,
      M.ReadbackUpgrade (Out₁ := Out₁) (Out₂ := Out₂) A := by
  exact exists_readbackUpgrade_of_finiteGlobalBeliefMachine A fallback
    (perStrategyWinningFiniteGlobalBeliefMachine_of_finiteEpochController A
      fallback hextract)

/-- Convenience endpoint when the construction proves pointwise agreement
with the original winning strategy instead of DPA acceptance separately. -/
theorem
    exists_readbackUpgrade_of_finiteEpochPhysicalControllerAgreement
    (fallback : LocalSummaryAutomaton.{u, v, w} In₁ In₂)
    (hextract :
      PerStrategyWinningFiniteEpochPhysicalControllerAgreement.{u, v, x, y,
        s, w} A) :
    ∃ M : LocalSummaryAutomaton.{u, v, w} In₁ In₂,
      M.ReadbackUpgrade (Out₁ := Out₁) (Out₂ := Out₂) A := by
  exact exists_readbackUpgrade_of_finiteEpochPhysicalController A fallback
    (perStrategyWinningFiniteEpochPhysicalController_of_agreement A hextract)

end


end DetParityAutomaton

end DistributedSynthesis
