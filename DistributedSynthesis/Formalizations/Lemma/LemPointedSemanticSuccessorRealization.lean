import DistributedSynthesis.Formalizations.Lemma.LemPointedSupportedSuccessor

/-!
# Pointed relational successors from per-descriptor move realization

This file gives the reusable construction needed at the concrete pinned-table
seam.  A public move need not be the move independently re-extracted from one
chosen semantic representative.  Instead, `Realizes` may say that the literal
controller carried by that move has semantic provenance for a particular
current descriptor.  Validity asks for such a realization separately for
every live descriptor in the advertised family.

The resulting support relation is descriptor-pointed.  Its successor family
and target are read from the same realization witness, so the one-step
existence theorem does not require child-family functionality, equality of
independent rational choices, or a common child family for all current
members.  This is only a proof-side relation; operational reconstruction of
the current descriptor at a later full-view receive remains a separate model
invariant.
-/

namespace DistributedSynthesis

universe u v m b x y

section


variable {Code : Type u} {MoveIdentity : Type v}
variable (D : DetParityAutomaton.{u, x} Code)
variable {Move : Type m} {Direction : Type b} {Semantic : Type y}
variable [Fintype Code] [Fintype MoveIdentity]

abbrev PointedSemanticDescriptor :=
  HiddenCodeControlDescriptor D (MoveIdentity := MoveIdentity)

abbrev PointedSemanticFamily :=
  HiddenDescriptorTwoFibreFamily D (MoveIdentity := MoveIdentity)

/-- Semantic states whose finite descriptor and public family are exactly the
advertised pointed query. -/
def PointedSemanticLive
    (semanticDescriptor : Semantic → PointedSemanticDescriptor D
      (MoveIdentity := MoveIdentity))
    (familyOf : Semantic → PointedSemanticFamily D
      (MoveIdentity := MoveIdentity))
    (current : PointedSemanticDescriptor D (MoveIdentity := MoveIdentity))
    (family : PointedSemanticFamily D (MoveIdentity := MoveIdentity)) : Prop :=
  ∃ state, semanticDescriptor state = current ∧ familyOf state = family

/-- A move is valid at a family when its literal controller realizes every
live descriptor in that family.  The witnessing semantic states may differ
between descriptors; no representative is selected once and for all. -/
def PointedSemanticMoveValid
    (semanticDescriptor : Semantic → PointedSemanticDescriptor D
      (MoveIdentity := MoveIdentity))
    (familyOf : Semantic → PointedSemanticFamily D
      (MoveIdentity := MoveIdentity))
    (Realizes : PointedSemanticDescriptor D (MoveIdentity := MoveIdentity) →
      PointedSemanticFamily D (MoveIdentity := MoveIdentity) →
      Move → Semantic → Prop)
    (family : PointedSemanticFamily D (MoveIdentity := MoveIdentity))
    (move : Move) : Prop :=
  ∀ current,
    PointedSemanticLive D semanticDescriptor familyOf current family →
    ∃ state, Realizes current family move state ∧
      semanticDescriptor state = current ∧ familyOf state = family

/-- The public child family advertised by one per-descriptor realization. -/
def PointedSemanticSupported
    (semanticStep : Semantic → Direction → Semantic)
    (semanticDescriptor : Semantic → PointedSemanticDescriptor D
      (MoveIdentity := MoveIdentity))
    (familyOf : Semantic → PointedSemanticFamily D
      (MoveIdentity := MoveIdentity))
    (Realizes : PointedSemanticDescriptor D (MoveIdentity := MoveIdentity) →
      PointedSemanticFamily D (MoveIdentity := MoveIdentity) →
      Move → Semantic → Prop)
    (current : PointedSemanticDescriptor D (MoveIdentity := MoveIdentity))
    (currentFamily : PointedSemanticFamily D
      (MoveIdentity := MoveIdentity))
    (move : Move) (direction : Direction)
    (nextFamily : PointedSemanticFamily D
      (MoveIdentity := MoveIdentity)) : Prop :=
  ∃ state, Realizes current currentFamily move state ∧
    semanticDescriptor state = current ∧
    familyOf state = currentFamily ∧
    familyOf (semanticStep state direction) = nextFamily

/-- Exact target relation generated by the same kind of realization witness.
The support and exact witnesses need not be unique; coverage below chooses one
witness and uses it for both. -/
def PointedSemanticExactEdge
    (semanticStep : Semantic → Direction → Semantic)
    (semanticDescriptor : Semantic → PointedSemanticDescriptor D
      (MoveIdentity := MoveIdentity))
    (familyOf : Semantic → PointedSemanticFamily D
      (MoveIdentity := MoveIdentity))
    (Realizes : PointedSemanticDescriptor D (MoveIdentity := MoveIdentity) →
      PointedSemanticFamily D (MoveIdentity := MoveIdentity) →
      Move → Semantic → Prop)
    (current : PointedSemanticDescriptor D (MoveIdentity := MoveIdentity))
    (move : Move) (direction : Direction)
    (nextFamily : PointedSemanticFamily D
      (MoveIdentity := MoveIdentity))
    (target : PointedSemanticDescriptor D
      (MoveIdentity := MoveIdentity)) : Prop :=
  ∃ state currentFamily,
    Realizes current currentFamily move state ∧
    semanticDescriptor state = current ∧
    familyOf state = currentFamily ∧
    familyOf (semanticStep state direction) = nextFamily ∧
    semanticDescriptor (semanticStep state direction) = target

/-- Per-descriptor move realization supplies the complete pointed totality
interface.  The only semantic equation required is the literal DPA control
update on a semantic step. -/
def pointedSemanticFamilyTotality
    (semanticStep : Semantic → Direction → Semantic)
    (semanticDescriptor : Semantic → PointedSemanticDescriptor D
      (MoveIdentity := MoveIdentity))
    (familyOf : Semantic → PointedSemanticFamily D
      (MoveIdentity := MoveIdentity))
    (Realizes : PointedSemanticDescriptor D (MoveIdentity := MoveIdentity) →
      PointedSemanticFamily D (MoveIdentity := MoveIdentity) →
      Move → Semantic → Prop)
    (hcontrol : ∀ state direction,
      (semanticDescriptor (semanticStep state direction)).control =
        D.step (semanticDescriptor state).control
          (semanticDescriptor (semanticStep state direction)).code) :
    PointedHiddenDescriptorFamilyTotality D
      (PointedSemanticLive D semanticDescriptor familyOf)
      (PointedSemanticLive D semanticDescriptor familyOf)
      (PointedSemanticExactEdge D semanticStep semanticDescriptor familyOf
        Realizes)
      (PointedSemanticMoveValid D semanticDescriptor familyOf Realizes)
      (PointedSemanticSupported D semanticStep semanticDescriptor familyOf
        Realizes) where
  live_represented := fun _ _ hlive ↦ hlive
  supported_exists := by
    intro current currentFamily move direction hlive hvalid
    obtain ⟨state, hrealizes, hdescriptor, hfamily⟩ := hvalid current hlive
    exact ⟨familyOf (semanticStep state direction), state, hrealizes,
      hdescriptor, hfamily, rfl⟩
  target_live := by
    intro current currentFamily move direction nextFamily target _hlive _hvalid
      _hsupported hedge
    obtain ⟨state, _witnessFamily, _hrealizes, _hdescriptor, _hsourceFamily,
      hfamily, htarget⟩ := hedge
    exact ⟨semanticStep state direction, htarget, hfamily⟩
  covers := by
    intro current currentFamily move direction nextFamily _hlive _hvalid
      hsupported
    obtain ⟨state, hrealizes, hdescriptor, hsourceFamily, hfamily⟩ :=
      hsupported
    let target := semanticDescriptor (semanticStep state direction)
    refine ⟨target, ?_, ?_⟩
    · exact ⟨state, currentFamily, hrealizes, hdescriptor, hsourceFamily,
        hfamily, rfl⟩
    · simpa only [target, hdescriptor] using hcontrol state direction

/-- Direct one-arrow spelling of the result consumed by the finite pointed
selector. -/
theorem exists_pointedSemanticSupportedExactSuccessor
    (semanticStep : Semantic → Direction → Semantic)
    (semanticDescriptor : Semantic → PointedSemanticDescriptor D
      (MoveIdentity := MoveIdentity))
    (familyOf : Semantic → PointedSemanticFamily D
      (MoveIdentity := MoveIdentity))
    (Realizes : PointedSemanticDescriptor D (MoveIdentity := MoveIdentity) →
      PointedSemanticFamily D (MoveIdentity := MoveIdentity) →
      Move → Semantic → Prop)
    (hcontrol : ∀ state direction,
      (semanticDescriptor (semanticStep state direction)).control =
        D.step (semanticDescriptor state).control
          (semanticDescriptor (semanticStep state direction)).code)
    (current : PointedSemanticDescriptor D (MoveIdentity := MoveIdentity))
    (currentFamily : PointedSemanticFamily D
      (MoveIdentity := MoveIdentity))
    (move : Move) (direction : Direction)
    (hlive : PointedSemanticLive D semanticDescriptor familyOf current
      currentFamily)
    (hvalid : PointedSemanticMoveValid D semanticDescriptor familyOf Realizes
      currentFamily move) :
    ∃ nextFamily target,
      PointedSemanticSupported D semanticStep semanticDescriptor familyOf
          Realizes current
          currentFamily move direction nextFamily ∧
        PointedSemanticExactEdge D semanticStep semanticDescriptor familyOf
          Realizes current move direction nextFamily target ∧
        target.control = D.step current.control target.code := by
  let totality := pointedSemanticFamilyTotality D semanticStep
    semanticDescriptor familyOf Realizes hcontrol
  obtain ⟨nextFamily, hsupported⟩ := totality.supported_exists current
    currentFamily move direction hlive hvalid
  obtain ⟨target, hedge, hstep⟩ := totality.covers current currentFamily
    move direction nextFamily hlive hvalid hsupported
  exact ⟨nextFamily, target, hsupported, hedge, hstep⟩

end

end DistributedSynthesis
