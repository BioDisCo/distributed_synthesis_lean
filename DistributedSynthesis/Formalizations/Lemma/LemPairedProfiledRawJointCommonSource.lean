import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledRawJointRightSourceRealization
import DistributedSynthesis.Formalizations.Lemma.LemEntryThreadClass

/-!
# One literal common source for a raw joint fibre

The two marginal child-family constructions are not enough: a right family
and a left family must come from one joint semantic source before the single
input-free rationalization.  This file proves the missing one-step source
fact at the raw-strategy level.

For histories generated by one fixed distributed strategy, equality of both
current local views implies literal history equality.  The within-lane
equality patterns provide one of the two view equalities, while the shared
blind view provides the other.  `ExactFibreAt` supplies the two cross-lane
equalities at the selected pivots.  Consequently every selected row on both
sides is literally one common generated history.  No finite code is asked to
recover a lambda, and no rational basis is used.
-/

namespace DistributedSynthesis

universe i u v x y s

namespace DetParityAutomaton

variable {I : Type i}
variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

noncomputable section

variable [Fintype I]
variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]

/-! ## Generated row histories -/

section
omit [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂] [Fintype In₁]
    [Fintype In₂] [Fintype Out₁] [Fintype Out₂]

theorem profiledRawProcOneRowHistory_generated
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (entry : ProcOnePairedEntryRep strategy) (row : PairedEntryRow) :
    StrategyGeneratedPrefix strategy
      (profiledRawProcOneRowHistory entry row) := by
  cases row with
  | first => exact entry.leftGenerated
  | both => exact entry.bothGenerated

theorem profiledRawProcTwoRowHistory_generated
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (entry : ProcTwoPairedEntryRep strategy) (row : PairedEntryRow) :
    StrategyGeneratedPrefix strategy
      (profiledRawProcTwoRowHistory entry row) := by
  cases row with
  | first => exact entry.rightGenerated
  | both => exact entry.bothGenerated

/-- Under one fixed strategy, the pair of current views determines the
literal generated history, including its outputs. -/
theorem strategyGeneratedPrefix_eq_of_currentViews_eq
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    {left right : History In₁ In₂ Graph Out₁ Out₂}
    (hleft : StrategyGeneratedPrefix strategy left)
    (hright : StrategyGeneratedPrefix strategy right)
    (hone : currentView Proc.one left = currentView Proc.one right)
    (htwo : currentView Proc.two left = currentView Proc.two right) :
    left = right := by
  rcases jointViews_determine_inputGraphHistory left right hone htwo with
    ⟨hgraph, hinputOne, hinputTwo⟩
  exact strategyGeneratedPrefix_ext strategy hleft hright hgraph hinputOne
    hinputTwo

theorem profiledRawProcOneRowHistory_view_one_eq_left
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (entry : ProcOnePairedEntryRep strategy) (row : PairedEntryRow) :
    currentView Proc.one (profiledRawProcOneRowHistory entry row) =
      currentView Proc.one entry.leftHistory := by
  cases row with
  | first => rfl
  | both => exact entry.view_eq.symm

theorem profiledRawProcTwoRowHistory_view_two_eq_right
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (entry : ProcTwoPairedEntryRep strategy) (row : PairedEntryRow) :
    currentView Proc.two (profiledRawProcTwoRowHistory entry row) =
      currentView Proc.two entry.rightHistory := by
  cases row with
  | first => rfl
  | both => exact entry.view_eq.symm

end

/-! ## Each equality-pattern class has a literal source -/

omit [Fintype I] [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂] in
theorem ProfiledRawJointSemanticFamily.rightPattern_history_eq_pivot
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (family : ProfiledRawJointSemanticFamily A strategy (I := I))
    (direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂))
    (index : I) (member pivotMember : ProcOnePairedEntryRep strategy × A.State)
    (hmember : family.right index = some member)
    (hpivot : family.right direction.rightPivot.1 = some pivotMember)
    (row : PairedEntryRow)
    (hpattern :
      family.rightPattern A (index, row) direction.rightPivot = true) :
    profiledRawProcOneRowHistory member.1 row =
      profiledRawProcOneRowHistory pivotMember.1 direction.rightPivot.2 := by
  have hviewTwo :
      currentView Proc.two (profiledRawProcOneRowHistory member.1 row) =
        currentView Proc.two
          (profiledRawProcOneRowHistory pivotMember.1
            direction.rightPivot.2) := by
    simpa [ProfiledRawJointSemanticFamily.rightPattern, hmember, hpivot] using
      hpattern
  have hviewOne :
      currentView Proc.one (profiledRawProcOneRowHistory member.1 row) =
        currentView Proc.one
          (profiledRawProcOneRowHistory pivotMember.1
            direction.rightPivot.2) := by
    calc
      _ = currentView Proc.one member.1.leftHistory :=
        profiledRawProcOneRowHistory_view_one_eq_left member.1 row
      _ = currentView Proc.one pivotMember.1.leftHistory :=
        family.right_view_shared index direction.rightPivot.1 member pivotMember
          hmember hpivot
      _ = _ :=
        (profiledRawProcOneRowHistory_view_one_eq_left pivotMember.1
          direction.rightPivot.2).symm
  exact strategyGeneratedPrefix_eq_of_currentViews_eq strategy
    (profiledRawProcOneRowHistory_generated member.1 row)
    (profiledRawProcOneRowHistory_generated pivotMember.1
      direction.rightPivot.2) hviewOne hviewTwo

omit [Fintype I] [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂] in
theorem ProfiledRawJointSemanticFamily.leftPattern_history_eq_pivot
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (family : ProfiledRawJointSemanticFamily A strategy (I := I))
    (direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂))
    (index : I) (member pivotMember : ProcTwoPairedEntryRep strategy × A.State)
    (hmember : family.left index = some member)
    (hpivot : family.left direction.leftPivot.1 = some pivotMember)
    (row : PairedEntryRow)
    (hpattern :
      family.leftPattern A (index, row) direction.leftPivot = true) :
    profiledRawProcTwoRowHistory member.1 row =
      profiledRawProcTwoRowHistory pivotMember.1 direction.leftPivot.2 := by
  have hviewOne :
      currentView Proc.one (profiledRawProcTwoRowHistory member.1 row) =
        currentView Proc.one
          (profiledRawProcTwoRowHistory pivotMember.1
            direction.leftPivot.2) := by
    simpa [ProfiledRawJointSemanticFamily.leftPattern, hmember, hpivot] using
      hpattern
  have hviewTwo :
      currentView Proc.two (profiledRawProcTwoRowHistory member.1 row) =
        currentView Proc.two
          (profiledRawProcTwoRowHistory pivotMember.1
            direction.leftPivot.2) := by
    calc
      _ = currentView Proc.two member.1.rightHistory :=
        profiledRawProcTwoRowHistory_view_two_eq_right member.1 row
      _ = currentView Proc.two pivotMember.1.rightHistory :=
        family.left_view_shared index direction.leftPivot.1 member pivotMember
          hmember hpivot
      _ = _ :=
        (profiledRawProcTwoRowHistory_view_two_eq_right pivotMember.1
          direction.leftPivot.2).symm
  exact strategyGeneratedPrefix_eq_of_currentViews_eq strategy
    (profiledRawProcTwoRowHistory_generated member.1 row)
    (profiledRawProcTwoRowHistory_generated pivotMember.1
      direction.leftPivot.2) hviewOne hviewTwo

/-! ## The two pivots are one literal history -/

omit [Fintype I] [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂] in
theorem ProfiledRawJointSemanticFamily.pivotHistories_eq
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (family : ProfiledRawJointSemanticFamily A strategy (I := I))
    (direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂))
    (hexact : family.ExactFibreAt A direction)
    (rightPivotMember : ProcOnePairedEntryRep strategy × A.State)
    (leftPivotMember : ProcTwoPairedEntryRep strategy × A.State)
    (hright : family.right direction.rightPivot.1 = some rightPivotMember)
    (hleft : family.left direction.leftPivot.1 = some leftPivotMember) :
    profiledRawProcOneRowHistory rightPivotMember.1 direction.rightPivot.2 =
      profiledRawProcTwoRowHistory leftPivotMember.1 direction.leftPivot.2 := by
  have hviewOne :
      currentView Proc.one
          (profiledRawProcOneRowHistory rightPivotMember.1
            direction.rightPivot.2) =
        currentView Proc.one
          (profiledRawProcTwoRowHistory leftPivotMember.1
            direction.leftPivot.2) := by
    calc
      _ = currentView Proc.one rightPivotMember.1.leftHistory :=
        profiledRawProcOneRowHistory_view_one_eq_left rightPivotMember.1
          direction.rightPivot.2
      _ = _ := hexact.1 direction.rightPivot.1 rightPivotMember
        leftPivotMember hright hleft
  have hviewTwo :
      currentView Proc.two
          (profiledRawProcOneRowHistory rightPivotMember.1
            direction.rightPivot.2) =
        currentView Proc.two
          (profiledRawProcTwoRowHistory leftPivotMember.1
            direction.leftPivot.2) := by
    calc
      _ = currentView Proc.two leftPivotMember.1.rightHistory :=
        (hexact.2 direction.leftPivot.1 leftPivotMember rightPivotMember
          hleft hright).symm
      _ = _ :=
        (profiledRawProcTwoRowHistory_view_two_eq_right leftPivotMember.1
          direction.leftPivot.2).symm
  exact strategyGeneratedPrefix_eq_of_currentViews_eq strategy
    (profiledRawProcOneRowHistory_generated rightPivotMember.1
      direction.rightPivot.2)
    (profiledRawProcTwoRowHistory_generated leftPivotMember.1
      direction.leftPivot.2) hviewOne hviewTwo

/-! ## Belief-wide common-source package -/

/-- Every row retained by either pivot pattern is literally one generated
base history.  Empty and one-sided families are included, so this package can
be used in a total input-free transition with a sink completion. -/
structure ProfiledRawJointCommonSourceAt
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (family : ProfiledRawJointSemanticFamily A strategy (I := I))
    (direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂)) where
  base : History In₁ In₂ Graph Out₁ Out₂
  base_generated : StrategyGeneratedPrefix strategy base
  right_source : ∀ index member row,
    family.right index = some member →
      family.rightPattern A (index, row) direction.rightPivot = true →
      profiledRawProcOneRowHistory member.1 row = base
  left_source : ∀ index member row,
    family.left index = some member →
      family.leftPattern A (index, row) direction.leftPivot = true →
      profiledRawProcTwoRowHistory member.1 row = base

omit [Fintype I] [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂] in
/-- `ExactFibreAt` is strong enough to recover a literal shared source; no
extra shared-origin axiom is needed for this one reversal. -/
theorem ProfiledRawJointSemanticFamily.exists_commonSourceAt
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (family : ProfiledRawJointSemanticFamily A strategy (I := I))
    (direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂))
    (hexact : family.ExactFibreAt A direction) :
    Nonempty (ProfiledRawJointCommonSourceAt A family direction) := by
  classical
  cases hright : family.right direction.rightPivot.1 with
  | none =>
      cases hleft : family.left direction.leftPivot.1 with
      | none =>
          refine ⟨{
            base := []
            base_generated := StrategyGeneratedPrefix.empty
            right_source := ?_
            left_source := ?_ }⟩
          · intro index member row hmember hpattern
            simp [ProfiledRawJointSemanticFamily.rightPattern, hmember,
              hright] at hpattern
          · intro index member row hmember hpattern
            simp [ProfiledRawJointSemanticFamily.leftPattern, hmember,
              hleft] at hpattern
      | some leftPivotMember =>
          refine ⟨{
            base := profiledRawProcTwoRowHistory leftPivotMember.1
              direction.leftPivot.2
            base_generated := profiledRawProcTwoRowHistory_generated
              leftPivotMember.1 direction.leftPivot.2
            right_source := ?_
            left_source := ?_ }⟩
          · intro index member row hmember hpattern
            simp [ProfiledRawJointSemanticFamily.rightPattern, hmember,
              hright] at hpattern
          · intro index member row hmember hpattern
            exact family.leftPattern_history_eq_pivot A direction index member
              leftPivotMember hmember hleft row hpattern
  | some rightPivotMember =>
      cases hleft : family.left direction.leftPivot.1 with
      | none =>
          refine ⟨{
            base := profiledRawProcOneRowHistory rightPivotMember.1
              direction.rightPivot.2
            base_generated := profiledRawProcOneRowHistory_generated
              rightPivotMember.1 direction.rightPivot.2
            right_source := ?_
            left_source := ?_ }⟩
          · intro index member row hmember hpattern
            exact family.rightPattern_history_eq_pivot A direction index member
              rightPivotMember hmember hright row hpattern
          · intro index member row hmember hpattern
            simp [ProfiledRawJointSemanticFamily.leftPattern, hmember,
              hleft] at hpattern
      | some leftPivotMember =>
          have hpivots := family.pivotHistories_eq A direction hexact
            rightPivotMember leftPivotMember hright hleft
          refine ⟨{
            base := profiledRawProcOneRowHistory rightPivotMember.1
              direction.rightPivot.2
            base_generated := profiledRawProcOneRowHistory_generated
              rightPivotMember.1 direction.rightPivot.2
            right_source := ?_
            left_source := ?_ }⟩
          · intro index member row hmember hpattern
            exact family.rightPattern_history_eq_pivot A direction index member
              rightPivotMember hmember hright row hpattern
          · intro index member row hmember hpattern
            exact (family.leftPattern_history_eq_pivot A direction index member
              leftPivotMember hmember hleft row hpattern).trans hpivots.symm

end

end DetParityAutomaton

end DistributedSynthesis
