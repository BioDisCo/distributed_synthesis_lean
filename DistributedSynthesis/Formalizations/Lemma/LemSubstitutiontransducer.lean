import DistributedSynthesis.Formalizations.Lemma.LemAutomatonedgetypesubstitution

/-!
# Finite transducer form of one-round substitution
-/

namespace DistributedSynthesis

universe u v w z

/-- A fixed-length three-edge output block. -/
abbrev EdgeBlock3 (Edge : Type u) :=
  Edge × Edge × Edge

namespace EdgeBlock3

/-- Convert a three-edge block to the word emitted by the transducer. -/
def toList {Edge : Type u} (block : EdgeBlock3 Edge) : List Edge :=
  [block.1, block.2.1, block.2.2]

@[simp]
theorem length_toList {Edge : Type u} (block : EdgeBlock3 Edge) :
    block.toList.length = 3 := by
  simp [toList]

end EdgeBlock3

/--
A finite one-round substitution scheme.  For each old edge, a finite type of
choices enumerates the relation entries `(left label, three-edge block,
right label)`.
-/
structure FiniteSubstitutionScheme
    (OldEdge : Type u) (NewEdge : Type v) (Label : Type w) where
  Choice : OldEdge -> Type z
  choiceFinite : (old : OldEdge) -> Fintype (Choice old)
  left : (old : OldEdge) -> Choice old -> Label
  block : (old : OldEdge) -> Choice old -> EdgeBlock3 NewEdge
  right : (old : OldEdge) -> Choice old -> Label

attribute [instance] FiniteSubstitutionScheme.choiceFinite

/-- The relation generated by the finite choices of a substitution scheme. -/
def FiniteSubstitutionScheme.Relation
    {OldEdge : Type u} {NewEdge : Type v} {Label : Type w}
    (scheme : FiniteSubstitutionScheme OldEdge NewEdge Label)
    (old : OldEdge)
    (left : Label)
    (block : EdgeBlock3 NewEdge)
    (right : Label) :
    Prop :=
  ∃ choice : scheme.Choice old,
    scheme.left old choice = left ∧
      scheme.block old choice = block ∧
      scheme.right old choice = right

/--
Locally uniform substitution from a stored left boundary label to a final
right boundary label.  The same boundary label is threaded between adjacent
old edges.
-/
def FiniteSubstitutionScheme.LocalFrom
    {OldEdge : Type u} {NewEdge : Type v} {Label : Type w}
    (scheme : FiniteSubstitutionScheme OldEdge NewEdge Label) :
    Label -> List OldEdge -> List NewEdge -> Label -> Prop
  | left, [], output, right =>
      output = [] ∧ right = left
  | left, old :: restOld, output, right =>
      ∃ emitted restOutput mid choice,
        scheme.left old choice = left ∧
          emitted = (scheme.block old choice).toList ∧
          scheme.right old choice = mid ∧
          scheme.LocalFrom mid restOld restOutput right ∧
          output = emitted ++ restOutput

/-- The possible successor words produced by locally uniform substitutions. -/
def FiniteSubstitutionScheme.SuccessorWords
    {OldEdge : Type u} {NewEdge : Type v} {Label : Type w}
    (scheme : FiniteSubstitutionScheme OldEdge NewEdge Label)
    (oldPath : List OldEdge) :
    Set (List NewEdge) :=
  { output | ∃ left right, scheme.LocalFrom left oldPath output right }

/-- A finite-state transducer with list-valued edge outputs. -/
structure FiniteStateTransducer (Input : Type u) (Output : Type v) where
  State : Type w
  stateFinite : Fintype State
  initial : State -> Prop
  accept : State -> Prop
  step : State -> Input -> List Output -> State -> Prop

attribute [instance] FiniteStateTransducer.stateFinite

/-- A transducer path from one state to another over an input/output pair. -/
def FiniteStateTransducer.Path
    {Input : Type u} {Output : Type v}
    (T : FiniteStateTransducer Input Output) :
    T.State -> List Input -> List Output -> T.State -> Prop
  | state, [], output, final =>
      output = [] ∧ final = state
  | state, input :: restInput, output, final =>
      ∃ emitted restOutput mid,
        T.step state input emitted mid ∧
          T.Path mid restInput restOutput final ∧
          output = emitted ++ restOutput

/-- Language accepted by a finite-state transducer. -/
def FiniteStateTransducer.Accepts
    {Input : Type u} {Output : Type v}
    (T : FiniteStateTransducer Input Output)
    (input : List Input)
    (output : List Output) :
    Prop :=
  ∃ initial final,
    T.initial initial ∧
      T.accept final ∧
      T.Path initial input output final

/-- The finite-state transducer induced by a finite substitution scheme. -/
@[reducible]
def substitutionTransducer
    {OldEdge : Type u} {NewEdge : Type v} {Label : Type w}
    [Fintype Label]
    (scheme : FiniteSubstitutionScheme OldEdge NewEdge Label) :
    FiniteStateTransducer OldEdge NewEdge where
  State := Label
  stateFinite := inferInstance
  initial := fun _ => True
  accept := fun _ => True
  step := fun state old emitted next =>
    ∃ choice : scheme.Choice old,
      scheme.left old choice = state ∧
        emitted = (scheme.block old choice).toList ∧
        scheme.right old choice = next

/--
The transducer paths are exactly the locally uniform substitutions with the
same initial and final boundary labels.
-/
theorem substitutionTransducer_path_exact
    {OldEdge : Type u} {NewEdge : Type v} {Label : Type w}
    [Fintype Label]
    (scheme : FiniteSubstitutionScheme OldEdge NewEdge Label)
    (left : Label)
    (oldPath : List OldEdge)
    (output : List NewEdge)
    (right : Label) :
    (substitutionTransducer scheme).Path left oldPath output right ↔
      scheme.LocalFrom left oldPath output right := by
  induction oldPath generalizing left output right with
  | nil =>
      simp [FiniteStateTransducer.Path, FiniteSubstitutionScheme.LocalFrom]
  | cons old restOld ih =>
      constructor
      · intro h
        rcases h with ⟨emitted, restOutput, mid, hstep, hpath, houtput⟩
        rcases hstep with ⟨choice, hleft, hemitted, hright⟩
        exact
          ⟨emitted, restOutput, mid, choice, hleft, hemitted, hright,
            (ih mid restOutput right).mp hpath, houtput⟩
      · intro h
        rcases h with
          ⟨emitted, restOutput, mid, choice, hleft, hemitted, hright,
            hlocal, houtput⟩
        exact
          ⟨emitted, restOutput, mid,
            ⟨choice, hleft, hemitted, hright⟩,
            (ih mid restOutput right).mpr hlocal,
            houtput⟩

/--
Paper-facing theorem for `lem:substitutiontransducer`: the possible successor
type words of a finite one-round substitution scheme are exactly the image
recognized by the finite-state transducer that stores the current boundary
label.
-/
theorem finite_transducer_form_of_one_round_substitution
    {OldEdge : Type u} {NewEdge : Type v} {Label : Type w}
    [Fintype Label]
    (scheme : FiniteSubstitutionScheme OldEdge NewEdge Label)
    (oldPath : List OldEdge) :
    scheme.SuccessorWords oldPath =
      { output | (substitutionTransducer scheme).Accepts oldPath output } := by
  ext output
  constructor
  · intro h
    rcases h with ⟨left, right, hlocal⟩
    exact
      ⟨left, right, trivial, trivial,
        (substitutionTransducer_path_exact scheme left oldPath output right).mpr
          hlocal⟩
  · intro h
    rcases h with ⟨left, right, _hinitial, _haccept, hpath⟩
    exact
      ⟨left, right,
        (substitutionTransducer_path_exact scheme left oldPath output right).mp
          hpath⟩

end DistributedSynthesis
