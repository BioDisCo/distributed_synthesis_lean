import DistributedSynthesis.Formalizations.Lemma.LemSourceFreeBeliefCodeParityRationalization

/-!
# Acceptance of paths in a code-observable rational policy

A rational policy for `sourceFreeBeliefCodeParityRunAutomaton` already is an
accepting finite tree.  This file exposes the pathwise consequence needed by
finite candidate constructions: any sequence which starts at the policy root
and follows the policy successor for one direction at each step yields an
accepted word of successive belief codes.

The result is independent of semantic representatives.  In particular, a
candidate implementation may reselect proof-side representatives between
steps, provided its finite `(code, control)` coordinate follows this one
policy path.
-/

namespace DistributedSynthesis

universe u v w z

section

variable {Direction : Type u} {Move : Type v} {BeliefCode : Type z}
variable [Fintype BeliefCode]

variable
  (D : DetParityAutomaton.{z, w} BeliefCode)
  (initialCode : BeliefCode)
  (Valid : BeliefCode → Move → Prop)
  (next : BeliefCode → Move → Direction → BeliefCode)

private abbrev CodePolicy :=
  SourceFreeBeliefCodeParityRationalPolicy D initialCode Valid next

private abbrev CodePolicyState :=
  (sourceFreeBeliefCodeParityRunAutomaton D initialCode Valid next).State

/-- One coherent path through the finite code-observable rational policy. -/
structure SourceFreeBeliefCodeParityPolicyPath (policy : CodePolicy D
    initialCode Valid next) where
  state : Nat → CodePolicyState D initialCode Valid next
  direction : Nat → Direction
  initial : state 0 = policy.run []
  successor : ∀ n, state (n + 1) = policy.successor (state n) (direction n)

namespace SourceFreeBeliefCodeParityPolicyPath

variable (policy : CodePolicy D initialCode Valid next)

/-- The word read by the objective DPA consists of the positive-time policy
codes. -/
def childCodeWord
    (path : SourceFreeBeliefCodeParityPolicyPath D initialCode Valid next
      policy) : OmegaWord BeliefCode :=
  fun n ↦ (path.state (n + 1)).1

/-- The abstract path state is the literal rational-run state at the branch
node generated by its directions. -/
theorem state_eq_run
    (path : SourceFreeBeliefCodeParityPolicyPath D initialCode Valid next
      policy) : ∀ n,
    path.state n = policy.run (branchNode path.direction n) := by
  intro n
  induction n with
  | zero => exact path.initial
  | succ n ih =>
      rw [path.successor n, ih]
      exact policy.successor_at (branchNode path.direction n)
        (path.direction n)

/-- Every state on the path is reachable in the selected rational run. -/
theorem reachable
    (path : SourceFreeBeliefCodeParityPolicyPath D initialCode Valid next
      policy) (n : Nat) :
    SourceFreeBeliefCodeParityRationalPolicy.Reachable D initialCode Valid next
      policy (path.state n) :=
  ⟨branchNode path.direction n, (path.state_eq_run D initialCode Valid next
    policy n).symm⟩

/-- The stored control at depth `n` is the objective-DPA run after the first
`n` positive-time policy codes. -/
theorem control_eq_run
    (path : SourceFreeBeliefCodeParityPolicyPath D initialCode Valid next
      policy) : ∀ n,
    (path.state n).2 = D.run (path.childCodeWord D initialCode Valid next
      policy) n := by
  intro n
  induction n with
  | zero =>
      have hroot := policy.accepts.1.1
      rw [path.initial, hroot]
      rfl
  | succ n ih =>
      obtain ⟨move, _hvalid, hmove⟩ :=
        SourceFreeBeliefCodeParityRationalPolicy.exists_sourceFreeMove D
          initialCode Valid next policy (path.state n)
          (path.reachable D initialCode Valid next policy n)
      have hsuccessor := hmove (path.direction n)
      have hstate : path.state (n + 1) =
          (next (path.state n).1 move (path.direction n),
            D.step (path.state n).2
              (next (path.state n).1 move (path.direction n))) := by
        exact (path.successor n).trans hsuccessor
      rw [D.run_succ, ← ih]
      have hcode : (path.childCodeWord D initialCode Valid next policy n) =
          next (path.state n).1 move (path.direction n) := by
        change (path.state (n + 1)).1 = _
        exact congrArg Prod.fst hstate
      rw [hcode]
      exact congrArg Prod.snd hstate

/-- Every coherent finite-policy path produces an accepted child-code word.
This is the anti-mosaic acceptance theorem used by the repaired candidate
route. -/
theorem accepts
    (path : SourceFreeBeliefCodeParityPolicyPath D initialCode Valid next
      policy) :
    D.Accepts (path.childCodeWord D initialCode Valid next policy) := by
  rw [D.accepts_iff_natSeqMinEvenParity]
  have hpolicy := policy.accepts.2 path.direction
  convert hpolicy using 1
  funext n
  change D.priority
      (D.run (path.childCodeWord D initialCode Valid next policy) n) =
    D.priority (policy.run (branchNode path.direction n)).2
  rw [← path.control_eq_run D initialCode Valid next policy n,
    path.state_eq_run D initialCode Valid next policy n]

end SourceFreeBeliefCodeParityPolicyPath

end

end DistributedSynthesis
