/-!
# The exact full-view recovery boundary for semantic families

This file isolates the model fact which distinguishes the present full-view
architecture from a channel in which one bit can be lost forever.

At a receive, the receiver's literal view contains both previous full views
and the current input pair.  On histories generated by one fixed strategy,
equality of two such receive views therefore implies equality of the whole
previous history and of both current inputs.  Consequently *any* semantic
family which is a function of that settled data factors through the literal
receive view.  The current `left`/`both` (or `right`/`both`) choice is
deliberately absent: it is the one fresh ambiguity, not recovered old data.

The analogous statement for a finite query or local summary is not automatic.
It is equivalent to constancy on the query fibres, and one collision refutes
it.  This is the honest socket for the fixed pinned block query constructed in
`LemSemanticChildFamilyFactorization`: its `Fintype` instance alone supplies
no recovery theorem.

Finally, the existing operational receiver is audited at the exact seam.  On
a literal `View.recv`, its finite read always installs the family move carried
by the partner's delivered sender summary.  Thus the activation/install code
is not the remaining obstruction; the missing model invariant is precisely
that the delivered sender move is the supported semantic family.

No statement below exposes a graph, lane, orientation, family member, or
strict-leader bit to a process, and no statement treats a bounded hidden bit
as harmless.
-/

namespace DistributedSynthesis

universe u v x y f q o s

/-! ## Generated receive occurrences -/

/-- One generated round in which process one receives. -/
structure GeneratedReceiveOne
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂) where
  history : History In₁ In₂ Graph Out₁ Out₂
  environment : EnvironmentRound In₁ In₂
  generated : StrategyGeneratedPrefix strategy history
  receives : environment.graph = .left ∨ environment.graph = .both

/-- One generated round in which process two receives. -/
structure GeneratedReceiveTwo
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂) where
  history : History In₁ In₂ Graph Out₁ Out₂
  environment : EnvironmentRound In₁ In₂
  generated : StrategyGeneratedPrefix strategy history
  receives : environment.graph = .right ∨ environment.graph = .both

namespace GeneratedReceiveOne

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable {strategy : StrategyPair In₁ In₂ Out₁ Out₂}

/-- The literal full view seen by process one at this receive. -/
def view (occurrence : GeneratedReceiveOne strategy) : View In₁ In₂ .one :=
  currentView Proc.one
    (History.append occurrence.history
      (nextRound strategy occurrence.history occurrence.environment))

/-- Every actual execution round at which process one receives is a generated
receive occurrence. -/
def ofExecution (environment : EnvironmentSequence In₁ In₂) (n : Nat)
    (hreceive : (environment n).graph = .left ∨
      (environment n).graph = .both) : GeneratedReceiveOne strategy where
  history := executionPrefix strategy environment n
  environment := environment n
  generated := strategyGeneratedPrefix_executionPrefix strategy environment n
  receives := hreceive

/-- The occurrence view is literally the next actual execution view. -/
@[simp] theorem ofExecution_view
    (environment : EnvironmentSequence In₁ In₂) (n : Nat)
    (hreceive : (environment n).graph = .left ∨
      (environment n).graph = .both) :
    (ofExecution environment n hreceive : GeneratedReceiveOne strategy).view =
      currentView Proc.one (executionPrefix strategy environment (n + 1)) := by
  simp only [ofExecution, view, executionPrefix_succ]

/-- Equal literal receive views recover the complete settled history. -/
theorem history_eq_of_view_eq
    (left right : GeneratedReceiveOne strategy)
    (hview : left.view = right.view) :
    left.history = right.history := by
  exact
    (recv_view_determines_prefix_one strategy right.generated left.generated
      right.environment.inputOne left.environment.inputOne
      right.environment.inputTwo left.environment.inputTwo
      right.environment.graph left.environment.graph right.receives left.receives
      hview).1

/-- The same receive view also recovers process one's current input. -/
theorem inputOne_eq_of_view_eq
    (left right : GeneratedReceiveOne strategy)
    (hview : left.view = right.view) :
    left.environment.inputOne = right.environment.inputOne := by
  exact
    (recv_view_determines_prefix_one strategy right.generated left.generated
      right.environment.inputOne left.environment.inputOne
      right.environment.inputTwo left.environment.inputTwo
      right.environment.graph left.environment.graph right.receives left.receives
      hview).2.1

/-- The same receive view also recovers process two's current input. -/
theorem inputTwo_eq_of_view_eq
    (left right : GeneratedReceiveOne strategy)
    (hview : left.view = right.view) :
    left.environment.inputTwo = right.environment.inputTwo := by
  exact
    (recv_view_determines_prefix_one strategy right.generated left.generated
      right.environment.inputOne left.environment.inputOne
      right.environment.inputTwo left.environment.inputTwo
      right.environment.graph left.environment.graph right.receives left.receives
      hview).2.2

end GeneratedReceiveOne

namespace GeneratedReceiveTwo

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable {strategy : StrategyPair In₁ In₂ Out₁ Out₂}

/-- The literal full view seen by process two at this receive. -/
def view (occurrence : GeneratedReceiveTwo strategy) : View In₁ In₂ .two :=
  currentView Proc.two
    (History.append occurrence.history
      (nextRound strategy occurrence.history occurrence.environment))

/-- Every actual execution round at which process two receives is a generated
receive occurrence. -/
def ofExecution (environment : EnvironmentSequence In₁ In₂) (n : Nat)
    (hreceive : (environment n).graph = .right ∨
      (environment n).graph = .both) : GeneratedReceiveTwo strategy where
  history := executionPrefix strategy environment n
  environment := environment n
  generated := strategyGeneratedPrefix_executionPrefix strategy environment n
  receives := hreceive

@[simp] theorem ofExecution_view
    (environment : EnvironmentSequence In₁ In₂) (n : Nat)
    (hreceive : (environment n).graph = .right ∨
      (environment n).graph = .both) :
    (ofExecution environment n hreceive : GeneratedReceiveTwo strategy).view =
      currentView Proc.two (executionPrefix strategy environment (n + 1)) := by
  simp only [ofExecution, view, executionPrefix_succ]

/-- Equal literal receive views recover the complete settled history. -/
theorem history_eq_of_view_eq
    (left right : GeneratedReceiveTwo strategy)
    (hview : left.view = right.view) :
    left.history = right.history := by
