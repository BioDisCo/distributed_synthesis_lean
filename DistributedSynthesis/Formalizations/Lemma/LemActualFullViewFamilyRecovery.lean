    (recv_view_determines_prefix_two strategy right.generated left.generated
      right.environment.inputOne left.environment.inputOne
      right.environment.inputTwo left.environment.inputTwo
      right.environment.graph left.environment.graph right.receives left.receives
      hview).1

theorem inputOne_eq_of_view_eq
    (left right : GeneratedReceiveTwo strategy)
    (hview : left.view = right.view) :
    left.environment.inputOne = right.environment.inputOne := by
  exact
    (recv_view_determines_prefix_two strategy right.generated left.generated
      right.environment.inputOne left.environment.inputOne
      right.environment.inputTwo left.environment.inputTwo
      right.environment.graph left.environment.graph right.receives left.receives
      hview).2.1

theorem inputTwo_eq_of_view_eq
    (left right : GeneratedReceiveTwo strategy)
    (hview : left.view = right.view) :
    left.environment.inputTwo = right.environment.inputTwo := by
  exact
    (recv_view_determines_prefix_two strategy right.generated left.generated
      right.environment.inputOne left.environment.inputOne
      right.environment.inputTwo left.environment.inputTwo
      right.environment.graph left.environment.graph right.receives left.receives
      hview).2.2

end GeneratedReceiveTwo

/-! ## Exact factorization through a retained query -/

/-- A target is constant on every fibre of the retained query. -/
def QueryFibreConstant {Source : Type u} {Query : Type q} {Target : Type f}
    (query : Source → Query) (target : Source → Target) : Prop :=
  ∀ left right, query left = query right → target left = target right

/-- A partial decoder computes the target exactly on every represented query.
`Option` supplies the honest value on unrepresented query points without an
inhabitedness assumption on the target. -/
def QueryPartialFactorizes {Source : Type u} {Query : Type q} {Target : Type f}
    (query : Source → Query) (target : Source → Target) : Prop :=
  ∃ decode : Query → Option Target,
    ∀ source, decode (query source) = some (target source)

/-- Exact partial decoding is equivalent to fibre constancy. -/
theorem queryFibreConstant_iff_partialFactorizes
    {Source : Type u} {Query : Type q} {Target : Type f}
    (query : Source → Query) (target : Source → Target) :
    QueryFibreConstant query target ↔ QueryPartialFactorizes query target := by
  constructor
  · intro hconstant
    classical
    let decode : Query → Option Target := fun value =>
      if h : ∃ source, query source = value then
        some (target (Classical.choose h))
      else
        none
    refine ⟨decode, ?_⟩
    intro source
    let hwitness : ∃ candidate, query candidate = query source := ⟨source, rfl⟩
    simp only [decode]
    rw [dif_pos hwitness]
    congr 1
    exact hconstant (Classical.choose hwitness) source
      (Classical.choose_spec hwitness)
  · rintro ⟨decode, hdecode⟩ left right hquery
    apply Option.some.inj
    calc
      some (target left) = decode (query left) := (hdecode left).symm
      _ = decode (query right) := congrArg decode hquery
      _ = some (target right) := hdecode right

/-- Finite-query spelling.  This is the form consumed by a finite local
summary or by `ProfiledOpenHiddenDescriptorPairedPinnedBlockQueryTag`; the
finiteness hypothesis makes the decoder a finite table but does not prove
fibre constancy. -/
theorem finiteQueryFibreConstant_iff_partialFactorizes
    {Source : Type u} {Query : Type q} {Target : Type f} [Fintype Query]
    (query : Source → Query) (target : Source → Target) :
    QueryFibreConstant query target ↔ QueryPartialFactorizes query target :=
  queryFibreConstant_iff_partialFactorizes query target

/-- A same-query collision with different targets refutes every decoder. -/
theorem not_queryPartialFactorizes_of_collision
    {Source : Type u} {Query : Type q} {Target : Type f}
    (query : Source → Query) (target : Source → Target)
    (left right : Source) (hquery : query left = query right)
    (htarget : target left ≠ target right) :
    ¬ QueryPartialFactorizes query target := by
  intro hfactor
  exact htarget
    ((queryFibreConstant_iff_partialFactorizes query target).mpr hfactor
      left right hquery)

/-! ## Literal full-view recovery of settled semantic data

The public family alphabet used by the rational tree is one fixed finite
type.  The semantic value may depend on the settled history and both current
inputs, but not on the fresh graph ambiguity. -/

theorem generatedReceiveOne_fixedFamily_fullView_partialFactorizes
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {Family : Type f}
    (family : History In₁ In₂ Graph Out₁ Out₂ → In₁ → In₂ → Family) :
    QueryPartialFactorizes GeneratedReceiveOne.view
      (fun occurrence : GeneratedReceiveOne strategy =>
        family occurrence.history occurrence.environment.inputOne
          occurrence.environment.inputTwo) := by
  apply (queryFibreConstant_iff_partialFactorizes _ _).mp
  intro left right hview
  change
    family left.history left.environment.inputOne left.environment.inputTwo =
      family right.history right.environment.inputOne right.environment.inputTwo
  simp only [GeneratedReceiveOne.history_eq_of_view_eq left right hview,
    GeneratedReceiveOne.inputOne_eq_of_view_eq left right hview,
    GeneratedReceiveOne.inputTwo_eq_of_view_eq left right hview]

theorem generatedReceiveTwo_fixedFamily_fullView_partialFactorizes
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {Family : Type f}
    (family : History In₁ In₂ Graph Out₁ Out₂ → In₁ → In₂ → Family) :
    QueryPartialFactorizes GeneratedReceiveTwo.view
      (fun occurrence : GeneratedReceiveTwo strategy =>
        family occurrence.history occurrence.environment.inputOne
          occurrence.environment.inputTwo) := by
  apply (queryFibreConstant_iff_partialFactorizes _ _).mp
  intro left right hview
  change
    family left.history left.environment.inputOne left.environment.inputTwo =
      family right.history right.environment.inputOne right.environment.inputTwo
  simp only [GeneratedReceiveTwo.history_eq_of_view_eq left right hview,
    GeneratedReceiveTwo.inputOne_eq_of_view_eq left right hview,
    GeneratedReceiveTwo.inputTwo_eq_of_view_eq left right hview]

/-! ## The operational install seam -/

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

noncomputable section

variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁]
  [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
variable [DecidableEq In₁] [DecidableEq In₂]

open PairedStrategyMemory
open PairedStrategyMemory.PairedInitialProfiledRationalPackage

variable (package : PairedInitialProfiledRationalPackage A)

section
omit [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]

/-- On an actual process-one receive view, the finite read installs exactly
the left-family move carried by the partner's previous sender summary. -/
theorem endToEndFamilyReceipt_read_recv_one_receiverMove
    (initialOne : EndToEndFamilyReceiptOneSummary A package)
    (initialTwo : EndToEndFamilyReceiptTwoSummary A package)
    (previousOne : View In₁ In₂ .one) (inputOne : In₁)
    (previousTwo : View In₁ In₂ .two) (inputTwo : In₂) :
    let M := endToEndFamilyReceiptSummaryAutomaton A package initialOne initialTwo
      (endToEndFamilyReceiptSyncOrActivateReceivePairTable A package)
    (M.read (.recv previousOne (.inl inputOne) previousTwo (.inr inputTwo))).1.1.leftReceiver.2.1 =
      (M.read previousTwo).1.1.leftSender.1 := by
  dsimp only
  rw [LocalSummaryAutomaton.read_recv]
  exact endToEndFamilyFullRecvOneBankSyncOrActivate_receiverMove A package
    (endToEndFamilyReceiptSummaryAutomaton A package initialOne initialTwo
      (endToEndFamilyReceiptSyncOrActivateReceivePairTable A package) |>.read previousOne).1
    inputOne
    (endToEndFamilyReceiptSummaryAutomaton A package initialOne initialTwo
      (endToEndFamilyReceiptSyncOrActivateReceivePairTable A package) |>.read previousTwo).1
    inputTwo
    (endToEndFamilyReceiptSummaryAutomaton A package initialOne initialTwo
      (endToEndFamilyReceiptSyncOrActivateReceivePairTable A package) |>.read previousOne).2

/-- Process-two mirror. -/
theorem endToEndFamilyReceipt_read_recv_two_receiverMove
    (initialOne : EndToEndFamilyReceiptOneSummary A package)
    (initialTwo : EndToEndFamilyReceiptTwoSummary A package)
    (previousTwo : View In₁ In₂ .two) (inputTwo : In₂)
    (previousOne : View In₁ In₂ .one) (inputOne : In₁) :
    let M := endToEndFamilyReceiptSummaryAutomaton A package initialOne initialTwo
      (endToEndFamilyReceiptSyncOrActivateReceivePairTable A package)
    (M.read (.recv previousTwo (.inr inputTwo) previousOne (.inl inputOne))).1.1.rightReceiver.2.1 =
      (M.read previousOne).1.1.rightSender.1 := by
  dsimp only
  rw [LocalSummaryAutomaton.read_recv]
  exact endToEndFamilyFullRecvTwoBankSyncOrActivate_receiverMove A package
    (endToEndFamilyReceiptSummaryAutomaton A package initialOne initialTwo
      (endToEndFamilyReceiptSyncOrActivateReceivePairTable A package) |>.read previousTwo).1
    inputTwo
    (endToEndFamilyReceiptSummaryAutomaton A package initialOne initialTwo
      (endToEndFamilyReceiptSyncOrActivateReceivePairTable A package) |>.read previousOne).1
    inputOne
    (endToEndFamilyReceiptSummaryAutomaton A package initialOne initialTwo
      (endToEndFamilyReceiptSyncOrActivateReceivePairTable A package) |>.read previousTwo).2

/-- Exact audit equation: the receive-installed left family is supported if
and only if the partner's delivered sender family is supported.  Hence no
additional semantic obligation is hidden inside activation. -/
theorem endToEndFamilyReceipt_read_recv_one_follows_supported_iff_carried
    (initialOne : EndToEndFamilyReceiptOneSummary A package)
    (initialTwo : EndToEndFamilyReceiptTwoSummary A package)
    (previousOne : View In₁ In₂ .one) (inputOne : In₁)
    (previousTwo : View In₁ In₂ .two) (inputTwo : In₂)
    (supported : EndToEndLeftFamilyPairMove A package) :
    let M := endToEndFamilyReceiptSummaryAutomaton A package initialOne initialTwo
      (endToEndFamilyReceiptSyncOrActivateReceivePairTable A package)
    (M.read (.recv previousOne (.inl inputOne) previousTwo (.inr inputTwo))).1.1.leftReceiver.2.1 =
        supported ↔
      (M.read previousTwo).1.1.leftSender.1 = supported := by
  dsimp only
  rw [endToEndFamilyReceipt_read_recv_one_receiverMove A package]

/-- Right-family mirror. -/
theorem endToEndFamilyReceipt_read_recv_two_follows_supported_iff_carried
    (initialOne : EndToEndFamilyReceiptOneSummary A package)
    (initialTwo : EndToEndFamilyReceiptTwoSummary A package)
    (previousTwo : View In₁ In₂ .two) (inputTwo : In₂)
    (previousOne : View In₁ In₂ .one) (inputOne : In₁)
    (supported : EndToEndRightFamilyPairMove A package) :
    let M := endToEndFamilyReceiptSummaryAutomaton A package initialOne initialTwo
      (endToEndFamilyReceiptSyncOrActivateReceivePairTable A package)
    (M.read (.recv previousTwo (.inr inputTwo) previousOne (.inl inputOne))).1.1.rightReceiver.2.1 =
        supported ↔
      (M.read previousOne).1.1.rightSender.1 = supported := by
  dsimp only
  rw [endToEndFamilyReceipt_read_recv_two_receiverMove A package]

/-- Therefore supported-family installation reduces exactly to correctness of
the move carried by the delivered sender summary. -/
theorem endToEndFamilyReceipt_read_recv_one_follows_supported
    (initialOne : EndToEndFamilyReceiptOneSummary A package)
    (initialTwo : EndToEndFamilyReceiptTwoSummary A package)
    (previousOne : View In₁ In₂ .one) (inputOne : In₁)
    (previousTwo : View In₁ In₂ .two) (inputTwo : In₂)
    (supported : EndToEndLeftFamilyPairMove A package)
    (hcarried :
      let M := endToEndFamilyReceiptSummaryAutomaton A package initialOne initialTwo
        (endToEndFamilyReceiptSyncOrActivateReceivePairTable A package)
      (M.read previousTwo).1.1.leftSender.1 = supported) :
    let M := endToEndFamilyReceiptSummaryAutomaton A package initialOne initialTwo
      (endToEndFamilyReceiptSyncOrActivateReceivePairTable A package)
    (M.read (.recv previousOne (.inl inputOne) previousTwo (.inr inputTwo))).1.1.leftReceiver.2.1 =
      supported := by
  dsimp only at hcarried ⊢
  exact
    (endToEndFamilyReceipt_read_recv_one_receiverMove A package initialOne
      initialTwo previousOne inputOne previousTwo inputTwo).trans hcarried

theorem endToEndFamilyReceipt_read_recv_two_follows_supported
    (initialOne : EndToEndFamilyReceiptOneSummary A package)
    (initialTwo : EndToEndFamilyReceiptTwoSummary A package)
    (previousTwo : View In₁ In₂ .two) (inputTwo : In₂)
    (previousOne : View In₁ In₂ .one) (inputOne : In₁)
    (supported : EndToEndRightFamilyPairMove A package)
    (hcarried :
      let M := endToEndFamilyReceiptSummaryAutomaton A package initialOne initialTwo
        (endToEndFamilyReceiptSyncOrActivateReceivePairTable A package)
      (M.read previousOne).1.1.rightSender.1 = supported) :
    let M := endToEndFamilyReceiptSummaryAutomaton A package initialOne initialTwo
      (endToEndFamilyReceiptSyncOrActivateReceivePairTable A package)
    (M.read (.recv previousTwo (.inr inputTwo) previousOne (.inl inputOne))).1.1.rightReceiver.2.1 =
      supported := by
  dsimp only at hcarried ⊢
  exact
    (endToEndFamilyReceipt_read_recv_two_receiverMove A package initialOne
      initialTwo previousTwo inputTwo previousOne inputOne).trans hcarried

end

end

end DetParityAutomaton

/-! ## The honest no-later-receive alternative -/

/-- If process one does not receive, the graph is strictly right-oriented. -/
theorem graph_eq_right_of_not_receive_one (graph : Graph)
    (h : ¬ (graph = .left ∨ graph = .both)) : graph = .right := by
  cases graph <;> simp_all

/-- If process two does not receive, the graph is strictly left-oriented. -/
theorem graph_eq_left_of_not_receive_two (graph : Graph)
    (h : ¬ (graph = .right ∨ graph = .both)) : graph = .left := by
  cases graph <;> simp_all

/-- Either process one receives arbitrarily late, so old data is eventually
transferred in a literal full view, or the graph has an eventually fixed
strict-right suffix. -/
theorem frequently_receive_one_or_eventually_strict_right
    (graphs : Nat → Graph) :
    (∀ start, ∃ n, start ≤ n ∧
      (graphs n = .left ∨ graphs n = .both)) ∨
    (∃ start, ∀ n, start ≤ n → graphs n = .right) := by
  classical
  by_cases hfrequent :
      ∀ start, ∃ n, start ≤ n ∧
        (graphs n = .left ∨ graphs n = .both)
  · exact Or.inl hfrequent
  · right
    push Not at hfrequent
    obtain ⟨start, hstart⟩ := hfrequent
    refine ⟨start, fun n hn => graph_eq_right_of_not_receive_one (graphs n) ?_⟩
    exact fun hreceive => hreceive.elim (hstart n hn).1 (hstart n hn).2

/-- Process-two mirror. -/
theorem frequently_receive_two_or_eventually_strict_left
    (graphs : Nat → Graph) :
    (∀ start, ∃ n, start ≤ n ∧
      (graphs n = .right ∨ graphs n = .both)) ∨
    (∃ start, ∀ n, start ≤ n → graphs n = .left) := by
  classical
  by_cases hfrequent :
      ∀ start, ∃ n, start ≤ n ∧
        (graphs n = .right ∨ graphs n = .both)
  · exact Or.inl hfrequent
  · right
    push Not at hfrequent
    obtain ⟨start, hstart⟩ := hfrequent
    refine ⟨start, fun n hn => graph_eq_left_of_not_receive_two (graphs n) ?_⟩
    exact fun hreceive => hreceive.elim (hstart n hn).1 (hstart n hn).2

/-- Global recovery/fixed-hierarchy trichotomy.  Either both processes receive
arbitrarily late, so every piece of old information is transferred again in
literal full views, or the communication graph is eventually fixed in one
strict direction.  The alternatives are proof-side properties of the graph
sequence; no process is told which alternative holds. -/
theorem both_frequently_receive_or_eventually_strict
    (graphs : Nat → Graph) :
    ((∀ start, ∃ n, start ≤ n ∧
        (graphs n = .left ∨ graphs n = .both)) ∧
      (∀ start, ∃ n, start ≤ n ∧
        (graphs n = .right ∨ graphs n = .both))) ∨
    (∃ start, ∀ n, start ≤ n → graphs n = .right) ∨
    (∃ start, ∀ n, start ≤ n → graphs n = .left) := by
  rcases frequently_receive_one_or_eventually_strict_right graphs with
    hone | hright
  · rcases frequently_receive_two_or_eventually_strict_left graphs with
      htwo | hleft
    · exact Or.inl ⟨hone, htwo⟩
    · exact Or.inr (Or.inr hleft)
  · exact Or.inr (Or.inl hright)

/-- Consumption form of the global trichotomy.  To establish any property of
an execution, it is enough to prove it in the genuine recurring-recovery case
and in the two eventually fixed strict-hierarchy cases.  The case distinction
is entirely in the proof: this theorem does not give either process a test for
which alternative holds. -/
theorem of_both_frequently_receive_of_eventually_strict_right_of_eventually_strict_left
    (graphs : Nat → Graph) {P : Prop}
    (hrecovery :
      ((∀ start, ∃ n, start ≤ n ∧
          (graphs n = .left ∨ graphs n = .both)) ∧
        (∀ start, ∃ n, start ≤ n ∧
          (graphs n = .right ∨ graphs n = .both))) → P)
    (hright :
      (∃ start, ∀ n, start ≤ n → graphs n = .right) → P)
    (hleft :
      (∃ start, ∀ n, start ≤ n → graphs n = .left) → P) : P := by
  rcases both_frequently_receive_or_eventually_strict graphs with
    hrecovers | hstrict
  · exact hrecovery hrecovers
  · rcases hstrict with hright' | hleft'
    · exact hright hright'
    · exact hleft hleft'

end DistributedSynthesis
