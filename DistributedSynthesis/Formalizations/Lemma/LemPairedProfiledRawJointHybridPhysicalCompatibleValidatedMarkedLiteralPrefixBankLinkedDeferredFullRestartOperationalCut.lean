import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledRawJointHybridPhysicalCompatibleValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartController
import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledRawJointHybridPhysicalCompatibleValidatedMarkedLiteralPrefixBankOperationalSemanticCloseConstructor
import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledRawJointHybridPhysicalCompatibleValidatedMarkedLiteralPrefixBankAuthorityPath

/-!
# Operational cuts of the sender-and-receiver restart

This module connects the fully local restart controller to the generic
semantic-close adapter.  It is scoped to the re-rooted persistent strict
suffix after the final simultaneous round.  The first strict root and its
live one-sided lane are supplied by the front/mega handoff; subsequent roots
are generated by the alternating linked tables.

No executable transition receives a side, graph, hierarchy, or leader bit.
All sides below occur only in proof predicates indexed by the environment.
-/

namespace DistributedSynthesis

universe u v x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

noncomputable section

variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁]
  [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
variable [DecidableEq In₁] [DecidableEq In₂]

variable
  (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
  (hwin : ∀ env : EnvironmentSequence In₁ In₂,
    A.Accepts (execution strategy env))

private abbrev BankControl :=
  ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankControl A strategy hwin

private abbrev RetainedTag :=
  ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankRetainedTag A strategy
    hwin

private abbrev LinkedOne :=
  ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedRetainedOneControl
    A strategy hwin

private abbrev LinkedTwo :=
  ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedRetainedTwoControl
    A strategy hwin

private abbrev Payload :=
  ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPayload A
    strategy hwin

private abbrev OneControl :=
  FiniteAcknowledgedDelayedCarrier.DeferredOrRecurrent
    (LinkedOne A strategy hwin) (Payload A strategy hwin) PUnit.{1}

private abbrev TwoControl :=
  FiniteAcknowledgedDelayedCarrier.DeferredOrRecurrent
    (LinkedTwo A strategy hwin) (Payload A strategy hwin) PUnit.{1}

private abbrev BankReachable
    (state : BankControl A strategy hwin) :=
  ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankReachable A strategy
    hwin state

/-! ## Proof-only strict-root packages -/

/-- A reachable one-sided bank root whose right lane is live.  The incidence
code and slot are existential proof witnesses; neither is stored in, or
supplied to, the executable controller. -/
def
    ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartRightRootReady
    (state : BankControl A strategy hwin) : Prop :=
  ∃ code : ProfiledRawJointIncidenceCode A (I := Unit),
    ∃ slot : ProfiledRawRightSlot A,
      BankReachable A strategy hwin state ∧
        state.2.1.1 = .oneSided code ∧
          code.family.right () = some slot

/-- Left-lane mirror. -/
def
    ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartLeftRootReady
    (state : BankControl A strategy hwin) : Prop :=
  ∃ code : ProfiledRawJointIncidenceCode A (I := Unit),
    ∃ slot : ProfiledRawLeftSlot A,
      BankReachable A strategy hwin state ∧
        state.2.1.1 = .oneSided code ∧
          code.family.left () = some slot

/-- A proof-side live right root initializes the exact right linked pair at
the fresh restart relay, for arbitrary local anchor bits. -/
theorem
    ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartRightRootReady.restartPair
    {state : BankControl A strategy hwin}
    (hready :
      ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartRightRootReady
        A strategy hwin state)
    (rightAnchor leftAnchor : Bool) :
    let relay :=
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredRestartRelay
        A strategy hwin state rightAnchor leftAnchor
    ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedRightPairAtPrefix
      A strategy hwin state relay.1.1 relay.1.2 := by
  rcases hready with ⟨code, slot, hreachable, hcode, hlive⟩
  obtain ⟨oldMove, hmove, _hrebuild⟩ :=
    exists_profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedRightMove_of_liveLane
      A strategy hwin hreachable code hcode slot hlive
  exact
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredRestartRelay_rightPairAtPrefix
      A strategy hwin hreachable code hcode oldMove hmove rightAnchor
        leftAnchor

/-- Fresh left-pair mirror. -/
theorem
    ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartLeftRootReady.restartPair
    {state : BankControl A strategy hwin}
    (hready :
      ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartLeftRootReady
        A strategy hwin state)
    (rightAnchor leftAnchor : Bool) :
    let relay :=
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredRestartRelay
        A strategy hwin state rightAnchor leftAnchor
    ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedLeftPairAtPrefix
      A strategy hwin state relay.2.1 relay.2.2 := by
  rcases hready with ⟨code, slot, hreachable, hcode, hlive⟩
  obtain ⟨oldMove, hmove, _hrebuild⟩ :=
    exists_profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedLeftMove_of_liveLane
      A strategy hwin hreachable code hcode slot hlive
  exact
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredRestartRelay_leftPairAtPrefix
      A strategy hwin hreachable code hcode oldMove hmove rightAnchor
        leftAnchor

/-- An exact strict-right child of a live right root is a reachable
one-sided root with a live left lane.  This is the replace-not-accumulate
step used between consecutive reversal blocks. -/
theorem
    ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartRightRootReady.strictRightChild
    {state : BankControl A strategy hwin}
    (hready :
      ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartRightRootReady
        A strategy hwin state)
    (row : PairedEntryRow) (past : List (In₂ × In₁))
    (input : In₂ × In₁) :
    ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartLeftRootReady
      A strategy hwin
        (profiledRawJointHybridValidatedMarkedLiteralPrefixBankChildren A
          strategy hwin state
            (.strict
              (profiledRawJointUnitRightActualDirection
                (In₁ := In₁) (In₂ := In₂) row past input))) := by
  rcases hready with ⟨code, slot, hreachable, hcode, hlive⟩
  let packet :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankFiniteStep A strategy
      hwin state.1 state.2 hreachable
  obtain ⟨source, hsource, hsourceCode⟩ :=
    ProfiledRawJointHybridPhysicalCompatibleValidatedMarkedLiteralPrefixBankFiniteStep.source_oneSided_of_code
      A strategy hwin hreachable code hcode
  have hpacketMove : packet.move.1 = some (source.move A) := by
    rw [← packet.source_move, hsource]
    rfl
  have hvalid := source.move_valid_of_winning A hwin
  rw [hsourceCode] at hvalid
  rcases hvalid.2.2.2.1 () slot hlive with
    ⟨lambda, hlambda, _hprofile, _hforever⟩
  have hfunctional := hvalid.2.1 ((), row)
  have hcurrentSlot :
      profiledRawJointOneSidedCurrentSlots A .right (source.code A) () =
        some (.inl slot) := by
    simp [profiledRawJointOneSidedCurrentSlots, hsourceCode, hlive]
  have hreflexive :=
    source.rightPattern_self_of_currentSlot A (.inl slot) hcurrentSlot row
  rw [hsourceCode] at hreflexive
  let actual := profiledRawJointUnitRightActualDirection
    (In₁ := In₁) (In₂ := In₂) row past input
  let nextCode :=
    profiledRawJointOneSidedNext A code (source.move A) actual
  let child :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankChildren A strategy
      hwin state (.strict actual)
  have hpublic :
      (state.childCode A strategy hwin (.strict actual)).1 =
        .oneSided nextCode := by
    rw [
      ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankControl.childCode,
      ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankControl.move_eq_of_reachable
        A strategy hwin state hreachable,
      sourceFreeBeliefParentLinkedNext_fst]
    change
      profiledRawJointHybridNext A state.2.1.1 packet.move.1
          (.strict actual) =
        .oneSided nextCode
    rw [hcode, hpacketMove]
    rfl
  have hchildReachable : BankReachable A strategy hwin child :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankChildren_reachable A
      strategy hwin state hreachable (.strict actual)
  have hchildCode : child.2.1.1 = .oneSided nextCode := by
    have hfull :=
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankChildren_code A
        strategy hwin state hreachable (.strict actual)
    exact (congrArg Prod.fst hfull).trans hpublic
  have hliveNext :
      nextCode.family.left () =
        some (profiledRawRightChildSlot A slot lambda row past input) := by
    exact
      profiledRawJointOneSidedNext_unitRight_leftSlot A code (source.move A)
        row past input slot lambda hlive hlambda hfunctional hreflexive
  exact ⟨nextCode, profiledRawRightChildSlot A slot lambda row past input,
    hchildReachable, hchildCode, hliveNext⟩

/-- Strict-left mirror: its exact child exposes the next live right lane. -/
theorem
    ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartLeftRootReady.strictLeftChild
    {state : BankControl A strategy hwin}
    (hready :
      ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartLeftRootReady
        A strategy hwin state)
    (row : PairedEntryRow) (past : List (In₁ × In₂))
    (input : In₁ × In₂) :
    ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartRightRootReady
      A strategy hwin
        (profiledRawJointHybridValidatedMarkedLiteralPrefixBankChildren A
          strategy hwin state
            (.strict
              (profiledRawJointUnitLeftActualDirection
                (In₁ := In₁) (In₂ := In₂) row past input))) := by
  rcases hready with ⟨code, slot, hreachable, hcode, hlive⟩
  let packet :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankFiniteStep A strategy
      hwin state.1 state.2 hreachable
  obtain ⟨source, hsource, hsourceCode⟩ :=
    ProfiledRawJointHybridPhysicalCompatibleValidatedMarkedLiteralPrefixBankFiniteStep.source_oneSided_of_code
      A strategy hwin hreachable code hcode
  have hpacketMove : packet.move.1 = some (source.move A) := by
    rw [← packet.source_move, hsource]
    rfl
  have hvalid := source.move_valid_of_winning A hwin
  rw [hsourceCode] at hvalid
  rcases hvalid.2.2.2.2.2.1 () slot hlive with
    ⟨lambda, hlambda, _hprofile, _hforever⟩
  have hfunctional := hvalid.2.2.1 ((), row)
  have hcurrentSlot :
      profiledRawJointOneSidedCurrentSlots A .left (source.code A) () =
        some (.inr slot) := by
    simp [profiledRawJointOneSidedCurrentSlots, hsourceCode, hlive]
  have hreflexive :=
    source.leftPattern_self_of_currentSlot A (.inr slot) hcurrentSlot row
  rw [hsourceCode] at hreflexive
  let actual := profiledRawJointUnitLeftActualDirection
    (In₁ := In₁) (In₂ := In₂) row past input
  let nextCode :=
    profiledRawJointOneSidedNext A code (source.move A) actual
  let child :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankChildren A strategy
      hwin state (.strict actual)
  have hpublic :
      (state.childCode A strategy hwin (.strict actual)).1 =
        .oneSided nextCode := by
    rw [
      ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankControl.childCode,
      ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankControl.move_eq_of_reachable
        A strategy hwin state hreachable,
      sourceFreeBeliefParentLinkedNext_fst]
    change
      profiledRawJointHybridNext A state.2.1.1 packet.move.1
          (.strict actual) =
        .oneSided nextCode
    rw [hcode, hpacketMove]
    rfl
  have hchildReachable : BankReachable A strategy hwin child :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankChildren_reachable A
      strategy hwin state hreachable (.strict actual)
  have hchildCode : child.2.1.1 = .oneSided nextCode := by
    have hfull :=
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankChildren_code A
        strategy hwin state hreachable (.strict actual)
    exact (congrArg Prod.fst hfull).trans hpublic
  have hliveNext :
      nextCode.family.right () =
        some (profiledRawLeftChildSlot A slot lambda row past input) := by
    exact
      profiledRawJointOneSidedNext_unitLeft_rightSlot A code (source.move A)
        row past input slot lambda hlive hlambda hfunctional hreflexive
  exact ⟨nextCode, profiledRawLeftChildSlot A slot lambda row past input,
    hchildReachable, hchildCode, hliveNext⟩

/-! ## Authoritative bank trace -/

/-- The receive-normalized authoritative parent of the full-restart trace. -/
noncomputable def
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartParentAt
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) (n : Nat) :
    BankControl A strategy hwin :=
  let fallback :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
      A strategy hwin initialTag
  let pair :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSemanticPairAt
      A strategy hwin initialTag env n
  profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredParentOne
    A strategy hwin
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredSelectedOne
        A strategy hwin fallback.1 pair.1)
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredSelectedTwo
        A strategy hwin fallback.2 pair.2)

@[simp] theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartParentAt_zero
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) :
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartParentAt
      A strategy hwin initialTag env 0 = initialTag.1 := by
  rfl

private theorem fullRestartParent_strictRight
    (fallback : LinkedOne A strategy hwin × LinkedTwo A strategy hwin)
    (one : OneControl A strategy hwin) (inputOne : In₁)
    (two : TwoControl A strategy hwin) (inputTwo : In₂)
    (hpending :
      FiniteAcknowledgedDelayedCarrier.DeferredPairIsPending one two) :
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredParentOne
        A strategy hwin
        (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredSelectedOne
          A strategy hwin fallback.1
          (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartNoRecvOne
            A strategy hwin one inputOne).1)
        (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredSelectedTwo
          A strategy hwin fallback.2
          (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartOpenRecvTwo
            A strategy hwin fallback two inputTwo one inputOne).1) =
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartReceivedTwo
        A strategy hwin fallback two inputTwo one inputOne).child A strategy
          hwin := by
  cases one with
  | inr recurrent => exact False.elim hpending.1
  | inl onePending =>
      cases two with
      | inr recurrent => exact False.elim hpending.2
      | inl twoPending =>
          simp only [
            profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredParentOne,
            profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSelectedOne_noRecv_lastRecv,
            Bool.false_eq_true, ↓reduceIte]
          rfl

private theorem fullRestartParent_strictLeft
    (fallback : LinkedOne A strategy hwin × LinkedTwo A strategy hwin)
    (one : OneControl A strategy hwin) (inputOne : In₁)
    (two : TwoControl A strategy hwin) (inputTwo : In₂)
    (hpending :
      FiniteAcknowledgedDelayedCarrier.DeferredPairIsPending one two) :
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredParentOne
        A strategy hwin
        (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredSelectedOne
          A strategy hwin fallback.1
          (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartOpenRecvOne
            A strategy hwin fallback one inputOne two inputTwo).1)
        (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredSelectedTwo
          A strategy hwin fallback.2
          (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartNoRecvTwo
            A strategy hwin two inputTwo).1) =
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartReceivedOne
        A strategy hwin fallback one inputOne two inputTwo).child A strategy
          hwin := by
  cases one with
  | inr recurrent => exact False.elim hpending.1
  | inl onePending =>
      cases two with
      | inr recurrent => exact False.elim hpending.2
      | inl twoPending =>
          simp only [
            profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredParentOne,
            profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartSelectedOne_openRecv_lastRecv,
            ↓reduceIte]
          rfl

/-- A strict-right round installs precisely the receiver's payload child as
the next authoritative parent. -/
theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartParentAt_succ_of_right
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) (n : Nat)
    (hgraph : (env n).graph = .right) :
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartParentAt
        A strategy hwin initialTag env (n + 1) =
      let fallback :=
        profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
          A strategy hwin initialTag
      let pair :=
        profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSemanticPairAt
          A strategy hwin initialTag env n
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartReceivedTwo
        A strategy hwin fallback pair.2 (env n).inputTwo pair.1
          (env n).inputOne).child A strategy hwin := by
  let fallback :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
      A strategy hwin initialTag
  let pair :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSemanticPairAt
      A strategy hwin initialTag env n
  have hpending :=
    (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSemanticPairAt_invariant
      A strategy hwin initialTag env n).1
  rw [
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartParentAt,
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSemanticPairAt,
    FiniteAcknowledgedDelayedCarrier.exactClosingSemanticPairTrace,
    hgraph]
  exact fullRestartParent_strictRight A strategy hwin fallback pair.1
    (env n).inputOne pair.2 (env n).inputTwo hpending

/-- Strict-left mirror. -/
theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartParentAt_succ_of_left
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) (n : Nat)
    (hgraph : (env n).graph = .left) :
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartParentAt
        A strategy hwin initialTag env (n + 1) =
      let fallback :=
        profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
          A strategy hwin initialTag
      let pair :=
        profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSemanticPairAt
          A strategy hwin initialTag env n
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartReceivedOne
        A strategy hwin fallback pair.1 (env n).inputOne pair.2
          (env n).inputTwo).child A strategy hwin := by
  let fallback :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
      A strategy hwin initialTag
  let pair :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSemanticPairAt
      A strategy hwin initialTag env n
  have hpending :=
    (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSemanticPairAt_invariant
      A strategy hwin initialTag env n).1
  rw [
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartParentAt,
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSemanticPairAt,
    FiniteAcknowledgedDelayedCarrier.exactClosingSemanticPairTrace,
    hgraph]
  exact fullRestartParent_strictLeft A strategy hwin fallback pair.1
    (env n).inputOne pair.2 (env n).inputTwo hpending

/-! ## Receiver-selected bases and rooted pairs -/

noncomputable def
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartRightBaseAt
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) (n : Nat) :=
  profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRightBase
    A strategy hwin
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSelectedOneAt
        A strategy hwin initialTag env n)
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSelectedTwoAt
        A strategy hwin initialTag env n)

noncomputable def
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartLeftBaseAt
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) (n : Nat) :=
  profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartLeftBase
    A strategy hwin
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSelectedOneAt
        A strategy hwin initialTag env n)
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSelectedTwoAt
        A strategy hwin initialTag env n)

@[simp] theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartRightBaseAt_zero
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) :
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartRightBaseAt
        A strategy hwin initialTag env 0 =
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredRestartRelay
        A strategy hwin initialTag.1 false false := by
  rfl

@[simp] theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartLeftBaseAt_zero
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) :
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartLeftBaseAt
        A strategy hwin initialTag env 0 =
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredRestartRelay
        A strategy hwin initialTag.1 false false := by
  rfl

/-- After a left round, the next right base is a fresh relay at the
receive-normalized authoritative parent. -/
theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartRightBaseAt_succ_of_left
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) (n : Nat)
    (hgraph : (env n).graph = .left) :
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartRightBaseAt
        A strategy hwin initialTag env (n + 1) =
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredRestartRelay
        A strategy hwin
          (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartParentAt
            A strategy hwin initialTag env (n + 1)) false false := by
  have hbits :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSemanticPairAt_succ_selected_lastRecv
      A strategy hwin initialTag env n
  rw [hgraph] at hbits
  have hone :
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSelectedOneAt
        A strategy hwin initialTag env (n + 1)).2.1 = true := by
    simpa [
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSelectedOneAt,
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSelectedTwoAt]
      using hbits.1
  have htwo :
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSelectedTwoAt
        A strategy hwin initialTag env (n + 1)).2.1 = false := by
    simpa [
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSelectedOneAt,
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSelectedTwoAt]
      using hbits.2
  let one :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSelectedOneAt
      A strategy hwin initialTag env (n + 1)
  let two :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartSelectedTwoAt
      A strategy hwin initialTag env (n + 1)
  change one.2.1 = true at hone
  change two.2.1 = false at htwo
  change
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRightBase
        A strategy hwin one two =
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredRestartRelay
        A strategy hwin
          (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredParentOne
            A strategy hwin one two) false false
  simp [
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRightBase,
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredParentOne,
