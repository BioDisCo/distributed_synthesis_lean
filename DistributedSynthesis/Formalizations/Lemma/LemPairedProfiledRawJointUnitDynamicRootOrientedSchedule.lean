import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledRawJointFreshPolicyCanonicalPhysicalSchedule

/-!
# Dynamic-row root-oriented schedule for one fixed Unit policy

The fixed-policy close query needs the checker row at its current cut.  A
strict physical closing round installs the target's `.first` coordinate,
whereas a simultaneous closing round installs its `.both` coordinate.  Since
the next cut and the next semantic root also depend on the current query, the
three values `(cut, root, row)` must be generated by one structural recursion.

This file provides that recursion and its projected close schedule.  It is
proof-side bookkeeping only; no row, root, graph, or cut is exposed to either
local controller.
-/

namespace DistributedSynthesis

universe u v x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

noncomputable section

variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁]
  [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
variable [DecidableEq In₁] [DecidableEq In₂]

variable
  (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
  (initial : ProfiledRawJointOneSidedSemanticState A strategy (I := Unit))
  (policy : ProfiledRawJointOneSidedProvenanceRationalPolicy A strategy
    (initial.code A))
  (bank : ProfiledRawJointUnitPolicyControllerBank A strategy initial policy)

/-- Row installed by the physical closing graph immediately before `next`.
All root-oriented next cuts are positive, but the definition is total. -/
def profiledRawJointUnitPhysicalClosingRow
    (graphs : Nat → Graph) (next : Nat) : PairedEntryRow :=
  if graphs (next - 1) = .both then .both else .first

/-- Simultaneously generated cut, fixed-policy root, and checker row. -/
structure ProfiledRawJointUnitDynamicThreadState where
  cut : Nat
  root : ProfiledRawJointUnitFixedPolicyRoot A strategy (initial.code A) policy
  row : PairedEntryRow

/-- Canonical root-oriented recursion with the row selected from the literal
physical closing graph. -/
noncomputable def profiledRawJointUnitPolicyDynamicThreadState
    (physicalEnv : EnvironmentSequence In₁ In₂) (base : Nat)
    (hterm : OperationalStrictRunsTerminate
      (profiledRawJointPhysicalGraphTail physicalEnv base))
    (seed : ProfiledRawJointUnitFixedPolicyRoot A strategy (initial.code A)
      policy)
    (seedRow : PairedEntryRow) : Nat →
      ProfiledRawJointUnitDynamicThreadState A strategy initial policy
  | 0 => ⟨0, seed, seedRow⟩
  | k + 1 =>
      let current := profiledRawJointUnitPolicyDynamicThreadState physicalEnv
        base hterm seed seedRow k
      let graphs := profiledRawJointPhysicalGraphTail physicalEnv base
      let next := rootOrientedCloseNext graphs hterm
        (current.root.graph A strategy initial policy) current.cut
      let query := profiledRawJointUnitPolicyPhysicalCloseQuery A strategy
        initial policy physicalEnv (base + current.cut) (base + next)
          current.row current.root
      ⟨next, query.target A strategy initial policy bank,
        profiledRawJointUnitPhysicalClosingRow graphs next⟩

noncomputable def profiledRawJointUnitPolicyDynamicThreadCuts
    (physicalEnv : EnvironmentSequence In₁ In₂) (base : Nat)
    (hterm : OperationalStrictRunsTerminate
      (profiledRawJointPhysicalGraphTail physicalEnv base))
    (seed : ProfiledRawJointUnitFixedPolicyRoot A strategy (initial.code A)
      policy)
    (seedRow : PairedEntryRow) : Nat → Nat :=
  fun k ↦ (profiledRawJointUnitPolicyDynamicThreadState A strategy initial
    policy bank physicalEnv base hterm seed seedRow k).cut

noncomputable def profiledRawJointUnitPolicyDynamicThreadRoot
    (physicalEnv : EnvironmentSequence In₁ In₂) (base : Nat)
    (hterm : OperationalStrictRunsTerminate
      (profiledRawJointPhysicalGraphTail physicalEnv base))
    (seed : ProfiledRawJointUnitFixedPolicyRoot A strategy (initial.code A)
      policy)
    (seedRow : PairedEntryRow) (k : Nat) :=
  (profiledRawJointUnitPolicyDynamicThreadState A strategy initial policy bank
    physicalEnv base hterm seed seedRow k).root

noncomputable def profiledRawJointUnitPolicyDynamicThreadRow
    (physicalEnv : EnvironmentSequence In₁ In₂) (base : Nat)
    (hterm : OperationalStrictRunsTerminate
      (profiledRawJointPhysicalGraphTail physicalEnv base))
    (seed : ProfiledRawJointUnitFixedPolicyRoot A strategy (initial.code A)
      policy)
    (seedRow : PairedEntryRow) (k : Nat) : PairedEntryRow :=
  (profiledRawJointUnitPolicyDynamicThreadState A strategy initial policy bank
    physicalEnv base hterm seed seedRow k).row

/-- Projected dependent close schedule of the simultaneous recursion. -/
noncomputable def profiledRawJointUnitPolicyDynamicCloseSchedule
    (physicalEnv : EnvironmentSequence In₁ In₂) (base : Nat)
    (hterm : OperationalStrictRunsTerminate
      (profiledRawJointPhysicalGraphTail physicalEnv base))
    (seed : ProfiledRawJointUnitFixedPolicyRoot A strategy (initial.code A)
      policy)
    (seedRow : PairedEntryRow) :
    ProfiledRawJointUnitPolicyCloseSchedule A strategy initial policy :=
  fun k root ↦
    let current := profiledRawJointUnitPolicyDynamicThreadCuts A strategy
      initial policy bank physicalEnv base hterm seed seedRow k
    let next := rootOrientedCloseNext
      (profiledRawJointPhysicalGraphTail physicalEnv base) hterm
        (root.graph A strategy initial policy) current
    profiledRawJointUnitPolicyPhysicalCloseQuery A strategy initial policy
      physicalEnv (base + current) (base + next)
        (profiledRawJointUnitPolicyDynamicThreadRow A strategy initial policy
          bank physicalEnv base hterm seed seedRow k) root

/-- Scheduled roots are the root coordinates of the dynamic recursion. -/
theorem profiledRawJointUnitPolicyScheduledRoot_dynamicCloseSchedule
    (physicalEnv : EnvironmentSequence In₁ In₂) (base : Nat)
    (hterm : OperationalStrictRunsTerminate
      (profiledRawJointPhysicalGraphTail physicalEnv base))
    (seed : ProfiledRawJointUnitFixedPolicyRoot A strategy (initial.code A)
      policy)
    (seedRow : PairedEntryRow) : ∀ k : Nat,
    profiledRawJointUnitPolicyScheduledRoot A strategy initial policy bank seed
        (profiledRawJointUnitPolicyDynamicCloseSchedule A strategy initial
          policy bank physicalEnv base hterm seed seedRow) k =
      profiledRawJointUnitPolicyDynamicThreadRoot A strategy initial policy bank
        physicalEnv base hterm seed seedRow k := by
  intro k
  induction k with
  | zero => rfl
  | succ k ih =>
      rw [profiledRawJointUnitPolicyScheduledRoot_succ, ih]
      rfl

/-- Root-oriented cuts of the projected schedule are its cut coordinates. -/
theorem profiledRawJointUnitPolicyRootOrientedCuts_dynamicCloseSchedule
    (physicalEnv : EnvironmentSequence In₁ In₂) (base : Nat)
    (hterm : OperationalStrictRunsTerminate
      (profiledRawJointPhysicalGraphTail physicalEnv base))
    (seed : ProfiledRawJointUnitFixedPolicyRoot A strategy (initial.code A)
      policy)
    (seedRow : PairedEntryRow) : ∀ k : Nat,
    profiledRawJointUnitPolicyRootOrientedCuts A strategy initial policy bank
        physicalEnv base hterm seed
          (profiledRawJointUnitPolicyDynamicCloseSchedule A strategy initial
            policy bank physicalEnv base hterm seed seedRow) k =
      profiledRawJointUnitPolicyDynamicThreadCuts A strategy initial policy bank
        physicalEnv base hterm seed seedRow k := by
  intro k
  induction k with
  | zero => rfl
  | succ k ih =>
      change rootOrientedCloseNext
          (profiledRawJointPhysicalGraphTail physicalEnv base) hterm
            (profiledRawJointUnitPolicyScheduledGraph A strategy initial policy
              bank seed
                (profiledRawJointUnitPolicyDynamicCloseSchedule A strategy
                  initial policy bank physicalEnv base hterm seed seedRow) k)
            (profiledRawJointUnitPolicyRootOrientedCuts A strategy initial
              policy bank physicalEnv base hterm seed
                (profiledRawJointUnitPolicyDynamicCloseSchedule A strategy
                  initial policy bank physicalEnv base hterm seed seedRow) k) =
        profiledRawJointUnitPolicyDynamicThreadCuts A strategy initial policy
          bank physicalEnv base hterm seed seedRow (k + 1)
      rw [ih]
      unfold profiledRawJointUnitPolicyScheduledGraph
      rw [profiledRawJointUnitPolicyScheduledRoot_dynamicCloseSchedule]
      rfl

/-- Query input length is constructionally the dynamic root-oriented open
length. -/
theorem profiledRawJointUnitPolicyDynamicCloseSchedule_inputListLengthAt
    (physicalEnv : EnvironmentSequence In₁ In₂) (base : Nat)
    (hterm : OperationalStrictRunsTerminate
      (profiledRawJointPhysicalGraphTail physicalEnv base))
    (seed : ProfiledRawJointUnitFixedPolicyRoot A strategy (initial.code A)
      policy)
    (seedRow : PairedEntryRow) (k : Nat) :
    let schedule := profiledRawJointUnitPolicyDynamicCloseSchedule A strategy
      initial policy bank physicalEnv base hterm seed seedRow
    let query := schedule k
      (profiledRawJointUnitPolicyScheduledRoot A strategy initial policy bank
        seed schedule k)
    query.inputListLength A strategy initial policy =
      profiledRawJointUnitPolicyRootOrientedOpenLength A strategy initial
        policy bank physicalEnv base hterm seed schedule k := by
  dsimp only
  rw [profiledRawJointUnitPolicyScheduledRoot_dynamicCloseSchedule]
  simp only [profiledRawJointUnitPolicyDynamicCloseSchedule]
  rw [profiledRawJointUnitPolicyPhysicalCloseQuery_inputListLength]
  change base + rootOrientedCloseNext
          (profiledRawJointPhysicalGraphTail physicalEnv base) hterm
            ((profiledRawJointUnitPolicyDynamicThreadRoot A strategy initial
              policy bank physicalEnv base hterm seed seedRow k).graph A
                strategy initial policy)
            (profiledRawJointUnitPolicyDynamicThreadCuts A strategy initial
              policy bank physicalEnv base hterm seed seedRow k) -
        (base + profiledRawJointUnitPolicyDynamicThreadCuts A strategy initial
          policy bank physicalEnv base hterm seed seedRow k) - 1 =
      profiledRawJointUnitPolicyRootOrientedCuts A strategy initial policy bank
          physicalEnv base hterm seed
            (profiledRawJointUnitPolicyDynamicCloseSchedule A strategy initial
              policy bank physicalEnv base hterm seed seedRow) (k + 1) -
        profiledRawJointUnitPolicyRootOrientedCuts A strategy initial policy
          bank physicalEnv base hterm seed
            (profiledRawJointUnitPolicyDynamicCloseSchedule A strategy initial
              policy bank physicalEnv base hterm seed seedRow) k - 1
  rw [profiledRawJointUnitPolicyRootOrientedCuts_dynamicCloseSchedule,
    profiledRawJointUnitPolicyRootOrientedCuts_dynamicCloseSchedule]
  change base +
          profiledRawJointUnitPolicyDynamicThreadCuts A strategy initial policy
            bank physicalEnv base hterm seed seedRow (k + 1) -
        (base + profiledRawJointUnitPolicyDynamicThreadCuts A strategy initial
          policy bank physicalEnv base hterm seed seedRow k) - 1 =
      profiledRawJointUnitPolicyDynamicThreadCuts A strategy initial policy bank
          physicalEnv base hterm seed seedRow (k + 1) -
        profiledRawJointUnitPolicyDynamicThreadCuts A strategy initial policy
          bank physicalEnv base hterm seed seedRow k - 1
  omega

end

end DetParityAutomaton

end DistributedSynthesis
