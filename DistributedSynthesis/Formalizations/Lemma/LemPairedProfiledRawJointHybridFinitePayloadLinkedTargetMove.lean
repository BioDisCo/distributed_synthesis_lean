import DistributedSynthesis.Formalizations.Lemma.LemNarrowedReceiverOutputDecoration
import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledRawJointHybridPhysicalCompatibleLocalCarrier
import DistributedSynthesis.Formalizations.Lemma.LemRowExactIndexedTargetReceiverOutput

/-!
# Pre-narrowing finite-payload enrichment of raw-joint targets

This is the payload-polymorphic form of the linked-target construction.  A
semantic receiver is enriched *before* rational narrowing with

`(bare incidence target, (literal row, children actualDirection))`.

The enriched target remains finite for every finite `Payload`.  Erasing the
new coordinates recovers the original bare target and the physical receiver
output definitionally.  The row is retained by the receiver-output type, so
no narrowed table can confuse `.first` with `.both` merely because their bare
targets coincide.

Most importantly, the semantic target's payload is definitionally the value
of `children` at the concrete right/left raw direction generated by its row,
past, and current input.  Thus a later application can use a finite policy
successor as `Payload` without selecting an arbitrary representative after
narrowing.

No definition below receives a graph, hierarchy side, leader bit,
strict-leader bit, semantic source, local view, or outer policy state.
-/

namespace DistributedSynthesis

universe u v x y s p

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

noncomputable section

variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁]
  [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
variable [DecidableEq In₁] [DecidableEq In₂]

private abbrev HybridDirection :=
  ProfiledRawJointHybridDirection (In₁ := In₁) (In₂ := In₂)

/-! ## Generic finite target -/

/-- A bare public incidence target, its literal receiver row, and one
arbitrary finite payload selected before narrowing. -/
abbrev ProfiledRawJointHybridFinitePayloadLinkedTarget
    (Payload : Type p) :=
  ProfiledRawJointUnitTarget A × (PairedEntryRow × Payload)

noncomputable instance
    {Payload : Type p} [Fintype Payload] :
    Fintype (ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload) := by
  classical
  infer_instance

/-- Bare right-target projection; the row and payload are proof/controller
coordinates and do not alter the old physical target state. -/
def profiledRawJointHybridFinitePayloadLinkedRightTargetProjection
    {Payload : Type p}
    (target : ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload) :
    PairedProfiledTreeState A :=
  profiledRawJointUnitRightTargetProjection A target.1

/-- Left mirror. -/
def profiledRawJointHybridFinitePayloadLinkedLeftTargetProjection
    {Payload : Type p}
    (target : ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload) :
    PairedProfiledTreeState A :=
  profiledRawJointUnitLeftTargetProjection A target.1

def profiledRawJointHybridFinitePayloadLinkedTargetRow
    {Payload : Type p}
    (target : ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload) :
    PairedEntryRow :=
  target.2.1

def profiledRawJointHybridFinitePayloadLinkedTargetPayload
    {Payload : Type p}
    (target : ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload) :
    Payload :=
  target.2.2

/-! ## Right semantic enrichment -/

/-- Exact finite image of one enriched semantic right receiver. -/
def ProfiledRawJointRightFinitePayloadLinkedTargetAllowed
    {Payload : Type p}
    {Allowed : ProfiledRawJointUnitTarget A → Prop}
    {source : ProfiledRawRightSlot A}
    (activation : ProfiledRawJointTargetRightBlockActivation A
      (ProfiledRawJointUnitTarget A)
      (profiledRawJointUnitRightTargetProjection A) Allowed source)
    (children : HybridDirection (In₁ := In₁) (In₂ := In₂) → Payload)
    (target : ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload) :
    Prop :=
  ∃ row past input,
    target =
      (activation.target row past input,
        (row,
          children (.strict
            (profiledRawJointUnitRightActualDirection
              (In₁ := In₁) (In₂ := In₂) row past input))))

noncomputable instance
    {Payload : Type p}
    {Allowed : ProfiledRawJointUnitTarget A → Prop}
    {source : ProfiledRawRightSlot A}
    (activation : ProfiledRawJointTargetRightBlockActivation A
      (ProfiledRawJointUnitTarget A)
      (profiledRawJointUnitRightTargetProjection A) Allowed source)
    (children : HybridDirection (In₁ := In₁) (In₂ := In₂) → Payload) :
    DecidablePred
      (ProfiledRawJointRightFinitePayloadLinkedTargetAllowed A activation
        children) :=
  fun _ ↦ Classical.propDecidable _

/-- Attach the row and the actual-direction payload to an exact semantic
right activation before any finite-tree rationalization. -/
def ProfiledRawJointTargetRightBlockActivation.linkFinitePayload
    {Payload : Type p}
    {Allowed : ProfiledRawJointUnitTarget A → Prop}
    {source : ProfiledRawRightSlot A}
    (activation : ProfiledRawJointTargetRightBlockActivation A
      (ProfiledRawJointUnitTarget A)
      (profiledRawJointUnitRightTargetProjection A) Allowed source)
    (children : HybridDirection (In₁ := In₁) (In₂ := In₂) → Payload) :
    ProfiledRawJointTargetRightBlockActivation A
      (ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload)
      (profiledRawJointHybridFinitePayloadLinkedRightTargetProjection A)
      (ProfiledRawJointRightFinitePayloadLinkedTargetAllowed A activation
        children)
      source where
  lambda := activation.lambda
  initial_profile := activation.initial_profile
  forever := activation.forever
  target := fun row past input ↦
    (activation.target row past input,
      (row,
        children (.strict
          (profiledRawJointUnitRightActualDirection
            (In₁ := In₁) (In₂ := In₂) row past input))))
  target_allowed := fun row past input ↦ ⟨row, past, input, rfl⟩
  target_state := fun row past input ↦
    activation.target_state row past input

section
omit [Inhabited Out₁] [Inhabited Out₂] [Fintype In₁] [Fintype In₂] [Fintype Out₁]
    [Fintype Out₂] [DecidableEq In₁] [DecidableEq In₂]

