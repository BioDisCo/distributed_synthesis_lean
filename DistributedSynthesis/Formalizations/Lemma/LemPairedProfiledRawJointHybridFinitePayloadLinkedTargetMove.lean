theorem profiledRawJointHybridFinitePayloadRowExactLeftTarget_row
    {Payload : Type p}
    (output :
      ProfiledRawJointHybridFinitePayloadRowExactLeftReceiverOutput A Payload)
    (row : PairedEntryRow) :
    profiledRawJointHybridFinitePayloadLinkedTargetRow A
        (output.forgetRowProof.target row) = row :=
  output.target_index row

/-! ## Monitor transport for unconditional narrowing -/

noncomputable abbrev
    profiledRawJointHybridFinitePayloadRowExactRightBlockMonitor
    {Payload : Type p} [Fintype Payload]
    (Allowed :
      ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload → Prop)
    (source : ProfiledRawRightSlot A) :=
  (profiledRawJointTargetRightBlockMonitor A
    (ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload)
    (profiledRawJointHybridFinitePayloadLinkedRightTargetProjection A)
    Allowed source).comapReceiverOutput
      (profiledRawJointHybridFinitePayloadRowExactRightReceiverProjection A)

noncomputable abbrev
    profiledRawJointHybridFinitePayloadRowExactLeftBlockMonitor
    {Payload : Type p} [Fintype Payload]
    (Allowed :
      ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload → Prop)
    (source : ProfiledRawLeftSlot A) :=
