/-! ## Row-exact alphabets consumed by finite narrowing -/

abbrev ProfiledRawJointHybridFinitePayloadRowExactRightReceiverOutput
    (Payload : Type p) :=
  RowExactIndexedTargetReceiverOutput
    (PairedRightReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂))
    PairedEntryRow
    (ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload)
    (profiledRawJointHybridFinitePayloadLinkedTargetRow A)

abbrev ProfiledRawJointHybridFinitePayloadRowExactLeftReceiverOutput
    (Payload : Type p) :=
  RowExactIndexedTargetReceiverOutput
    (PairedLeftReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂))
    PairedEntryRow
    (ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload)
    (profiledRawJointHybridFinitePayloadLinkedTargetRow A)

def profiledRawJointHybridFinitePayloadRowExactRightReceiverProjection
    {Payload : Type p}
    (output :
      ProfiledRawJointHybridFinitePayloadRowExactRightReceiverOutput A
        Payload) :
    ProfiledRawJointTargetRightReceiverOutput
      (Out₁ := Out₁) (Out₂ := Out₂)
      (ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload) :=
  output.forgetRowProof

def profiledRawJointHybridFinitePayloadRowExactLeftReceiverProjection
    {Payload : Type p}
    (output :
      ProfiledRawJointHybridFinitePayloadRowExactLeftReceiverOutput A Payload) :
    ProfiledRawJointTargetLeftReceiverOutput
      (Out₁ := Out₁) (Out₂ := Out₂)
      (ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload) :=
  output.forgetRowProof

/-- Lift any enriched right activation into the row-subtyped alphabet. -/
def profiledRawJointHybridFinitePayloadRowExactRightReceiverStrategy
    {Payload : Type p}
    {Allowed :
      ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload → Prop}
    {source : ProfiledRawRightSlot A}
    (activation : ProfiledRawJointTargetRightBlockActivation A
      (ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload)
      (profiledRawJointHybridFinitePayloadLinkedRightTargetProjection A)
      Allowed source)
    (target_row : ∀ row past input,
      profiledRawJointHybridFinitePayloadLinkedTargetRow A
        (activation.target row past input) = row) :
    ReceiverBlockStrategy In₂ In₁
      (ProfiledRawJointHybridFinitePayloadRowExactRightReceiverOutput A
        Payload) :=
  fun past input ↦
    let output :=
      profiledRawJointTargetRightReceiverStrategy A activation past input
    RowExactIndexedTargetReceiverOutput.ofTarget output.physical output.target
      (fun row ↦ target_row row past input)

/-- Left mirror. -/
def profiledRawJointHybridFinitePayloadRowExactLeftReceiverStrategy
    {Payload : Type p}
    {Allowed :
      ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload → Prop}
    {source : ProfiledRawLeftSlot A}
    (activation : ProfiledRawJointTargetLeftBlockActivation A
      (ProfiledRawJointHybridFinitePayloadLinkedTarget A Payload)
      (profiledRawJointHybridFinitePayloadLinkedLeftTargetProjection A)
      Allowed source)
    (target_row : ∀ row past input,
      profiledRawJointHybridFinitePayloadLinkedTargetRow A
        (activation.target row past input) = row) :
    ReceiverBlockStrategy In₁ In₂
      (ProfiledRawJointHybridFinitePayloadRowExactLeftReceiverOutput A
        Payload) :=
  fun past input ↦
    let output :=
      profiledRawJointTargetLeftReceiverStrategy A activation past input
    RowExactIndexedTargetReceiverOutput.ofTarget output.physical output.target
      (fun row ↦ target_row row past input)

/-- Exact right receiver in the row-subtyped alphabet. -/
def profiledRawJointHybridFinitePayloadRightReceiverStrategy
    {Payload : Type p}
    {Allowed : ProfiledRawJointUnitTarget A → Prop}
    {source : ProfiledRawRightSlot A}
    (activation : ProfiledRawJointTargetRightBlockActivation A
      (ProfiledRawJointUnitTarget A)
      (profiledRawJointUnitRightTargetProjection A) Allowed source)
    (children : HybridDirection (In₁ := In₁) (In₂ := In₂) → Payload) :
    ReceiverBlockStrategy In₂ In₁
      (ProfiledRawJointHybridFinitePayloadRowExactRightReceiverOutput A
        Payload) :=
  profiledRawJointHybridFinitePayloadRowExactRightReceiverStrategy A
    (activation.linkFinitePayload A children) (fun _row _past _input ↦ rfl)

/-- Exact left receiver in the row-subtyped alphabet. -/
def profiledRawJointHybridFinitePayloadLeftReceiverStrategy
    {Payload : Type p}
    {Allowed : ProfiledRawJointUnitTarget A → Prop}
    {source : ProfiledRawLeftSlot A}
    (activation : ProfiledRawJointTargetLeftBlockActivation A
      (ProfiledRawJointUnitTarget A)
      (profiledRawJointUnitLeftTargetProjection A) Allowed source)
    (children : HybridDirection (In₁ := In₁) (In₂ := In₂) → Payload) :
    ReceiverBlockStrategy In₁ In₂
