/-- The row proof survives as data in every later narrowed receiver cell. -/
theorem profiledRawJointHybridFinitePayloadRowExactRightTarget_row
    {Payload : Type p}
    (output :
      ProfiledRawJointHybridFinitePayloadRowExactRightReceiverOutput A Payload)
    (row : PairedEntryRow) :
    profiledRawJointHybridFinitePayloadLinkedTargetRow A
        (output.forgetRowProof.target row) = row :=
  output.target_index row

