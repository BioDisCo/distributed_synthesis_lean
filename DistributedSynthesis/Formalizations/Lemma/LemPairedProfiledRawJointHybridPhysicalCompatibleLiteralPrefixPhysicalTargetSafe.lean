import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledRawJointHybridPhysicalCompatibleLiteralPrefixExtraReadback

/-!
# Physical target safety of recurring literal-prefix tables

The literal-prefix controllers have guard-extended monitor states, so they
cannot be cast to the independently rationalized unguarded physical
controllers.  Their induced physical plays nevertheless win the unguarded
monitor selected by the same semantic edge.  This file performs that honest
play-level erasure and derives the physical target-legality packet consumed
at a joint-policy successor.

No equality of rationalized tables is assumed.  Only the common finite base
descriptor, guard-erasure theorem, and semantic record readback are used.
-/

namespace DistributedSynthesis

universe u v x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

noncomputable section

variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁]
  [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
variable [DecidableEq In₁] [DecidableEq In₂]

variable
  (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
  (hwin : ∀ env : EnvironmentSequence In₁ In₂,
    A.Accepts (execution strategy env))

/-! ## Right blocks -/

/-- The physical play generated by one member of the guarded recurring right
table.  The guard state is internal to the narrowed label and absent from the
resulting block records. -/
noncomputable def profiledRawJointRightLiteralPrefixMoveOfPhysicalPlay
    (family : ProfiledRawJointSemanticFamily A strategy (I := Unit))
    (direction : ProfiledRawJointFamilyDirection
      (I := Unit) (In₁ := In₁) (In₂ := In₂))
    (semanticMember : ProcOnePairedEntryRep strategy × A.State)
    (hmember : (family.semanticChild A direction).right () =
      some semanticMember)
    (anchor : Bool) (env : Nat → In₂ × In₁) :
    Nat → RealizedBlockRound In₂ In₁
      (ProfiledRawJointTargetRightReceiverOutput
        (Out₁ := Out₁) (Out₂ := Out₂) (ProfiledRawJointUnitTarget A))
      Out₁ :=
  let move := profiledRawJointRightLiteralPrefixMoveOf A strategy hwin family
    direction semanticMember hmember
  let monitorFamily :=
    fun descriptor : ProfiledRawJointRightPhysicalSiblingDescriptor A ↦
      profiledRawJointRightPhysicalSiblingMonitor A descriptor false
  let monitor := finiteCrossAnchorLiteralPrefixMonitor monitorFamily
  let firstAllowed := finiteCrossAnchorLiteralPrefixFirstAllowed monitorFamily
  let secondAllowed :=
    finiteCrossAnchorLiteralPrefixSecondAllowed monitorFamily
  let guard := finiteCrossAnchorFirstTwoGuardFamily
    (fun member ↦ monitor (move.1.descriptor member)) move.1.start
    (firstAllowed move.1) (secondAllowed move.1) anchor
  let controller := move.memberController monitor anchor
  treePlay (narrowedInducedTree guard controller.labeledTree) env

/-- Guard erasure: the recurring right table's physical play wins the exact
unguarded target monitor belonging to the same semantic member. -/
theorem profiledRawJointRightLiteralPrefixMoveOfPhysicalPlay_wins
    (family : ProfiledRawJointSemanticFamily A strategy (I := Unit))
    (direction : ProfiledRawJointFamilyDirection
      (I := Unit) (In₁ := In₁) (In₂ := In₂))
    (semanticMember : ProcOnePairedEntryRep strategy × A.State)
    (hmember : (family.semanticChild A direction).right () =
      some semanticMember)
    (anchor : Bool) (env : Nat → In₂ × In₁) :
    (profiledRawJointRightPhysicalSiblingMonitor A
      (profiledRawJointRightPhysicalSiblingDescriptorOf A family direction
        semanticMember) false).WinsPlay
      (profiledRawJointRightLiteralPrefixMoveOfPhysicalPlay A strategy hwin
        family direction semanticMember hmember anchor env) := by
  letI : Inhabited (ProfiledRawJointUnitTarget A) :=
    ⟨family.incidenceCode A⟩
  let move := profiledRawJointRightLiteralPrefixMoveOf A strategy hwin family
    direction semanticMember hmember
  let monitorFamily :=
    fun descriptor : ProfiledRawJointRightPhysicalSiblingDescriptor A ↦
      profiledRawJointRightPhysicalSiblingMonitor A descriptor false
  let monitor := finiteCrossAnchorLiteralPrefixMonitor monitorFamily
  have hbase := move.memberController_base_wins monitor anchor env
  simpa [profiledRawJointRightLiteralPrefixMoveOfPhysicalPlay, move, monitor,
    monitorFamily, finiteCrossAnchorRestartFamily,
    BlockRecordMonitor.restartAt, profiledRawJointRightLiteralPrefixMoveOf,
    finiteCrossAnchorLiteralPrefixMove] using hbase

/-- Every target emitted by the recurring right literal table is a legal
target of the unguarded physical descriptor selected on the same edge. -/
theorem profiledRawJointRightLiteralPrefixMoveOf_targetSafe
    (family : ProfiledRawJointSemanticFamily A strategy (I := Unit))
    (direction : ProfiledRawJointFamilyDirection
      (I := Unit) (In₁ := In₁) (In₂ := In₂))
    (semanticMember : ProcOnePairedEntryRep strategy × A.State)
    (hmember : (family.semanticChild A direction).right () =
      some semanticMember)
    (anchor : Bool) (env : Nat → In₂ × In₁) (n : Nat)
    (row : PairedEntryRow) :
    let descriptor :=
      profiledRawJointRightPhysicalSiblingDescriptorOf A family direction
        semanticMember
    let monitor :=
      profiledRawJointRightPhysicalSiblingMonitor A descriptor false
    let play := profiledRawJointRightLiteralPrefixMoveOfPhysicalPlay A
      strategy hwin family direction semanticMember hmember anchor env
    erasePairedProfiledState A
        (profiledRawJointUnitRightTargetProjection A
          ((play n).2.1.target row)) =
        pairedRightCloseTarget A ((monitor.run play n).2.1) row
          (profiledRawJointTargetRightPhysicalLetter A (play n)) ∧
      profiledRawJointRightPhysicalSiblingAllowed A descriptor
        ((play n).2.1.target row) := by
  dsimp only
  exact profiledRawJointTargetRight_targetsSafe_of_wins A
    (profiledRawJointUnitRightTargetProjection A)
    (profiledRawJointRightPhysicalSiblingAllowed A
      (profiledRawJointRightPhysicalSiblingDescriptorOf A family direction
        semanticMember))
    (profiledRawJointRightPhysicalSiblingDescriptorOf A family direction
      semanticMember).source
    (profiledRawJointRightLiteralPrefixMoveOfPhysicalPlay A strategy hwin
      family direction semanticMember hmember anchor env)
    (profiledRawJointRightLiteralPrefixMoveOfPhysicalPlay_wins A strategy hwin
      family direction semanticMember hmember anchor env) n row

/-- Annotation-facing form: if the physical component of the same semantic
edge stores `physicalMove`, the guarded literal play is legal for precisely
that stored move's descriptor. -/
theorem
    profiledRawJointRightLiteralPrefixMoveOf_targetSafe_for_physicalAnnotation
    (family : ProfiledRawJointSemanticFamily A strategy (I := Unit))
    (direction : ProfiledRawJointFamilyDirection
      (I := Unit) (In₁ := In₁) (In₂ := In₂))
    (semanticMember : ProcOnePairedEntryRep strategy × A.State)
    (hmember : (family.semanticChild A direction).right () =
      some semanticMember)
    (physicalMove : ProfiledRawJointRightPhysicalSiblingMove A)
    (hphysical :
      (profiledRawJointHybridPhysicalAnnotationOf A strategy hwin family
        direction).1 = some physicalMove)
    (anchor : Bool) (env : Nat → In₂ × In₁) (n : Nat)
    (row : PairedEntryRow) :
    let monitor :=
      profiledRawJointRightPhysicalSiblingMonitor A physicalMove.1 false
    let play := profiledRawJointRightLiteralPrefixMoveOfPhysicalPlay A
      strategy hwin family direction semanticMember hmember anchor env
    erasePairedProfiledState A
        (profiledRawJointUnitRightTargetProjection A
          ((play n).2.1.target row)) =
        pairedRightCloseTarget A ((monitor.run play n).2.1) row
          (profiledRawJointTargetRightPhysicalLetter A (play n)) ∧
      profiledRawJointRightPhysicalSiblingAllowed A physicalMove.1
        ((play n).2.1.target row) := by
  obtain ⟨storedMember, hstoredMember, hstoredMove⟩ :=
    profiledRawJointRightPhysicalSiblingMoveOption_spec A strategy hwin family
      direction physicalMove (by
        simpa [profiledRawJointHybridPhysicalAnnotationOf] using hphysical)
  have hsame : storedMember = semanticMember := by
    exact Option.some.inj (hstoredMember.symm.trans hmember)
  subst storedMember
  subst physicalMove
  exact profiledRawJointRightLiteralPrefixMoveOf_targetSafe A strategy hwin
    family direction semanticMember hmember anchor env n row

/-! ## Left blocks -/

/-- Physical play of a recurring left literal-prefix member. -/
noncomputable def profiledRawJointLeftLiteralPrefixMoveOfPhysicalPlay
    (family : ProfiledRawJointSemanticFamily A strategy (I := Unit))
    (direction : ProfiledRawJointFamilyDirection
      (I := Unit) (In₁ := In₁) (In₂ := In₂))
    (semanticMember : ProcTwoPairedEntryRep strategy × A.State)
    (hmember : (family.semanticChild A direction).left () =
      some semanticMember)
    (anchor : Bool) (env : Nat → In₁ × In₂) :
    Nat → RealizedBlockRound In₁ In₂
      (ProfiledRawJointTargetLeftReceiverOutput
        (Out₁ := Out₁) (Out₂ := Out₂) (ProfiledRawJointUnitTarget A))
      Out₂ :=
  let move := profiledRawJointLeftLiteralPrefixMoveOf A strategy hwin family
    direction semanticMember hmember
  let monitorFamily :=
    fun descriptor : ProfiledRawJointLeftPhysicalSiblingDescriptor A ↦
      profiledRawJointGuardedCommonLeftLiteralCrossMonitor A descriptor
  let monitor := finiteCrossAnchorLiteralPrefixMonitor monitorFamily
  let firstAllowed := finiteCrossAnchorLiteralPrefixFirstAllowed monitorFamily
  let secondAllowed :=
    finiteCrossAnchorLiteralPrefixSecondAllowed monitorFamily
  let guard := finiteCrossAnchorFirstTwoGuardFamily
    (fun member ↦ monitor (move.1.descriptor member)) move.1.start
    (firstAllowed move.1) (secondAllowed move.1) anchor
  let controller := move.memberController monitor anchor
  treePlay (narrowedInducedTree guard controller.labeledTree) env

/-- Left guard erasure. -/
theorem profiledRawJointLeftLiteralPrefixMoveOfPhysicalPlay_wins
    (family : ProfiledRawJointSemanticFamily A strategy (I := Unit))
    (direction : ProfiledRawJointFamilyDirection
      (I := Unit) (In₁ := In₁) (In₂ := In₂))
    (semanticMember : ProcTwoPairedEntryRep strategy × A.State)
    (hmember : (family.semanticChild A direction).left () =
      some semanticMember)
    (anchor : Bool) (env : Nat → In₁ × In₂) :
    (profiledRawJointLeftPhysicalSiblingMonitor A
      (profiledRawJointLeftPhysicalSiblingDescriptorOf A family direction
        semanticMember) false).WinsPlay
      (profiledRawJointLeftLiteralPrefixMoveOfPhysicalPlay A strategy hwin
        family direction semanticMember hmember anchor env) := by
  letI : Inhabited (ProfiledRawJointUnitTarget A) :=
    ⟨family.incidenceCode A⟩
  let move := profiledRawJointLeftLiteralPrefixMoveOf A strategy hwin family
    direction semanticMember hmember
  let baseMonitor := fun descriptor :
      ProfiledRawJointLeftPhysicalSiblingDescriptor A ↦
    profiledRawJointLeftPhysicalSiblingMonitor A descriptor false
  let monitorFamily :=
    fun descriptor : ProfiledRawJointLeftPhysicalSiblingDescriptor A ↦
      profiledRawJointGuardedCommonLeftLiteralCrossMonitor A descriptor
  let monitor := finiteCrossAnchorLiteralPrefixMonitor monitorFamily
  have hbase := move.memberController_base_wins monitor anchor env
  have hunraised :
      (baseMonitor
        (profiledRawJointLeftPhysicalSiblingDescriptorOf A family direction
          semanticMember)).WinsPlay
        (profiledRawJointLeftLiteralPrefixMoveOfPhysicalPlay A strategy hwin
          family direction semanticMember hmember anchor env) := by
    apply (BlockRecordMonitor.raiseState_winsPlay_iff
      (baseMonitor
        (profiledRawJointLeftPhysicalSiblingDescriptorOf A family direction
          semanticMember)) _).mp
    simpa [profiledRawJointLeftLiteralPrefixMoveOfPhysicalPlay, move, monitor,
      monitorFamily, baseMonitor, finiteCrossAnchorRestartFamily,
      BlockRecordMonitor.restartAt,
      profiledRawJointLeftLiteralPrefixMoveOf,
      finiteCrossAnchorLiteralPrefixMove,
      profiledRawJointGuardedCommonLeftLiteralCrossMonitor] using hbase
  exact hunraised

/-- Left target-legality packet. -/
theorem profiledRawJointLeftLiteralPrefixMoveOf_targetSafe
    (family : ProfiledRawJointSemanticFamily A strategy (I := Unit))
    (direction : ProfiledRawJointFamilyDirection
      (I := Unit) (In₁ := In₁) (In₂ := In₂))
    (semanticMember : ProcTwoPairedEntryRep strategy × A.State)
    (hmember : (family.semanticChild A direction).left () =
      some semanticMember)
    (anchor : Bool) (env : Nat → In₁ × In₂) (n : Nat)
    (row : PairedEntryRow) :
    let descriptor :=
      profiledRawJointLeftPhysicalSiblingDescriptorOf A family direction
        semanticMember
    let monitor :=
      profiledRawJointLeftPhysicalSiblingMonitor A descriptor false
    let play := profiledRawJointLeftLiteralPrefixMoveOfPhysicalPlay A strategy
      hwin family direction semanticMember hmember anchor env
    erasePairedProfiledState A
        (profiledRawJointUnitLeftTargetProjection A
          ((play n).2.1.target row)) =
        pairedLeftCloseTarget A ((monitor.run play n).2.1) row
          (profiledRawJointTargetLeftPhysicalLetter A (play n)) ∧
      profiledRawJointLeftPhysicalSiblingAllowed A descriptor
        ((play n).2.1.target row) := by
  dsimp only
  exact profiledRawJointTargetLeft_targetsSafe_of_wins A
    (profiledRawJointUnitLeftTargetProjection A)
    (profiledRawJointLeftPhysicalSiblingAllowed A
      (profiledRawJointLeftPhysicalSiblingDescriptorOf A family direction
        semanticMember))
    (profiledRawJointLeftPhysicalSiblingDescriptorOf A family direction
      semanticMember).source
    (profiledRawJointLeftLiteralPrefixMoveOfPhysicalPlay A strategy hwin family
      direction semanticMember hmember anchor env)
    (profiledRawJointLeftLiteralPrefixMoveOfPhysicalPlay_wins A strategy hwin
      family direction semanticMember hmember anchor env) n row

/-- Left annotation-facing target legality. -/
theorem
    profiledRawJointLeftLiteralPrefixMoveOf_targetSafe_for_physicalAnnotation
    (family : ProfiledRawJointSemanticFamily A strategy (I := Unit))
    (direction : ProfiledRawJointFamilyDirection
      (I := Unit) (In₁ := In₁) (In₂ := In₂))
    (semanticMember : ProcTwoPairedEntryRep strategy × A.State)
    (hmember : (family.semanticChild A direction).left () =
      some semanticMember)
    (physicalMove : ProfiledRawJointLeftPhysicalSiblingMove A)
    (hphysical :
      (profiledRawJointHybridPhysicalAnnotationOf A strategy hwin family
        direction).2 = some physicalMove)
    (anchor : Bool) (env : Nat → In₁ × In₂) (n : Nat)
    (row : PairedEntryRow) :
    let monitor :=
      profiledRawJointLeftPhysicalSiblingMonitor A physicalMove.1 false
    let play := profiledRawJointLeftLiteralPrefixMoveOfPhysicalPlay A strategy
      hwin family direction semanticMember hmember anchor env
    erasePairedProfiledState A
        (profiledRawJointUnitLeftTargetProjection A
          ((play n).2.1.target row)) =
        pairedLeftCloseTarget A ((monitor.run play n).2.1) row
          (profiledRawJointTargetLeftPhysicalLetter A (play n)) ∧
      profiledRawJointLeftPhysicalSiblingAllowed A physicalMove.1
        ((play n).2.1.target row) := by
  obtain ⟨storedMember, hstoredMember, hstoredMove⟩ :=
    profiledRawJointLeftPhysicalSiblingMoveOption_spec A strategy hwin family
      direction physicalMove (by
        simpa [profiledRawJointHybridPhysicalAnnotationOf] using hphysical)
  have hsame : storedMember = semanticMember := by
    exact Option.some.inj (hstoredMember.symm.trans hmember)
  subst storedMember
  subst physicalMove
  exact profiledRawJointLeftLiteralPrefixMoveOf_targetSafe A strategy hwin
    family direction semanticMember hmember anchor env n row

end

end DetParityAutomaton

end DistributedSynthesis
