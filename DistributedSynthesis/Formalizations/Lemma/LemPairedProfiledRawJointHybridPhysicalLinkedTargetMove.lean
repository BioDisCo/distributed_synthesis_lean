import DistributedSynthesis.Formalizations.Lemma.LemNarrowedReceiverOutputDecoration
import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledRawJointHybridPhysicalCompatibleLocalCarrier
import DistributedSynthesis.Formalizations.Lemma.LemRowExactIndexedTargetReceiverOutput

/-!
# Physical sibling tables retaining the linked child annotation

The old finite physical sibling table deliberately emits only a bare
incidence code.  That is enough for physical safety, but not for iterating one
parent-linked compatible policy: both the literal successor row and the
annotation selected by the same parent move have been erased.  The row is
essential at a `.both` cut: the same bare code may describe the actual
`.first` coordinate and the counterfactual `.both` coordinate, while their
parent-linked successors need not agree.

This file performs the safe one-step repair before narrowing.  The exact
semantic receiver emits

`(bare target, (literal row, children (.strict actual)))`

for its literal row, past, and current input.  The target alphabet is finite,
and a sticky finite truth table records precisely the image of this map.
State-controlled narrowing is then applied once to the enriched receiver.
Consequently every target emitted by the resulting finite controller still
contains an annotation selected by the same parent move.  Its physical
projection and blind sender strategy are unchanged.

The annotation is receiver output, not a process observation.  No executable
definition accepts a graph, orientation, side, leader bit, strict-leader bit,
semantic history, view, or outer policy state.
-/

namespace DistributedSynthesis

universe u v x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

noncomputable section

variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁]
  [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
variable [DecidableEq In₁] [DecidableEq In₂]

private abbrev PhysicalAnnotation :=
  ProfiledRawJointHybridPhysicalEdgeAnnotation A

/-- Finite one-sided physical target retaining both the literal successor row
and the annotation selected by the same parent-linked move. -/
abbrev ProfiledRawJointHybridPhysicalLinkedTarget :=
  ProfiledRawJointIncidenceCode A (I := Unit) ×
    (PairedEntryRow × PhysicalAnnotation A)

noncomputable instance :
    Fintype (ProfiledRawJointHybridPhysicalLinkedTarget A) := by
  classical
  infer_instance

/-- Forget only the linked annotation at a right target projection. -/
def profiledRawJointHybridPhysicalLinkedRightTargetProjection
    (target : ProfiledRawJointHybridPhysicalLinkedTarget A) :
    PairedProfiledTreeState A :=
  profiledRawJointUnitRightTargetProjection A target.1

/-- Left-target mirror. -/
def profiledRawJointHybridPhysicalLinkedLeftTargetProjection
    (target : ProfiledRawJointHybridPhysicalLinkedTarget A) :
    PairedProfiledTreeState A :=
  profiledRawJointUnitLeftTargetProjection A target.1

/-- The finite coordinate selected by the receiver table is retained
literally in the linked target. -/
def profiledRawJointHybridPhysicalLinkedTargetRow
    (target : ProfiledRawJointHybridPhysicalLinkedTarget A) :
    PairedEntryRow :=
  target.2.1

/-- The parent-selected child annotation retained at the target. -/
def profiledRawJointHybridPhysicalLinkedTargetAnnotation
    (target : ProfiledRawJointHybridPhysicalLinkedTarget A) :
    PhysicalAnnotation A :=
  target.2.2

private abbrev HybridDirection :=
  ProfiledRawJointHybridDirection (In₁ := In₁) (In₂ := In₂)

/-! ## Exact enriched semantic activations -/

/-- The finite linked targets generated by one exact right activation and one
parent-selected child-annotation table. -/
def ProfiledRawJointRightLinkedTargetAllowed
    {Allowed : ProfiledRawJointIncidenceCode A (I := Unit) → Prop}
    {source : ProfiledRawRightSlot A}
    (activation : ProfiledRawJointTargetRightBlockActivation A
      (ProfiledRawJointIncidenceCode A (I := Unit))
      (profiledRawJointUnitRightTargetProjection A) Allowed source)
    (children : HybridDirection (In₁ := In₁) (In₂ := In₂) →
      PhysicalAnnotation A)
    (target : ProfiledRawJointHybridPhysicalLinkedTarget A) : Prop :=
  ∃ row past input,
    target =
      (activation.target row past input,
        (row,
          children (.strict
            (profiledRawJointUnitRightActualDirection
              (In₁ := In₁) (In₂ := In₂) row past input))))

noncomputable instance
    {Allowed : ProfiledRawJointIncidenceCode A (I := Unit) → Prop}
    {source : ProfiledRawRightSlot A}
    (activation : ProfiledRawJointTargetRightBlockActivation A
      (ProfiledRawJointIncidenceCode A (I := Unit))
      (profiledRawJointUnitRightTargetProjection A) Allowed source)
    (children : HybridDirection (In₁ := In₁) (In₂ := In₂) →
      PhysicalAnnotation A) :
    DecidablePred
      (ProfiledRawJointRightLinkedTargetAllowed A activation children) :=
  fun _ ↦ Classical.propDecidable _

/-- Enrich an exact right activation before finite narrowing. -/
def ProfiledRawJointTargetRightBlockActivation.linkPhysicalAnnotation
    {Allowed : ProfiledRawJointIncidenceCode A (I := Unit) → Prop}
    {source : ProfiledRawRightSlot A}
    (activation : ProfiledRawJointTargetRightBlockActivation A
      (ProfiledRawJointIncidenceCode A (I := Unit))
      (profiledRawJointUnitRightTargetProjection A) Allowed source)
    (children : HybridDirection (In₁ := In₁) (In₂ := In₂) →
      PhysicalAnnotation A) :
    ProfiledRawJointTargetRightBlockActivation A
      (ProfiledRawJointHybridPhysicalLinkedTarget A)
      (profiledRawJointHybridPhysicalLinkedRightTargetProjection A)
      (ProfiledRawJointRightLinkedTargetAllowed A activation children)
      source where
  lambda := activation.lambda
  initial_profile := activation.initial_profile
  forever := activation.forever
  target := fun row past input ↦
    (activation.target row past input,
      (row,
        children (.strict
          (profiledRawJointUnitRightActualDirection
            (In₁ := In₁) (In₂ := In₂) row past input))))
  target_allowed := fun row past input ↦ ⟨row, past, input, rfl⟩
  target_state := by
    intro row past input
    exact activation.target_state row past input

