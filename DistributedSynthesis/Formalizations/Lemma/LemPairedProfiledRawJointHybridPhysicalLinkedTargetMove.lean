/-! ## Row-exact receiver alphabets

The old target monitor checks a unary target relation.  Since `.first` and
`.both` can have the same bare projection, that alone cannot force a narrowed
table to put the parent-selected annotation into the row that selected it.
The following finite receiver alphabet makes that equation part of the table
cell's type.  The monitor merely erases the proof and otherwise runs
unchanged.
-/

/-- Right receiver output whose linked target at every row carries the
literal row equation. -/
abbrev ProfiledRawJointHybridPhysicalRowExactRightReceiverOutput :=
  RowExactIndexedTargetReceiverOutput
    (PairedRightReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂))
    PairedEntryRow (ProfiledRawJointHybridPhysicalLinkedTarget A)
    (profiledRawJointHybridPhysicalLinkedTargetRow A)

/-- Left mirror. -/
abbrev ProfiledRawJointHybridPhysicalRowExactLeftReceiverOutput :=
  RowExactIndexedTargetReceiverOutput
    (PairedLeftReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂))
    PairedEntryRow (ProfiledRawJointHybridPhysicalLinkedTarget A)
    (profiledRawJointHybridPhysicalLinkedTargetRow A)

/-- Erase right row proofs for the old target monitor. -/
def profiledRawJointHybridPhysicalRowExactRightReceiverProjection
    (output : ProfiledRawJointHybridPhysicalRowExactRightReceiverOutput A) :
    ProfiledRawJointTargetRightReceiverOutput
      (Out₁ := Out₁) (Out₂ := Out₂)
      (ProfiledRawJointHybridPhysicalLinkedTarget A) :=
  output.forgetRowProof

/-- Left mirror. -/
def profiledRawJointHybridPhysicalRowExactLeftReceiverProjection
    (output : ProfiledRawJointHybridPhysicalRowExactLeftReceiverOutput A) :
    ProfiledRawJointTargetLeftReceiverOutput
      (Out₁ := Out₁) (Out₂ := Out₂)
      (ProfiledRawJointHybridPhysicalLinkedTarget A) :=
  output.forgetRowProof

/-- Lift one exact linked right activation into the row-exact receiver
alphabet. -/
def profiledRawJointHybridPhysicalRowExactRightReceiverStrategy
    {Allowed : ProfiledRawJointHybridPhysicalLinkedTarget A → Prop}
    {source : ProfiledRawRightSlot A}
    (activation : ProfiledRawJointTargetRightBlockActivation A
      (ProfiledRawJointHybridPhysicalLinkedTarget A)
      (profiledRawJointHybridPhysicalLinkedRightTargetProjection A)
      Allowed source)
    (target_row : ∀ row past input,
      profiledRawJointHybridPhysicalLinkedTargetRow A
        (activation.target row past input) = row) :
    ReceiverBlockStrategy In₂ In₁
      (ProfiledRawJointHybridPhysicalRowExactRightReceiverOutput A) :=
  fun past input ↦
    let output :=
      profiledRawJointTargetRightReceiverStrategy A activation past input
    RowExactIndexedTargetReceiverOutput.ofTarget output.physical output.target
      (fun row ↦ target_row row past input)

omit [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂] in
/-- Erasing row proofs recovers the exact semantic linked receiver. -/
@[simp] theorem
    profiledRawJointHybridPhysicalRowExactRightReceiverStrategy_forget
    {Allowed : ProfiledRawJointHybridPhysicalLinkedTarget A → Prop}
    {source : ProfiledRawRightSlot A}
    (activation : ProfiledRawJointTargetRightBlockActivation A
      (ProfiledRawJointHybridPhysicalLinkedTarget A)
      (profiledRawJointHybridPhysicalLinkedRightTargetProjection A)
      Allowed source)
    (target_row : ∀ row past input,
      profiledRawJointHybridPhysicalLinkedTargetRow A
        (activation.target row past input) = row)
    (past : List (In₂ × In₁)) (input : In₂ × In₁) :
    profiledRawJointHybridPhysicalRowExactRightReceiverProjection A
        (profiledRawJointHybridPhysicalRowExactRightReceiverStrategy A
          activation target_row past input) =
        profiledRawJointTargetRightReceiverStrategy A activation past input :=
  rfl

/-- The old exact linked monitor, comapped through row-proof erasure. -/
noncomputable abbrev profiledRawJointHybridPhysicalRowExactRightBlockMonitor
    (Allowed : ProfiledRawJointHybridPhysicalLinkedTarget A → Prop)
    (source : ProfiledRawRightSlot A) :=
  (profiledRawJointTargetRightBlockMonitor A
    (ProfiledRawJointHybridPhysicalLinkedTarget A)
    (profiledRawJointHybridPhysicalLinkedRightTargetProjection A)
    Allowed source).comapReceiverOutput
      (profiledRawJointHybridPhysicalRowExactRightReceiverProjection A)

omit [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂] in
/-- Exact semantic realizability transfers to the row-exact alphabet. -/
theorem profiledRawJointHybridPhysicalRowExactRightBlockMonitor_realizable
    {Allowed : ProfiledRawJointHybridPhysicalLinkedTarget A → Prop}
    {source : ProfiledRawRightSlot A}
    (activation : ProfiledRawJointTargetRightBlockActivation A
      (ProfiledRawJointHybridPhysicalLinkedTarget A)
      (profiledRawJointHybridPhysicalLinkedRightTargetProjection A)
      Allowed source)
    (target_row : ∀ row past input,
      profiledRawJointHybridPhysicalLinkedTargetRow A
        (activation.target row past input) = row) :
    ∀ env : Nat → In₂ × In₁,
      (profiledRawJointHybridPhysicalRowExactRightBlockMonitor A Allowed
        source).WinsPlay
        (pairPlay
          (profiledRawJointHybridPhysicalRowExactRightReceiverStrategy A
            activation target_row)
          (pairedRightSenderStrategy activation.lambda) env) := by
  intro env
  apply (BlockRecordMonitor.comapReceiverOutput_wins_iff
    (profiledRawJointTargetRightBlockMonitor A
      (ProfiledRawJointHybridPhysicalLinkedTarget A)
      (profiledRawJointHybridPhysicalLinkedRightTargetProjection A)
      Allowed source)
    (profiledRawJointHybridPhysicalRowExactRightReceiverProjection A) _).mpr
  simpa [BlockRecordMonitor.projectReceiverPlay, pairPlay, treePlay,
    treeOfPair, blockLabelApply] using
    (profiledRawJointTargetRightBlockMonitor_realizable A
      (profiledRawJointHybridPhysicalLinkedRightTargetProjection A)
      Allowed source activation env)

omit [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂] in
