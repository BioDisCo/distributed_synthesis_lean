/-! ## Exact post-narrowing decoration of an installed table

The activation construction above is the semantic source of linked targets.
The following generic adapter records a weaker, conditional operation: once a
finite physical sibling table has already been installed, a *row-sensitive*
finite lookup can decorate its bare targets without changing its control,
transition, sender output, or physical receiver output.  It does not claim
that an arbitrary semantic child table factors through that lookup.  Such a
claim requires a separate functional-lookup law; the exact positive
construction instead narrows `activation.linkPhysicalAnnotation` itself.
-/

/-- Forget the linked annotation from a right receiver output. -/
def profiledRawJointHybridPhysicalLinkedRightReceiverProjection
    (output : ProfiledRawJointTargetRightReceiverOutput
      (Out₁ := Out₁) (Out₂ := Out₂)
      (ProfiledRawJointHybridPhysicalLinkedTarget A)) :
    ProfiledRawJointTargetRightReceiverOutput
      (Out₁ := Out₁) (Out₂ := Out₂)
      (ProfiledRawJointUnitTarget A) where
  physical := output.physical
  target := fun row ↦ (output.target row).1

/-- Pair one bare right target with its finite annotation lookup. -/
def profiledRawJointHybridPhysicalLinkRightTargetAt
    (nextAnnotation : PairedEntryRow →
      ProfiledRawJointUnitTarget A → PhysicalAnnotation A)
    (output : ProfiledRawJointTargetRightReceiverOutput
      (Out₁ := Out₁) (Out₂ := Out₂)
      (ProfiledRawJointUnitTarget A))
    (row : PairedEntryRow) :
    ProfiledRawJointHybridPhysicalLinkedTarget A :=
  (output.target row, (row, nextAnnotation row (output.target row)))

/-- Pair every bare right target with a finite annotation lookup. -/
def profiledRawJointHybridPhysicalLinkRightReceiverOutput
    (nextAnnotation : PairedEntryRow →
      ProfiledRawJointUnitTarget A → PhysicalAnnotation A)
    (output : ProfiledRawJointTargetRightReceiverOutput
      (Out₁ := Out₁) (Out₂ := Out₂)
      (ProfiledRawJointUnitTarget A)) :
    ProfiledRawJointTargetRightReceiverOutput
      (Out₁ := Out₁) (Out₂ := Out₂)
      (ProfiledRawJointHybridPhysicalLinkedTarget A) where
  physical := output.physical
  target := profiledRawJointHybridPhysicalLinkRightTargetAt A nextAnnotation
    output

section
omit [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]

@[simp] theorem profiledRawJointHybridPhysicalLinkRightTargetAt_fst
    (nextAnnotation : PairedEntryRow →
      ProfiledRawJointUnitTarget A → PhysicalAnnotation A)
    (output : ProfiledRawJointTargetRightReceiverOutput
      (Out₁ := Out₁) (Out₂ := Out₂)
      (ProfiledRawJointUnitTarget A)) (row : PairedEntryRow) :
    (profiledRawJointHybridPhysicalLinkRightTargetAt A nextAnnotation output
      row).1 = output.target row :=
  rfl

@[simp] theorem profiledRawJointHybridPhysicalLinkRightTargetAt_row
    (nextAnnotation : PairedEntryRow →
      ProfiledRawJointUnitTarget A → PhysicalAnnotation A)
    (output : ProfiledRawJointTargetRightReceiverOutput
      (Out₁ := Out₁) (Out₂ := Out₂)
      (ProfiledRawJointUnitTarget A)) (row : PairedEntryRow) :
    (profiledRawJointHybridPhysicalLinkRightTargetAt A nextAnnotation output
      row).2.1 = row :=
