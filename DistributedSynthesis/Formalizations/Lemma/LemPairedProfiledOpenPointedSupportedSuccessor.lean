import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledOpenOptionalBlockQueryFactorization
import DistributedSynthesis.Formalizations.Lemma.LemPointedSemanticSuccessorRealization

/-!
# Pointed supported successors at the optional pinned-query seam

This file instantiates the descriptor-pointed relational interface at the
four-shape optional semantics.  It does not require the child public family
to factor through the unpointed current family.  The selected pinned move is
allowed to realize each live descriptor by a different semantic history; one
finite descriptor-indexed table records all those answers.

The only model-specific input left in the specialization is `Realizes`: the
literal root-pinned controller and coherent block query must have the strong
semantic-table provenance represented by that relation.  Once validity says
that every live descriptor has such a witness, the supported family, exact
target, and parity-control step are constructed in one theorem.  No process
is told the lane shape, orientation, current descriptor, or strict leader.
-/

namespace DistributedSynthesis

universe i u v x y s

namespace DetParityAutomaton

variable {I : Type i}
variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

noncomputable section

variable [Fintype I]
variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁]
  [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
variable [DecidableEq In₁] [DecidableEq In₂]

variable (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
variable (hwin : ∀ env : EnvironmentSequence In₁ In₂,
  A.Accepts (execution strategy env))
variable (basis : ∀ state : PairedProfiledTreeState A,
  (pairedProfiledEntryRunAutomaton A state).RationalRunBasis)
variable (initialCode : ProfiledOpenIndexedBiBeliefCode A (I := I))

/-- The concrete semantic realization relation expected from the literal
pinned controller.  Its arguments retain the current descriptor and public
family separately; it is not equality with a separately extracted move. -/
abbrev ProfiledOpenOptionalPinnedQueryRealizes :=
  ProfiledOpenIndexedOldMoveHiddenDescriptor A (I := I) initialCode →
    ProfiledOpenIndexedHiddenDescriptorFamilyCode A (I := I) initialCode →
    ProfiledOpenHiddenDescriptorPairedPinnedFamilyMove.{i, u, v, x, y, s,
      0, 0} A (I := I) initialCode →
    ProfiledOpenIndexedOptionalControlledSemanticState A strategy hwin basis
      initialCode → Prop

/-- Live pointed queries are exactly the image of the optional semantic
descriptor together with its selected public family. -/
noncomputable abbrev ProfiledOpenOptionalPointedSemanticLive :=
  PointedSemanticLive
    (profiledOpenIndexedBiBeliefCodeParityDPA A initialCode)
    (profiledOpenIndexedOptionalControlledSemanticDescriptor A strategy hwin
      basis initialCode)
    (profiledOpenOptionalControlledFamilyOf A strategy hwin basis initialCode)

/-- Validity means that the literal pinned controller realizes every live
descriptor of its advertised family.  This is the precise target discharged
by arbitrary-node semantic provenance plus coherent query decoding. -/
noncomputable abbrev ProfiledOpenOptionalPointedPinnedMoveValid
    (Realizes : ProfiledOpenOptionalPinnedQueryRealizes A strategy hwin basis
      initialCode) :=
  PointedSemanticMoveValid
    (profiledOpenIndexedBiBeliefCodeParityDPA A initialCode)
    (profiledOpenIndexedOptionalControlledSemanticDescriptor A strategy hwin
      basis initialCode)
    (profiledOpenOptionalControlledFamilyOf A strategy hwin basis initialCode)
    Realizes

/-- Descriptor-indexed public successor-family support. -/
noncomputable abbrev ProfiledOpenOptionalPointedSupported
    (Realizes : ProfiledOpenOptionalPinnedQueryRealizes A strategy hwin basis
      initialCode) :=
  PointedSemanticSupported
    (profiledOpenIndexedBiBeliefCodeParityDPA A initialCode)
    (profiledOpenOptionalControlledBlockQuerySemanticNext A strategy hwin
      basis initialCode)
    (profiledOpenIndexedOptionalControlledSemanticDescriptor A strategy hwin
      basis initialCode)
    (profiledOpenOptionalControlledFamilyOf A strategy hwin basis initialCode)
    Realizes

/-- Exact edge generated by one semantic realization of the literal pinned
controller. -/
noncomputable abbrev ProfiledOpenOptionalPointedExactEdge
    (Realizes : ProfiledOpenOptionalPinnedQueryRealizes A strategy hwin basis
      initialCode) :=
  PointedSemanticExactEdge
    (profiledOpenIndexedBiBeliefCodeParityDPA A initialCode)
    (profiledOpenOptionalControlledBlockQuerySemanticNext A strategy hwin
      basis initialCode)
    (profiledOpenIndexedOptionalControlledSemanticDescriptor A strategy hwin
      basis initialCode)
    (profiledOpenOptionalControlledFamilyOf A strategy hwin basis initialCode)
    Realizes

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- The optional semantic successor performs exactly the control update
required by the generic pointed construction. -/
theorem profiledOpenOptionalControlledBlockQuerySemanticNext_controlStep
    (point : ProfiledOpenIndexedOptionalControlledSemanticState A strategy
      hwin basis initialCode)
    (tag : ProfiledOpenHiddenDescriptorPairedPinnedBlockQueryTag.{i, u, v, x,
      y, s, 0, 0, 0, 0} A (I := I) initialCode) :
    (profiledOpenIndexedOptionalControlledSemanticDescriptor A strategy hwin
      basis initialCode
      (profiledOpenOptionalControlledBlockQuerySemanticNext A strategy hwin
        basis initialCode point tag)).control =
      (profiledOpenIndexedBiBeliefCodeParityDPA A initialCode).step
        (profiledOpenIndexedOptionalControlledSemanticDescriptor A strategy
          hwin basis initialCode point).control
        (profiledOpenIndexedOptionalControlledSemanticDescriptor A strategy
          hwin basis initialCode
          (profiledOpenOptionalControlledBlockQuerySemanticNext A strategy
            hwin basis initialCode point tag)).code := by
  exact profiledOpenIndexedOptionalControlledSemanticNext_control A strategy
    hwin basis initialCode point tag.2.2

/-- Complete pointed totality at the concrete optional types, obtained
without any child-family factorization. -/
noncomputable def profiledOpenOptionalPointedFamilyTotality
    (Realizes : ProfiledOpenOptionalPinnedQueryRealizes A strategy hwin basis
      initialCode) :
    PointedHiddenDescriptorFamilyTotality
      (profiledOpenIndexedBiBeliefCodeParityDPA A initialCode)
      (ProfiledOpenOptionalPointedSemanticLive A strategy hwin basis
        initialCode)
      (ProfiledOpenOptionalPointedSemanticLive A strategy hwin basis
        initialCode)
      (ProfiledOpenOptionalPointedExactEdge A strategy hwin basis initialCode
        Realizes)
      (ProfiledOpenOptionalPointedPinnedMoveValid A strategy hwin basis
        initialCode Realizes)
      (ProfiledOpenOptionalPointedSupported A strategy hwin basis initialCode
        Realizes) :=
  pointedSemanticFamilyTotality
    (profiledOpenIndexedBiBeliefCodeParityDPA A initialCode)
    (profiledOpenOptionalControlledBlockQuerySemanticNext A strategy hwin
      basis initialCode)
    (profiledOpenIndexedOptionalControlledSemanticDescriptor A strategy hwin
      basis initialCode)
    (profiledOpenOptionalControlledFamilyOf A strategy hwin basis initialCode)
    Realizes
    (profiledOpenOptionalControlledBlockQuerySemanticNext_controlStep A
      strategy hwin basis initialCode)

/-- Concrete one-arrow successor existence.  The hypotheses name exactly the
current live descriptor and the fact that the selected literal pinned move
realizes every descriptor in that family. -/
theorem exists_profiledOpenOptionalPointedSupportedExactSuccessor
    (Realizes : ProfiledOpenOptionalPinnedQueryRealizes A strategy hwin basis
      initialCode)
    (current : ProfiledOpenIndexedOldMoveHiddenDescriptor A (I := I)
      initialCode)
    (currentFamily : ProfiledOpenIndexedHiddenDescriptorFamilyCode A (I := I)
      initialCode)
    (move : ProfiledOpenHiddenDescriptorPairedPinnedFamilyMove.{i, u, v, x, y,
      s, 0, 0} A (I := I) initialCode)
    (tag : ProfiledOpenHiddenDescriptorPairedPinnedBlockQueryTag.{i, u, v, x,
      y, s, 0, 0, 0, 0} A (I := I) initialCode)
    (hlive : ProfiledOpenOptionalPointedSemanticLive A strategy hwin basis
      initialCode current currentFamily)
    (hvalid : ProfiledOpenOptionalPointedPinnedMoveValid A strategy hwin basis
      initialCode Realizes currentFamily move) :
    ∃ nextFamily target,
      ProfiledOpenOptionalPointedSupported A strategy hwin basis initialCode
          Realizes current currentFamily move tag nextFamily ∧
        ProfiledOpenOptionalPointedExactEdge A strategy hwin basis initialCode
          Realizes current move tag nextFamily target ∧
        target.control =
          (profiledOpenIndexedBiBeliefCodeParityDPA A initialCode).step
            current.control target.code :=
  exists_pointedSemanticSupportedExactSuccessor
    (profiledOpenIndexedBiBeliefCodeParityDPA A initialCode)
    (profiledOpenOptionalControlledBlockQuerySemanticNext A strategy hwin
      basis initialCode)
    (profiledOpenIndexedOptionalControlledSemanticDescriptor A strategy hwin
      basis initialCode)
    (profiledOpenOptionalControlledFamilyOf A strategy hwin basis initialCode)
    Realizes
    (profiledOpenOptionalControlledBlockQuerySemanticNext_controlStep A
      strategy hwin basis initialCode)
    current currentFamily move tag hlive hvalid

/-- The concrete finite descriptor-table coverage from the optional-query
module follows immediately.  Thus, after `PinnedMoveValid` is discharged by
the strong provenance decoder, every `(family, tag)` slice has a good row for
every live descriptor. -/
theorem profiledOpenOptionalControlledPinnedPointedCoverage_of_realizes
    (Realizes : ProfiledOpenOptionalPinnedQueryRealizes A strategy hwin basis
      initialCode) :
    ProfiledOpenOptionalControlledPinnedPointedCoverage A initialCode
      (ProfiledOpenOptionalPointedSupported A strategy hwin basis initialCode
        Realizes)
      (ProfiledOpenOptionalPointedExactEdge A strategy hwin basis initialCode
        Realizes)
      (ProfiledOpenOptionalPointedSemanticLive A strategy hwin basis
        initialCode)
      (ProfiledOpenOptionalPointedPinnedMoveValid A strategy hwin basis
        initialCode Realizes) := by
  intro query hlive hvalid
  obtain ⟨nextFamily, target, hsupported, hedge, hcontrol⟩ :=
    exists_profiledOpenOptionalPointedSupportedExactSuccessor A strategy hwin
      basis initialCode Realizes query.descriptor query.family query.tag.1
      query.tag hlive hvalid
  exact ⟨(nextFamily, target), hsupported, hedge, hcontrol⟩

/-- Fully materialized finite descriptor-to-answer tables.  The table is
finite data carried by the controller; the actual descriptor is used only as
its lookup index after model-side full-view recovery. -/
theorem exists_profiledOpenOptionalControlledPinnedPointedTables_of_realizes
    (Realizes : ProfiledOpenOptionalPinnedQueryRealizes A strategy hwin basis
      initialCode) :
    ∃ tables :
        ProfiledOpenOptionalControlledPinnedPointedTables A initialCode,
      ∀ family tag,
        ProfiledOpenOptionalControlledPinnedDescriptorTableWorks A initialCode
          (ProfiledOpenOptionalPointedSupported A strategy hwin basis
            initialCode Realizes)
          (ProfiledOpenOptionalPointedExactEdge A strategy hwin basis
            initialCode Realizes)
          (ProfiledOpenOptionalPointedSemanticLive A strategy hwin basis
            initialCode)
          (ProfiledOpenOptionalPointedPinnedMoveValid A strategy hwin basis
            initialCode Realizes)
          family tag (tables family tag) := by
  apply
    (profiledOpenOptionalControlledPinnedPointedCoverage_iff_exists_tables A
      initialCode
      (ProfiledOpenOptionalPointedSupported A strategy hwin basis initialCode
        Realizes)
      (ProfiledOpenOptionalPointedExactEdge A strategy hwin basis initialCode
        Realizes)
      (ProfiledOpenOptionalPointedSemanticLive A strategy hwin basis
        initialCode)
      (ProfiledOpenOptionalPointedPinnedMoveValid A strategy hwin basis
        initialCode Realizes)).mp
  exact profiledOpenOptionalControlledPinnedPointedCoverage_of_realizes A
    strategy hwin basis initialCode Realizes

end

end DetParityAutomaton

end DistributedSynthesis
