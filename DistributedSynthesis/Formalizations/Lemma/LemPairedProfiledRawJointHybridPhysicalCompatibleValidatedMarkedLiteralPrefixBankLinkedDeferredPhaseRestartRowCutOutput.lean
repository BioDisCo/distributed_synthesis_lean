import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledRawJointHybridPhysicalCompatibleValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowCutRestart

/-!
# Physical output alignment for the row-aware restart controller

The repaired controller uses checker row `.first` on the first round of a
strict block and checker row `.both` after the receiver has observed one
round.  This module exposes its physical word and the exact same-block relay
run without freezing that local phase bit.
-/

namespace DistributedSynthesis

universe u v x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

noncomputable section

variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁]
  [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
variable [DecidableEq In₁] [DecidableEq In₂]

variable
  (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
  (hwin : ∀ env : EnvironmentSequence In₁ In₂,
    A.Accepts (execution strategy env))

private abbrev RetainedTag :=
  ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankRetainedTag A strategy
    hwin

private abbrev LinkedRelay :=
  ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedRetainedRelay A
    strategy hwin

private abbrev LinkedOne :=
  ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedRetainedOneControl
    A strategy hwin

private abbrev LinkedTwo :=
  ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedRetainedTwoControl
    A strategy hwin

private abbrev Payload :=
  ProfiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPayload A
    strategy hwin

private abbrev OneControl :=
  FiniteAcknowledgedDelayedCarrier.DeferredOrRecurrent
    (LinkedOne A strategy hwin) (Payload A strategy hwin) PUnit.{1}

private abbrev TwoControl :=
  FiniteAcknowledgedDelayedCarrier.DeferredOrRecurrent
    (LinkedTwo A strategy hwin) (Payload A strategy hwin) PUnit.{1}

/-! ## The physical word and its explicit semantic output -/

/-- The actual physical word generated by the row-aware finite controller. -/
noncomputable def
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowWord
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) :=
  let controller :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowController
      A strategy hwin initialTag
  controller.globalMachine.globalMachineTraceWord controller.globalOutputOne
    controller.globalOutputTwo env

/-- Output pair named by the proved row-aware reference word. -/
noncomputable def
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowReferenceOutputAt
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) (n : Nat) : Out₁ × Out₂ :=
  let controller :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowController
      A strategy hwin initialTag
  let word :=
    (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowTraceInvariant
      A strategy hwin initialTag env).referenceWord controller
  ((word n).outputOne, (word n).outputTwo)

/-- The same output pair read directly from the deterministic semantic
controls. -/
noncomputable def
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticOutputPairAt
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) (n : Nat) : Out₁ × Out₂ :=
  let fallback :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
      A strategy hwin initialTag
  let pair :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
      A strategy hwin initialTag env n
  match (env n).graph with
  | .right =>
      ((profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartNoRecvOne
          A strategy hwin pair.1 (env n).inputOne).2,
        (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowOpenRecvTwo
          A strategy hwin fallback pair.2 (env n).inputTwo pair.1
            (env n).inputOne).2)
  | .left =>
      ((profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowOpenRecvOne
          A strategy hwin fallback pair.1 (env n).inputOne pair.2
            (env n).inputTwo).2,
        (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartNoRecvTwo
          A strategy hwin pair.2 (env n).inputTwo).2)
  | .both =>
      ((profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowOpenRecvOne
          A strategy hwin fallback pair.1 (env n).inputOne pair.2
            (env n).inputTwo).2,
        (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowOpenRecvTwo
          A strategy hwin fallback pair.2 (env n).inputTwo pair.1
            (env n).inputOne).2)

/-- The row-aware trace invariant records the explicit semantic output. -/
@[simp] theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowReferenceOutputAt_eq_semantic
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) (n : Nat) :
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowReferenceOutputAt
        A strategy hwin initialTag env n =
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticOutputPairAt
        A strategy hwin initialTag env n := by
  simp only [
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowReferenceOutputAt,
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowTraceInvariant,
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowMealyTraceInvariant,
    FinitePairedMealyController.LiteralCrossMealyTraceInvariant.toMooreTraceInvariant,
    FinitePairedPhysicalController.LiteralCrossGraphTraceInvariant.referenceWord,
    FiniteAcknowledgedDelayedCarrier.ExactClosingSelectedTraceLaws.toMealyTraceInvariant,
    FiniteAcknowledgedDelayedCarrier.exactClosingSemanticOutputOne,
    FiniteAcknowledgedDelayedCarrier.exactClosingSemanticOutputTwo,
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticOutputPairAt,
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt]
  cases hgraph : (env n).graph <;> rfl

/-! ## Open-member provenance on a no-`both` run -/

/-- Without a simultaneous round, both row-aware semantic controls remain
in the open pending member.  In particular, their member-selection flags are
literally `false`, which identifies the executable blind relay. -/
theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt_open_of_noBoth
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂)
    (hnoBoth : ∀ n : Nat, (env n).graph ≠ .both) : ∀ n : Nat,
    ∃ one : LinkedOne A strategy hwin,
      ∃ payloadOne : Payload A strategy hwin,
        ∃ two : LinkedTwo A strategy hwin,
          ∃ payloadTwo : Payload A strategy hwin,
            profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                A strategy hwin initialTag env n =
              ((.inl (false, one, payloadOne) : OneControl A strategy hwin),
                (.inl (false, two, payloadTwo) : TwoControl A strategy hwin)) := by
  intro n
  induction n with
  | zero =>
      refine ⟨
        (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
          A strategy hwin initialTag).1,
        profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPayloadOfChild
          A strategy hwin initialTag.1,
        (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
          A strategy hwin initialTag).2,
        profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPayloadOfChild
          A strategy hwin initialTag.1, ?_⟩
      rfl
  | succ n ih =>
      rcases ih with ⟨one, payloadOne, two, payloadTwo, hcurrent⟩
      have hnext :
          profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
              A strategy hwin initialTag env (n + 1) =
            match (env n).graph with
            | .right =>
                ((profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartNoRecvOne
                    A strategy hwin
                      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                        A strategy hwin initialTag env n).1
                      (env n).inputOne).1,
                  (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowOpenRecvTwo
                    A strategy hwin
                      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
                        A strategy hwin initialTag)
                      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                        A strategy hwin initialTag env n).2
                      (env n).inputTwo
                      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                        A strategy hwin initialTag env n).1
                      (env n).inputOne).1)
            | .left =>
                ((profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowOpenRecvOne
                    A strategy hwin
                      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
                        A strategy hwin initialTag)
                      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                        A strategy hwin initialTag env n).1
                      (env n).inputOne
                      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                        A strategy hwin initialTag env n).2
                      (env n).inputTwo).1,
                  (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartNoRecvTwo
                    A strategy hwin
                      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                        A strategy hwin initialTag env n).2
                      (env n).inputTwo).1)
            | .both =>
                profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowClose
                  A strategy hwin
                    (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
                      A strategy hwin initialTag)
                    (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                      A strategy hwin initialTag env n).1
                    (env n).inputOne
                    (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                      A strategy hwin initialTag env n).2
                    (env n).inputTwo := by
        rw [
          profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt,
          FiniteAcknowledgedDelayedCarrier.exactClosingSemanticPairTrace]
        rfl
      cases hgraph : (env n).graph with
      | right =>
          refine ⟨
            (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartRetainedNoRecvOne
              A strategy hwin one (env n).inputOne), payloadOne,
            (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowFreshTwo
              A strategy hwin
                (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
                  A strategy hwin initialTag)
                (.inl (false, two, payloadTwo)) (env n).inputTwo
                (.inl (false, one, payloadOne)) (env n).inputOne).1,
            (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowFreshTwo
              A strategy hwin
                (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
                  A strategy hwin initialTag)
                (.inl (false, two, payloadTwo)) (env n).inputTwo
                (.inl (false, one, payloadOne)) (env n).inputOne).2, ?_⟩
          rw [hnext, hgraph, hcurrent]
          rfl
      | left =>
          refine ⟨
            (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowFreshOne
              A strategy hwin
                (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
                  A strategy hwin initialTag)
                (.inl (false, one, payloadOne)) (env n).inputOne
                (.inl (false, two, payloadTwo)) (env n).inputTwo).1,
            (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowFreshOne
              A strategy hwin
                (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
                  A strategy hwin initialTag)
                (.inl (false, one, payloadOne)) (env n).inputOne
                (.inl (false, two, payloadTwo)) (env n).inputTwo).2,
            (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartRetainedNoRecvTwo
              A strategy hwin two (env n).inputTwo), payloadTwo, ?_⟩
          rw [hnext, hgraph, hcurrent]
          rfl
      | both => exact False.elim (hnoBoth n hgraph)

/-! ## The relay actually used by a blind endpoint -/

/-- Right-blind process one's locally selected relay before round `n`.  When
its last action was a receive, the executable no-receive handler restarts at
the newly stored child; otherwise it continues the retained relay. -/
noncomputable def
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBlindBaseAt
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) (n : Nat) :
    LinkedRelay A strategy hwin :=
  let one :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedOneAt
      A strategy hwin initialTag env n
  if one.2.1 then
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredRestartRelay
      A strategy hwin (one.child A strategy hwin) false false
  else one.2.2.1

/-- Left-blind process two's mirror relay. -/
noncomputable def
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowLeftBlindBaseAt
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) (n : Nat) :
    LinkedRelay A strategy hwin :=
  let two :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedTwoAt
      A strategy hwin initialTag env n
  if two.2.1 then
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredRestartRelay
      A strategy hwin (two.child A strategy hwin) false false
  else two.2.2.1

/-- At time zero the right blind sender and receiver-selected sender use the
same initialized linked sender. -/
@[simp] theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBlindBaseAt_zero_sender
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) :
    (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBlindBaseAt
        A strategy hwin initialTag env 0).1.1 =
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBaseAt
        A strategy hwin initialTag env 0).1.1 := by
  rfl

/-- Initial left-sender mirror. -/
@[simp] theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowLeftBlindBaseAt_zero_sender
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) :
    (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowLeftBlindBaseAt
        A strategy hwin initialTag env 0).2.1 =
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowLeftBaseAt
        A strategy hwin initialTag env 0).2.1 := by
  rfl

/-- Immediately after a strict-left round, process one and the next
strict-right receiver base restart at the same child. -/
theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBlindBaseAt_succ_of_left
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) (n : Nat)
    (hgraph : (env n).graph = .left) :
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBlindBaseAt
        A strategy hwin initialTag env (n + 1) =
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBaseAt
        A strategy hwin initialTag env (n + 1) := by
  have hbits :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt_succ_selected_lastRecv
      A strategy hwin initialTag env n
  rw [hgraph] at hbits
  have hone :
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedOneAt
        A strategy hwin initialTag env (n + 1)).2.1 = true := by
    simpa [
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedOneAt,
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedTwoAt]
      using hbits.1
  have htwo :
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedTwoAt
        A strategy hwin initialTag env (n + 1)).2.1 = false := by
    simpa [
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedOneAt,
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedTwoAt]
      using hbits.2
  simp [
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBlindBaseAt,
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBaseAt,
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRightBase,
    hone, htwo]

/-- Immediately after a strict-right round, left mirror. -/
theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowLeftBlindBaseAt_succ_of_right
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) (n : Nat)
    (hgraph : (env n).graph = .right) :
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowLeftBlindBaseAt
        A strategy hwin initialTag env (n + 1) =
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowLeftBaseAt
        A strategy hwin initialTag env (n + 1) := by
  have hbits :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt_succ_selected_lastRecv
      A strategy hwin initialTag env n
  rw [hgraph] at hbits
  have hone :
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedOneAt
        A strategy hwin initialTag env (n + 1)).2.1 = false := by
    simpa [
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedOneAt,
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedTwoAt]
      using hbits.1
  have htwo :
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedTwoAt
        A strategy hwin initialTag env (n + 1)).2.1 = true := by
    simpa [
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedOneAt,
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedTwoAt]
      using hbits.2
  simp [
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowLeftBlindBaseAt,
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowLeftBaseAt,
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartLeftBase,
    hone, htwo]

/-- The actually blind right sender obeys the linked no-receive recurrence. -/
theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBlindBaseAt_succ_of_right_sender
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂)
    (hnoBoth : ∀ m : Nat, (env m).graph ≠ .both)
    (n : Nat) (hgraph : (env n).graph = .right) :
    (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBlindBaseAt
        A strategy hwin initialTag env (n + 1)).1.1 =
      (profiledRawJointRightFinitePayloadLiteralPrefixSenderNoRecv A
        (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBlindBaseAt
          A strategy hwin initialTag env n).1.1 (env n).inputOne).2 := by
  obtain ⟨one, payloadOne, two, payloadTwo, hpair⟩ :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt_open_of_noBoth
      A strategy hwin initialTag env hnoBoth n
  have hnext :
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
          A strategy hwin initialTag env (n + 1) =
        ((profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartNoRecvOne
            A strategy hwin
              (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                A strategy hwin initialTag env n).1 (env n).inputOne).1,
          (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowOpenRecvTwo
            A strategy hwin
              (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
                A strategy hwin initialTag)
              (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                A strategy hwin initialTag env n).2 (env n).inputTwo
              (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                A strategy hwin initialTag env n).1 (env n).inputOne).1) := by
    rw [
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt,
      FiniteAcknowledgedDelayedCarrier.exactClosingSemanticPairTrace,
      hgraph]
    rfl
  simp only [
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBlindBaseAt,
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedOneAt]
  rw [hnext, hpair]
  rfl

/-- Blind left-sender mirror. -/
theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowLeftBlindBaseAt_succ_of_left_sender
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂)
    (hnoBoth : ∀ m : Nat, (env m).graph ≠ .both)
    (n : Nat) (hgraph : (env n).graph = .left) :
    (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowLeftBlindBaseAt
        A strategy hwin initialTag env (n + 1)).2.1 =
      (profiledRawJointLeftFinitePayloadLiteralPrefixSenderNoRecv A
        (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowLeftBlindBaseAt
          A strategy hwin initialTag env n).2.1 (env n).inputTwo).2 := by
  obtain ⟨one, payloadOne, two, payloadTwo, hpair⟩ :=
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt_open_of_noBoth
      A strategy hwin initialTag env hnoBoth n
  have hnext :
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
          A strategy hwin initialTag env (n + 1) =
        ((profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowOpenRecvOne
            A strategy hwin
              (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredInitialPair
                A strategy hwin initialTag)
              (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                A strategy hwin initialTag env n).1 (env n).inputOne
              (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                A strategy hwin initialTag env n).2 (env n).inputTwo).1,
          (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredFullRestartNoRecvTwo
            A strategy hwin
              (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt
                A strategy hwin initialTag env n).2 (env n).inputTwo).1) := by
    rw [
      profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSemanticPairAt,
      FiniteAcknowledgedDelayedCarrier.exactClosingSemanticPairTrace,
      hgraph]
    rfl
  simp only [
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowLeftBlindBaseAt,
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowSelectedTwoAt]
  rw [hnext, hpair]
  rfl

/-! ## Exact sender alignment at strict operational cuts -/

/-- At every strict-right cut on a no-`both` run, the executable blind
sender is exactly the sender selected by the receiver's restart base. -/
theorem
    profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBlindBaseAt_cut_sender
    (initialTag : RetainedTag A strategy hwin)
    (env : EnvironmentSequence In₁ In₂)
    (cuts : OperationalCloseCutPackage (fun n ↦ (env n).graph))
    (hnoBoth : ∀ n : Nat, (env n).graph ≠ .both)
    (k : Nat) (hgraph : (env (cuts.cuts k)).graph = .right) :
    (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBlindBaseAt
        A strategy hwin initialTag env (cuts.cuts k)).1.1 =
      (profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBaseAt
        A strategy hwin initialTag env (cuts.cuts k)).1.1 := by
  cases k with
  | zero =>
      rw [cuts.cuts_zero]
      exact
        profiledRawJointHybridValidatedMarkedLiteralPrefixBankLinkedDeferredPhaseRestartRowRightBlindBaseAt_zero_sender
          A strategy hwin initialTag env
  | succ k =>
      have hstrict : (env (cuts.cuts k)).graph ≠ .both := hnoBoth _
      have hchange := cuts.maximal_of_strict k hstrict
      have hprevious : (env (cuts.cuts k)).graph = .left := by
        cases hp : (env (cuts.cuts k)).graph with
        | left => rfl
        | right => exact False.elim (hchange (hgraph.trans hp.symm))
        | both => exact False.elim (hstrict hp)
      have hclosingIndex :
          cuts.cuts (k + 1) - 1 = cuts.cuts k + cuts.openLength k := by
        rw [cuts.step_eq]
        omega
