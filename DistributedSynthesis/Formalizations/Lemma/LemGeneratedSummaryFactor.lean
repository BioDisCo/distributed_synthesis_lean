import DistributedSynthesis.Formalizations.Lemma.LemAndShortLongFailure

/-!
# Finite generated-semigroup factor certificates

A finite calculation about path-summary algebras is useful only after its
closure argument has been made explicit.  The certificate below records a
finite carrier closed under every edge letter, together with simultaneous
interpretations in two summary algebras.  If the first interpretation
determines the second on the carrier, then the first path summary determines
the second on every word.

This is the proof-producing interface used by the Boolean-AND E₁ experiment:
the finite search is not a bounded-depth argument.  Its transition table must
cover the whole semigroup generated by the four edge letters.
-/

namespace DistributedSynthesis

universe u v w x

section GeneratedSummaryFactor

variable {Edge : Type u}
variable (S : PathSummarySemigroup.{u, v} Edge)
variable (T : PathSummarySemigroup.{u, w} Edge)

/-- A finite simultaneous presentation of the subsemigroup generated by the
edge letters in `S` and `T`. -/
structure GeneratedSummaryFactorCertificate where
  Carrier : Type x
  carrierFinite : Fintype Carrier
  initial : Carrier
  step : Carrier -> Edge -> Carrier
  valueS : Carrier -> S.Summary
  valueT : Carrier -> T.Summary
  valueS_initial : valueS initial = S.empty
  valueT_initial : valueT initial = T.empty
  valueS_step : ∀ q e,
    valueS (step q e) = S.multiply (valueS q) (S.ofEdge e)
  valueT_step : ∀ q e,
    valueT (step q e) = T.multiply (valueT q) (T.ofEdge e)
  factor : ∀ q r, valueS q = valueS r -> valueT q = valueT r

attribute [instance] GeneratedSummaryFactorCertificate.carrierFinite

namespace GeneratedSummaryFactorCertificate

variable {S T}

/-- Every word is represented by the certified generated carrier in both
summary algebras simultaneously. -/
theorem represents (C : GeneratedSummaryFactorCertificate S T)
    (word : List Edge) :
    ∃ q : C.Carrier,
      C.valueS q = pathSummaryValue S word ∧
        C.valueT q = pathSummaryValue T word := by
  induction word using List.reverseRecOn with
  | nil =>
      exact ⟨C.initial, C.valueS_initial, C.valueT_initial⟩
  | append_singleton word edge ih =>
      obtain ⟨q, hS, hT⟩ := ih
      refine ⟨C.step q edge, ?_, ?_⟩
      · rw [C.valueS_step, hS]
        simp [pathSummaryValue, List.foldl_append]
      · rw [C.valueT_step, hT]
        simp [pathSummaryValue, List.foldl_append]

/-- The certified first summary factors the second summary on every word. -/
theorem determines (C : GeneratedSummaryFactorCertificate S T)
    {u v : List Edge}
    (h : pathSummaryValue S u = pathSummaryValue S v) :
    pathSummaryValue T u = pathSummaryValue T v := by
  obtain ⟨qu, hSu, hTu⟩ := C.represents u
  obtain ⟨qv, hSv, hTv⟩ := C.represents v
  exact hTu.symm.trans
    ((C.factor qu qv (hSu.trans (h.trans hSv.symm))).trans hTv)

end GeneratedSummaryFactorCertificate

end GeneratedSummaryFactor

end DistributedSynthesis
