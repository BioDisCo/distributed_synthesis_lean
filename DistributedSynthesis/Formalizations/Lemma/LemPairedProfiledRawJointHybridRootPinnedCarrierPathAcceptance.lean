import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledRawJointHybridRootPinnedPathAcceptance
import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledRawJointHybridRootPinnedPersistentControllerBank
import DistributedSynthesis.Formalizations.Lemma.LemFiniteGlobalBeliefReadback

/-!
# Root-pinned acceptance for an abstract carrier close trace

The concrete leader-free carrier may spend many physical rounds inside one
block.  Acceptance of its finite policy path only reads the guarded states at
the selected close cuts.  This file isolates that adapter.

The first close is the literal state reached by the actual first child of the
one root-pinned policy.  Every later close is an `AllowedTarget` edge of that
same policy.  Consequently the positive-time child-code word is accepted
from the code-DPA control already reached at the first child.  No objective
automaton is reset and no policy is selected below a close.
-/

namespace DistributedSynthesis

universe u v w x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

noncomputable section

variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁]
  [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]

variable
  (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
  (hwin : ∀ env : EnvironmentSequence In₁ In₂,
    A.Accepts (execution strategy env))

/-! ## Sequence-level adapter -/

/-- Child-code word emitted after the actual first guarded child.  Position
`n` is the code carried by close state `n+1`; the DPA control at close state
zero has already consumed `firstChild`. -/
abbrev profiledRawJointHybridInitialRootPinnedCloseCodeWord
    (first : In₁ × In₂)
    (states : Nat →
      ProfiledRawJointHybridInitialRootPinnedGuardedState A strategy first) :
    OmegaWord (ProfiledRawJointHybridCode A) :=
  fun n ↦ (states (n + 1)).2.1

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- Abstract close-state adapter with the source rewritten to the literal
state of the actual first child.  This is the direct consumer of a carrier
invariant saying that every close follows a guarded `AllowedTarget` edge. -/
theorem
    profiledRawJointHybridInitialRootPinned_acceptsFrom_actualFirstChild_of_closePath
    (first : In₁ × In₂)
    (firstChild : ProfiledRawJointHybridCode A)
    (states : Nat →
      ProfiledRawJointHybridInitialRootPinnedGuardedState A strategy first)
    (hzero : states 0 =
      (profiledRawJointHybridInitialRootPinnedPolicy A strategy hwin first
        ).policy.run [firstChild])
    (hstep : ∀ n,
      ProfiledRawJointHybridInitialRootPinnedAllowedTarget A strategy hwin
        first (states n) (states (n + 1))) :
    (profiledRawJointHybridCodeParityDPA A
      (ProfiledRawJointHybridInitialRootPinnedCode A strategy first)
      ).AcceptsFrom
        ((profiledRawJointHybridInitialRootPinnedPolicy A strategy hwin first
          ).policy.run [firstChild]).2.2
        (profiledRawJointHybridInitialRootPinnedCloseCodeWord A strategy first
          states) := by
  have haccepts :=
    profiledRawJointHybridInitialRootPinned_acceptsFrom_of_allowedPath A
      strategy hwin first firstChild states hzero hstep
  rw [hzero] at haccepts
  exact haccepts

/-! ## Close paths generated by the guarded persistent controller bank -/

/-- One recurrent close generated by either orientation of the guarded
persistent controller bank.  The indices are exact false/one-sided keys of
one root-pinned policy.  The constructor name is proof-side only and is not a
runtime orientation signal. -/
inductive ProfiledRawJointHybridInitialRootPinnedPersistentCloseStep
    [DecidableEq In₁] [DecidableEq In₂]
    (first : In₁ × In₂) :
    ProfiledRawJointHybridInitialRootPinnedFalseOneSidedKey A strategy hwin
        first →
      ProfiledRawJointHybridInitialRootPinnedFalseOneSidedKey A strategy hwin
        first → Prop
  | right
      (source :
        ProfiledRawJointHybridInitialRootPinnedPersistentRightMacro A strategy
          hwin first)
      (row : PairedEntryRow) (past : List (In₂ × In₁))
      (input : In₂ × In₁) :
      ProfiledRawJointHybridInitialRootPinnedPersistentCloseStep first
        source.key (source.closeKey A strategy hwin first row past input)
  | left
      (source :
        ProfiledRawJointHybridInitialRootPinnedPersistentLeftMacro A strategy
          hwin first)
      (row : PairedEntryRow) (past : List (In₁ × In₂))
      (input : In₁ × In₂) :
      ProfiledRawJointHybridInitialRootPinnedPersistentCloseStep first
        source.key (source.closeKey A strategy hwin first row past input)

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- Every controller-bank close step is literally an `AllowedTarget` edge of
the same guarded policy. -/
theorem
    ProfiledRawJointHybridInitialRootPinnedPersistentCloseStep.allowed
    [DecidableEq In₁] [DecidableEq In₂]
    {first : In₁ × In₂}
    {source target :
      ProfiledRawJointHybridInitialRootPinnedFalseOneSidedKey A strategy hwin
        first}
    (hstep :
      ProfiledRawJointHybridInitialRootPinnedPersistentCloseStep A strategy
        hwin first source target) :
    ProfiledRawJointHybridInitialRootPinnedAllowedTarget A strategy hwin first
      source.state target.state := by
  cases hstep with
  | right source row past input =>
      exact source.close_allowed A strategy hwin first row past input
  | left source row past input =>
      exact source.close_allowed A strategy hwin first row past input

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- A recurrent path assembled from the guarded controller bank therefore
inherits acceptance from its actual first-child control.  This endpoint does
not restart at the root; `hzero` fixes the already-consumed child exactly. -/
theorem
    profiledRawJointHybridInitialRootPinned_acceptsFrom_actualFirstChild_of_persistentClosePath
    [DecidableEq In₁] [DecidableEq In₂]
    (first : In₁ × In₂)
    (firstChild : ProfiledRawJointHybridCode A)
    (keys : Nat →
      ProfiledRawJointHybridInitialRootPinnedFalseOneSidedKey A strategy hwin
        first)
    (hzero : (keys 0).state =
      (profiledRawJointHybridInitialRootPinnedPolicy A strategy hwin first
        ).policy.run [firstChild])
    (hstep : ∀ n,
      ProfiledRawJointHybridInitialRootPinnedPersistentCloseStep A strategy
        hwin first (keys n) (keys (n + 1))) :
    (profiledRawJointHybridCodeParityDPA A
      (ProfiledRawJointHybridInitialRootPinnedCode A strategy first)
      ).AcceptsFrom
        ((profiledRawJointHybridInitialRootPinnedPolicy A strategy hwin first
          ).policy.run [firstChild]).2.2
        (fun n ↦ (keys (n + 1)).state.2.1) := by
  apply
    profiledRawJointHybridInitialRootPinned_acceptsFrom_actualFirstChild_of_closePath
      A strategy hwin first firstChild (fun n ↦ (keys n).state) hzero
  intro n
  exact (hstep n).allowed A strategy hwin

/-! ## Finite-global-machine close cuts -/

/-- Guarded states extracted from selected close cuts of a finite global
machine trace.  The cut sequence is intentionally unconstrained here: its
strictness belongs to the later physical block-minimum coupling, whereas
policy-path acceptance needs only the adjacent `AllowedTarget` facts. -/
abbrev profiledRawJointHybridInitialRootPinnedMachineCloseStates
    (first : In₁ × In₂)
    (G : FiniteGlobalRoundMachine.{u, v, w} In₁ In₂)
    (env : EnvironmentSequence In₁ In₂)
    (start : Nat) (cuts : Nat → Nat)
    (closeState : G.State →
      ProfiledRawJointHybridInitialRootPinnedGuardedState A strategy first) :
    Nat → ProfiledRawJointHybridInitialRootPinnedGuardedState A strategy
      first :=
  fun n ↦ closeState (G.globalStateTrace env (start + cuts n))

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- A finite global carrier whose selected close states start at the actual
first child and follow guarded edges has code-DPA acceptance from that exact
child control.  In particular, the conclusion is not based at the original
code-DPA initial state. -/
theorem
    finiteGlobalMachine_profiledRawJointHybridInitialRootPinned_acceptsFrom_of_closePath
    (first : In₁ × In₂)
    (firstChild : ProfiledRawJointHybridCode A)
    (G : FiniteGlobalRoundMachine.{u, v, w} In₁ In₂)
    (env : EnvironmentSequence In₁ In₂)
    (start : Nat) (cuts : Nat → Nat)
    (closeState : G.State →
      ProfiledRawJointHybridInitialRootPinnedGuardedState A strategy first)
    (hzero : closeState (G.globalStateTrace env (start + cuts 0)) =
      (profiledRawJointHybridInitialRootPinnedPolicy A strategy hwin first
        ).policy.run [firstChild])
    (hstep : ∀ n,
      ProfiledRawJointHybridInitialRootPinnedAllowedTarget A strategy hwin
        first
          (closeState (G.globalStateTrace env (start + cuts n)))
          (closeState (G.globalStateTrace env (start + cuts (n + 1))))) :
    (profiledRawJointHybridCodeParityDPA A
      (ProfiledRawJointHybridInitialRootPinnedCode A strategy first)
      ).AcceptsFrom
        ((profiledRawJointHybridInitialRootPinnedPolicy A strategy hwin first
          ).policy.run [firstChild]).2.2
        (fun n ↦
          (closeState
            (G.globalStateTrace env (start + cuts (n + 1)))).2.1) := by
  let states :=
    profiledRawJointHybridInitialRootPinnedMachineCloseStates A strategy first
      G env start cuts closeState
  exact
    profiledRawJointHybridInitialRootPinned_acceptsFrom_actualFirstChild_of_closePath
      A strategy hwin first firstChild states hzero hstep

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- Typed controller-bank specialization of the finite-global-machine
adapter.  A concrete leader-free carrier only has to expose, at its selected
cuts, the exact persistent key and prove that each adjacent pair is one of
the bank's two physical close constructors.  The conclusion remains based
at the control reached by the literal first child. -/
theorem
    finiteGlobalMachine_profiledRawJointHybridInitialRootPinned_acceptsFrom_of_persistentClosePath
    [DecidableEq In₁] [DecidableEq In₂]
    (first : In₁ × In₂)
    (firstChild : ProfiledRawJointHybridCode A)
    (G : FiniteGlobalRoundMachine.{u, v, w} In₁ In₂)
    (env : EnvironmentSequence In₁ In₂)
    (start : Nat) (cuts : Nat → Nat)
    (closeKey : G.State →
      ProfiledRawJointHybridInitialRootPinnedFalseOneSidedKey A strategy hwin
        first)
    (hzero :
      (closeKey (G.globalStateTrace env (start + cuts 0))).state =
        (profiledRawJointHybridInitialRootPinnedPolicy A strategy hwin first
          ).policy.run [firstChild])
    (hstep : ∀ n,
      ProfiledRawJointHybridInitialRootPinnedPersistentCloseStep A strategy
        hwin first
          (closeKey (G.globalStateTrace env (start + cuts n)))
          (closeKey (G.globalStateTrace env (start + cuts (n + 1))))) :
    (profiledRawJointHybridCodeParityDPA A
      (ProfiledRawJointHybridInitialRootPinnedCode A strategy first)
      ).AcceptsFrom
        ((profiledRawJointHybridInitialRootPinnedPolicy A strategy hwin first
          ).policy.run [firstChild]).2.2
        (fun n ↦
          (closeKey
            (G.globalStateTrace env (start + cuts (n + 1)))).state.2.1) := by
  let keys := fun n ↦
    closeKey (G.globalStateTrace env (start + cuts n))
  exact
    profiledRawJointHybridInitialRootPinned_acceptsFrom_actualFirstChild_of_persistentClosePath
      A strategy hwin first firstChild keys hzero hstep

end

end DetParityAutomaton

end DistributedSynthesis
