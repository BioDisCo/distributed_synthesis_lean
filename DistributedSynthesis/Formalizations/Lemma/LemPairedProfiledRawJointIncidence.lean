import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledRawJointCrossIncidence
import DistributedSynthesis.Formalizations.Theorem.ThmUniformizationTracking

/-!
# The missing finite cross-incidence coordinate

The two within-lane equality patterns of `ProfiledRawJointFamilyCode` do not
say whether a selected right row and a selected left row are the same hidden
strategy-generated history.  This file adds exactly that finite datum: a
Boolean matrix on the finite row-candidate set.

For a semantic family the matrix records literal equality of the two selected
generated histories.  A direction is coherent when either one pivot is
absent (so the corresponding selected lane is empty), or its two live pivots
are incident.  Coherence is already enough to recover one literal common
source for every row retained by the two pivot patterns; the stronger
all-members `ExactFibreAt` premise is not needed.

The last section defines the source-free suffix comparison which will be the
cross-incidence coordinate after a handoff.  It compares only concrete
environment suffixes, not histories, lambdas, leaders, or orientations known
to a process.
-/

namespace DistributedSynthesis

universe i u v x y s

namespace DetParityAutomaton

variable {I : Type i}
variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

noncomputable section

variable [Fintype I]
variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]

/-! ## Finite enriched code -/

/-- Cross-lane incidence between a right row candidate and a left row
candidate. -/
abbrev ProfiledRawJointCrossIncidence (I : Type i) :=
  ProfiledRawJointCandidate I → ProfiledRawJointCandidate I → Bool

/-- The former finite family code together with its missing cross-incidence
matrix. -/
structure ProfiledRawJointIncidenceCode where
  family : ProfiledRawJointFamilyCode A (I := I)
  cross : ProfiledRawJointCrossIncidence I

omit [Fintype I] [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂] in
/-- Fieldwise extensionality for the incidence-enriched code. -/
theorem ProfiledRawJointIncidenceCode.eq_of_fields
    (left right : ProfiledRawJointIncidenceCode A (I := I))
    (hfamily : left.family = right.family)
    (hcross : left.cross = right.cross) :
    left = right := by
  cases left
  cases right
  simp_all

noncomputable instance : Fintype (ProfiledRawJointIncidenceCode A (I := I)) := by
  classical
  let Rep := ProfiledRawJointFamilyCode A (I := I) ×
    ProfiledRawJointCrossIncidence I
  let e : ProfiledRawJointIncidenceCode A (I := I) ≃ Rep :=
    { toFun := fun code => (code.family, code.cross)
      invFun := fun code => ⟨code.1, code.2⟩
      left_inv := by intro code; cases code; rfl
      right_inv := by intro code; cases code; rfl }
  exact Fintype.ofEquiv Rep e.symm

/-! ## Exact semantic incidence -/

/-- Literal cross-incidence of one semantic family.  Both histories are
generated by the same fixed strategy, so this is equivalently equality of
their two current local views. -/
noncomputable def ProfiledRawJointSemanticFamily.crossIncidence
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (family : ProfiledRawJointSemanticFamily A strategy (I := I)) :
    ProfiledRawJointCrossIncidence I := by
  classical
  exact fun right left =>
    match family.right right.1, family.left left.1 with
    | some rightMember, some leftMember =>
        decide
          (profiledRawProcOneRowHistory rightMember.1 right.2 =
            profiledRawProcTwoRowHistory leftMember.1 left.2)
    | _, _ => false

/-- Finite erasure including the exact cross-incidence matrix. -/
noncomputable def ProfiledRawJointSemanticFamily.incidenceCode
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (family : ProfiledRawJointSemanticFamily A strategy (I := I)) :
    ProfiledRawJointIncidenceCode A (I := I) :=
  { family := family.code A
    cross := family.crossIncidence A }

/-- Shape-aware coherence of one exact direction.  If a pivot is absent, its
selected child lane is empty.  If both pivots are live, they must name the
same literal hidden history. -/
def ProfiledRawJointIncidenceCode.CoherentAt
    (code : ProfiledRawJointIncidenceCode A (I := I))
    (direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂)) : Prop :=
  match code.family.right direction.rightPivot.1,
      code.family.left direction.leftPivot.1 with
  | some _, some _ =>
      code.cross direction.rightPivot direction.leftPivot = true
  | _, _ => True

omit [Fintype I] [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂] in
theorem ProfiledRawJointSemanticFamily.crossIncidence_eq_true_iff
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (family : ProfiledRawJointSemanticFamily A strategy (I := I))
    (right left : ProfiledRawJointCandidate I)
    (rightMember : ProcOnePairedEntryRep strategy × A.State)
    (leftMember : ProcTwoPairedEntryRep strategy × A.State)
    (hright : family.right right.1 = some rightMember)
    (hleft : family.left left.1 = some leftMember) :
    family.crossIncidence A right left = true ↔
      profiledRawProcOneRowHistory rightMember.1 right.2 =
        profiledRawProcTwoRowHistory leftMember.1 left.2 := by
  classical
  simp [ProfiledRawJointSemanticFamily.crossIncidence, hright, hleft]

/-! ## Coherence yields one common literal source -/

omit [Fintype I] [Inhabited Out₁] [Inhabited Out₂] [Fintype In₁] [Fintype In₂] [Fintype Out₁]
    [Fintype Out₂] in
/-- The finite incidence bit is exactly the extra joint fact needed by the
two marginal pivot classes. -/
theorem ProfiledRawJointSemanticFamily.exists_commonSourceAt_of_coherent
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (family : ProfiledRawJointSemanticFamily A strategy (I := I))
    (direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂))
    (hcoherent : (family.incidenceCode A).CoherentAt A direction) :
    Nonempty (ProfiledRawJointCommonSourceAt A family direction) := by
  classical
  cases hright : family.right direction.rightPivot.1 with
  | none =>
      cases hleft : family.left direction.leftPivot.1 with
      | none =>
          refine ⟨{
            base := []
            base_generated := StrategyGeneratedPrefix.empty
            right_source := ?_
            left_source := ?_ }⟩
          · intro index member row hmember hpattern
            simp [ProfiledRawJointSemanticFamily.rightPattern, hmember,
              hright] at hpattern
          · intro index member row hmember hpattern
            simp [ProfiledRawJointSemanticFamily.leftPattern, hmember,
              hleft] at hpattern
      | some leftPivotMember =>
          refine ⟨{
            base := profiledRawProcTwoRowHistory leftPivotMember.1
              direction.leftPivot.2
            base_generated := profiledRawProcTwoRowHistory_generated
              leftPivotMember.1 direction.leftPivot.2
            right_source := ?_
            left_source := ?_ }⟩
          · intro index member row hmember hpattern
            simp [ProfiledRawJointSemanticFamily.rightPattern, hmember,
              hright] at hpattern
          · intro index member row hmember hpattern
            exact family.leftPattern_history_eq_pivot A direction index member
              leftPivotMember hmember hleft row hpattern
  | some rightPivotMember =>
      cases hleft : family.left direction.leftPivot.1 with
      | none =>
          refine ⟨{
            base := profiledRawProcOneRowHistory rightPivotMember.1
              direction.rightPivot.2
            base_generated := profiledRawProcOneRowHistory_generated
              rightPivotMember.1 direction.rightPivot.2
            right_source := ?_
            left_source := ?_ }⟩
          · intro index member row hmember hpattern
            exact family.rightPattern_history_eq_pivot A direction index member
              rightPivotMember hmember hright row hpattern
          · intro index member row hmember hpattern
            simp [ProfiledRawJointSemanticFamily.leftPattern, hmember,
              hleft] at hpattern
      | some leftPivotMember =>
          have hpivots :
              profiledRawProcOneRowHistory rightPivotMember.1
                  direction.rightPivot.2 =
                profiledRawProcTwoRowHistory leftPivotMember.1
                  direction.leftPivot.2 := by
            apply (family.crossIncidence_eq_true_iff A direction.rightPivot
              direction.leftPivot rightPivotMember leftPivotMember hright
                hleft).1
            simpa [ProfiledRawJointIncidenceCode.CoherentAt,
              ProfiledRawJointSemanticFamily.incidenceCode,
              ProfiledRawJointSemanticFamily.code, hright, hleft] using
                hcoherent
          refine ⟨{
            base := profiledRawProcOneRowHistory rightPivotMember.1
              direction.rightPivot.2
            base_generated := profiledRawProcOneRowHistory_generated
              rightPivotMember.1 direction.rightPivot.2
            right_source := ?_
            left_source := ?_ }⟩
          · intro index member row hmember hpattern
            exact family.rightPattern_history_eq_pivot A direction index member
              rightPivotMember hmember hright row hpattern
          · intro index member row hmember hpattern
            exact (family.leftPattern_history_eq_pivot A direction index member
              leftPivotMember hmember hleft row hpattern).trans hpivots.symm

/-! ## Source-free successor incidence -/

/-- Environment suffix of a row in a fresh process-one child (the new right
lane). -/
def ProfiledRawJointFamilyDirection.leftChildSuffix
    (direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂))
    (row : PairedEntryRow) : List (EnvironmentRound In₁ In₂) :=
  direction.leftEnvironmentSuffix row

/-- Environment suffix of a row in a fresh process-two child (the new left
lane). -/
def ProfiledRawJointFamilyDirection.rightChildSuffix
    (direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂))
    (row : PairedEntryRow) : List (EnvironmentRound In₁ In₂) :=
  direction.rightEnvironmentSuffix row

/-! ## Literal child rows are exactly the two suffix replays -/

omit [Fintype I] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂] [Fintype In₁] [Fintype In₂]
    [Fintype Out₁] [Fintype Out₂] in
/-- Every row of a selected process-one child is the common source followed
by the source-free left-child suffix for that row. -/
theorem ProfiledRawJointCommonSourceAt.leftSelectedChild_rowHistory
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {family : ProfiledRawJointSemanticFamily A strategy (I := I)}
    {direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂)}
    (common : ProfiledRawJointCommonSourceAt A family direction)
    (index : I) (child : ProcOnePairedEntryRep strategy × A.State)
    (hchild : family.leftSelectedChild A direction index = some child)
    (row : PairedEntryRow) :
    profiledRawProcOneRowHistory child.1 row =
      extendPrefix strategy common.base (direction.leftChildSuffix row) := by
  rcases family.leftSelectedChild_eq_some_source A direction index child
      hchild with
    ⟨member, sourceRow, hmember, hpattern, rfl⟩
  have hsource := common.left_source index member sourceRow hmember hpattern
  cases sourceRow with
  | first =>
      change member.1.rightHistory = common.base at hsource
      simpa [profiledRawLeftSemanticChildPair, procOneViewClassChild,
        ProfiledRawJointFamilyDirection.leftChildSuffix, hsource] using
        (profiledRawProcOneFreshRowHistory_eq_extendPrefix
          (I := I) strategy common.base common.base_generated direction row)
  | both =>
      change member.1.bothHistory = common.base at hsource
      simpa [profiledRawLeftSemanticChildPair, procOneViewClassChild,
        ProfiledRawJointFamilyDirection.leftChildSuffix, hsource] using
        (profiledRawProcOneFreshRowHistory_eq_extendPrefix
          (I := I) strategy common.base common.base_generated direction row)

omit [Fintype I] [Inhabited In₁] [Inhabited Out₁] [Inhabited Out₂] [Fintype In₁] [Fintype In₂]
    [Fintype Out₁] [Fintype Out₂] in
/-- Process-two/right-block mirror. -/
theorem ProfiledRawJointCommonSourceAt.rightSelectedChild_rowHistory
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {family : ProfiledRawJointSemanticFamily A strategy (I := I)}
    {direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂)}
    (common : ProfiledRawJointCommonSourceAt A family direction)
    (index : I) (child : ProcTwoPairedEntryRep strategy × A.State)
    (hchild : family.rightSelectedChild A direction index = some child)
    (row : PairedEntryRow) :
    profiledRawProcTwoRowHistory child.1 row =
      extendPrefix strategy common.base (direction.rightChildSuffix row) := by
  rcases family.rightSelectedChild_eq_some_source A direction index child
      hchild with
    ⟨member, sourceRow, hmember, hpattern, rfl⟩
  have hsource := common.right_source index member sourceRow hmember hpattern
  cases sourceRow with
  | first =>
      change member.1.leftHistory = common.base at hsource
      simpa [profiledRawRightSemanticChildPair, procTwoViewClassChild,
        ProfiledRawJointFamilyDirection.rightChildSuffix, hsource] using
        (profiledRawProcTwoFreshRowHistory_eq_extendPrefix
          (I := I) strategy common.base common.base_generated direction row)
  | both =>
      change member.1.bothHistory = common.base at hsource
      simpa [profiledRawRightSemanticChildPair, procTwoViewClassChild,
        ProfiledRawJointFamilyDirection.rightChildSuffix, hsource] using
        (profiledRawProcTwoFreshRowHistory_eq_extendPrefix
          (I := I) strategy common.base common.base_generated direction row)

/-- The cross-incidence matrix announced by the finite successor.  Activity
is read from the already computed finite child slots; equality itself is only
equality of the two exact environment suffixes. -/
noncomputable def profiledRawJointSuccessorCrossIncidence
    (direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂))
    (right : I → Option (ProfiledRawRightSlot A))
    (left : I → Option (ProfiledRawLeftSlot A)) :
    ProfiledRawJointCrossIncidence I := by
  classical
  exact fun rightCandidate leftCandidate =>
    match right rightCandidate.1, left leftCandidate.1 with
    | some _, some _ => decide
        (direction.leftChildSuffix rightCandidate.2 =
          direction.rightChildSuffix leftCandidate.2)
    | _, _ => false

/-- Enrich the old source-free successor with its source-free cross-incidence
coordinate. -/
noncomputable def profiledRawJointIncidenceNext
    (code : ProfiledRawJointFamilyCode A (I := I))
    (move : ProfiledRawJointLambdaFamilyMove A (I := I))
    (direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂)) :
    ProfiledRawJointIncidenceCode A (I := I) :=
  let next := profiledRawJointFamilyNext A code move direction
  { family := next
    cross := profiledRawJointSuccessorCrossIncidence A direction next.right
      next.left }

/-! ## Exact successor incidence -/

section
omit [Fintype I] [Inhabited Out₁] [Inhabited Out₂] [Fintype In₁] [Fintype In₂] [Fintype Out₁]
    [Fintype Out₂]

/-- With one literal common source, the semantic child's exact cross-lane
incidence is precisely the source-free suffix matrix installed by the finite
successor.  The inactive cases use the already proved slot equalities; in the
live/live case both histories are extensions of `common.base`, so equality is
equivalent to equality of the two concrete environment suffixes. -/
theorem ProfiledRawJointSemanticFamily.semanticChild_crossIncidence_eq_of_commonSource
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (family : ProfiledRawJointSemanticFamily A strategy (I := I))
    (direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂))
    (common : ProfiledRawJointCommonSourceAt A family direction) :
    (family.semanticChild A direction).crossIncidence A =
      let next := profiledRawJointFamilyNext A (family.code A)
        (family.move A) direction
      profiledRawJointSuccessorCrossIncidence A direction next.right
        next.left := by
  classical
  funext rightCandidate leftCandidate
  rcases rightCandidate with ⟨rightIndex, rightRow⟩
  rcases leftCandidate with ⟨leftIndex, leftRow⟩
  cases hright : family.leftSelectedChild A direction rightIndex with
  | none =>
      have hrightSlot := family.leftSelectedChild_finiteSlot A direction
        rightIndex
      rw [hright] at hrightSlot
      simp only [Option.map_none] at hrightSlot
      simp only [profiledRawJointSuccessorCrossIncidence]
      rw [← hrightSlot]
      simp [ProfiledRawJointSemanticFamily.crossIncidence,
        ProfiledRawJointSemanticFamily.semanticChild,
        hright]
  | some rightChild =>
      cases hleft : family.rightSelectedChild A direction leftIndex with
      | none =>
          have hleftSlot := family.rightSelectedChild_finiteSlot A direction
            leftIndex
          rw [hleft] at hleftSlot
          simp only [Option.map_none] at hleftSlot
          simp only [profiledRawJointSuccessorCrossIncidence]
          rw [← hleftSlot]
          simp [ProfiledRawJointSemanticFamily.crossIncidence,
            ProfiledRawJointSemanticFamily.semanticChild,
            hright, hleft]
      | some leftChild =>
          have hrightSlot := family.leftSelectedChild_finiteSlot A direction
            rightIndex
          have hleftSlot := family.rightSelectedChild_finiteSlot A direction
            leftIndex
          rw [hright] at hrightSlot
          rw [hleft] at hleftSlot
          simp only [Option.map_some] at hrightSlot hleftSlot
          simp only [profiledRawJointSuccessorCrossIncidence]
          rw [← hrightSlot, ← hleftSlot]
          simp only [ProfiledRawJointSemanticFamily.crossIncidence,
            ProfiledRawJointSemanticFamily.semanticChild,
            hright, hleft]
          rw [common.leftSelectedChild_rowHistory A rightIndex rightChild
              hright rightRow,
            common.rightSelectedChild_rowHistory A leftIndex leftChild
              hleft leftRow]
          exact Bool.decide_congr
            (extendPrefix_eq_iff_suffix_eq strategy common.base
              (direction.leftChildSuffix rightRow)
              (direction.rightChildSuffix leftRow))

/-- The full enriched semantic child code, including cross-incidence, is the
finite source-free successor. -/
theorem ProfiledRawJointSemanticFamily.semanticChild_incidenceCode_eq_of_commonSource
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (family : ProfiledRawJointSemanticFamily A strategy (I := I))
    (direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂))
    (common : ProfiledRawJointCommonSourceAt A family direction) :
    (family.semanticChild A direction).incidenceCode A =
      profiledRawJointIncidenceNext A (family.code A) (family.move A)
        direction := by
  apply ProfiledRawJointIncidenceCode.eq_of_fields A
  · exact family.semanticChild_code_eq_of_commonSource A direction common
  · simpa [profiledRawJointIncidenceNext] using
      family.semanticChild_crossIncidence_eq_of_commonSource A direction
        common

/-- Coherence of the current finite incidence code is sufficient to produce
one literal semantic child realizing the entire enriched finite successor.
No all-members exact-fibre premise is used. -/
theorem ProfiledRawJointSemanticFamily.exists_semanticChild_incidenceCode_eq_of_coherent
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (family : ProfiledRawJointSemanticFamily A strategy (I := I))
    (direction : ProfiledRawJointFamilyDirection
      (I := I) (In₁ := In₁) (In₂ := In₂))
    (hcoherent : (family.incidenceCode A).CoherentAt A direction) :
    ∃ child : ProfiledRawJointSemanticFamily A strategy (I := I),
      child.incidenceCode A =
        profiledRawJointIncidenceNext A (family.code A) (family.move A)
          direction := by
  classical
  let common := Classical.choice
    (family.exists_commonSourceAt_of_coherent A direction hcoherent)
  exact ⟨family.semanticChild A direction,
    family.semanticChild_incidenceCode_eq_of_commonSource A direction common⟩

end

end

end DetParityAutomaton

end DistributedSynthesis
