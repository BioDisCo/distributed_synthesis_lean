import DistributedSynthesis.Formalizations.Lemma.LemPairedProfiledRawJointOneSidedPhysicalCompatiblePolicyBankLocalPhaseLiveOwnerFibreTraceAlignment

/-!
# Realizable rollback monitor for the owner-fibre carrier

The parent-only rollback relation is a useful finite overapproximation, but it
forgets the phase, pending member, and current inputs.  This file retains the
full pair of owner-fibre controls and the current input pair.  Its finite edge
graph is therefore the exact transition graph generated by physical graph
choices and next-round inputs.  A separate coordinate stores the actual DPA
run state; it must not be identified with the policy state stored at the
active parent after a rollback.
-/

namespace DistributedSynthesis

universe u v x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

noncomputable section

variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁]
  [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
variable [DecidableEq In₁] [DecidableEq In₂]

variable
  (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
  (hwin : ∀ env : EnvironmentSequence In₁ In₂,
    A.Accepts (execution strategy env))

private abbrev OneControl :=
  ProfiledRawJointRecurrentOwnerFibreBoundaryOneControl A strategy hwin

private abbrev TwoControl :=
  ProfiledRawJointRecurrentOwnerFibreBoundaryTwoControl A strategy hwin

private abbrev BankControl :=
  ProfiledRawJointOneSidedPhysicalCompatibleBankControl A strategy hwin

private abbrev RootKey :=
  ProfiledRawJointOneSidedPhysicalCompatibleRootKey A strategy

/-- The active bank parent decoded from an arbitrary operational pair.  The
definition uses proof-side selection only; `parent_eq` shows that the result
does not depend on which decoder witness is selected. -/
noncomputable def profiledRawJointRecurrentOwnerFibreBoundaryActiveParent
    (one : OneControl A strategy hwin)
    (two : TwoControl A strategy hwin)
    (hoperational :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        one two)
    (input : In₁ × In₂) : BankControl A strategy hwin :=
  (ProfiledRawJointRecurrentOwnerFibreBoundaryResolverObservation.ofSelected A
    strategy hwin hoperational.selected (input := input)).parent A strategy
      hwin

/-- Any resolver observation of the same operational controls yields the
active parent chosen above. -/
theorem profiledRawJointRecurrentOwnerFibreBoundaryActiveParent_eq
    (one : OneControl A strategy hwin)
    (two : TwoControl A strategy hwin)
    (hoperational :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        one two)
    (input : In₁ × In₂)
    (observation :
      ProfiledRawJointRecurrentOwnerFibreBoundaryResolverObservation A
        strategy hwin one two input) :
    profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
        one two hoperational input =
      observation.parent A strategy hwin := by
  unfold profiledRawJointRecurrentOwnerFibreBoundaryActiveParent
  exact
    (ProfiledRawJointRecurrentOwnerFibreBoundaryResolverObservation.ofSelected
      A strategy hwin hoperational.selected
        (input := input)).parent_eq A strategy hwin observation

/-- If both endpoint controls lie in one root-key fibre, then the active
parent decoded from them lies in that fibre as well. -/
theorem profiledRawJointRecurrentOwnerFibreBoundaryActiveParent_atKey
    (key : RootKey A strategy)
    (one : OneControl A strategy hwin)
    (two : TwoControl A strategy hwin)
    (hoperational :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        one two)
    (input : In₁ × In₂)
    (hone :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOneAtKey A strategy hwin key
        one)
    (htwo :
      ProfiledRawJointRecurrentOwnerFibreBoundaryTwoAtKey A strategy hwin key
        two) :
    (profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
      one two hoperational input).AtKey A strategy hwin key := by
  let observation :=
    ProfiledRawJointRecurrentOwnerFibreBoundaryResolverObservation.ofSelected
      A strategy hwin hoperational.selected (input := input)
  rw [profiledRawJointRecurrentOwnerFibreBoundaryActiveParent_eq A strategy
    hwin one two hoperational input observation]
  exact (observation.atKey A strategy hwin key hone htwo).1

/-- The active-parent selector is extensional in the controls and input; its
value does not depend on the proof used to establish operationality. -/
theorem profiledRawJointRecurrentOwnerFibreBoundaryActiveParent_congr
    (one one' : OneControl A strategy hwin)
    (two two' : TwoControl A strategy hwin)
    (hoperational :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        one two)
    (hoperational' :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        one' two')
    (input input' : In₁ × In₂)
    (hone : one = one') (htwo : two = two') (hinput : input = input') :
    profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
        one two hoperational input =
      profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
        one' two' hoperational' input' := by
  subst one'
  subst two'
  subst input'
  rfl

/-- One physical round of the full semantic owner-fibre control pair. -/
noncomputable def profiledRawJointRecurrentOwnerFibreBoundaryPairStep
    (controls : OneControl A strategy hwin × TwoControl A strategy hwin)
    (input : In₁ × In₂) (graph : Graph) :
    OneControl A strategy hwin × TwoControl A strategy hwin :=
  match graph with
  | .right =>
      ((profiledRawJointRecurrentOwnerFibreBoundaryNoRecvOne A strategy hwin
          controls.1 input.1).1,
        (profiledRawJointRecurrentOwnerFibreBoundaryOpenRecvTwo A strategy
          hwin controls.2 input.2 controls.1 input.1).1)
  | .left =>
      ((profiledRawJointRecurrentOwnerFibreBoundaryOpenRecvOne A strategy hwin
          controls.1 input.1 controls.2 input.2).1,
        (profiledRawJointRecurrentOwnerFibreBoundaryNoRecvTwo A strategy hwin
          controls.2 input.2).1)
  | .both =>
      profiledRawJointRecurrentOwnerFibreBoundaryClose A strategy hwin
        controls.1 input.1 controls.2 input.2

/-- A physical pair step cannot move between root-key fibres.  This is the
key locality fact needed to separate the later parity regularization across
distinct root keys. -/
theorem profiledRawJointRecurrentOwnerFibreBoundaryPairStep_atKey
    (key : RootKey A strategy)
    (controls : OneControl A strategy hwin × TwoControl A strategy hwin)
    (hone :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOneAtKey A strategy hwin key
        controls.1)
    (htwo :
      ProfiledRawJointRecurrentOwnerFibreBoundaryTwoAtKey A strategy hwin key
        controls.2)
    (input : In₁ × In₂) (graph : Graph) :
    ProfiledRawJointRecurrentOwnerFibreBoundaryOneAtKey A strategy hwin key
        (profiledRawJointRecurrentOwnerFibreBoundaryPairStep A strategy hwin
          controls input graph).1 ∧
      ProfiledRawJointRecurrentOwnerFibreBoundaryTwoAtKey A strategy hwin key
        (profiledRawJointRecurrentOwnerFibreBoundaryPairStep A strategy hwin
          controls input graph).2 := by
  cases graph with
  | right =>
      exact ⟨by
          simpa [profiledRawJointRecurrentOwnerFibreBoundaryPairStep] using
            hone.noRecv A strategy hwin key controls.1 input.1,
        by
          simpa [profiledRawJointRecurrentOwnerFibreBoundaryPairStep] using
            profiledRawJointRecurrentOwnerFibreBoundaryOpenRecvTwo_atKey A
              strategy hwin key controls.2 input.2 controls.1 input.1 htwo
                hone⟩
  | left =>
      exact ⟨by
          simpa [profiledRawJointRecurrentOwnerFibreBoundaryPairStep] using
            profiledRawJointRecurrentOwnerFibreBoundaryOpenRecvOne_atKey A
              strategy hwin key controls.1 input.1 controls.2 input.2 hone
                htwo,
        by
          simpa [profiledRawJointRecurrentOwnerFibreBoundaryPairStep] using
            htwo.noRecv A strategy hwin key controls.2 input.2⟩
  | both =>
      simpa [profiledRawJointRecurrentOwnerFibreBoundaryPairStep] using
        profiledRawJointRecurrentOwnerFibreBoundaryClose_atKey A strategy hwin
          key controls.1 input.1 controls.2 input.2 hone htwo

/-- The canonical semantic control trace obeys the combined pair-step
equation for every physical graph. -/
theorem profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace_succ_step
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (env : EnvironmentSequence In₁ In₂) (n : Nat) :
    profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace A strategy
        hwin initialOne initialTwo env (n + 1) =
      profiledRawJointRecurrentOwnerFibreBoundaryPairStep A strategy hwin
        (profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace A
          strategy hwin initialOne initialTwo env n)
        ((env n).inputOne, (env n).inputTwo) (env n).graph := by
  cases hgraph : (env n).graph with
  | right =>
      simpa [profiledRawJointRecurrentOwnerFibreBoundaryPairStep] using
        profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace_succ_right
          A strategy hwin initialOne initialTwo env n hgraph
  | left =>
      simpa [profiledRawJointRecurrentOwnerFibreBoundaryPairStep] using
        profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace_succ_left
          A strategy hwin initialOne initialTwo env n hgraph
  | both =>
      simpa [profiledRawJointRecurrentOwnerFibreBoundaryPairStep] using
        profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace_succ_both
          A strategy hwin initialOne initialTwo env n hgraph

/-- Finite state of the realizable rollback monitor. -/
abbrev ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂) :=
  (OneControl A strategy hwin × TwoControl A strategy hwin) ×
    ((In₁ × In₂) ×
      (sourceFreeBeliefParentLinkedCodeParityDPA
        (Annotation := ProfiledRawJointHybridPhysicalEdgeAnnotation A)
        (profiledRawJointOneSidedCodeParityDPA A
          (profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy
            hwin initialOne initialTwo hinitial initialInput).1.1.1)).State)

/-- Fixed entry of the realizable monitor. -/
noncomputable def
    profiledRawJointRecurrentOwnerFibreRealizableMonitorInitial
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂) :
    ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy hwin
      initialOne initialTwo hinitial initialInput :=
  ((initialOne, initialTwo),
    (initialInput,
      (profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
        initialOne initialTwo hinitial initialInput).2.2))

/-- All and only one-round transitions of operational full control pairs,
augmented by the deterministic DPA update on the next active parent's linked
code.  The target input is stored in the target vertex and is unrestricted,
as it is the environment's next-round choice. -/
noncomputable def
    profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂) :
    Finset
      (ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy
          hwin initialOne initialTwo hinitial initialInput ×
        ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy
          hwin initialOne initialTwo hinitial initialInput) := by
  classical
  let D :=
    sourceFreeBeliefParentLinkedCodeParityDPA
      (Annotation := ProfiledRawJointHybridPhysicalEdgeAnnotation A)
      (profiledRawJointOneSidedCodeParityDPA A
        (profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy
          hwin initialOne initialTwo hinitial initialInput).1.1.1)
  exact Finset.univ.filter (fun edge ↦
    ∃ hsource :
        ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
          edge.1.1.1 edge.1.1.2,
      ∃ htarget :
          ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy
            hwin edge.2.1.1 edge.2.1.2,
        ∃ graph : Graph,
          edge.2.1 =
              profiledRawJointRecurrentOwnerFibreBoundaryPairStep A strategy
                hwin edge.1.1 edge.1.2.1 graph ∧
            edge.2.2.2 = D.step edge.1.2.2
              (profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A
                strategy hwin edge.2.1.1 edge.2.1.2 htarget
                  edge.2.2.1).2.1)

/-- The control update carried by a realizable-monitor edge has a physical
graph witness. -/
theorem
    profiledRawJointRecurrentOwnerFibreRealizableMonitorEdge_exists_graph
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂)
    (source target :
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy
        hwin initialOne initialTwo hinitial initialInput)
    (hedge :
      (source, target) ∈
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy
          hwin initialOne initialTwo hinitial initialInput) :
    ∃ graph : Graph,
      target.1 =
        profiledRawJointRecurrentOwnerFibreBoundaryPairStep A strategy hwin
          source.1 source.2.1 graph := by
  simp only [profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges,
    Finset.mem_filter, Finset.mem_univ, true_and] at hedge
  obtain ⟨_hsource, _htarget, graph, hcontrols, _hdpa⟩ := hedge
  exact ⟨graph, hcontrols⟩

/-- A proof-side physical graph selected from a realizable-monitor edge. -/
noncomputable def
    profiledRawJointRecurrentOwnerFibreRealizableMonitorEdgeGraph
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂)
    (source target :
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy
        hwin initialOne initialTwo hinitial initialInput)
    (hedge :
      (source, target) ∈
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy
          hwin initialOne initialTwo hinitial initialInput) : Graph :=
  Classical.choose
    (profiledRawJointRecurrentOwnerFibreRealizableMonitorEdge_exists_graph A
      strategy hwin initialOne initialTwo hinitial initialInput source target
        hedge)

/-- The selected graph realizes the control update recorded by its edge. -/
theorem
    profiledRawJointRecurrentOwnerFibreRealizableMonitorEdgeGraph_spec
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂)
    (source target :
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy
        hwin initialOne initialTwo hinitial initialInput)
    (hedge :
      (source, target) ∈
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy
          hwin initialOne initialTwo hinitial initialInput) :
    target.1 =
      profiledRawJointRecurrentOwnerFibreBoundaryPairStep A strategy hwin
        source.1 source.2.1
          (profiledRawJointRecurrentOwnerFibreRealizableMonitorEdgeGraph A
            strategy hwin initialOne initialTwo hinitial initialInput source
              target hedge) :=
  Classical.choose_spec
    (profiledRawJointRecurrentOwnerFibreRealizableMonitorEdge_exists_graph A
      strategy hwin initialOne initialTwo hinitial initialInput source target
        hedge)

/-- The target control pair of every monitor edge is operational. -/
theorem
    profiledRawJointRecurrentOwnerFibreRealizableMonitorEdge_target_operational
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂)
    (source target :
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy
        hwin initialOne initialTwo hinitial initialInput)
    (hedge :
      (source, target) ∈
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy
          hwin initialOne initialTwo hinitial initialInput) :
    ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
      target.1.1 target.1.2 := by
  simp only [profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges,
    Finset.mem_filter, Finset.mem_univ, true_and] at hedge
  exact hedge.2.1

/-- Every path from a fixed-fibre monitor entry remains in that same fibre.
In particular, no environment or physical graph schedule can make a monitor
path consult a policy selected for a different root key. -/
theorem profiledRawJointRecurrentOwnerFibreRealizableMonitorPath_atKey
    (key : RootKey A strategy)
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂)
    (hone :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOneAtKey A strategy hwin key
        initialOne)
    (htwo :
      ProfiledRawJointRecurrentOwnerFibreBoundaryTwoAtKey A strategy hwin key
        initialTwo)
    (walk : Nat →
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy hwin
        initialOne initialTwo hinitial initialInput)
    (hzero :
      walk 0 =
        profiledRawJointRecurrentOwnerFibreRealizableMonitorInitial A strategy
          hwin initialOne initialTwo hinitial initialInput)
    (hedges : ∀ n : Nat,
      (walk n, walk (n + 1)) ∈
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy
          hwin initialOne initialTwo hinitial initialInput) :
    ∀ n : Nat,
      ProfiledRawJointRecurrentOwnerFibreBoundaryOneAtKey A strategy hwin key
          (walk n).1.1 ∧
        ProfiledRawJointRecurrentOwnerFibreBoundaryTwoAtKey A strategy hwin key
          (walk n).1.2 := by
  intro n
  induction n with
  | zero =>
      rw [hzero]
      exact ⟨hone, htwo⟩
  | succ n ih =>
      rw [profiledRawJointRecurrentOwnerFibreRealizableMonitorEdgeGraph_spec A
        strategy hwin initialOne initialTwo hinitial initialInput (walk n)
          (walk (n + 1)) (hedges n)]
      exact profiledRawJointRecurrentOwnerFibreBoundaryPairStep_atKey A
        strategy hwin key (walk n).1 ih.1 ih.2 (walk n).2.1
          (profiledRawJointRecurrentOwnerFibreRealizableMonitorEdgeGraph A
            strategy hwin initialOne initialTwo hinitial initialInput (walk n)
              (walk (n + 1)) (hedges n))

/-- Every vertex of a realizable-monitor path carries an operational control
pair. -/
theorem profiledRawJointRecurrentOwnerFibreRealizableMonitorPath_operational
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂)
    (walk : Nat →
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy hwin
        initialOne initialTwo hinitial initialInput)
    (hzero :
      walk 0 =
        profiledRawJointRecurrentOwnerFibreRealizableMonitorInitial A strategy
          hwin initialOne initialTwo hinitial initialInput)
    (hedges : ∀ n : Nat,
      (walk n, walk (n + 1)) ∈
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy
          hwin initialOne initialTwo hinitial initialInput) :
    ∀ n : Nat,
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        (walk n).1.1 (walk n).1.2 := by
  intro n
  cases n with
  | zero =>
      rw [hzero]
      exact hinitial
  | succ n =>
      exact
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdge_target_operational
          A strategy hwin initialOne initialTwo hinitial initialInput (walk n)
            (walk (n + 1)) (hedges n)

/-- Along a fixed-fibre monitor path, every decoded active parent has the
same root key.  Thus the path consults only the one policy chosen at that
key. -/
theorem profiledRawJointRecurrentOwnerFibreRealizableMonitorPath_activeParent_atKey
    (key : RootKey A strategy)
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂)
    (hone :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOneAtKey A strategy hwin key
        initialOne)
    (htwo :
      ProfiledRawJointRecurrentOwnerFibreBoundaryTwoAtKey A strategy hwin key
        initialTwo)
    (walk : Nat →
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy hwin
        initialOne initialTwo hinitial initialInput)
    (hzero :
      walk 0 =
        profiledRawJointRecurrentOwnerFibreRealizableMonitorInitial A strategy
          hwin initialOne initialTwo hinitial initialInput)
    (hedges : ∀ n : Nat,
      (walk n, walk (n + 1)) ∈
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy
          hwin initialOne initialTwo hinitial initialInput) :
    ∀ n : Nat,
      let hoperational :=
        profiledRawJointRecurrentOwnerFibreRealizableMonitorPath_operational A
          strategy hwin initialOne initialTwo hinitial initialInput walk hzero
            hedges n
      (profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
        (walk n).1.1 (walk n).1.2 hoperational (walk n).2.1).AtKey A strategy
          hwin key := by
  intro n
  exact
    profiledRawJointRecurrentOwnerFibreBoundaryActiveParent_atKey A strategy
      hwin key (walk n).1.1 (walk n).1.2 _ (walk n).2.1
        (profiledRawJointRecurrentOwnerFibreRealizableMonitorPath_atKey A
          strategy hwin key initialOne initialTwo hinitial initialInput hone
            htwo walk hzero hedges n).1
        (profiledRawJointRecurrentOwnerFibreRealizableMonitorPath_atKey A
          strategy hwin key initialOne initialTwo hinitial initialInput hone
            htwo walk hzero hedges n).2

/-- The DPA coordinate of a monitor edge is the deterministic update on the
target active-parent code. -/
theorem
    profiledRawJointRecurrentOwnerFibreRealizableMonitorEdge_dpa
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂)
    (source target :
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy
        hwin initialOne initialTwo hinitial initialInput)
    (hedge :
      (source, target) ∈
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy
          hwin initialOne initialTwo hinitial initialInput)
    (htarget :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        target.1.1 target.1.2) :
    let D :=
      sourceFreeBeliefParentLinkedCodeParityDPA
        (Annotation := ProfiledRawJointHybridPhysicalEdgeAnnotation A)
        (profiledRawJointOneSidedCodeParityDPA A
          (profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy
            hwin initialOne initialTwo hinitial initialInput).1.1.1)
    target.2.2 = D.step source.2.2
      (profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
        target.1.1 target.1.2 htarget target.2.1).2.1 := by
  simp only [profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges,
    Finset.mem_filter, Finset.mem_univ, true_and] at hedge
  obtain ⟨_hsource, htarget', _graph, _hcontrols, hdpa⟩ := hedge
  simpa only using hdpa

/-- Reconstruct the environment encoded by an infinite monitor path.  Inputs
are read from the current vertex, and the current graph is the edge witness
selected above. -/
noncomputable def
    profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂)
    (walk : Nat →
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy hwin
        initialOne initialTwo hinitial initialInput)
    (hedges : ∀ n : Nat,
      (walk n, walk (n + 1)) ∈
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy
          hwin initialOne initialTwo hinitial initialInput) :
    EnvironmentSequence In₁ In₂ :=
  fun n ↦
    let input := match n with
      | 0 => initialInput
      | m + 1 => (walk (m + 1)).2.1
    { inputOne := input.1
      inputTwo := input.2
      graph :=
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdgeGraph A
          strategy hwin initialOne initialTwo hinitial initialInput (walk n)
            (walk (n + 1)) (hedges n) }

/-- The reconstructed environment carries precisely the input stored at each
path vertex.  The zero case uses the fixed entry equation. -/
theorem
    profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment_input
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂)
    (walk : Nat →
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy hwin
        initialOne initialTwo hinitial initialInput)
    (hzero :
      walk 0 =
        profiledRawJointRecurrentOwnerFibreRealizableMonitorInitial A strategy
          hwin initialOne initialTwo hinitial initialInput)
    (hedges : ∀ n : Nat,
      (walk n, walk (n + 1)) ∈
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy
          hwin initialOne initialTwo hinitial initialInput) :
    ∀ n : Nat,
      let env :=
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment A
          strategy hwin initialOne initialTwo hinitial initialInput walk hedges
      ((env n).inputOne, (env n).inputTwo) = (walk n).2.1 := by
  intro n
  cases n with
  | zero =>
      simpa [profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment,
        profiledRawJointRecurrentOwnerFibreRealizableMonitorInitial] using
        congrArg (fun state ↦ state.2.1) hzero.symm
  | succ n => rfl

/-- The semantic control trace driven by the reconstructed environment is
exactly the control projection of the original monitor path. -/
theorem
    profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment_controls
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂)
    (walk : Nat →
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy hwin
        initialOne initialTwo hinitial initialInput)
    (hzero :
      walk 0 =
        profiledRawJointRecurrentOwnerFibreRealizableMonitorInitial A strategy
          hwin initialOne initialTwo hinitial initialInput)
    (hedges : ∀ n : Nat,
      (walk n, walk (n + 1)) ∈
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy
          hwin initialOne initialTwo hinitial initialInput) :
    ∀ n : Nat,
      profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace A strategy
          hwin initialOne initialTwo
            (profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment A
              strategy hwin initialOne initialTwo hinitial initialInput walk
                hedges) n =
        (walk n).1 := by
  intro n
  induction n with
  | zero =>
      simpa [profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace,
        FiniteAcknowledgedDelayedCarrier.exactClosingSemanticPairTrace,
        profiledRawJointRecurrentOwnerFibreRealizableMonitorInitial] using
        congrArg (fun state ↦ state.1) hzero.symm
  | succ n ih =>
      rw [profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace_succ_step,
        ih,
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment_input A
          strategy hwin initialOne initialTwo hinitial initialInput walk hzero
            hedges n]
      exact
        (profiledRawJointRecurrentOwnerFibreRealizableMonitorEdgeGraph_spec A
          strategy hwin initialOne initialTwo hinitial initialInput (walk n)
            (walk (n + 1)) (hedges n)).symm

/-- The DPA coordinate of a path is also reconstructed exactly: it is the
run on the active-parent word of the reconstructed semantic execution. -/
theorem
    profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment_dpa
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂)
    (walk : Nat →
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy hwin
        initialOne initialTwo hinitial initialInput)
    (hzero :
      walk 0 =
        profiledRawJointRecurrentOwnerFibreRealizableMonitorInitial A strategy
          hwin initialOne initialTwo hinitial initialInput)
    (hedges : ∀ n : Nat,
      (walk n, walk (n + 1)) ∈
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy
          hwin initialOne initialTwo hinitial initialInput) :
    let env :=
      profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment A
        strategy hwin initialOne initialTwo hinitial initialInput walk hedges
    let initialParent :=
      profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
        initialOne initialTwo hinitial initialInput
    let D :=
      sourceFreeBeliefParentLinkedCodeParityDPA
        (Annotation := ProfiledRawJointHybridPhysicalEdgeAnnotation A)
        (profiledRawJointOneSidedCodeParityDPA A initialParent.1.1.1)
    let word : OmegaWord _ := fun n ↦
      (profiledRawJointRecurrentOwnerFibreBoundarySemanticTraceParent A
        strategy hwin initialOne initialTwo hinitial env (n + 1)).2.1
    ∀ n : Nat, D.runFrom initialParent.2.2 word n = (walk n).2.2 := by
  dsimp only
  let env :=
    profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment A strategy
      hwin initialOne initialTwo hinitial initialInput walk hedges
  let initialParent :=
    profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
      initialOne initialTwo hinitial initialInput
  let D :=
    sourceFreeBeliefParentLinkedCodeParityDPA
      (Annotation := ProfiledRawJointHybridPhysicalEdgeAnnotation A)
      (profiledRawJointOneSidedCodeParityDPA A initialParent.1.1.1)
  let word : OmegaWord _ := fun n ↦
    (profiledRawJointRecurrentOwnerFibreBoundarySemanticTraceParent A strategy
      hwin initialOne initialTwo hinitial env (n + 1)).2.1
  intro n
  induction n with
  | zero =>
      simpa [D, initialParent,
        profiledRawJointRecurrentOwnerFibreRealizableMonitorInitial] using
        congrArg (fun state ↦ state.2.2) hzero.symm
  | succ n ih =>
      let semanticTarget :=
        profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace A strategy
          hwin initialOne initialTwo env (n + 1)
      have hsemanticTarget :
          ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy
            hwin semanticTarget.1 semanticTarget.2 :=
        profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace_operational
          A strategy hwin initialOne initialTwo hinitial env (n + 1)
      have hparent :=
        profiledRawJointRecurrentOwnerFibreBoundaryActiveParent_eq A strategy
          hwin semanticTarget.1 semanticTarget.2 hsemanticTarget
            ((env (n + 1)).inputOne, (env (n + 1)).inputTwo)
            (profiledRawJointRecurrentOwnerFibreBoundarySemanticTraceObservation
              A strategy hwin initialOne initialTwo hinitial env (n + 1))
      have hparentCode :
          (profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy
            hwin semanticTarget.1 semanticTarget.2 hsemanticTarget
              ((env (n + 1)).inputOne, (env (n + 1)).inputTwo)).2.1 =
            (profiledRawJointRecurrentOwnerFibreBoundarySemanticTraceParent A
              strategy hwin initialOne initialTwo hinitial env (n + 1)).2.1 := by
        simpa only [
          profiledRawJointRecurrentOwnerFibreBoundarySemanticTraceParent] using
          congrArg (fun parent ↦ parent.2.1) hparent
      have hcontrols :=
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment_controls
          A strategy hwin initialOne initialTwo hinitial initialInput walk hzero
            hedges (n + 1)
      have hinput :=
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment_input A
          strategy hwin initialOne initialTwo hinitial initialInput walk hzero
            hedges (n + 1)
      have hwalkTarget :=
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdge_target_operational
          A strategy hwin initialOne initialTwo hinitial initialInput (walk n)
            (walk (n + 1)) (hedges n)
      have hedgeDpa :=
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdge_dpa A strategy
          hwin initialOne initialTwo hinitial initialInput (walk n)
            (walk (n + 1)) (hedges n) hwalkTarget
      have hactive :
          profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy
              hwin semanticTarget.1 semanticTarget.2 hsemanticTarget
                ((env (n + 1)).inputOne, (env (n + 1)).inputTwo) =
            profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy
              hwin (walk (n + 1)).1.1 (walk (n + 1)).1.2 hwalkTarget
                (walk (n + 1)).2.1 := by
        exact
          profiledRawJointRecurrentOwnerFibreBoundaryActiveParent_congr A
            strategy hwin semanticTarget.1 (walk (n + 1)).1.1
              semanticTarget.2 (walk (n + 1)).1.2 hsemanticTarget hwalkTarget
                ((env (n + 1)).inputOne, (env (n + 1)).inputTwo)
                (walk (n + 1)).2.1 (congrArg Prod.fst hcontrols)
                  (congrArg Prod.snd hcontrols) hinput
      change D.step (D.runFrom initialParent.2.2 word n) (word n) =
        (walk (n + 1)).2.2
      rw [ih]
      change D.step (walk n).2.2
        (profiledRawJointRecurrentOwnerFibreBoundarySemanticTraceParent A
          strategy hwin initialOne initialTwo hinitial env (n + 1)).2.1 =
        (walk (n + 1)).2.2
      rw [← hparentCode]
      rw [hactive]
      exact hedgeDpa.symm

/-- Exact finite-graph parity target for one recurrent entry and one first
input pair.  Every infinite path in the realizable full-control product from
the fixed entry has even minimum recurrent DPA priority. -/
def ProfiledRawJointRecurrentOwnerFibreRealizableMonitorAccepting
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂) : Prop :=
  let D :=
    sourceFreeBeliefParentLinkedCodeParityDPA
      (Annotation := ProfiledRawJointHybridPhysicalEdgeAnnotation A)
      (profiledRawJointOneSidedCodeParityDPA A
        (profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy
          hwin initialOne initialTwo hinitial initialInput).1.1.1)
  ∀ walk : Nat →
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy hwin
        initialOne initialTwo hinitial initialInput,
    walk 0 =
        profiledRawJointRecurrentOwnerFibreRealizableMonitorInitial A strategy
          hwin initialOne initialTwo hinitial initialInput →
      (∀ n : Nat,
        (walk n, walk (n + 1)) ∈
          profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy
            hwin initialOne initialTwo hinitial initialInput) →
      ∃ p : Nat,
        NatEven p ∧
          (∀ n : Nat, ∃ k : Nat,
            n ≤ k ∧ D.priority (walk k).2.2 = p) ∧
          ∀ q : Nat,
            (∀ n : Nat, ∃ k : Nat,
              n ≤ k ∧ D.priority (walk k).2.2 = q) →
            p ≤ q

/-- The canonical recurrent execution, augmented by its current inputs and
literal DPA run state, as a path candidate in the realizable monitor. -/
noncomputable def
    profiledRawJointRecurrentOwnerFibreRealizableMonitorTrace
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (env : EnvironmentSequence In₁ In₂) : Nat →
    ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy hwin
      initialOne initialTwo hinitial
        ((env 0).inputOne, (env 0).inputTwo) := by
  let initialInput := ((env 0).inputOne, (env 0).inputTwo)
  let initialParent :=
    profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
      initialOne initialTwo hinitial initialInput
  let D :=
    sourceFreeBeliefParentLinkedCodeParityDPA
      (Annotation := ProfiledRawJointHybridPhysicalEdgeAnnotation A)
      (profiledRawJointOneSidedCodeParityDPA A initialParent.1.1.1)
  let word : OmegaWord _ := fun n ↦
    (profiledRawJointRecurrentOwnerFibreBoundarySemanticTraceParent A strategy
      hwin initialOne initialTwo hinitial env (n + 1)).2.1
  exact fun n ↦
    (profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace A strategy
        hwin initialOne initialTwo env n,
      (((env n).inputOne, (env n).inputTwo),
        D.runFrom initialParent.2.2 word n))

/-- The augmented canonical execution starts at the fixed monitor entry. -/
theorem
    profiledRawJointRecurrentOwnerFibreRealizableMonitorTrace_zero
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (env : EnvironmentSequence In₁ In₂) :
    profiledRawJointRecurrentOwnerFibreRealizableMonitorTrace A strategy hwin
        initialOne initialTwo hinitial env 0 =
      profiledRawJointRecurrentOwnerFibreRealizableMonitorInitial A strategy
        hwin initialOne initialTwo hinitial
          ((env 0).inputOne, (env 0).inputTwo) := by
  rfl

/-- Every successive pair of augmented canonical states is an edge of the
realizable finite monitor. -/
theorem
    profiledRawJointRecurrentOwnerFibreRealizableMonitorTrace_edge
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (env : EnvironmentSequence In₁ In₂) (n : Nat) :
    let trace :=
      profiledRawJointRecurrentOwnerFibreRealizableMonitorTrace A strategy
        hwin initialOne initialTwo hinitial env
    (trace n, trace (n + 1)) ∈
      profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy hwin
        initialOne initialTwo hinitial
          ((env 0).inputOne, (env 0).inputTwo) := by
  dsimp only
  let sourcePair :=
    profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace A strategy
      hwin initialOne initialTwo env n
  let targetPair :=
    profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace A strategy
      hwin initialOne initialTwo env (n + 1)
  have hsource :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        sourcePair.1 sourcePair.2 :=
    profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace_operational A
      strategy hwin initialOne initialTwo hinitial env n
  have htarget :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        targetPair.1 targetPair.2 :=
    profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace_operational A
      strategy hwin initialOne initialTwo hinitial env (n + 1)
  have hcontrols :
      targetPair =
        profiledRawJointRecurrentOwnerFibreBoundaryPairStep A strategy hwin
          sourcePair ((env n).inputOne, (env n).inputTwo) (env n).graph := by
    cases hgraph : (env n).graph with
    | right =>
        simpa [sourcePair, targetPair,
          profiledRawJointRecurrentOwnerFibreBoundaryPairStep] using
          profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace_succ_right
            A strategy hwin initialOne initialTwo env n hgraph
    | left =>
        simpa [sourcePair, targetPair,
          profiledRawJointRecurrentOwnerFibreBoundaryPairStep] using
          profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace_succ_left
            A strategy hwin initialOne initialTwo env n hgraph
    | both =>
        simpa [sourcePair, targetPair,
          profiledRawJointRecurrentOwnerFibreBoundaryPairStep] using
          profiledRawJointRecurrentOwnerFibreBoundarySemanticPairTrace_succ_both
            A strategy hwin initialOne initialTwo env n hgraph
  simp only [profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges,
    Finset.mem_filter, Finset.mem_univ, true_and]
  refine ⟨hsource, htarget, (env n).graph, hcontrols, ?_⟩
  have hparent :=
    profiledRawJointRecurrentOwnerFibreBoundaryActiveParent_eq A strategy hwin
      targetPair.1 targetPair.2 htarget
        ((env (n + 1)).inputOne, (env (n + 1)).inputTwo)
        (profiledRawJointRecurrentOwnerFibreBoundarySemanticTraceObservation A
          strategy hwin initialOne initialTwo hinitial env (n + 1))
  let initialParent :=
    profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
      initialOne initialTwo hinitial
        ((env 0).inputOne, (env 0).inputTwo)
  let D :=
    sourceFreeBeliefParentLinkedCodeParityDPA
      (Annotation := ProfiledRawJointHybridPhysicalEdgeAnnotation A)
      (profiledRawJointOneSidedCodeParityDPA A initialParent.1.1.1)
  let word : OmegaWord _ := fun m ↦
    (profiledRawJointRecurrentOwnerFibreBoundarySemanticTraceParent A strategy
      hwin initialOne initialTwo hinitial env (m + 1)).2.1
  have hdpa :
      D.runFrom initialParent.2.2 word (n + 1) =
        D.step (D.runFrom initialParent.2.2 word n)
          (profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy
            hwin targetPair.1 targetPair.2 htarget
              ((env (n + 1)).inputOne, (env (n + 1)).inputTwo)).2.1 := by
    rw [hparent]
    rfl
  simpa only [profiledRawJointRecurrentOwnerFibreRealizableMonitorTrace] using
    hdpa

/-- Conversely, reconstructing an environment from a monitor path and then
forming its canonical augmented trace returns the original path pointwise.
Thus the finite monitor has no spurious paths. -/
theorem
    profiledRawJointRecurrentOwnerFibreRealizableMonitorTrace_reconstruct
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂)
    (walk : Nat →
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorState A strategy hwin
        initialOne initialTwo hinitial initialInput)
    (hzero :
      walk 0 =
        profiledRawJointRecurrentOwnerFibreRealizableMonitorInitial A strategy
          hwin initialOne initialTwo hinitial initialInput)
    (hedges : ∀ n : Nat,
      (walk n, walk (n + 1)) ∈
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEdges A strategy
          hwin initialOne initialTwo hinitial initialInput) :
    let env :=
      profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment A
        strategy hwin initialOne initialTwo hinitial initialInput walk hedges
    ∀ n : Nat,
      profiledRawJointRecurrentOwnerFibreRealizableMonitorTrace A strategy hwin
        initialOne initialTwo hinitial env n = walk n := by
  dsimp only
  let env :=
    profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment A strategy
      hwin initialOne initialTwo hinitial initialInput walk hedges
  intro n
  apply Prod.ext
  · exact
      profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment_controls
        A strategy hwin initialOne initialTwo hinitial initialInput walk hzero
          hedges n
  · apply Prod.ext
    · exact
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment_input A
          strategy hwin initialOne initialTwo hinitial initialInput walk hzero
            hedges n
    · simpa only [
        profiledRawJointRecurrentOwnerFibreRealizableMonitorTrace] using
        profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment_dpa A
          strategy hwin initialOne initialTwo hinitial initialInput walk hzero
            hedges n

/-- Acceptance of the exact finite realizable monitor implies acceptance of
the canonical active-parent word for the chosen environment. -/
theorem
    profiledRawJointRecurrentOwnerFibreSemanticTraceParent_acceptsFrom_of_realizableMonitorAccepting
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (env : EnvironmentSequence In₁ In₂)
    (haccepting :
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorAccepting A strategy
        hwin initialOne initialTwo hinitial
          ((env 0).inputOne, (env 0).inputTwo)) :
    let initialParent :=
      profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
        initialOne initialTwo hinitial
          ((env 0).inputOne, (env 0).inputTwo)
    (sourceFreeBeliefParentLinkedCodeParityDPA
        (Annotation := ProfiledRawJointHybridPhysicalEdgeAnnotation A)
        (profiledRawJointOneSidedCodeParityDPA A
          initialParent.1.1.1)).AcceptsFrom
      initialParent.2.2
      (fun n ↦
        (profiledRawJointRecurrentOwnerFibreBoundarySemanticTraceParent A
          strategy hwin initialOne initialTwo hinitial env (n + 1)).2.1) := by
  dsimp only
  let initialParent :=
    profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
      initialOne initialTwo hinitial
        ((env 0).inputOne, (env 0).inputTwo)
  let D :=
    sourceFreeBeliefParentLinkedCodeParityDPA
      (Annotation := ProfiledRawJointHybridPhysicalEdgeAnnotation A)
      (profiledRawJointOneSidedCodeParityDPA A initialParent.1.1.1)
  let word : OmegaWord _ := fun n ↦
    (profiledRawJointRecurrentOwnerFibreBoundarySemanticTraceParent A strategy
      hwin initialOne initialTwo hinitial env (n + 1)).2.1
  let walk :=
    profiledRawJointRecurrentOwnerFibreRealizableMonitorTrace A strategy hwin
      initialOne initialTwo hinitial env
  unfold ProfiledRawJointRecurrentOwnerFibreRealizableMonitorAccepting at haccepting
  obtain ⟨p, hpEven, hpInf, hpMin⟩ := haccepting walk
    (profiledRawJointRecurrentOwnerFibreRealizableMonitorTrace_zero A strategy
      hwin initialOne initialTwo hinitial env)
    (profiledRawJointRecurrentOwnerFibreRealizableMonitorTrace_edge A strategy
      hwin initialOne initialTwo hinitial env)
  refine ⟨p, hpEven, ?_, ?_⟩
  · intro n
    obtain ⟨k, hnk, hk⟩ := hpInf n
    refine ⟨k, hnk, ?_⟩
    simpa only [walk,
      profiledRawJointRecurrentOwnerFibreRealizableMonitorTrace] using hk
  · intro q hq
    apply hpMin q
    intro n
    obtain ⟨k, hnk, hk⟩ := hq n
    refine ⟨k, hnk, ?_⟩
    simpa only [walk,
      profiledRawJointRecurrentOwnerFibreRealizableMonitorTrace] using hk

/-- Semantic form of the exact target at a fixed first input: every
environment with that first input has an accepting active-parent word. -/
def ProfiledRawJointRecurrentOwnerFibreSemanticTraceParentAcceptingAtInput
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂) : Prop :=
  let initialParent :=
    profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
      initialOne initialTwo hinitial initialInput
  let D :=
    sourceFreeBeliefParentLinkedCodeParityDPA
      (Annotation := ProfiledRawJointHybridPhysicalEdgeAnnotation A)
      (profiledRawJointOneSidedCodeParityDPA A initialParent.1.1.1)
  ∀ env : EnvironmentSequence In₁ In₂,
    ((env 0).inputOne, (env 0).inputTwo) = initialInput →
      D.AcceptsFrom initialParent.2.2
        (fun n ↦
          (profiledRawJointRecurrentOwnerFibreBoundarySemanticTraceParent A
            strategy hwin initialOne initialTwo hinitial env (n + 1)).2.1)

/-- Exactness of the realizable monitor.  Its graph-parity condition is
equivalent to universal semantic acceptance at the fixed first input; the
reverse implication uses the environment reconstructed from an arbitrary
monitor path. -/
theorem
    profiledRawJointRecurrentOwnerFibreRealizableMonitorAccepting_iff_semantic
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (initialInput : In₁ × In₂) :
    ProfiledRawJointRecurrentOwnerFibreRealizableMonitorAccepting A strategy
        hwin initialOne initialTwo hinitial initialInput ↔
      ProfiledRawJointRecurrentOwnerFibreSemanticTraceParentAcceptingAtInput A
        strategy hwin initialOne initialTwo hinitial initialInput := by
  constructor
  · intro haccepting
    dsimp only [
      ProfiledRawJointRecurrentOwnerFibreSemanticTraceParentAcceptingAtInput
      ]
    intro env hfirst
    have hacceptingEnv :
        ProfiledRawJointRecurrentOwnerFibreRealizableMonitorAccepting A
          strategy hwin initialOne initialTwo hinitial
            ((env 0).inputOne, (env 0).inputTwo) := by
      simpa only [hfirst] using haccepting
    have hresult :=
      profiledRawJointRecurrentOwnerFibreSemanticTraceParent_acceptsFrom_of_realizableMonitorAccepting
        A strategy hwin initialOne initialTwo hinitial env hacceptingEnv
    have hparent :
        profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
            initialOne initialTwo hinitial initialInput =
          profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy
            hwin initialOne initialTwo hinitial
              ((env 0).inputOne, (env 0).inputTwo) :=
      profiledRawJointRecurrentOwnerFibreBoundaryActiveParent_congr A strategy
        hwin initialOne initialOne initialTwo initialTwo hinitial hinitial
          initialInput ((env 0).inputOne, (env 0).inputTwo) rfl rfl hfirst.symm
    rw [hparent]
    exact hresult
  · intro hsemantic
    dsimp only [ProfiledRawJointRecurrentOwnerFibreRealizableMonitorAccepting]
    intro walk hzero hedges
    let env :=
      profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment A
        strategy hwin initialOne initialTwo hinitial initialInput walk hedges
    let initialParent :=
      profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
        initialOne initialTwo hinitial initialInput
    let D :=
      sourceFreeBeliefParentLinkedCodeParityDPA
        (Annotation := ProfiledRawJointHybridPhysicalEdgeAnnotation A)
        (profiledRawJointOneSidedCodeParityDPA A initialParent.1.1.1)
    let word : OmegaWord _ := fun n ↦
      (profiledRawJointRecurrentOwnerFibreBoundarySemanticTraceParent A
        strategy hwin initialOne initialTwo hinitial env (n + 1)).2.1
    have hdpa : ∀ n : Nat,
        D.runFrom initialParent.2.2 word n = (walk n).2.2 :=
      profiledRawJointRecurrentOwnerFibreRealizableMonitorEnvironment_dpa A
        strategy hwin initialOne initialTwo hinitial initialInput walk hzero
          hedges
    dsimp only [
      ProfiledRawJointRecurrentOwnerFibreSemanticTraceParentAcceptingAtInput
      ] at hsemantic
    obtain ⟨p, hpEven, hpInf, hpMin⟩ := hsemantic env rfl
    refine ⟨p, hpEven, ?_, ?_⟩
    · intro n
      obtain ⟨k, hnk, hk⟩ := hpInf n
      refine ⟨k, hnk, ?_⟩
      rw [hdpa k] at hk
      exact hk
    · intro q hq
      apply hpMin q
      intro n
      obtain ⟨k, hnk, hk⟩ := hq n
      refine ⟨k, hnk, ?_⟩
      rw [hdpa k]
      exact hk

/-- Entry-level form of the exact certificate: every possible first input
pair has an accepting realizable monitor. -/
def ProfiledRawJointRecurrentOwnerFibreRealizableMonitorAcceptingAllInputs
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo) : Prop :=
  ∀ initialInput : In₁ × In₂,
    ProfiledRawJointRecurrentOwnerFibreRealizableMonitorAccepting A strategy
      hwin initialOne initialTwo hinitial initialInput

/-- An all-input entry certificate supplies the parent-word acceptance
conclusion for every environment. -/
theorem
    profiledRawJointRecurrentOwnerFibreSemanticTraceParent_acceptsFrom_of_realizableMonitorAcceptingAllInputs
    (initialOne : OneControl A strategy hwin)
    (initialTwo : TwoControl A strategy hwin)
    (hinitial :
      ProfiledRawJointRecurrentOwnerFibreBoundaryOperational A strategy hwin
        initialOne initialTwo)
    (haccepting :
      ProfiledRawJointRecurrentOwnerFibreRealizableMonitorAcceptingAllInputs A
        strategy hwin initialOne initialTwo hinitial)
    (env : EnvironmentSequence In₁ In₂) :
    let initialParent :=
      profiledRawJointRecurrentOwnerFibreBoundaryActiveParent A strategy hwin
        initialOne initialTwo hinitial
          ((env 0).inputOne, (env 0).inputTwo)
    (sourceFreeBeliefParentLinkedCodeParityDPA
        (Annotation := ProfiledRawJointHybridPhysicalEdgeAnnotation A)
        (profiledRawJointOneSidedCodeParityDPA A
          initialParent.1.1.1)).AcceptsFrom
      initialParent.2.2
      (fun n ↦
        (profiledRawJointRecurrentOwnerFibreBoundarySemanticTraceParent A
          strategy hwin initialOne initialTwo hinitial env (n + 1)).2.1) := by
  exact
    profiledRawJointRecurrentOwnerFibreSemanticTraceParent_acceptsFrom_of_realizableMonitorAccepting
      A strategy hwin initialOne initialTwo hinitial env
        (haccepting ((env 0).inputOne, (env 0).inputTwo))

end

