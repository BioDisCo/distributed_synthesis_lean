import DistributedSynthesis.Formalizations.Proposition.PropParametricjournal
import DistributedSynthesis.Formalizations.Theorem.ThmDeterministicBlockAutomaton

/-!
# Journal finite memory gives the uniform one-directional lemma

This file formalizes Proposition `prop:journalgivesuniform` from `paper.tex`.

The constructed content is the second half of the file: for a
deterministic-monitor block with a realizable objective, the emptiness-game
route supplies a transition-rational winning controller, and the product of
the controller state with the monitor state is a finite block summary
satisfying the items of Definition `def:uniformonedirectional` as theorems:

* item (ii): the summary is updated by the autonomous finite step
  `ConstructedBlockSummary.summaryStep`, and the strategy label is a function
  of the summary (`strategyTree_eq`);
* item (iv): equal summaries give equal continuation label trees and equal
  monitor evolution on every continuation
  (`strategyTree_continuation_congruence`,
  `monitorState_continuation_congruence`,
  `priority_continuation_congruence`) — this is the rational-run soundness
  content, proved rather than assumed;
* item (v): the summary of a path is the fold of the finite deterministic
  step over the branch word (`summaryAt_eq_foldl`), i.e. the summary classes
  are DFA-recognizable.

Items (i) and (iii) are boundary indexing and readout; they are supplied by
`journal_gives_uniform_constructed` and the `OneDirectionalSummaryData`
bridge.  The legacy packaging theorem `journal_gives_uniform` is retained
for the parametric-journal interface.
-/

namespace DistributedSynthesis

universe u v w x y z b

/--
Proposition `prop:journalgivesuniform`: once the one-directional finite-memory
construction supplies a base uniform summary, every finite family of regular
synchronized-block tests can be included by the parametric journal product.
-/
theorem journal_gives_uniform
    {Alphabet : Type u}
    {In₁ : Type v} {In₂ : Type w} {Out₁ : Type x} {Out₂ : Type y}
    (base : UniformOneDirectionalFiniteIndexLemma.{u, v, w, x, y, z} Alphabet In₁ In₂ Out₁ Out₂)
    (monitor : SynchronizedBlockRegularMonitor.{v, w, x, y, max u v w x y z} In₁ In₂ Out₁ Out₂)
    (continuationInvariant : Prop)
    (regularRepresentation : Prop) :
    ∃ uniform : UniformOneDirectionalFiniteIndexLemma.{u, v, w, x, y, z} Alphabet In₁ In₂ Out₁ Out₂,
      uniform.continuationInvariant = continuationInvariant ∧
      uniform.regularRepresentation = regularRepresentation := by
  obtain ⟨enriched, _summaryProduct, hcontinuation, hregular⟩ :=
    parametric_journal base monitor continuationInvariant regularRepresentation
  exact ⟨enriched, hcontinuation, hregular⟩

namespace TransitionRationalTree

variable {Branch : Type u} {Alphabet : Type v}

/-- Control evolution along an appended branch word. -/
theorem controlAt_append
    (t : TransitionRationalTree.{u, v, w} Branch Alphabet)
    (node tail : TreeNode Branch) :
    t.controlAt (node ++ tail) = tail.foldl t.step (t.controlAt node) := by
  simp [controlAt, List.foldl_append]

/--
Subtree congruence: nodes with the same finite control generate the same
labeled subtree.  This is the mechanism behind item (iv) of
Definition `def:uniformonedirectional`: a rational run chooses the same
continuation strategy tree at any two nodes with the same sampled state.
-/
theorem labeledTree_append_of_controlAt_eq
    (t : TransitionRationalTree.{u, v, w} Branch Alphabet)
    {left right : TreeNode Branch}
    (h : t.controlAt left = t.controlAt right)
    (tail : TreeNode Branch) :
    t.labeledTree (left ++ tail) = t.labeledTree (right ++ tail) := by
  simp [labeledTree, controlAt_append, h]

end TransitionRationalTree

/--
A block summary constructed from a deterministic block monitor and a
transition-rational block controller.  The summary carrier is the product of
the controller control state and the monitor state; both are finite.
-/
structure ConstructedBlockSummary (Branch : Type u) (Alphabet : Type v) where
  monitor : DeterministicBlockMonitor.{u, v, w} Branch Alphabet
  controller : TransitionRationalTree.{u, v, w} Branch Alphabet

namespace ConstructedBlockSummary

variable {Branch : Type u} {Alphabet : Type v}
variable (s : ConstructedBlockSummary.{u, v, w} Branch Alphabet)

/-- The finite summary carrier. -/
abbrev Summary := s.controller.Control × s.monitor.State

instance : Fintype s.Summary := inferInstance

/-- The block strategy tree generated by the controller. -/
def strategyTree : LabeledTree Branch Alphabet :=
  s.controller.labeledTree

/-- The summary at a node: controller control and monitor state. -/
def summaryAt (node : TreeNode Branch) : s.Summary :=
  (s.controller.controlAt node, s.monitor.control s.strategyTree node)

/-- The initial summary (item (i): block initialization). -/
def summaryInit : s.Summary :=
  (s.controller.initial, s.monitor.initial)

/-- The strategy label read off a summary. -/
def outputOfSummary (x : s.Summary) : Alphabet :=
  s.controller.labelOf x.1

/--
The autonomous finite summary step (item (ii)): the controller advances on
the branch, and the monitor consumes the label chosen by the controller at
the current summary together with the branch.
-/
def summaryStep (x : s.Summary) (branch : Branch) : s.Summary :=
  (s.controller.step x.1 branch,
    s.monitor.step x.2 (s.controller.labelOf x.1) branch)

@[simp]
theorem summaryAt_nil : s.summaryAt [] = s.summaryInit :=
  rfl

/-- The block strategy output is a function of the summary. -/
theorem strategyTree_eq (node : TreeNode Branch) :
    s.strategyTree node = s.outputOfSummary (s.summaryAt node) :=
  rfl

/-- One-step law of the summary. -/
theorem summaryAt_append (node : TreeNode Branch) (branch : Branch) :
    s.summaryAt (node ++ [branch]) = s.summaryStep (s.summaryAt node) branch := by
  refine Prod.ext ?_ ?_
  · show s.controller.controlAt (node ++ [branch]) = _
    simp [TransitionRationalTree.controlAt_append, summaryStep, summaryAt]
  · show s.monitor.control s.strategyTree (node ++ [branch]) = _
    rw [s.monitor.control_append s.strategyTree node branch]
    rfl

/-- Word form of the summary evolution. -/
theorem summaryAt_append_word (node tail : TreeNode Branch) :
    s.summaryAt (node ++ tail) = tail.foldl s.summaryStep (s.summaryAt node) := by
  induction tail using List.reverseRecOn with
  | nil => simp
  | append_singleton tail branch ih =>
      rw [← List.append_assoc, s.summaryAt_append (node ++ tail) branch, ih,
        List.foldl_append]
      rfl

/--
Item (v), effective regularity: the summary of a path is computed by the
finite deterministic automaton `(Summary, summaryInit, summaryStep)` reading
the branch word.  The summary classes are therefore DFA-recognizable.
-/
theorem summaryAt_eq_foldl (node : TreeNode Branch) :
    s.summaryAt node = node.foldl s.summaryStep s.summaryInit := by
  simpa using s.summaryAt_append_word [] node

/-- Equal summaries evolve identically on every continuation word. -/
theorem summaryAt_append_congruence
    {left right : TreeNode Branch}
    (h : s.summaryAt left = s.summaryAt right)
    (tail : TreeNode Branch) :
    s.summaryAt (left ++ tail) = s.summaryAt (right ++ tail) := by
  rw [s.summaryAt_append_word, s.summaryAt_append_word, h]

/--
Item (iv), strategy part: equal summaries choose the same continuation
strategy tree.
-/
theorem strategyTree_continuation_congruence
    {left right : TreeNode Branch}
    (h : s.summaryAt left = s.summaryAt right)
    (tail : TreeNode Branch) :
    s.strategyTree (left ++ tail) = s.strategyTree (right ++ tail) := by
  rw [s.strategyTree_eq (left ++ tail), s.strategyTree_eq (right ++ tail),
    s.summaryAt_append_congruence h tail]

/--
Item (iv), objective part: equal summaries give the same monitor evolution
on every continuation, hence the same objective monitors, automaton state,
and boundary readout at the closing round.
-/
theorem monitorState_continuation_congruence
    {left right : TreeNode Branch}
    (h : s.summaryAt left = s.summaryAt right)
    (tail : TreeNode Branch) :
    s.monitor.control s.strategyTree (left ++ tail) =
      s.monitor.control s.strategyTree (right ++ tail) :=
  congrArg Prod.snd (s.summaryAt_append_congruence h tail)

/--
Item (iv), parity part: equal summaries give the same priority along every
continuation branch, so the continuation games have the same parity
outcomes.
-/
theorem priority_continuation_congruence
    {left right : TreeNode Branch}
    (h : s.summaryAt left = s.summaryAt right)
    (branch : Nat -> Branch) (n : Nat) :
    s.monitor.priority
        (s.monitor.control s.strategyTree (left ++ branchNode branch n)) =
      s.monitor.priority
        (s.monitor.control s.strategyTree (right ++ branchNode branch n)) :=
  congrArg s.monitor.priority
    (s.monitorState_continuation_congruence h (branchNode branch n))

end ConstructedBlockSummary

/--
Constructed block summary for a realizable deterministic-monitor block: the
emptiness-game route supplies a transition-rational winning controller, and
the product summary machinery applies to it.
-/
theorem exists_constructedBlockSummary
    {Branch : Type u} {Alphabet : Type v}
    (M : DeterministicBlockMonitor.{u, v, w} Branch Alphabet)
    (hrealizable : ∃ tree : LabeledTree Branch Alphabet, M.WinningTree tree) :
    ∃ s : ConstructedBlockSummary.{u, v, w} Branch Alphabet,
      s.monitor = M ∧ M.WinningTree s.strategyTree := by
  letI := M.branchFinite
  letI := M.alphabetFinite
  rcases hrealizable with ⟨tree, hwin⟩
  rcases M.toRunAutomaton.exists_transitionRational_accepted
      ⟨tree, (M.acceptsTree_iff_winningTree tree).mpr hwin⟩ with
    ⟨controller, haccepts⟩
  exact ⟨⟨M, controller⟩, rfl,
    (M.acceptsTree_iff_winningTree controller.labeledTree).mp haccepts⟩

/--
Proposition `prop:journalgivesuniform`, constructed form: for a family of
deterministic block monitors indexed by common boundary states, with the
block objective realizable at every boundary, there is a family of
constructed block summaries — one finite controller-times-monitor summary
system per boundary — whose members satisfy items (ii), (iv), and (v) of
Definition `def:uniformonedirectional` by the theorems of
`ConstructedBlockSummary`, and whose strategy trees win the block objective.
Item (i) is the boundary indexing of the family; item (iii) is the boundary
readout of the monitor component at the closing round.
-/
theorem journal_gives_uniform_constructed
    {Boundary : Type b} {Branch : Type u} {Alphabet : Type v}
    (M : Boundary -> DeterministicBlockMonitor.{u, v, w} Branch Alphabet)
    (hrealizable :
      ∀ boundary : Boundary,
        ∃ tree : LabeledTree Branch Alphabet, (M boundary).WinningTree tree) :
    ∃ S : Boundary -> ConstructedBlockSummary.{u, v, w} Branch Alphabet,
      ∀ boundary : Boundary,
        (S boundary).monitor = M boundary ∧
          (M boundary).WinningTree (S boundary).strategyTree := by
  choose S hS using
    fun boundary => exists_constructedBlockSummary (M boundary) (hrealizable boundary)
  exact ⟨S, hS⟩

/--
Interface bridge: the monitor component of a block summary yields the
`OneDirectionalSummaryData` shape of Definition `def:uniformonedirectional`,
with block letters split into inputs and outputs and an explicit boundary
readout for the closing round.
-/
def DeterministicBlockMonitor.toOneDirectionalSummaryData
    {Boundary : Type b}
    {In₁ : Type v} {In₂ : Type w} {Out₁ : Type x} {Out₂ : Type y}
    (M : DeterministicBlockMonitor.{max v w, max x y, z} (In₁ × In₂) (Out₁ × Out₂))
    (init : Boundary -> M.State)
    (close : M.State -> ClosingLetter In₁ In₂ Out₁ Out₂ -> Boundary) :
    OneDirectionalSummaryData Boundary M.State In₁ In₂ Out₁ Out₂ where
  init := init
  update := fun state in₁ in₂ out₁ out₂ => M.step state (out₁, out₂) (in₁, in₂)
  close := close

end DistributedSynthesis
