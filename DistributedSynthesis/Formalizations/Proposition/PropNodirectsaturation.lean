    StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityData
      uniform initialBoundary cert edgeOfRound sameParityOutcomes
      containmentOrder orderOfHistory automatonOfHistory parityOfHistory
      σ generationBound :=
  StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityData.of_packages
