/--
Convert a truth-vector-labelled finite quotient into the generic bundled
history quotient.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedHistoryQuotientCertificate.of_truthVectorQuotientCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (truthCertificate :
      StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate
        uniform initialBoundary cert edgeOfRound containmentOrder
        orderOfHistory automatonOfHistory parityOfHistory σ generationBound) :
    StabilizedSaturationBasisBoundedGeneratedHistoryQuotientCertificate
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory σ generationBound :=
  { Q := truthCertificate.Q
    qFinite := truthCertificate.qFinite
    stateOfHistory := truthCertificate.stateOfHistory
    envsOf := truthCertificate.envsOf
    envs_length_le := truthCertificate.envs_length_le
    quotientPathEquivalent := by
      intro c
      refine stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq ?_
      calc
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound c.1.history)
            =
          truthCertificate.truthOf
            (truthCertificate.stateOfHistory c.1.history) := by
            exact (truthCertificate.state_truth_eq c).symm
        _ =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              (executionPrefixFromList σ
                (truthCertificate.envsOf
                  (truthCertificate.stateOfHistory c.1.history)))) := by
            exact
              (truthCertificate.representative_truth_eq
                (truthCertificate.stateOfHistory c.1.history)).symm
    quotientEnrichedState_eq := truthCertificate.quotientEnrichedState_eq
    quotientGeneratedEnrichedState_determined := by
      intro x x' hpath
      have htruth :
          truthCertificate.truthOf x = truthCertificate.truthOf x' := by
        calc
          truthCertificate.truthOf x =
              regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound
                  (executionPrefixFromList σ
                    (truthCertificate.envsOf x))) := by
                exact (truthCertificate.representative_truth_eq x).symm
          _ =
              regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound
                  (executionPrefixFromList σ
                    (truthCertificate.envsOf x'))) := by
                exact
                  stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent
                    hpath
          _ = truthCertificate.truthOf x' := by
                exact truthCertificate.representative_truth_eq x'
      exact truthCertificate.representativeEnriched_eq_of_truthOf_eq x x' htruth }

/--
Build the bundled carrier certificate from the stronger local bounded-generated
premise.

The carrier is the finite type of generated environment-round lists of length
at most `generationBound`, encoded as a bounded length and a function from
`Fin length`.  This constructor is not the final journal finite-memory
argument, because the local bounded-coverage premise is too strong in the
canonical all-history setting.  It is nevertheless the checked bridge showing
that the bundled carrier surface exactly generalizes the earlier bounded-local
route.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedCoherentCarrierCertificate.of_coherentGeneratedHistoryBounded
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (coherentGeneratedHistoryBounded :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ envs : List (EnvironmentRound In₁ In₂),
          c.1.history = executionPrefixFromList σ envs ∧
          envs.length ≤ generationBound)
    (boundedGeneratedEnrichedState_determined :
      ∀ envs envs' : List (EnvironmentRound In₁ In₂),
        envs.length ≤ generationBound ->
        envs'.length ≤ generationBound ->
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs))
          (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs')) ->
        uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory
            (executionPrefixFromList σ envs) =
          uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory
            (executionPrefixFromList σ envs')) :
    StabilizedSaturationBasisBoundedGeneratedCoherentCarrierCertificate
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory σ generationBound := by
  classical
  let SmallCarrier :=
    Sigma fun k : Fin (generationBound + 1) =>
      Fin k.1 -> EnvironmentRound In₁ In₂
  let Carrier : Type (max u v w a b) :=
    ULift.{max u v w a b, max u v} SmallCarrier
  let envsOf : Carrier -> List (EnvironmentRound In₁ In₂) :=
    fun x => List.ofFn x.down.2
  let mkCarrier
      (envs : List (EnvironmentRound In₁ In₂))
      (hlen : envs.length ≤ generationBound) : Carrier :=
    ULift.up ⟨⟨envs.length, Nat.lt_succ_of_le hlen⟩, envs.get⟩
  let chosenEnvs :=
    fun c :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory =>
      Classical.choose (coherentGeneratedHistoryBounded c)
  have chosen_history :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        c.1.history = executionPrefixFromList σ (chosenEnvs c) := by
    intro c
    exact (Classical.choose_spec (coherentGeneratedHistoryBounded c)).1
  have chosen_length :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        (chosenEnvs c).length ≤ generationBound := by
    intro c
    exact (Classical.choose_spec (coherentGeneratedHistoryBounded c)).2
  let stateOf :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory ->
      Carrier :=
    fun c => mkCarrier (chosenEnvs c) (chosen_length c)
  let carrier :
      StabilizedSaturationBasisBoundedGeneratedCoherentCarrier
        containmentOrder orderOfHistory automatonOfHistory σ generationBound :=
    { Carrier := Carrier
      carrierFinite := by infer_instance
      stateOf := stateOf
      envsOf := envsOf
      envs_length_le := by
        intro x
        rcases x with ⟨⟨k, f⟩⟩
        dsimp [envsOf]
        rw [List.length_ofFn]
        exact Nat.le_of_lt_succ k.2 }
  refine
    { carrier := carrier
      carrierPathEquivalent := ?_
      carrierEnrichedState_eq := ?_
      carrierGeneratedEnrichedState_determined := ?_ }
  · intro c
    dsimp [carrier, stateOf, mkCarrier, envsOf]
    rw [List.ofFn_get]
    rw [chosen_history c]
    exact StabilizedSaturationBasisPathEquivalent.refl cert _
  · intro c
    dsimp [carrier, stateOf, mkCarrier, envsOf]
    rw [List.ofFn_get]
    rw [chosen_history c]
  · intro x x' hpath
    exact
      boundedGeneratedEnrichedState_determined
        (carrier.envsOf x) (carrier.envsOf x')
        (carrier.envs_length_le x) (carrier.envs_length_le x') hpath

/--
Build the bundled carrier certificate from a finite quotient of histories.

This is the shape expected from the rotating rational-run/access-state
argument: a finite state is assigned to histories, each finite state has a
bounded generated representative, and the quotient state is proved to preserve
the stabilized path and enriched no-direct state on coherent configurations.
The final determinacy obligation only compares generated representatives of
quotient states.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedCoherentCarrierCertificate.of_historyQuotientRepresentatives
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (Q : Type (max u v w a b))
    (qFinite : Fintype Q)
    (stateOfHistory : History In₁ In₂ Graph Out₁ Out₂ -> Q)
    (envsOf : Q -> List (EnvironmentRound In₁ In₂))
    (envs_length_le : ∀ x : Q, (envsOf x).length ≤ generationBound)
    (quotientPathEquivalent :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistoryByRound edgeOfRound c.1.history)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (envsOf (stateOfHistory c.1.history)))))
    (quotientEnrichedState_eq :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory
            c.1.history =
          uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory
            (executionPrefixFromList σ (envsOf (stateOfHistory c.1.history))))
    (quotientGeneratedEnrichedState_determined :
      ∀ x x' : Q,
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (envsOf x)))
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (envsOf x'))) ->
        uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory
            (executionPrefixFromList σ (envsOf x)) =
          uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory
            (executionPrefixFromList σ (envsOf x'))) :
    StabilizedSaturationBasisBoundedGeneratedCoherentCarrierCertificate
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory σ generationBound :=
  let carrier :
      StabilizedSaturationBasisBoundedGeneratedCoherentCarrier
        containmentOrder orderOfHistory automatonOfHistory σ generationBound :=
    { Carrier := Q
      carrierFinite := qFinite
      stateOf := fun c => stateOfHistory c.1.history
      envsOf := envsOf
      envs_length_le := envs_length_le }
  { carrier := carrier
    carrierPathEquivalent := quotientPathEquivalent
    carrierEnrichedState_eq := quotientEnrichedState_eq
    carrierGeneratedEnrichedState_determined :=
      quotientGeneratedEnrichedState_determined }

/--
Bundled version of `of_historyQuotientRepresentatives`.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedCoherentCarrierCertificate.of_historyQuotientCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
