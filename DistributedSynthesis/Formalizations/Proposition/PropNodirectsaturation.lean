    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (stateData :
      StabilizedSaturationBasisBoundedGeneratedRepresentedTruthStateData
        uniform initialBoundary cert edgeOfRound containmentOrder
        orderOfHistory automatonOfHistory σ generationBound)
    (factorization :
      StabilizedSaturationBasisNoDirectSplitQuotientFactorization
        uniform initialBoundary cert (pathOfHistoryByRound edgeOfRound)
