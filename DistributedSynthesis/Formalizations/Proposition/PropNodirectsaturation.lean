/--
Truth-vector component split for the raw no-direct epoch state.

This is the raw-state part of the current main skeleton with the constructor
analysis made explicit: matching raw-state constructors must have equal
payloads, and mixed constructors must be impossible, whenever the stabilized
truth-vector atoms agree.
-/
structure StabilizedSaturationBasisNoDirectRawEpochTruthVectorComponentInvariants
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (_containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (_orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (_automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) : Prop where
  boundary_boundary :
    cert.determinesPathData ->
    cert.predecessorClosed ->
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
    cert.continuationClosed ->
      ∀ h h' boundary boundary',
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inl boundary ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inl boundary' ->
        boundary = boundary'
  sideOne_sideOne :
    cert.determinesPathData ->
    cert.predecessorClosed ->
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
    cert.continuationClosed ->
      ∀ h h' summary summary',
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inr (Sum.inl summary) ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inr (Sum.inl summary') ->
        summary = summary'
  sideTwo_sideTwo :
    cert.determinesPathData ->
    cert.predecessorClosed ->
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
    cert.continuationClosed ->
      ∀ h h' summary summary',
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inr (Sum.inr summary) ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inr (Sum.inr summary') ->
        summary = summary'
  boundary_sideOne_absurd :
    cert.determinesPathData ->
    cert.predecessorClosed ->
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
    cert.continuationClosed ->
      ∀ h h' boundary summary',
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inl boundary ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inr (Sum.inl summary') ->
        False
  boundary_sideTwo_absurd :
    cert.determinesPathData ->
    cert.predecessorClosed ->
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
    cert.continuationClosed ->
      ∀ h h' boundary summary',
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inl boundary ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inr (Sum.inr summary') ->
        False
  sideOne_boundary_absurd :
    cert.determinesPathData ->
    cert.predecessorClosed ->
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
    cert.continuationClosed ->
      ∀ h h' summary boundary',
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inr (Sum.inl summary) ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inl boundary' ->
        False
  sideOne_sideTwo_absurd :
    cert.determinesPathData ->
    cert.predecessorClosed ->
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
    cert.continuationClosed ->
      ∀ h h' summary summary',
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inr (Sum.inl summary) ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inr (Sum.inr summary') ->
        False
  sideTwo_boundary_absurd :
    cert.determinesPathData ->
    cert.predecessorClosed ->
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
    cert.continuationClosed ->
      ∀ h h' summary boundary',
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inr (Sum.inr summary) ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inl boundary' ->
        False
  sideTwo_sideOne_absurd :
    cert.determinesPathData ->
    cert.predecessorClosed ->
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
    cert.continuationClosed ->
      ∀ h h' summary summary',
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inr (Sum.inr summary) ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inr (Sum.inl summary') ->
        False

/--
Convert the older stabilized-same-tests raw constructor cases into the newer
truth-vector raw component target.

The only mathematical step is the stabilized bridge from truth-vector equality
to `StabilizedSaturationBasisPathEquivalent`; the nine constructor obligations
are then reused verbatim.
-/
theorem
    StabilizedSaturationBasisNoDirectRawEpochTruthVectorComponentInvariants_of_pathCases
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (pathCases :
      StabilizedSaturationBasisRawEpochStateCaseInvariants
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisNoDirectRawEpochTruthVectorComponentInvariants
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory where
  boundary_boundary := by
    intro _ _ _ _ h h' boundary boundary' htruth hstate hstate'
    exact pathCases.boundary_boundary h h' boundary boundary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  sideOne_sideOne := by
    intro _ _ _ _ h h' summary summary' htruth hstate hstate'
    exact pathCases.sideOne_sideOne h h' summary summary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  sideTwo_sideTwo := by
    intro _ _ _ _ h h' summary summary' htruth hstate hstate'
    exact pathCases.sideTwo_sideTwo h h' summary summary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  boundary_sideOne_absurd := by
    intro _ _ _ _ h h' boundary summary' htruth hstate hstate'
    exact pathCases.boundary_sideOne_absurd h h' boundary summary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  boundary_sideTwo_absurd := by
    intro _ _ _ _ h h' boundary summary' htruth hstate hstate'
    exact pathCases.boundary_sideTwo_absurd h h' boundary summary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  sideOne_boundary_absurd := by
    intro _ _ _ _ h h' summary boundary' htruth hstate hstate'
    exact pathCases.sideOne_boundary_absurd h h' summary boundary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  sideOne_sideTwo_absurd := by
    intro _ _ _ _ h h' summary summary' htruth hstate hstate'
    exact pathCases.sideOne_sideTwo_absurd h h' summary summary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  sideTwo_boundary_absurd := by
    intro _ _ _ _ h h' summary boundary' htruth hstate hstate'
    exact pathCases.sideTwo_boundary_absurd h h' summary boundary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  sideTwo_sideOne_absurd := by
    intro _ _ _ _ h h' summary summary' htruth hstate hstate'
    exact pathCases.sideTwo_sideOne_absurd h h' summary summary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'

/--
Assemble raw no-direct epoch-state truth-vector invariance from the component
case split.
-/
theorem StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant_of_components
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (components :
      StabilizedSaturationBasisNoDirectRawEpochTruthVectorComponentInvariants
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory := by
  intro hdet hpred hboundary hcont h h' htruth
  cases hstate :
      uniform.noDirectEpochStateAfterHistory initialBoundary h with
  | inl boundary =>
      cases hstate' :
          uniform.noDirectEpochStateAfterHistory initialBoundary h' with
      | inl boundary' =>
          exact
            congrArg Sum.inl
              (components.boundary_boundary hdet hpred hboundary hcont
                h h' boundary boundary' htruth hstate hstate')
      | inr side' =>
          cases hside' : side' with
          | inl summary' =>
              exact False.elim
                (components.boundary_sideOne_absurd hdet hpred hboundary hcont
                  h h' boundary summary' htruth hstate
                  (by simpa [hside'] using hstate'))
          | inr summary' =>
              exact False.elim
                (components.boundary_sideTwo_absurd hdet hpred hboundary hcont
                  h h' boundary summary' htruth hstate
                  (by simpa [hside'] using hstate'))
  | inr side =>
      cases hside : side with
      | inl summary =>
          cases hstate' :
              uniform.noDirectEpochStateAfterHistory initialBoundary h' with
          | inl boundary' =>
              exact False.elim
                (components.sideOne_boundary_absurd hdet hpred hboundary hcont
                  h h' summary boundary' htruth
                  (by simpa [hside] using hstate) hstate')
          | inr side' =>
              cases hside' : side' with
              | inl summary' =>
                  exact
                    congrArg (fun summary => Sum.inr (Sum.inl summary))
                      (components.sideOne_sideOne hdet hpred hboundary hcont
                        h h' summary summary' htruth
                        (by simpa [hside] using hstate)
                        (by simpa [hside'] using hstate'))
              | inr summary' =>
                  exact False.elim
                    (components.sideOne_sideTwo_absurd hdet hpred hboundary hcont
                      h h' summary summary' htruth
                      (by simpa [hside] using hstate)
                      (by simpa [hside'] using hstate'))
      | inr summary =>
          cases hstate' :
              uniform.noDirectEpochStateAfterHistory initialBoundary h' with
          | inl boundary' =>
              exact False.elim
                (components.sideTwo_boundary_absurd hdet hpred hboundary hcont
                  h h' summary boundary' htruth
                  (by simpa [hside] using hstate) hstate')
          | inr side' =>
              cases hside' : side' with
              | inl summary' =>
                  exact False.elim
                    (components.sideTwo_sideOne_absurd hdet hpred hboundary hcont
                      h h' summary summary' htruth
                      (by simpa [hside] using hstate)
                      (by simpa [hside'] using hstate'))
              | inr summary' =>
                  exact
                    congrArg (fun summary => Sum.inr (Sum.inr summary))
                      (components.sideTwo_sideTwo hdet hpred hboundary hcont
                        h h' summary summary' htruth
                        (by simpa [hside] using hstate)
                        (by simpa [hside'] using hstate'))

/--
Use the older stabilized-same-tests raw case package directly as a raw
truth-vector invariant.
-/
theorem StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant_of_pathCases
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (pathCases :
      StabilizedSaturationBasisRawEpochStateCaseInvariants
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory :=
  StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant_of_components
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory
    (StabilizedSaturationBasisNoDirectRawEpochTruthVectorComponentInvariants_of_pathCases
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory pathCases)

/--
Automaton-history half of the current truth-vector invariant target.

This isolates the continuation/automaton profile branch from the raw no-direct
epoch-state branch.
-/
def StabilizedSaturationBasisNoDirectAutomatonTruthVectorInvariant
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (_initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (_containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (_orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) : Prop :=
  cert.continuationClosed ->
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h) =
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h') ->
      automatonOfHistory h = automatonOfHistory h'

