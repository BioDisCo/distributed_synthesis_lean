      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        List.Forall₂ NoDirectEpochRelevantRoundEq h h' ->
        automatonOfHistory h = automatonOfHistory h') :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory :=
  StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_pathStrategyGeneratedCurrentViews
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory σ strategyGeneratedHistory
    (by
      intro env env' generationLength generationLength' hpath
      have hlength :=
        pathEquivalentDeterminesPathLength
          (pathOfHistory (executionPrefix σ env generationLength))
          (pathOfHistory (executionPrefix σ env' generationLength')) hpath
      rw [pathOfGeneratedPrefix_length env generationLength,
        pathOfGeneratedPrefix_length env' generationLength'] at hlength
      exact hlength)
    pathEquivalentDeterminesGeneratedCurrentViews
    automatonOfHistory_respectsRelevantHistory

