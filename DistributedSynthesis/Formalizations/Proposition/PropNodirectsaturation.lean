/-- Build the four-field factorization package from separate quotient factors. -/
def StabilizedSaturationBasisNoDirectSplitQuotientFactorization_of_splitQuotientFactors
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
