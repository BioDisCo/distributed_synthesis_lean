      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (truthVectorDeterminesRelevantHistory :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        List.Forall₂ NoDirectEpochRelevantRoundEq h h')
    (automatonOfHistory_respectsRelevantHistory :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        List.Forall₂ NoDirectEpochRelevantRoundEq h h' ->
        automatonOfHistory h = automatonOfHistory h') :
    StabilizedSaturationBasisNoDirectByRoundFiniteStateSeparation
      uniform initialBoundary cert edgeOfRound automatonOfHistory := by
  intro _hcont h h' htruth
  have hhistory := truthVectorDeterminesRelevantHistory h h' htruth
  exact
    Prod.ext
      (uniform.noDirectEpochStateAfterHistory_eq_of_relevantHistoryEq
        initialBoundary hhistory)
      (automatonOfHistory_respectsRelevantHistory h h' hhistory)

