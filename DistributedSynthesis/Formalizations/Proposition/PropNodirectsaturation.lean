              currentReceiptOrderData c'.1.history
                (historyCurrentContainmentOrder c'.1.history) := by
                rw [hc']
      · have hc' : c'.1.history = [] := by simpa using not_not.mp hne'
        calc
          currentReceiptOrderData c.1.history
              (historyCurrentContainmentOrder c.1.history) =
              defaultReceiptOrderData := by
              exact emptyCompatibility c hne (by simpa [hc'] using htruth.symm)
          _ =
              currentReceiptOrderData c'.1.history
                (historyCurrentContainmentOrder c'.1.history) := by
              rw [hc']
              rfl
    · have hc : c.1.history = [] := by simpa using not_not.mp hne
      by_cases hne' : c'.1.history ≠ []
      · calc
          currentReceiptOrderData c.1.history
              (historyCurrentContainmentOrder c.1.history) =
              defaultReceiptOrderData := by
              rw [hc]
              rfl
          _ =
              currentReceiptOrderData c'.1.history
                (historyCurrentContainmentOrder c'.1.history) := by
              exact (emptyCompatibility c' hne' (by simpa [hc] using htruth)).symm
      · have hc' : c'.1.history = [] := by simpa using not_not.mp hne'
        rw [hc, hc']
  rcases c.2.1 with ⟨hone, htwo, horder⟩
  rcases c'.2.1 with ⟨hone', htwo', horder'⟩
  have honeData := congrArg ReceiptOrderData.receiptOne hdata
  have htwoData := congrArg ReceiptOrderData.receiptTwo hdata
  have horderData := congrArg ReceiptOrderData.containmentOrder hdata
  exact
    ⟨by
        rw [hone, hone']
        simpa [currentReceiptOrderData] using honeData,
      by
        rw [htwo, htwo']
        simpa [currentReceiptOrderData] using htwoData,
      by
        rw [horder, horder']
        simpa [currentReceiptOrderData] using horderData⟩

/--
Stabilized separation after discharging receipt/order through non-append
truth-factor data.

This is the empty-history-safe analogue of the summary-receipt/order assembler:
the remaining semantic work is only automaton-control equality and
parity-progress equality.
-/
theorem StabilizedSaturationBasisCoherentAContinuationSeparation_of_receiptOrderTruthFactorData
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    {sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop}
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (automatonState_inv :
      StabilizedSaturationBasisAutomatonStateInvariant
        cert (pathOfHistoryByRound edgeOfRound) sameParityOutcomes
        containmentOrder orderOfHistory automatonOfHistory)
    (parity_inv :
      StabilizedSaturationBasisParityInvariant
        cert (pathOfHistoryByRound edgeOfRound) sameParityOutcomes
        containmentOrder orderOfHistory automatonOfHistory)
    (receiptOrderData :
      StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData
        uniform initialBoundary cert edgeOfRound containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisCoherentAContinuationSeparation
      cert (pathOfHistoryByRound edgeOfRound) sameParityOutcomes
      containmentOrder orderOfHistory automatonOfHistory := by
  exact
    (stabilizedSaturationBasisCoherentAContinuationSeparation_iff_fieldInvariants).mpr
      ⟨automatonState_inv,
        StabilizedSaturationBasisReceiptOrderInvariant_of_receiptOrderTruthFactorData
          uniform initialBoundary cert edgeOfRound containmentOrder
          orderOfHistory automatonOfHistory receiptOrderData,
        parity_inv⟩

/--
Current-order stabilized separation from append-level receipt/order
determinacy, mixed empty-prefix compatibility, and the two remaining field
invariants.
-/
theorem StabilizedSaturationBasisCoherentAContinuationSeparation_of_currentOrderAppendDeterminesReceiptOrderAndEmptyCompatibility
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
