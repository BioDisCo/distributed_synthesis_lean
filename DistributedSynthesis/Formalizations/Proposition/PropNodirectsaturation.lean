-/
theorem StabilizedSaturationBasisCoherentAContinuationSeparation_of_currentOrderAppendDeterminesReceiptOrderAndCoherentEmptyCompatibility
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
