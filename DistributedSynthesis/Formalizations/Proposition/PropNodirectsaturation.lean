      cert pathOfHistory sameParityOutcomes containmentOrder
      orderOfHistory automatonOfHistory := by
  intro c c' heq
  exact
    AContinuationEquivalent_of_components
      (automatonState_eq c c' heq)
      (receiptOne_eq c c' heq)
      (receiptTwo_eq c c' heq)
      (containmentOrder_eq c c' heq)
      (parity_eq c c' heq)

