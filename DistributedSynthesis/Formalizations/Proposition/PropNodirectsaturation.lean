        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (separation :
      RegularTestPathEquivalentCoherentAContinuationSeparation
        (stabilizedSaturationBasis cert) pathOfHistory sameParityOutcomes
        containmentOrder orderOfHistory automatonOfHistory)
    (representatives :
      StabilizedSaturationBasisCanonicalCoherentHistoryRepresentatives
        containmentOrder orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisNoDirectAutomatonClosureSoundness
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory :=
  StabilizedSaturationBasisNoDirectAutomatonClosureSoundness_of_pathEquivalentSeparation
    uniform initialBoundary cert pathOfHistory sameParityOutcomes
    containmentOrder orderOfHistory automatonOfHistory separation
    (stabilizedSaturationBasisCanonicalCoherentConfigOfHistory representatives)
    (stabilizedSaturationBasisCanonicalCoherentConfigOfHistory_history representatives)

/--
Raw closure soundness from path-equivalent relevant-history equality.

This is the raw-state analogue of the existing truth-vector relevant-history
route: once stabilized same-tests determine the graph/input/output round trace
used by the no-direct epoch transition, the raw no-direct epoch state is
preserved.
-/
theorem StabilizedSaturationBasisNoDirectRawEpochClosureSoundness_of_pathRelevantHistoryEq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
