      cert.continuationClosed ->
        ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
          regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h) =
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h') ->
          (uniform.noDirectEpochStateAfterHistory initialBoundary h,
              automatonOfHistory h) =
            (uniform.noDirectEpochStateAfterHistory initialBoundary h',
              automatonOfHistory h'))
    (summaryUnit : Summary₂)
    (decodeReceiptOrder :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) × Summary₂ ->
        ReceiptOrderData)
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrder
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound (History.append pref r)),
                summaryUnit) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (coherentHistoryAppend :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            c.1.history = History.append pref r)
    (parityOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> ParityProgress)
    (parity_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        parityOfHistory h =
          parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h))) :
    StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityPayload
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory σ generationBound :=
  { Summary₂ := Summary₂
    stateOfHistory := stateOfHistory
    state_truth_eq := state_truth_eq
    closureInvariants :=
      StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_splitQuotientFactorizationPackage
        uniform initialBoundary cert (pathOfHistoryByRound edgeOfRound)
        containmentOrder orderOfHistory automatonOfHistory
        (StabilizedSaturationBasisNoDirectSplitQuotientFactorization_of_rawAutomatonStateEqData
          uniform initialBoundary cert (pathOfHistoryByRound edgeOfRound)
          containmentOrder orderOfHistory automatonOfHistory
          truthVectorDeterminesRawAutomatonState)
    summaryUnit := summaryUnit
    decodeReceiptOrder := decodeReceiptOrder
    decodesCurrent := decodesCurrent
    orderOfAppend := orderOfAppend
    coherentHistoryAppend := coherentHistoryAppend
    parityOfTruth := parityOfTruth
    parity_factor := parity_factor }

/--
Build the bundled represented-truth payload from an already established
split-quotient factorization.

This is the journal-style route when the finite-memory construction has already
proved that the raw no-direct epoch state and automaton state factor through the
stabilized truth atom.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityPayload.of_splitQuotientFactorization
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (stateOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ ->
        { truth : RegularTestTruthAtom (stabilizedSaturationBasis cert) //
          ∃ envs : List (EnvironmentRound In₁ In₂),
            envs.length ≤ generationBound ∧
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound
                (executionPrefixFromList σ envs)) = truth ∧
            ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
              ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
                executionPrefixFromList σ envs = History.append pref r })
    (state_truth_eq :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
      (stateOfHistory c.1.history).1 =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history))
    (factorization :
      StabilizedSaturationBasisNoDirectSplitQuotientFactorization
        uniform initialBoundary cert (pathOfHistoryByRound edgeOfRound)
        containmentOrder orderOfHistory automatonOfHistory)
    (summaryUnit : Summary₂)
    (decodeReceiptOrder :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) × Summary₂ ->
        ReceiptOrderData)
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrder
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound (History.append pref r)),
                summaryUnit) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (coherentHistoryAppend :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            c.1.history = History.append pref r)
    (parityOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> ParityProgress)
    (parity_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        parityOfHistory h =
          parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h))) :
    StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityPayload
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory σ generationBound :=
  { Summary₂ := Summary₂
    stateOfHistory := stateOfHistory
    state_truth_eq := state_truth_eq
    closureInvariants :=
      StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_splitQuotientFactorizationPackage
        uniform initialBoundary cert (pathOfHistoryByRound edgeOfRound)
        containmentOrder orderOfHistory automatonOfHistory factorization
    summaryUnit := summaryUnit
    decodeReceiptOrder := decodeReceiptOrder
    decodesCurrent := decodesCurrent
    orderOfAppend := orderOfAppend
    coherentHistoryAppend := coherentHistoryAppend
    parityOfTruth := parityOfTruth
    parity_factor := parity_factor }

/--
Bounded represented truth-state data for the final no-direct route.

This is the localized finite-memory classifier supplied by the journal
