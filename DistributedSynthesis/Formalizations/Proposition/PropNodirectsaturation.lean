/--
Concrete raw epoch-state route: if equality of stabilized truth-vector atoms
determines the round fields used by the no-direct epoch transition, then it
determines the raw no-direct epoch state.

This isolates the real data dependency of `noDirectEpochStateAfterHistory`: it
uses the graph/input/output trace of the history, not views or automaton data.
-/
theorem StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant_of_relevantHistoryEq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
