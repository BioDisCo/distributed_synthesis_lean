/--
Bounded generated representative data without an append/nonempty requirement.

This is the state component used by the empty-history-safe truth-factor route:
each represented truth atom has a bounded generated representative, and the
representative for the empty-history truth atom may be the empty generated
word.
-/
structure StabilizedSaturationBasisBoundedGeneratedRepresentedTruthStateTruthData
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
