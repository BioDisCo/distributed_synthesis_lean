/--
Empty-history-safe represented-truth handoff to stabilized coherent
`A`-continuation separation.

The represented-truth state data records the finite generated-prefix witness
table; the proof of separation only needs the raw/automaton factors,
receipt/order truth factors, and truth-level parity bridge.
-/
theorem StabilizedSaturationBasisCoherentAContinuationSeparation_of_representedTruthClosureTruthFactorParityData
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (data :
      StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureTruthFactorParityData
        uniform initialBoundary cert edgeOfRound sameParityOutcomes
        containmentOrder orderOfHistory automatonOfHistory parityOfHistory
        σ generationBound) :
    StabilizedSaturationBasisCoherentAContinuationSeparation
      cert (pathOfHistoryByRound edgeOfRound) sameParityOutcomes
      containmentOrder orderOfHistory automatonOfHistory :=
  StabilizedSaturationBasisCoherentAContinuationSeparation_of_receiptOrderTruthFactorData
    uniform initialBoundary cert edgeOfRound containmentOrder
    orderOfHistory automatonOfHistory
    (by
      intro c c' heq
      have htruth :
          regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound c.1.history) =
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound c'.1.history) :=
        stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent heq
      have hpair :
          (uniform.noDirectEpochStateAfterHistory
                initialBoundary c.1.history,
              automatonOfHistory c.1.history) =
            (uniform.noDirectEpochStateAfterHistory
                initialBoundary c'.1.history,
              automatonOfHistory c'.1.history) :=
        data.factorData.truthVectorDeterminesRawAutomatonState
          cert.continuationClosed_proof (h := c.1.history)
          (h' := c'.1.history) htruth
      have hauto :
          automatonOfHistory c.1.history =
            automatonOfHistory c'.1.history :=
        congrArg Prod.snd hpair
      calc
        c.1.automatonState = automatonOfHistory c.1.history := c.2.2
        _ = automatonOfHistory c'.1.history := hauto
        _ = c'.1.automatonState := (c'.2.2).symm)
    (by
      intro c c' heq
      have htruth :
          regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound c.1.history) =
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound c'.1.history) :=
        stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent heq
      exact data.parityData.sameParityOfTruth c c'
        (congrArg data.parityData.parityOfTruth htruth))
    data.receiptOrderData

