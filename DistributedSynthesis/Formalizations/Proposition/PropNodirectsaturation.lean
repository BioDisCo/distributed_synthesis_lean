/--
Current receipt/order equality from a truth-vector summary decoder.

This is the history-level form needed by the represented-truth quotient:
provided the histories under comparison are appended histories, equality of
their stabilized truth atoms makes the decoded receipt/order summaries equal.
-/
theorem currentReceiptOrderData_eq_of_truthVectorSummary
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (summaryUnit : Summary₂)
    (decodeReceiptOrder :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) × Summary₂ ->
        ReceiptOrderData)
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrder
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound (History.append pref r)),
                summaryUnit) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    {h h' : History In₁ In₂ Graph Out₁ Out₂}
    (historyAppend :
      (∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          h = History.append pref r) ∧
      (∃ (pref' : History In₁ In₂ Graph Out₁ Out₂),
        ∃ (r' : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          h' = History.append pref' r'))
    (htruth :
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound h')) :
    currentReceiptOrderData h (orderOfHistory h) =
      currentReceiptOrderData h' (orderOfHistory h') := by
  rcases historyAppend.1 with ⟨pref, r, hh⟩
  rcases historyAppend.2 with ⟨pref', r', hh'⟩
  have htruthAppend :
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound (History.append pref r)) =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound (History.append pref' r')) := by
    simpa [hh, hh'] using htruth
  calc
    currentReceiptOrderData h (orderOfHistory h)
        = currentReceiptOrderData (History.append pref r)
            (orderOfHistory (History.append pref r)) := by
          rw [hh]
    _ = currentReceiptOrderData (History.append pref r)
            (graphContainmentOrder r.graph) := by
          rw [orderOfAppend pref r]
    _ = currentReceiptOrderDataForAppend pref r := rfl
    _ = decodeReceiptOrder
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound (History.append pref r)),
              summaryUnit) :=
          (decodesCurrent pref r).symm
    _ = decodeReceiptOrder
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound (History.append pref' r')),
              summaryUnit) := by
          rw [htruthAppend]
    _ = currentReceiptOrderDataForAppend pref' r' :=
          decodesCurrent pref' r'
    _ = currentReceiptOrderData (History.append pref' r')
            (graphContainmentOrder r'.graph) := rfl
    _ = currentReceiptOrderData (History.append pref' r')
            (orderOfHistory (History.append pref' r')) := by
          rw [orderOfAppend pref' r']
    _ = currentReceiptOrderData h' (orderOfHistory h') := by
          rw [hh']

