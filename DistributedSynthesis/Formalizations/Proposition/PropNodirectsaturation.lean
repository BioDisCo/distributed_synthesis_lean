        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (rawFactor :
      StabilizedSaturationBasisNoDirectRawEpochQuotientFactor
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory)
    (automatonFactor :
      StabilizedSaturationBasisNoDirectAutomatonQuotientFactor
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisNoDirectSplitQuotientFactorization
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory where
  rawEpochOfTruth := rawFactor.rawEpochOfTruth
  rawEpoch_factor := rawFactor.rawEpoch_factor
  automatonOfTruth := automatonFactor.automatonOfTruth
  automaton_factor := automatonFactor.automaton_factor

/--
Build the four-field package directly from the two truth-vector invariants.
The quotient functions are the canonical representative-history functions used
by the split quotient-factor constructors.
-/
noncomputable def StabilizedSaturationBasisNoDirectSplitQuotientFactorization_of_invariants
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (rawInvariant :
      StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory)
    (automatonInvariant :
      StabilizedSaturationBasisNoDirectAutomatonTruthVectorInvariant
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisNoDirectSplitQuotientFactorization
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory :=
  StabilizedSaturationBasisNoDirectSplitQuotientFactorization_of_splitQuotientFactors
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory
    (StabilizedSaturationBasisNoDirectRawEpochQuotientFactor_of_invariant
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory rawInvariant)
    (StabilizedSaturationBasisNoDirectAutomatonQuotientFactor_of_invariant
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory automatonInvariant)

/--
Concrete four-field package constructor from the focused pair-state target:
same stabilized truth-vector atoms determine exactly the raw no-direct epoch
state and the automaton state.  This is weaker than proving full
transition-relevant history equality and is the direct mathematical content
