/--
Build the receipt/order append package from its concrete fields.

This is mostly a named constructor for the proof skeleton: it keeps the
remaining receipt/order obligation as the familiar decoder plus append
bookkeeping assumptions.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedReceiptOrderAppendData.of_fields
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (summaryUnit : Summary₂)
    (decodeReceiptOrder :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) × Summary₂ ->
        ReceiptOrderData)
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrder
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound (History.append pref r)),
                summaryUnit) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (coherentHistoryAppend :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            c.1.history = History.append pref r) :
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderAppendData
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory :=
  { Summary₂ := Summary₂
    summaryUnit := summaryUnit
    decodeReceiptOrder := decodeReceiptOrder
    decodesCurrent := decodesCurrent
    orderOfAppend := orderOfAppend
    coherentHistoryAppend := coherentHistoryAppend }

/--
Receipt/order constructor for the common case where the second summary
component is only a fixed dummy value.  The remaining semantic object is just a
decoder from stabilized truth atoms to current receipt/order data.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedReceiptOrderAppendData.of_truthDecoder
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (decodeReceiptOrderOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        ReceiptOrderData)
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrderOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound (History.append pref r))) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (coherentHistoryAppend :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            c.1.history = History.append pref r) :
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderAppendData
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory :=
  StabilizedSaturationBasisBoundedGeneratedReceiptOrderAppendData.of_fields
    uniform initialBoundary cert edgeOfRound containmentOrder orderOfHistory
    automatonOfHistory PUnit.unit
    (fun pair => decodeReceiptOrderOfTruth pair.1)
    decodesCurrent orderOfAppend coherentHistoryAppend

/--
Canonical truth-atom decoder from append-history well-definedness.

Instead of asking for a decoder directly, it is enough to prove that any two
append histories with the same stabilized truth atom have the same canonical
current receipt/order data.  The decoder chooses one realized append history for
each realized truth atom and uses `defaultReceiptOrderData` elsewhere.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedReceiptOrderAppendData.of_appendTruthDeterminesReceiptOrder
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (appendTruthDeterminesReceiptOrder :
      ∀ (pref pref' : History In₁ In₂ Graph Out₁ Out₂)
        (r r' : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound (History.append pref r)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound (History.append pref' r')) ->
        currentReceiptOrderDataForAppend pref r =
          currentReceiptOrderDataForAppend pref' r')
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (coherentHistoryAppend :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            c.1.history = History.append pref r) :
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderAppendData
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory := by
  classical
  let realized :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> Prop :=
    fun truth =>
      ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound (History.append pref r)) =
            truth
  let witness :
      ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis cert),
        realized truth ->
          { pair :
              History In₁ In₂ Graph Out₁ Out₂ ×
                RoundRecord In₁ In₂ Graph Out₁ Out₂ //
            regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound
                  (History.append pair.1 pair.2)) =
              truth } :=
    fun truth hreal =>
      ⟨(Classical.choose hreal,
          Classical.choose (Classical.choose_spec hreal)),
        Classical.choose_spec (Classical.choose_spec hreal)⟩
  let decodeReceiptOrderOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        ReceiptOrderData :=
    fun truth =>
      if hreal : realized truth then
        let selected := witness truth hreal
        currentReceiptOrderDataForAppend selected.1.1 selected.1.2
      else
        defaultReceiptOrderData
  exact
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderAppendData.of_truthDecoder
    uniform initialBoundary cert edgeOfRound containmentOrder orderOfHistory
    automatonOfHistory decodeReceiptOrderOfTruth
    (by
      intro pref r
      dsimp [decodeReceiptOrderOfTruth, realized]
      have hreal :
          ∃ (pref' : History In₁ In₂ Graph Out₁ Out₂),
            ∃ (r' : RoundRecord In₁ In₂ Graph Out₁ Out₂),
              regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound (History.append pref' r')) =
                regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound (History.append pref r)) :=
        ⟨pref, r, rfl⟩
      rw [dif_pos hreal]
      dsimp [witness]
      exact
        appendTruthDeterminesReceiptOrder
          (Classical.choose hreal)
          pref
          (Classical.choose (Classical.choose_spec hreal))
          r
          (Classical.choose_spec (Classical.choose_spec hreal)))
    orderOfAppend coherentHistoryAppend

/--
Truth-atom parity factorization and outcome bridge for the final no-direct
route.

This is the parity part of the journal finite-memory handoff: the chosen
history parity observation factors through stabilized truth atoms, and equality
of that truth-level parity value is enough for the requested outcome relation.
-/
structure StabilizedSaturationBasisBoundedGeneratedTruthParityBridgeData
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress) where
  parityOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis cert) -> ParityProgress
  parity_factor :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      parityOfHistory h =
        parityOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h))
  sameParityOfTruth :
    ∀ c c' :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      parityOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound c.1.history)) =
      parityOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound c'.1.history)) ->
        sameParityOutcomes c.1 c'.1

/--
Field-level constructor for the truth-level parity bridge.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedTruthParityBridgeData.of_fields
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (parityOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> ParityProgress)
    (parity_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        parityOfHistory h =
          parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h)))
    (sameParityOfTruth :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound c.1.history)) =
        parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound c'.1.history)) ->
          sameParityOutcomes c.1 c'.1) :
    StabilizedSaturationBasisBoundedGeneratedTruthParityBridgeData
      uniform initialBoundary cert edgeOfRound sameParityOutcomes
      containmentOrder orderOfHistory automatonOfHistory parityOfHistory :=
  { parityOfTruth := parityOfTruth
    parity_factor := parity_factor
    sameParityOfTruth := sameParityOfTruth }

/--
Build the truth-level parity bridge from the older history-level parity bridge.

The only genuinely truth-level input is the factorization of the chosen parity
observation through stabilized truth atoms; after that, equality at truth level
implies equality of the original history parity observations.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedTruthParityBridgeData.of_historyBridge
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (parityOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> ParityProgress)
    (parity_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        parityOfHistory h =
          parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h)))
    (sameParityOfProgress :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        parityOfHistory c.1.history = parityOfHistory c'.1.history ->
          sameParityOutcomes c.1 c'.1) :
    StabilizedSaturationBasisBoundedGeneratedTruthParityBridgeData
      uniform initialBoundary cert edgeOfRound sameParityOutcomes
      containmentOrder orderOfHistory automatonOfHistory parityOfHistory :=
  { parityOfTruth := parityOfTruth
    parity_factor := parity_factor
    sameParityOfTruth := by
      intro c c' hparity
      apply sameParityOfProgress c c'
      calc
        parityOfHistory c.1.history =
            parityOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound c.1.history)) :=
          parity_factor c.1.history
        _ =
            parityOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound c'.1.history)) :=
          hparity
        _ = parityOfHistory c'.1.history :=
          (parity_factor c'.1.history).symm }

/--
Build the truth-level parity bridge from well-definedness of the history parity
observation on stabilized truth atoms.

The truth-level parity value is chosen from an arbitrary realized history for
each realized truth atom, and falls back to the empty-history parity on
unrealized atoms.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedTruthParityBridgeData.of_truthDeterminesParity
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (parityOfHistory_eq_of_truth_eq :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        parityOfHistory h = parityOfHistory h')
    (sameParityOfProgress :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        parityOfHistory c.1.history = parityOfHistory c'.1.history ->
          sameParityOutcomes c.1 c'.1) :
    StabilizedSaturationBasisBoundedGeneratedTruthParityBridgeData
      uniform initialBoundary cert edgeOfRound sameParityOutcomes
      containmentOrder orderOfHistory automatonOfHistory parityOfHistory := by
  classical
  let realized :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> Prop :=
    fun truth =>
      ∃ h : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          truth
  let witness :
      ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis cert),
        realized truth ->
          { h : History In₁ In₂ Graph Out₁ Out₂ //
            regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound h) =
              truth } :=
    fun truth hreal =>
      ⟨Classical.choose hreal, Classical.choose_spec hreal⟩
  let parityOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> ParityProgress :=
    fun truth =>
      if hreal : realized truth then
        parityOfHistory (witness truth hreal).1
      else
        parityOfHistory (History.empty : History In₁ In₂ Graph Out₁ Out₂)
  exact
    StabilizedSaturationBasisBoundedGeneratedTruthParityBridgeData.of_historyBridge
      uniform initialBoundary cert edgeOfRound sameParityOutcomes
      containmentOrder orderOfHistory automatonOfHistory parityOfHistory
      parityOfTruth
      (by
        intro h
        dsimp [parityOfTruth, realized]
        have hreal :
            ∃ h' : History In₁ In₂ Graph Out₁ Out₂,
              regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound h') =
                regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound h) :=
          ⟨h, rfl⟩
        rw [dif_pos hreal]
        dsimp [witness]
        exact
          parityOfHistory_eq_of_truth_eq h (Classical.choose hreal)
            (Classical.choose_spec hreal).symm)
      sameParityOfProgress

/--
Representative-list closure-invariant constructor consuming named receipt/order
and parity truth-factor packages.

This is the proposition-level analogue of the theorem-facing package endpoint:
the skeleton can hand over the two named finite-memory packages directly,
without unpacking their individual factor maps.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representativesClosureInvariantsReceiptParityData
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (truthOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ ->
        RegularTestTruthAtom (stabilizedSaturationBasis cert))
    (envsOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂))
    (envs_bound :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        (envsOfHistory h).length ≤ generationBound)
    (envs_truth :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (envsOfHistory h))) =
          truthOfHistory h)
    (truthOfHistory_eq :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
      truthOfHistory c.1.history =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history))
    (closureInvariants :
      StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
        uniform initialBoundary cert (pathOfHistoryByRound edgeOfRound)
        containmentOrder orderOfHistory automatonOfHistory)
    (receiptData :
      StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData
        uniform initialBoundary cert edgeOfRound containmentOrder
        orderOfHistory automatonOfHistory)
    (parityData :
      StabilizedSaturationBasisBoundedGeneratedTruthParityBridgeData
        uniform initialBoundary cert edgeOfRound sameParityOutcomes
        containmentOrder orderOfHistory automatonOfHistory parityOfHistory) :
    StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory σ generationBound :=
  StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representativesClosureInvariantsTruthReceiptParity
    uniform initialBoundary cert edgeOfRound containmentOrder orderOfHistory
    automatonOfHistory parityOfHistory σ generationBound truthOfHistory
    envsOfHistory envs_bound envs_truth truthOfHistory_eq closureInvariants
    receiptData.receiptOrderOfTruth receiptData.receiptOrder_factor
    parityData.parityOfTruth parityData.parity_factor

/--
Representative-list closure-invariant constructor from direct truth-vector
determinacy of receipt/order and parity.

This is the smallest non-append formulation of the two remaining enriched
payloads: histories with equal stabilized truth atoms have the same current
receipt/order payload and the same selected parity observation.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representativesClosureInvariantsTruthDeterminacy
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (sameParityOfProgress :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        parityOfHistory c.1.history = parityOfHistory c'.1.history ->
          sameParityOutcomes c.1 c'.1)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (truthOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ ->
        RegularTestTruthAtom (stabilizedSaturationBasis cert))
    (envsOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂))
    (envs_bound :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        (envsOfHistory h).length ≤ generationBound)
    (envs_truth :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (envsOfHistory h))) =
          truthOfHistory h)
    (truthOfHistory_eq :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
      truthOfHistory c.1.history =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history))
    (closureInvariants :
      StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
        uniform initialBoundary cert (pathOfHistoryByRound edgeOfRound)
        containmentOrder orderOfHistory automatonOfHistory)
    (receiptOrder_eq_of_truth_eq :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        currentReceiptOrderData h (orderOfHistory h) =
          currentReceiptOrderData h' (orderOfHistory h'))
    (parityOfHistory_eq_of_truth_eq :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        parityOfHistory h = parityOfHistory h') :
    StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory σ generationBound :=
  StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representativesClosureInvariantsReceiptParityData
    uniform initialBoundary cert edgeOfRound sameParityOutcomes
    containmentOrder orderOfHistory automatonOfHistory parityOfHistory σ
    generationBound truthOfHistory envsOfHistory envs_bound envs_truth
    truthOfHistory_eq closureInvariants
    (StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData.of_truthDeterminesReceiptOrder
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory receiptOrder_eq_of_truth_eq)
    (StabilizedSaturationBasisBoundedGeneratedTruthParityBridgeData.of_truthDeterminesParity
      uniform initialBoundary cert edgeOfRound sameParityOutcomes
      containmentOrder orderOfHistory automatonOfHistory parityOfHistory
      parityOfHistory_eq_of_truth_eq sameParityOfProgress)

/--
Truth-atom factor maps for the raw no-direct epoch state and the selected
automaton history state.

This is the finite-state part of the journal handoff: both operational states
factor through stabilized truth atoms.  Equal truth atoms therefore determine
the raw/automaton pair used by the downstream closure-invariant package.
-/
structure StabilizedSaturationBasisBoundedGeneratedRawAutomatonFactorData
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) where
  rawEpochOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
      EpochRotatingAccessState
        uniform.boundary (uniform.summary Proc.one) (uniform.summary Proc.two)
  rawEpoch_factor :
    cert.determinesPathData ->
    cert.predecessorClosed ->
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
    cert.continuationClosed ->
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        rawEpochOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h)) =
          uniform.noDirectEpochStateAfterHistory initialBoundary h
  automatonOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis cert) -> AState
  automaton_factor :
    cert.continuationClosed ->
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        automatonOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h)) =
          automatonOfHistory h

/--
Turn the existing split-quotient factorization package into the final by-round
raw/automaton factor package.

This keeps the final handoff aligned with the older, better-developed
factorization route: the only specialization is that `pathOfHistory` is the
by-round path induced by `edgeOfRound`.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedRawAutomatonFactorData.of_splitQuotientFactorization
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (factorization :
      StabilizedSaturationBasisNoDirectSplitQuotientFactorization
        uniform initialBoundary cert (pathOfHistoryByRound edgeOfRound)
        containmentOrder orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisBoundedGeneratedRawAutomatonFactorData
      uniform initialBoundary cert edgeOfRound automatonOfHistory :=
  { rawEpochOfTruth := factorization.rawEpochOfTruth
    rawEpoch_factor := factorization.rawEpoch_factor
    automatonOfTruth := factorization.automatonOfTruth
    automaton_factor := factorization.automaton_factor }

/--
Assemble the bundled represented-truth payload from the localized state,
receipt/order, parity, and split-quotient packages.

This is the direct paper-facing payload constructor when the finite-memory
argument supplies the older split-quotient factorization instead of the derived
raw/automaton factor package.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityPayload.of_packagesAndSplitQuotientFactorization
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (stateData :
      StabilizedSaturationBasisBoundedGeneratedRepresentedTruthStateData
        uniform initialBoundary cert edgeOfRound containmentOrder
        orderOfHistory automatonOfHistory σ generationBound)
    (factorization :
      StabilizedSaturationBasisNoDirectSplitQuotientFactorization
        uniform initialBoundary cert (pathOfHistoryByRound edgeOfRound)
        containmentOrder orderOfHistory automatonOfHistory)
    (receiptOrderData :
      StabilizedSaturationBasisBoundedGeneratedReceiptOrderAppendData
        uniform initialBoundary cert edgeOfRound containmentOrder
        orderOfHistory automatonOfHistory)
    (parityData :
      StabilizedSaturationBasisBoundedGeneratedTruthParityBridgeData
        uniform initialBoundary cert edgeOfRound sameParityOutcomes
        containmentOrder orderOfHistory automatonOfHistory parityOfHistory) :
    StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityPayload
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory σ generationBound :=
  StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityPayload.of_splitQuotientFactorization
    uniform initialBoundary cert edgeOfRound containmentOrder
    orderOfHistory automatonOfHistory parityOfHistory σ generationBound
    stateData.stateOfHistory stateData.state_truth_eq factorization
    receiptOrderData.summaryUnit receiptOrderData.decodeReceiptOrder
    receiptOrderData.decodesCurrent receiptOrderData.orderOfAppend
    receiptOrderData.coherentHistoryAppend
    parityData.parityOfTruth parityData.parity_factor

/--
The raw/automaton truth-factor package gives the pair-state determinacy needed
by the downstream no-direct closure invariant.
-/
theorem StabilizedSaturationBasisBoundedGeneratedRawAutomatonFactorData.truthVectorDeterminesRawAutomatonState
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    {uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂}
    {initialBoundary : uniform.boundary}
    {cert : StabilizedSaturationBasisCertificate sat n}
    {edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType}
    {automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState}
    (factors :
      StabilizedSaturationBasisBoundedGeneratedRawAutomatonFactorData
        uniform initialBoundary cert edgeOfRound automatonOfHistory)
    (hcont : cert.continuationClosed)
    {h h' : History In₁ In₂ Graph Out₁ Out₂}
    (htruth :
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound h')) :
    (uniform.noDirectEpochStateAfterHistory initialBoundary h,
        automatonOfHistory h) =
      (uniform.noDirectEpochStateAfterHistory initialBoundary h',
        automatonOfHistory h') := by
  apply Prod.ext
  · calc
      uniform.noDirectEpochStateAfterHistory initialBoundary h =
          factors.rawEpochOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h)) := by
            exact
              (factors.rawEpoch_factor cert.determinesPathData_proof
                cert.predecessorClosed_proof cert.boundaryClosed_proof
                hcont h).symm
      _ =
          factors.rawEpochOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h')) := by
            rw [htruth]
      _ = uniform.noDirectEpochStateAfterHistory initialBoundary h' :=
            factors.rawEpoch_factor cert.determinesPathData_proof
              cert.predecessorClosed_proof cert.boundaryClosed_proof
              hcont h'
  · calc
      automatonOfHistory h =
          factors.automatonOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h)) := by
            exact (factors.automaton_factor hcont h).symm
      _ =
          factors.automatonOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h')) := by
            rw [htruth]
      _ = automatonOfHistory h' := factors.automaton_factor hcont h'

