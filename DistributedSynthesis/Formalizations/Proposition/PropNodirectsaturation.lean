/--
Exact reduction of the remaining stabilized semantic Step 3 proof to the three
field invariants suggested by the paper argument: automaton-control equality,
receipt/order equality, and parity-progress equality.
-/
theorem stabilizedSaturationBasisCoherentAContinuationSeparation_iff_fieldInvariants
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    {cert : StabilizedSaturationBasisCertificate sat n}
    {pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType}
    {sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop}
    {containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder}
    {orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder}
    {automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState} :
    StabilizedSaturationBasisCoherentAContinuationSeparation
        cert pathOfHistory sameParityOutcomes containmentOrder
        orderOfHistory automatonOfHistory ↔
      StabilizedSaturationBasisFieldInvariants
        cert pathOfHistory sameParityOutcomes containmentOrder
        orderOfHistory automatonOfHistory := by
  constructor
  · intro separation
    refine ⟨?_, ?_, ?_⟩
    · intro c c' heq
      exact (separation c c' heq).1
    · intro c c' heq
      exact
        ⟨(separation c c' heq).2.1,
          (separation c c' heq).2.2.1,
          (separation c c' heq).2.2.2.1⟩
    · intro c c' heq
      exact sameParityOutcomes_of_AContinuationEquivalent
        (separation c c' heq)
  · intro invariants
    exact
      StabilizedSaturationBasisCoherentAContinuationSeparation_of_state_receiptOrder_parity
        invariants.1 invariants.2.1 invariants.2.2

/--
Stabilized separation after discharging the receipt/order field through a
concrete summary decoder.  The remaining mathematical fields are then exactly
automaton-control equality and parity-progress equality.
-/
theorem StabilizedSaturationBasisCoherentAContinuationSeparation_of_summaryReceiptOrder
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {Summary₁ : Type (max u v w a b)}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    {cert : StabilizedSaturationBasisCertificate sat n}
    {pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType}
    {sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop}
    {containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder}
    {orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder}
    {automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState}
    (automatonState_inv :
      StabilizedSaturationBasisAutomatonStateInvariant
        cert pathOfHistory sameParityOutcomes containmentOrder
        orderOfHistory automatonOfHistory)
    (parity_inv :
      StabilizedSaturationBasisParityInvariant
        cert pathOfHistory sameParityOutcomes containmentOrder
        orderOfHistory automatonOfHistory)
    (summaryOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> Summary₁ × Summary₂)
    (decodeReceiptOrder : Summary₁ × Summary₂ -> ReceiptOrderData)
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrder (summaryOfHistory (History.append pref r)) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (historyAppend :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            c.1.history = History.append pref r)
    (summary_eq :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory c.1.history)
          (pathOfHistory c'.1.history) ->
        summaryOfHistory c.1.history = summaryOfHistory c'.1.history) :
    StabilizedSaturationBasisCoherentAContinuationSeparation
      cert pathOfHistory sameParityOutcomes containmentOrder
      orderOfHistory automatonOfHistory := by
  exact
    (stabilizedSaturationBasisCoherentAContinuationSeparation_iff_fieldInvariants).mpr
      ⟨automatonState_inv,
        StabilizedSaturationBasisReceiptOrderInvariant_of_summaryOfHistory_eq
          summaryOfHistory decodeReceiptOrder decodesCurrent orderOfAppend
          historyAppend summary_eq,
        parity_inv⟩

