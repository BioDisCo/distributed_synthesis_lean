        hspec.2.2.1.symm hspec.2.2.2.symm
  · intro h
    have hwitness :
        ∃ hist : History In₁ In₂ Graph Out₁ Out₂,
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound hist) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) :=
      ⟨h, rfl⟩
    dsimp [automatonOfTruth]
    rw [dif_pos hwitness]
    exact
      (automaton_determined (Classical.choose hwitness) h
        (Classical.choose_spec hwitness)).symm

