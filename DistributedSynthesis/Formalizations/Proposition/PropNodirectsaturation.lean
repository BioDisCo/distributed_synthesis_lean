    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (stateOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ ->
        { truth : RegularTestTruthAtom (stabilizedSaturationBasis cert) //
          ∃ envs : List (EnvironmentRound In₁ In₂),
            envs.length ≤ generationBound ∧
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound
                (executionPrefixFromList σ envs)) = truth ∧
            ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
              ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
                executionPrefixFromList σ envs = History.append pref r })
    (state_truth_eq :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
      (stateOfHistory c.1.history).1 =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history))
    (rawEpochOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        EpochRotatingAccessState
          uniform.boundary (uniform.summary Proc.one) (uniform.summary Proc.two))
    (rawEpoch_factor :
      cert.determinesPathData ->
      cert.predecessorClosed ->
      (∀ boundaryState, cert.boundaryClosed boundaryState) ->
      cert.continuationClosed ->
        ∀ h : History In₁ In₂ Graph Out₁ Out₂,
          rawEpochOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound h)) =
            uniform.noDirectEpochStateAfterHistory initialBoundary h)
    (automatonOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> AState)
    (automaton_factor :
      cert.continuationClosed ->
        ∀ h : History In₁ In₂ Graph Out₁ Out₂,
          automatonOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound h)) =
            automatonOfHistory h)
    (summaryUnit : Summary₂)
    (decodeReceiptOrder :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) × Summary₂ ->
        ReceiptOrderData)
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrder
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound (History.append pref r)),
                summaryUnit) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (coherentHistoryAppend :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            c.1.history = History.append pref r)
    (parityOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> ParityProgress)
    (parity_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        parityOfHistory h =
          parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h)))
    (sameParityOfTruth :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound c.1.history)) =
          parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound c'.1.history)) ->
          sameParityOutcomes c.1 c'.1) :
    StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityData
      uniform initialBoundary cert edgeOfRound sameParityOutcomes
      containmentOrder orderOfHistory automatonOfHistory parityOfHistory
      σ generationBound :=
  StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityData.of_rawAutomatonFactors
    uniform initialBoundary cert edgeOfRound sameParityOutcomes
    containmentOrder orderOfHistory automatonOfHistory parityOfHistory
    σ generationBound
    { stateOfHistory := stateOfHistory
      state_truth_eq := state_truth_eq }
    { rawEpochOfTruth := rawEpochOfTruth
      rawEpoch_factor := rawEpoch_factor
      automatonOfTruth := automatonOfTruth
      automaton_factor := automaton_factor }
    { Summary₂ := Summary₂
      summaryUnit := summaryUnit
      decodeReceiptOrder := decodeReceiptOrder
      decodesCurrent := decodesCurrent
      orderOfAppend := orderOfAppend
      coherentHistoryAppend := coherentHistoryAppend }
    { parityOfTruth := parityOfTruth
      parity_factor := parity_factor
      sameParityOfTruth := sameParityOfTruth }

/--
Convert the final named data target into the payload consumed by the quotient
certificate.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityData.toPayload
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    {uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂}
    {initialBoundary : uniform.boundary}
    {cert : StabilizedSaturationBasisCertificate sat n}
    {edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType}
    {sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop}
    {containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder}
    {orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder}
    {automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState}
    {parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress}
    {σ : StrategyPair In₁ In₂ Out₁ Out₂}
    {generationBound : Nat}
    (data :
      StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityData
        uniform initialBoundary cert edgeOfRound sameParityOutcomes
        containmentOrder orderOfHistory automatonOfHistory parityOfHistory
        σ generationBound) :
    StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityPayload
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory σ generationBound :=
  StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityPayload.of_rawAutomatonStateEq
    uniform initialBoundary cert edgeOfRound containmentOrder
    orderOfHistory automatonOfHistory parityOfHistory σ generationBound
    data.stateData.stateOfHistory data.stateData.state_truth_eq
    data.truthVectorDeterminesRawAutomatonState
    data.receiptOrderData.summaryUnit data.receiptOrderData.decodeReceiptOrder
    data.receiptOrderData.decodesCurrent data.receiptOrderData.orderOfAppend
    data.receiptOrderData.coherentHistoryAppend
    data.parityData.parityOfTruth data.parityData.parity_factor

/--
Convert the bundled localized represented-truth payload into the
truth-vector-labelled quotient certificate.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representedTruthClosureSummaryParityPayload
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
