/--
Raw closure soundness for histories known to be generated prefixes of a fixed
strategy.  The remaining obligations are generated length preservation and
current-view preservation at every positive prefix.
-/
theorem StabilizedSaturationBasisNoDirectRawEpochClosureSoundness_of_pathGeneratedCurrentViews
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generatedHistory :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        ∃ env : EnvironmentSequence In₁ In₂,
          ∃ generationLength : Nat,
            h = executionPrefix σ env generationLength)
    (pathEquivalentDeterminesGeneratedLength :
      ∀ (env env' : EnvironmentSequence In₁ In₂)
        (generationLength generationLength' : Nat),
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory (executionPrefix σ env generationLength))
          (pathOfHistory (executionPrefix σ env' generationLength')) ->
        generationLength = generationLength')
    (pathEquivalentDeterminesGeneratedCurrentViews :
      ∀ (env env' : EnvironmentSequence In₁ In₂)
        (generationLength : Nat),
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory (executionPrefix σ env generationLength))
          (pathOfHistory (executionPrefix σ env' generationLength)) ->
        ∀ k : Nat, k < generationLength ->
          currentView Proc.one (executionPrefix σ env (k + 1)) =
            currentView Proc.one (executionPrefix σ env' (k + 1)) ∧
          currentView Proc.two (executionPrefix σ env (k + 1)) =
            currentView Proc.two (executionPrefix σ env' (k + 1))) :
    StabilizedSaturationBasisNoDirectRawEpochClosureSoundness
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory :=
  StabilizedSaturationBasisNoDirectRawEpochClosureSoundness_of_pathRelevantNamedTracesEq
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory
    (by
      intro h h' hpath
      rcases generatedHistory h with ⟨env, generationLength, rfl⟩
      rcases generatedHistory h' with ⟨env', generationLength', rfl⟩
      have hlength :
          generationLength = generationLength' :=
        pathEquivalentDeterminesGeneratedLength env env'
          generationLength generationLength' hpath
      subst generationLength'
      exact
        noDirectEpochRelevantHistoryNamedTracesEq_executionPrefix_of_currentView_succ_eq
          σ env env' generationLength
          (pathEquivalentDeterminesGeneratedCurrentViews env env'
            generationLength hpath))

