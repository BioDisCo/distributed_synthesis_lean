/--
No-counterexample characterization of raw epoch-state truth-vector invariance.

This is the contrapositive shape of the raw split target: after the four
closure fields are available, there must not be two histories with the same
stabilized truth-vector atom but different raw no-direct epoch states.
-/
theorem StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant_iff_no_counterexample
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) :
    StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory ↔
      cert.determinesPathData ->
      cert.predecessorClosed ->
      (∀ boundaryState, cert.boundaryClosed boundaryState) ->
      cert.continuationClosed ->
        ¬ ∃ h h' : History In₁ In₂ Graph Out₁ Out₂,
          regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h) =
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h') ∧
          uniform.noDirectEpochStateAfterHistory initialBoundary h ≠
            uniform.noDirectEpochStateAfterHistory initialBoundary h' := by
  constructor
  · intro rawInvariant hdet hpred hboundary hcont hcounter
    rcases hcounter with ⟨h, h', htruth, hneq⟩
    exact hneq (rawInvariant hdet hpred hboundary hcont h h' htruth)
  · intro hno hdet hpred hboundary hcont h h' htruth
    classical
    by_contra hneq
    exact hno hdet hpred hboundary hcont ⟨h, h', htruth, hneq⟩

/--
Diagnostic no-go for the direct raw epoch-state target.

If the chosen history path identifies two histories whose raw no-direct epoch
states differ, then the raw epoch-state truth-vector invariant is impossible:
equal paths have equal stabilized truth-vector atoms.
-/
theorem not_rawEpochTruthVectorInvariant_of_pathOfHistory_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    {h h' : History In₁ In₂ Graph Out₁ Out₂}
    (hpath : pathOfHistory h = pathOfHistory h')
    (hstate_ne :
      uniform.noDirectEpochStateAfterHistory initialBoundary h ≠
        uniform.noDirectEpochStateAfterHistory initialBoundary h') :
    ¬ StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory := by
  intro rawInvariant
  have htruth :
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h) =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h') := by
    rw [hpath]
  exact hstate_ne
    (rawInvariant
      cert.determinesPathData_proof
      cert.predecessorClosed_proof
      cert.boundaryClosed_proof
      cert.continuationClosed_proof
      h h' htruth)

