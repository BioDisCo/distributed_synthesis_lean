    (StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant_of_pathRelevantHistoryEq
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory pathEquivalentDeterminesRelevantHistory)
    (StabilizedSaturationBasisNoDirectAutomatonTruthVectorInvariant_of_pathRelevantHistoryEq
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory pathEquivalentDeterminesRelevantHistory
      automatonOfHistory_respectsRelevantHistory)

