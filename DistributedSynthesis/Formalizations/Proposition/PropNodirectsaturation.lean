    { generatedLength := ?_
      currentViewsOfTruth := currentViewsOfTruth
      currentViews_factor := ?_
      generatedPrefixTruthOf := generatedPrefixTruthOf
      generatedPrefixTruth_factor := ?_
      automatonOfTruth := automatonOfTruth
      automaton_factor := ?_
      relevantHistoryDeterminesTruthVector := relevantHistoryDeterminesTruthVector }
  · intro envs envs' hpath
    exact generatedLength_determined envs envs'
      (stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent hpath)
  · intro h
    have hwitness :
        ∃ hist : History In₁ In₂ Graph Out₁ Out₂,
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound hist) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) :=
      ⟨h, rfl⟩
    dsimp [currentViewsOfTruth]
    rw [dif_pos hwitness]
    exact
