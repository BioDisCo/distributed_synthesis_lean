    (_uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) where
  generatedLength :
    ∀ envs envs' : List (EnvironmentRound In₁ In₂),
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs))
        (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs')) ->
      envs.length = envs'.length
  currentViewsOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
      View In₁ In₂ Proc.one × View In₁ In₂ Proc.two
  currentViews_factor :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      (currentView Proc.one h, currentView Proc.two h) =
        currentViewsOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h))
  generatedPrefixTruthOf :
    RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
      Nat -> RegularTestTruthAtom (stabilizedSaturationBasis cert)
  generatedPrefixTruth_factor :
    ∀ envs pref : List (EnvironmentRound In₁ In₂),
      pref.length ≤ envs.length ->
      (∃ suff, envs = pref ++ suff) ->
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ pref)) =
        generatedPrefixTruthOf
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              (executionPrefixFromList σ envs)))
          pref.length
  automatonOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis cert) -> AState
  automaton_factor :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      automatonOfHistory h =
        automatonOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h))
  relevantHistoryDeterminesTruthVector :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      List.Forall₂ NoDirectEpochRelevantRoundEq h h' ->
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound h')

