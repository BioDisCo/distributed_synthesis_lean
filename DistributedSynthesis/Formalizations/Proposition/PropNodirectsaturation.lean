      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        Nat -> RegularTestTruthAtom (stabilizedSaturationBasis cert) :=
    fun atom k =>
      if h :
          ∃ envs : List (EnvironmentRound In₁ In₂),
            ∃ pref : List (EnvironmentRound In₁ In₂),
              pref.length ≤ envs.length ∧
              (∃ suff, envs = pref ++ suff) ∧
              regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound
