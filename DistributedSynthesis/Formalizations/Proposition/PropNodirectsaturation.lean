/--
Package-level relevant-history route for the current no-direct saturation
skeleton.

It reduces the two-field truth-vector invariant package to the single theorem
that stabilized truth-vector equality determines the graph/input/output round
trace, plus the choice-specific theorem that `automatonOfHistory` only depends
on that same trace.
-/
theorem StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_relevantHistoryEq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (truthVectorDeterminesRelevantHistory :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        List.Forall₂ NoDirectEpochRelevantRoundEq h h')
    (automatonOfHistory_respectsRelevantHistory :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        List.Forall₂ NoDirectEpochRelevantRoundEq h h' ->
        automatonOfHistory h = automatonOfHistory h') :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory :=
  StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_split
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory
    (StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant_of_relevantHistoryEq
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory truthVectorDeterminesRelevantHistory)
    (StabilizedSaturationBasisNoDirectAutomatonTruthVectorInvariant_of_relevantHistoryEq
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory truthVectorDeterminesRelevantHistory
      automatonOfHistory_respectsRelevantHistory)

/--
Trace-equality form of the package-level relevant-history route.

This is often the more natural mathematical target: prove that equal stabilized
truth-vector atoms determine the graph/input/output traces, then reconstruct
`List.Forall₂ NoDirectEpochRelevantRoundEq` mechanically.
-/
