            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h))) :
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory :=
  { receiptOrderOfTruth := receiptOrderOfTruth
    receiptOrder_factor := receiptOrder_factor }

/--
Build receipt/order truth-factor data from well-definedness on stabilized truth
atoms.

The truth-level receipt/order value is chosen from an arbitrary realized
history for each realized truth atom, and falls back to
`defaultReceiptOrderData` on unrealized atoms.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData.of_truthDeterminesReceiptOrder
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (receiptOrder_eq_of_truth_eq :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        currentReceiptOrderData h (orderOfHistory h) =
          currentReceiptOrderData h' (orderOfHistory h')) :
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory := by
  classical
  let realized :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> Prop :=
    fun truth =>
      ∃ h : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          truth
  let witness :
      ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis cert),
        realized truth ->
          { h : History In₁ In₂ Graph Out₁ Out₂ //
            regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound h) =
              truth } :=
    fun truth hreal =>
      ⟨Classical.choose hreal, Classical.choose_spec hreal⟩
  let receiptOrderOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> ReceiptOrderData :=
    fun truth =>
      if hreal : realized truth then
        currentReceiptOrderData (witness truth hreal).1
          (orderOfHistory (witness truth hreal).1)
      else
        defaultReceiptOrderData
  exact
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData.of_fields
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory receiptOrderOfTruth
      (by
        intro h
        dsimp [receiptOrderOfTruth, realized]
        have hreal :
            ∃ h' : History In₁ In₂ Graph Out₁ Out₂,
              regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound h') =
                regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound h) :=
          ⟨h, rfl⟩
        rw [dif_pos hreal]
        dsimp [witness]
        exact
          receiptOrder_eq_of_truth_eq h (Classical.choose hreal)
            (Classical.choose_spec hreal).symm)

/--
Append-level receipt/order determinacy plus the mixed empty-prefix case gives
the non-append receipt/order truth-factor package.

The nonempty/nonempty histories are reduced to append histories.  Empty/empty
is handled by the supplied empty payload, and the two mixed cases are exactly
the `emptyCompatibility` premise.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData.of_appendDeterminesReceiptOrderAndEmptyCompatibility
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (appendTruthDeterminesReceiptOrder :
      ∀ (pref pref' : History In₁ In₂ Graph Out₁ Out₂)
        (r r' : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound (History.append pref r)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound (History.append pref' r')) ->
        currentReceiptOrderDataForAppend pref r =
          currentReceiptOrderDataForAppend pref' r')
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) =
            graphContainmentOrder r.graph)
    (emptyReceiptOrderData :
      currentReceiptOrderData
          ([] : History In₁ In₂ Graph Out₁ Out₂)
          (orderOfHistory
            ([] : History In₁ In₂ Graph Out₁ Out₂)) =
        defaultReceiptOrderData)
    (emptyCompatibility :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        h ≠ [] ->
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              ([] : History In₁ In₂ Graph Out₁ Out₂)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) ->
        currentReceiptOrderData h (orderOfHistory h) =
          defaultReceiptOrderData) :
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory :=
  StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData.of_truthDeterminesReceiptOrder
    uniform initialBoundary cert edgeOfRound containmentOrder
    orderOfHistory automatonOfHistory
    (by
      intro h h' htruth
      by_cases hne : h ≠ []
      · by_cases hne' : h' ≠ []
        · rcases history_eq_append_of_ne_nil hne with ⟨pref, r, hh⟩
          rcases history_eq_append_of_ne_nil hne' with ⟨pref', r', hh'⟩
          have htruthAppend :
              regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound
                    (History.append pref r)) =
                regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound
                    (History.append pref' r')) := by
            simpa [hh, hh'] using htruth
          have happend :
              currentReceiptOrderDataForAppend pref r =
                currentReceiptOrderDataForAppend pref' r' :=
            appendTruthDeterminesReceiptOrder pref pref' r r' htruthAppend
          calc
            currentReceiptOrderData h (orderOfHistory h) =
                currentReceiptOrderData (History.append pref r)
                  (orderOfHistory (History.append pref r)) := by
                  rw [hh]
            _ =
                currentReceiptOrderData (History.append pref r)
                  (graphContainmentOrder r.graph) := by
                  rw [orderOfAppend pref r]
            _ = currentReceiptOrderDataForAppend pref r := rfl
            _ = currentReceiptOrderDataForAppend pref' r' := happend
            _ =
                currentReceiptOrderData (History.append pref' r')
                  (graphContainmentOrder r'.graph) := rfl
            _ =
                currentReceiptOrderData (History.append pref' r')
                  (orderOfHistory (History.append pref' r')) := by
                  rw [orderOfAppend pref' r']
            _ = currentReceiptOrderData h' (orderOfHistory h') := by
                  rw [hh']
        · have hh' : h' = [] := by simpa using not_not.mp hne'
          calc
            currentReceiptOrderData h (orderOfHistory h) =
                defaultReceiptOrderData := by
                exact emptyCompatibility h hne (by simpa [hh'] using htruth.symm)
            _ =
                currentReceiptOrderData h' (orderOfHistory h') := by
                rw [hh']
                exact emptyReceiptOrderData.symm
      · have hh : h = [] := by simpa using not_not.mp hne
        by_cases hne' : h' ≠ []
        · calc
            currentReceiptOrderData h (orderOfHistory h) =
                defaultReceiptOrderData := by
                rw [hh]
                exact emptyReceiptOrderData
            _ =
                currentReceiptOrderData h' (orderOfHistory h') := by
                exact (emptyCompatibility h' hne' (by simpa [hh] using htruth)).symm
        · have hh' : h' = [] := by simpa using not_not.mp hne'
          rw [hh, hh'])

/--
Current-order specialization of
`StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData.of_appendDeterminesReceiptOrderAndEmptyCompatibility`.

For `historyCurrentContainmentOrder`, append-order correctness and the neutral
empty receipt/order payload are discharged by definitional lemmas.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData.of_currentOrderAppendDeterminesReceiptOrderAndEmptyCompatibility
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
