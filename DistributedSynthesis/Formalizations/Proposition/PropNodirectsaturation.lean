      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (core :
      StabilizedSaturationBasisNoDirectClosureSoundnessCore
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisNoDirectAutomatonTruthVectorInvariant
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory := by
  intro hcont h h' htruth
  exact
    core.automatonOfHistory_of_continuationClosed hcont h h'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)

/--
Componentwise interpretation of the stabilized closure fields for the current
no-direct path-invariance target.

This is a more explicit version of
`StabilizedSaturationBasisNoDirectPathInvariantsSoundness`: each field names the
part of the raw epoch-state or automaton-profile argument that a closure
hypothesis is expected to supply.
-/
structure StabilizedSaturationBasisNoDirectClosureSoundnessComponents
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (_containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (_orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) : Prop where
  boundary_boundary_of_determinesPathData :
    cert.determinesPathData ->
      ∀ h h' boundary boundary',
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory h) (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inl boundary ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inl boundary' ->
        boundary = boundary'
  sideOne_sideOne_of_predecessorClosed :
    cert.predecessorClosed ->
      ∀ h h' summary summary',
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory h) (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inr (Sum.inl summary) ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inr (Sum.inl summary') ->
        summary = summary'
  sideTwo_sideTwo_of_predecessorClosed :
    cert.predecessorClosed ->
      ∀ h h' summary summary',
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory h) (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inr (Sum.inr summary) ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inr (Sum.inr summary') ->
        summary = summary'
  boundary_sideOne_absurd_of_boundaryClosed :
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
      ∀ h h' boundary summary',
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory h) (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inl boundary ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inr (Sum.inl summary') ->
        False
  boundary_sideTwo_absurd_of_boundaryClosed :
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
      ∀ h h' boundary summary',
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory h) (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inl boundary ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inr (Sum.inr summary') ->
        False
  sideOne_boundary_absurd_of_boundaryClosed :
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
      ∀ h h' summary boundary',
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory h) (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inr (Sum.inl summary) ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inl boundary' ->
        False
  sideTwo_boundary_absurd_of_boundaryClosed :
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
      ∀ h h' summary boundary',
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory h) (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inr (Sum.inr summary) ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inl boundary' ->
        False
  sideOne_sideTwo_absurd_of_continuationClosed :
    cert.continuationClosed ->
      ∀ h h' summary summary',
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory h) (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inr (Sum.inl summary) ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inr (Sum.inr summary') ->
        False
  sideTwo_sideOne_absurd_of_continuationClosed :
    cert.continuationClosed ->
      ∀ h h' summary summary',
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory h) (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          Sum.inr (Sum.inr summary) ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h' =
          Sum.inr (Sum.inl summary') ->
        False
  automatonOfHistory_of_continuationClosed :
    cert.continuationClosed ->
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory h) (pathOfHistory h') ->
        automatonOfHistory h = automatonOfHistory h'

/--
Project the componentwise closure interpretation directly into the newer raw
truth-vector component skeleton.

Each field keeps the intended closure source visible: `determinesPathData` for
boundary/boundary, `predecessorClosed` for same-side summaries,
`boundaryClosed` for boundary/side shape changes, and `continuationClosed` for
opposite-side shape changes.
-/
theorem
    StabilizedSaturationBasisNoDirectRawEpochTruthVectorComponentInvariants_of_closureComponents
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
