          (∃ suff, envs = pref ++ suff) ->
          (∃ suff', envs' = pref' ++ suff') ->
          StabilizedSaturationBasisPathEquivalent cert
            (pathOfHistory (executionPrefixFromList σ pref))
            (pathOfHistory (executionPrefixFromList σ pref')))
    (pathEquivalentDeterminesCurrentViews :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory h) (pathOfHistory h') ->
