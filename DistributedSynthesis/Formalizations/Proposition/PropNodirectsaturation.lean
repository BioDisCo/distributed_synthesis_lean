/--
Quotient-factor form of the compact closure soundness target.

This is often the most useful mathematical skeleton: construct the raw
no-direct epoch state and the automaton profile as functions of the stabilized
truth-vector atom.  Once these factorization equations are available, path
invariance follows immediately from equality of stabilized truth vectors.
-/
structure StabilizedSaturationBasisNoDirectClosureSoundnessQuotientFactors
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (_containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (_orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) where
  rawEpochOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
      EpochRotatingAccessState
        uniform.boundary (uniform.summary Proc.one) (uniform.summary Proc.two)
  automatonOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis cert) -> AState
  rawEpoch_factor_of_closureFields :
    cert.determinesPathData ->
    cert.predecessorClosed ->
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
    cert.continuationClosed ->
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        rawEpochOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h)) =
          uniform.noDirectEpochStateAfterHistory initialBoundary h
  automaton_factor_of_continuationClosed :
    cert.continuationClosed ->
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        automatonOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h)) =
          automatonOfHistory h

/--
Two-field truth-vector invariance target for the no-direct closure branch.

This is the current preferred mathematical skeleton: prove that equality of the
stabilized truth-vector atom preserves the raw no-direct epoch state, and prove
that it preserves the automaton state read from history.  The quotient-factor,
compact-core, constructor-case, and final separation layers are then automatic.
-/
structure StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (_containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (_orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) : Prop where
  rawEpochState_invariant :
    cert.determinesPathData ->
    cert.predecessorClosed ->
    (∀ boundaryState, cert.boundaryClosed boundaryState) ->
    cert.continuationClosed ->
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          uniform.noDirectEpochStateAfterHistory initialBoundary h'
  automatonOfHistory_invariant :
    cert.continuationClosed ->
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        automatonOfHistory h = automatonOfHistory h'

/--
Quotient-style fallback for the current no-direct saturation target.

The preferred concrete relation is
`List.Forall₂ NoDirectEpochRelevantRoundEq`, but this structure deliberately
allows a weaker relation if the stabilized tests determine only a quotient of
the round trace.  It is enough that equal stabilized truth-vector atoms imply
the relation and that both semantic states needed by Step 3 respect it.
-/
structure StabilizedSaturationBasisNoDirectTraceQuotientInvariants
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (_containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (_orderOfHistory :
