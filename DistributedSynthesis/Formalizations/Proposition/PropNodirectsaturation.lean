noncomputable def StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representedTruthAtomsClosureSummaryParityRepresentatives
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (stateOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ ->
        { truth : RegularTestTruthAtom (stabilizedSaturationBasis cert) //
          ∃ envs : List (EnvironmentRound In₁ In₂),
            envs.length ≤ generationBound ∧
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound
                (executionPrefixFromList σ envs)) = truth ∧
            ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
              ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
                executionPrefixFromList σ envs = History.append pref r })
    (state_truth_eq :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
      (stateOfHistory c.1.history).1 =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history))
    (closureInvariants :
      StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
        uniform initialBoundary cert (pathOfHistoryByRound edgeOfRound)
        containmentOrder orderOfHistory automatonOfHistory)
    (summaryUnit : Summary₂)
    (decodeReceiptOrder :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) × Summary₂ ->
        ReceiptOrderData)
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrder
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound (History.append pref r)),
                summaryUnit) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (coherentHistoryAppend :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            c.1.history = History.append pref r)
    (parityOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> ParityProgress)
    (parity_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        parityOfHistory h =
          parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h))) :
    StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory σ generationBound := by
  classical
  letI : Fintype (RegularTestTruthAtom (stabilizedSaturationBasis cert)) :=
    regularTestTruthAtomFintype (stabilizedSaturationBasis cert)
  let Q :=
    { truth : RegularTestTruthAtom (stabilizedSaturationBasis cert) //
      ∃ envs : List (EnvironmentRound In₁ In₂),
        envs.length ≤ generationBound ∧
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ envs)) = truth ∧
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            executionPrefixFromList σ envs = History.append pref r }
  let chosenEnvs : Q -> List (EnvironmentRound In₁ In₂) :=
    fun x => Classical.choose x.2
  have chosen_length :
      ∀ x : Q, (chosenEnvs x).length ≤ generationBound := by
    intro x
    exact (Classical.choose_spec x.2).1
  have chosen_truth :
      ∀ x : Q,
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (chosenEnvs x))) = x.1 := by
    intro x
    exact (Classical.choose_spec x.2).2.1
  have chosen_append :
      ∀ x : Q,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            executionPrefixFromList σ (chosenEnvs x) =
              History.append pref r := by
    intro x
    exact (Classical.choose_spec x.2).2.2
  refine
    { Q := Q
      qFinite := by infer_instance
      stateOfHistory := stateOfHistory
      envsOf := chosenEnvs
      envs_length_le := chosen_length
      truthOf := fun x => x.1
      state_truth_eq := state_truth_eq
      representative_truth_eq := chosen_truth
      quotientEnrichedState_eq := ?_
      representativeEnriched_eq_of_truthOf_eq := ?_ }
  · intro c
    exact
      noDirectEpochStateWithAContinuationData_eq_of_components
        uniform initialBoundary orderOfHistory automatonOfHistory
        parityOfHistory
        (closureInvariants.rawEpochState_invariant
          cert.determinesPathData_proof
          cert.predecessorClosed_proof
          cert.boundaryClosed_proof
          cert.continuationClosed_proof c.1.history
          (executionPrefixFromList σ
            (chosenEnvs (stateOfHistory c.1.history)))
          (by
            calc
              regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound c.1.history)
                  =
                (stateOfHistory c.1.history).1 := by
                  exact (state_truth_eq c).symm
              _ =
                regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound
                    (executionPrefixFromList σ
                      (chosenEnvs (stateOfHistory c.1.history)))) := by
                  exact
                    (chosen_truth (stateOfHistory c.1.history)).symm))
        (currentReceiptOrderData_eq_of_truthVectorSummary
          cert edgeOfRound orderOfHistory summaryUnit decodeReceiptOrder
          decodesCurrent orderOfAppend
          ⟨coherentHistoryAppend c,
            chosen_append (stateOfHistory c.1.history)⟩
          (by
            calc
              regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound c.1.history)
                  =
                (stateOfHistory c.1.history).1 := by
                  exact (state_truth_eq c).symm
              _ =
                regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound
                    (executionPrefixFromList σ
                      (chosenEnvs (stateOfHistory c.1.history)))) := by
                  exact
                    (chosen_truth (stateOfHistory c.1.history)).symm))
        (closureInvariants.automatonOfHistory_invariant
          cert.continuationClosed_proof c.1.history
          (executionPrefixFromList σ
            (chosenEnvs (stateOfHistory c.1.history)))
          (by
            calc
              regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound c.1.history)
                  =
                (stateOfHistory c.1.history).1 := by
                  exact (state_truth_eq c).symm
              _ =
                regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound
                    (executionPrefixFromList σ
                      (chosenEnvs (stateOfHistory c.1.history)))) := by
                  exact
                    (chosen_truth (stateOfHistory c.1.history)).symm))
        (by
          calc
            parityOfHistory c.1.history =
                parityOfTruth
                  (regularTestTruthVector (stabilizedSaturationBasis cert)
                    (pathOfHistoryByRound edgeOfRound c.1.history)) :=
                  parity_factor c.1.history
            _ = parityOfTruth
                  (regularTestTruthVector (stabilizedSaturationBasis cert)
                    (pathOfHistoryByRound edgeOfRound
                      (executionPrefixFromList σ
                        (chosenEnvs (stateOfHistory c.1.history))))) := by
                  apply congrArg parityOfTruth
                  calc
                    regularTestTruthVector (stabilizedSaturationBasis cert)
                        (pathOfHistoryByRound edgeOfRound c.1.history)
                        =
                      (stateOfHistory c.1.history).1 := by
                        exact (state_truth_eq c).symm
                    _ =
                      regularTestTruthVector (stabilizedSaturationBasis cert)
                        (pathOfHistoryByRound edgeOfRound
                          (executionPrefixFromList σ
                            (chosenEnvs (stateOfHistory c.1.history)))) := by
                        exact
                          (chosen_truth (stateOfHistory c.1.history)).symm
            _ = parityOfHistory
                  (executionPrefixFromList σ
                    (chosenEnvs (stateOfHistory c.1.history))) :=
                  (parity_factor
                    (executionPrefixFromList σ
                      (chosenEnvs (stateOfHistory c.1.history)))).symm)
  · intro x x' htruth
    exact
      noDirectEpochStateWithAContinuationData_eq_of_components
        uniform initialBoundary orderOfHistory automatonOfHistory
        parityOfHistory
        (closureInvariants.rawEpochState_invariant
          cert.determinesPathData_proof
          cert.predecessorClosed_proof
          cert.boundaryClosed_proof
          cert.continuationClosed_proof
          (executionPrefixFromList σ (chosenEnvs x))
          (executionPrefixFromList σ (chosenEnvs x'))
          (by
            calc
              regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound
                    (executionPrefixFromList σ (chosenEnvs x)))
                  =
                x.1 := chosen_truth x
              _ = x'.1 := htruth
              _ =
                regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound
                    (executionPrefixFromList σ (chosenEnvs x'))) := by
                  exact (chosen_truth x').symm))
        (currentReceiptOrderData_eq_of_truthVectorSummary
          cert edgeOfRound orderOfHistory summaryUnit decodeReceiptOrder
          decodesCurrent orderOfAppend
          ⟨chosen_append x, chosen_append x'⟩
          (by
            calc
              regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound
                    (executionPrefixFromList σ (chosenEnvs x)))
                  =
                x.1 := chosen_truth x
              _ = x'.1 := htruth
              _ =
                regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound
                    (executionPrefixFromList σ (chosenEnvs x'))) := by
                  exact (chosen_truth x').symm))
        (closureInvariants.automatonOfHistory_invariant
          cert.continuationClosed_proof
          (executionPrefixFromList σ (chosenEnvs x))
          (executionPrefixFromList σ (chosenEnvs x'))
          (by
            calc
              regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound
                    (executionPrefixFromList σ (chosenEnvs x)))
                  =
                x.1 := chosen_truth x
              _ = x'.1 := htruth
              _ =
                regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistoryByRound edgeOfRound
                    (executionPrefixFromList σ (chosenEnvs x'))) := by
                  exact (chosen_truth x').symm))
        (by
          calc
            parityOfHistory (executionPrefixFromList σ (chosenEnvs x)) =
                parityOfTruth
                  (regularTestTruthVector (stabilizedSaturationBasis cert)
                    (pathOfHistoryByRound edgeOfRound
                      (executionPrefixFromList σ (chosenEnvs x)))) :=
                  parity_factor (executionPrefixFromList σ (chosenEnvs x))
            _ = parityOfTruth x.1 := by
                  rw [chosen_truth x]
            _ = parityOfTruth x'.1 := by
                  rw [htruth]
            _ = parityOfTruth
                  (regularTestTruthVector (stabilizedSaturationBasis cert)
                    (pathOfHistoryByRound edgeOfRound
                      (executionPrefixFromList σ (chosenEnvs x')))) := by
                  rw [chosen_truth x']
            _ = parityOfHistory (executionPrefixFromList σ (chosenEnvs x')) :=
                  (parity_factor
                    (executionPrefixFromList σ (chosenEnvs x'))).symm)

/--
Bundled localized represented-truth payload.

This is the current sharp finite-memory target.  It packages exactly the data
needed by
`StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representedTruthAtomsClosureSummaryParityRepresentatives`.
The representative side carries append decompositions only for the bounded
generated representatives, while coherent configurations carry the ordinary
coherent-history append decomposition.
-/
structure StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityPayload
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat) where
  Summary₂ : Type (max u v w a b)
  stateOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ ->
      { truth : RegularTestTruthAtom (stabilizedSaturationBasis cert) //
        ∃ envs : List (EnvironmentRound In₁ In₂),
          envs.length ≤ generationBound ∧
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              (executionPrefixFromList σ envs)) = truth ∧
          ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
            ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
              executionPrefixFromList σ envs = History.append pref r }
  state_truth_eq :
    ∀ c :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
    (stateOfHistory c.1.history).1 =
      regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistoryByRound edgeOfRound c.1.history)
  closureInvariants :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      uniform initialBoundary cert (pathOfHistoryByRound edgeOfRound)
      containmentOrder orderOfHistory automatonOfHistory
  summaryUnit : Summary₂
  decodeReceiptOrder :
    RegularTestTruthAtom (stabilizedSaturationBasis cert) × Summary₂ ->
      ReceiptOrderData
  decodesCurrent :
    ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
      ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        decodeReceiptOrder
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound (History.append pref r)),
              summaryUnit) =
          currentReceiptOrderDataForAppend pref r
  orderOfAppend :
    ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
      ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        orderOfHistory (History.append pref r) = graphContainmentOrder r.graph
  coherentHistoryAppend :
    ∀ c :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
    ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
      ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        c.1.history = History.append pref r
  parityOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis cert) -> ParityProgress
  parity_factor :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      parityOfHistory h =
        parityOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h))

/--
Derive the old history-level parity-progress bridge from the payload parity
factorization and a truth-atom-level outcome bridge.
-/
theorem sameParityOfProgress_of_representedTruthClosureSummaryParityPayload
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    {uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂}
    {initialBoundary : uniform.boundary}
    {cert : StabilizedSaturationBasisCertificate sat n}
    {edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType}
    {sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop}
    {containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder}
    {orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder}
    {automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState}
    {parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress}
    {σ : StrategyPair In₁ In₂ Out₁ Out₂}
    {generationBound : Nat}
    (payload :
      StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityPayload
        uniform initialBoundary cert edgeOfRound containmentOrder
        orderOfHistory automatonOfHistory parityOfHistory σ generationBound)
    (sameParityOfTruth :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        payload.parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound c.1.history)) =
          payload.parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound c'.1.history)) ->
          sameParityOutcomes c.1 c'.1) :
    ∀ c c' :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      parityOfHistory c.1.history = parityOfHistory c'.1.history ->
        sameParityOutcomes c.1 c'.1 := by
  intro c c' hparity
  apply sameParityOfTruth c c'
  calc
    payload.parityOfTruth
        (regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history)) =
        parityOfHistory c.1.history := (payload.parity_factor c.1.history).symm
    _ = parityOfHistory c'.1.history := hparity
    _ =
        payload.parityOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound c'.1.history)) :=
        payload.parity_factor c'.1.history

/--
Build the bundled represented-truth payload from the focused finite-state
separation target.

This replaces the opaque closure-invariant field by the concrete journal-style
condition that equal stabilized truth atoms determine the pair consisting of
the raw no-direct epoch state and the chosen automaton history state.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityPayload.of_rawAutomatonStateEq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
