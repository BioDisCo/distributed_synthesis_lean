/--
Generated-current-view route where the generated length is recovered from the
typed-path length.  This replaces the direct generated-length assumption by two
more concrete obligations: generated prefixes have paths of the same length,
and stabilized same-tests preserve path length.
-/
theorem StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_pathStrategyGeneratedCurrentViews_pathLength
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁] [Inhabited In₂]
