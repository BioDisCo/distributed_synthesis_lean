        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (pathEquivalentDeterminesRelevantHistory :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory h) (pathOfHistory h') ->
        List.Forall₂ NoDirectEpochRelevantRoundEq h h') :
    StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory :=
  StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant_of_relevantHistoryEq
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory
    (by
      intro h h' htruth
      exact pathEquivalentDeterminesRelevantHistory h h'
        (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth))

/--
Diagnostic no-go for the raw relevant-history target.

The desired premise
`pathEquivalentDeterminesRelevantHistory` cannot be obtained from the abstract
stabilized basis alone: if the chosen `pathOfHistory` identifies two histories
whose graph/input/output traces differ, those histories are path-equivalent but
not no-direct transition-relevant equal.
-/
theorem not_pathEquivalentDeterminesRelevantHistory_of_pathOfHistory_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    {cert : StabilizedSaturationBasisCertificate sat n}
    {pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType}
    {h h' : History In₁ In₂ Graph Out₁ Out₂}
    (hpath : pathOfHistory h = pathOfHistory h')
    (hnotRelevant : ¬ List.Forall₂ NoDirectEpochRelevantRoundEq h h') :
    ¬ (∀ x y : History In₁ In₂ Graph Out₁ Out₂,
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory x) (pathOfHistory y) ->
        List.Forall₂ NoDirectEpochRelevantRoundEq x y) := by
  intro hdet
  exact hnotRelevant
    (hdet h h'
      (by
        rw [hpath]
        exact StabilizedSaturationBasisPathEquivalent.refl cert
          (pathOfHistory h')))

/--
Automaton route from the same concrete relevant-history dependency used by the
