    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (components :
      StabilizedSaturationBasisNoDirectClosureSoundnessComponents
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisNoDirectRawEpochTruthVectorComponentInvariants
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory where
  boundary_boundary := by
    intro hdet _ _ _ h h' boundary boundary' htruth hstate hstate'
    exact components.boundary_boundary_of_determinesPathData hdet
      h h' boundary boundary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  sideOne_sideOne := by
    intro _ hpred _ _ h h' summary summary' htruth hstate hstate'
    exact components.sideOne_sideOne_of_predecessorClosed hpred
      h h' summary summary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  sideTwo_sideTwo := by
    intro _ hpred _ _ h h' summary summary' htruth hstate hstate'
    exact components.sideTwo_sideTwo_of_predecessorClosed hpred
      h h' summary summary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  boundary_sideOne_absurd := by
    intro _ _ hboundary _ h h' boundary summary' htruth hstate hstate'
    exact components.boundary_sideOne_absurd_of_boundaryClosed hboundary
      h h' boundary summary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  boundary_sideTwo_absurd := by
    intro _ _ hboundary _ h h' boundary summary' htruth hstate hstate'
    exact components.boundary_sideTwo_absurd_of_boundaryClosed hboundary
      h h' boundary summary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  sideOne_boundary_absurd := by
    intro _ _ hboundary _ h h' summary boundary' htruth hstate hstate'
    exact components.sideOne_boundary_absurd_of_boundaryClosed hboundary
      h h' summary boundary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  sideOne_sideTwo_absurd := by
    intro _ _ _ hcont h h' summary summary' htruth hstate hstate'
    exact components.sideOne_sideTwo_absurd_of_continuationClosed hcont
      h h' summary summary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  sideTwo_boundary_absurd := by
    intro _ _ hboundary _ h h' summary boundary' htruth hstate hstate'
    exact components.sideTwo_boundary_absurd_of_boundaryClosed hboundary
      h h' summary boundary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'
  sideTwo_sideOne_absurd := by
    intro _ _ _ hcont h h' summary summary' htruth hstate hstate'
    exact components.sideTwo_sideOne_absurd_of_continuationClosed hcont
      h h' summary summary'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
      hstate hstate'

