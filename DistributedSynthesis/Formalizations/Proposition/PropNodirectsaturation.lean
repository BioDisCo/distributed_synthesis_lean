/--
Representative-list constructor for the bounded represented truth-state package.

This is the most concrete state-classifier surface: choose a truth atom and a
bounded generated representative list for each history, prove the representative
realizes the chosen atom and is an append history, and prove coherent histories
get their actual truth atom.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedRepresentedTruthStateData.of_representatives
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (truthOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ ->
        RegularTestTruthAtom (stabilizedSaturationBasis cert))
    (envsOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂))
    (envs_bound :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        (envsOfHistory h).length ≤ generationBound)
    (envs_truth :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (envsOfHistory h))) =
          truthOfHistory h)
    (envs_append :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            executionPrefixFromList σ (envsOfHistory h) =
              History.append pref r)
    (truthOfHistory_eq :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
      truthOfHistory c.1.history =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history)) :
    StabilizedSaturationBasisBoundedGeneratedRepresentedTruthStateData
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory σ generationBound :=
  StabilizedSaturationBasisBoundedGeneratedRepresentedTruthStateData.of_fields
    uniform initialBoundary cert edgeOfRound containmentOrder orderOfHistory
    automatonOfHistory σ generationBound
    (fun h =>
      ⟨truthOfHistory h,
        ⟨envsOfHistory h, envs_bound h, envs_truth h, envs_append h⟩⟩)
    truthOfHistory_eq

/--
Nonempty finite generated prefixes are append histories.
-/
theorem executionPrefixFromList_eq_append_of_ne_nil
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    {envs : List (EnvironmentRound In₁ In₂)}
    (hnonempty : envs ≠ []) :
    ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
      ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        executionPrefixFromList σ envs = History.append pref r := by
  induction envs using List.reverseRecOn with
  | nil =>
      exact False.elim (hnonempty rfl)
  | append_singleton envs env =>
      exact ⟨executionPrefixFromList σ envs,
        nextRound σ (executionPrefixFromList σ envs) env, by simp⟩

/--
Representative-list constructor where append decomposition is discharged from
nonemptiness of the generated representative lists.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedRepresentedTruthStateData.of_nonempty_representatives
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (truthOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ ->
        RegularTestTruthAtom (stabilizedSaturationBasis cert))
    (envsOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂))
    (envs_bound :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        (envsOfHistory h).length ≤ generationBound)
    (envs_truth :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (envsOfHistory h))) =
          truthOfHistory h)
    (envs_nonempty :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        envsOfHistory h ≠ [])
    (truthOfHistory_eq :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
      truthOfHistory c.1.history =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history)) :
    StabilizedSaturationBasisBoundedGeneratedRepresentedTruthStateData
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory σ generationBound :=
  StabilizedSaturationBasisBoundedGeneratedRepresentedTruthStateData.of_representatives
    uniform initialBoundary cert edgeOfRound containmentOrder orderOfHistory
    automatonOfHistory σ generationBound truthOfHistory envsOfHistory
    envs_bound envs_truth
    (fun h => executionPrefixFromList_eq_append_of_ne_nil σ (envs_nonempty h))
    truthOfHistory_eq

/--
Receipt/order summary and append bookkeeping for the final no-direct route.

This isolates the data that decodes the current receipt-order state from a
