    (state_truth_eq :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
      (stateOfHistory c.1.history).1 =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history))
    (closureInvariants :
      StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
        uniform initialBoundary cert (pathOfHistoryByRound edgeOfRound)
        containmentOrder orderOfHistory automatonOfHistory)
    (summaryUnit : Summary₂)
    (decodeReceiptOrder :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) × Summary₂ ->
        ReceiptOrderData)
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrder
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound (History.append pref r)),
                summaryUnit) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (historyAppend :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            h = History.append pref r)
    (parityOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> ParityProgress)
    (parity_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        parityOfHistory h =
          parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h))) :
    StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory σ generationBound :=
  StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representedTruthAtomsClosureInvariants
    uniform initialBoundary cert edgeOfRound containmentOrder
    orderOfHistory automatonOfHistory parityOfHistory σ generationBound
    stateOfHistory state_truth_eq closureInvariants
    (by
      intro h h' htruth
      exact
        currentReceiptOrderData_eq_of_truthVectorSummary
          cert edgeOfRound orderOfHistory summaryUnit decodeReceiptOrder
          decodesCurrent orderOfAppend
          ⟨historyAppend h, historyAppend h'⟩ htruth)
    (by
      intro h h' htruth
      calc
        parityOfHistory h =
            parityOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound h)) := parity_factor h
        _ = parityOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound h')) := by
              rw [htruth]
        _ = parityOfHistory h' := (parity_factor h').symm)

