  constructor
  · intro hdet hpred hboundary hcont h h' htruth
    rw [← factorization.rawEpoch_factor hdet hpred hboundary hcont h,
      ← factorization.rawEpoch_factor hdet hpred hboundary hcont h',
      htruth]
  · intro hcont h h' htruth
    rw [← factorization.automaton_factor hcont h,
      ← factorization.automaton_factor hcont h',
      htruth]

/--
