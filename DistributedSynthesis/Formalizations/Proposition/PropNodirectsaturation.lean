/--
The quotient-factor skeleton implies the compact closure-soundness core.

The proof is pure quotient bookkeeping: stabilized path-equivalence gives
equality of stabilized truth-vector atoms, and the factorization equations
rewrite both semantic states to those atoms.
-/
theorem StabilizedSaturationBasisNoDirectClosureSoundnessCore_of_quotientFactors
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (factors :
      StabilizedSaturationBasisNoDirectClosureSoundnessQuotientFactors
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisNoDirectClosureSoundnessCore
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory where
  rawEpochState_of_closureFields := by
    intro hdet hpred hboundary hcont h h' heq
    have htruth :
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') :=
      stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent heq
    have hfactor :=
      factors.rawEpoch_factor_of_closureFields
        hdet hpred hboundary hcont h
    have hfactor' :=
      factors.rawEpoch_factor_of_closureFields
        hdet hpred hboundary hcont h'
    rw [← hfactor, ← hfactor', htruth]
  automatonOfHistory_of_continuationClosed := by
    intro hcont h h' heq
    have htruth :
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') :=
      stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent heq
    have hfactor := factors.automaton_factor_of_continuationClosed hcont h
    have hfactor' := factors.automaton_factor_of_continuationClosed hcont h'
    rw [← hfactor, ← hfactor', htruth]

/--
Convert quotient factors into the two-field truth-vector invariant package by
first assembling the compact core.
-/
def StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_quotientFactors
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (factors :
      StabilizedSaturationBasisNoDirectClosureSoundnessQuotientFactors
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory :=
  StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_core
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory
    (StabilizedSaturationBasisNoDirectClosureSoundnessCore_of_quotientFactors
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory factors)

/--
Convert split quotient factors directly into the two-field truth-vector
invariant package.
-/
def StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_splitQuotientFactors
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (rawFactor :
      StabilizedSaturationBasisNoDirectRawEpochQuotientFactor
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory)
    (automatonFactor :
      StabilizedSaturationBasisNoDirectAutomatonQuotientFactor
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      uniform initialBoundary cert pathOfHistory containmentOrder
