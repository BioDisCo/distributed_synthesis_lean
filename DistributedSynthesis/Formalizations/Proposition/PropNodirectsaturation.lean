        (Classical.choose_spec hwitness)).symm
  · intro envs pref hprefLe hprefSub
    have hwitness :
        ∃ envs' : List (EnvironmentRound In₁ In₂),
          ∃ pref' : List (EnvironmentRound In₁ In₂),
