    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (strategyGeneratedHistory :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        StrategyGeneratedPrefix σ h)
    (pathOfGeneratedPrefix_length :
      ∀ (env : EnvironmentSequence In₁ In₂)
        (generationLength : Nat),
        (pathOfHistory (executionPrefix σ env generationLength)).length =
          generationLength)
    (pathEquivalentDeterminesPathLength :
      ∀ (path path' : TypedPath EdgeType),
        StabilizedSaturationBasisPathEquivalent cert path path' ->
        path.length = path'.length)
    (pathEquivalentDeterminesGeneratedCurrentViews :
      ∀ (env env' : EnvironmentSequence In₁ In₂)
        (generationLength : Nat),
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory (executionPrefix σ env generationLength))
          (pathOfHistory (executionPrefix σ env' generationLength)) ->
        ∀ k : Nat, k < generationLength ->
          currentView Proc.one (executionPrefix σ env (k + 1)) =
            currentView Proc.one (executionPrefix σ env' (k + 1)) ∧
          currentView Proc.two (executionPrefix σ env (k + 1)) =
            currentView Proc.two (executionPrefix σ env' (k + 1)))
