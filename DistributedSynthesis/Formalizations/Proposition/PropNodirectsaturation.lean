import DistributedSynthesis.Formalizations.Proposition.PropNodirectfromjournal
import DistributedSynthesis.Formalizations.Proposition.PropSaturationbasis
import Mathlib.Data.Fintype.Pi
import Mathlib.Data.Fintype.Sigma

/-!
# No-direct handoff for stabilized regular-test saturation

This file connects the stabilized saturation-basis predicate to the no-direct
parity-progress certificate.  The remaining mathematical input is still the
semantic separation theorem, but it may now be stated directly with
`StabilizedSaturationBasisPathEquivalent`.
-/

namespace DistributedSynthesis

universe u v w a b

/--
Coherent no-direct `A`-continuation separation for a stabilized saturation
basis.

The saturation certificate is universe-specialized to the finite quotient
universe used by the no-direct DPA/LTL endpoints, so
`stabilizedSaturationBasis cert` can be passed directly to the existing
regular-test wrappers.
-/
def StabilizedSaturationBasisCoherentAContinuationSeparation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) : Prop :=
  ∀ c c' :
    CoherentContinuationConfiguration
      containmentOrder orderOfHistory automatonOfHistory,
    StabilizedSaturationBasisPathEquivalent cert
      (pathOfHistory c.1.history)
      (pathOfHistory c'.1.history) ->
      AContinuationEquivalent sameParityOutcomes containmentOrder c.1 c'.1

/--
The automaton-control part of the remaining semantic Step 3 claim: the
stabilized saturation summary determines the continuation automaton state.
-/
def StabilizedSaturationBasisAutomatonStateInvariant
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) : Prop :=
  ∀ c c' :
    CoherentContinuationConfiguration
      containmentOrder orderOfHistory automatonOfHistory,
    StabilizedSaturationBasisPathEquivalent cert
      (pathOfHistory c.1.history)
      (pathOfHistory c'.1.history) ->
    c.1.automatonState = c'.1.automatonState

/--
Automaton-state invariant from equality of the enriched no-direct
`A`-continuation state.

Unlike the enriched-state separation shortcuts below, this is not a
post-certificate tool: it only projects the automaton-profile field from a
candidate finite state that also carries some parity-progress payload.
-/
theorem StabilizedSaturationBasisAutomatonStateInvariant_of_enrichedState_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    {cert : StabilizedSaturationBasisCertificate sat n}
    {pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType}
    {sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop}
    {containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder}
    {orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder}
    {automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState}
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (enrichedState_eq :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory c.1.history)
          (pathOfHistory c'.1.history) ->
        uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory
            c.1.history =
          uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory
            c'.1.history) :
    StabilizedSaturationBasisAutomatonStateInvariant
      cert pathOfHistory sameParityOutcomes containmentOrder
      orderOfHistory automatonOfHistory := by
  intro c c' heq
  exact
    noDirectEpochStateWithAContinuationData_determines_configAutomatonState_of_coherent
      uniform initialBoundary containmentOrder orderOfHistory automatonOfHistory
      parityOfHistory c.2 c'.2 (enrichedState_eq c c' heq)

/--
The receipt/order part of the remaining semantic Step 3 claim: the stabilized
saturation summary determines the two current receipt tags and the current
non-fringe containment order.
-/
def StabilizedSaturationBasisReceiptOrderInvariant
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) : Prop :=
  ∀ c c' :
    CoherentContinuationConfiguration
      containmentOrder orderOfHistory automatonOfHistory,
    StabilizedSaturationBasisPathEquivalent cert
      (pathOfHistory c.1.history)
      (pathOfHistory c'.1.history) ->
    c.1.receiptOne = c'.1.receiptOne ∧
      c.1.receiptTwo = c'.1.receiptTwo ∧
      containmentOrder c.1 = containmentOrder c'.1

/--
Receipt/order invariant from a concrete finite summary decoder.

This is the first nontrivial field of the stabilized Step 3 split: once the
chosen stabilized quotient is known to determine a concrete summary whose
decoder is `currentReceiptOrderDataForAppend`, the no-direct receipt/order
bridge supplies the two receipt-tag equalities and containment-order equality.
-/
theorem StabilizedSaturationBasisReceiptOrderInvariant_of_summaryOfHistory_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {Summary₁ : Type (max u v w a b)}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    {cert : StabilizedSaturationBasisCertificate sat n}
    {pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType}
    {sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop}
    {containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder}
    {orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder}
    {automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState}
    (summaryOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> Summary₁ × Summary₂)
    (decodeReceiptOrder : Summary₁ × Summary₂ -> ReceiptOrderData)
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrder (summaryOfHistory (History.append pref r)) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (historyAppend :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            c.1.history = History.append pref r)
    (summary_eq :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory c.1.history)
          (pathOfHistory c'.1.history) ->
        summaryOfHistory c.1.history = summaryOfHistory c'.1.history) :
    StabilizedSaturationBasisReceiptOrderInvariant
      cert pathOfHistory sameParityOutcomes containmentOrder
      orderOfHistory automatonOfHistory := by
  intro c c' heq
  rcases historyAppend c with ⟨pref, r, hc⟩
  rcases historyAppend c' with ⟨pref', r', hc'⟩
  exact
    noDirectSummaryState_determines_configReceiptOrder_of_decodesCurrent_coherent
      summaryOfHistory decodeReceiptOrder decodesCurrent
      containmentOrder orderOfHistory orderOfAppend
      hc hc' c.2.1 c'.2.1 (summary_eq c c' heq)

/--
The parity part of the remaining semantic Step 3 claim: the stabilized
saturation summary determines the chosen parity-progress observation.
-/
def StabilizedSaturationBasisParityInvariant
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) : Prop :=
  ∀ c c' :
    CoherentContinuationConfiguration
      containmentOrder orderOfHistory automatonOfHistory,
    StabilizedSaturationBasisPathEquivalent cert
      (pathOfHistory c.1.history)
      (pathOfHistory c'.1.history) ->
    sameParityOutcomes c.1 c'.1

/--
Parity invariant from a finite parity-progress observation.  This isolates the
last semantic Step 3 payload: stabilized same-tests only need to determine the
chosen `parityOfHistory` value, provided equality of that value has already
been shown to imply `sameParityOutcomes`.
-/
theorem StabilizedSaturationBasisParityInvariant_of_parityOfHistory_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    {cert : StabilizedSaturationBasisCertificate sat n}
    {pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType}
    {sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop}
    {containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder}
    {orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder}
    {automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState}
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (sameParityOfProgress :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        parityOfHistory c.1.history = parityOfHistory c'.1.history ->
          sameParityOutcomes c.1 c'.1)
    (parity_eq :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory c.1.history)
          (pathOfHistory c'.1.history) ->
        parityOfHistory c.1.history = parityOfHistory c'.1.history) :
    StabilizedSaturationBasisParityInvariant
      cert pathOfHistory sameParityOutcomes containmentOrder
      orderOfHistory automatonOfHistory := by
  intro c c' heq
  exact sameParityOfProgress c c' (parity_eq c c' heq)

/--
The three finite equalities that now constitute the concrete stabilized Step 3
target: stabilized same-tests determine the enriched no-direct state, the
concrete receipt/order summary, and the finite parity-progress value.
-/
def StabilizedSaturationBasisFiniteStateEqualities
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {Summary₁ : Type (max u v w a b)}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (summaryOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> Summary₁ × Summary₂) : Prop :=
  (∀ c c' :
    CoherentContinuationConfiguration
      containmentOrder orderOfHistory automatonOfHistory,
    StabilizedSaturationBasisPathEquivalent cert
      (pathOfHistory c.1.history)
      (pathOfHistory c'.1.history) ->
    uniform.noDirectEpochStateWithAContinuationData
        initialBoundary orderOfHistory automatonOfHistory parityOfHistory
        c.1.history =
      uniform.noDirectEpochStateWithAContinuationData
        initialBoundary orderOfHistory automatonOfHistory parityOfHistory
        c'.1.history) ∧
    (∀ c c' :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory c.1.history)
        (pathOfHistory c'.1.history) ->
      summaryOfHistory c.1.history = summaryOfHistory c'.1.history) ∧
    (∀ c c' :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory c.1.history)
        (pathOfHistory c'.1.history) ->
      parityOfHistory c.1.history = parityOfHistory c'.1.history)

/--
Truth-vector version of `StabilizedSaturationBasisFiniteStateEqualities`.
Use this when the remaining semantic proof works directly over stabilized
truth-vector atoms.
-/
def StabilizedSaturationBasisTruthVectorFiniteStateEqualities
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {Summary₁ : Type (max u v w a b)}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (summaryOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> Summary₁ × Summary₂) : Prop :=
  (∀ c c' :
    CoherentContinuationConfiguration
      containmentOrder orderOfHistory automatonOfHistory,
    regularTestTruthVector (stabilizedSaturationBasis cert)
      (pathOfHistory c.1.history) =
      regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistory c'.1.history) ->
    uniform.noDirectEpochStateWithAContinuationData
        initialBoundary orderOfHistory automatonOfHistory parityOfHistory
        c.1.history =
      uniform.noDirectEpochStateWithAContinuationData
        initialBoundary orderOfHistory automatonOfHistory parityOfHistory
        c'.1.history) ∧
    (∀ c c' :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistory c.1.history) =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory c'.1.history) ->
      summaryOfHistory c.1.history = summaryOfHistory c'.1.history) ∧
    (∀ c c' :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistory c.1.history) =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory c'.1.history) ->
      parityOfHistory c.1.history = parityOfHistory c'.1.history)

/--
Componentwise route to the truth-vector finite-state equality target.

This is the useful split for the current no-direct branch: the enriched
no-direct state is a tuple, so equality of the raw epoch/receipt-order state,
the history-derived automaton profile, the concrete summary, and the
parity-progress payload is enough to fill the whole finite-state package.
-/
theorem StabilizedSaturationBasisTruthVectorFiniteStateEqualities_of_components
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {Summary₁ : Type (max u v w a b)}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (summaryOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> Summary₁ × Summary₂)
    (epochReceiptState_eq :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory c.1.history) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory c'.1.history) ->
        uniform.noDirectEpochStateWithReceiptOrder
            initialBoundary orderOfHistory c.1.history =
          uniform.noDirectEpochStateWithReceiptOrder
            initialBoundary orderOfHistory c'.1.history)
    (automatonOfHistory_eq :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory c.1.history) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory c'.1.history) ->
        automatonOfHistory c.1.history = automatonOfHistory c'.1.history)
    (summaryOfHistory_eq :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory c.1.history) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory c'.1.history) ->
        summaryOfHistory c.1.history = summaryOfHistory c'.1.history)
    (parityOfHistory_eq :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory c.1.history) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory c'.1.history) ->
        parityOfHistory c.1.history = parityOfHistory c'.1.history) :
    StabilizedSaturationBasisTruthVectorFiniteStateEqualities
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory summaryOfHistory := by
  refine ⟨?_, ?_, ?_⟩
  · intro c c' htruth
    simp [UniformOneDirectionalFiniteIndexLemma.noDirectEpochStateWithAContinuationData,
      epochReceiptState_eq c c' htruth,
      automatonOfHistory_eq c c' htruth,
      parityOfHistory_eq c c' htruth]
  · exact summaryOfHistory_eq
  · exact parityOfHistory_eq

/--
In the truth-vector-payload branch, equality of the enriched epoch/receipt-order
state reduces to equality of the raw no-direct epoch state.

The receipt/order component is already forced by the chosen summary decoder:
both coherent histories are append histories, `decodesCurrent` reads the current
receipt/order data from the truth-vector payload, and the equal truth-vector
atom makes the two decoder calls equal.
-/
theorem StabilizedSaturationBasisTruthVectorEpochReceiptState_eq_of_rawEpochState_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (summaryUnit : Summary₂)
    (decodeReceiptOrder :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) × Summary₂ ->
        ReceiptOrderData)
    (rawEpochState_eq :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory c.1.history) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory c'.1.history) ->
        uniform.noDirectEpochStateAfterHistory initialBoundary c.1.history =
          uniform.noDirectEpochStateAfterHistory initialBoundary c'.1.history)
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrder
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory (History.append pref r)), summaryUnit) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (historyAppend :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            c.1.history = History.append pref r)
    {c c' :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory}
    (htruth :
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory c.1.history) =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory c'.1.history)) :
    uniform.noDirectEpochStateWithReceiptOrder
        initialBoundary orderOfHistory c.1.history =
      uniform.noDirectEpochStateWithReceiptOrder
        initialBoundary orderOfHistory c'.1.history := by
  rcases historyAppend c with ⟨pref, r, hc⟩
  rcases historyAppend c' with ⟨pref', r', hc'⟩
  have hraw :
      uniform.noDirectEpochStateAfterHistory initialBoundary c.1.history =
        uniform.noDirectEpochStateAfterHistory initialBoundary c'.1.history :=
    rawEpochState_eq c c' htruth
  have htruthAppend :
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory (History.append pref r)) =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory (History.append pref' r')) := by
    simpa [hc, hc'] using htruth
  have hreceipt :
      currentReceiptOrderData c.1.history (orderOfHistory c.1.history) =
        currentReceiptOrderData c'.1.history (orderOfHistory c'.1.history) := by
    calc
      currentReceiptOrderData c.1.history (orderOfHistory c.1.history)
          = currentReceiptOrderData (History.append pref r)
              (orderOfHistory (History.append pref r)) := by
            rw [hc]
      _ = currentReceiptOrderData (History.append pref r)
              (graphContainmentOrder r.graph) := by
            rw [orderOfAppend pref r]
      _ = currentReceiptOrderDataForAppend pref r := rfl
      _ = decodeReceiptOrder
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory (History.append pref r)), summaryUnit) :=
            (decodesCurrent pref r).symm
      _ = decodeReceiptOrder
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory (History.append pref' r')), summaryUnit) := by
            rw [htruthAppend]
      _ = currentReceiptOrderDataForAppend pref' r' :=
            decodesCurrent pref' r'
      _ = currentReceiptOrderData (History.append pref' r')
              (graphContainmentOrder r'.graph) := rfl
      _ = currentReceiptOrderData (History.append pref' r')
              (orderOfHistory (History.append pref' r')) := by
            rw [orderOfAppend pref' r']
      _ = currentReceiptOrderData c'.1.history (orderOfHistory c'.1.history) := by
            rw [hc']
  exact Prod.ext hraw hreceipt

/--
Truth-vector-payload finite-state equalities from the two remaining semantic
factorizations.

After the receipt/order reduction, it is enough to show that the raw no-direct
epoch state and the history-derived automaton profile are both functions of the
stabilized truth-vector atom.  The concrete summary and parity payload are the
truth-vector atom itself, so their equalities are immediate.
-/
theorem StabilizedSaturationBasisTruthVectorFiniteStateEqualities_of_rawEpochState_factorization
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (summaryUnit : Summary₂)
    (decodeReceiptOrder :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) × Summary₂ ->
        ReceiptOrderData)
    (rawEpochOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        EpochRotatingAccessState
          uniform.boundary
          (uniform.summary Proc.one)
          (uniform.summary Proc.two))
    (automatonOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> AState)
    (rawEpoch_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          rawEpochOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h)))
    (automaton_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        automatonOfHistory h =
          automatonOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h)))
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrder
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory (History.append pref r)), summaryUnit) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (historyAppend :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            c.1.history = History.append pref r) :
    StabilizedSaturationBasisTruthVectorFiniteStateEqualities
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory
      (fun h =>
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h))
      (fun h =>
        (regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h), summaryUnit)) := by
  refine
    StabilizedSaturationBasisTruthVectorFiniteStateEqualities_of_components
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory
      (fun h =>
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h))
      (fun h =>
        (regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h), summaryUnit))
      ?_ ?_ ?_ ?_
  · intro c c' htruth
    exact
      StabilizedSaturationBasisTruthVectorEpochReceiptState_eq_of_rawEpochState_eq
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory summaryUnit decodeReceiptOrder
        (by
          intro d d' hdtruth
          calc
            uniform.noDirectEpochStateAfterHistory initialBoundary d.1.history =
                rawEpochOfTruth
                  (regularTestTruthVector (stabilizedSaturationBasis cert)
                    (pathOfHistory d.1.history)) := rawEpoch_factor d.1.history
            _ = rawEpochOfTruth
                  (regularTestTruthVector (stabilizedSaturationBasis cert)
                    (pathOfHistory d'.1.history)) := by
                  rw [hdtruth]
            _ = uniform.noDirectEpochStateAfterHistory initialBoundary d'.1.history :=
                (rawEpoch_factor d'.1.history).symm)
        decodesCurrent orderOfAppend historyAppend htruth
  · intro c c' htruth
    calc
      automatonOfHistory c.1.history =
          automatonOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory c.1.history)) := automaton_factor c.1.history
      _ = automatonOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory c'.1.history)) := by
            rw [htruth]
      _ = automatonOfHistory c'.1.history :=
          (automaton_factor c'.1.history).symm
  · intro c c' htruth
    exact congrArg (fun truth => (truth, summaryUnit)) htruth
  · intro c c' htruth
    exact htruth

/--
Choose a concrete history representing a realized stabilized truth-vector atom.

For atoms that are not realized by any history, the representative is the empty
history.  The only theorem below uses this function at atoms of the form
`regularTestTruthVector ... (pathOfHistory h)`, where realization is immediate.
-/
noncomputable def stabilizedTruthVectorRepresentativeHistory
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (_containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (_orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (_automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (atom : RegularTestTruthAtom (stabilizedSaturationBasis cert)) :
    History In₁ In₂ Graph Out₁ Out₂ := by
  classical
  exact
    if h :
        ∃ hist : History In₁ In₂ Graph Out₁ Out₂,
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory hist) = atom then
      Classical.choose h
    else
      []

/--
The representative chosen above realizes every truth-vector atom that actually
comes from a history.
-/
theorem stabilizedTruthVectorRepresentativeHistory_realizes
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (h : History In₁ In₂ Graph Out₁ Out₂) :
    regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistory
          (stabilizedTruthVectorRepresentativeHistory
            cert pathOfHistory containmentOrder orderOfHistory automatonOfHistory
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h)))) =
      regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistory h) := by
  classical
  let atom :=
    regularTestTruthVector (stabilizedSaturationBasis cert) (pathOfHistory h)
  have hexists :
      ∃ hist : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory hist) = atom := ⟨h, rfl⟩
  change
    regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistory
          (stabilizedTruthVectorRepresentativeHistory
            cert pathOfHistory containmentOrder orderOfHistory automatonOfHistory
            atom)) =
      atom
  simp [stabilizedTruthVectorRepresentativeHistory, hexists,
    Classical.choose_spec hexists]

/--
Invariance form of the final truth-vector-payload target.

Instead of constructing decoder functions directly, it is enough to prove that
equal stabilized truth-vector atoms force equality of the raw no-direct epoch
state and of the history-derived automaton profile on arbitrary histories.
Representative histories then supply the decoder functions used by the
factorization theorem above.
-/
theorem StabilizedSaturationBasisTruthVectorFiniteStateEqualities_of_rawEpochState_invariance
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (summaryUnit : Summary₂)
    (decodeReceiptOrder :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) × Summary₂ ->
        ReceiptOrderData)
    (rawEpochState_invariant :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          uniform.noDirectEpochStateAfterHistory initialBoundary h')
    (automatonOfHistory_invariant :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        automatonOfHistory h = automatonOfHistory h')
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrder
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory (History.append pref r)), summaryUnit) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (historyAppend :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            c.1.history = History.append pref r) :
    StabilizedSaturationBasisTruthVectorFiniteStateEqualities
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory
      (fun h =>
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h))
      (fun h =>
        (regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h), summaryUnit)) := by
  let repr :=
    stabilizedTruthVectorRepresentativeHistory
      cert pathOfHistory containmentOrder orderOfHistory automatonOfHistory
  refine
    StabilizedSaturationBasisTruthVectorFiniteStateEqualities_of_rawEpochState_factorization
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory summaryUnit decodeReceiptOrder
      (fun atom => uniform.noDirectEpochStateAfterHistory initialBoundary (repr atom))
      (fun atom => automatonOfHistory (repr atom))
      ?_ ?_ decodesCurrent orderOfAppend historyAppend
  · intro h
    exact
      rawEpochState_invariant h (repr
        (regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h)))
        (stabilizedTruthVectorRepresentativeHistory_realizes
          cert pathOfHistory containmentOrder orderOfHistory automatonOfHistory h).symm
  · intro h
    exact
      automatonOfHistory_invariant h (repr
        (regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h)))
        (stabilizedTruthVectorRepresentativeHistory_realizes
          cert pathOfHistory containmentOrder orderOfHistory automatonOfHistory h).symm

/--
Path-equivalence form of the current invariance target.

This is the statement shape that should connect to stabilized saturation
closure: prove the raw no-direct epoch state and the automaton profile are
invariant under `StabilizedSaturationBasisPathEquivalent`, then the truth-vector
payload branch follows because truth-vector equality and stabilized
path-equivalence are equivalent.
-/
theorem StabilizedSaturationBasisTruthVectorFiniteStateEqualities_of_rawEpochState_pathInvariant
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (summaryUnit : Summary₂)
    (decodeReceiptOrder :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) × Summary₂ ->
        ReceiptOrderData)
    (rawEpochState_pathInvariant :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory h) (pathOfHistory h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          uniform.noDirectEpochStateAfterHistory initialBoundary h')
    (automatonOfHistory_pathInvariant :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory h) (pathOfHistory h') ->
        automatonOfHistory h = automatonOfHistory h')
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrder
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory (History.append pref r)), summaryUnit) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (historyAppend :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            c.1.history = History.append pref r) :
    StabilizedSaturationBasisTruthVectorFiniteStateEqualities
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory
      (fun h =>
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h))
      (fun h =>
        (regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h), summaryUnit)) :=
  StabilizedSaturationBasisTruthVectorFiniteStateEqualities_of_rawEpochState_invariance
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory summaryUnit decodeReceiptOrder
    (by
      intro h h' htruth
      exact rawEpochState_pathInvariant h h'
        (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth))
    (by
      intro h h' htruth
      exact automatonOfHistory_pathInvariant h h'
        (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth))
    decodesCurrent orderOfAppend historyAppend

/--
Case split for proving raw no-direct epoch-state invariance under stabilized
path-equivalence.

The raw state is `boundary ⊎ summary₁ ⊎ summary₂`; this package exposes exactly
the same cases.  The diagonal fields prove equality of the payloads in matching
constructors, while the off-diagonal fields rule out shape changes.
-/
structure StabilizedSaturationBasisRawEpochStateCaseInvariants
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (_containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (_orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (_automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) : Prop where
  boundary_boundary :
    ∀ h h' boundary boundary',
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory h) (pathOfHistory h') ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h =
        Sum.inl boundary ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h' =
        Sum.inl boundary' ->
      boundary = boundary'
  sideOne_sideOne :
    ∀ h h' summary summary',
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory h) (pathOfHistory h') ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h =
        Sum.inr (Sum.inl summary) ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h' =
        Sum.inr (Sum.inl summary') ->
      summary = summary'
  sideTwo_sideTwo :
    ∀ h h' summary summary',
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory h) (pathOfHistory h') ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h =
        Sum.inr (Sum.inr summary) ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h' =
        Sum.inr (Sum.inr summary') ->
      summary = summary'
  boundary_sideOne_absurd :
    ∀ h h' boundary summary',
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory h) (pathOfHistory h') ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h =
        Sum.inl boundary ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h' =
        Sum.inr (Sum.inl summary') ->
      False
  boundary_sideTwo_absurd :
    ∀ h h' boundary summary',
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory h) (pathOfHistory h') ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h =
        Sum.inl boundary ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h' =
        Sum.inr (Sum.inr summary') ->
      False
  sideOne_boundary_absurd :
    ∀ h h' summary boundary',
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory h) (pathOfHistory h') ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h =
        Sum.inr (Sum.inl summary) ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h' =
        Sum.inl boundary' ->
      False
  sideOne_sideTwo_absurd :
    ∀ h h' summary summary',
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory h) (pathOfHistory h') ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h =
        Sum.inr (Sum.inl summary) ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h' =
        Sum.inr (Sum.inr summary') ->
      False
  sideTwo_boundary_absurd :
    ∀ h h' summary boundary',
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory h) (pathOfHistory h') ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h =
        Sum.inr (Sum.inr summary) ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h' =
        Sum.inl boundary' ->
      False
  sideTwo_sideOne_absurd :
    ∀ h h' summary summary',
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory h) (pathOfHistory h') ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h =
        Sum.inr (Sum.inr summary) ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h' =
        Sum.inr (Sum.inl summary') ->
      False

/-- Assemble raw no-direct epoch-state path-invariance from the case package. -/
theorem StabilizedSaturationBasisRawEpochState_pathInvariant_of_cases
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (caseInvariants :
      StabilizedSaturationBasisRawEpochStateCaseInvariants
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory h) (pathOfHistory h') ->
      uniform.noDirectEpochStateAfterHistory initialBoundary h =
        uniform.noDirectEpochStateAfterHistory initialBoundary h' := by
  intro h h' heq
  cases hstate :
      uniform.noDirectEpochStateAfterHistory initialBoundary h with
  | inl boundary =>
      cases hstate' :
          uniform.noDirectEpochStateAfterHistory initialBoundary h' with
      | inl boundary' =>
          exact
            congrArg Sum.inl
              (caseInvariants.boundary_boundary
                h h' boundary boundary' heq hstate hstate')
      | inr side' =>
          cases hside' : side' with
          | inl summary' =>
              exact False.elim
                (caseInvariants.boundary_sideOne_absurd
                  h h' boundary summary' heq hstate (by simpa [hside'] using hstate'))
          | inr summary' =>
              exact False.elim
                (caseInvariants.boundary_sideTwo_absurd
                  h h' boundary summary' heq hstate (by simpa [hside'] using hstate'))
  | inr side =>
      cases hside : side with
      | inl summary =>
          cases hstate' :
              uniform.noDirectEpochStateAfterHistory initialBoundary h' with
          | inl boundary' =>
              exact False.elim
                (caseInvariants.sideOne_boundary_absurd
                  h h' summary boundary' heq (by simpa [hside] using hstate) hstate')
          | inr side' =>
              cases hside' : side' with
              | inl summary' =>
                  exact
                    congrArg (fun summary => Sum.inr (Sum.inl summary))
                      (caseInvariants.sideOne_sideOne
                        h h' summary summary' heq
                        (by simpa [hside] using hstate)
                        (by simpa [hside'] using hstate'))
              | inr summary' =>
                  exact False.elim
                    (caseInvariants.sideOne_sideTwo_absurd
                      h h' summary summary' heq
                      (by simpa [hside] using hstate)
                      (by simpa [hside'] using hstate'))
      | inr summary =>
          cases hstate' :
              uniform.noDirectEpochStateAfterHistory initialBoundary h' with
          | inl boundary' =>
              exact False.elim
                (caseInvariants.sideTwo_boundary_absurd
                  h h' summary boundary' heq (by simpa [hside] using hstate) hstate')
          | inr side' =>
              cases hside' : side' with
              | inl summary' =>
                  exact False.elim
                    (caseInvariants.sideTwo_sideOne_absurd
                      h h' summary summary' heq
                      (by simpa [hside] using hstate)
                      (by simpa [hside'] using hstate'))
              | inr summary' =>
                  exact
                    congrArg (fun summary => Sum.inr (Sum.inr summary))
                      (caseInvariants.sideTwo_sideTwo
                        h h' summary summary' heq
                        (by simpa [hside] using hstate)
                        (by simpa [hside'] using hstate'))

