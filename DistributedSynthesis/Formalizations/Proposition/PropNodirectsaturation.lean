      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (truthVectorDeterminesRelevantHistory :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        List.Forall₂ NoDirectEpochRelevantRoundEq h h') :
    StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory := by
  intro _ _ _ _ h h' htruth
  exact
    uniform.noDirectEpochStateAfterHistory_eq_of_relevantHistoryEq
      initialBoundary
      (truthVectorDeterminesRelevantHistory h h' htruth)

/--
Same-tests form of the concrete raw epoch-state route.

If stabilized path-equivalence determines the transition-relevant round trace,
then equality of stabilized truth-vector atoms determines the raw no-direct
epoch state.
-/
theorem StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant_of_pathRelevantHistoryEq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
