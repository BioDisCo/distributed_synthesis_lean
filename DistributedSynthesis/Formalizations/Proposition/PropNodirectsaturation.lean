theorem StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_pathInvariantsSoundness
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
