/--
Coherent-history version of the current-order receipt/order field invariant.

Unlike the truth-factor-data constructor, this theorem is scoped exactly to the
Step 3 separation target: the mixed empty-prefix compatibility premise is only
needed for coherent configurations, because the invariant itself only compares
coherent continuation configurations.
-/
theorem StabilizedSaturationBasisReceiptOrderInvariant_of_currentOrderAppendDeterminesReceiptOrderAndCoherentEmptyCompatibility
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    {sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop}
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (appendTruthDeterminesReceiptOrder :
      ∀ (pref pref' : History In₁ In₂ Graph Out₁ Out₂)
        (r r' : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound (History.append pref r)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound (History.append pref' r')) ->
        currentReceiptOrderDataForAppend pref r =
          currentReceiptOrderDataForAppend pref' r')
    (emptyCompatibility :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder historyCurrentContainmentOrder automatonOfHistory,
        c.1.history ≠ [] ->
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              ([] : History In₁ In₂ Graph Out₁ Out₂)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound c.1.history) ->
        currentReceiptOrderData c.1.history
            (historyCurrentContainmentOrder c.1.history) =
          defaultReceiptOrderData) :
    StabilizedSaturationBasisReceiptOrderInvariant
      cert (pathOfHistoryByRound edgeOfRound) sameParityOutcomes
      containmentOrder historyCurrentContainmentOrder automatonOfHistory := by
  intro c c' heq
  have htruth :
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history) =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c'.1.history) :=
    stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent heq
  have hdata :
      currentReceiptOrderData c.1.history
          (historyCurrentContainmentOrder c.1.history) =
        currentReceiptOrderData c'.1.history
          (historyCurrentContainmentOrder c'.1.history) := by
    by_cases hne : c.1.history ≠ []
    · by_cases hne' : c'.1.history ≠ []
      · rcases history_eq_append_of_ne_nil hne with ⟨pref, r, hc⟩
        rcases history_eq_append_of_ne_nil hne' with ⟨pref', r', hc'⟩
        have htruthAppend :
            regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound (History.append pref r)) =
              regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound (History.append pref' r')) := by
          simpa [hc, hc'] using htruth
        have happend :
            currentReceiptOrderDataForAppend pref r =
              currentReceiptOrderDataForAppend pref' r' :=
          appendTruthDeterminesReceiptOrder pref pref' r r' htruthAppend
        calc
          currentReceiptOrderData c.1.history
              (historyCurrentContainmentOrder c.1.history) =
              currentReceiptOrderData (History.append pref r)
                (historyCurrentContainmentOrder (History.append pref r)) := by
                rw [hc]
          _ =
              currentReceiptOrderData (History.append pref r)
                (graphContainmentOrder r.graph) := by
                rw [historyCurrentContainmentOrder_append pref r]
          _ = currentReceiptOrderDataForAppend pref r := rfl
          _ = currentReceiptOrderDataForAppend pref' r' := happend
          _ =
              currentReceiptOrderData (History.append pref' r')
                (graphContainmentOrder r'.graph) := rfl
          _ =
              currentReceiptOrderData (History.append pref' r')
                (historyCurrentContainmentOrder (History.append pref' r')) := by
                rw [historyCurrentContainmentOrder_append pref' r']
