        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat) where
  stateOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ ->
      { truth : RegularTestTruthAtom (stabilizedSaturationBasis cert) //
        ∃ envs : List (EnvironmentRound In₁ In₂),
          envs.length ≤ generationBound ∧
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              (executionPrefixFromList σ envs)) = truth }
  state_truth_eq :
    ∀ c :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
    (stateOfHistory c.1.history).1 =
      regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistoryByRound edgeOfRound c.1.history)

