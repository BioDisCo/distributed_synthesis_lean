    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory where
  rawEpochState_invariant := by
    intro hdet hpred hboundary hcont h h' htruth
    let pathInvariants := closureSoundness hdet hpred hboundary hcont
    exact
      StabilizedSaturationBasisRawEpochState_pathInvariant_of_cases
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory
        pathInvariants.rawEpochCases h h'
        (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
  automatonOfHistory_invariant := by
    intro hcont h h' htruth
    let pathInvariants :=
      closureSoundness
        cert.determinesPathData_proof
        cert.predecessorClosed_proof
        cert.boundaryClosed_proof
        hcont
    exact
      pathInvariants.automatonOfHistory_pathInvariant h h'
        (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)

