/--
The harmless fallback receipt/order value used by choice-based decoders on
unrealized truth atoms.
-/
def defaultReceiptOrderData : ReceiptOrderData where
  receiptOne := .noRecv
  receiptTwo := .noRecv
  containmentOrder := .equivalent

/--
Truth-atom factorization data for the current receipt/order payload.

This is the non-append analogue of the receipt/order decoder package: it states
