/--
Same-tests route for histories known to be generated prefixes of a fixed
strategy.  The remaining concrete obligations are that stabilized same-tests
determine the generated prefix length and the two current local views at every
positive prefix length.  The no-direct relevant traces, including outputs, then
follow from the generated-prefix induction lemma.
-/
theorem StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_pathGeneratedCurrentViews
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generatedHistory :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        ∃ env : EnvironmentSequence In₁ In₂,
          ∃ generationLength : Nat,
            h = executionPrefix σ env generationLength)
    (pathEquivalentDeterminesGeneratedLength :
      ∀ (env env' : EnvironmentSequence In₁ In₂)
        (generationLength generationLength' : Nat),
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory (executionPrefix σ env generationLength))
          (pathOfHistory (executionPrefix σ env' generationLength')) ->
        generationLength = generationLength')
    (pathEquivalentDeterminesGeneratedCurrentViews :
      ∀ (env env' : EnvironmentSequence In₁ In₂)
        (generationLength : Nat),
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory (executionPrefix σ env generationLength))
          (pathOfHistory (executionPrefix σ env' generationLength)) ->
        ∀ k : Nat, k < generationLength ->
          currentView Proc.one (executionPrefix σ env (k + 1)) =
            currentView Proc.one (executionPrefix σ env' (k + 1)) ∧
          currentView Proc.two (executionPrefix σ env (k + 1)) =
            currentView Proc.two (executionPrefix σ env' (k + 1)))
    (automatonOfHistory_respectsRelevantHistory :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        List.Forall₂ NoDirectEpochRelevantRoundEq h h' ->
        automatonOfHistory h = automatonOfHistory h') :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory :=
  StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_pathRelevantNamedTracesEq
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory
    (by
      intro h h' hpath
      rcases generatedHistory h with ⟨env, generationLength, rfl⟩
      rcases generatedHistory h' with ⟨env', generationLength', rfl⟩
      have hlength :
          generationLength = generationLength' :=
        pathEquivalentDeterminesGeneratedLength env env'
          generationLength generationLength' hpath
      subst generationLength'
      exact
        noDirectEpochRelevantHistoryNamedTracesEq_executionPrefix_of_currentView_succ_eq
          σ env env' generationLength
          (pathEquivalentDeterminesGeneratedCurrentViews env env'
            generationLength hpath))
    automatonOfHistory_respectsRelevantHistory

/--
Finite-list generated-prefix route.  This is the finite analogue of
`StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_pathGeneratedCurrentViews`:
it avoids choosing arbitrary infinite environment tails and states the remaining
current-view obligation directly on finite prefixes of the two generated
environment lists.
-/
theorem StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_pathGeneratedCurrentViewsFromList
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generatedHistory :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        ∃ envs : List (EnvironmentRound In₁ In₂),
          h = executionPrefixFromList σ envs)
    (pathEquivalentDeterminesGeneratedLength :
      ∀ envs envs' : List (EnvironmentRound In₁ In₂),
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory (executionPrefixFromList σ envs))
          (pathOfHistory (executionPrefixFromList σ envs')) ->
        envs.length = envs'.length)
    (pathEquivalentDeterminesGeneratedCurrentViews :
      ∀ envs envs' : List (EnvironmentRound In₁ In₂),
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistory (executionPrefixFromList σ envs))
          (pathOfHistory (executionPrefixFromList σ envs')) ->
        ∀ pref pref' : List (EnvironmentRound In₁ In₂),
          pref.length = pref'.length ->
          pref.length ≤ envs.length ->
          (∃ suff, envs = pref ++ suff) ->
          (∃ suff', envs' = pref' ++ suff') ->
          currentView Proc.one (executionPrefixFromList σ pref) =
            currentView Proc.one (executionPrefixFromList σ pref') ∧
          currentView Proc.two (executionPrefixFromList σ pref) =
            currentView Proc.two (executionPrefixFromList σ pref'))
    (automatonOfHistory_respectsRelevantHistory :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        List.Forall₂ NoDirectEpochRelevantRoundEq h h' ->
        automatonOfHistory h = automatonOfHistory h') :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory :=
  StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_pathRelevantNamedTracesEq
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory
    (by
      intro h h' hpath
      rcases generatedHistory h with ⟨envs, rfl⟩
      rcases generatedHistory h' with ⟨envs', rfl⟩
      exact
        noDirectEpochRelevantHistoryNamedTracesEq_executionPrefixFromList_of_currentView_snoc_eq
          σ envs envs'
          (pathEquivalentDeterminesGeneratedLength envs envs' hpath)
          (pathEquivalentDeterminesGeneratedCurrentViews envs envs' hpath))
    automatonOfHistory_respectsRelevantHistory

/--
The canonical one-edge-per-round path abstraction obtained by mapping each
history round to an edge label.
-/
def pathOfHistoryByRound
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {EdgeType : Type b}
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (h : History In₁ In₂ Graph Out₁ Out₂) :
    TypedPath EdgeType :=
  h.map edgeOfRound

/--
The canonical current containment order of a history: empty histories use the
neutral equivalent order, and nonempty histories use the graph of their last
round.
-/
def historyCurrentContainmentOrder
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (h : History In₁ In₂ Graph Out₁ Out₂) :
    NonFringeContainmentOrder :=
  match h.reverse with
  | [] => .equivalent
  | r :: _ => graphContainmentOrder r.graph

@[simp]
theorem historyCurrentContainmentOrder_append
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (h : History In₁ In₂ Graph Out₁ Out₂)
    (r : RoundRecord In₁ In₂ Graph Out₁ Out₂) :
    historyCurrentContainmentOrder (History.append h r) =
      graphContainmentOrder r.graph := by
  simp [historyCurrentContainmentOrder, History.append]

/--
Every nonempty history has a last round, hence is an appended prefix.
-/
theorem history_eq_append_of_ne_nil
    {In₁ : Type u}
    {In₂ : Type v}
    {G : Type w}
    {Out₁ : Type a}
    {Out₂ : Type b}
    {h : History In₁ In₂ G Out₁ Out₂}
    (hnonempty : h ≠ []) :
    ∃ (pref : History In₁ In₂ G Out₁ Out₂),
      ∃ (r : RoundRecord In₁ In₂ G Out₁ Out₂),
        h = History.append pref r := by
  induction h using List.reverseRecOn with
  | nil =>
      exact False.elim (hnonempty rfl)
  | append_singleton pref r =>
      exact ⟨pref, r, rfl⟩

@[simp]
theorem pathOfHistoryByRound_length
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {EdgeType : Type b}
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (h : History In₁ In₂ Graph Out₁ Out₂) :
    (pathOfHistoryByRound edgeOfRound h).length = History.length h := by
  simp [pathOfHistoryByRound, History.length]

@[simp]
theorem pathOfHistoryByRound_executionPrefixFromList_length
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {EdgeType : Type b}
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (envs : List (EnvironmentRound In₁ In₂)) :
    (pathOfHistoryByRound edgeOfRound
        (executionPrefixFromList σ envs)).length = envs.length := by
  simpa [pathOfHistoryByRound, History.length] using
    executionPrefixFromList_length σ envs

/--
For the concrete one-edge-per-round path abstraction, equality of typed paths
implies no-direct transition-relevant history equality whenever the edge label
records enough information to recover the graph/input/output fields used by the
raw epoch transition.
-/
theorem pathOfHistoryByRound_eq_imp_relevantHistoryEq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {EdgeType : Type b}
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (edgeReflectsRelevantRound :
      ∀ round round' : RoundRecord In₁ In₂ Graph Out₁ Out₂,
        edgeOfRound round = edgeOfRound round' ->
          NoDirectEpochRelevantRoundEq round round')
    {h h' : History In₁ In₂ Graph Out₁ Out₂}
    (hpath : pathOfHistoryByRound edgeOfRound h =
      pathOfHistoryByRound edgeOfRound h') :
    List.Forall₂ NoDirectEpochRelevantRoundEq h h' := by
  induction h generalizing h' with
  | nil =>
      cases h' with
      | nil => exact List.Forall₂.nil
      | cons round rest =>
          simp [pathOfHistoryByRound] at hpath
  | cons round rest ih =>
      cases h' with
      | nil =>
          simp [pathOfHistoryByRound] at hpath
      | cons round' rest' =>
          simp [pathOfHistoryByRound] at hpath
          exact
            List.Forall₂.cons
              (edgeReflectsRelevantRound round round' hpath.1)
              (ih hpath.2)

/--
Even the generated-path-local length preservation obligation is impossible over
all finite generated prefixes when the private input types are inhabited.  The
finite stabilized truth atom cannot distinguish the lengths of the infinitely
many prefixes obtained by repeating one environment round.
-/
theorem stabilizedSaturationBasis_no_global_generatedLength_preservation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁] [Inhabited In₂]
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (pathEquivalentDeterminesGeneratedLength :
      ∀ envs envs' : List (EnvironmentRound In₁ In₂),
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs))
          (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs')) ->
        envs.length = envs'.length) :
    False := by
  classical
  letI := regularTestTruthAtomFintype (stabilizedSaturationBasis cert)
  let envRound : EnvironmentRound In₁ In₂ :=
    { inputOne := default, inputTwo := default, graph := dominantGraph Proc.one }
  let encode :
      Fin (Fintype.card (RegularTestTruthAtom (stabilizedSaturationBasis cert)) + 1) ->
        RegularTestTruthAtom (stabilizedSaturationBasis cert) :=
    fun i =>
      regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistoryByRound edgeOfRound
          (executionPrefixFromList σ (List.replicate i.val envRound)))
  have hInjective : Function.Injective encode := by
    intro i j hij
    have hpath :
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (List.replicate i.val envRound)))
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (List.replicate j.val envRound))) := by
      apply stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq
      simpa [encode] using hij
    have hlen :=
      pathEquivalentDeterminesGeneratedLength
        (List.replicate i.val envRound)
        (List.replicate j.val envRound)
        hpath
    exact Fin.ext (by simpa using hlen)
  have hcard :
      Fintype.card
          (Fin (Fintype.card
            (RegularTestTruthAtom (stabilizedSaturationBasis cert)) + 1)) ≤
        Fintype.card (RegularTestTruthAtom (stabilizedSaturationBasis cert)) :=
    Fintype.card_le_of_injective encode hInjective
  have hbad :
      Fintype.card (RegularTestTruthAtom (stabilizedSaturationBasis cert)) + 1 ≤
        Fintype.card (RegularTestTruthAtom (stabilizedSaturationBasis cert)) := by
    simpa using hcard
  exact Nat.not_succ_le_self _ hbad

/--
If the pair of current local views factors through stabilized truth-vector
atoms, then stabilized path equivalence determines both current views.
-/
theorem stabilizedSaturationBasis_currentViews_eq_of_truthVector_factor
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    {cert : StabilizedSaturationBasisCertificate sat n}
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (currentViewsOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        View In₁ In₂ Proc.one × View In₁ In₂ Proc.two)
    (currentViews_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        (currentView Proc.one h, currentView Proc.two h) =
          currentViewsOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h)))
    {h h' : History In₁ In₂ Graph Out₁ Out₂}
    (heq :
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory h) (pathOfHistory h')) :
    currentView Proc.one h = currentView Proc.one h' ∧
      currentView Proc.two h = currentView Proc.two h' := by
  have htruth :=
    stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent heq
  have hpairs :
      (currentView Proc.one h, currentView Proc.two h) =
        (currentView Proc.one h', currentView Proc.two h') := by
    calc
      (currentView Proc.one h, currentView Proc.two h) =
          currentViewsOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h)) := by
            exact currentViews_factor h
      _ =
          currentViewsOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h')) := by
            exact congrArg currentViewsOfTruth htruth
      _ = (currentView Proc.one h', currentView Proc.two h') := by
            exact (currentViews_factor h').symm
  exact ⟨congrArg Prod.fst hpairs, congrArg Prod.snd hpairs⟩

/--
If the typed path assigned to each history factors through the stabilized
truth-vector atom, then stabilized path-equivalence forces literal equality of
those history paths.

This is stronger than the usual same-tests equivalence, and is exactly the
extra separation needed by the by-round raw-state route.
-/
theorem stabilizedSaturationBasis_pathOfHistory_eq_of_truthVector_factor
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    {cert : StabilizedSaturationBasisCertificate sat n}
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (pathOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> TypedPath EdgeType)
    (path_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        pathOfHistory h =
          pathOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h)))
    {h h' : History In₁ In₂ Graph Out₁ Out₂}
    (heq :
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory h) (pathOfHistory h')) :
    pathOfHistory h = pathOfHistory h' := by
  have htruth :=
    stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent heq
  calc
    pathOfHistory h =
        pathOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h)) := by
        exact path_factor h
    _ =
        pathOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h')) := by
        exact congrArg pathOfTruth htruth
    _ = pathOfHistory h' := by
        exact (path_factor h').symm

/--
No-go for the global exact by-round path decoder.

If a single stabilized finite truth-vector atom decoded the whole by-round path
for every history, then it would in particular decode the lengths of arbitrarily
long repetitions of one round, contradicting finiteness of the truth-atom type.
Use generated/bounded or more semantic trace factors instead of this as a
global target.
-/
theorem stabilizedSaturationBasis_no_global_byRoundPathTruthVector_factor
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (round : RoundRecord In₁ In₂ Graph Out₁ Out₂)
    (pathOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> TypedPath EdgeType)
    (path_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        pathOfHistoryByRound edgeOfRound h =
          pathOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound h))) :
    False := by
  classical
  letI := regularTestTruthAtomFintype (stabilizedSaturationBasis cert)
  let encode :
      Fin (Fintype.card
          (RegularTestTruthAtom (stabilizedSaturationBasis cert)) + 1) ->
        RegularTestTruthAtom (stabilizedSaturationBasis cert) :=
    fun i =>
      regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistoryByRound edgeOfRound (List.replicate i.val round))
  have hInjective : Function.Injective encode := by
    intro i j hij
    have hi := congrArg List.length (path_factor (List.replicate i.val round))
    have hj := congrArg List.length (path_factor (List.replicate j.val round))
    have hlen :
        (pathOfHistoryByRound edgeOfRound (List.replicate i.val round)).length =
          (pathOfHistoryByRound edgeOfRound (List.replicate j.val round)).length := by
      calc
        (pathOfHistoryByRound edgeOfRound (List.replicate i.val round)).length =
            (pathOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound
                  (List.replicate i.val round)))).length := by
            exact hi
        _ =
            (pathOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound
                  (List.replicate j.val round)))).length := by
            simpa [encode] using congrArg (fun atom => (pathOfTruth atom).length) hij
        _ =
            (pathOfHistoryByRound edgeOfRound (List.replicate j.val round)).length := by
            exact hj.symm
    have hval : i.val = j.val := by
      simpa [pathOfHistoryByRound] using hlen
    exact Fin.ext hval
  have hcard :
      Fintype.card
          (Fin (Fintype.card
              (RegularTestTruthAtom (stabilizedSaturationBasis cert)) + 1)) ≤
        Fintype.card (RegularTestTruthAtom (stabilizedSaturationBasis cert)) :=
    Fintype.card_le_of_injective encode hInjective
  have hbad :
      Fintype.card (RegularTestTruthAtom (stabilizedSaturationBasis cert)) + 1 ≤
        Fintype.card (RegularTestTruthAtom (stabilizedSaturationBasis cert)) := by
    simpa using hcard
  exact Nat.not_succ_le_self _ hbad

/--
If generated-list length is decoded by stabilized truth-vector atoms on a
bounded generated family, then stabilized path-equivalence preserves generated
length inside that bound.
-/
theorem stabilizedSaturationBasis_boundedGeneratedLength_eq_of_truthVector_option_factor
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    {cert : StabilizedSaturationBasisCertificate sat n}
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (generatedLengthOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> Option Nat)
    (generatedLength_factor :
      ∀ envs : List (EnvironmentRound In₁ In₂),
        envs.length ≤ generationBound ->
        generatedLengthOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory (executionPrefixFromList σ envs))) =
          some envs.length)
    {envs envs' : List (EnvironmentRound In₁ In₂)}
    (hlen : envs.length ≤ generationBound)
    (hlen' : envs'.length ≤ generationBound)
    (heq :
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory (executionPrefixFromList σ envs))
        (pathOfHistory (executionPrefixFromList σ envs'))) :
    envs.length = envs'.length := by
  have htruth :=
    stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent heq
  have hsome : some envs.length = some envs'.length := by
    calc
      some envs.length =
          generatedLengthOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory (executionPrefixFromList σ envs))) := by
          exact (generatedLength_factor envs hlen).symm
      _ =
          generatedLengthOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory (executionPrefixFromList σ envs'))) := by
          exact congrArg generatedLengthOfTruth htruth
      _ = some envs'.length := by
          exact generatedLength_factor envs' hlen'
  exact Option.some.inj hsome

/--
If prefix truth-vector atoms are decoded from full generated truth-vector atoms
on a bounded generated family, then full generated path-equivalence induces
path-equivalence of corresponding finite generated prefixes.
-/
theorem stabilizedSaturationBasis_boundedGeneratedPrefixPathEquivalent_of_truthVector_factor
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    {cert : StabilizedSaturationBasisCertificate sat n}
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (generatedPrefixTruthOf :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        Nat -> RegularTestTruthAtom (stabilizedSaturationBasis cert))
    (generatedPrefixTruth_factor :
      ∀ envs pref : List (EnvironmentRound In₁ In₂),
        envs.length ≤ generationBound ->
        pref.length ≤ envs.length ->
        (∃ suff, envs = pref ++ suff) ->
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory (executionPrefixFromList σ pref)) =
          generatedPrefixTruthOf
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory (executionPrefixFromList σ envs)))
            pref.length)
    {envs envs' pref pref' : List (EnvironmentRound In₁ In₂)}
    (hlen : envs.length ≤ generationBound)
    (hlen' : envs'.length ≤ generationBound)
    (heq :
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory (executionPrefixFromList σ envs))
        (pathOfHistory (executionPrefixFromList σ envs')))
    (hprefLength : pref.length = pref'.length)
    (hprefLe : pref.length ≤ envs.length)
    (hprefSub : ∃ suff, envs = pref ++ suff)
    (hprefSub' : ∃ suff', envs' = pref' ++ suff') :
    StabilizedSaturationBasisPathEquivalent cert
      (pathOfHistory (executionPrefixFromList σ pref))
      (pathOfHistory (executionPrefixFromList σ pref')) := by
  have htruth :=
    stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent heq
  have hprefLe' : pref'.length ≤ envs'.length := by
    rcases hprefSub' with ⟨suff', hsuff'⟩
    subst envs'
    simp
  apply stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq
  calc
    regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistory (executionPrefixFromList σ pref)) =
      generatedPrefixTruthOf
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory (executionPrefixFromList σ envs)))
          pref.length := by
        exact generatedPrefixTruth_factor envs pref hlen hprefLe hprefSub
    _ =
      generatedPrefixTruthOf
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory (executionPrefixFromList σ envs')))
          pref'.length := by
        rw [htruth, hprefLength]
    _ =
      regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistory (executionPrefixFromList σ pref')) := by
        exact (generatedPrefixTruth_factor envs' pref' hlen' hprefLe'
          hprefSub').symm

/--
If the automaton state factors through stabilized truth-vector atoms, and
no-direct relevant-history equality preserves those atoms, then the automaton
respects no-direct relevant histories.
-/
theorem automatonOfHistory_respectsRelevantHistory_of_truthVector_factor
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    {cert : StabilizedSaturationBasisCertificate sat n}
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (automatonOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> AState)
    (automaton_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        automatonOfHistory h =
          automatonOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h)))
    (relevantHistoryDeterminesTruthVector :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        List.Forall₂ NoDirectEpochRelevantRoundEq h h' ->
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h')) :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      List.Forall₂ NoDirectEpochRelevantRoundEq h h' ->
      automatonOfHistory h = automatonOfHistory h' := by
  intro h h' hrel
  calc
    automatonOfHistory h =
        automatonOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h)) := by
          exact automaton_factor h
    _ =
        automatonOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h')) := by
          exact congrArg automatonOfTruth
            (relevantHistoryDeterminesTruthVector h h' hrel)
    _ = automatonOfHistory h' := by
          exact (automaton_factor h').symm

