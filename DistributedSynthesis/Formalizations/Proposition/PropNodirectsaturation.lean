    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (stateData :
      StabilizedSaturationBasisBoundedGeneratedRepresentedTruthStateData
        uniform initialBoundary cert edgeOfRound containmentOrder
        orderOfHistory automatonOfHistory σ generationBound) :
    StabilizedSaturationBasisBoundedGeneratedRepresentedTruthStateTruthData
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory σ generationBound :=
  { stateOfHistory := fun h =>
      ⟨(stateData.stateOfHistory h).1,
        let witness := (stateData.stateOfHistory h).2
        ⟨Classical.choose witness,
          (Classical.choose_spec witness).1,
          (Classical.choose_spec witness).2.1⟩⟩
    state_truth_eq := stateData.state_truth_eq }

