  StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_split
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory
    (StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant_of_quotientFactor
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory rawFactor)
    (StabilizedSaturationBasisNoDirectAutomatonTruthVectorInvariant_of_quotientFactor
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory automatonFactor)

/--
The two-field truth-vector invariant package is exactly the well-definedness of
quotient factors through the stabilized truth-vector atom.

The forward direction constructs canonical representatives; the reverse
direction says any such quotient-factor data rewrites equal truth-vector atoms
to equal raw epoch/automaton states.
-/
theorem stabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_iff_nonempty_quotientFactors
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory ↔
      Nonempty
        (StabilizedSaturationBasisNoDirectClosureSoundnessQuotientFactors
          uniform initialBoundary cert pathOfHistory containmentOrder
          orderOfHistory automatonOfHistory) := by
  constructor
  · intro invariants
    exact
      ⟨StabilizedSaturationBasisNoDirectClosureSoundnessQuotientFactors_of_truthVectorInvariantPackage
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory invariants⟩
  · intro hfactors
    rcases hfactors with ⟨factors⟩
    exact
      StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_quotientFactors
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory factors

/--
The two-field truth-vector invariant package is equivalently a pair of split
quotient factors through the stabilized truth-vector atom.
-/
theorem stabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_iff_splitQuotientFactors
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory ↔
      Nonempty
        (StabilizedSaturationBasisNoDirectRawEpochQuotientFactor
          uniform initialBoundary cert pathOfHistory containmentOrder
          orderOfHistory automatonOfHistory) ∧
        Nonempty
          (StabilizedSaturationBasisNoDirectAutomatonQuotientFactor
            uniform initialBoundary cert pathOfHistory containmentOrder
            orderOfHistory automatonOfHistory) := by
  constructor
  · intro invariants
    have hfactors :
        Nonempty
          (StabilizedSaturationBasisNoDirectClosureSoundnessQuotientFactors
            uniform initialBoundary cert pathOfHistory containmentOrder
            orderOfHistory automatonOfHistory) :=
      (stabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_iff_nonempty_quotientFactors
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory).mp invariants
    exact
      (stabilizedSaturationBasisNoDirectClosureSoundnessQuotientFactors_iff_split
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory).mp hfactors
  · intro hsplit
    rcases hsplit with ⟨⟨rawFactor⟩, ⟨automatonFactor⟩⟩
    exact
      StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_splitQuotientFactors
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory rawFactor automatonFactor

/--
Assemble closure soundness from the compact raw-state/automaton-state core.

This is the top-down route to use when the mathematical proof first establishes
raw no-direct epoch-state invariance as a single theorem, rather than proving
the nine constructor cases directly.
-/
theorem StabilizedSaturationBasisNoDirectPathInvariantsSoundness_of_core
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (core :
      StabilizedSaturationBasisNoDirectClosureSoundnessCore
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisNoDirectPathInvariantsSoundness
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory := by
  intro hdet hpred hboundary hcont
  let rawInvariant :=
    core.rawEpochState_of_closureFields hdet hpred hboundary hcont
  exact {
    rawEpochCases := {
      boundary_boundary := by
        intro h h' boundary boundary' heq hstate hstate'
        have hraw := rawInvariant h h' heq
        rw [hstate, hstate'] at hraw
        simpa using hraw
      sideOne_sideOne := by
        intro h h' summary summary' heq hstate hstate'
        have hraw := rawInvariant h h' heq
        rw [hstate, hstate'] at hraw
        simpa using hraw
      sideTwo_sideTwo := by
        intro h h' summary summary' heq hstate hstate'
        have hraw := rawInvariant h h' heq
        rw [hstate, hstate'] at hraw
        simpa using hraw
      boundary_sideOne_absurd := by
        intro h h' boundary summary' heq hstate hstate'
        have hraw := rawInvariant h h' heq
        rw [hstate, hstate'] at hraw
        cases hraw
      boundary_sideTwo_absurd := by
        intro h h' boundary summary' heq hstate hstate'
        have hraw := rawInvariant h h' heq
        rw [hstate, hstate'] at hraw
        cases hraw
      sideOne_boundary_absurd := by
        intro h h' summary boundary' heq hstate hstate'
        have hraw := rawInvariant h h' heq
        rw [hstate, hstate'] at hraw
        cases hraw
      sideOne_sideTwo_absurd := by
        intro h h' summary summary' heq hstate hstate'
        have hraw := rawInvariant h h' heq
        rw [hstate, hstate'] at hraw
        cases hraw
      sideTwo_boundary_absurd := by
        intro h h' summary boundary' heq hstate hstate'
        have hraw := rawInvariant h h' heq
        rw [hstate, hstate'] at hraw
        cases hraw
      sideTwo_sideOne_absurd := by
        intro h h' summary summary' heq hstate hstate'
        have hraw := rawInvariant h h' heq
        rw [hstate, hstate'] at hraw
        cases hraw
    }
    automatonOfHistory_pathInvariant :=
      core.automatonOfHistory_of_continuationClosed hcont
  }

/--
Build the current no-direct path-invariance package by interpreting the abstract
stabilized saturation closure fields with the provided soundness theorem.
-/
theorem StabilizedSaturationBasisNoDirectPathInvariants_of_closureSoundness
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (closureSoundness :
      StabilizedSaturationBasisNoDirectPathInvariantsSoundness
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisNoDirectPathInvariants
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory :=
  closureSoundness
    cert.determinesPathData_proof
    cert.predecessorClosed_proof
    cert.boundaryClosed_proof
    cert.continuationClosed_proof

/--
Truth-vector finite-state equalities from a sound interpretation of the
stabilized saturation closure fields.
-/
theorem StabilizedSaturationBasisTruthVectorFiniteStateEqualities_of_closureSoundness
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (summaryUnit : Summary₂)
    (decodeReceiptOrder :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) × Summary₂ ->
        ReceiptOrderData)
    (closureSoundness :
      StabilizedSaturationBasisNoDirectPathInvariantsSoundness
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory)
    (decodesCurrent :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          decodeReceiptOrder
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory (History.append pref r)), summaryUnit) =
            currentReceiptOrderDataForAppend pref r)
    (orderOfAppend :
      ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          orderOfHistory (History.append pref r) = graphContainmentOrder r.graph)
    (historyAppend :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
          ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
            c.1.history = History.append pref r) :
    StabilizedSaturationBasisTruthVectorFiniteStateEqualities
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory
      (fun h =>
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h))
      (fun h =>
        (regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory h), summaryUnit)) :=
  StabilizedSaturationBasisTruthVectorFiniteStateEqualities_of_pathInvariants
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory summaryUnit decodeReceiptOrder
    (StabilizedSaturationBasisNoDirectPathInvariants_of_closureSoundness
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory closureSoundness)
    decodesCurrent orderOfAppend historyAppend

/--
Canonical repair-atom version of `StabilizedSaturationBasisFiniteStateEqualities`.
Use this when the remaining semantic proof works directly over stabilized
canonical repair atoms.
-/
def StabilizedSaturationBasisRepairAtomFiniteStateEqualities
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {Summary₁ : Type (max u v w a b)}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (summaryOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> Summary₁ × Summary₂) : Prop :=
  (∀ c c' :
    CoherentContinuationConfiguration
      containmentOrder orderOfHistory automatonOfHistory,
    (stabilizedSaturationBasisRepairClauses cert).quotient.encode
      (pathOfHistory c.1.history) =
      (stabilizedSaturationBasisRepairClauses cert).quotient.encode
        (pathOfHistory c'.1.history) ->
    uniform.noDirectEpochStateWithAContinuationData
        initialBoundary orderOfHistory automatonOfHistory parityOfHistory
        c.1.history =
      uniform.noDirectEpochStateWithAContinuationData
        initialBoundary orderOfHistory automatonOfHistory parityOfHistory
        c'.1.history) ∧
    (∀ c c' :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      (stabilizedSaturationBasisRepairClauses cert).quotient.encode
        (pathOfHistory c.1.history) =
        (stabilizedSaturationBasisRepairClauses cert).quotient.encode
          (pathOfHistory c'.1.history) ->
      summaryOfHistory c.1.history = summaryOfHistory c'.1.history) ∧
    (∀ c c' :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      (stabilizedSaturationBasisRepairClauses cert).quotient.encode
        (pathOfHistory c.1.history) =
        (stabilizedSaturationBasisRepairClauses cert).quotient.encode
          (pathOfHistory c'.1.history) ->
      parityOfHistory c.1.history = parityOfHistory c'.1.history)

/--
Build the truth-vector finite-state equality target from factorization through
the stabilized truth-vector atom.

This is the first concrete way to fill the scratch `finiteState_eq` branch:
show the enriched no-direct state, the concrete summary, and the parity payload
are all computed from the same stabilized truth-vector atom.
-/
theorem StabilizedSaturationBasisTruthVectorFiniteStateEqualities_of_factorization
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {Summary₁ : Type (max u v w a b)}
    {Summary₂ : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (summaryOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> Summary₁ × Summary₂)
    (enrichedOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        ((EpochRotatingAccessState
              uniform.boundary
              (uniform.summary Proc.one)
              (uniform.summary Proc.two) ×
            ReceiptOrderData) ×
          AState) ×
          ParityProgress)
    (summaryOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        Summary₁ × Summary₂)
    (parityOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        ParityProgress)
    (enriched_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory h =
          enrichedOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h)))
    (summary_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        summaryOfHistory h =
          summaryOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h)))
    (parity_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        parityOfHistory h =
          parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h))) :
    StabilizedSaturationBasisTruthVectorFiniteStateEqualities
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory summaryOfHistory := by
  refine ⟨?_, ?_, ?_⟩
  · intro c c' htruth
    calc
      uniform.noDirectEpochStateWithAContinuationData
          initialBoundary orderOfHistory automatonOfHistory parityOfHistory
          c.1.history =
          enrichedOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory c.1.history)) := enriched_factor c.1.history
      _ = enrichedOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory c'.1.history)) := by
            rw [htruth]
      _ = uniform.noDirectEpochStateWithAContinuationData
          initialBoundary orderOfHistory automatonOfHistory parityOfHistory
          c'.1.history := (enriched_factor c'.1.history).symm
  · intro c c' htruth
    calc
      summaryOfHistory c.1.history =
          summaryOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory c.1.history)) := summary_factor c.1.history
      _ = summaryOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory c'.1.history)) := by
            rw [htruth]
      _ = summaryOfHistory c'.1.history := (summary_factor c'.1.history).symm
  · intro c c' htruth
    calc
      parityOfHistory c.1.history =
          parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory c.1.history)) := parity_factor c.1.history
      _ = parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory c'.1.history)) := by
            rw [htruth]
      _ = parityOfHistory c'.1.history := (parity_factor c'.1.history).symm

/--
The three independent finite-summary invariants whose conjunction is exactly
the stabilized no-direct `A`-continuation separation target.
-/
def StabilizedSaturationBasisFieldInvariants
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) : Prop :=
  StabilizedSaturationBasisAutomatonStateInvariant
      cert pathOfHistory sameParityOutcomes containmentOrder
      orderOfHistory automatonOfHistory ∧
    StabilizedSaturationBasisReceiptOrderInvariant
      cert pathOfHistory sameParityOutcomes containmentOrder
      orderOfHistory automatonOfHistory ∧
    StabilizedSaturationBasisParityInvariant
      cert pathOfHistory sameParityOutcomes containmentOrder
      orderOfHistory automatonOfHistory

