/--
The four-field package is equivalent to the pair of raw and automaton quotient
factors.
-/
theorem stabilizedSaturationBasisNoDirectSplitQuotientFactorization_iff_splitQuotientFactors
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) :
    Nonempty
        (StabilizedSaturationBasisNoDirectSplitQuotientFactorization
          uniform initialBoundary cert pathOfHistory containmentOrder
          orderOfHistory automatonOfHistory) ↔
      Nonempty
        (StabilizedSaturationBasisNoDirectRawEpochQuotientFactor
          uniform initialBoundary cert pathOfHistory containmentOrder
          orderOfHistory automatonOfHistory) ∧
        Nonempty
          (StabilizedSaturationBasisNoDirectAutomatonQuotientFactor
            uniform initialBoundary cert pathOfHistory containmentOrder
            orderOfHistory automatonOfHistory) := by
  constructor
  · intro hfactorization
    rcases hfactorization with ⟨factorization⟩
    exact
      ⟨⟨StabilizedSaturationBasisNoDirectRawEpochQuotientFactor_of_splitQuotientFactorization
          uniform initialBoundary cert pathOfHistory containmentOrder
          orderOfHistory automatonOfHistory factorization⟩,
        ⟨StabilizedSaturationBasisNoDirectAutomatonQuotientFactor_of_splitQuotientFactorization
          uniform initialBoundary cert pathOfHistory containmentOrder
          orderOfHistory automatonOfHistory factorization⟩⟩
  · intro hsplit
    rcases hsplit with ⟨⟨rawFactor⟩, ⟨automatonFactor⟩⟩
    exact
      ⟨StabilizedSaturationBasisNoDirectSplitQuotientFactorization_of_splitQuotientFactors
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory rawFactor automatonFactor⟩

/--
The four-field package is also exactly the pair of truth-vector invariance
statements for the raw no-direct epoch state and the automaton state.
-/
theorem stabilizedSaturationBasisNoDirectSplitQuotientFactorization_iff_invariants
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) :
    Nonempty
        (StabilizedSaturationBasisNoDirectSplitQuotientFactorization
          uniform initialBoundary cert pathOfHistory containmentOrder
          orderOfHistory automatonOfHistory) ↔
      StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory ∧
      StabilizedSaturationBasisNoDirectAutomatonTruthVectorInvariant
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory := by
  constructor
  · intro hfactorization
    have hsplit :
        Nonempty
            (StabilizedSaturationBasisNoDirectRawEpochQuotientFactor
              uniform initialBoundary cert pathOfHistory containmentOrder
              orderOfHistory automatonOfHistory) ∧
          Nonempty
            (StabilizedSaturationBasisNoDirectAutomatonQuotientFactor
              uniform initialBoundary cert pathOfHistory containmentOrder
              orderOfHistory automatonOfHistory) :=
      (stabilizedSaturationBasisNoDirectSplitQuotientFactorization_iff_splitQuotientFactors
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory).mp hfactorization
    exact
      ⟨(stabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant_iff_nonempty_quotientFactor
          uniform initialBoundary cert pathOfHistory containmentOrder
          orderOfHistory automatonOfHistory).mpr hsplit.1,
        (stabilizedSaturationBasisNoDirectAutomatonTruthVectorInvariant_iff_nonempty_quotientFactor
          uniform initialBoundary cert pathOfHistory containmentOrder
          orderOfHistory automatonOfHistory).mpr hsplit.2⟩
  · intro hinvariants
    have hraw :
        Nonempty
          (StabilizedSaturationBasisNoDirectRawEpochQuotientFactor
            uniform initialBoundary cert pathOfHistory containmentOrder
            orderOfHistory automatonOfHistory) :=
      (stabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant_iff_nonempty_quotientFactor
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory).mp hinvariants.1
    have hautomaton :
        Nonempty
          (StabilizedSaturationBasisNoDirectAutomatonQuotientFactor
            uniform initialBoundary cert pathOfHistory containmentOrder
            orderOfHistory automatonOfHistory) :=
      (stabilizedSaturationBasisNoDirectAutomatonTruthVectorInvariant_iff_nonempty_quotientFactor
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory).mp hinvariants.2
    exact
      (stabilizedSaturationBasisNoDirectSplitQuotientFactorization_iff_splitQuotientFactors
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory).mpr
        ⟨hraw, hautomaton⟩

/--
Contrapositive characterization of the four-field package.  The remaining
length-free skeleton exists exactly when the closure fields rule out both
same-truth-vector counterexamples: one separating the raw no-direct epoch state,
and one separating the automaton state.
-/
theorem stabilizedSaturationBasisNoDirectSplitQuotientFactorization_iff_no_counterexamples
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) :
    Nonempty
        (StabilizedSaturationBasisNoDirectSplitQuotientFactorization
          uniform initialBoundary cert pathOfHistory containmentOrder
          orderOfHistory automatonOfHistory) ↔
      (cert.determinesPathData ->
        cert.predecessorClosed ->
        (∀ boundaryState, cert.boundaryClosed boundaryState) ->
        cert.continuationClosed ->
          ¬ ∃ h h' : History In₁ In₂ Graph Out₁ Out₂,
            regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory h) =
              regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory h') ∧
            uniform.noDirectEpochStateAfterHistory initialBoundary h ≠
              uniform.noDirectEpochStateAfterHistory initialBoundary h') ∧
      (cert.continuationClosed ->
          ¬ ∃ h h' : History In₁ In₂ Graph Out₁ Out₂,
            regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory h) =
              regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory h') ∧
            automatonOfHistory h ≠ automatonOfHistory h') := by
  constructor
  · intro hfactorization
    have hinvariants :
        StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant
            uniform initialBoundary cert pathOfHistory containmentOrder
            orderOfHistory automatonOfHistory ∧
          StabilizedSaturationBasisNoDirectAutomatonTruthVectorInvariant
            uniform initialBoundary cert pathOfHistory containmentOrder
            orderOfHistory automatonOfHistory :=
      (stabilizedSaturationBasisNoDirectSplitQuotientFactorization_iff_invariants
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory).mp hfactorization
    exact
      ⟨(StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant_iff_no_counterexample
          uniform initialBoundary cert pathOfHistory containmentOrder
          orderOfHistory automatonOfHistory).mp hinvariants.1,
        (StabilizedSaturationBasisNoDirectAutomatonTruthVectorInvariant_iff_no_counterexample
          uniform initialBoundary cert pathOfHistory containmentOrder
          orderOfHistory automatonOfHistory).mp hinvariants.2⟩
  · intro hno
    have hraw :
        StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant
          uniform initialBoundary cert pathOfHistory containmentOrder
          orderOfHistory automatonOfHistory :=
      (StabilizedSaturationBasisNoDirectRawEpochTruthVectorInvariant_iff_no_counterexample
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory).mpr hno.1
    have hautomaton :
        StabilizedSaturationBasisNoDirectAutomatonTruthVectorInvariant
          uniform initialBoundary cert pathOfHistory containmentOrder
          orderOfHistory automatonOfHistory :=
      (StabilizedSaturationBasisNoDirectAutomatonTruthVectorInvariant_iff_no_counterexample
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory).mpr hno.2
    exact
      (stabilizedSaturationBasisNoDirectSplitQuotientFactorization_iff_invariants
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory).mpr
        ⟨hraw, hautomaton⟩

/--
The focused pair-state target rules out both diagnostic counterexamples for
the active package.  It is enough to show that same stabilized truth-vector
atoms determine the pair consisting of the raw no-direct epoch state and the
history automaton state.
-/
theorem stabilizedSaturationBasisNoDirectSplitQuotientFactorization_no_counterexamples_of_rawAutomatonStateEq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (truthVectorDeterminesRawAutomatonState :
      cert.continuationClosed ->
        ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
          regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h) =
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h') ->
          (uniform.noDirectEpochStateAfterHistory initialBoundary h,
              automatonOfHistory h) =
            (uniform.noDirectEpochStateAfterHistory initialBoundary h',
              automatonOfHistory h')) :
    (cert.determinesPathData ->
      cert.predecessorClosed ->
      (∀ boundaryState, cert.boundaryClosed boundaryState) ->
      cert.continuationClosed ->
        ¬ ∃ h h' : History In₁ In₂ Graph Out₁ Out₂,
          regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h) =
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h') ∧
          uniform.noDirectEpochStateAfterHistory initialBoundary h ≠
            uniform.noDirectEpochStateAfterHistory initialBoundary h') ∧
      (cert.continuationClosed ->
        ¬ ∃ h h' : History In₁ In₂ Graph Out₁ Out₂,
          regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h) =
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h') ∧
          automatonOfHistory h ≠ automatonOfHistory h') := by
  constructor
  · intro _hdet _hpred _hboundary hcont hcounter
    rcases hcounter with ⟨h, h', htruth, hneq⟩
    exact hneq
      (congrArg Prod.fst
        (truthVectorDeterminesRawAutomatonState hcont h h' htruth))
  · intro hcont hcounter
    rcases hcounter with ⟨h, h', htruth, hneq⟩
    exact hneq
      (congrArg Prod.snd
        (truthVectorDeterminesRawAutomatonState hcont h h' htruth))

/--
Focused pair-state determinacy is a sufficient condition for the four-field
length-free factorization package.
-/
theorem stabilizedSaturationBasisNoDirectSplitQuotientFactorization_of_rawAutomatonStateEq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (truthVectorDeterminesRawAutomatonState :
      cert.continuationClosed ->
        ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
          regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h) =
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h') ->
          (uniform.noDirectEpochStateAfterHistory initialBoundary h,
              automatonOfHistory h) =
            (uniform.noDirectEpochStateAfterHistory initialBoundary h',
              automatonOfHistory h')) :
    Nonempty
      (StabilizedSaturationBasisNoDirectSplitQuotientFactorization
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :=
  (stabilizedSaturationBasisNoDirectSplitQuotientFactorization_iff_no_counterexamples
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory).mpr
    (stabilizedSaturationBasisNoDirectSplitQuotientFactorization_no_counterexamples_of_rawAutomatonStateEq
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory
      truthVectorDeterminesRawAutomatonState)

