    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (_uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (_initialBoundary : _uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (_containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (_orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) : Prop :=
  cert.continuationClosed ->
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistory h) (pathOfHistory h') ->
      automatonOfHistory h = automatonOfHistory h'

/--
Assemble the compact core from its raw and automaton halves.
-/
theorem StabilizedSaturationBasisNoDirectClosureSoundnessCore_of_split
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (rawSoundness :
      StabilizedSaturationBasisNoDirectRawEpochClosureSoundness
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory)
    (automatonSoundness :
      StabilizedSaturationBasisNoDirectAutomatonClosureSoundness
        uniform initialBoundary cert pathOfHistory containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisNoDirectClosureSoundnessCore
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory where
  rawEpochState_of_closureFields := rawSoundness
  automatonOfHistory_of_continuationClosed := automatonSoundness

/--
Concrete condition making every history into a coherent continuation
configuration by choosing its current receipt tags and automaton profile.
-/
def StabilizedSaturationBasisCanonicalCoherentHistoryRepresentatives
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type b}
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState) : Prop :=
  ∀ h : History In₁ In₂ Graph Out₁ Out₂,
    containmentOrder {
      history := h
      automatonState := automatonOfHistory h
      receiptOne := (currentView Proc.one h).receiptTag
      receiptTwo := (currentView Proc.two h).receiptTag
    } = orderOfHistory h

/--
Canonical coherent continuation configuration attached to a history.
-/
def stabilizedSaturationBasisCanonicalCoherentConfigOfHistory
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type b}
    {containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder}
    {orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder}
    {automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState}
    (representatives :
      StabilizedSaturationBasisCanonicalCoherentHistoryRepresentatives
        containmentOrder orderOfHistory automatonOfHistory)
    (h : History In₁ In₂ Graph Out₁ Out₂) :
    CoherentContinuationConfiguration
      containmentOrder orderOfHistory automatonOfHistory :=
  ⟨{
      history := h
      automatonState := automatonOfHistory h
      receiptOne := (currentView Proc.one h).receiptTag
      receiptTwo := (currentView Proc.two h).receiptTag
    },
    by
      exact ⟨⟨rfl, rfl, representatives h⟩, rfl⟩⟩

@[simp]
theorem stabilizedSaturationBasisCanonicalCoherentConfigOfHistory_history
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type b}
    {containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder}
    {orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder}
    {automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState}
    (representatives :
      StabilizedSaturationBasisCanonicalCoherentHistoryRepresentatives
        containmentOrder orderOfHistory automatonOfHistory)
    (h : History In₁ In₂ Graph Out₁ Out₂) :
    (stabilizedSaturationBasisCanonicalCoherentConfigOfHistory
        representatives h).1.history = h :=
  rfl

/--
Derive the automaton half of the compact core from regular-test
path-equivalent coherent `A`-continuation separation.

The extra representative assumption is necessary because the separation theorem
only talks about coherent continuation configurations, while the automaton
closure target quantifies over histories.
-/
theorem StabilizedSaturationBasisNoDirectAutomatonClosureSoundness_of_pathEquivalentSeparation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (separation :
      RegularTestPathEquivalentCoherentAContinuationSeparation
        (stabilizedSaturationBasis cert) pathOfHistory sameParityOutcomes
        containmentOrder orderOfHistory automatonOfHistory)
    (coherentConfigOfHistory :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory)
    (coherentConfigOfHistory_history :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        (coherentConfigOfHistory h).1.history = h) :
    StabilizedSaturationBasisNoDirectAutomatonClosureSoundness
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory := by
  intro _hcont h h' hpath
  let c := coherentConfigOfHistory h
  let c' := coherentConfigOfHistory h'
  have hcHistory : c.1.history = h := coherentConfigOfHistory_history h
  have hcHistory' : c'.1.history = h' := coherentConfigOfHistory_history h'
  have hcState : c.1.automatonState = automatonOfHistory h := by
    simpa [hcHistory] using c.2.2
  have hcState' : c'.1.automatonState = automatonOfHistory h' := by
    simpa [hcHistory'] using c'.2.2
  have hbasis :
      RegularTestBasisPathEquivalent (stabilizedSaturationBasis cert)
        (pathOfHistory c.1.history) (pathOfHistory c'.1.history) := by
    simpa [RegularTestBasisPathEquivalent,
      StabilizedSaturationBasisPathEquivalent, hcHistory, hcHistory'] using hpath
  have hstate : c.1.automatonState = c'.1.automatonState :=
    (separation c c' hbasis).1
  calc
    automatonOfHistory h = c.1.automatonState := hcState.symm
    _ = c'.1.automatonState := hstate
    _ = automatonOfHistory h' := hcState'

/--
Canonical-representative version of
`StabilizedSaturationBasisNoDirectAutomatonClosureSoundness_of_pathEquivalentSeparation`.
-/
theorem StabilizedSaturationBasisNoDirectAutomatonClosureSoundness_of_pathEquivalentSeparation_canonical
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
