      uniform cert edgeOfRound automatonOfHistory σ := by
  classical
  let currentViewsOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        View In₁ In₂ Proc.one × View In₁ In₂ Proc.two :=
    fun atom =>
      if h :
          ∃ hist : History In₁ In₂ Graph Out₁ Out₂,
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound hist) = atom then
        (currentView Proc.one (Classical.choose h),
          currentView Proc.two (Classical.choose h))
