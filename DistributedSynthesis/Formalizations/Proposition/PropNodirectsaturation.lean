      sideTwo_sideOne_absurd :=
        components.sideTwo_sideOne_absurd_of_continuationClosed hcont
    }
    automatonOfHistory_pathInvariant :=
      components.automatonOfHistory_of_continuationClosed hcont
  }

/--
Convert any typed closure-soundness interpretation into the current two-field
truth-vector invariant package.

This bridge keeps older path-invariant soundness proofs usable with the current
sharp top-down endpoint.
