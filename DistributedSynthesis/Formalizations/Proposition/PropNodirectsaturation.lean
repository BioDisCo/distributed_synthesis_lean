      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (rawEpochOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        EpochRotatingAccessState
          uniform.boundary (uniform.summary Proc.one) (uniform.summary Proc.two))
    (rawEpoch_factor :
      cert.determinesPathData ->
      cert.predecessorClosed ->
      (∀ boundaryState, cert.boundaryClosed boundaryState) ->
      cert.continuationClosed ->
        ∀ h : History In₁ In₂ Graph Out₁ Out₂,
          rawEpochOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory h)) =
            uniform.noDirectEpochStateAfterHistory initialBoundary h)
    (automatonOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> AState)
    (automaton_factor :
      cert.continuationClosed ->
        ∀ h : History In₁ In₂ Graph Out₁ Out₂,
          automatonOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory h)) =
            automatonOfHistory h) :
    StabilizedSaturationBasisNoDirectSplitQuotientFactorization
      uniform initialBoundary cert pathOfHistory containmentOrder orderOfHistory
      automatonOfHistory :=
  { rawEpochOfTruth := rawEpochOfTruth
    rawEpoch_factor := rawEpoch_factor
    automatonOfTruth := automatonOfTruth
    automaton_factor := automaton_factor }

