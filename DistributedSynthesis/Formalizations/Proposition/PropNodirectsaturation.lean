/--
Build quotient factors from truth-vector invariance, using the canonical
representative history for realized stabilized truth-vector atoms.

This is the practical proof target behind
`StabilizedSaturationBasisNoDirectClosureSoundnessQuotientFactors`: prove that
equal stabilized truth vectors preserve the raw no-direct epoch state and the
automaton profile.  The quotient maps are then obtained by evaluating the
concrete maps at the chosen representative history.
-/
noncomputable def
    StabilizedSaturationBasisNoDirectClosureSoundnessQuotientFactors_of_truthVectorInvariants
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (rawEpochState_invariant :
      cert.determinesPathData ->
      cert.predecessorClosed ->
      (∀ boundaryState, cert.boundaryClosed boundaryState) ->
      cert.continuationClosed ->
        ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
          regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h) =
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h') ->
          uniform.noDirectEpochStateAfterHistory initialBoundary h =
            uniform.noDirectEpochStateAfterHistory initialBoundary h')
    (automatonOfHistory_invariant :
      cert.continuationClosed ->
        ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
          regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h) =
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h') ->
          automatonOfHistory h = automatonOfHistory h') :
    StabilizedSaturationBasisNoDirectClosureSoundnessQuotientFactors
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory where
  rawEpochOfTruth := fun atom =>
    uniform.noDirectEpochStateAfterHistory initialBoundary
      (stabilizedTruthVectorRepresentativeHistory
        cert pathOfHistory containmentOrder orderOfHistory automatonOfHistory atom)
  automatonOfTruth := fun atom =>
    automatonOfHistory
      (stabilizedTruthVectorRepresentativeHistory
        cert pathOfHistory containmentOrder orderOfHistory automatonOfHistory atom)
  rawEpoch_factor_of_closureFields := by
    intro hdet hpred hboundary hcont h
    exact
      rawEpochState_invariant hdet hpred hboundary hcont
        (stabilizedTruthVectorRepresentativeHistory
          cert pathOfHistory containmentOrder orderOfHistory automatonOfHistory
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h)))
        h
        (stabilizedTruthVectorRepresentativeHistory_realizes
          cert pathOfHistory containmentOrder orderOfHistory automatonOfHistory h)
  automaton_factor_of_continuationClosed := by
    intro hcont h
    exact
      automatonOfHistory_invariant hcont
        (stabilizedTruthVectorRepresentativeHistory
          cert pathOfHistory containmentOrder orderOfHistory automatonOfHistory
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h)))
        h
        (stabilizedTruthVectorRepresentativeHistory_realizes
          cert pathOfHistory containmentOrder orderOfHistory automatonOfHistory h)

