      ∀ envs envs' : List (EnvironmentRound In₁ In₂),
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs))
          (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs')) ->
        envs.length = envs'.length)
    (pathEquivalentDeterminesGeneratedCurrentViews :
      ∀ envs envs' : List (EnvironmentRound In₁ In₂),
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs))
          (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs')) ->
        ∀ pref pref' : List (EnvironmentRound In₁ In₂),
          pref.length = pref'.length ->
          pref.length ≤ envs.length ->
          (∃ suff, envs = pref ++ suff) ->
          (∃ suff', envs' = pref' ++ suff') ->
          currentView Proc.one (executionPrefixFromList σ pref) =
            currentView Proc.one (executionPrefixFromList σ pref') ∧
          currentView Proc.two (executionPrefixFromList σ pref) =
            currentView Proc.two (executionPrefixFromList σ pref'))
    (automatonOfHistory_respectsRelevantHistory :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        List.Forall₂ NoDirectEpochRelevantRoundEq h h' ->
        automatonOfHistory h = automatonOfHistory h') :
    StabilizedSaturationBasisNoDirectByRoundFiniteStateSeparation
      uniform initialBoundary cert edgeOfRound automatonOfHistory := by
  apply byRoundFiniteStateSeparation_of_relevantHistoryEq
    uniform initialBoundary cert edgeOfRound automatonOfHistory
  · intro h h' htruth
    rcases generatedHistory h with ⟨envs, rfl⟩
    rcases generatedHistory h' with ⟨envs', rfl⟩
    have hpath :
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs))
          (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs')) :=
      (stabilizedSaturationBasisPathEquivalent_iff_truthVector_eq
        cert
        (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs))
        (pathOfHistoryByRound edgeOfRound
          (executionPrefixFromList σ envs'))).mpr htruth
    exact
      noDirectEpochRelevantHistoryEq_executionPrefixFromList_of_currentView_snoc_eq
        σ envs envs'
        (pathEquivalentDeterminesGeneratedLength envs envs' hpath)
        (pathEquivalentDeterminesGeneratedCurrentViews envs envs' hpath)
  · exact automatonOfHistory_respectsRelevantHistory

/--
Generated finite-prefix route where the generated-list length is recovered
from the length of the by-round typed path.
-/
theorem byRoundFiniteStateSeparation_of_generatedCurrentViewsFromList_pathLength
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generatedHistory :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        ∃ envs : List (EnvironmentRound In₁ In₂),
          h = executionPrefixFromList σ envs)
    (pathEquivalentDeterminesPathLength :
      ∀ path path' : TypedPath EdgeType,
        StabilizedSaturationBasisPathEquivalent cert path path' ->
        path.length = path'.length)
    (pathEquivalentDeterminesGeneratedCurrentViews :
      ∀ envs envs' : List (EnvironmentRound In₁ In₂),
        StabilizedSaturationBasisPathEquivalent cert
          (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs))
          (pathOfHistoryByRound edgeOfRound (executionPrefixFromList σ envs')) ->
        ∀ pref pref' : List (EnvironmentRound In₁ In₂),
          pref.length = pref'.length ->
          pref.length ≤ envs.length ->
          (∃ suff, envs = pref ++ suff) ->
          (∃ suff', envs' = pref' ++ suff') ->
          currentView Proc.one (executionPrefixFromList σ pref) =
            currentView Proc.one (executionPrefixFromList σ pref') ∧
          currentView Proc.two (executionPrefixFromList σ pref) =
            currentView Proc.two (executionPrefixFromList σ pref'))
    (automatonOfHistory_respectsRelevantHistory :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        List.Forall₂ NoDirectEpochRelevantRoundEq h h' ->
        automatonOfHistory h = automatonOfHistory h') :
    StabilizedSaturationBasisNoDirectByRoundFiniteStateSeparation
      uniform initialBoundary cert edgeOfRound automatonOfHistory :=
  byRoundFiniteStateSeparation_of_generatedCurrentViewsFromList
    uniform initialBoundary cert edgeOfRound automatonOfHistory σ
    generatedHistory
    (by
      intro envs envs' hpath
      rw [← pathOfHistoryByRound_executionPrefixFromList_length
            σ edgeOfRound envs,
        ← pathOfHistoryByRound_executionPrefixFromList_length
            σ edgeOfRound envs']
      exact
        pathEquivalentDeterminesPathLength
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ envs))
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ envs'))
          hpath)
    pathEquivalentDeterminesGeneratedCurrentViews
    automatonOfHistory_respectsRelevantHistory

/--
Preferred package form of the generated finite-prefix route.

This closes the named by-round finite-state separation target from the
corrected truth-vector factor package: generated length is only required on
generated paths, while current views, generated-prefix atoms, and the automaton
state factor through stabilized truth-vector atoms.
-/
theorem byRoundFiniteStateSeparation_of_generatedLengthTruthVectorFactorPackage
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generatedHistory :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        ∃ envs : List (EnvironmentRound In₁ In₂),
          h = executionPrefixFromList σ envs)
    (factors :
      StabilizedSaturationBasisNoDirectByRoundGeneratedLengthTruthVectorFactors
        uniform cert edgeOfRound automatonOfHistory σ) :
    StabilizedSaturationBasisNoDirectByRoundFiniteStateSeparation
      uniform initialBoundary cert edgeOfRound automatonOfHistory :=
  byRoundFiniteStateSeparation_of_generatedCurrentViewsFromList
    uniform initialBoundary cert edgeOfRound automatonOfHistory σ
    generatedHistory
    factors.generatedLength
    (by
      intro envs envs' hpath pref pref' hprefLength hprefLe hprefSub hprefSub'
      have hfullTruth :=
        stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent hpath
      have hprefTruth :
          regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound
                (executionPrefixFromList σ pref)) =
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound
                (executionPrefixFromList σ pref')) := by
        calc
          regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound
                (executionPrefixFromList σ pref))
              =
            factors.generatedPrefixTruthOf
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound
                  (executionPrefixFromList σ envs)))
              pref.length := by
                exact factors.generatedPrefixTruth_factor envs pref hprefLe hprefSub
          _ =
            factors.generatedPrefixTruthOf
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistoryByRound edgeOfRound
                  (executionPrefixFromList σ envs')))
              pref'.length := by
                rw [hfullTruth, hprefLength]
          _ =
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound
                (executionPrefixFromList σ pref')) := by
                exact
                  (factors.generatedPrefixTruth_factor envs' pref'
                    (by
                      have henvLength := factors.generatedLength envs envs' hpath
                      rw [← hprefLength, ← henvLength]
                      exact hprefLe)
                    hprefSub').symm
      exact
        stabilizedSaturationBasis_currentViews_eq_of_truthVector_factor
          (pathOfHistoryByRound edgeOfRound)
          factors.currentViewsOfTruth factors.currentViews_factor
          (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq hprefTruth))
    (automatonOfHistory_respectsRelevantHistory_of_truthVector_factor
      (pathOfHistoryByRound edgeOfRound) automatonOfHistory
      factors.automatonOfTruth factors.automaton_factor
      factors.relevantHistoryDeterminesTruthVector)

/--
Determinacy-statement form of the preferred generated finite-prefix route.

This is the most direct usable endpoint for the by-round finite-state target:
same stabilized truth atoms must determine generated length, generated-prefix
truth atoms, current views, and the chosen automaton state; relevant-history
equality must preserve the stabilized truth atom.
-/
theorem byRoundFiniteStateSeparation_of_generatedDeterminacy
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generatedHistory :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        ∃ envs : List (EnvironmentRound In₁ In₂),
          h = executionPrefixFromList σ envs)
    (generatedLength_determined :
      ∀ envs envs' : List (EnvironmentRound In₁ In₂),
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              (executionPrefixFromList σ envs)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              (executionPrefixFromList σ envs')) ->
        envs.length = envs'.length)
    (generatedPrefixTruth_determined :
      ∀ envs envs' pref pref' : List (EnvironmentRound In₁ In₂),
        pref.length ≤ envs.length ->
        pref'.length ≤ envs'.length ->
        (∃ suff, envs = pref ++ suff) ->
        (∃ suff', envs' = pref' ++ suff') ->
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              (executionPrefixFromList σ envs)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              (executionPrefixFromList σ envs')) ->
        pref.length = pref'.length ->
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              (executionPrefixFromList σ pref)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              (executionPrefixFromList σ pref')))
    (currentViews_determined :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        (currentView Proc.one h, currentView Proc.two h) =
          (currentView Proc.one h', currentView Proc.two h'))
    (automaton_determined :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        automatonOfHistory h = automatonOfHistory h')
    (relevantHistoryDeterminesTruthVector :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        List.Forall₂ NoDirectEpochRelevantRoundEq h h' ->
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h')) :
    StabilizedSaturationBasisNoDirectByRoundFiniteStateSeparation
      uniform initialBoundary cert edgeOfRound automatonOfHistory :=
  byRoundFiniteStateSeparation_of_generatedLengthTruthVectorFactorPackage
    uniform initialBoundary cert edgeOfRound automatonOfHistory σ
    generatedHistory
    (StabilizedSaturationBasisNoDirectByRoundGeneratedLengthTruthVectorFactors_of_determinacy
      uniform cert edgeOfRound automatonOfHistory σ
      generatedLength_determined
      generatedPrefixTruth_determined
      currentViews_determined
      automaton_determined
      relevantHistoryDeterminesTruthVector)

/--
The unbounded generated-determinacy endpoint cannot be discharged globally in
the usual inhabited-input setting: its generated-length premise alone
contradicts finiteness of stabilized truth atoms.
-/
theorem not_generatedLength_determined_of_inhabited_inputs
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁] [Inhabited In₂]
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) :
    ¬ (∀ envs envs' : List (EnvironmentRound In₁ In₂),
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              (executionPrefixFromList σ envs)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              (executionPrefixFromList σ envs')) ->
        envs.length = envs'.length) := by
  intro generatedLength_determined
  exact
    stabilizedSaturationBasis_no_global_generatedLength_preservation
      (Alphabet := Alphabet) cert edgeOfRound σ
      (by
        intro envs envs' hpath
        exact generatedLength_determined envs envs'
          (stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent hpath))

/--
No-go for the global bounded generated-history coverage premise.

Any premise saying every finite history has an `executionPrefixFromList`
representative of length at most a fixed `generationBound` is globally false:
with inhabited inputs and outputs there are histories of length
`generationBound + 1`.  Bounded generated-prefix arguments must therefore be
stated over an epoch-local/generated-history domain, not over all histories.
-/
theorem not_all_histories_bounded_generatedFromList_of_inhabited
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Inhabited Out₁]
    [Inhabited Out₂]
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat) :
    ¬ (∀ h : History In₁ In₂ Graph Out₁ Out₂,
        ∃ envs : List (EnvironmentRound In₁ In₂),
          h = executionPrefixFromList σ envs ∧
          envs.length ≤ generationBound) := by
  intro generatedHistoryBounded
  let round : RoundRecord In₁ In₂ Graph Out₁ Out₂ :=
    { inputOne := default
      inputTwo := default
      graph := Graph.left
      outputOne := default
      outputTwo := default }
  let h : History In₁ In₂ Graph Out₁ Out₂ :=
    List.replicate (generationBound + 1) round
  rcases generatedHistoryBounded h with ⟨envs, heq, hle⟩
  have hlenH : History.length h = generationBound + 1 := by
    simp [h, History.length]
  have hlenExec :
      History.length (executionPrefixFromList σ envs) = envs.length :=
    executionPrefixFromList_length σ envs
  have henvs : envs.length = generationBound + 1 := by
    calc
      envs.length = History.length (executionPrefixFromList σ envs) := hlenExec.symm
      _ = History.length h := by rw [heq]
      _ = generationBound + 1 := hlenH
  have hsucc : generationBound + 1 ≤ generationBound := by
    simpa [henvs] using hle
  exact Nat.not_succ_le_self generationBound hsucc

/--
No-go for local coherent bounded coverage when coherent configurations still
include canonical representatives of every history.

The local bounded endpoint is only a genuine escape from the global no-go if
its coherent domain is a real finite/rational-run carrier.  If canonical
coherent representatives are available for all histories, then bounded
coverage of all coherent configurations immediately implies the globally false
bounded generated-history coverage premise.
-/
theorem not_all_canonical_coherent_histories_bounded_generatedFromList_of_inhabited
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Inhabited Out₁]
    [Inhabited Out₂]
    {AState : Type b}
    {containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder}
    {orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder}
    {automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState}
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (representatives :
      StabilizedSaturationBasisCanonicalCoherentHistoryRepresentatives
        containmentOrder orderOfHistory automatonOfHistory) :
    ¬ (∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        ∃ envs : List (EnvironmentRound In₁ In₂),
          c.1.history = executionPrefixFromList σ envs ∧
          envs.length ≤ generationBound) := by
  intro coherentGeneratedHistoryBounded
  exact
    not_all_histories_bounded_generatedFromList_of_inhabited σ generationBound
      (by
        intro h
        rcases coherentGeneratedHistoryBounded
            (stabilizedSaturationBasisCanonicalCoherentConfigOfHistory
              representatives h) with
          ⟨envs, hhist, hlen⟩
        exact ⟨envs, by simpa using hhist, hlen⟩)

/--
Finite/rational-run carrier for the bounded coherent generated route.

This is the corrected shape of the remaining finite-memory payload: every
coherent configuration is classified by a finite carrier state, and each
carrier state has a bounded generated representative.  The representative need
not be literally equal to the classified history; the semantic carrier theorem
below asks separately that the representative preserve the stabilized path and
the enriched no-direct state.  This avoids the globally false bounded-history
coverage premise.
-/
structure StabilizedSaturationBasisBoundedGeneratedCoherentCarrier
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type b}
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat) where
  Carrier : Type (max u v w a b)
  carrierFinite : Fintype Carrier
  stateOf :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory ->
      Carrier
  envsOf : Carrier -> List (EnvironmentRound In₁ In₂)
  envs_length_le :
    ∀ x : Carrier, (envsOf x).length ≤ generationBound

attribute [instance] StabilizedSaturationBasisBoundedGeneratedCoherentCarrier.carrierFinite

namespace StabilizedSaturationBasisBoundedGeneratedCoherentCarrier

/--
Every classified state has a bounded generated representative.
-/
theorem envsOf_length_le
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type b}
    {containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder}
    {orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder}
    {automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState}
    {σ : StrategyPair In₁ In₂ Out₁ Out₂}
    {generationBound : Nat}
    (carrier :
      StabilizedSaturationBasisBoundedGeneratedCoherentCarrier
        containmentOrder orderOfHistory automatonOfHistory σ generationBound) :
    ∀ x : carrier.Carrier, (carrier.envsOf x).length ≤ generationBound :=
  carrier.envs_length_le

end StabilizedSaturationBasisBoundedGeneratedCoherentCarrier

/--
Bundled correctness certificate for the finite/rational-run bounded coherent
carrier.

This is the final shape of the remaining positive payload: construct a finite
classifier with bounded generated representatives, show that representatives
preserve the stabilized path and enriched state of each coherent
configuration, and prove determinacy between representatives.
-/
structure StabilizedSaturationBasisBoundedGeneratedCoherentCarrierCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat) where
  carrier :
    StabilizedSaturationBasisBoundedGeneratedCoherentCarrier
      containmentOrder orderOfHistory automatonOfHistory σ generationBound
  carrierPathEquivalent :
    ∀ c :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistoryByRound edgeOfRound c.1.history)
        (pathOfHistoryByRound edgeOfRound
          (executionPrefixFromList σ (carrier.envsOf (carrier.stateOf c))))
  carrierEnrichedState_eq :
    ∀ c :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      uniform.noDirectEpochStateWithAContinuationData
          initialBoundary orderOfHistory automatonOfHistory parityOfHistory
          c.1.history =
        uniform.noDirectEpochStateWithAContinuationData
          initialBoundary orderOfHistory automatonOfHistory parityOfHistory
          (executionPrefixFromList σ (carrier.envsOf (carrier.stateOf c)))
  carrierGeneratedEnrichedState_determined :
    ∀ x x' : carrier.Carrier,
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistoryByRound edgeOfRound
          (executionPrefixFromList σ (carrier.envsOf x)))
        (pathOfHistoryByRound edgeOfRound
          (executionPrefixFromList σ (carrier.envsOf x'))) ->
        uniform.noDirectEpochStateWithAContinuationData
          initialBoundary orderOfHistory automatonOfHistory parityOfHistory
          (executionPrefixFromList σ (carrier.envsOf x)) =
        uniform.noDirectEpochStateWithAContinuationData
          initialBoundary orderOfHistory automatonOfHistory parityOfHistory
          (executionPrefixFromList σ (carrier.envsOf x'))

/--
Bundled finite history-quotient data for the rational/access-state route.

This is the paper-facing payload expected from the rotating rational-run finite
memory argument.  It is deliberately stated over a finite quotient of histories:
the quotient state chooses a bounded generated representative, and the
representative must preserve exactly the stabilized path and enriched
no-direct state used by the final carrier theorem.
-/
structure StabilizedSaturationBasisBoundedGeneratedHistoryQuotientCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat) where
  Q : Type (max u v w a b)
  qFinite : Fintype Q
  stateOfHistory : History In₁ In₂ Graph Out₁ Out₂ -> Q
  envsOf : Q -> List (EnvironmentRound In₁ In₂)
  envs_length_le : ∀ x : Q, (envsOf x).length ≤ generationBound
  quotientPathEquivalent :
    ∀ c :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistoryByRound edgeOfRound c.1.history)
        (pathOfHistoryByRound edgeOfRound
          (executionPrefixFromList σ (envsOf (stateOfHistory c.1.history))))
  quotientEnrichedState_eq :
    ∀ c :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      uniform.noDirectEpochStateWithAContinuationData
          initialBoundary orderOfHistory automatonOfHistory parityOfHistory
          c.1.history =
        uniform.noDirectEpochStateWithAContinuationData
          initialBoundary orderOfHistory automatonOfHistory parityOfHistory
          (executionPrefixFromList σ (envsOf (stateOfHistory c.1.history)))
  quotientGeneratedEnrichedState_determined :
    ∀ x x' : Q,
      StabilizedSaturationBasisPathEquivalent cert
        (pathOfHistoryByRound edgeOfRound
          (executionPrefixFromList σ (envsOf x)))
        (pathOfHistoryByRound edgeOfRound
          (executionPrefixFromList σ (envsOf x'))) ->
      uniform.noDirectEpochStateWithAContinuationData
          initialBoundary orderOfHistory automatonOfHistory parityOfHistory
          (executionPrefixFromList σ (envsOf x)) =
        uniform.noDirectEpochStateWithAContinuationData
          initialBoundary orderOfHistory automatonOfHistory parityOfHistory
          (executionPrefixFromList σ (envsOf x'))

attribute [instance] StabilizedSaturationBasisBoundedGeneratedHistoryQuotientCertificate.qFinite

/--
Truth-vector-labelled finite quotient data for the bounded generated route.

This is a sharper journal-facing payload than the completely abstract history
quotient above.  Each finite quotient state carries the stabilized truth-vector
atom it represents; generated representatives realize that atom; and generated
representatives with the same atom have the same enriched no-direct state.  The
generic history-quotient determinacy field is then derived mechanically from
`StabilizedSaturationBasisPathEquivalent`.
-/
structure StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat) where
  Q : Type (max u v w a b)
  qFinite : Fintype Q
  stateOfHistory : History In₁ In₂ Graph Out₁ Out₂ -> Q
  envsOf : Q -> List (EnvironmentRound In₁ In₂)
  envs_length_le : ∀ x : Q, (envsOf x).length ≤ generationBound
  truthOf : Q -> RegularTestTruthAtom (stabilizedSaturationBasis cert)
  state_truth_eq :
    ∀ c :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      truthOf (stateOfHistory c.1.history) =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history)
  representative_truth_eq :
    ∀ x : Q,
      regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistoryByRound edgeOfRound
          (executionPrefixFromList σ (envsOf x))) =
        truthOf x
  quotientEnrichedState_eq :
    ∀ c :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      uniform.noDirectEpochStateWithAContinuationData
          initialBoundary orderOfHistory automatonOfHistory parityOfHistory
          c.1.history =
        uniform.noDirectEpochStateWithAContinuationData
          initialBoundary orderOfHistory automatonOfHistory parityOfHistory
          (executionPrefixFromList σ (envsOf (stateOfHistory c.1.history)))
  representativeEnriched_eq_of_truthOf_eq :
    ∀ x x' : Q,
      truthOf x = truthOf x' ->
      uniform.noDirectEpochStateWithAContinuationData
          initialBoundary orderOfHistory automatonOfHistory parityOfHistory
          (executionPrefixFromList σ (envsOf x)) =
        uniform.noDirectEpochStateWithAContinuationData
          initialBoundary orderOfHistory automatonOfHistory parityOfHistory
          (executionPrefixFromList σ (envsOf x'))

attribute [instance] StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.qFinite

/--
Construct the truth-vector-labelled quotient from represented stabilized truth
atoms.

The quotient state is the finite subtype of stabilized truth-vector atoms that
have a bounded generated representative.  The caller supplies the finite-memory
state map from histories into that represented subtype and proves that, on
coherent configurations, its atom is the actual stabilized truth vector.  Once
the enriched no-direct state is invariant under equality of truth atoms, all
remaining certificate fields are derived.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representedTruthAtoms
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (stateOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ ->
        { truth : RegularTestTruthAtom (stabilizedSaturationBasis cert) //
          ∃ envs : List (EnvironmentRound In₁ In₂),
            envs.length ≤ generationBound ∧
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound
                (executionPrefixFromList σ envs)) = truth })
    (state_truth_eq :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
      (stateOfHistory c.1.history).1 =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history))
    (enrichedState_eq_of_truth_eq :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory h =
          uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory h') :
    StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory σ generationBound := by
  classical
  letI : Fintype (RegularTestTruthAtom (stabilizedSaturationBasis cert)) :=
    regularTestTruthAtomFintype (stabilizedSaturationBasis cert)
  let Q :=
    { truth : RegularTestTruthAtom (stabilizedSaturationBasis cert) //
      ∃ envs : List (EnvironmentRound In₁ In₂),
        envs.length ≤ generationBound ∧
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ envs)) = truth }
  let chosenEnvs : Q -> List (EnvironmentRound In₁ In₂) :=
    fun x => Classical.choose x.2
  have chosen_length :
      ∀ x : Q, (chosenEnvs x).length ≤ generationBound := by
    intro x
    exact (Classical.choose_spec x.2).1
  have chosen_truth :
      ∀ x : Q,
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (chosenEnvs x))) = x.1 := by
    intro x
    exact (Classical.choose_spec x.2).2
  refine
    { Q := Q
      qFinite := by infer_instance
      stateOfHistory := stateOfHistory
      envsOf := chosenEnvs
      envs_length_le := chosen_length
      truthOf := fun x => x.1
      state_truth_eq := state_truth_eq
      representative_truth_eq := chosen_truth
      quotientEnrichedState_eq := ?_
      representativeEnriched_eq_of_truthOf_eq := ?_ }
  · intro c
    apply enrichedState_eq_of_truth_eq
    calc
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history)
          =
        (stateOfHistory c.1.history).1 := by
          exact (state_truth_eq c).symm
      _ =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ
              (chosenEnvs (stateOfHistory c.1.history)))) := by
          exact (chosen_truth (stateOfHistory c.1.history)).symm
  · intro x x' htruth
    apply enrichedState_eq_of_truth_eq
    calc
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (chosenEnvs x)))
          =
        x.1 := chosen_truth x
      _ = x'.1 := htruth
      _ =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (chosenEnvs x'))) := by
          exact (chosen_truth x').symm

/--
Concrete representative-list version of `of_representedTruthAtoms`.

This is the journal-facing surface for the current shortest route: assign a
stabilized truth atom to each history, give a bounded generated representative
that realizes that atom, prove coherent histories receive their actual atom, and
prove that equal stabilized atoms determine the enriched no-direct state.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representatives
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (truthOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ ->
        RegularTestTruthAtom (stabilizedSaturationBasis cert))
    (envsOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂))
    (envs_bound :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        (envsOfHistory h).length ≤ generationBound)
    (envs_truth :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (envsOfHistory h))) =
          truthOfHistory h)
    (truthOfHistory_eq :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
      truthOfHistory c.1.history =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history))
    (enrichedState_eq_of_truth_eq :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory h =
          uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory h') :
    StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory σ generationBound :=
  StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representedTruthAtoms
    uniform initialBoundary cert edgeOfRound containmentOrder orderOfHistory
    automatonOfHistory parityOfHistory σ generationBound
    (fun h =>
      ⟨truthOfHistory h,
        ⟨envsOfHistory h, envs_bound h, envs_truth h⟩⟩)
    (fun c => truthOfHistory_eq c)
    enrichedState_eq_of_truth_eq

/--
Componentwise representative-list version of
`of_representatives`.

This is the sharper journal-facing surface: the enriched no-direct state
equality is supplied through its four semantic components and assembled by
`noDirectEpochStateWithAContinuationData_eq_of_components`.
-/
noncomputable def StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representativesComponents
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (truthOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ ->
        RegularTestTruthAtom (stabilizedSaturationBasis cert))
    (envsOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂))
    (envs_bound :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        (envsOfHistory h).length ≤ generationBound)
    (envs_truth :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (envsOfHistory h))) =
          truthOfHistory h)
    (truthOfHistory_eq :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
      truthOfHistory c.1.history =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history))
    (rawEpochState_eq_of_truth_eq :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        uniform.noDirectEpochStateAfterHistory initialBoundary h =
          uniform.noDirectEpochStateAfterHistory initialBoundary h')
    (receiptOrder_eq_of_truth_eq :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        currentReceiptOrderData h (orderOfHistory h) =
          currentReceiptOrderData h' (orderOfHistory h'))
    (automatonOfHistory_eq_of_truth_eq :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        automatonOfHistory h = automatonOfHistory h')
    (parityOfHistory_eq_of_truth_eq :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        parityOfHistory h = parityOfHistory h') :
    StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate
      uniform initialBoundary cert edgeOfRound containmentOrder
      orderOfHistory automatonOfHistory parityOfHistory σ generationBound :=
  StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representatives
    uniform initialBoundary cert edgeOfRound containmentOrder orderOfHistory
    automatonOfHistory parityOfHistory σ generationBound truthOfHistory
    envsOfHistory envs_bound envs_truth truthOfHistory_eq
    (by
      intro h h' htruth
      exact
        noDirectEpochStateWithAContinuationData_eq_of_components
          uniform initialBoundary orderOfHistory automatonOfHistory
          parityOfHistory
          (rawEpochState_eq_of_truth_eq h h' htruth)
          (receiptOrder_eq_of_truth_eq h h' htruth)
          (automatonOfHistory_eq_of_truth_eq h h' htruth)
          (parityOfHistory_eq_of_truth_eq h h' htruth))

