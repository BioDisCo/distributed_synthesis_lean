  StabilizedSaturationBasisNoDirectRawEpochClosureSoundness_of_pathRelevantNamedTracesEq
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory
    (by
      intro h h' hpath
      rcases generatedHistoryBounded h with ⟨envs, rfl, hlen⟩
      rcases generatedHistoryBounded h' with ⟨envs', rfl, hlen'⟩
      exact
        noDirectEpochRelevantHistoryNamedTracesEq_executionPrefixFromList_of_currentView_snoc_eq
          σ envs envs'
          (pathEquivalentDeterminesGeneratedLength_bounded
            envs envs' hlen hlen' hpath)
          (by
            intro pref pref' hprefLength hprefLe hprefSub hprefSub'
            exact
              pathEquivalentDeterminesCurrentViews
                (executionPrefixFromList σ pref)
                (executionPrefixFromList σ pref')
                (pathEquivalentDeterminesGeneratedPrefixPathEquivalent_bounded
                  envs envs' hlen hlen' hpath pref pref' hprefLength
                  hprefLe hprefSub hprefSub')))

/--
Bounded generated-prefix raw closure from local truth-vector factorization data:
generated length is decoded by a partial truth-vector decoder, generated-prefix
truth is decoded from the full generated truth-vector atom and prefix length,
and current views factor through stabilized truth-vector atoms.
-/
theorem StabilizedSaturationBasisNoDirectRawEpochClosureSoundness_of_boundedGeneratedTruthVectorFactorsFromList
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (generatedHistoryBounded :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        ∃ envs : List (EnvironmentRound In₁ In₂),
          h = executionPrefixFromList σ envs ∧
          envs.length ≤ generationBound)
    (generatedLengthOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> Option Nat)
    (generatedLength_factor :
      ∀ envs : List (EnvironmentRound In₁ In₂),
        envs.length ≤ generationBound ->
        generatedLengthOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory (executionPrefixFromList σ envs))) =
          some envs.length)
    (generatedPrefixTruthOf :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        Nat -> RegularTestTruthAtom (stabilizedSaturationBasis cert))
    (generatedPrefixTruth_factor :
      ∀ envs pref : List (EnvironmentRound In₁ In₂),
        envs.length ≤ generationBound ->
        pref.length ≤ envs.length ->
        (∃ suff, envs = pref ++ suff) ->
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory (executionPrefixFromList σ pref)) =
          generatedPrefixTruthOf
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory (executionPrefixFromList σ envs)))
            pref.length)
    (currentViewsOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        View In₁ In₂ Proc.one × View In₁ In₂ Proc.two)
    (currentViews_factor :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        (currentView Proc.one h, currentView Proc.two h) =
          currentViewsOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory h))) :
    StabilizedSaturationBasisNoDirectRawEpochClosureSoundness
      uniform initialBoundary cert pathOfHistory containmentOrder
      orderOfHistory automatonOfHistory :=
  StabilizedSaturationBasisNoDirectRawEpochClosureSoundness_of_boundedPathGeneratedPrefixEquivalentFromList
    uniform initialBoundary cert pathOfHistory containmentOrder
    orderOfHistory automatonOfHistory σ generationBound generatedHistoryBounded
    (by
      intro envs envs' hlen hlen' hpath
      have htruth :=
        stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent hpath
      have hsome : some envs.length = some envs'.length := by
        calc
          some envs.length =
              generatedLengthOfTruth
                (regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistory (executionPrefixFromList σ envs))) := by
              exact (generatedLength_factor envs hlen).symm
          _ =
              generatedLengthOfTruth
                (regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistory (executionPrefixFromList σ envs'))) := by
              exact congrArg generatedLengthOfTruth htruth
          _ = some envs'.length := by
              exact generatedLength_factor envs' hlen'
      exact Option.some.inj hsome)
    (by
      intro envs envs' hlen hlen' hpath pref pref' hprefLength hprefLe
        hprefSub hprefSub'
      have htruth :=
        stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent hpath
      have hprefLe' : pref'.length ≤ envs'.length := by
        rcases hprefSub' with ⟨suff', hsuff'⟩
        subst envs'
        simp
      apply stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq
      calc
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory (executionPrefixFromList σ pref)) =
          generatedPrefixTruthOf
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory (executionPrefixFromList σ envs)))
              pref.length := by
            exact generatedPrefixTruth_factor envs pref hlen hprefLe hprefSub
        _ =
          generatedPrefixTruthOf
              (regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory (executionPrefixFromList σ envs')))
              pref'.length := by
            rw [htruth, hprefLength]
        _ =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory (executionPrefixFromList σ pref')) := by
            exact (generatedPrefixTruth_factor envs' pref' hlen' hprefLe'
              hprefSub').symm)
    (by
      intro h h' hpath
      have htruth :=
        stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent hpath
      have hpairs :
          (currentView Proc.one h, currentView Proc.two h) =
            (currentView Proc.one h', currentView Proc.two h') := by
        calc
          (currentView Proc.one h, currentView Proc.two h) =
              currentViewsOfTruth
                (regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistory h)) := by
              exact currentViews_factor h
          _ =
              currentViewsOfTruth
                (regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistory h')) := by
              exact congrArg currentViewsOfTruth htruth
          _ = (currentView Proc.one h', currentView Proc.two h') := by
              exact (currentViews_factor h').symm
      exact ⟨congrArg Prod.fst hpairs, congrArg Prod.snd hpairs⟩)

/--
Package of local truth-vector decoders for the bounded generated-prefix branch.

The generated-length decoder is partial because it is only required to decode
truth atoms that arise from generated lists below `generationBound`.
-/
structure StabilizedSaturationBasisNoDirectBoundedGeneratedTruthVectorFactorsFromList
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat) where
  generatedLengthOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis cert) -> Option Nat
  generatedLength_factor :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      envs.length ≤ generationBound ->
      generatedLengthOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory (executionPrefixFromList σ envs))) =
        some envs.length
  generatedPrefixTruthOf :
    RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
      Nat -> RegularTestTruthAtom (stabilizedSaturationBasis cert)
  generatedPrefixTruth_factor :
    ∀ envs pref : List (EnvironmentRound In₁ In₂),
      envs.length ≤ generationBound ->
      pref.length ≤ envs.length ->
      (∃ suff, envs = pref ++ suff) ->
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory (executionPrefixFromList σ pref)) =
        generatedPrefixTruthOf
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory (executionPrefixFromList σ envs)))
          pref.length
  currentViewsOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
      View In₁ In₂ Proc.one × View In₁ In₂ Proc.two
  currentViews_factor :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      (currentView Proc.one h, currentView Proc.two h) =
        currentViewsOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h))

/--
Constructor for the bounded generated-prefix decoder package from determinacy
statements.  The actual decoder functions are chosen only on truth atoms that
come from the bounded generated family; outside that image they use harmless
fallback values.
-/
noncomputable def StabilizedSaturationBasisNoDirectBoundedGeneratedTruthVectorFactorsFromList_of_determinacy
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n)
    (pathOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (boundedGeneratedLength_determined :
      ∀ envs envs' : List (EnvironmentRound In₁ In₂),
        envs.length ≤ generationBound ->
        envs'.length ≤ generationBound ->
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory (executionPrefixFromList σ envs)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory (executionPrefixFromList σ envs')) ->
        envs.length = envs'.length)
    (boundedGeneratedPrefixTruth_determined :
      ∀ envs envs' pref pref' : List (EnvironmentRound In₁ In₂),
        envs.length ≤ generationBound ->
        envs'.length ≤ generationBound ->
        pref.length ≤ envs.length ->
        pref'.length ≤ envs'.length ->
        (∃ suff, envs = pref ++ suff) ->
        (∃ suff', envs' = pref' ++ suff') ->
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory (executionPrefixFromList σ envs)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory (executionPrefixFromList σ envs')) ->
        pref.length = pref'.length ->
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory (executionPrefixFromList σ pref)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory (executionPrefixFromList σ pref')))
    (currentViews_determined :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h') ->
        (currentView Proc.one h, currentView Proc.two h) =
          (currentView Proc.one h', currentView Proc.two h')) :
    StabilizedSaturationBasisNoDirectBoundedGeneratedTruthVectorFactorsFromList
      cert pathOfHistory σ generationBound := by
  classical
  let generatedLengthOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) -> Option Nat :=
    fun atom =>
      if h :
          ∃ envs : List (EnvironmentRound In₁ In₂),
            envs.length ≤ generationBound ∧
            regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory (executionPrefixFromList σ envs)) = atom then
        some (Classical.choose h).length
      else
        none
  let generatedPrefixTruthOf :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        Nat -> RegularTestTruthAtom (stabilizedSaturationBasis cert) :=
    fun atom k =>
      if h :
          ∃ envs : List (EnvironmentRound In₁ In₂),
            ∃ pref : List (EnvironmentRound In₁ In₂),
              envs.length ≤ generationBound ∧
              pref.length ≤ envs.length ∧
              (∃ suff, envs = pref ++ suff) ∧
              regularTestTruthVector (stabilizedSaturationBasis cert)
                  (pathOfHistory (executionPrefixFromList σ envs)) = atom ∧
              pref.length = k then
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory (executionPrefixFromList σ (Classical.choose (Classical.choose_spec h))))
      else
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistory (executionPrefixFromList σ []))
  let currentViewsOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis cert) ->
        View In₁ In₂ Proc.one × View In₁ In₂ Proc.two :=
    fun atom =>
      if h :
          ∃ hist : History In₁ In₂ Graph Out₁ Out₂,
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory hist) = atom then
        (currentView Proc.one (Classical.choose h),
          currentView Proc.two (Classical.choose h))
      else
        (currentView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂),
          currentView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂))
  refine
    { generatedLengthOfTruth := generatedLengthOfTruth
      generatedLength_factor := ?_
      generatedPrefixTruthOf := generatedPrefixTruthOf
      generatedPrefixTruth_factor := ?_
      currentViewsOfTruth := currentViewsOfTruth
      currentViews_factor := ?_ }
  · intro envs hlen
    have hwitness :
        ∃ envs' : List (EnvironmentRound In₁ In₂),
          envs'.length ≤ generationBound ∧
          regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory (executionPrefixFromList σ envs')) =
            regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistory (executionPrefixFromList σ envs)) :=
      ⟨envs, hlen, rfl⟩
    dsimp [generatedLengthOfTruth]
    rw [dif_pos hwitness]
    have hspec := Classical.choose_spec hwitness
    exact congrArg some
      (boundedGeneratedLength_determined
        (Classical.choose hwitness) envs hspec.1 hlen hspec.2)
  · intro envs pref hlen hprefLe hprefSub
    have hwitness :
        ∃ envs' : List (EnvironmentRound In₁ In₂),
          ∃ pref' : List (EnvironmentRound In₁ In₂),
            envs'.length ≤ generationBound ∧
            pref'.length ≤ envs'.length ∧
            (∃ suff, envs' = pref' ++ suff) ∧
            regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory (executionPrefixFromList σ envs')) =
              regularTestTruthVector (stabilizedSaturationBasis cert)
                (pathOfHistory (executionPrefixFromList σ envs)) ∧
            pref'.length = pref.length :=
      ⟨envs, pref, hlen, hprefLe, hprefSub, rfl, rfl⟩
    dsimp [generatedPrefixTruthOf]
    rw [dif_pos hwitness]
    let envs' := Classical.choose hwitness
    let hprefWitness := Classical.choose_spec hwitness
    let pref' := Classical.choose hprefWitness
    have hspec := Classical.choose_spec hprefWitness
    exact
      boundedGeneratedPrefixTruth_determined
        envs envs' pref pref' hlen hspec.1 hprefLe hspec.2.1
        hprefSub hspec.2.2.1 hspec.2.2.2.1.symm hspec.2.2.2.2.symm
  · intro h
    have hwitness :
        ∃ hist : History In₁ In₂ Graph Out₁ Out₂,
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory hist) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistory h) :=
      ⟨h, rfl⟩
    dsimp [currentViewsOfTruth]
    rw [dif_pos hwitness]
    exact
      (currentViews_determined (Classical.choose hwitness) h
        (Classical.choose_spec hwitness)).symm

