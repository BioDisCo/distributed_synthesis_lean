            (pathOfHistoryByRound edgeOfRound h) ->
        currentReceiptOrderData h (historyCurrentContainmentOrder h) =
          defaultReceiptOrderData) :
    StabilizedSaturationBasisCoherentAContinuationSeparation
      cert (pathOfHistoryByRound edgeOfRound) sameParityOutcomes
      containmentOrder historyCurrentContainmentOrder automatonOfHistory :=
  StabilizedSaturationBasisCoherentAContinuationSeparation_of_receiptOrderTruthFactorData
    uniform initialBoundary cert edgeOfRound containmentOrder
    historyCurrentContainmentOrder automatonOfHistory automatonState_inv
    parity_inv
    (StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData.of_currentOrderAppendDeterminesReceiptOrderAndEmptyCompatibility
      uniform initialBoundary cert edgeOfRound containmentOrder
      automatonOfHistory appendTruthDeterminesReceiptOrder
      emptyCompatibility)

/--
Current-order stabilized separation with coherent-history-only empty-prefix
compatibility.

This is the narrower Step 3 route: the mixed empty-prefix premise is required
only for coherent continuation configurations, matching the quantifier in
