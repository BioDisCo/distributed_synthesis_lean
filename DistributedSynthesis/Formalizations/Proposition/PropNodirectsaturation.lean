    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (appendTruthDeterminesReceiptOrder :
      ∀ (pref pref' : History In₁ In₂ Graph Out₁ Out₂)
        (r r' : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound (History.append pref r)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound (History.append pref' r')) ->
        currentReceiptOrderDataForAppend pref r =
          currentReceiptOrderDataForAppend pref' r')
    (emptyCompatibility :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        h ≠ [] ->
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound
              ([] : History In₁ In₂ Graph Out₁ Out₂)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) ->
        currentReceiptOrderData h (historyCurrentContainmentOrder h) =
          defaultReceiptOrderData) :
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData
      uniform initialBoundary cert edgeOfRound containmentOrder
      historyCurrentContainmentOrder automatonOfHistory :=
  StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData.of_appendDeterminesReceiptOrderAndEmptyCompatibility
    uniform initialBoundary cert edgeOfRound containmentOrder
    historyCurrentContainmentOrder automatonOfHistory
    appendTruthDeterminesReceiptOrder
    (fun pref r => historyCurrentContainmentOrder_append pref r)
    (by rfl)
    emptyCompatibility

/--
Receipt/order field invariant from non-append truth-factor data.

This is the Step 3 receipt/order handoff that does not require a global
append-decomposition hypothesis for coherent histories: the factor data already
handles the initial empty history and all nonempty histories uniformly.
-/
theorem StabilizedSaturationBasisReceiptOrderInvariant_of_receiptOrderTruthFactorData
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    {Alphabet : Type (max u v w a)}
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        Alphabet In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    {sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop}
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (receiptOrderData :
      StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData
        uniform initialBoundary cert edgeOfRound containmentOrder
        orderOfHistory automatonOfHistory) :
    StabilizedSaturationBasisReceiptOrderInvariant
      cert (pathOfHistoryByRound edgeOfRound) sameParityOutcomes
      containmentOrder orderOfHistory automatonOfHistory := by
  intro c c' heq
  have htruth :
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history) =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c'.1.history) :=
    stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent heq
  have hdata :
      currentReceiptOrderData c.1.history (orderOfHistory c.1.history) =
        currentReceiptOrderData c'.1.history (orderOfHistory c'.1.history) := by
    calc
      currentReceiptOrderData c.1.history (orderOfHistory c.1.history) =
          receiptOrderData.receiptOrderOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound c.1.history)) :=
            receiptOrderData.receiptOrder_factor c.1.history
      _ =
          receiptOrderData.receiptOrderOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis cert)
              (pathOfHistoryByRound edgeOfRound c'.1.history)) := by
            rw [htruth]
      _ = currentReceiptOrderData c'.1.history
            (orderOfHistory c'.1.history) :=
            (receiptOrderData.receiptOrder_factor c'.1.history).symm
  rcases c.2.1 with ⟨hone, htwo, horder⟩
  rcases c'.2.1 with ⟨hone', htwo', horder'⟩
  have honeData := congrArg ReceiptOrderData.receiptOne hdata
  have htwoData := congrArg ReceiptOrderData.receiptTwo hdata
  have horderData := congrArg ReceiptOrderData.containmentOrder hdata
  exact
    ⟨by
        rw [hone, hone']
        simpa [currentReceiptOrderData] using honeData,
      by
        rw [htwo, htwo']
        simpa [currentReceiptOrderData] using htwoData,
      by
        rw [horder, horder']
        simpa [currentReceiptOrderData] using horderData⟩

/--
