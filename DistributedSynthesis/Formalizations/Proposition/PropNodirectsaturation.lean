            (pathOfHistoryByRound edgeOfRound
              ([] : History In₁ In₂ Graph Out₁ Out₂)) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) ->
        currentReceiptOrderData h (historyCurrentContainmentOrder h) =
          defaultReceiptOrderData) :
    NoDirectCoherentParityProgressCertificate.{max u v w a, u, v, w, a, b}
      sameParityOutcomes containmentOrder historyCurrentContainmentOrder
      automatonOfHistory :=
  noDirectCoherentParityProgressCertificateOfStabilizedSaturationBasisSeparation
    cert (pathOfHistoryByRound edgeOfRound) sameParityOutcomes
    containmentOrder historyCurrentContainmentOrder automatonOfHistory
    (StabilizedSaturationBasisCoherentAContinuationSeparation_of_currentOrderAppendDeterminesReceiptOrderAndEmptyCompatibility
