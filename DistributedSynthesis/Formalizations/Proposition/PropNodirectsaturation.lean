      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        automatonOfHistory h = automatonOfHistory h')
    (relevantHistoryDeterminesTruthVector :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        List.Forall₂ NoDirectEpochRelevantRoundEq h h' ->
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
