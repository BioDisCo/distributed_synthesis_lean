import Mathlib.Data.Fintype.Basic

/-!
# Input-free parity tree automata

This file gives a small interface for the external regular-tree facts used by
the finite-memory part of the paper.
-/

namespace DistributedSynthesis

universe u v w

/-- Nodes of a full tree with branch alphabet `Branch`. -/
abbrev TreeNode (Branch : Type u) := List Branch

/-- A labeled tree over branch alphabet `Branch` and node-label alphabet `Alphabet`. -/
abbrev LabeledTree (Branch : Type u) (Alphabet : Type v) :=
  TreeNode Branch -> Alphabet

/--
A rational tree is represented by a finite control type and a labeling map
from control states to node labels.  The transition structure of the finite
control is abstracted away because the paper only uses the state-determined
label consequence.
-/
structure RationalTree (Alphabet : Type u) where
  Control : Type v
  controlFinite : Fintype Control
  labelOf : Control -> Alphabet

attribute [instance] RationalTree.controlFinite

/--
A rational tree with its finite transition structure exposed.

The node control is obtained by starting at `initial` and following `step`
along the branch word.  This is the controller-level object needed by the
reachable finite-memory construction: unlike `RationalTree`, it exposes the
successor map on branch choices.
-/
structure TransitionRationalTree (Branch : Type u) (Alphabet : Type v) where
  Control : Type w
  controlFinite : Fintype Control
  initial : Control
  step : Control -> Branch -> Control
  labelOf : Control -> Alphabet

attribute [instance] TransitionRationalTree.controlFinite

namespace TransitionRationalTree

/-- The finite control reached at a tree node. -/
def controlAt
    {Branch : Type u} {Alphabet : Type v}
    (tree : TransitionRationalTree.{u, v, w} Branch Alphabet)
    (node : TreeNode Branch) :
    tree.Control :=
  node.foldl tree.step tree.initial

/-- The labeled tree generated by a transition-rational tree. -/
def labeledTree
    {Branch : Type u} {Alphabet : Type v}
    (tree : TransitionRationalTree.{u, v, w} Branch Alphabet) :
    LabeledTree Branch Alphabet :=
  fun node => tree.labelOf (tree.controlAt node)

/-- Forget the transition structure, retaining the old rational-tree surface. -/
def toRationalTree
    {Branch : Type u} {Alphabet : Type v}
    (tree : TransitionRationalTree.{u, v, w} Branch Alphabet) :
    RationalTree.{v, w} Alphabet where
  Control := tree.Control
  controlFinite := tree.controlFinite
  labelOf := tree.labelOf

end TransitionRationalTree

/--
Input-free parity tree automata, with the regular-tree rationality theorem
recorded as an interface field.  This isolates the cited external theorem:
nonempty accepted tree language implies a rational accepted tree.
-/
structure InputFreeParityTreeAutomaton (Branch : Type u) (Alphabet : Type v) where
  alphabetFinite : Fintype Alphabet
  branchFinite : Fintype Branch
  State : Type w
  stateFinite : Fintype State
  acceptsTree : LabeledTree Branch Alphabet -> Prop
  acceptsRationalTree : RationalTree.{v, w} Alphabet -> Prop
  rationality :
    (∃ tree : LabeledTree Branch Alphabet, acceptsTree tree) ->
      ∃ rationalTree : RationalTree.{v, w} Alphabet, acceptsRationalTree rationalTree
  transitionRationality :
    (∃ tree : LabeledTree Branch Alphabet, acceptsTree tree) ->
      ∃ rationalTree : TransitionRationalTree.{u, v, w} Branch Alphabet,
        acceptsTree rationalTree.labeledTree

attribute [instance] InputFreeParityTreeAutomaton.alphabetFinite
attribute [instance] InputFreeParityTreeAutomaton.branchFinite
attribute [instance] InputFreeParityTreeAutomaton.stateFinite

/-- An accepted rational tree has labels determined by its finite control state. -/
def RationalAcceptedBy
    {Branch : Type u} {Alphabet : Type v}
    (A : InputFreeParityTreeAutomaton.{u, v, w} Branch Alphabet) : Prop :=
  ∃ rationalTree : RationalTree.{v, w} Alphabet, A.acceptsRationalTree rationalTree

/--
Accepted rational tree with its finite transition structure exposed.

This is the stronger form needed when the finite-memory proof must build an
actual next-state function rather than only know that labels are drawn from a
finite control set.
-/
def TransitionRationalAcceptedBy
    {Branch : Type u} {Alphabet : Type v}
    (A : InputFreeParityTreeAutomaton.{u, v, w} Branch Alphabet) : Prop :=
  ∃ rationalTree : TransitionRationalTree.{u, v, w} Branch Alphabet,
    A.acceptsTree rationalTree.labeledTree

end DistributedSynthesis
