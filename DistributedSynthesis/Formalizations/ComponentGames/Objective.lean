namespace Characterisation.ComponentGames
open DistributedSynthesis Characterisation Characterisation.PeriodicBlocks
noncomputable section
set_option maxHeartbeats 1200000

-- This is the paper's full ternary relation alphabet: different priorities
-- for the SAME pair of source/target histories are retained, not collapsed.
abbrev TransitionAlphabet (B K : Nat) := Finset (Fin (B+1) × Fin (K+1) × Fin (B+1))

def relationEdge {B K : Nat} (old : HandoverCode B K)
    (T : TransitionAlphabet B K) (_ : Unit) (next : HandoverCode B K) : Prop :=
  (old.1,next.2,next.1) ∈ T

def paperMonitor {B K : Nat} (initial : Fin (B+1)) :
    DetParityAutomaton (TransitionAlphabet B K) :=
  ((hiddenCodeContinuitySystem (handoverPriorityDPA B K)
    (initial,0) relationEdge).universalRunDPA).comap (fun T => (T,()))

theorem bounded_parity_monitor {B K : Nat} (initial : Fin (B+1))
    (word : Nat → TransitionAlphabet B K) :
    (paperMonitor initial).Accepts word ↔
      ∀ (h : Nat → Fin (B+1)) (c : Nat → Fin (K+1)), h 0 = initial →
        (∀ n, (h n,c n,h (n+1)) ∈ word n) →
        NatSeqMinEvenParity (fun n => (c n).val) := by
  rw [paperMonitor, DetParityAutomaton.comap_accepts_iff,
    hiddenCodeContinuitySystem_universalRunDPA_accepts_iff]
  constructor
  · intro all h c hi edges
    let code : Nat → HandoverCode B K := fun n =>
      (h n, if n = 0 then 0 else c (n-1))
    have succ : ∀ n, code (n+1) = (h (n+1),c n) := by
      intro n
      simp [code]
    let thread : HiddenCodeContinuityThread (initial,0) relationEdge
        (OmegaWord.map (fun T => (T,())) word) :=
      { code := code
        initial := by simp [code,hi]
        edge := by intro n; change (h n,(code (n+1)).2,(code (n+1)).1) ∈ word n
                   rw [succ]; exact edges n }
    have accepts := (handoverPriorityDPA_accepts_iff _).mp (all thread)
    simpa only [HiddenCodeContinuityThread.childCodeWord,thread,succ] using accepts
  · intro all thread
    apply (handoverPriorityDPA_accepts_iff _).mpr
    exact all (fun n => (thread.code n).1) (fun n => (thread.code (n+1)).2)
      (congrArg Prod.fst thread.initial) (thread.edge)

-- Semantic A_phi language equality for ALL execution words, not just words
-- generated by an already winning distributed strategy.
theorem A_phi_language (adversary : DetParityAutomaton Graph) (i : WithInputs.Instance)
    (word : Nat → WithInputs.TupleLetter i) :
    (WithInputs.guardedInstanceObjective adversary i).Accepts word ↔
      (¬ adversary.Accepts (fun n => (word n).1.2.2) ∨
        LTL.Satisfies (EncodedNoDirect.interp i)
          (OmegaWord.map continuationRecord word) (EncodedFiniteLTL.decode i.formula)) := by
  rw [WithInputs.guardedInstanceObjective, guardedPhysicalObjective_accepts_iff,
    DetParityAutomaton.comap_accepts_iff, EncodedNoDirectParity.accepts_iff]
  exact imp_iff_not_or

-- Computational strength for Lemma 3.7: the adversary table is an INPUT,
-- not a constant chosen before claiming primitive recursiveness.
theorem A_phi_uniform_compiler :
    Primrec EncodedGuardedObjective.compile ∧
      ∀ (d : EncodedGuardedObjective.Data)
        (alphabet : (EncodedParityTables.rows d.1).length = 3)
        (word : Nat → WithInputs.TupleLetter d.2),
        (EncodedLeaderObjective.automaton (d.2,EncodedGuardedObjective.compile d)).Accepts word ↔
          (¬ (EncodedGuardedObjective.graphAutomaton d.1 alphabet).Accepts
              (fun n => (word n).1.2.2) ∨
           LTL.Satisfies (EncodedNoDirect.interp d.2)
             (OmegaWord.map continuationRecord word) (EncodedFiniteLTL.decode d.2.formula)) := by
  refine ⟨EncodedGuardedObjective.compile_primrec, ?_⟩
  intro d alphabet word
  change (EncodedLeaderObjective.automaton (EncodedGuardedObjective.roundData d)).Accepts word ↔ _
  rw [← EncodedGuardedObjective.automaton_eq_round]
  exact (EncodedGuardedObjective.accepts_semantic_guard_iff d alphabet word).trans
    (A_phi_language _ _ word)

-- Discharge the hypothesis of the tree-rank theorem from an arbitrary
-- realizing distributed algorithm, including inadmissible graph words.
theorem realizing_strategy_all_branches
    (adversary : DetParityAutomaton Graph) (i : WithInputs.Instance)
    (σ : WithInputs.Strategies i)
    (realizes : ∀ env, adversary.Accepts (fun n => (env n).graph) →
      LTL.Satisfies (EncodedNoDirect.interp i) (execution σ env)
        (EncodedFiniteLTL.decode i.formula)) :
    ∀ word : Nat → RoundRecord (Fin (i.inputOneSizeMinusOne+1))
        (Fin (i.inputTwoSizeMinusOne+1)) Graph Unit Unit,
      NatSeqMinEvenParity (fun n => (WithInputs.guardedInstanceObjective adversary i).priority
        (strategyHistoryLabel σ
          (fun q e y => (WithInputs.guardedInstanceObjective adversary i).step q (e,y))
          (WithInputs.guardedInstanceObjective adversary i).initial (branchNode word n))) := by
  intro word
  have accepted := (WithInputs.guardedInstanceObjective_execution_iff adversary i σ
    (wordEnvironment word)).mpr (realizes (wordEnvironment word))
  simpa only [environmentWord_wordEnvironment] using
    (objective_accepts_history_iff (WithInputs.guardedInstanceObjective adversary i)
      σ (wordEnvironment word)).mp accepted

end
