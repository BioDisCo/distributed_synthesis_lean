import DistributedSynthesis.Formalizations.Theorem.ThmPairedEntryLocalHandoff

/-!
# Finite policy bank for feasible paired targets

An initial-block controller may change the closing outputs, so its paired
target need not be one of the targets generated by the original strategy at a
fixed first input pair.  The correct run-time key is instead a finite paired
state together with a proof that its input-free run language has a rational
run.  This file selects, at every such key, the rational transition policy and
all recurrent finite block controllers proved earlier.
-/

namespace DistributedSynthesis

universe u v x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A :
    DetParityAutomaton.{max u v x y, s}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂))

/-- A finite paired state from which the input-free run automaton has a
rational accepting run. -/
abbrev FeasiblePairedState :=
  {state : PairedEntryTreeState A //
    (pairedEntryRunAutomaton A state).HasRationalRun}

noncomputable instance : Fintype (FeasiblePairedState A) := by
  classical
  infer_instance

/-- Rational policy selected at a feasible paired target. -/
noncomputable def feasiblePolicy (target : FeasiblePairedState A) :
    (pairedEntryRunAutomaton A target.1).RationalTransitionPolicy :=
  Classical.choice
    (InputFreeRunParityTreeAutomaton.nonempty_rationalTransitionPolicy_of_hasRationalRun
      (pairedEntryRunAutomaton A target.1) target.2)

/-- All recurrent finite controllers selected at a feasible target. -/
noncomputable def feasibleControllerFamily
    [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
    [DecidableEq In₁] [DecidableEq In₂]
    (target : FeasiblePairedState A) :
    FinitePairedPolicyFamily A (feasiblePolicy A target) :=
  finitePairedPolicyFamily A (feasiblePolicy A target)

/-- The bank policy starts at its target, hence that target is reachable. -/
theorem feasiblePolicy_target_reachable (target : FeasiblePairedState A) :
    PairedRationalPolicy.Reachable A (feasiblePolicy A target) target.1 := by
  refine ⟨[], ?_⟩
  exact (feasiblePolicy A target).accepts.1.1

/-- A reachable process-one macro state under one feasible bank entry. -/
abbrev BankRightMacro :=
  Σ target : FeasiblePairedState A,
    {stateData : (A.State × A.State) × A.State //
      PairedRationalPolicy.Reachable A (feasiblePolicy A target)
        (Sum.inr (Sum.inl stateData))}

/-- A reachable process-two macro state under one feasible bank entry. -/
abbrev BankLeftMacro :=
  Σ target : FeasiblePairedState A,
    {stateData : (A.State × A.State) × A.State //
      PairedRationalPolicy.Reachable A (feasiblePolicy A target)
        (Sum.inr (Sum.inr stateData))}

noncomputable instance : Fintype (BankRightMacro A) := by
  classical
  infer_instance

noncomputable instance : Fintype (BankLeftMacro A) := by
  classical
  infer_instance

/-- A feasible target whose state is process-one yields the initial reachable
right macro carrier. -/
def bankRightRoot (target : FeasiblePairedState A)
    (stateData : (A.State × A.State) × A.State)
    (hshape : target.1 = Sum.inr (Sum.inl stateData)) :
    BankRightMacro A := by
  refine ⟨target, stateData, ?_⟩
  rw [← hshape]
  exact feasiblePolicy_target_reachable A target

/-- Process-two mirror. -/
def bankLeftRoot (target : FeasiblePairedState A)
    (stateData : (A.State × A.State) × A.State)
    (hshape : target.1 = Sum.inr (Sum.inr stateData)) :
    BankLeftMacro A := by
  refine ⟨target, stateData, ?_⟩
  rw [← hshape]
  exact feasiblePolicy_target_reachable A target

/-- Allowed recurrent closes preserve reachability inside the same feasible
bank entry. -/
def bankStageLeftOfAllowed
    (source : BankRightMacro A)
    (targetData : (A.State × A.State) × A.State)
    (hallowed : PairedRationalPolicy.Allowed A (feasiblePolicy A source.1)
      (Sum.inr (Sum.inl source.2.1)) (Sum.inr (Sum.inr targetData))) :
    BankLeftMacro A :=
  ⟨source.1, targetData,
    PairedRationalPolicy.reachable_of_allowed A
      (feasiblePolicy A source.1) source.2.2 hallowed⟩

/-- Mirror recurrent handoff. -/
def bankStageRightOfAllowed
    (source : BankLeftMacro A)
    (targetData : (A.State × A.State) × A.State)
    (hallowed : PairedRationalPolicy.Allowed A (feasiblePolicy A source.1)
      (Sum.inr (Sum.inr source.2.1)) (Sum.inr (Sum.inl targetData))) :
    BankRightMacro A :=
  ⟨source.1, targetData,
    PairedRationalPolicy.reachable_of_allowed A
      (feasiblePolicy A source.1) source.2.2 hallowed⟩

@[simp] theorem bankStageLeftOfAllowed_bank
    (source : BankRightMacro A)
    (targetData : (A.State × A.State) × A.State)
    (hallowed : PairedRationalPolicy.Allowed A (feasiblePolicy A source.1)
      (Sum.inr (Sum.inl source.2.1)) (Sum.inr (Sum.inr targetData))) :
    (bankStageLeftOfAllowed A source targetData hallowed).1 = source.1 := rfl

@[simp] theorem bankStageRightOfAllowed_bank
    (source : BankLeftMacro A)
    (targetData : (A.State × A.State) × A.State)
    (hallowed : PairedRationalPolicy.Allowed A (feasiblePolicy A source.1)
      (Sum.inr (Sum.inr source.2.1)) (Sum.inr (Sum.inl targetData))) :
    (bankStageRightOfAllowed A source targetData hallowed).1 = source.1 := rfl

end DetParityAutomaton

end DistributedSynthesis
