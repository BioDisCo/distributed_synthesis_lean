/--
The locally observable round-aware certificate instantiates the generic finite
strategy abstraction interface.
-/
noncomputable def toDPAFiniteStrategyAbstraction
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert : RoundAwareLocalEpochGameAbstractionCertificate.{u, v, w, a} A) :
    DPAFiniteStrategyAbstraction.{u, v, w, a, max u v w a} Out₂ A := by
  classical
  let controllerFinite :=
    Classical.choice
      (cert.transformer.roundAwareLocalControllerCode_fintype
        cert.viewOne cert.viewTwo)
  let environmentFinite := Classical.choice cert.transformer.environmentCode_fintype
  exact
    {
      ControllerCode :=
        cert.transformer.RoundAwareLocalControllerCode cert.viewOne cert.viewTwo
      EnvironmentCode := cert.transformer.EnvironmentCode
      controllerFinite := controllerFinite
      environmentFinite := environmentFinite
      wins := fun controller environment =>
        cert.transformer.roundAwareGameWins
          cert.initialBoundary controller.1 environment
      winsDecidable := cert.winsDecidable
      controllerStrategy := cert.controllerStrategy
      dynamicHierarchy := cert.dynamicHierarchy
      parityObjective := cert.parityObjective
      dynamicHierarchy_proof := cert.dynamicHierarchy_proof
      parityObjective_proof := cert.parityObjective_proof
      sound := cert.sound
      complete := cert.complete
    }

/-- The locally observable round-aware certificate yields a finite-game compilation. -/
