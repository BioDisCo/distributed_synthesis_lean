exposed: coherent decoded state streams for soundness and controller
simulation for completeness.
-/
noncomputable def toDPAToFiniteGameCompilationOfCoherentStateStreamsAndControllerSimulation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
