/--
Finite-summary state witnesses for the actual local views reached by a
strategy.  This is the lambda-side replacement for requiring a finite state to
decode the full recursive view.
-/
def RoundAwareLambdaControllerActualFiniteViewStateWitnesses
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) : Prop :=
  ∀ env : EnvironmentSequence In₁ In₂,
    ∀ n : Nat,
      (∃ stateOne : GameState T,
        historyOne stateOne (env n) =
            historyOfViewOne
              (nextView Proc.one (executionPrefix σ env n) (env n)) ∧
          fringeOne stateOne (env n) =
            fringeOfViewOne
              (nextView Proc.one (executionPrefix σ env n) (env n))) ∧
      (∃ stateTwo : GameState T,
        historyTwo stateTwo (env n) =
            historyOfViewTwo
              (nextView Proc.two (executionPrefix σ env n) (env n)) ∧
          fringeTwo stateTwo (env n) =
            fringeOfViewTwo
              (nextView Proc.two (executionPrefix σ env n) (env n)))

/--
Pointwise compatibility stated in finite-lambda terms.  The word is generated
from finite state witnesses whose summaries/fringe arguments match the real
local views, rather than from states decoding those full views.
-/
def RoundAwareLambdaControllerCompatibleExecution
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)) : Prop :=
  ∀ n : Nat,
    ∃ stateOne : GameState T,
      historyOne stateOne (env n) =
          historyOfViewOne
            (nextView Proc.one (executionPrefix σ env n) (env n)) ∧
        fringeOne stateOne (env n) =
          fringeOfViewOne
            (nextView Proc.one (executionPrefix σ env n) (env n)) ∧
        ∃ stateTwo : GameState T,
          historyTwo stateTwo (env n) =
              historyOfViewTwo
                (nextView Proc.two (executionPrefix σ env n) (env n)) ∧
            fringeTwo stateTwo (env n) =
              fringeOfViewTwo
                (nextView Proc.two (executionPrefix σ env n) (env n)) ∧
            word n =
              {
                inputOne := (env n).inputOne
                inputTwo := (env n).inputTwo
                graph := (env n).graph
                outputOne := (controller.1 stateOne (env n)).1
                outputTwo := (controller.1 stateTwo (env n)).2
              }

theorem roundAwareLambdaControllerCompatibleExecution_of_actualFiniteViewStateWitnesses
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
