    dynamicHierarchy_proof parityObjective_proof
    coherentStateStreams
    (FiniteEpochTransformer.gameExecutionControllerSimulation_of_stateViewDecoders
      transformer initialBoundary viewOne viewTwo stateViewDecoders)

/--
Build the journal/rational-run backend certificate from synchronized decoded
state choices and a controller-simulation completeness proof.

This is the paper-facing version of
`EpochGameAbstractionCertificate.ofTransformerWithSynchronizedStateChoicesAndControllerSimulation`:
the rational-run fields remain visible, while the decoded soundness and
finite-game completeness fields are derived internally.
-/
noncomputable def ofSynchronizedStateChoicesAndControllerSimulation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (Branch : Proc -> Type b)
    (Label : Proc -> Type x)
    (target :
      (d : Proc) -> InputFreeParityTreeAutomaton.{b, x, y} (Branch d) (Label d))
    (targetNonempty :
      ∀ d : Proc,
        ∃ tree : LabeledTree (Branch d) (Label d),
          (target d).acceptsTree tree)
    (transformer :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (FiniteEpochTransformer.GameState transformer)]
    (initialBoundary : transformer.boundary)
    (automaton_equiv :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        transformer.automaton.Accepts word ↔ A.Accepts word)
    (dynamicHierarchy parityObjective : Prop)
    (dynamicHierarchy_proof : dynamicHierarchy)
    (parityObjective_proof : parityObjective)
    (synchronizedChoices :
      ∀ controller : transformer.ControllerCode,
        ∀ (env : EnvironmentSequence In₁ In₂)
          (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
            FiniteEpochTransformer.CompatibleDecodedExecution
              transformer initialBoundary controller env word ->
              ∃ stateStream : Nat -> FiniteEpochTransformer.GameState transformer,
                FiniteEpochTransformer.CompatibleDecodedExecutionSynchronizedStateChoices
                  transformer initialBoundary controller env word stateStream)
    (simulationBoundary :
      ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∃ controller : transformer.ControllerCode,
          FiniteEpochTransformer.GameExecutionControllerSimulatesStrategy
            transformer initialBoundary controller σ) :
    RotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y} A where
  Branch := Branch
  Label := Label
  target := target
  targetNonempty := targetNonempty
  transformer := transformer
  gameStateDecidable := inferInstance
  initialBoundary := initialBoundary
  automaton_equiv := automaton_equiv
  dynamicHierarchy := dynamicHierarchy
  parityObjective := parityObjective
  dynamicHierarchy_proof := dynamicHierarchy_proof
  parityObjective_proof := parityObjective_proof
  soundBoundary := by
    intro controller hwins
    exact
      FiniteEpochTransformer.compatibleDecodedControllerSound_of_gameWins_and_synchronizedStateChoices
        transformer initialBoundary controller A automaton_equiv hwins
        (synchronizedChoices controller)
  completeBoundary :=
    FiniteEpochTransformer.gameExecutionControllerComplete_of_controllerSimulation
      transformer initialBoundary A simulationBoundary

/--
Build the journal/rational-run backend certificate from synchronized decoded
state choices and matching finite controllers.

This is the most operational current finite-game target: no caller has to
weaken synchronized choices to coherent streams, and controller simulation is
derived from pointwise matching against distributed strategies.
-/
noncomputable def ofSynchronizedStateChoicesAndMatchingControllers
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (Branch : Proc -> Type b)
    (Label : Proc -> Type x)
    (target :
      (d : Proc) -> InputFreeParityTreeAutomaton.{b, x, y} (Branch d) (Label d))
    (targetNonempty :
      ∀ d : Proc,
        ∃ tree : LabeledTree (Branch d) (Label d),
          (target d).acceptsTree tree)
    (transformer :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (FiniteEpochTransformer.GameState transformer)]
    (initialBoundary : transformer.boundary)
    (automaton_equiv :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        transformer.automaton.Accepts word ↔ A.Accepts word)
    (dynamicHierarchy parityObjective : Prop)
    (dynamicHierarchy_proof : dynamicHierarchy)
    (parityObjective_proof : parityObjective)
    (synchronizedChoices :
      ∀ controller : transformer.ControllerCode,
        ∀ (env : EnvironmentSequence In₁ In₂)
          (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
            FiniteEpochTransformer.CompatibleDecodedExecution
              transformer initialBoundary controller env word ->
              ∃ stateStream : Nat -> FiniteEpochTransformer.GameState transformer,
                FiniteEpochTransformer.CompatibleDecodedExecutionSynchronizedStateChoices
                  transformer initialBoundary controller env word stateStream)
    (matchingControllers :
      FiniteEpochTransformer.GameExecutionStrategiesHaveMatchingControllers
        transformer initialBoundary) :
    RotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y} A :=
  ofSynchronizedStateChoicesAndControllerSimulation
    A Branch Label target targetNonempty
    transformer initialBoundary automaton_equiv
    dynamicHierarchy parityObjective
    dynamicHierarchy_proof parityObjective_proof
    synchronizedChoices
    (FiniteEpochTransformer.gameExecutionControllerSimulation_of_matchingControllers
      transformer initialBoundary matchingControllers)

/-- The journal/rational-run backend certificate yields the epoch abstraction certificate. -/
noncomputable def toEpochGameAbstractionCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert :
      RotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y} A) :
    EpochGameAbstractionCertificate.{u, v, w, a} A := by
  classical
  letI : DecidableEq (FiniteEpochTransformer.GameState cert.transformer) :=
    cert.gameStateDecidable
  exact
    EpochGameAbstractionCertificate.ofTransformerWithDecodedBoundaries
      A cert.transformer cert.initialBoundary cert.automaton_equiv
      cert.dynamicHierarchy cert.parityObjective
      cert.dynamicHierarchy_proof cert.parityObjective_proof
      cert.soundBoundary cert.completeBoundary

end RotatingRationalRunEpochBackendCertificate

/-- The finite game induced by a concrete finite strategy abstraction. -/
def DPAFiniteStrategyAbstraction.toFiniteGame
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (abstraction : DPAFiniteStrategyAbstraction.{u, v, w, a, b} Out₂ A) :
    FiniteDynamicHierarchyParityGame.{b, max u v w a} where
  ControllerStrategy := abstraction.ControllerCode
  EnvironmentStrategy := abstraction.EnvironmentCode
  controllerFinite := abstraction.controllerFinite
  environmentFinite := abstraction.environmentFinite
  wins := abstraction.wins
  winsDecidable := abstraction.winsDecidable
  dynamicHierarchy := abstraction.dynamicHierarchy
  parityObjective := abstraction.parityObjective
  dynamicHierarchy_proof := abstraction.dynamicHierarchy_proof
  parityObjective_proof := abstraction.parityObjective_proof

/--
A concrete finite strategy abstraction is exactly enough to compile the DPA
objective to the finite dynamic-hierarchy parity game interface.
-/
def DPAFiniteStrategyAbstraction.toDPAToFiniteGameCompilation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (abstraction : DPAFiniteStrategyAbstraction.{u, v, w, a, b} Out₂ A) :
    DPAToFiniteGameCompilation.{u, v, w, a, b} Out₂ A where
  finiteGame := abstraction.toFiniteGame
  realizabilityEquivalent := by
    constructor
    · intro h
      rcases h with ⟨controller, hwins⟩
      exact
        ⟨abstraction.controllerStrategy controller,
          abstraction.sound controller hwins⟩
    · intro h
      rcases h with ⟨σ, hσ⟩
      rcases abstraction.complete σ hσ with ⟨controller, hwins⟩
      exact ⟨controller, hwins⟩

/--
Build a finite strategy abstraction from an arbitrary finite carrier `Q`.

This is the compiler-level form of the enriched product-observer route.  The
finite environment strategies are memoryless `Q -> Move` codes, the finite
outcome is the DPA acceptance of the induced carrier play, and decidability of
that outcome is supplied by the generic combined `Q`/DPA loop certificate.

The two semantic inputs are exactly the theorem-facing obligations left for the
concrete Bérard instantiation:

* rejected real executions of a finite controller reflect to rejected finite
  `Q` codes;
* every realizable strategy is represented by some finite controller that wins
  against all finite `Q` codes.
-/
noncomputable def DPAFiniteStrategyAbstraction.ofFiniteCarrierCounterexampleReflection
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (ControllerCode : Type b)
    (Q Move : Type (max u v w a))
    [Fintype ControllerCode]
    [Fintype Q]
    [DecidableEq Q]
    [Fintype Move]
    (initial : ControllerCode -> Q)
    (step : ControllerCode -> Q -> Move -> Q)
    (emit :
      ControllerCode -> Q -> Move ->
        RoundRecord In₁ In₂ Graph Out₁ Out₂)
    (controllerStrategy :
      ControllerCode -> StrategyPair In₁ In₂ Out₁ Out₂)
    (dynamicHierarchy parityObjective : Prop)
    (dynamicHierarchy_proof : dynamicHierarchy)
    (parityObjective_proof : parityObjective)
    (counterexampleReflection :
      ∀ controller : ControllerCode,
        ∀ env : EnvironmentSequence In₁ In₂,
          ¬ A.Accepts (execution (controllerStrategy controller) env) ->
            ∃ code : Q -> Move,
              ¬ A.Accepts
                (FiniteEpochTransformer.finiteCarrierPlayWord
                  (initial controller) (step controller)
                  (emit controller) code))
    (complete :
      ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        (∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution σ env)) ->
          ∃ controller : ControllerCode,
            ∀ code : Q -> Move,
              A.Accepts
                (FiniteEpochTransformer.finiteCarrierPlayWord
                  (initial controller) (step controller)
                  (emit controller) code)) :
    DPAFiniteStrategyAbstraction.{u, v, w, a, b}
      Out₂ A where
  ControllerCode := ControllerCode
  EnvironmentCode := Q -> Move
  controllerFinite := inferInstance
  environmentFinite := inferInstance
  wins := fun controller code =>
    A.Accepts
      (FiniteEpochTransformer.finiteCarrierPlayWord
        (initial controller) (step controller) (emit controller) code)
  winsDecidable := fun controller code =>
    FiniteEpochTransformer.finiteCarrierAcceptsDecidableByStateLoop
      (initial controller) (step controller) (emit controller) A code
  controllerStrategy := controllerStrategy
  dynamicHierarchy := dynamicHierarchy
  parityObjective := parityObjective
  dynamicHierarchy_proof := dynamicHierarchy_proof
  parityObjective_proof := parityObjective_proof
  sound := by
    intro controller hwins env
    by_contra hreject
    rcases counterexampleReflection controller env hreject with
      ⟨code, hbad⟩
    exact hbad (hwins code)
  complete := by
    intro σ hσ
    rcases complete σ hσ with ⟨controller, hwins⟩
    exact ⟨controller, hwins⟩

/--
High-universe finite carriers can be consumed by the same finite-game backend
after encoding their finite state space as `Fin (Fintype.card Q)`.

This removes the artificial universe restriction from the semantic carrier
obligations: the concrete proof may build any finite product carrier `Q`, while
the exported game still uses low-universe environment codes.
-/
noncomputable def DPAFiniteStrategyAbstraction.ofFiniteCarrierCounterexampleReflectionHighCarrier
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (ControllerCode : Type b)
    (Q : Type x)
    (Move : Type (max u v w a))
    [Fintype ControllerCode]
    [Fintype Q]
    [Fintype Move]
    (initial : ControllerCode -> Q)
    (step : ControllerCode -> Q -> Move -> Q)
    (emit :
      ControllerCode -> Q -> Move ->
        RoundRecord In₁ In₂ Graph Out₁ Out₂)
    (controllerStrategy :
      ControllerCode -> StrategyPair In₁ In₂ Out₁ Out₂)
    (dynamicHierarchy parityObjective : Prop)
    (dynamicHierarchy_proof : dynamicHierarchy)
    (parityObjective_proof : parityObjective)
    (counterexampleReflection :
      ∀ controller : ControllerCode,
        ∀ env : EnvironmentSequence In₁ In₂,
          ¬ A.Accepts (execution (controllerStrategy controller) env) ->
            ∃ code : Q -> Move,
              ¬ A.Accepts
                (FiniteEpochTransformer.finiteCarrierPlayWord
                  (initial controller) (step controller)
                  (emit controller) code))
    (complete :
      ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        (∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution σ env)) ->
          ∃ controller : ControllerCode,
            ∀ code : Q -> Move,
              A.Accepts
                (FiniteEpochTransformer.finiteCarrierPlayWord
                  (initial controller) (step controller)
                  (emit controller) code)) :
    DPAFiniteStrategyAbstraction.{u, v, w, a, b}
      Out₂ A := by
  classical
  let Qenc : Type (max u v w a) :=
    ULift.{max u v w a, 0} (Fin (Fintype.card Q))
  let encFin : Q ≃ Fin (Fintype.card Q) := Fintype.equivFin Q
  let enc : Q ≃ Qenc :=
    { toFun := fun q => ULift.up (encFin q)
      invFun := fun q => encFin.symm q.down
      left_inv := by
        intro q
        simp
      right_inv := by
        intro q
        cases q
        simp }
  let initialEnc : ControllerCode -> Qenc :=
    fun controller => enc (initial controller)
  let stepEnc : ControllerCode -> Qenc -> Move -> Qenc :=
    fun controller q move => enc (step controller (enc.symm q) move)
  let emitEnc :
      ControllerCode -> Qenc -> Move ->
        RoundRecord In₁ In₂ Graph Out₁ Out₂ :=
    fun controller q move => emit controller (enc.symm q) move
  refine
    DPAFiniteStrategyAbstraction.ofFiniteCarrierCounterexampleReflection
      ControllerCode Qenc Move
      initialEnc stepEnc emitEnc controllerStrategy
      dynamicHierarchy parityObjective
      dynamicHierarchy_proof parityObjective_proof ?_ ?_
  · intro controller env hreject
    rcases counterexampleReflection controller env hreject with
      ⟨code, hbad⟩
    refine ⟨fun q => code (enc.symm q), ?_⟩
    have hword :
        FiniteEpochTransformer.finiteCarrierPlayWord
            (initialEnc controller) (stepEnc controller)
            (emitEnc controller) (fun q => code (enc.symm q)) =
          FiniteEpochTransformer.finiteCarrierPlayWord
            (initial controller) (step controller)
            (emit controller) code := by
      simpa [initialEnc, stepEnc, emitEnc] using
        (FiniteEpochTransformer.finiteCarrierPlayWord_encode
          enc (initial controller) (step controller)
          (emit controller) (fun q => code (enc.symm q)))
    exact fun haccept => hbad (by simpa [hword] using haccept)
  · intro σ hσ
    rcases complete σ hσ with ⟨controller, hwins⟩
    refine ⟨controller, ?_⟩
    intro codeEnc
    let code : Q -> Move := fun q => codeEnc (enc q)
    have hword :
        FiniteEpochTransformer.finiteCarrierPlayWord
            (initialEnc controller) (stepEnc controller)
            (emitEnc controller) codeEnc =
          FiniteEpochTransformer.finiteCarrierPlayWord
            (initial controller) (step controller)
            (emit controller) code := by
      simpa [initialEnc, stepEnc, emitEnc, code] using
        (FiniteEpochTransformer.finiteCarrierPlayWord_encode
          enc (initial controller) (step controller)
          (emit controller) codeEnc)
    exact by
      simpa [hword] using hwins code

