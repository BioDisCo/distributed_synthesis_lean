/--
Actual-execution lambda choices from the concrete no-direct epoch stream.

This is the operational handoff needed by the no-direct `\lambda` proof: once
the concrete stream is deterministic enough to choose the next environment
move, decodes the two local current views, and the finite controller agrees
with the decoded strategy outputs, it is already a synchronized lambda-choice
stream for the actual execution.
-/
theorem noDirectEpochStateStream_actualLambdaChoices_of_controller_matches
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (viewOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.one)
    (viewTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.two)
    (controller :
      RoundAwareLocalControllerCode
        uniform.noDirectEpochTransformer viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (hconsistent :
      ∀ i j : Nat,
        uniform.noDirectEpochStateStream initialBoundary σ env i =
          uniform.noDirectEpochStateStream initialBoundary σ env j ->
        env i = env j)
    (hviews :
      ∀ n : Nat,
        viewOne
            (uniform.noDirectEpochStateStream initialBoundary σ env n)
            (env n) =
          nextView Proc.one (executionPrefix σ env n) (env n) ∧
        viewTwo
            (uniform.noDirectEpochStateStream initialBoundary σ env n)
            (env n) =
          nextView Proc.two (executionPrefix σ env n) (env n))
    (hmatch :
      ∀ n : Nat,
        controller.1
            (uniform.noDirectEpochStateStream initialBoundary σ env n)
            (env n) =
          (σ.one (nextView Proc.one (executionPrefix σ env n) (env n)),
            σ.two (nextView Proc.two (executionPrefix σ env n) (env n)))) :
    RoundAwareLocalControllerCompatibleDecodedExecutionLambdaChoices
      uniform.noDirectEpochTransformer initialBoundary viewOne viewTwo
      controller σ env (execution σ env)
      (uniform.noDirectEpochStateStream initialBoundary σ env) := by
  constructor
  · rfl
  constructor
  · exact
      noDirectEpochStateStream_succ_eq_roundAwareGameTransition_of_controller_matches
        uniform initialBoundary controller.1 σ env hmatch
  constructor
  · exact hconsistent
  · intro n
    rcases hviews n with ⟨hviewOne, hviewTwo⟩
    refine ⟨hviewOne, hviewTwo, ?_⟩
    rw [execution_apply]
    have hm := hmatch n
    cases henv : env n with
    | mk inputOne inputTwo graph =>
        simp [henv] at hm
        simp [nextRound, henv, hm]

