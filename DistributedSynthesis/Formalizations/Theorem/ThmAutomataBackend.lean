/--
Rejected finite-carrier progress streams have a recurrent carrier state carrying
the odd least recurring priority, and after a finite cutoff no lower decoded DPA
priority appears.
-/
theorem exists_recurrent_finiteCarrierState_min_priority_not_even_and_eventually_ge_of_not_accepts
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (stateStream : Nat -> Q)
    (moveStream : Nat -> Move)
    (dpaOf : Q -> A.State)
    [Fintype Q]
    (hdpaRun :
      ∀ n : Nat,
        dpaOf (stateStream n) =
          A.run (finiteCarrierWord emit stateStream moveStream) n)
    (hreject :
      ¬ A.Accepts (finiteCarrierWord emit stateStream moveStream)) :
    ∃ p : Nat,
      ∃ state : Q,
        ∃ N : Nat,
          A.priority (dpaOf state) = p ∧
            (∀ n : Nat, ∃ k : Nat, n ≤ k ∧ stateStream k = state) ∧
              (∀ k : Nat, N ≤ k -> p ≤ A.priority (dpaOf (stateStream k))) ∧
                ¬ DetParityAutomaton.NatEven p := by
  rcases
      exists_recurrent_finiteCarrierState_min_priority_not_even_of_not_accepts
        emit A stateStream moveStream dpaOf hdpaRun hreject with
    ⟨p, state, hstatePriority, hstateSeen, hpMin, hpOdd⟩
  rcases
      A.exists_eventually_priority_ge_of_min_prioritySeenInfinitelyOften
        (finiteCarrierWord emit stateStream moveStream) hpMin with
    ⟨N, hN⟩
  refine ⟨p, state, N, hstatePriority, hstateSeen, ?_, hpOdd⟩
  intro k hk
  have hNk := hN k hk
  simpa [hdpaRun k] using hNk

