        stateAt envAt start period
        hprefixSimple hcycleSimple hprefixCycleDisjoint)
  have hdpaStep :
      ∀ n : Nat,
        dpaOf (selectedLassoStateStream stateAt start period (n + 1)) =
          A.step
            (dpaOf (selectedLassoStateStream stateAt start period n))
            (roundAwareWordOfStateStream T controller
              (selectedLassoStateStream stateAt start period)
              (selectedLassoEnvironment envAt start period) n) :=
    selectedLasso_dpaStep_of_bounded_nextIndex_dpaStep
      T controller A stateAt envAt dpaOf start period hperiodPositive
      hdpaStepBounded
  have hwitnessPriorityStream :
      A.priority
          (dpaOf
            (selectedLassoStateStream stateAt start period
              (start + witness))) = p := by
    simpa [selectedLassoStateStream,
      selectedLassoIndex_cycle start period witness hwitnessLt] using
      hwitnessPriority
  have hcycleLowerStream :
      ∀ i : Nat,
        i < period ->
          p ≤
            A.priority
              (dpaOf
                (selectedLassoStateStream stateAt start period
                  (start + i))) := by
    intro i hi
    simpa [selectedLassoStateStream,
      selectedLassoIndex_cycle start period i hi] using hcycleLower i hi
  exact
    exists_environmentCode_rejected_roundAwareGameExecution_of_consistent_looping_stateStream_of_dpaProgress_cycleWitness_lowerBound
      T initialBoundary controller A
      (selectedLassoStateStream stateAt start period)
      (selectedLassoEnvironment envAt start period)
      dpaOf
      (by simpa [selectedLassoStateStream] using hdpaInit)
      hdpaStep
      (by simpa [selectedLassoStateStream] using hinit)
      hstep hconsistent start period hperiodPositive
      (selectedLassoStateStream_loop_shift stateAt start period hperiodPositive)
      (selectedLassoEnvironment_loop_shift envAt start period hperiodPositive)
      witness hwitnessLt
      hwitnessPriorityStream hcycleLowerStream hpOdd

/--
Selected finite-lasso data for the enriched-observer proof.

The branch provenance is supplied by the extractor theorem that produces this
record from a rejected compatible word.  The record itself contains the
loop-erased prefix, simple rotated cycle, priority witness, and bounded
transition/DPA-progress laws for the selected edges.
-/
structure RoundAwareSelectedLassoCycleWitnessData
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (dpaOf : GameState T -> A.State) where
  stateAt : Nat -> GameState T
  envAt : EnvironmentSequence In₁ In₂
  start : Nat
  period : Nat
  witness : Nat
  p : Nat
  periodPositive : 0 < period
  init : stateAt 0 = Sum.inl initialBoundary
  stepBounded :
    ∀ k : Nat,
      k < start + period ->
        stateAt (selectedLassoNextIndex start period k) =
          roundAwareGameTransition T controller (stateAt k) (envAt k)
  prefixSimple :
    ∀ i j : Nat,
      i < start ->
      j < start ->
      stateAt i = stateAt j ->
      i = j
  cycleSimple :
    ∀ i j : Nat,
      i < period ->
      j < period ->
      stateAt (start + i) = stateAt (start + j) ->
      i = j
  prefixCycleDisjoint :
    ∀ i j : Nat,
      i < start ->
      j < period ->
      stateAt i ≠ stateAt (start + j)
  dpaInit : dpaOf (stateAt 0) = A.initial
  dpaStepBounded :
    ∀ k : Nat,
      k < start + period ->
        dpaOf (stateAt (selectedLassoNextIndex start period k)) =
          A.step (dpaOf (stateAt k))
            {
              inputOne := (envAt k).inputOne
              inputTwo := (envAt k).inputTwo
              graph := (envAt k).graph
              outputOne := (controller (stateAt k) (envAt k)).1
              outputTwo := (controller (stateAt k) (envAt k)).2
            }
  witnessLt : witness < period
  witnessPriority : A.priority (dpaOf (stateAt (start + witness))) = p
  cycleLower :
    ∀ i : Nat,
      i < period ->
      p ≤ A.priority (dpaOf (stateAt (start + i)))
  odd : ¬ DetParityAutomaton.NatEven p

/--
Pure loop-erasure output for one recurrent return.

The recurrent-return theorem supplies two source indices where the same
recurrent enriched state appears after the no-lower-priority cutoff.  This
record is the remaining combinatorial output expected from loop erasure: a
selected prefix/cycle, source-edge witnesses for its retained labelled edges,
simple/disjoint shape, and the fact that the selected cycle still contains the
recurrent return state.  The lower and upper return-index bounds are provenance
checks saying the selected cycle edges really come from the finite return
segment; only the lower bound is needed later for priority transfer.  The record
intentionally does not mention DPA priorities; those are inherited later from
the recurrent-return facts.
-/
structure RoundAwareLoopErasedRecurrentReturnLassoWitness
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (sourceState : Nat -> GameState T)
    (sourceEnv : EnvironmentSequence In₁ In₂)
    (recurrentState : GameState T)
    (returnStart returnStop : Nat) where
  stateAt : Nat -> GameState T
  envAt : EnvironmentSequence In₁ In₂
  edgeTime : Nat -> Nat
  start : Nat
  period : Nat
  witness : Nat
  periodPositive : 0 < period
  selectedInit : stateAt 0 = sourceState 0
  selectedSource :
    ∀ k : Nat,
      k < start + period ->
        stateAt k = sourceState (edgeTime k)
  selectedEnv :
    ∀ k : Nat,
      k < start + period ->
        envAt k = sourceEnv (edgeTime k)
  selectedTarget :
    ∀ k : Nat,
      k < start + period ->
        stateAt (selectedLassoNextIndex start period k) =
          sourceState (edgeTime k + 1)
  prefixSimple :
    ∀ i j : Nat,
      i < start ->
      j < start ->
      stateAt i = stateAt j ->
      i = j
  cycleSimple :
    ∀ i j : Nat,
      i < period ->
      j < period ->
      stateAt (start + i) = stateAt (start + j) ->
      i = j
  prefixCycleDisjoint :
    ∀ i j : Nat,
      i < start ->
      j < period ->
      stateAt i ≠ stateAt (start + j)
  witnessLt : witness < period
  witnessState :
    sourceState (edgeTime (start + witness)) = recurrentState
  cycleEdgeAfterReturnStart :
    ∀ i : Nat,
      i < period ->
        returnStart ≤ edgeTime (start + i)
  cycleEdgeBeforeReturnStop :
    ∀ i : Nat,
      i < period ->
        edgeTime (start + i) + 1 ≤ returnStop

/--
Selected source-edge times are enough to build the pure loop-erasure witness.

This is the general retained-edge target for loop erasure.  Unlike the stronger
selected-index form below, the next selected state only has to equal the target
of the retained source edge as a state; its own outgoing edge may come from a
later occurrence of that same state.
-/
theorem exists_loopErasedRecurrentReturnLassoWitness_of_selectedEdgeTimes
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (sourceState : Nat -> GameState T)
    (sourceEnv : EnvironmentSequence In₁ In₂)
    (recurrentState : GameState T)
    {returnStart returnStop : Nat}
    (edgeTime : Nat -> Nat)
    (start period witness : Nat)
    (hperiodPositive : 0 < period)
    (hselectedInit : sourceState (edgeTime 0) = sourceState 0)
    (hselectedTarget :
      ∀ k : Nat,
        k < start + period ->
          sourceState (edgeTime (selectedLassoNextIndex start period k)) =
            sourceState (edgeTime k + 1))
    (hprefixSimple :
      ∀ i j : Nat,
        i < start ->
        j < start ->
        sourceState (edgeTime i) = sourceState (edgeTime j) ->
          i = j)
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        sourceState (edgeTime (start + i)) =
          sourceState (edgeTime (start + j)) ->
          i = j)
    (hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < start ->
        j < period ->
          sourceState (edgeTime i) ≠
            sourceState (edgeTime (start + j)))
    (hwitnessLt : witness < period)
    (hwitnessState :
      sourceState (edgeTime (start + witness)) = recurrentState)
    (hcycleEdgeAfterReturnStart :
      ∀ i : Nat,
        i < period ->
          returnStart ≤ edgeTime (start + i))
    (hcycleEdgeBeforeReturnStop :
      ∀ i : Nat,
        i < period ->
          edgeTime (start + i) + 1 ≤ returnStop) :
    Nonempty
      (RoundAwareLoopErasedRecurrentReturnLassoWitness
        T sourceState sourceEnv recurrentState returnStart returnStop) := by
  refine
    ⟨{
      stateAt := fun n => sourceState (edgeTime n)
      envAt := fun n => sourceEnv (edgeTime n)
      edgeTime := edgeTime
      start := start
      period := period
      witness := witness
      periodPositive := hperiodPositive
      selectedInit := hselectedInit
      selectedSource := ?_
      selectedEnv := ?_
      selectedTarget := hselectedTarget
      prefixSimple := hprefixSimple
      cycleSimple := hcycleSimple
      prefixCycleDisjoint := hprefixCycleDisjoint
      witnessLt := hwitnessLt
      witnessState := hwitnessState
      cycleEdgeAfterReturnStart := hcycleEdgeAfterReturnStart
      cycleEdgeBeforeReturnStop := hcycleEdgeBeforeReturnStop
    }⟩
  · intro k _hk
    rfl
  · intro k _hk
    rfl

/--
Selected source indices are enough to build the pure loop-erasure witness.

This is the convenient target for the eventual finite-walk loop-erasure
algorithm: it only has to output which source edge each selected lasso edge
uses.  The selected states, labels, and edge-target equations are then obtained
by composing with the source stream.
-/
theorem exists_loopErasedRecurrentReturnLassoWitness_of_selectedSourceIndices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (sourceState : Nat -> GameState T)
    (sourceEnv : EnvironmentSequence In₁ In₂)
    (recurrentState : GameState T)
    {returnStart returnStop : Nat}
    (selectedIndex : Nat -> Nat)
    (start period witness : Nat)
    (hperiodPositive : 0 < period)
    (hselectedZero : selectedIndex 0 = 0)
    (hselectedNext :
      ∀ k : Nat,
        k < start + period ->
          selectedIndex (selectedLassoNextIndex start period k) =
            selectedIndex k + 1)
    (hprefixSimple :
      ∀ i j : Nat,
        i < start ->
        j < start ->
        sourceState (selectedIndex i) =
          sourceState (selectedIndex j) ->
          i = j)
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        sourceState (selectedIndex (start + i)) =
          sourceState (selectedIndex (start + j)) ->
          i = j)
    (hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < start ->
        j < period ->
          sourceState (selectedIndex i) ≠
            sourceState (selectedIndex (start + j)))
    (hwitnessLt : witness < period)
    (hwitnessState :
      sourceState (selectedIndex (start + witness)) = recurrentState)
    (hcycleEdgeAfterReturnStart :
      ∀ i : Nat,
        i < period ->
          returnStart ≤ selectedIndex (start + i))
    (hcycleEdgeBeforeReturnStop :
      ∀ i : Nat,
        i < period ->
          selectedIndex (start + i) + 1 ≤ returnStop) :
    Nonempty
      (RoundAwareLoopErasedRecurrentReturnLassoWitness
        T sourceState sourceEnv recurrentState returnStart returnStop) := by
  refine
    ⟨{
      stateAt := fun n => sourceState (selectedIndex n)
      envAt := fun n => sourceEnv (selectedIndex n)
      edgeTime := selectedIndex
      start := start
      period := period
      witness := witness
      periodPositive := hperiodPositive
      selectedInit := ?_
      selectedSource := ?_
      selectedEnv := ?_
      selectedTarget := ?_
      prefixSimple := hprefixSimple
      cycleSimple := hcycleSimple
      prefixCycleDisjoint := hprefixCycleDisjoint
      witnessLt := hwitnessLt
      witnessState := hwitnessState
      cycleEdgeAfterReturnStart := hcycleEdgeAfterReturnStart
      cycleEdgeBeforeReturnStop := hcycleEdgeBeforeReturnStop
    }⟩
  · rw [hselectedZero]
  · intro k _hk
    rfl
  · intro k _hk
    rfl
  · intro k hk
    rw [hselectedNext k hk]

/--
A minimal equal-state gap is simple.

This is the finite-walk kernel used by loop erasure: if the chosen repeated
state pair has no shorter repeated-state subgap inside it, then the half-open
cycle window between the two occurrences has no repeated states.
-/
theorem sourceState_cycleSimple_of_minimal_equal_state_gap
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (sourceState : Nat -> GameState T)
    {cycleStart cycleStop : Nat}
    (hcycleLt : cycleStart < cycleStop)
    (hminimal :
      ∀ a b : Nat,
        cycleStart ≤ a ->
        a < b ->
        b ≤ cycleStop ->
        sourceState a = sourceState b ->
          cycleStop - cycleStart ≤ b - a) :
    ∀ i j : Nat,
      i < cycleStop - cycleStart ->
      j < cycleStop - cycleStart ->
      sourceState (cycleStart + i) =
        sourceState (cycleStart + j) ->
        i = j := by
  intro i j hi hj hstate
  by_cases hij : i = j
  · exact hij
  rcases Nat.lt_or_gt_of_ne hij with hijlt | hjilt
  · have hmin :
        cycleStop - cycleStart ≤
          (cycleStart + j) - (cycleStart + i) :=
      hminimal (cycleStart + i) (cycleStart + j)
        (by omega) (by omega) (by omega) hstate
    have hgap :
        (cycleStart + j) - (cycleStart + i) = j - i := by
      omega
    have hgapLt : j - i < cycleStop - cycleStart := by
      omega
    omega
  · have hmin :
        cycleStop - cycleStart ≤
          (cycleStart + i) - (cycleStart + j) :=
      hminimal (cycleStart + j) (cycleStart + i)
        (by omega) (by omega) (by omega) hstate.symm
    have hgap :
        (cycleStart + i) - (cycleStart + j) = i - j := by
      omega
    have hgapLt : i - j < cycleStop - cycleStart := by
      omega
    omega

/--
Any repeated pair inside a half-open cycle window exposes a strictly shorter
equal-state gap.

This is the reduction step dual to
`sourceState_cycleSimple_of_minimal_equal_state_gap`: a non-simple window gives
the smaller repeated-state segment that loop erasure should remove or recurse
on.
-/
theorem exists_shorter_equal_state_gap_of_cycleWindow_repeat
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (sourceState : Nat -> GameState T)
    {cycleStart cycleStop : Nat}
    (hcycleLt : cycleStart < cycleStop)
    {i j : Nat}
    (hi : i < cycleStop - cycleStart)
    (hj : j < cycleStop - cycleStart)
    (hneq : i ≠ j)
    (hstate :
      sourceState (cycleStart + i) =
        sourceState (cycleStart + j)) :
    ∃ a b : Nat,
      cycleStart ≤ a ∧
        a < b ∧
          b ≤ cycleStop ∧
            sourceState a = sourceState b ∧
              b - a < cycleStop - cycleStart := by
  rcases Nat.lt_or_gt_of_ne hneq with hij | hji
  · refine ⟨cycleStart + i, cycleStart + j, ?_, ?_, ?_, hstate, ?_⟩ <;> omega
  · refine ⟨cycleStart + j, cycleStart + i, ?_, ?_, ?_, hstate.symm, ?_⟩ <;> omega

/--
Cycle edge-time map obtained by removing the internal gap `[i,j)` from a return
segment that starts at `returnStart`.

Positions before `i` keep their original source edge.  Positions from `i`
onward are shifted by `j - i`, so the outgoing edge at the repeated state is
taken from the later occurrence.
-/
def compressedCycleEdgeTime (returnStart i j n : Nat) : Nat :=
  if n < i then returnStart + n else returnStart + n + (j - i)

/--
Removing an internal repeated-state gap preserves the closed-cycle edge law and
strictly shortens the cycle.

This is the edge-time core of witness-preserving loop erasure for the safe case
where the removed gap is strictly after the cycle entry, so the entry witness at
offset `0` remains selected.
-/
theorem compressedCycleEdgeTime_internal_repeat_properties
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (sourceState : Nat -> GameState T)
    {returnStart returnStop i j : Nat}
    (hreturnLt : returnStart < returnStop)
    (hiPos : 0 < i)
    (hij : i < j)
    (hj : j < returnStop - returnStart)
    (hrepeat :
      sourceState (returnStart + i) = sourceState (returnStart + j))
    (hclosed : sourceState returnStart = sourceState returnStop) :
    let period := returnStop - returnStart
    let gap := j - i
    let newPeriod := period - gap
    0 < newPeriod ∧
      newPeriod < period ∧
        compressedCycleEdgeTime returnStart i j 0 = returnStart ∧
          (∀ n : Nat,
            n < newPeriod ->
              returnStart ≤ compressedCycleEdgeTime returnStart i j n ∧
                compressedCycleEdgeTime returnStart i j n + 1 ≤ returnStop) ∧
            (∀ n : Nat,
              n < newPeriod ->
                sourceState
                    (compressedCycleEdgeTime returnStart i j
                      (selectedLassoNextIndex 0 newPeriod n)) =
                  sourceState
                    (compressedCycleEdgeTime returnStart i j n + 1)) := by
  dsimp
  let period := returnStop - returnStart
  let gap := j - i
  let newPeriod := period - gap
  have hperiodEq : returnStart + period = returnStop := by
    dsimp [period]
    omega
  have hgapPos : 0 < gap := by
    dsimp [gap]
    omega
  have hgapLtPeriod : gap < period := by
    dsimp [gap, period]
    omega
  have hnewPos : 0 < newPeriod := by
    dsimp [newPeriod]
    omega
  have hnewLt : newPeriod < period := by
    dsimp [newPeriod]
    omega
  have hiLtNew : i < newPeriod := by
    dsimp [newPeriod, gap, period]
    omega
  refine ⟨hnewPos, hnewLt, ?_, ?_, ?_⟩
  · simp [compressedCycleEdgeTime, hiPos]
  · intro n hn
    by_cases hni : n < i
    · simp [compressedCycleEdgeTime, hni]
      omega
    · simp [compressedCycleEdgeTime, hni]
      omega
  · intro n hn
    by_cases hlast : n + 1 = 0 + newPeriod
    · have hnge : 0 ≤ n := by omega
      have hnEq : n = newPeriod - 1 := by omega
      have hnNotLtI : ¬ n < i := by omega
      rw [selectedLassoNextIndex_eq_start_of_last 0 newPeriod n hnge hlast]
      simp [compressedCycleEdgeTime, hiPos, hnNotLtI]
      have hnEdge : returnStart + n + gap + 1 = returnStop := by
        dsimp [newPeriod, period, gap] at hnEq
        omega
      rw [hnEdge]
      exact hclosed
    · have hnNew : n < 0 + newPeriod := by
        omega
      rw [selectedLassoNextIndex_eq_succ_of_not_last 0 newPeriod n hnNew hlast]
      by_cases hni : n < i
      · by_cases hsuccLt : n + 1 < i
        · simp [compressedCycleEdgeTime, hni, hsuccLt]
          have hidx : returnStart + (n + 1) = returnStart + n + 1 := by
            omega
          rw [hidx]
        · have hsuccEq : n + 1 = i := by
            omega
          have hsuccNotLt : ¬ n + 1 < i := by
            omega
          simp [compressedCycleEdgeTime, hni, hsuccNotLt, hsuccEq]
          have hleft : returnStart + i + (j - i) = returnStart + j := by
            omega
          have hright : returnStart + n + 1 = returnStart + i := by
            omega
          rw [hleft, hright]
          exact hrepeat.symm
      · have hsuccNotLt : ¬ n + 1 < i := by
          omega
        simp [compressedCycleEdgeTime, hni, hsuccNotLt]
        have hidx :
            returnStart + (n + 1) + (j - i) =
              returnStart + n + (j - i) + 1 := by
          omega
        rw [hidx]

/--
Cycle edge-time map obtained by removing the internal gap `[i,j)` from an
already retained cycle edge-time map.

This is the iterated form needed by loop erasure after the first deletion:
positions before `i` keep their retained source edge, and positions from `i`
onward reuse the edge that was previously `j - i` positions later.
-/
def compressedRetainedCycleEdgeTime
    (edgeTime : Nat -> Nat) (i j n : Nat) : Nat :=
  if n < i then edgeTime n else edgeTime (n + (j - i))

/--
Removing an internal repeated-state gap from an already retained cycle preserves
the closed-cycle edge law and strictly shortens the cycle.

Unlike `compressedCycleEdgeTime_internal_repeat_properties`, this theorem does
not assume that the current cycle is a contiguous source segment.  It only uses
the retained-edge target law.  This is the reusable descent step for repeated
loop erasure.
-/
theorem compressedRetainedCycleEdgeTime_internal_repeat_properties
    {State : Type u}
    (sourceState : Nat -> State)
    (edgeTime : Nat -> Nat)
    {returnStart returnStop period i j : Nat}
    (hperiodPositive : 0 < period)
    (hiPos : 0 < i)
    (hij : i < j)
    (hj : j < period)
    (hrepeat :
      sourceState (edgeTime i) = sourceState (edgeTime j))
    (hselectedTarget :
      ∀ n : Nat,
        n < period ->
          sourceState
              (edgeTime (selectedLassoNextIndex 0 period n)) =
            sourceState (edgeTime n + 1))
    (hcycleEdgeAfterReturnStart :
      ∀ n : Nat,
        n < period ->
          returnStart ≤ edgeTime n)
    (hcycleEdgeBeforeReturnStop :
      ∀ n : Nat,
        n < period ->
          edgeTime n + 1 ≤ returnStop) :
    let gap := j - i
    let newPeriod := period - gap
    0 < newPeriod ∧
      newPeriod < period ∧
        compressedRetainedCycleEdgeTime edgeTime i j 0 = edgeTime 0 ∧
          (∀ n : Nat,
            n < newPeriod ->
              returnStart ≤ compressedRetainedCycleEdgeTime edgeTime i j n ∧
                compressedRetainedCycleEdgeTime edgeTime i j n + 1 ≤
                  returnStop) ∧
            (∀ n : Nat,
              n < newPeriod ->
                sourceState
                    (compressedRetainedCycleEdgeTime edgeTime i j
                      (selectedLassoNextIndex 0 newPeriod n)) =
                  sourceState
                    (compressedRetainedCycleEdgeTime edgeTime i j n + 1)) := by
  dsimp
  let gap := j - i
  let newPeriod := period - gap
  have hgapPos : 0 < gap := by
    dsimp [gap]
    omega
  have hgapLtPeriod : gap < period := by
    dsimp [gap]
    omega
  have hnewPos : 0 < newPeriod := by
    dsimp [newPeriod]
    omega
  have hnewLt : newPeriod < period := by
    dsimp [newPeriod]
    omega
  have hiLtNew : i < newPeriod := by
    dsimp [newPeriod, gap]
    omega
  refine ⟨hnewPos, hnewLt, ?_, ?_, ?_⟩
  · simp [compressedRetainedCycleEdgeTime, hiPos]
  · intro n hn
    by_cases hni : n < i
    · have hnOld : n < period := by
        omega
      simp [compressedRetainedCycleEdgeTime, hni]
      exact
        ⟨hcycleEdgeAfterReturnStart n hnOld,
          hcycleEdgeBeforeReturnStop n hnOld⟩
    · have hnOld : n + gap < period := by
        omega
      simp [compressedRetainedCycleEdgeTime, hni]
      exact
        ⟨hcycleEdgeAfterReturnStart (n + gap) hnOld,
          hcycleEdgeBeforeReturnStop (n + gap) hnOld⟩
  · intro n hn
    by_cases hlast : n + 1 = 0 + newPeriod
    · have hnge : 0 ≤ n := by omega
      have hnEq : n = newPeriod - 1 := by omega
      have hnNotLtI : ¬ n < i := by omega
      have hnOld : n + gap < period := by
        dsimp [newPeriod, gap] at hnEq
        omega
      have hlastOld : n + gap + 1 = 0 + period := by
        dsimp [newPeriod, gap] at hnEq
        omega
      rw [selectedLassoNextIndex_eq_start_of_last 0 newPeriod n hnge hlast]
      simp [compressedRetainedCycleEdgeTime, hiPos, hnNotLtI]
      have htarget := hselectedTarget (n + gap) hnOld
      rw [selectedLassoNextIndex_eq_start_of_last
        0 period (n + gap) (by omega) hlastOld] at htarget
      exact htarget
    · have hnNew : n < 0 + newPeriod := by
        omega
      rw [selectedLassoNextIndex_eq_succ_of_not_last
        0 newPeriod n hnNew hlast]
      by_cases hni : n < i
      · by_cases hsuccLt : n + 1 < i
        · have hnOld : n < period := by
            omega
          have htarget := hselectedTarget n hnOld
          have hnotLastOld : ¬ n + 1 = 0 + period := by
            omega
          rw [selectedLassoNextIndex_eq_succ_of_not_last
            0 period n (by omega) hnotLastOld] at htarget
          simp [compressedRetainedCycleEdgeTime, hni, hsuccLt]
          exact htarget
        · have hsuccEq : n + 1 = i := by
            omega
          have hsuccNotLt : ¬ n + 1 < i := by
            omega
          have hnOld : n < period := by
            omega
          have htarget := hselectedTarget n hnOld
          have hnotLastOld : ¬ n + 1 = 0 + period := by
            omega
          rw [selectedLassoNextIndex_eq_succ_of_not_last
            0 period n (by omega) hnotLastOld] at htarget
          rw [hsuccEq] at htarget
          simp [compressedRetainedCycleEdgeTime, hni, hsuccNotLt, hsuccEq]
          have hleft : i + (j - i) = j := by
            omega
          rw [hleft]
          exact hrepeat.symm.trans htarget
      · have hsuccNotLt : ¬ n + 1 < i := by
          omega
        have hnOld : n + gap < period := by
          omega
        have hnotLastOld : ¬ n + gap + 1 = 0 + period := by
          omega
        have htarget := hselectedTarget (n + gap) hnOld
        rw [selectedLassoNextIndex_eq_succ_of_not_last
          0 period (n + gap) (by omega) hnotLastOld] at htarget
        simp [compressedRetainedCycleEdgeTime, hni, hsuccNotLt]
        have hidx : n + 1 + gap = n + gap + 1 := by
          omega
        rw [hidx]
        exact htarget

/--
If the retained cycle returns to its entry before the current period ends, the
prefix up to that return is already a shorter closed retained cycle.

This handles the loop-erasure boundary case not covered by
`compressedRetainedCycleEdgeTime_internal_repeat_properties`, whose deletion gap
must start strictly after the entry.  The retained edge-time map itself is
unchanged; only the period is shortened to the first selected return.
-/
theorem retainedCycleEdgeTime_entry_repeat_truncation_properties
    {State : Type u}
    (sourceState : Nat -> State)
    (edgeTime : Nat -> Nat)
    {returnStart returnStop period j : Nat}
    (hjPos : 0 < j)
    (hj : j < period)
    (hrepeat :
      sourceState (edgeTime 0) = sourceState (edgeTime j))
    (hselectedTarget :
      ∀ n : Nat,
        n < period ->
          sourceState
              (edgeTime (selectedLassoNextIndex 0 period n)) =
            sourceState (edgeTime n + 1))
    (hcycleEdgeAfterReturnStart :
      ∀ n : Nat,
        n < period ->
          returnStart ≤ edgeTime n)
    (hcycleEdgeBeforeReturnStop :
      ∀ n : Nat,
        n < period ->
          edgeTime n + 1 ≤ returnStop) :
    0 < j ∧
      j < period ∧
        (∀ n : Nat,
          n < j ->
            returnStart ≤ edgeTime n ∧
              edgeTime n + 1 ≤ returnStop) ∧
          (∀ n : Nat,
            n < j ->
              sourceState (edgeTime (selectedLassoNextIndex 0 j n)) =
                sourceState (edgeTime n + 1)) := by
  refine ⟨hjPos, hj, ?_, ?_⟩
  · intro n hn
    have hnOld : n < period := by
      omega
    exact
      ⟨hcycleEdgeAfterReturnStart n hnOld,
        hcycleEdgeBeforeReturnStop n hnOld⟩
  · intro n hn
    by_cases hlast : n + 1 = 0 + j
    · have hnge : 0 ≤ n := by omega
      rw [selectedLassoNextIndex_eq_start_of_last 0 j n hnge hlast]
      have hnOld : n < period := by
        omega
      have hnotLastOld : n + 1 ≠ 0 + period := by
        omega
      have htarget := hselectedTarget n hnOld
      rw [selectedLassoNextIndex_eq_succ_of_not_last
        0 period n (by omega) hnotLastOld] at htarget
      have hnSucc : n + 1 = j := by
        omega
      rw [hnSucc] at htarget
      exact hrepeat.trans htarget
    · rw [selectedLassoNextIndex_eq_succ_of_not_last 0 j n (by omega) hlast]
      have hnOld : n < period := by
        omega
      have hnotLastOld : n + 1 ≠ 0 + period := by
        omega
      have htarget := hselectedTarget n hnOld
      rw [selectedLassoNextIndex_eq_succ_of_not_last
        0 period n (by omega) hnotLastOld] at htarget
      exact htarget

/--
Any repeated selected state in a retained cycle gives a strictly shorter retained
cycle preserving the entry edge-time, return-segment bounds, and retained-edge
target law.

This combines the two local loop-erasure shortening moves: entry repeats are
handled by truncation, while strictly internal repeats are handled by retained
edge-time compression.
-/
theorem exists_shorter_retainedCycleEdgeTime_of_repeat
    {State : Type u}
    (sourceState : Nat -> State)
    (edgeTime : Nat -> Nat)
    {returnStart returnStop period i j : Nat}
    (hperiodPositive : 0 < period)
    (hij : i < j)
    (hj : j < period)
    (hrepeat :
      sourceState (edgeTime i) = sourceState (edgeTime j))
    (hselectedTarget :
      ∀ n : Nat,
        n < period ->
          sourceState
              (edgeTime (selectedLassoNextIndex 0 period n)) =
            sourceState (edgeTime n + 1))
    (hcycleEdgeAfterReturnStart :
      ∀ n : Nat,
        n < period ->
          returnStart ≤ edgeTime n)
    (hcycleEdgeBeforeReturnStop :
      ∀ n : Nat,
        n < period ->
          edgeTime n + 1 ≤ returnStop) :
    ∃ newPeriod : Nat,
      ∃ newEdgeTime : Nat -> Nat,
        0 < newPeriod ∧
          newPeriod < period ∧
            newEdgeTime 0 = edgeTime 0 ∧
              (∀ n : Nat,
                n < newPeriod ->
                  returnStart ≤ newEdgeTime n ∧
                    newEdgeTime n + 1 ≤ returnStop) ∧
                (∀ n : Nat,
                  n < newPeriod ->
                    sourceState
                        (newEdgeTime
                          (selectedLassoNextIndex 0 newPeriod n)) =
                      sourceState (newEdgeTime n + 1)) := by
  by_cases hiZero : i = 0
  · subst i
    have hjPos : 0 < j := by
      omega
    rcases
        retainedCycleEdgeTime_entry_repeat_truncation_properties
          sourceState edgeTime hjPos hj hrepeat hselectedTarget
          hcycleEdgeAfterReturnStart hcycleEdgeBeforeReturnStop with
      ⟨hnewPos, hnewLt, hbounds, htarget⟩
    exact ⟨j, edgeTime, hnewPos, hnewLt, rfl, hbounds, htarget⟩
  · have hiPos : 0 < i := by
      omega
    rcases
        compressedRetainedCycleEdgeTime_internal_repeat_properties
          sourceState edgeTime hperiodPositive hiPos hij hj hrepeat
          hselectedTarget hcycleEdgeAfterReturnStart
          hcycleEdgeBeforeReturnStop with
      ⟨hnewPos, hnewLt, hzero, hbounds, htarget⟩
    exact
      ⟨period - (j - i), compressedRetainedCycleEdgeTime edgeTime i j,
        hnewPos, hnewLt, hzero, hbounds, htarget⟩

/--
If a retained cycle has no ordered repeated selected states, then its cycle
window is simple.

This is the terminal condition for the retained-cycle finite descent: once no
shortening repeat remains, the selected cycle satisfies the simple-cycle field
needed by `RoundAwareLoopErasedRecurrentReturnLassoWitness`.
-/
theorem retainedCycleSimple_of_no_ordered_repeat
    {State : Type u}
    (sourceState : Nat -> State)
    (edgeTime : Nat -> Nat)
    {period : Nat}
    (hnoRepeat :
      ∀ i j : Nat,
        i < j ->
        j < period ->
        sourceState (edgeTime i) = sourceState (edgeTime j) ->
          False) :
    ∀ i j : Nat,
      i < period ->
      j < period ->
      sourceState (edgeTime i) = sourceState (edgeTime j) ->
        i = j := by
  intro i j hi hj hstate
  by_cases hij : i = j
  · exact hij
  rcases Nat.lt_or_gt_of_ne hij with hlt | hgt
  · exact False.elim (hnoRepeat i j hlt hj hstate)
  · exact False.elim (hnoRepeat j i hgt hi hstate.symm)

/--
Finite descent for retained cycles: repeatedly shorten at ordered repeated
selected states until the retained cycle is simple.

The resulting cycle keeps the same entry edge-time, all retained cycle edges stay
inside the original return segment, and the retained-edge target law is preserved
through every shortening step.  This is the pure cycle half of the eventual
recurrent-return loop-erasure producer.
-/
theorem exists_simple_retainedCycleEdgeTime_of_retainedCycle
    {State : Type u}
    (sourceState : Nat -> State)
    (edgeTime : Nat -> Nat)
    {returnStart returnStop period : Nat}
    (hperiodPositive : 0 < period)
    (hselectedTarget :
      ∀ n : Nat,
        n < period ->
          sourceState
              (edgeTime (selectedLassoNextIndex 0 period n)) =
            sourceState (edgeTime n + 1))
    (hcycleEdgeAfterReturnStart :
      ∀ n : Nat,
        n < period ->
          returnStart ≤ edgeTime n)
    (hcycleEdgeBeforeReturnStop :
      ∀ n : Nat,
        n < period ->
          edgeTime n + 1 ≤ returnStop) :
    ∃ simplePeriod : Nat,
      ∃ simpleEdgeTime : Nat -> Nat,
        0 < simplePeriod ∧
          simplePeriod ≤ period ∧
            simpleEdgeTime 0 = edgeTime 0 ∧
              (∀ n : Nat,
                n < simplePeriod ->
                  returnStart ≤ simpleEdgeTime n ∧
                    simpleEdgeTime n + 1 ≤ returnStop) ∧
                (∀ n : Nat,
                  n < simplePeriod ->
                    sourceState
                        (simpleEdgeTime
                          (selectedLassoNextIndex 0 simplePeriod n)) =
                      sourceState (simpleEdgeTime n + 1)) ∧
                  (∀ i j : Nat,
                    i < simplePeriod ->
                    j < simplePeriod ->
                    sourceState (simpleEdgeTime i) =
                      sourceState (simpleEdgeTime j) ->
                      i = j) := by
  classical
  let P : Nat -> Prop := fun period =>
    ∀ edgeTime : Nat -> Nat,
      0 < period ->
      (∀ n : Nat,
        n < period ->
          sourceState
              (edgeTime (selectedLassoNextIndex 0 period n)) =
            sourceState (edgeTime n + 1)) ->
      (∀ n : Nat,
        n < period ->
          returnStart ≤ edgeTime n) ->
      (∀ n : Nat,
        n < period ->
          edgeTime n + 1 ≤ returnStop) ->
      ∃ simplePeriod : Nat,
        ∃ simpleEdgeTime : Nat -> Nat,
          0 < simplePeriod ∧
            simplePeriod ≤ period ∧
              simpleEdgeTime 0 = edgeTime 0 ∧
                (∀ n : Nat,
                  n < simplePeriod ->
                    returnStart ≤ simpleEdgeTime n ∧
                      simpleEdgeTime n + 1 ≤ returnStop) ∧
                  (∀ n : Nat,
                    n < simplePeriod ->
                      sourceState
                          (simpleEdgeTime
                            (selectedLassoNextIndex 0 simplePeriod n)) =
                        sourceState (simpleEdgeTime n + 1)) ∧
                    (∀ i j : Nat,
                      i < simplePeriod ->
                      j < simplePeriod ->
                      sourceState (simpleEdgeTime i) =
                        sourceState (simpleEdgeTime j) ->
                        i = j)
  have hmain : P period := by
    refine Nat.strong_induction_on period ?_
    intro period ih
    dsimp [P]
    intro edgeTime hperiodPositive hselectedTarget
      hcycleEdgeAfterReturnStart hcycleEdgeBeforeReturnStop
    by_cases hrepeat :
        ∃ i j : Nat,
          i < j ∧
            j < period ∧
              sourceState (edgeTime i) = sourceState (edgeTime j)
    · rcases hrepeat with ⟨i, j, hij, hj, hstate⟩
      rcases
          exists_shorter_retainedCycleEdgeTime_of_repeat
            sourceState edgeTime hperiodPositive hij hj hstate
            hselectedTarget hcycleEdgeAfterReturnStart
            hcycleEdgeBeforeReturnStop with
        ⟨newPeriod, newEdgeTime, hnewPos, hnewLt, hnewEntry,
          hnewBounds, hnewTarget⟩
      rcases
          ih newPeriod hnewLt newEdgeTime hnewPos hnewTarget
            (fun n hn => (hnewBounds n hn).1)
            (fun n hn => (hnewBounds n hn).2) with
        ⟨simplePeriod, simpleEdgeTime, hsimplePos, hsimpleLeNew,
          hsimpleEntry, hsimpleBounds, hsimpleTarget, hsimpleSimple⟩
      refine
        ⟨simplePeriod, simpleEdgeTime, hsimplePos, ?_, ?_,
          hsimpleBounds, hsimpleTarget, hsimpleSimple⟩
      · omega
      · exact hsimpleEntry.trans hnewEntry
    · refine
        ⟨period, edgeTime, hperiodPositive, le_rfl, rfl, ?_,
          hselectedTarget, ?_⟩
      · intro n hn
        exact
          ⟨hcycleEdgeAfterReturnStart n hn,
            hcycleEdgeBeforeReturnStop n hn⟩
      · exact
          retainedCycleSimple_of_no_ordered_repeat
            sourceState edgeTime (period := period)
            (by
              intro i j hij hj hstate
              exact hrepeat ⟨i, j, hij, hj, hstate⟩)
  exact
    hmain edgeTime hperiodPositive hselectedTarget
      hcycleEdgeAfterReturnStart hcycleEdgeBeforeReturnStop

/-- Index rotation inside a retained cycle. -/
def rotatedCycleIndex (period c n : Nat) : Nat :=
  (c + n) % period

/-- Retained edge-time map after rotating a cycle entry to offset `c`. -/
def rotatedRetainedCycleEdgeTime
    (edgeTime : Nat -> Nat) (period c n : Nat) : Nat :=
  edgeTime (rotatedCycleIndex period c n)

/--
The offset of the old cycle entry after rotating the cycle to start at `c`.

When `c = 0`, the old entry remains at offset `0`; otherwise it appears after
`period - c` rotated steps.
-/
def rotatedCycleWitnessOffset (period c : Nat) : Nat :=
  if c = 0 then 0 else period - c

theorem rotatedCycleIndex_next
    {period c n : Nat} :
    rotatedCycleIndex period c (selectedLassoNextIndex 0 period n) =
      selectedLassoNextIndex 0 period (rotatedCycleIndex period c n) := by
  unfold rotatedCycleIndex
  simp [selectedLassoNextIndex, Nat.add_assoc]

theorem rotatedCycleIndex_injective_on_period
    {period c i j : Nat}
    (hi : i < period)
    (hj : j < period)
    (hidx : rotatedCycleIndex period c i = rotatedCycleIndex period c j) :
    i = j := by
  have hmod : c + i ≡ c + j [MOD period] := by
    simpa [rotatedCycleIndex, Nat.ModEq] using hidx
  have hijmod : i ≡ j [MOD period] :=
    Nat.ModEq.add_left_cancel' c hmod
  simpa [Nat.ModEq, Nat.mod_eq_of_lt hi, Nat.mod_eq_of_lt hj] using hijmod

theorem rotatedCycleWitnessOffset_properties
    {period c : Nat}
    (hperiodPositive : 0 < period)
    (hc : c < period) :
    rotatedCycleWitnessOffset period c < period ∧
      rotatedCycleIndex period c (rotatedCycleWitnessOffset period c) = 0 := by
  by_cases hcZero : c = 0
  · subst c
    simp [rotatedCycleWitnessOffset, rotatedCycleIndex, hperiodPositive]
  · have hcPos : 0 < c := by omega
    refine ⟨?_, ?_⟩
    · simp [rotatedCycleWitnessOffset, hcZero]
      omega
    · simp [rotatedCycleWitnessOffset, rotatedCycleIndex, hcZero]
      have hsum : c + (period - c) = period := by omega
      rw [hsum, Nat.mod_self]

/--
Concrete rotation laws for a retained cycle.

This is the non-existential form needed by the recurrent-return producer: the
rotated edge-time map remains the explicit term
`rotatedRetainedCycleEdgeTime edgeTime period c`, so disjointness facts about
the unrotated cycle can be transported through `rotatedCycleIndex`.
-/
theorem rotatedRetainedCycleEdgeTime_properties
    {State : Type u}
    (sourceState : Nat -> State)
    (edgeTime : Nat -> Nat)
    (recurrentState : State)
    {returnStart returnStop period c : Nat}
    (hperiodPositive : 0 < period)
    (hc : c < period)
    (hwitnessEntry :
      sourceState (edgeTime 0) = recurrentState)
    (hselectedTarget :
      ∀ n : Nat,
        n < period ->
          sourceState
              (edgeTime (selectedLassoNextIndex 0 period n)) =
            sourceState (edgeTime n + 1))
    (hcycleEdgeAfterReturnStart :
      ∀ n : Nat,
        n < period ->
          returnStart ≤ edgeTime n)
    (hcycleEdgeBeforeReturnStop :
      ∀ n : Nat,
        n < period ->
          edgeTime n + 1 ≤ returnStop)
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        sourceState (edgeTime i) = sourceState (edgeTime j) ->
          i = j) :
    let rotatedEdgeTime :=
      rotatedRetainedCycleEdgeTime edgeTime period c
    let witness := rotatedCycleWitnessOffset period c
    rotatedEdgeTime 0 = edgeTime c ∧
      witness < period ∧
        sourceState (rotatedEdgeTime witness) = recurrentState ∧
          (∀ n : Nat,
            n < period ->
              returnStart ≤ rotatedEdgeTime n ∧
                rotatedEdgeTime n + 1 ≤ returnStop) ∧
            (∀ n : Nat,
              n < period ->
                sourceState
                    (rotatedEdgeTime
                      (selectedLassoNextIndex 0 period n)) =
                  sourceState (rotatedEdgeTime n + 1)) ∧
              (∀ i j : Nat,
                i < period ->
                j < period ->
                sourceState (rotatedEdgeTime i) =
                  sourceState (rotatedEdgeTime j) ->
                i = j) := by
  let rotatedEdgeTime := rotatedRetainedCycleEdgeTime edgeTime period c
  let witness := rotatedCycleWitnessOffset period c
  have hwitnessProps :=
    rotatedCycleWitnessOffset_properties hperiodPositive hc
  refine
    ⟨?_, hwitnessProps.1, ?_, ?_, ?_, ?_⟩
  · dsimp [rotatedEdgeTime, rotatedRetainedCycleEdgeTime, rotatedCycleIndex]
    rw [Nat.mod_eq_of_lt hc]
  · dsimp [rotatedEdgeTime, witness, rotatedRetainedCycleEdgeTime]
    rw [hwitnessProps.2]
    exact hwitnessEntry
  · intro n hn
    have hidx : rotatedCycleIndex period c n < period :=
      Nat.mod_lt _ hperiodPositive
    dsimp [rotatedEdgeTime, rotatedRetainedCycleEdgeTime]
    exact
      ⟨hcycleEdgeAfterReturnStart (rotatedCycleIndex period c n) hidx,
        hcycleEdgeBeforeReturnStop (rotatedCycleIndex period c n) hidx⟩
  · intro n hn
    have hidx : rotatedCycleIndex period c n < period :=
      Nat.mod_lt _ hperiodPositive
    dsimp [rotatedEdgeTime, rotatedRetainedCycleEdgeTime]
    rw [rotatedCycleIndex_next]
    exact hselectedTarget (rotatedCycleIndex period c n) hidx
  · intro i j hi hj hstate
    apply rotatedCycleIndex_injective_on_period hi hj
    apply hcycleSimple
    · exact Nat.mod_lt _ hperiodPositive
    · exact Nat.mod_lt _ hperiodPositive
    · simpa [rotatedEdgeTime, rotatedRetainedCycleEdgeTime] using hstate

/--
Rotate a simple retained cycle to a chosen entry offset while keeping the old
entry as an explicit witness inside the rotated cycle.

The period is unchanged.  The rotated edge-time map starts with the old edge at
offset `c`; the old entry, carrying `recurrentState`, moves to
`rotatedCycleWitnessOffset period c`.
-/
theorem exists_rotated_simple_retainedCycle_with_witness
    {State : Type u}
    (sourceState : Nat -> State)
    (edgeTime : Nat -> Nat)
    (recurrentState : State)
    {returnStart returnStop period c : Nat}
    (hperiodPositive : 0 < period)
    (hc : c < period)
    (hwitnessEntry :
      sourceState (edgeTime 0) = recurrentState)
    (hselectedTarget :
      ∀ n : Nat,
        n < period ->
          sourceState
              (edgeTime (selectedLassoNextIndex 0 period n)) =
            sourceState (edgeTime n + 1))
    (hcycleEdgeAfterReturnStart :
      ∀ n : Nat,
        n < period ->
          returnStart ≤ edgeTime n)
    (hcycleEdgeBeforeReturnStop :
      ∀ n : Nat,
        n < period ->
          edgeTime n + 1 ≤ returnStop)
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        sourceState (edgeTime i) = sourceState (edgeTime j) ->
          i = j) :
    ∃ rotatedEdgeTime : Nat -> Nat,
      ∃ witness : Nat,
        rotatedEdgeTime 0 = edgeTime c ∧
          witness < period ∧
            sourceState (rotatedEdgeTime witness) = recurrentState ∧
              (∀ n : Nat,
                n < period ->
                  returnStart ≤ rotatedEdgeTime n ∧
                    rotatedEdgeTime n + 1 ≤ returnStop) ∧
                (∀ n : Nat,
                  n < period ->
                    sourceState
                        (rotatedEdgeTime
                          (selectedLassoNextIndex 0 period n)) =
                      sourceState (rotatedEdgeTime n + 1)) ∧
                  (∀ i j : Nat,
                    i < period ->
                    j < period ->
                    sourceState (rotatedEdgeTime i) =
                      sourceState (rotatedEdgeTime j) ->
                      i = j) := by
  let rotatedEdgeTime := rotatedRetainedCycleEdgeTime edgeTime period c
  let witness := rotatedCycleWitnessOffset period c
  exact
    ⟨rotatedEdgeTime, witness,
      rotatedRetainedCycleEdgeTime_properties
        sourceState edgeTime recurrentState hperiodPositive hc hwitnessEntry
        hselectedTarget hcycleEdgeAfterReturnStart
        hcycleEdgeBeforeReturnStop hcycleSimple⟩

/--
Edge-time map obtained by concatenating a selected prefix with a selected cycle.

Positions before `start` use the prefix edge-time map.  Positions from `start`
onward use the cycle edge-time map with the cycle-local offset.
-/
def prefixCycleLassoEdgeTime
    (prefixEdgeTime cycleEdgeTime : Nat -> Nat) (start k : Nat) : Nat :=
  if k < start then prefixEdgeTime k else cycleEdgeTime (k - start)

/--
The selected vertex named by a retained prefix edge-time map, with a separate
terminal vertex at the cycle entry.
-/
def retainedPrefixVertexEdgeTime
    (edgeTime : Nat -> Nat) (terminalEdgeTime start n : Nat) : Nat :=
  if n < start then edgeTime n else terminalEdgeTime

/--
Retained prefix edge-time map obtained by removing the loop between repeated
selected prefix vertices at offsets `i < j`.

Positions before `i` keep their retained source edge.  Positions from `i` onward
reuse the edge that was previously `j - i` positions later.
-/
def compressedRetainedPrefixEdgeTime
    (edgeTime : Nat -> Nat) (i j n : Nat) : Nat :=
  if n < i then edgeTime n else edgeTime (n + (j - i))

/--
One loop-erasure step for retained prefixes.

If a retained prefix contains repeated selected states at offsets `i < j < start`,
then removing the loop `[i,j)` strictly shortens the prefix while preserving the
initial selected state and the retained-edge target law into the same terminal
cycle-entry state.
-/
theorem compressedRetainedPrefixEdgeTime_repeat_properties
    {State : Type u}
    (sourceState : Nat -> State)
    (edgeTime : Nat -> Nat)
    (terminalEdgeTime : Nat)
    {start i j : Nat}
    (initialState : State)
    (hij : i < j)
    (hj : j < start)
    (hrepeat :
      sourceState (edgeTime i) = sourceState (edgeTime j))
    (hselectedInit :
      sourceState (edgeTime 0) = initialState)
    (hprefixTarget :
      ∀ n : Nat,
        n < start ->
          sourceState
              (retainedPrefixVertexEdgeTime edgeTime terminalEdgeTime start
                (n + 1)) =
            sourceState (edgeTime n + 1)) :
    let gap := j - i
    let newStart := start - gap
    newStart < start ∧
      sourceState (compressedRetainedPrefixEdgeTime edgeTime i j 0) =
        initialState ∧
        (∀ n : Nat,
          n < newStart ->
            sourceState
                (retainedPrefixVertexEdgeTime
                  (compressedRetainedPrefixEdgeTime edgeTime i j)
                  terminalEdgeTime newStart (n + 1)) =
              sourceState
                (compressedRetainedPrefixEdgeTime edgeTime i j n + 1)) := by
  dsimp
  let gap := j - i
  let newStart := start - gap
  have hgapPos : 0 < gap := by
    dsimp [gap]
    omega
  have hgapLtStart : gap < start := by
    dsimp [gap]
    omega
  have hnewLt : newStart < start := by
    dsimp [newStart]
    omega
  have hiLtNew : i < newStart := by
    dsimp [newStart, gap]
    omega
  refine ⟨hnewLt, ?_, ?_⟩
  · by_cases hiPos : 0 < i
    · simp [compressedRetainedPrefixEdgeTime, hiPos, hselectedInit]
    · have hiZero : i = 0 := by
        omega
      have hidx : j - i = j := by
        omega
      have hrepeat0 :
          sourceState (edgeTime 0) = sourceState (edgeTime j) := by
        simpa [hiZero] using hrepeat
      simp [compressedRetainedPrefixEdgeTime, hiPos]
      rw [hidx]
      exact hrepeat0.symm.trans hselectedInit
  · intro n hn
    by_cases hni : n < i
    · by_cases hsuccLt : n + 1 < i
      · have hnOld : n < start := by
          omega
        have htarget := hprefixTarget n hnOld
        have holdNextLt : n + 1 < start := by
          omega
        rw [show
            retainedPrefixVertexEdgeTime edgeTime terminalEdgeTime start
                (n + 1) = edgeTime (n + 1) by
              simp [retainedPrefixVertexEdgeTime, holdNextLt]] at htarget
        have hnewNextLt : n + 1 < newStart := by
          omega
        rw [show
            retainedPrefixVertexEdgeTime
                (compressedRetainedPrefixEdgeTime edgeTime i j)
                terminalEdgeTime newStart (n + 1) =
              edgeTime (n + 1) by
            simp [retainedPrefixVertexEdgeTime, compressedRetainedPrefixEdgeTime,
              hnewNextLt, hsuccLt]]
        simpa [compressedRetainedPrefixEdgeTime, hni] using htarget
      · have hsuccEq : n + 1 = i := by
          omega
        have hnOld : n < start := by
          omega
        have htarget := hprefixTarget n hnOld
        have holdNextLt : n + 1 < start := by
          omega
        rw [show
            retainedPrefixVertexEdgeTime edgeTime terminalEdgeTime start
                (n + 1) = edgeTime (n + 1) by
              simp [retainedPrefixVertexEdgeTime, holdNextLt]] at htarget
        rw [hsuccEq] at htarget
        have hsuccNotLt : ¬ n + 1 < i := by
          omega
        have hnewNextLt : n + 1 < newStart := by
          omega
        have hleft : i + gap = j := by
          dsimp [gap]
          omega
        rw [show
            retainedPrefixVertexEdgeTime
                (compressedRetainedPrefixEdgeTime edgeTime i j)
                terminalEdgeTime newStart (n + 1) =
              edgeTime j by
            simp [retainedPrefixVertexEdgeTime, compressedRetainedPrefixEdgeTime,
              hnewNextLt, hsuccNotLt, hsuccEq, hiLtNew]
            rw [hleft]]
        simp [compressedRetainedPrefixEdgeTime, hni]
        exact hrepeat.symm.trans htarget
    · have hnOld : n + gap < start := by
        omega
      have htarget := hprefixTarget (n + gap) hnOld
      by_cases hsuccLtNew : n + 1 < newStart
      · have holdNextLt : n + gap + 1 < start := by
          dsimp [newStart] at hsuccLtNew
          omega
        rw [show
            retainedPrefixVertexEdgeTime edgeTime terminalEdgeTime start
                (n + gap + 1) = edgeTime (n + gap + 1) by
              simp [retainedPrefixVertexEdgeTime, holdNextLt]] at htarget
        have hsuccNotLtI : ¬ n + 1 < i := by
          omega
        have hnewVertex :
            retainedPrefixVertexEdgeTime
                (compressedRetainedPrefixEdgeTime edgeTime i j)
                terminalEdgeTime newStart (n + 1) =
              compressedRetainedPrefixEdgeTime edgeTime i j (n + 1) := by
          simp [retainedPrefixVertexEdgeTime, hsuccLtNew]
        rw [hnewVertex]
        simp [compressedRetainedPrefixEdgeTime, hni, hsuccNotLtI]
        have hidx : n + 1 + gap = n + gap + 1 := by
          omega
        rw [hidx]
        simpa [gap] using htarget
      · have hsuccEq : n + 1 = newStart := by
          omega
        have holdTerminal :
            retainedPrefixVertexEdgeTime edgeTime terminalEdgeTime start
                (n + gap + 1) = terminalEdgeTime := by
          have hnotLt : ¬ n + gap + 1 < start := by
            dsimp [newStart] at hsuccEq
            omega
          simp [retainedPrefixVertexEdgeTime, hnotLt]
        rw [holdTerminal] at htarget
        have hsuccNotLtI : ¬ n + 1 < i := by
          omega
        have hnewVertex :
            retainedPrefixVertexEdgeTime
                (compressedRetainedPrefixEdgeTime edgeTime i j)
                terminalEdgeTime newStart (n + 1) =
              terminalEdgeTime := by
          simp [retainedPrefixVertexEdgeTime, hsuccLtNew]
        rw [hnewVertex]
        simp [compressedRetainedPrefixEdgeTime, hni]
        simpa [gap] using htarget

/--
If a retained prefix has no ordered repeated selected states, then its selected
prefix window is simple.
-/
theorem retainedPrefixSimple_of_no_ordered_repeat
    {State : Type u}
    (sourceState : Nat -> State)
    (edgeTime : Nat -> Nat)
    {start : Nat}
    (hnoRepeat :
      ∀ i j : Nat,
        i < j ->
        j < start ->
        sourceState (edgeTime i) = sourceState (edgeTime j) ->
          False) :
    ∀ i j : Nat,
      i < start ->
      j < start ->
      sourceState (edgeTime i) = sourceState (edgeTime j) ->
        i = j := by
  intro i j hi hj hstate
  by_cases hij : i = j
  · exact hij
  rcases Nat.lt_or_gt_of_ne hij with hlt | hgt
  · exact False.elim (hnoRepeat i j hlt hj hstate)
  · exact False.elim (hnoRepeat j i hgt hi hstate.symm)

/--
Finite descent for retained prefixes ending at a fixed terminal cycle-entry
state.

Starting from any retained prefix with a target law into the terminal entry,
repeatedly delete repeated-state loops until the selected prefix is simple.  The
initial selected state and the target law, including the final edge into the
terminal entry, are preserved.
-/
theorem exists_simple_retainedPrefixEdgeTime_of_retainedPrefix
    {State : Type u}
    (sourceState : Nat -> State)
    (edgeTime : Nat -> Nat)
    (terminalEdgeTime : Nat)
    {start : Nat}
    (initialState : State)
    (hselectedInit :
      sourceState
          (retainedPrefixVertexEdgeTime edgeTime terminalEdgeTime start 0) =
        initialState)
    (hprefixTarget :
      ∀ n : Nat,
        n < start ->
          sourceState
              (retainedPrefixVertexEdgeTime edgeTime terminalEdgeTime start
                (n + 1)) =
            sourceState (edgeTime n + 1)) :
    ∃ simpleStart : Nat,
      ∃ simpleEdgeTime : Nat -> Nat,
        simpleStart ≤ start ∧
          sourceState
              (retainedPrefixVertexEdgeTime simpleEdgeTime terminalEdgeTime
                simpleStart 0) =
            initialState ∧
            (∀ n : Nat,
              n < simpleStart ->
                sourceState
                    (retainedPrefixVertexEdgeTime simpleEdgeTime
                      terminalEdgeTime simpleStart (n + 1)) =
                  sourceState (simpleEdgeTime n + 1)) ∧
              (∀ i j : Nat,
                i < simpleStart ->
                j < simpleStart ->
                sourceState (simpleEdgeTime i) =
                  sourceState (simpleEdgeTime j) ->
                  i = j) := by
  classical
  let P : Nat -> Prop := fun start =>
    ∀ edgeTime : Nat -> Nat,
      sourceState
          (retainedPrefixVertexEdgeTime edgeTime terminalEdgeTime start 0) =
        initialState ->
      (∀ n : Nat,
        n < start ->
          sourceState
              (retainedPrefixVertexEdgeTime edgeTime terminalEdgeTime start
                (n + 1)) =
            sourceState (edgeTime n + 1)) ->
      ∃ simpleStart : Nat,
        ∃ simpleEdgeTime : Nat -> Nat,
          simpleStart ≤ start ∧
            sourceState
                (retainedPrefixVertexEdgeTime simpleEdgeTime terminalEdgeTime
                  simpleStart 0) =
              initialState ∧
              (∀ n : Nat,
                n < simpleStart ->
                  sourceState
                      (retainedPrefixVertexEdgeTime simpleEdgeTime
                        terminalEdgeTime simpleStart (n + 1)) =
                    sourceState (simpleEdgeTime n + 1)) ∧
                (∀ i j : Nat,
                  i < simpleStart ->
                  j < simpleStart ->
                  sourceState (simpleEdgeTime i) =
                    sourceState (simpleEdgeTime j) ->
                    i = j)
  have hmain : P start := by
    refine Nat.strong_induction_on start ?_
    intro start ih
    dsimp [P]
    intro edgeTime hselectedInit hprefixTarget
    by_cases hrepeat :
        ∃ i j : Nat,
          i < j ∧
            j < start ∧
              sourceState (edgeTime i) = sourceState (edgeTime j)
    · rcases hrepeat with ⟨i, j, hij, hj, hstate⟩
      let gap := j - i
      let newStart := start - gap
      let newEdgeTime := compressedRetainedPrefixEdgeTime edgeTime i j
      have hstartPos : 0 < start := by
        omega
      have hinitEdge : sourceState (edgeTime 0) = initialState := by
        simpa [retainedPrefixVertexEdgeTime, hstartPos] using hselectedInit
      rcases
          compressedRetainedPrefixEdgeTime_repeat_properties
            sourceState edgeTime terminalEdgeTime initialState hij hj hstate
            hinitEdge hprefixTarget with
        ⟨hnewLt, hnewEdgeInit, hnewTarget⟩
      have hnewPos : 0 < newStart := by
        dsimp [newStart, gap]
        omega
      have hnewInit :
          sourceState
              (retainedPrefixVertexEdgeTime newEdgeTime terminalEdgeTime
                newStart 0) =
            initialState := by
        dsimp [newEdgeTime]
        simpa [retainedPrefixVertexEdgeTime, hnewPos] using hnewEdgeInit
      rcases
          ih newStart hnewLt newEdgeTime hnewInit hnewTarget with
        ⟨simpleStart, simpleEdgeTime, hsimpleLeNew, hsimpleInit,
          hsimpleTarget, hsimpleSimple⟩
      refine
        ⟨simpleStart, simpleEdgeTime, ?_, hsimpleInit, hsimpleTarget,
          hsimpleSimple⟩
      omega
    · refine
        ⟨start, edgeTime, le_rfl, hselectedInit, hprefixTarget, ?_⟩
      exact
        retainedPrefixSimple_of_no_ordered_repeat
          sourceState edgeTime (start := start)
          (by
            intro i j hij hj hstate
            exact hrepeat ⟨i, j, hij, hj, hstate⟩)
  exact hmain edgeTime hselectedInit hprefixTarget

/--
One retained-prefix compression preserves disjointness from a fixed cycle window.
-/
theorem compressedRetainedPrefixEdgeTime_repeat_preserves_cycleDisjoint
    {State : Type u}
    (sourceState : Nat -> State)
    (edgeTime cycleEdgeTime : Nat -> Nat)
    {start period i j newStart : Nat}
    (hij : i < j)
    (hj : j < start)
    (hnewStart : newStart = start - (j - i))
    (hprefixCycleDisjoint :
      ∀ n c : Nat,
        n < start ->
        c < period ->
          sourceState (edgeTime n) ≠ sourceState (cycleEdgeTime c)) :
    ∀ n c : Nat,
      n < newStart ->
      c < period ->
        sourceState (compressedRetainedPrefixEdgeTime edgeTime i j n) ≠
          sourceState (cycleEdgeTime c) := by
  intro n c hn hc
  by_cases hni : n < i
  · simp [compressedRetainedPrefixEdgeTime, hni]
    exact hprefixCycleDisjoint n c (by omega) hc
  · simp [compressedRetainedPrefixEdgeTime, hni]
    exact hprefixCycleDisjoint (n + (j - i)) c (by omega) hc

/--
Finite retained-prefix descent preserving disjointness from a fixed cycle window.

This strengthens `exists_simple_retainedPrefixEdgeTime_of_retainedPrefix` with
the invariant needed by the lasso assembler: if the original retained prefix is
disjoint from a fixed rotated cycle window, the loop-erased simple prefix remains
disjoint from that cycle.
-/
theorem exists_simple_retainedPrefixEdgeTime_of_retainedPrefix_preserving_cycleDisjoint
    {State : Type u}
    (sourceState : Nat -> State)
    (edgeTime cycleEdgeTime : Nat -> Nat)
    (terminalEdgeTime : Nat)
    {start period : Nat}
    (initialState : State)
    (hselectedInit :
      sourceState
          (retainedPrefixVertexEdgeTime edgeTime terminalEdgeTime start 0) =
        initialState)
    (hprefixTarget :
      ∀ n : Nat,
        n < start ->
          sourceState
              (retainedPrefixVertexEdgeTime edgeTime terminalEdgeTime start
                (n + 1)) =
            sourceState (edgeTime n + 1))
    (hprefixCycleDisjoint :
      ∀ n c : Nat,
        n < start ->
        c < period ->
          sourceState (edgeTime n) ≠ sourceState (cycleEdgeTime c)) :
    ∃ simpleStart : Nat,
      ∃ simpleEdgeTime : Nat -> Nat,
        simpleStart ≤ start ∧
          sourceState
              (retainedPrefixVertexEdgeTime simpleEdgeTime terminalEdgeTime
                simpleStart 0) =
            initialState ∧
            (∀ n : Nat,
              n < simpleStart ->
                sourceState
                    (retainedPrefixVertexEdgeTime simpleEdgeTime
                      terminalEdgeTime simpleStart (n + 1)) =
                  sourceState (simpleEdgeTime n + 1)) ∧
              (∀ i j : Nat,
                i < simpleStart ->
                j < simpleStart ->
                sourceState (simpleEdgeTime i) =
                  sourceState (simpleEdgeTime j) ->
                  i = j) ∧
                (∀ n c : Nat,
                  n < simpleStart ->
                  c < period ->
                    sourceState (simpleEdgeTime n) ≠
                      sourceState (cycleEdgeTime c)) := by
  classical
  let P : Nat -> Prop := fun start =>
    ∀ edgeTime : Nat -> Nat,
      sourceState
          (retainedPrefixVertexEdgeTime edgeTime terminalEdgeTime start 0) =
        initialState ->
      (∀ n : Nat,
        n < start ->
          sourceState
              (retainedPrefixVertexEdgeTime edgeTime terminalEdgeTime start
                (n + 1)) =
            sourceState (edgeTime n + 1)) ->
      (∀ n c : Nat,
        n < start ->
        c < period ->
          sourceState (edgeTime n) ≠ sourceState (cycleEdgeTime c)) ->
      ∃ simpleStart : Nat,
        ∃ simpleEdgeTime : Nat -> Nat,
          simpleStart ≤ start ∧
            sourceState
                (retainedPrefixVertexEdgeTime simpleEdgeTime terminalEdgeTime
                  simpleStart 0) =
              initialState ∧
              (∀ n : Nat,
                n < simpleStart ->
                  sourceState
                      (retainedPrefixVertexEdgeTime simpleEdgeTime
                        terminalEdgeTime simpleStart (n + 1)) =
                    sourceState (simpleEdgeTime n + 1)) ∧
                (∀ i j : Nat,
                  i < simpleStart ->
                  j < simpleStart ->
                  sourceState (simpleEdgeTime i) =
                    sourceState (simpleEdgeTime j) ->
                    i = j) ∧
                  (∀ n c : Nat,
                    n < simpleStart ->
                    c < period ->
                      sourceState (simpleEdgeTime n) ≠
                        sourceState (cycleEdgeTime c))
  have hmain : P start := by
    refine Nat.strong_induction_on start ?_
    intro start ih
    dsimp [P]
    intro edgeTime hselectedInit hprefixTarget hprefixCycleDisjoint
    by_cases hrepeat :
        ∃ i j : Nat,
          i < j ∧
            j < start ∧
              sourceState (edgeTime i) = sourceState (edgeTime j)
    · rcases hrepeat with ⟨i, j, hij, hj, hstate⟩
      let gap := j - i
      let newStart := start - gap
      let newEdgeTime := compressedRetainedPrefixEdgeTime edgeTime i j
      have hstartPos : 0 < start := by
        omega
      have hinitEdge : sourceState (edgeTime 0) = initialState := by
        simpa [retainedPrefixVertexEdgeTime, hstartPos] using hselectedInit
      rcases
          compressedRetainedPrefixEdgeTime_repeat_properties
            sourceState edgeTime terminalEdgeTime initialState hij hj hstate
            hinitEdge hprefixTarget with
        ⟨hnewLt, hnewEdgeInit, hnewTarget⟩
      have hnewPos : 0 < newStart := by
        dsimp [newStart, gap]
        omega
      have hnewInit :
          sourceState
              (retainedPrefixVertexEdgeTime newEdgeTime terminalEdgeTime
                newStart 0) =
            initialState := by
        dsimp [newEdgeTime]
        simpa [retainedPrefixVertexEdgeTime, hnewPos] using hnewEdgeInit
      have hnewDisjoint :
          ∀ n c : Nat,
            n < newStart ->
            c < period ->
              sourceState (newEdgeTime n) ≠ sourceState (cycleEdgeTime c) := by
        dsimp [newEdgeTime, newStart, gap]
        exact
          compressedRetainedPrefixEdgeTime_repeat_preserves_cycleDisjoint
            sourceState edgeTime cycleEdgeTime hij hj rfl
            hprefixCycleDisjoint
      rcases
          ih newStart hnewLt newEdgeTime hnewInit hnewTarget hnewDisjoint with
        ⟨simpleStart, simpleEdgeTime, hsimpleLeNew, hsimpleInit,
          hsimpleTarget, hsimpleSimple, hsimpleDisjoint⟩
      refine
        ⟨simpleStart, simpleEdgeTime, ?_, hsimpleInit, hsimpleTarget,
          hsimpleSimple, hsimpleDisjoint⟩
      omega
    · refine
        ⟨start, edgeTime, le_rfl, hselectedInit, hprefixTarget, ?_,
          hprefixCycleDisjoint⟩
      exact
        retainedPrefixSimple_of_no_ordered_repeat
          sourceState edgeTime (start := start)
          (by
            intro i j hij hj hstate
            exact hrepeat ⟨i, j, hij, hj, hstate⟩)
  exact hmain edgeTime hselectedInit hprefixTarget hprefixCycleDisjoint

/--
Choose the first prefix vertex that lies on a fixed retained cycle window.

This is the abstract first-hit fact needed before rotating the cycle: if some
prefix vertex up to `start` is equal to a cycle vertex, then there is an earliest
such prefix vertex, and every earlier prefix vertex is disjoint from the whole
cycle window.
-/
theorem exists_first_prefix_cycle_hit
    {State : Type u}
    (sourceState : Nat -> State)
    (prefixVertexTime cycleEdgeTime : Nat -> Nat)
    {start period : Nat}
    (hhit :
      ∃ n : Nat,
        ∃ c : Nat,
          n ≤ start ∧
            c < period ∧
              sourceState (prefixVertexTime n) =
                sourceState (cycleEdgeTime c)) :
    ∃ hit : Nat,
      ∃ cHit : Nat,
        hit ≤ start ∧
          cHit < period ∧
            sourceState (prefixVertexTime hit) =
              sourceState (cycleEdgeTime cHit) ∧
              (∀ n c : Nat,
                n < hit ->
                c < period ->
                  sourceState (prefixVertexTime n) ≠
                    sourceState (cycleEdgeTime c)) := by
  classical
  let P : Nat -> Prop := fun n =>
    n ≤ start ∧
      ∃ c : Nat,
        c < period ∧
          sourceState (prefixVertexTime n) = sourceState (cycleEdgeTime c)
  have hnonempty : ∃ n : Nat, P n := by
    rcases hhit with ⟨n, c, hn, hc, hstate⟩
    exact ⟨n, hn, c, hc, hstate⟩
  let hit := Nat.find hnonempty
  have hhitSpec : P hit := Nat.find_spec hnonempty
  rcases hhitSpec with ⟨hhitLe, cHit, hcHit, hhitState⟩
  refine ⟨hit, cHit, hhitLe, hcHit, hhitState, ?_⟩
  intro n c hn hc hstate
  have hPn : P n := by
    exact ⟨by omega, c, hc, hstate⟩
  have hmin := Nat.find_min' hnonempty hPn
  omega

/--
First-hit disjointness is stable under explicit cycle rotation.

Every rotated offset is an unrotated offset modulo the same period, so an
earliest prefix/cycle hit remains disjoint from all earlier prefix vertices
after the cycle is rotated to that hit.
-/
theorem firstHit_disjoint_rotatedRetainedCycle
    {State : Type u}
    (sourceState : Nat -> State)
    (prefixVertexTime cycleEdgeTime : Nat -> Nat)
    {hit period cHit : Nat}
    (hperiodPositive : 0 < period)
    (hfirstDisjoint :
      ∀ n c : Nat,
        n < hit ->
        c < period ->
          sourceState (prefixVertexTime n) ≠
            sourceState (cycleEdgeTime c)) :
    ∀ n j : Nat,
      n < hit ->
      j < period ->
        sourceState (prefixVertexTime n) ≠
          sourceState
            (rotatedRetainedCycleEdgeTime cycleEdgeTime period cHit j) := by
  intro n j hn _hj
  simpa [rotatedRetainedCycleEdgeTime] using
    hfirstDisjoint n (rotatedCycleIndex period cHit j) hn
      (Nat.mod_lt _ hperiodPositive)

/--
The identity retained prefix starts at the source initial state, even in the
degenerate `hit = 0` case where the retained prefix's first vertex is the cycle
entry.
-/
theorem retainedPrefixVertexEdgeTime_id_selectedInit_of_terminal_hit
    {State : Type u}
    (sourceState : Nat -> State)
    {terminalEdgeTime hit : Nat}
    (hhitState :
      sourceState hit = sourceState terminalEdgeTime) :
    sourceState
        (retainedPrefixVertexEdgeTime (fun n : Nat => n)
          terminalEdgeTime hit 0) =
      sourceState 0 := by
  by_cases hhitPos : 0 < hit
  · simp [retainedPrefixVertexEdgeTime, hhitPos]
  · have hhitZero : hit = 0 := by omega
    subst hit
    simpa [retainedPrefixVertexEdgeTime] using hhitState.symm

/--
The identity retained prefix has the expected target law into a terminal cycle
entry equal to the hit vertex.
-/
theorem retainedPrefixVertexEdgeTime_id_target_of_terminal_hit
    {State : Type u}
    (sourceState : Nat -> State)
    {terminalEdgeTime hit : Nat}
    (hhitState :
      sourceState hit = sourceState terminalEdgeTime) :
    ∀ k : Nat,
      k < hit ->
        sourceState
            (retainedPrefixVertexEdgeTime (fun n : Nat => n)
              terminalEdgeTime hit (k + 1)) =
          sourceState ((fun n : Nat => n) k + 1) := by
  intro k hk
  by_cases hnext : k + 1 < hit
  · simp [retainedPrefixVertexEdgeTime, hnext]
  · have hnextEq : k + 1 = hit := by omega
    simpa [retainedPrefixVertexEdgeTime, hnext, hnextEq] using
      hhitState.symm

/--
Assemble a simple retained prefix and a rotated simple retained cycle into the
pure recurrent-return loop-erasure witness.

This is the lasso-level bridge after the cycle has already been simplified and
rotated to the chosen prefix-entry state.  The remaining future work is to
produce the prefix hypotheses: a loop-erased prefix ending at that entry and
disjoint from the rotated cycle before the entry.
-/
theorem exists_loopErasedRecurrentReturnLassoWitness_of_simple_prefix_and_rotated_simple_retainedCycle
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (sourceState : Nat -> GameState T)
    (sourceEnv : EnvironmentSequence In₁ In₂)
    (recurrentState : GameState T)
    {returnStart returnStop : Nat}
    (prefixEdgeTime cycleEdgeTime : Nat -> Nat)
    (start period witness : Nat)
    (hperiodPositive : 0 < period)
    (hselectedInit :
      sourceState
          (prefixCycleLassoEdgeTime prefixEdgeTime cycleEdgeTime start 0) =
        sourceState 0)
    (hprefixTarget :
      ∀ k : Nat,
        k < start ->
          sourceState
              (prefixCycleLassoEdgeTime prefixEdgeTime cycleEdgeTime start
                (k + 1)) =
            sourceState (prefixEdgeTime k + 1))
    (hcycleTarget :
      ∀ i : Nat,
        i < period ->
          sourceState (cycleEdgeTime (selectedLassoNextIndex 0 period i)) =
            sourceState (cycleEdgeTime i + 1))
    (hprefixSimple :
      ∀ i j : Nat,
        i < start ->
        j < start ->
        sourceState (prefixEdgeTime i) = sourceState (prefixEdgeTime j) ->
          i = j)
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        sourceState (cycleEdgeTime i) = sourceState (cycleEdgeTime j) ->
          i = j)
    (hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < start ->
        j < period ->
          sourceState (prefixEdgeTime i) ≠ sourceState (cycleEdgeTime j))
    (hwitnessLt : witness < period)
    (hwitnessState :
      sourceState (cycleEdgeTime witness) = recurrentState)
    (hcycleEdgeAfterReturnStart :
      ∀ i : Nat,
        i < period ->
          returnStart ≤ cycleEdgeTime i)
    (hcycleEdgeBeforeReturnStop :
      ∀ i : Nat,
        i < period ->
          cycleEdgeTime i + 1 ≤ returnStop) :
    Nonempty
      (RoundAwareLoopErasedRecurrentReturnLassoWitness
        T sourceState sourceEnv recurrentState returnStart returnStop) := by
  let edgeTime := prefixCycleLassoEdgeTime prefixEdgeTime cycleEdgeTime start
  refine
    exists_loopErasedRecurrentReturnLassoWitness_of_selectedEdgeTimes
      sourceState sourceEnv recurrentState edgeTime start period witness
      hperiodPositive ?_ ?_ ?_ ?_ ?_ hwitnessLt ?_ ?_ ?_
  · exact hselectedInit
  · intro k hk
    by_cases hkPrefix : k < start
    · have hnext :
          selectedLassoNextIndex start period k = k + 1 := by
        simp [selectedLassoNextIndex, hkPrefix]
      rw [hnext]
      dsimp [edgeTime]
      simpa [prefixCycleLassoEdgeTime, hkPrefix] using
        hprefixTarget k hkPrefix
    · let i := k - start
      have hi : i < period := by
        dsimp [i]
        omega
      have hkEq : k = start + i := by
        dsimp [i]
        omega
      have hnext :
          selectedLassoNextIndex start period k =
            start + selectedLassoNextIndex 0 period i := by
        rw [hkEq]
        simp [selectedLassoNextIndex]
      dsimp [edgeTime]
      rw [hnext]
      simpa [prefixCycleLassoEdgeTime, hkPrefix, i] using hcycleTarget i hi
  · intro i j hi hj hstate
    apply hprefixSimple i j hi hj
    simpa [edgeTime, prefixCycleLassoEdgeTime, hi, hj] using hstate
  · intro i j hi hj hstate
    apply hcycleSimple i j hi hj
    simpa [edgeTime, prefixCycleLassoEdgeTime] using hstate
  · intro i j hi hj hstate
    exact
      hprefixCycleDisjoint i j hi hj
        (by simpa [edgeTime, prefixCycleLassoEdgeTime, hi] using hstate)
  · simpa [edgeTime, prefixCycleLassoEdgeTime] using hwitnessState
  · intro i hi
    simpa [edgeTime, prefixCycleLassoEdgeTime] using
      hcycleEdgeAfterReturnStart i hi
  · intro i hi
    simpa [edgeTime, prefixCycleLassoEdgeTime] using
      hcycleEdgeBeforeReturnStop i hi

/--
Assemble a retained prefix and a rotated simple retained cycle when the prefix is
not yet simple but is already disjoint from the cycle.

The retained prefix is first loop-erased by
`exists_simple_retainedPrefixEdgeTime_of_retainedPrefix_preserving_cycleDisjoint`;
the resulting simple/disjoint prefix is then fed to the lasso assembler above.
Thus the remaining future producer only has to choose the first prefix hit of the
cycle, which supplies the initial prefix/cycle disjointness.
-/
theorem exists_loopErasedRecurrentReturnLassoWitness_of_retainedPrefixAndRotatedSimpleCycle_disjoint
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (sourceState : Nat -> GameState T)
    (sourceEnv : EnvironmentSequence In₁ In₂)
    (recurrentState : GameState T)
    {returnStart returnStop : Nat}
    (prefixEdgeTime cycleEdgeTime : Nat -> Nat)
    (start period witness : Nat)
    (hperiodPositive : 0 < period)
    (hselectedInit :
      sourceState
          (retainedPrefixVertexEdgeTime prefixEdgeTime (cycleEdgeTime 0)
            start 0) =
        sourceState 0)
    (hprefixTarget :
      ∀ k : Nat,
        k < start ->
          sourceState
              (retainedPrefixVertexEdgeTime prefixEdgeTime (cycleEdgeTime 0)
                start (k + 1)) =
            sourceState (prefixEdgeTime k + 1))
    (hcycleTarget :
      ∀ i : Nat,
        i < period ->
          sourceState (cycleEdgeTime (selectedLassoNextIndex 0 period i)) =
            sourceState (cycleEdgeTime i + 1))
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        sourceState (cycleEdgeTime i) = sourceState (cycleEdgeTime j) ->
          i = j)
    (hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < start ->
        j < period ->
          sourceState (prefixEdgeTime i) ≠ sourceState (cycleEdgeTime j))
    (hwitnessLt : witness < period)
    (hwitnessState :
      sourceState (cycleEdgeTime witness) = recurrentState)
    (hcycleEdgeAfterReturnStart :
      ∀ i : Nat,
        i < period ->
          returnStart ≤ cycleEdgeTime i)
    (hcycleEdgeBeforeReturnStop :
      ∀ i : Nat,
        i < period ->
          cycleEdgeTime i + 1 ≤ returnStop) :
    Nonempty
      (RoundAwareLoopErasedRecurrentReturnLassoWitness
        T sourceState sourceEnv recurrentState returnStart returnStop) := by
  rcases
      exists_simple_retainedPrefixEdgeTime_of_retainedPrefix_preserving_cycleDisjoint
        sourceState prefixEdgeTime cycleEdgeTime (cycleEdgeTime 0)
        (sourceState 0) hselectedInit hprefixTarget
        hprefixCycleDisjoint with
    ⟨simpleStart, simplePrefixEdgeTime, _hsimpleLe, hsimpleInit,
      hsimpleTarget, hsimplePrefix, hsimpleDisjoint⟩
  exact
    exists_loopErasedRecurrentReturnLassoWitness_of_simple_prefix_and_rotated_simple_retainedCycle
      sourceState sourceEnv recurrentState simplePrefixEdgeTime cycleEdgeTime
      simpleStart period witness hperiodPositive
      (by
        simpa [prefixCycleLassoEdgeTime, retainedPrefixVertexEdgeTime] using
          hsimpleInit)
      (by
        intro k hk
        by_cases hnext : k + 1 < simpleStart
        · simpa [prefixCycleLassoEdgeTime, retainedPrefixVertexEdgeTime,
            hnext] using hsimpleTarget k hk
        · have hnextEq : k + 1 = simpleStart := by
            omega
          have hoffset : k + 1 - simpleStart = 0 := by
            omega
          have hvertex :
              prefixCycleLassoEdgeTime simplePrefixEdgeTime cycleEdgeTime
                  simpleStart (k + 1) =
                retainedPrefixVertexEdgeTime simplePrefixEdgeTime
                  (cycleEdgeTime 0) simpleStart (k + 1) := by
            simp [prefixCycleLassoEdgeTime, retainedPrefixVertexEdgeTime,
              hnext, hoffset]
          rw [hvertex]
          exact hsimpleTarget k hk)
      hcycleTarget hsimplePrefix hcycleSimple hsimpleDisjoint hwitnessLt
      hwitnessState hcycleEdgeAfterReturnStart hcycleEdgeBeforeReturnStop

/--
Assemble a loop-erased recurrent-return witness from a simple retained return
cycle and the original identity prefix.

The proof chooses the first prefix vertex that hits the simple retained cycle,
rotates the cycle to that hit, transports the first-hit disjointness through the
explicit rotation, and then delegates prefix loop erasure to the retained-prefix
assembler.
-/
theorem exists_loopErasedRecurrentReturnLassoWitness_of_simple_retainedCycle_and_identityPrefix
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (sourceState : Nat -> GameState T)
    (sourceEnv : EnvironmentSequence In₁ In₂)
    (recurrentState : GameState T)
    {returnStart returnStop period : Nat}
    (cycleEdgeTime : Nat -> Nat)
    (hperiodPositive : 0 < period)
    (hcycleEntry :
      cycleEdgeTime 0 = returnStart)
    (hwitnessEntry :
      sourceState (cycleEdgeTime 0) = recurrentState)
    (hcycleTarget :
      ∀ n : Nat,
        n < period ->
          sourceState
              (cycleEdgeTime (selectedLassoNextIndex 0 period n)) =
            sourceState (cycleEdgeTime n + 1))
    (hcycleEdgeAfterReturnStart :
      ∀ n : Nat,
        n < period ->
          returnStart ≤ cycleEdgeTime n)
    (hcycleEdgeBeforeReturnStop :
      ∀ n : Nat,
        n < period ->
          cycleEdgeTime n + 1 ≤ returnStop)
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        sourceState (cycleEdgeTime i) = sourceState (cycleEdgeTime j) ->
          i = j) :
    Nonempty
      (RoundAwareLoopErasedRecurrentReturnLassoWitness
        T sourceState sourceEnv recurrentState returnStart returnStop) := by
  rcases
      exists_first_prefix_cycle_hit
        sourceState (fun n : Nat => n) cycleEdgeTime
        (start := returnStart) (period := period)
        (by
          refine ⟨returnStart, 0, le_rfl, hperiodPositive, ?_⟩
          simpa [hcycleEntry]) with
    ⟨hit, cHit, hhitLe, hcHit, hhitState, hfirstDisjoint⟩
  let rotatedCycleEdgeTime :=
    rotatedRetainedCycleEdgeTime cycleEdgeTime period cHit
  let witness := rotatedCycleWitnessOffset period cHit
  rcases
      rotatedRetainedCycleEdgeTime_properties
        sourceState cycleEdgeTime recurrentState hperiodPositive hcHit
        hwitnessEntry hcycleTarget hcycleEdgeAfterReturnStart
        hcycleEdgeBeforeReturnStop hcycleSimple with
    ⟨hrotEntry, hwitnessLt, hwitnessState, hrotBounds, hrotTarget,
      hrotSimple⟩
  have hhitTerminal :
      sourceState hit = sourceState (rotatedCycleEdgeTime 0) := by
    exact hhitState.trans (congrArg sourceState hrotEntry.symm)
  have hselectedInit :
      sourceState
          (retainedPrefixVertexEdgeTime (fun n : Nat => n)
            (rotatedCycleEdgeTime 0) hit 0) =
        sourceState 0 :=
    retainedPrefixVertexEdgeTime_id_selectedInit_of_terminal_hit
      sourceState hhitTerminal
  have hprefixTarget :
      ∀ k : Nat,
        k < hit ->
          sourceState
              (retainedPrefixVertexEdgeTime (fun n : Nat => n)
                (rotatedCycleEdgeTime 0) hit (k + 1)) =
            sourceState ((fun n : Nat => n) k + 1) :=
    retainedPrefixVertexEdgeTime_id_target_of_terminal_hit
      sourceState hhitTerminal
  have hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < hit ->
        j < period ->
          sourceState ((fun n : Nat => n) i) ≠
            sourceState (rotatedCycleEdgeTime j) := by
    simpa [rotatedCycleEdgeTime] using
      firstHit_disjoint_rotatedRetainedCycle
        sourceState (fun n : Nat => n) cycleEdgeTime
        hperiodPositive hfirstDisjoint
  exact
    exists_loopErasedRecurrentReturnLassoWitness_of_retainedPrefixAndRotatedSimpleCycle_disjoint
      sourceState sourceEnv recurrentState (fun n : Nat => n)
      rotatedCycleEdgeTime hit period witness hperiodPositive
      hselectedInit hprefixTarget hrotTarget hrotSimple
      hprefixCycleDisjoint hwitnessLt hwitnessState
      (fun i hi => (hrotBounds i hi).1)
      (fun i hi => (hrotBounds i hi).2)

/--
Every finite recurrent return admits a loop-erased retained-lasso witness.

Starting with the contiguous return segment, Lean first simplifies the retained
cycle, then uses the first prefix/cycle hit and explicit cycle rotation to
produce a simple/disjoint lasso whose retained edges are all original source
edges from the return segment.
-/
theorem exists_loopErasedRecurrentReturnLassoWitness_of_recurrentReturn
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (sourceState : Nat -> GameState T)
    (sourceEnv : EnvironmentSequence In₁ In₂)
    (recurrentState : GameState T)
    {returnStart returnStop : Nat}
    (hreturnLt : returnStart < returnStop)
    (hreturnStart : sourceState returnStart = recurrentState)
    (hreturnStop : sourceState returnStop = recurrentState) :
    Nonempty
      (RoundAwareLoopErasedRecurrentReturnLassoWitness
        T sourceState sourceEnv recurrentState returnStart returnStop) := by
  let period := returnStop - returnStart
  let baseCycleEdgeTime : Nat -> Nat := fun n => returnStart + n
  have hperiodPositive : 0 < period := by
    dsimp [period]
    omega
  have hbaseTarget :
      ∀ n : Nat,
        n < period ->
          sourceState
              (baseCycleEdgeTime
                (selectedLassoNextIndex 0 period n)) =
            sourceState (baseCycleEdgeTime n + 1) := by
    intro n hn
    by_cases hlast : n + 1 = period
    · have hnext :
          selectedLassoNextIndex 0 period n = 0 := by
        simpa using
          selectedLassoNextIndex_eq_start_of_last
            0 period n (by omega) (by simpa using hlast)
      rw [hnext]
      have hleft : baseCycleEdgeTime 0 = returnStart := by
        rfl
      have hright : baseCycleEdgeTime n + 1 = returnStop := by
        dsimp [baseCycleEdgeTime, period] at hlast ⊢
        omega
      rw [hleft, hright]
      exact hreturnStart.trans hreturnStop.symm
    · have hnext :
          selectedLassoNextIndex 0 period n = n + 1 :=
        selectedLassoNextIndex_eq_succ_of_not_last
          0 period n (by omega) (by simpa using hlast)
      rw [hnext]
      have hsucc :
          baseCycleEdgeTime (n + 1) = baseCycleEdgeTime n + 1 := by
        dsimp [baseCycleEdgeTime]
        omega
      rw [hsucc]
  have hbaseAfter :
      ∀ n : Nat,
        n < period ->
          returnStart ≤ baseCycleEdgeTime n := by
    intro n _hn
    dsimp [baseCycleEdgeTime]
    omega
  have hbaseBefore :
      ∀ n : Nat,
        n < period ->
          baseCycleEdgeTime n + 1 ≤ returnStop := by
    intro n hn
    dsimp [baseCycleEdgeTime, period] at hn ⊢
    omega
  rcases
      exists_simple_retainedCycleEdgeTime_of_retainedCycle
        sourceState baseCycleEdgeTime hperiodPositive hbaseTarget
        hbaseAfter hbaseBefore with
    ⟨simplePeriod, simpleEdgeTime, hsimplePeriodPositive, _hsimpleLe,
      hsimpleEntry, hsimpleBounds, hsimpleTarget, hsimpleSimple⟩
  have hsimpleEntryReturnStart :
      simpleEdgeTime 0 = returnStart := by
    exact hsimpleEntry.trans (by rfl)
  have hwitnessEntry :
      sourceState (simpleEdgeTime 0) = recurrentState := by
    rw [hsimpleEntryReturnStart]
    exact hreturnStart
  exact
    exists_loopErasedRecurrentReturnLassoWitness_of_simple_retainedCycle_and_identityPrefix
      sourceState sourceEnv recurrentState simpleEdgeTime
      hsimplePeriodPositive hsimpleEntryReturnStart hwitnessEntry
      hsimpleTarget
      (fun n hn => (hsimpleBounds n hn).1)
      (fun n hn => (hsimpleBounds n hn).2)
      hsimpleSimple

/--
If the recurrent return segment is already in simple-lasso form, it directly
produces the pure loop-erasure witness.

This is the base case for the eventual loop-erasure theorem: after loop erasure
has removed repetitions, the selected lasso is just the retained source prefix
and return segment with identity source-edge times.
-/
theorem exists_loopErasedRecurrentReturnLassoWitness_of_simple_source_returnSegment
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (sourceState : Nat -> GameState T)
    (sourceEnv : EnvironmentSequence In₁ In₂)
    (recurrentState : GameState T)
    {returnStart returnStop : Nat}
    (hreturnLt : returnStart < returnStop)
    (hreturnStart : sourceState returnStart = recurrentState)
    (hreturnStop : sourceState returnStop = recurrentState)
    (hprefixSimple :
      ∀ i j : Nat,
        i < returnStart ->
        j < returnStart ->
        sourceState i = sourceState j ->
          i = j)
    (hcycleSimple :
      ∀ i j : Nat,
        i < returnStop - returnStart ->
        j < returnStop - returnStart ->
        sourceState (returnStart + i) = sourceState (returnStart + j) ->
          i = j)
    (hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < returnStart ->
        j < returnStop - returnStart ->
          sourceState i ≠ sourceState (returnStart + j)) :
    Nonempty
      (RoundAwareLoopErasedRecurrentReturnLassoWitness
        T sourceState sourceEnv recurrentState returnStart returnStop) := by
  let period := returnStop - returnStart
  have hperiodPositive : 0 < period := by
    dsimp [period]
    omega
  refine
    ⟨{
      stateAt := sourceState
      envAt := sourceEnv
      edgeTime := fun k => k
      start := returnStart
      period := period
      witness := 0
      periodPositive := hperiodPositive
      selectedInit := rfl
      selectedSource := ?_
      selectedEnv := ?_
      selectedTarget := ?_
      prefixSimple := hprefixSimple
      cycleSimple := ?_
      prefixCycleDisjoint := ?_
      witnessLt := hperiodPositive
      witnessState := ?_
      cycleEdgeAfterReturnStart := ?_
      cycleEdgeBeforeReturnStop := ?_
    }⟩
  · intro k _hk
    rfl
  · intro k _hk
    rfl
  · intro k hk
    change
      sourceState (selectedLassoNextIndex returnStart period k) =
        sourceState (k + 1)
    by_cases hlast : k + 1 = returnStart + period
    · have hkge : returnStart ≤ k := by
        omega
      rw [selectedLassoNextIndex_eq_start_of_last
        returnStart period k hkge hlast]
      calc
        sourceState returnStart = recurrentState := hreturnStart
        _ = sourceState returnStop := hreturnStop.symm
        _ = sourceState (k + 1) := by
          have hkstop : k + 1 = returnStop := by
            dsimp [period] at hlast
            omega
          rw [hkstop]
    · rw [selectedLassoNextIndex_eq_succ_of_not_last
        returnStart period k hk hlast]
  · intro i j hi hj hstate
    exact hcycleSimple i j (by simpa [period] using hi)
      (by simpa [period] using hj) hstate
  · intro i j hi hj
    exact hprefixCycleDisjoint i j hi (by simpa [period] using hj)
  · simpa using hreturnStart
  · intro i _hi
    omega
  · intro i hi
    dsimp [period] at hi
    omega

/--
If the prefix is already simple/disjoint and the recurrent return segment is a
minimal equal-state gap, then the pure loop-erasure witness follows.

This packages the previous minimal-gap kernel with the already-simple
constructor.  The arbitrary loop-erasure proof still has to choose or produce
such a minimal-gap segment and a compatible simple prefix.
-/
theorem exists_loopErasedRecurrentReturnLassoWitness_of_simple_prefix_minimal_returnSegment
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (sourceState : Nat -> GameState T)
    (sourceEnv : EnvironmentSequence In₁ In₂)
    (recurrentState : GameState T)
    {returnStart returnStop : Nat}
    (hreturnLt : returnStart < returnStop)
    (hreturnStart : sourceState returnStart = recurrentState)
    (hreturnStop : sourceState returnStop = recurrentState)
    (hminimal :
      ∀ a b : Nat,
        returnStart ≤ a ->
        a < b ->
        b ≤ returnStop ->
        sourceState a = sourceState b ->
          returnStop - returnStart ≤ b - a)
    (hprefixSimple :
      ∀ i j : Nat,
        i < returnStart ->
        j < returnStart ->
        sourceState i = sourceState j ->
          i = j)
    (hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < returnStart ->
        j < returnStop - returnStart ->
          sourceState i ≠ sourceState (returnStart + j)) :
    Nonempty
      (RoundAwareLoopErasedRecurrentReturnLassoWitness
        T sourceState sourceEnv recurrentState returnStart returnStop) := by
  exact
    exists_loopErasedRecurrentReturnLassoWitness_of_simple_source_returnSegment
      sourceState sourceEnv recurrentState
      hreturnLt hreturnStart hreturnStop
      hprefixSimple
      (sourceState_cycleSimple_of_minimal_equal_state_gap
        sourceState hreturnLt hminimal)
      hprefixCycleDisjoint

/--
Embedded source-edge form of the selected-lasso producer.

This is the interface expected from the recurrent-return/loop-erasure proof:
it may assemble the selected prefix/cycle from legal source-stream transitions,
not necessarily from one contiguous segment of the rejected word.  For each
selected bounded index `k`, `edgeTime k` names a source transition whose source
state and environment label are the selected state/label at `k`, and whose
target is the selected successor (with the last cycle edge closing through
`selectedLassoNextIndex`).  The coherent source stream then supplies the
transition and DPA-progress fields of `RoundAwareSelectedLassoCycleWitnessData`.
-/
def roundAwareSelectedLassoCycleWitnessData_of_embedded_source_edges
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (sourceState : Nat -> GameState T)
    (sourceEnv : EnvironmentSequence In₁ In₂)
    (stateAt : Nat -> GameState T)
    (envAt : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    (edgeTime : Nat -> Nat)
    (start period witness p : Nat)
    (hperiodPositive : 0 < period)
    (hsourceInit : sourceState 0 = Sum.inl initialBoundary)
    (hsourceStep :
      ∀ n : Nat,
        sourceState (n + 1) =
          roundAwareGameTransition T controller (sourceState n) (sourceEnv n))
    (hdpaSourceInit : dpaOf (sourceState 0) = A.initial)
    (hdpaSourceStep :
      ∀ n : Nat,
        dpaOf (sourceState (n + 1)) =
          A.step (dpaOf (sourceState n))
            (roundAwareWordOfStateStream T controller sourceState sourceEnv n))
    (hselectedInit : stateAt 0 = sourceState 0)
    (hselectedSource :
      ∀ k : Nat,
        k < start + period ->
          stateAt k = sourceState (edgeTime k))
    (hselectedEnv :
      ∀ k : Nat,
        k < start + period ->
          envAt k = sourceEnv (edgeTime k))
    (hselectedTarget :
      ∀ k : Nat,
        k < start + period ->
          stateAt (selectedLassoNextIndex start period k) =
            sourceState (edgeTime k + 1))
    (hprefixSimple :
      ∀ i j : Nat,
        i < start ->
        j < start ->
        stateAt i = stateAt j ->
          i = j)
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        stateAt (start + i) = stateAt (start + j) ->
          i = j)
    (hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < start ->
        j < period ->
          stateAt i ≠ stateAt (start + j))
    (hwitnessLt : witness < period)
    (hwitnessPrioritySource :
      A.priority
        (dpaOf (sourceState (edgeTime (start + witness)))) = p)
    (hcycleLowerSource :
      ∀ i : Nat,
        i < period ->
          p ≤
            A.priority
              (dpaOf (sourceState (edgeTime (start + i)))))
    (hpOdd : ¬ DetParityAutomaton.NatEven p) :
    RoundAwareSelectedLassoCycleWitnessData
      T initialBoundary controller A dpaOf := by
  refine
    {
      stateAt := stateAt
      envAt := envAt
      start := start
      period := period
      witness := witness
      p := p
      periodPositive := hperiodPositive
      init := ?_
      stepBounded := ?_
      prefixSimple := hprefixSimple
      cycleSimple := hcycleSimple
      prefixCycleDisjoint := hprefixCycleDisjoint
      dpaInit := ?_
      dpaStepBounded := ?_
      witnessLt := hwitnessLt
      witnessPriority := ?_
      cycleLower := ?_
      odd := hpOdd
    }
  · rw [hselectedInit, hsourceInit]
  · intro k hk
    calc
      stateAt (selectedLassoNextIndex start period k)
          = sourceState (edgeTime k + 1) := hselectedTarget k hk
      _ = roundAwareGameTransition T controller
            (sourceState (edgeTime k)) (sourceEnv (edgeTime k)) :=
            hsourceStep (edgeTime k)
      _ = roundAwareGameTransition T controller
            (stateAt k) (envAt k) := by
            rw [hselectedSource k hk, hselectedEnv k hk]
  · rw [hselectedInit, hdpaSourceInit]
  · intro k hk
    calc
      dpaOf (stateAt (selectedLassoNextIndex start period k))
          = dpaOf (sourceState (edgeTime k + 1)) := by
            rw [hselectedTarget k hk]
      _ = A.step (dpaOf (sourceState (edgeTime k)))
            (roundAwareWordOfStateStream
              T controller sourceState sourceEnv (edgeTime k)) :=
            hdpaSourceStep (edgeTime k)
      _ = A.step (dpaOf (stateAt k))
            {
              inputOne := (envAt k).inputOne
              inputTwo := (envAt k).inputTwo
              graph := (envAt k).graph
              outputOne := (controller (stateAt k) (envAt k)).1
              outputTwo := (controller (stateAt k) (envAt k)).2
            } := by
            rw [hselectedSource k hk, hselectedEnv k hk]
            simp [roundAwareWordOfStateStream]
  · have hwWindow : start + witness < start + period := by
      omega
    calc
      A.priority (dpaOf (stateAt (start + witness)))
          =
            A.priority
              (dpaOf (sourceState (edgeTime (start + witness)))) := by
            rw [hselectedSource (start + witness) hwWindow]
      _ = p := hwitnessPrioritySource
  · intro i hi
    have hiWindow : start + i < start + period := by
      omega
    calc
      p ≤
          A.priority
            (dpaOf (sourceState (edgeTime (start + i)))) :=
            hcycleLowerSource i hi
      _ =
          A.priority (dpaOf (stateAt (start + i))) := by
            rw [hselectedSource (start + i) hiWindow]

/--
Loop-erased recurrent-return witnesses produce selected-lasso data.

The loop-erasure witness supplies only combinatorial information.  The odd
witness priority and the no-lower cycle bound are inherited here from the
recurrent-return state and cutoff.
-/
def roundAwareSelectedLassoCycleWitnessData_of_loopErased_recurrentReturn
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (sourceState : Nat -> GameState T)
    (sourceEnv : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    {p : Nat}
    {recurrentState : GameState T}
    {returnStart returnStop : Nat}
    (hsourceInit : sourceState 0 = Sum.inl initialBoundary)
    (hsourceStep :
      ∀ n : Nat,
        sourceState (n + 1) =
          roundAwareGameTransition T controller (sourceState n) (sourceEnv n))
    (hdpaSourceInit : dpaOf (sourceState 0) = A.initial)
    (hdpaSourceStep :
      ∀ n : Nat,
        dpaOf (sourceState (n + 1)) =
          A.step (dpaOf (sourceState n))
            (roundAwareWordOfStateStream T controller sourceState sourceEnv n))
    (hrecurrentPriority : A.priority (dpaOf recurrentState) = p)
    (hcycleLowerFromReturn :
      ∀ k : Nat,
        returnStart ≤ k ->
          p ≤ A.priority (dpaOf (sourceState k)))
    (hpOdd : ¬ DetParityAutomaton.NatEven p)
    (lasso :
      RoundAwareLoopErasedRecurrentReturnLassoWitness
        T sourceState sourceEnv recurrentState returnStart returnStop) :
    RoundAwareSelectedLassoCycleWitnessData
      T initialBoundary controller A dpaOf := by
  exact
    roundAwareSelectedLassoCycleWitnessData_of_embedded_source_edges
      T initialBoundary controller A sourceState sourceEnv
      lasso.stateAt lasso.envAt dpaOf lasso.edgeTime
      lasso.start lasso.period lasso.witness p
      lasso.periodPositive hsourceInit hsourceStep
      hdpaSourceInit hdpaSourceStep
      lasso.selectedInit lasso.selectedSource lasso.selectedEnv
      lasso.selectedTarget lasso.prefixSimple lasso.cycleSimple
      lasso.prefixCycleDisjoint lasso.witnessLt
      (by
        rw [lasso.witnessState]
        exact hrecurrentPriority)
      (by
        intro i hi
        exact
          hcycleLowerFromReturn
            (lasso.edgeTime (lasso.start + i))
            (lasso.cycleEdgeAfterReturnStart i hi))
      hpOdd

/--
Rejected enriched-progress streams yield selected-lasso data once the pure
loop-erasure witness is available for the recurrent return chosen by Lean.

This parameterized adapter is kept for callers that want to supply a custom
loop-erasure witness provider.  The theorem immediately below discharges this
input with the checked recurrent-return producer.
-/
theorem exists_roundAwareSelectedLassoCycleWitnessData_of_rejected_dpaProgress_stateStream_of_loopErasedRecurrentReturn
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (sourceState : Nat -> GameState T)
    (sourceEnv : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    [Fintype (GameState T)]
    (hsourceInit : sourceState 0 = Sum.inl initialBoundary)
    (hsourceStep :
      ∀ n : Nat,
        sourceState (n + 1) =
          roundAwareGameTransition T controller (sourceState n) (sourceEnv n))
    (hdpaSourceInit : dpaOf (sourceState 0) = A.initial)
    (hdpaSourceStep :
      ∀ n : Nat,
        dpaOf (sourceState (n + 1)) =
          A.step (dpaOf (sourceState n))
            (roundAwareWordOfStateStream T controller sourceState sourceEnv n))
    (hreject :
      ¬ A.Accepts
        (roundAwareWordOfStateStream T controller sourceState sourceEnv))
    (hloop :
      ∀ (p : Nat)
        (recurrentState : GameState T)
        (returnStart returnStop : Nat),
          returnStart < returnStop ->
          A.priority (dpaOf recurrentState) = p ->
          sourceState returnStart = recurrentState ->
          sourceState returnStop = recurrentState ->
          (∀ k : Nat,
            returnStart ≤ k ->
              p ≤ A.priority (dpaOf (sourceState k))) ->
          ¬ DetParityAutomaton.NatEven p ->
            Nonempty
              (RoundAwareLoopErasedRecurrentReturnLassoWitness
                T sourceState sourceEnv recurrentState
                returnStart returnStop)) :
    Nonempty
      (RoundAwareSelectedLassoCycleWitnessData
