/--
Synchronized state choices for self-compatible finite-lambda words.

The single stream is the finite replay object the reversal proof has to build:
it follows the controller transition on the environment read from the word, is
repeat-consistent, and carries both processes' non-fringe histories plus the
current fringe arguments read from the word's own prefixes.
-/
def RoundAwareLambdaControllerSelfCompatibleExecutionSynchronizedStateChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T) : Prop :=
  stateStream 0 = Sum.inl initialBoundary ∧
    (∀ n : Nat,
      stateStream (n + 1) =
        roundAwareGameTransition T controller.1
          (stateStream n) (environmentRoundOfWord word n)) ∧
    (∀ i j : Nat,
      stateStream i = stateStream j ->
        environmentRoundOfWord word i = environmentRoundOfWord word j) ∧
    (∀ n : Nat,
      let envRound := environmentRoundOfWord word n
      historyOne (stateStream n) envRound =
          historyOfViewOne
            (nextView Proc.one (wordPrefix word n) envRound) ∧
        fringeOne (stateStream n) envRound =
          fringeOfViewOne
            (nextView Proc.one (wordPrefix word n) envRound) ∧
        historyTwo (stateStream n) envRound =
          historyOfViewTwo
            (nextView Proc.two (wordPrefix word n) envRound) ∧
        fringeTwo (stateStream n) envRound =
          fringeOfViewTwo
            (nextView Proc.two (wordPrefix word n) envRound) ∧
        word n =
          {
            inputOne := envRound.inputOne
            inputTwo := envRound.inputTwo
            graph := envRound.graph
            outputOne := (controller.1 (stateStream n) envRound).1
            outputTwo := (controller.1 (stateStream n) envRound).2
          })

/-- Paper-facing alias for the self-compatible lambda-choice stream. -/
abbrev RoundAwareLambdaControllerSelfCompatibleExecutionLambdaChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T) : Prop :=
  RoundAwareLambdaControllerSelfCompatibleExecutionSynchronizedStateChoices
    T initialBoundary historyOne historyTwo fringeOne fringeTwo controller
    historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
    word stateStream

/--
The concrete no-direct prefix state stream is a self-compatible lambda-choice
stream once the reversal analysis supplies repeat consistency and the
non-fringe/fringe tracking equations for that same stream.
-/
theorem noDirectEpochStateAfterHistory_selfCompatibleLambdaChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (historyOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        uniform.noDirectEpochTransformer
        historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hconsistent :
      ∀ i j : Nat,
        uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word i) =
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word j) ->
        environmentRoundOfWord word i = environmentRoundOfWord word j)
    (hchoice :
      ∀ n : Nat,
        let state :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word n)
        let envRound := environmentRoundOfWord word n
        historyOne state envRound =
            historyOfViewOne
              (nextView Proc.one (wordPrefix word n) envRound) ∧
          fringeOne state envRound =
            fringeOfViewOne
              (nextView Proc.one (wordPrefix word n) envRound) ∧
          historyTwo state envRound =
            historyOfViewTwo
              (nextView Proc.two (wordPrefix word n) envRound) ∧
          fringeTwo state envRound =
            fringeOfViewTwo
              (nextView Proc.two (wordPrefix word n) envRound) ∧
          word n =
            {
              inputOne := envRound.inputOne
              inputTwo := envRound.inputTwo
              graph := envRound.graph
              outputOne := (controller.1 state envRound).1
              outputTwo := (controller.1 state envRound).2
            }) :
    RoundAwareLambdaControllerSelfCompatibleExecutionLambdaChoices
      uniform.noDirectEpochTransformer initialBoundary
      historyOne historyTwo fringeOne fringeTwo controller
      historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
      word
      (fun n =>
        uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word n)) := by
  refine ⟨?_, ?_, hconsistent, hchoice⟩
  · rfl
  · intro n
    let state :=
      uniform.noDirectEpochStateAfterHistory initialBoundary
        (wordPrefix word n)
    let envRound := environmentRoundOfWord word n
    have hword :
        word n =
          {
            inputOne := envRound.inputOne
            inputTwo := envRound.inputTwo
            graph := envRound.graph
            outputOne := (controller.1 state envRound).1
            outputTwo := (controller.1 state envRound).2
          } := by
      exact (hchoice n).2.2.2.2
    change
      uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word (n + 1)) =
        roundAwareGameTransition uniform.noDirectEpochTransformer controller.1
          state envRound
    rw [wordPrefix_succ]
    rw [
      UniformOneDirectionalFiniteIndexLemma.noDirectEpochStateAfterHistory_append_round
        uniform initialBoundary (wordPrefix word n) (word n)
    ]
    rw [hword]
    change
      uniform.noDirectEpochStateTransition state
          {
            inputOne := envRound.inputOne
            inputTwo := envRound.inputTwo
            graph := envRound.graph
            outputOne := (controller.1 state envRound).1
            outputTwo := (controller.1 state envRound).2
          } =
        roundAwareGameTransition uniform.noDirectEpochTransformer controller.1
          state envRound
    exact
      noDirectEpochStateTransition_eq_roundAwareGameTransition
        uniform controller.1 state envRound

