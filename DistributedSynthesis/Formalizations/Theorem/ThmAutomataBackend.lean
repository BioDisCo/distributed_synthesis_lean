    (historyOfViewOne :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        View In₁ In₂ Proc.one -> List (H₁ A))
    (historyOfViewTwo :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        View In₁ In₂ Proc.two -> List (H₂ A))
    (fringeOfViewOne :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        View In₁ In₂ Proc.one -> R₁ A)
    (fringeOfViewTwo :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        View In₁ In₂ Proc.two -> R₂ A)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (dynamicHierarchy parityObjective :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        Prop)
    (dynamicHierarchy_proof :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        dynamicHierarchy A)
    (parityObjective_proof :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        parityObjective A)
    (actualLambdaChoices :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ controller :
          (transformer A).RoundAwareLambdaControllerCode
            (historyOne A) (historyTwo A) (fringeOne A) (fringeTwo A),
          ∀ env : EnvironmentSequence In₁ In₂,
            ∃ stateStream : Nat -> FiniteEpochTransformer.GameState (transformer A),
              FiniteEpochTransformer.RoundAwareLambdaControllerCompatibleExecutionLambdaChoices
                (transformer A) (initialBoundary A)
                (historyOne A) (historyTwo A)
                (fringeOne A) (fringeTwo A) controller
                (historyOfViewOne A) (historyOfViewTwo A)
                (fringeOfViewOne A) (fringeOfViewTwo A)
                (FiniteEpochTransformer.strategyOfRoundAwareLambdaController
                  (transformer A) (historyOne A) (historyTwo A)
                  (fringeOne A) (fringeTwo A) controller
                  (historyOfViewOne A) (historyOfViewTwo A)
                  (fringeOfViewOne A) (fringeOfViewTwo A)
                  defaultOne defaultTwo)
                env
                (execution
                  (FiniteEpochTransformer.strategyOfRoundAwareLambdaController
                    (transformer A) (historyOne A) (historyTwo A)
                    (fringeOne A) (fringeTwo A) controller
                    (historyOfViewOne A) (historyOfViewTwo A)
                    (fringeOfViewOne A) (fringeOfViewTwo A)
                    defaultOne defaultTwo)
                  env)
                stateStream)
    (matchingControllers :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
          ∃ controller :
            (transformer A).RoundAwareLambdaControllerCode
              (historyOne A) (historyTwo A) (fringeOne A) (fringeTwo A),
            FiniteEpochTransformer.RoundAwareLambdaControllerStrategyMatchesFiniteViews
              (transformer A) (historyOne A) (historyTwo A)
              (fringeOne A) (fringeTwo A) controller
              (historyOfViewOne A) (historyOfViewTwo A)
              (fringeOfViewOne A) (fringeOfViewTwo A) σ ∧
            ∀ environment : (transformer A).EnvironmentCode,
              ∀ n : Nat,
                let env : EnvironmentSequence In₁ In₂ :=
                  (transformer A).roundAwareEnvironmentSequenceOfGamePlay
                    (initialBoundary A) controller.1 environment
                let state :=
                  (transformer A).roundAwareGameStateStream
                    (initialBoundary A) controller.1 environment n
                let envRound := environment state
                historyOne A state envRound =
                    historyOfViewOne A
                      (nextView Proc.one
                        (executionPrefix σ env n) (env n)) ∧
                  fringeOne A state envRound =
                    fringeOfViewOne A
                      (nextView Proc.one
                        (executionPrefix σ env n) (env n)) ∧
                  historyTwo A state envRound =
                    historyOfViewTwo A
                      (nextView Proc.two
                        (executionPrefix σ env n) (env n)) ∧
                  fringeTwo A state envRound =
                    fringeOfViewTwo A
                      (nextView Proc.two
                        (executionPrefix σ env n) (env n))) :
    DPARoundAwareLambdaRotatingRationalRunEpochCompiler.{u, v, w, a, b, x, y, z}
      In₁ In₂ Out₁ Out₂ where
  compile := fun A =>
    RoundAwareLambdaRotatingRationalRunEpochBackendCertificate.ofActualLambdaChoicesAndFiniteViewStateDecoders
      A (Branch A) (Label A) (target A) (targetNonempty A)
      (transformer A) (initialBoundary A) (automaton_equiv A)
      (historyOne A) (historyTwo A) (fringeOne A) (fringeTwo A)
      (historyOfViewOne A) (historyOfViewTwo A)
      (fringeOfViewOne A) (fringeOfViewTwo A)
      defaultOne defaultTwo
      (dynamicHierarchy A) (parityObjective A)
      (dynamicHierarchy_proof A) (parityObjective_proof A)
      (actualLambdaChoices A)
      (matchingControllers A)

/--
Uniform lambda-local rotating compiler from self-compatible rejected lambda
choices.

This is the compiler-level surface for the finite-game compilation hypotheses:
actual plays are tracked by finite summaries/fringe arguments, while rejected
candidate words are replayed from their own prefixes through synchronized
lambda-state choices.
-/
noncomputable def ofRejectedSelfCompatibleLambdaChoicesAndFiniteViewStateDecoders
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (Branch :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        Proc -> Type b)
    (Label :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        Proc -> Type x)
