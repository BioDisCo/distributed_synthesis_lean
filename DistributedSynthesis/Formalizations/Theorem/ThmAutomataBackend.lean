stabilized truth atoms.

This is a concrete journal-facing wrapper around
`noDirectDPASynthesisDecidable_of_truthVectorQuotientCertificate`: provide a
truth label and bounded generated representative for every history, coherent
truth correctness, and enriched-state invariance under equal stabilized truth
atoms.
-/
noncomputable def noDirectDPASynthesisDecidable_of_representatives
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {AState : Type (max u v w a b)}
    [Fintype AState]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    {SatAlphabet : Type (max u v w a)}
    {Boundary : Type (max u v w a)}
    {EdgeType : Type b}
    {ParityProgress : Type (max u v w a b)}
    {sat :
      RegularTestSaturation.{max u v w a, b, max u v w a, u, v,
        max (max u v w a) b}
        SatAlphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v w a, u, v, w, a, b}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (cert : StabilizedSaturationBasisCertificate sat n)
    (edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType)
    (sameParityOutcomes :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      Prop)
    (containmentOrder :
      ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
      NonFringeContainmentOrder)
    (orderOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder)
    (automatonOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> AState)
    (parityOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress)
    (sameParityOfProgress :
      ∀ c c' :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
        parityOfHistory c.1.history = parityOfHistory c'.1.history ->
          sameParityOutcomes c.1 c'.1)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (generationBound : Nat)
    (truthOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ ->
        RegularTestTruthAtom (stabilizedSaturationBasis cert))
    (envsOfHistory :
      History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂))
    (envs_bound :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        (envsOfHistory h).length ≤ generationBound)
    (envs_truth :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound
            (executionPrefixFromList σ (envsOfHistory h))) =
          truthOfHistory h)
    (truthOfHistory_eq :
      ∀ c :
        CoherentContinuationConfiguration
          containmentOrder orderOfHistory automatonOfHistory,
      truthOfHistory c.1.history =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound c.1.history))
    (enrichedState_eq_of_truth_eq :
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis cert)
            (pathOfHistoryByRound edgeOfRound h') ->
        uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory h =
          uniform.noDirectEpochStateWithAContinuationData
            initialBoundary orderOfHistory automatonOfHistory parityOfHistory h')
    (updateClosed : Prop)
    (updateClosed_proof : updateClosed)
    (preservesDynamicHierarchy : Prop)
    (preservesDynamicHierarchy_proof : preservesDynamicHierarchy)
    (finiteFringeCompilation : Prop)
    (finiteFringeCompilation_proof : finiteFringeCompilation)
    (boundaryAndBlockTransitionsEffective : Prop)
    (boundaryAndBlockTransitionsEffective_proof :
      boundaryAndBlockTransitionsEffective)
    (continuationPreservedBlockByBlock : Prop)
    (continuationPreservedBlockByBlock_proof :
      continuationPreservedBlockByBlock)
    (transitionRelationEffective : Prop)
    (transitionRelationEffective_proof : transitionRelationEffective)
    (finiteGame :
      FiniteDynamicHierarchyParityGame.{max u v w a b,
        max u v w a b})
    (finiteGameRealizableIff :
      finiteGame.realizable ↔
        ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
          ∀ env : EnvironmentSequence In₁ In₂,
            A.Accepts (execution σ env)) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  noDirectDPASynthesisDecidable_of_truthVectorQuotientCertificate
    A uniform initialBoundary cert edgeOfRound sameParityOutcomes
    containmentOrder orderOfHistory automatonOfHistory parityOfHistory
    sameParityOfProgress σ generationBound
    (StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representatives
      uniform initialBoundary cert edgeOfRound containmentOrder orderOfHistory
      automatonOfHistory parityOfHistory σ generationBound truthOfHistory
      envsOfHistory envs_bound envs_truth truthOfHistory_eq
      enrichedState_eq_of_truth_eq)
    updateClosed updateClosed_proof preservesDynamicHierarchy
    preservesDynamicHierarchy_proof finiteFringeCompilation
    finiteFringeCompilation_proof boundaryAndBlockTransitionsEffective
    boundaryAndBlockTransitionsEffective_proof continuationPreservedBlockByBlock
    continuationPreservedBlockByBlock_proof transitionRelationEffective
    transitionRelationEffective_proof finiteGame finiteGameRealizableIff

