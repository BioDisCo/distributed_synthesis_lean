/--
Uniform round-aware rotating-rational-run compiler from explicit soundness and
round-aware state-view decoders.

This is the compiler-level completion handler for the finite-game compilation
completeness side: the caller supplies the paper's soundness bridge for
round-aware finite controllers plus the local-view decoder theorem; Lean
derives matching controllers and hence the finite-game completeness boundary.
-/
noncomputable def ofRoundAwareSoundAndStateViewDecoders
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (Branch :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        Proc -> Type b)
    (Label :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        Proc -> Type x)
    (target :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        (d : Proc) -> InputFreeParityTreeAutomaton.{b, x, y}
          (Branch A d) (Label A d))
    (targetNonempty :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ d : Proc,
          ∃ tree : LabeledTree (Branch A d) (Label A d),
            (target A d).acceptsTree tree)
    (transformer :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (gameStateDecidable :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        DecidableEq (FiniteEpochTransformer.GameState (transformer A)))
    (initialBoundary :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        (transformer A).boundary)
    (automaton_equiv :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
          (transformer A).automaton.Accepts word ↔ A.Accepts word)
    (controllerStrategy :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        (transformer A).RoundAwareControllerCode -> StrategyPair In₁ In₂ Out₁ Out₂)
    (dynamicHierarchy parityObjective :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        Prop)
    (dynamicHierarchy_proof :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        dynamicHierarchy A)
    (parityObjective_proof :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        parityObjective A)
    (soundBoundary :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        letI : DecidableEq (FiniteEpochTransformer.GameState (transformer A)) :=
          gameStateDecidable A
        ∀ controller : (transformer A).RoundAwareControllerCode,
          (∀ environment : (transformer A).EnvironmentCode,
            (transformer A).roundAwareGameWins
              (initialBoundary A) controller environment) ->
            ∀ env : EnvironmentSequence In₁ In₂,
              A.Accepts (execution ((controllerStrategy A) controller) env))
    (viewOne :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        FiniteEpochTransformer.GameState (transformer A) ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        FiniteEpochTransformer.GameState (transformer A) ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (stateViewDecoders :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        letI : DecidableEq (FiniteEpochTransformer.GameState (transformer A)) :=
          gameStateDecidable A
        FiniteEpochTransformer.RoundAwareGameExecutionStateViewDecodersSimulateStrategies
          (transformer A) (initialBoundary A) (viewOne A) (viewTwo A)) :
    DPARoundAwareRotatingRationalRunEpochCompiler.{u, v, w, a, b, x, y, z}
      In₁ In₂ Out₁ Out₂ where
  compile := by
    intro A
    letI : DecidableEq (FiniteEpochTransformer.GameState (transformer A)) :=
      gameStateDecidable A
    exact
      RoundAwareRotatingRationalRunEpochBackendCertificate.ofRoundAwareSoundAndStateViewDecoders
        A (Branch A) (Label A) (target A) (targetNonempty A)
        (transformer A) (initialBoundary A) (automaton_equiv A)
        (controllerStrategy A)
        (dynamicHierarchy A) (parityObjective A)
        (dynamicHierarchy_proof A) (parityObjective_proof A)
        (soundBoundary A) (viewOne A) (viewTwo A) (stateViewDecoders A)

/--
Uniform round-aware rotating-rational-run compiler from execution
