Actual-execution finite-lambda choices from the no-direct epoch stream.

This is the finite-lambda analogue of the older full-view actual branch: once
the no-direct stream is repeat-consistent and carries the finite summaries and
fringe arguments of the real local views, it is a synchronized lambda-choice
stream for the real execution of the extracted lambda strategy.
-/
theorem noDirectEpochStateStream_actualLambdaChoices_lambdaController
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (historyOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        uniform.noDirectEpochTransformer
        historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (hconsistent :
      ∀ i j : Nat,
        uniform.noDirectEpochStateStream initialBoundary
            (strategyOfRoundAwareLambdaController
              uniform.noDirectEpochTransformer
              historyOne historyTwo fringeOne fringeTwo controller
              historyOfViewOne historyOfViewTwo
              fringeOfViewOne fringeOfViewTwo
              defaultOne defaultTwo)
            env i =
          uniform.noDirectEpochStateStream initialBoundary
            (strategyOfRoundAwareLambdaController
              uniform.noDirectEpochTransformer
              historyOne historyTwo fringeOne fringeTwo controller
              historyOfViewOne historyOfViewTwo
              fringeOfViewOne fringeOfViewTwo
              defaultOne defaultTwo)
            env j ->
        env i = env j)
    (hactual :
      ∀ n : Nat,
        let σ :=
          strategyOfRoundAwareLambdaController
            uniform.noDirectEpochTransformer
            historyOne historyTwo fringeOne fringeTwo controller
            historyOfViewOne historyOfViewTwo
            fringeOfViewOne fringeOfViewTwo
            defaultOne defaultTwo
        let state := uniform.noDirectEpochStateStream initialBoundary σ env n
        historyOne state (env n) =
            historyOfViewOne
              (nextView Proc.one (executionPrefix σ env n) (env n)) ∧
          fringeOne state (env n) =
            fringeOfViewOne
              (nextView Proc.one (executionPrefix σ env n) (env n)) ∧
          historyTwo state (env n) =
            historyOfViewTwo
              (nextView Proc.two (executionPrefix σ env n) (env n)) ∧
          fringeTwo state (env n) =
            fringeOfViewTwo
              (nextView Proc.two (executionPrefix σ env n) (env n))) :
    RoundAwareLambdaControllerCompatibleExecutionLambdaChoices
      uniform.noDirectEpochTransformer initialBoundary
      historyOne historyTwo fringeOne fringeTwo controller
      historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
      (strategyOfRoundAwareLambdaController
        uniform.noDirectEpochTransformer
        historyOne historyTwo fringeOne fringeTwo controller
        historyOfViewOne historyOfViewTwo
        fringeOfViewOne fringeOfViewTwo
        defaultOne defaultTwo)
      env
      (execution
        (strategyOfRoundAwareLambdaController
          uniform.noDirectEpochTransformer
          historyOne historyTwo fringeOne fringeTwo controller
          historyOfViewOne historyOfViewTwo
          fringeOfViewOne fringeOfViewTwo
          defaultOne defaultTwo)
        env)
      (uniform.noDirectEpochStateStream initialBoundary
        (strategyOfRoundAwareLambdaController
          uniform.noDirectEpochTransformer
          historyOne historyTwo fringeOne fringeTwo controller
          historyOfViewOne historyOfViewTwo
          fringeOfViewOne fringeOfViewTwo
          defaultOne defaultTwo)
        env) := by
  let σ :=
    strategyOfRoundAwareLambdaController
      uniform.noDirectEpochTransformer
      historyOne historyTwo fringeOne fringeTwo controller
      historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
      defaultOne defaultTwo
  constructor
  · rfl
  constructor
  · exact
      noDirectEpochStateStream_succ_eq_roundAwareGameTransition_of_lambdaController
        uniform initialBoundary
        historyOne historyTwo fringeOne fringeTwo controller
        historyOfViewOne historyOfViewTwo
        fringeOfViewOne fringeOfViewTwo
        defaultOne defaultTwo env hactual
  constructor
  · exact hconsistent
  · intro n
    rcases hactual n with
      ⟨hhistoryOne, hfringeOne, hhistoryTwo, hfringeTwo⟩
    refine ⟨hhistoryOne, hfringeOne, hhistoryTwo, hfringeTwo, ?_⟩
    rw [execution_apply]
    let state := uniform.noDirectEpochStateStream initialBoundary σ env n
    have hone :
        σ.one (nextView Proc.one (executionPrefix σ env n) (env n)) =
          (controller.1 state (env n)).1 :=
      strategyOneOfRoundAwareLambdaController_apply_decoded
        uniform.noDirectEpochTransformer
        historyOne historyTwo fringeOne fringeTwo controller
        historyOfViewOne fringeOfViewOne defaultOne
        state (env n)
        (nextView Proc.one (executionPrefix σ env n) (env n))
        hhistoryOne hfringeOne
    have htwo :
        σ.two (nextView Proc.two (executionPrefix σ env n) (env n)) =
          (controller.1 state (env n)).2 :=
      strategyTwoOfRoundAwareLambdaController_apply_decoded
        uniform.noDirectEpochTransformer
        historyOne historyTwo fringeOne fringeTwo controller
        historyOfViewTwo fringeOfViewTwo defaultTwo
        state (env n)
        (nextView Proc.two (executionPrefix σ env n) (env n))
        hhistoryTwo hfringeTwo
    cases henv : env n with
    | mk inputOne inputTwo graph =>
        have honeEnv :
            σ.one
                (nextView Proc.one (executionPrefix σ env n)
                  { inputOne := inputOne, inputTwo := inputTwo, graph := graph }) =
              (controller.1 state
                  { inputOne := inputOne, inputTwo := inputTwo, graph := graph }).1 := by
          simpa [henv] using hone
        have htwoEnv :
            σ.two
                (nextView Proc.two (executionPrefix σ env n)
                  { inputOne := inputOne, inputTwo := inputTwo, graph := graph }) =
              (controller.1 state
                  { inputOne := inputOne, inputTwo := inputTwo, graph := graph }).2 := by
          simpa [henv] using htwo
        simpa [nextRound] using And.intro honeEnv htwoEnv

theorem roundAwareLambdaController_rejectedCompatibleWordsRepresentable_of_synchronizedStateChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hsync :
      ∀ (env : EnvironmentSequence In₁ In₂)
        (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          RoundAwareLambdaControllerCompatibleExecution
            T historyOne historyTwo fringeOne fringeTwo controller
            historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
            σ env word ->
          ¬ A.Accepts word ->
            ∃ stateStream : Nat -> GameState T,
              RoundAwareLambdaControllerCompatibleExecutionSynchronizedStateChoices
                T initialBoundary
                historyOne historyTwo fringeOne fringeTwo controller
                historyOfViewOne historyOfViewTwo
                fringeOfViewOne fringeOfViewTwo
                σ env word stateStream) :
    ∀ (env : EnvironmentSequence In₁ In₂)
      (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
        RoundAwareLambdaControllerCompatibleExecution
          T historyOne historyTwo fringeOne fringeTwo controller
          historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
          σ env word ->
        ¬ A.Accepts word ->
          ∃ environment : EnvironmentCode T,
            roundAwareGameExecution T initialBoundary controller.1
              environment =
              word := by
  intro env word hcompatible hreject
  rcases hsync env word hcompatible hreject with ⟨stateStream, hstream⟩
  rcases hstream with ⟨hinit, hstep, hconsistent, hchoice⟩
  let environment := environmentCodeOfStateStream T stateStream env
  refine ⟨environment, ?_⟩
  funext n
  have hstate :
      roundAwareGameStateStream T initialBoundary controller.1
          environment n =
        stateStream n :=
    roundAwareGameStateStream_environmentCodeOfStateStream_eq
      T initialBoundary controller.1 stateStream env
      hinit hstep hconsistent n
  have henv :
      environment (stateStream n) = env n :=
    environmentCodeOfStateStream_apply_of_consistent
      T stateStream env hconsistent n
  rw [(hchoice n).2.2.2.2]
  simp [roundAwareGameExecution, nextRound, environment, hstate, henv]

