              uniform.noDirectEpochTransformer initialBoundary
              controller environment) n) =
        roundAwareGameStateStream
          uniform.noDirectEpochTransformer initialBoundary
          controller environment n := by
  intro n
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [wordPrefix_succ]
      rw [
        UniformOneDirectionalFiniteIndexLemma.noDirectEpochStateAfterHistory_append_round
          uniform initialBoundary
          (wordPrefix
            (roundAwareGameExecution
              uniform.noDirectEpochTransformer initialBoundary
              controller environment) n)
          ((roundAwareGameExecution
              uniform.noDirectEpochTransformer initialBoundary
              controller environment) n)
      ]
      rw [ih]
      let state :=
        roundAwareGameStateStream
          uniform.noDirectEpochTransformer initialBoundary controller
          environment n
      let envRound := environment state
      simpa [roundAwareGameExecution, state, envRound] using
        noDirectEpochStateTransition_eq_roundAwareGameTransition
          uniform controller state envRound

/--
Exact round-aware finite replay supplies repeat consistency for the concrete
no-direct prefix state stream.
-/
theorem noDirectEpochStateAfterHistory_prefixConsistent_of_roundAwareGameExecution
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (controller : RoundAwareControllerCode uniform.noDirectEpochTransformer)
    (environment : EnvironmentCode uniform.noDirectEpochTransformer)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hreplay :
      roundAwareGameExecution
        uniform.noDirectEpochTransformer initialBoundary
        controller environment = word) :
    ∀ i j : Nat,
      uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word i) =
        uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word j) ->
      environmentRoundOfWord word i = environmentRoundOfWord word j := by
  intro i j hsame
  let generated :=
    roundAwareGameExecution
      uniform.noDirectEpochTransformer initialBoundary controller environment
  have hprefix :
      ∀ n : Nat,
        uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word n) =
          roundAwareGameStateStream
            uniform.noDirectEpochTransformer initialBoundary
            controller environment n := by
    intro n
    rw [← hreplay]
    exact
      noDirectEpochStateAfterHistory_roundAwareGameExecution_prefix
        uniform initialBoundary controller environment n
  have hstate :
      roundAwareGameStateStream
          uniform.noDirectEpochTransformer initialBoundary
          controller environment i =
        roundAwareGameStateStream
          uniform.noDirectEpochTransformer initialBoundary
          controller environment j := by
    rw [← hprefix i, ← hprefix j]
    exact hsame
  rw [← hreplay]
  simp [environmentRoundOfWord, roundAwareGameExecution, hstate]

/--
Exact round-aware finite replay supplies the output component of the concrete
no-direct prefix-state lambda choices.  The only extra input is the semantic
tracking of the two finite histories and fringe arguments by that prefix state.
-/
theorem noDirectEpochStateAfterHistory_prefixChoices_of_roundAwareGameExecution
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (historyOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        uniform.noDirectEpochTransformer
        historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (environment : EnvironmentCode uniform.noDirectEpochTransformer)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hreplay :
      roundAwareGameExecution
        uniform.noDirectEpochTransformer initialBoundary
        controller.1 environment = word)
    (htrack :
      ∀ n : Nat,
        let state :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word n)
        let envRound := environmentRoundOfWord word n
        historyOne state envRound =
            historyOfViewOne
              (nextView Proc.one (wordPrefix word n) envRound) ∧
          fringeOne state envRound =
            fringeOfViewOne
              (nextView Proc.one (wordPrefix word n) envRound) ∧
          historyTwo state envRound =
            historyOfViewTwo
              (nextView Proc.two (wordPrefix word n) envRound) ∧
          fringeTwo state envRound =
            fringeOfViewTwo
              (nextView Proc.two (wordPrefix word n) envRound)) :
    ∀ n : Nat,
      let state :=
        uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word n)
      let envRound := environmentRoundOfWord word n
      historyOne state envRound =
          historyOfViewOne
            (nextView Proc.one (wordPrefix word n) envRound) ∧
        fringeOne state envRound =
          fringeOfViewOne
            (nextView Proc.one (wordPrefix word n) envRound) ∧
        historyTwo state envRound =
          historyOfViewTwo
            (nextView Proc.two (wordPrefix word n) envRound) ∧
        fringeTwo state envRound =
          fringeOfViewTwo
            (nextView Proc.two (wordPrefix word n) envRound) ∧
        word n =
          {
            inputOne := envRound.inputOne
            inputTwo := envRound.inputTwo
            graph := envRound.graph
            outputOne := (controller.1 state envRound).1
            outputTwo := (controller.1 state envRound).2
          } := by
  intro n
  let state :=
    uniform.noDirectEpochStateAfterHistory initialBoundary
      (wordPrefix word n)
  let envRound := environmentRoundOfWord word n
  rcases htrack n with ⟨hhistoryOne, hfringeOne, hhistoryTwo, hfringeTwo⟩
  have hstate :
      state =
        roundAwareGameStateStream
          uniform.noDirectEpochTransformer initialBoundary
          controller.1 environment n := by
    dsimp [state]
    rw [← hreplay]
    exact
      noDirectEpochStateAfterHistory_roundAwareGameExecution_prefix
        uniform initialBoundary controller.1 environment n
  have henv :
      envRound =
        environment
          (roundAwareGameStateStream
            uniform.noDirectEpochTransformer initialBoundary
            controller.1 environment n) := by
    dsimp [envRound]
    rw [← hreplay]
    simp [environmentRoundOfWord, roundAwareGameExecution]
  have hword :
      word n =
        {
          inputOne := envRound.inputOne
          inputTwo := envRound.inputTwo
          graph := envRound.graph
          outputOne := (controller.1 state envRound).1
          outputTwo := (controller.1 state envRound).2
        } := by
    rw [← hreplay]
    simp [roundAwareGameExecution, hstate, henv]
  exact ⟨hhistoryOne, hfringeOne, hhistoryTwo, hfringeTwo, hword⟩

/--
Self-compatible finite-lambda execution.

Unlike `RoundAwareLambdaControllerCompatibleExecution`, this predicate reads
the local views from the candidate word's own finite prefixes.  This is the
paper-side rejected-word semantics needed for the carried-fringe-bit route:
the hidden bit is replayed as an argument to the lambda table, not by comparing
against the actual execution of an already extracted strategy.
-/
def RoundAwareLambdaControllerSelfCompatibleExecution
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)) : Prop :=
  ∀ n : Nat,
    let envRound := environmentRoundOfWord word n
    ∃ stateOne : GameState T,
      historyOne stateOne envRound =
          historyOfViewOne
            (nextView Proc.one (wordPrefix word n) envRound) ∧
        fringeOne stateOne envRound =
          fringeOfViewOne
            (nextView Proc.one (wordPrefix word n) envRound) ∧
        ∃ stateTwo : GameState T,
          historyTwo stateTwo envRound =
              historyOfViewTwo
                (nextView Proc.two (wordPrefix word n) envRound) ∧
            fringeTwo stateTwo envRound =
              fringeOfViewTwo
                (nextView Proc.two (wordPrefix word n) envRound) ∧
            word n =
              {
                inputOne := envRound.inputOne
                inputTwo := envRound.inputTwo
                graph := envRound.graph
                outputOne := (controller.1 stateOne envRound).1
                outputTwo := (controller.1 stateTwo envRound).2
              }

theorem roundAwareLambdaControllerSelfCompatibleExecution_of_actualFiniteViewStateWitnesses
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (hmatch :
      RoundAwareLambdaControllerStrategyMatchesFiniteViews
        T historyOne historyTwo fringeOne fringeTwo controller
        historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo σ)
    (hwitnesses :
      RoundAwareLambdaControllerActualFiniteViewStateWitnesses
        T historyOne historyTwo fringeOne fringeTwo
        historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo σ)
    (env : EnvironmentSequence In₁ In₂) :
    RoundAwareLambdaControllerSelfCompatibleExecution
      T historyOne historyTwo fringeOne fringeTwo controller
      historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
      (execution σ env) := by
  have hcompatible :
      RoundAwareLambdaControllerCompatibleExecution
        T historyOne historyTwo fringeOne fringeTwo controller
        historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
        σ env (execution σ env) :=
    roundAwareLambdaControllerCompatibleExecution_of_actualFiniteViewStateWitnesses
      T historyOne historyTwo fringeOne fringeTwo controller
      historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
      σ hmatch hwitnesses env
  intro n
  rcases hcompatible n with
    ⟨stateOne, hhistoryOne, hfringeOne,
      stateTwo, hhistoryTwo, hfringeTwo, hword⟩
  have henv :
      environmentRoundOfWord (execution σ env) n = env n := by
    simp [environmentRoundOfWord, execution_apply, nextRound]
  refine
    ⟨stateOne, ?_, ?_,
      stateTwo, ?_, ?_, ?_⟩
  · simpa [henv] using hhistoryOne
  · simpa [henv] using hfringeOne
  · simpa [henv] using hhistoryTwo
  · simpa [henv] using hfringeTwo
  · simpa [henv] using hword

