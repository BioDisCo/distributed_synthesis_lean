    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert : EpochGameAbstractionCertificate.{u, v, w, a} A) :
    EpochGameAbstractionCertificate.{u, v, w, a} (A.shiftPriority 2) :=
  cert.transferLanguage
    (fun word => DetParityAutomaton.shiftPriority_two_accepts_iff A word)

/-- A uniform epoch-game compiler supplies a certificate for each priority-normalized DPA. -/
def DPAEpochGameCompiler.compileShiftPriorityTwo
