/--
Index map for the ultimately periodic stream induced by a selected lasso.

Positions before `start` read the selected prefix directly.  Positions from
`start` onward wrap around the cycle window of length `period`.
-/
def selectedLassoIndex (start period n : Nat) : Nat :=
  if n < start then n else start + ((n - start) % period)

@[simp] theorem selectedLassoIndex_zero (start period : Nat) :
    selectedLassoIndex start period 0 = 0 := by
  by_cases hstart : 0 < start
  · simp [selectedLassoIndex, hstart]
  · have hzero : start = 0 := by omega
    simp [selectedLassoIndex, hzero]

@[simp] theorem selectedLassoIndex_start
    (start period : Nat) :
    selectedLassoIndex start period start = start := by
  simp [selectedLassoIndex]

theorem selectedLassoIndex_cycle
    (start period i : Nat)
    (hi : i < period) :
    selectedLassoIndex start period (start + i) = start + i := by
  have hnot : ¬ start + i < start := by omega
  have hsub : start + i - start = i := by omega
  simp [selectedLassoIndex, hnot, hsub, Nat.mod_eq_of_lt hi]

theorem selectedLassoIndex_loop_shift
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (m : Nat) :
    selectedLassoIndex start period (start + period + m) =
      selectedLassoIndex start period (start + m) := by
  have hleftNot : ¬ start + period + m < start := by omega
  have hrightNot : ¬ start + m < start := by omega
  have hleftSub : start + period + m - start = period + m := by omega
  have hrightSub : start + m - start = m := by omega
  simp [selectedLassoIndex, hleftNot, hrightNot, hleftSub, hrightSub,
    Nat.add_mod]

theorem selectedLassoIndex_lt_start_add_period
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (n : Nat) :
    selectedLassoIndex start period n < start + period := by
  by_cases hn : n < start
  · simp [selectedLassoIndex, hn]
    omega
  · have hmod : (n - start) % period < period :=
      Nat.mod_lt (n - start) hperiodPositive
    simp [selectedLassoIndex, hn]
    omega

/--
Successor of a bounded selected-lasso index.

Prefix indices advance by one.  Cycle indices advance modulo `period`, so the
last cycle index closes back to `start`.
-/
def selectedLassoNextIndex (start period k : Nat) : Nat :=
  if k < start then k + 1 else start + (((k - start) + 1) % period)

theorem selectedLassoNextIndex_lt_start_add_period
    (start period k : Nat)
    (hperiodPositive : 0 < period)
    (hk : k < start + period) :
    selectedLassoNextIndex start period k < start + period := by
  by_cases hkstart : k < start
  · simp [selectedLassoNextIndex, hkstart]
    omega
  · have hmod : ((k - start) + 1) % period < period :=
      Nat.mod_lt ((k - start) + 1) hperiodPositive
    simp [selectedLassoNextIndex, hkstart]
    omega

theorem selectedLassoNextIndex_eq_start_of_last
    (start period k : Nat)
    (hkge : start ≤ k)
    (hlast : k + 1 = start + period) :
    selectedLassoNextIndex start period k = start := by
  have hkstart : ¬ k < start := by omega
  have hsub : k - start + 1 = period := by omega
  simp [selectedLassoNextIndex, hkstart, hsub]

theorem selectedLassoNextIndex_eq_succ_of_not_last
    (start period k : Nat)
    (hk : k < start + period)
    (hlast : k + 1 ≠ start + period) :
    selectedLassoNextIndex start period k = k + 1 := by
  by_cases hkstart : k < start
  · simp [selectedLassoNextIndex, hkstart]
  · have hlt : k - start + 1 < period := by omega
    have hmod : (k - start + 1) % period = k - start + 1 :=
      Nat.mod_eq_of_lt hlt
    simp [selectedLassoNextIndex, hkstart, hmod]
    omega

theorem selectedLassoIndex_succ_eq_nextIndex
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (n : Nat) :
    selectedLassoIndex start period (n + 1) =
      selectedLassoNextIndex start period
        (selectedLassoIndex start period n) := by
  unfold selectedLassoIndex selectedLassoNextIndex
  by_cases hn : n < start
  · by_cases hnsucc : n + 1 < start
    · simp [hn, hnsucc]
    · have hsucc : n + 1 = start := by omega
      simp [hn, hnsucc, hsucc]
  · have hnsucc : ¬ n + 1 < start := by omega
    have hidxNot :
        ¬ start + (n - start) % period < start := by omega
    have hsubSucc : n + 1 - start = (n - start) + 1 := by omega
    have hsubIdx :
        start + (n - start) % period - start =
          (n - start) % period := by omega
    simp [hn, hnsucc, hidxNot, hsubSucc, hsubIdx, Nat.add_mod_mod]

/-- State stream obtained by wrapping selected finite lasso indices. -/
def selectedLassoStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (stateAt : Nat -> GameState T)
    (start period : Nat) :
    Nat -> GameState T :=
  fun n => stateAt (selectedLassoIndex start period n)

/-- Environment stream obtained by wrapping selected finite lasso indices. -/
def selectedLassoEnvironment
    {In₁ : Type u}
    {In₂ : Type v}
    (envAt : EnvironmentSequence In₁ In₂)
    (start period : Nat) :
    EnvironmentSequence In₁ In₂ :=
  fun n => envAt (selectedLassoIndex start period n)

theorem selectedLassoStateStream_loop_shift
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (stateAt : Nat -> GameState T)
    (start period : Nat)
    (hperiodPositive : 0 < period) :
    ∀ m : Nat,
      selectedLassoStateStream stateAt start period (start + period + m) =
        selectedLassoStateStream stateAt start period (start + m) := by
  intro m
  simp [selectedLassoStateStream,
    selectedLassoIndex_loop_shift start period hperiodPositive m]

theorem selectedLassoEnvironment_loop_shift
    {In₁ : Type u}
    {In₂ : Type v}
    (envAt : EnvironmentSequence In₁ In₂)
    (start period : Nat)
    (hperiodPositive : 0 < period) :
    ∀ m : Nat,
      selectedLassoEnvironment envAt start period (start + period + m) =
        selectedLassoEnvironment envAt start period (start + m) := by
  intro m
  simp [selectedLassoEnvironment,
    selectedLassoIndex_loop_shift start period hperiodPositive m]

/- Generic selected-lasso adapters for the non-stuttering finite carrier. -/

/-- State stream obtained by wrapping selected finite lasso indices for a carrier `Q`. -/
def finiteCarrierSelectedLassoStateStream
    {Q : Type x}
    (stateAt : Nat -> Q)
    (start period : Nat) :
    Nat -> Q :=
  fun n => stateAt (selectedLassoIndex start period n)

/-- Move stream obtained by wrapping selected finite lasso indices. -/
def finiteCarrierSelectedLassoMoveStream
    {Move : Type y}
    (moveAt : Nat -> Move)
    (start period : Nat) :
    Nat -> Move :=
  fun n => moveAt (selectedLassoIndex start period n)

theorem finiteCarrierSelectedLassoStateStream_loop_shift
    {Q : Type x}
    (stateAt : Nat -> Q)
    (start period : Nat)
    (hperiodPositive : 0 < period) :
    ∀ m : Nat,
      finiteCarrierSelectedLassoStateStream stateAt start period
          (start + period + m) =
        finiteCarrierSelectedLassoStateStream stateAt start period
          (start + m) := by
  intro m
  simp [finiteCarrierSelectedLassoStateStream,
    selectedLassoIndex_loop_shift start period hperiodPositive m]

theorem finiteCarrierSelectedLassoMoveStream_loop_shift
    {Move : Type y}
    (moveAt : Nat -> Move)
    (start period : Nat)
    (hperiodPositive : 0 < period) :
    ∀ m : Nat,
      finiteCarrierSelectedLassoMoveStream moveAt start period
          (start + period + m) =
        finiteCarrierSelectedLassoMoveStream moveAt start period
          (start + m) := by
  intro m
  simp [finiteCarrierSelectedLassoMoveStream,
    selectedLassoIndex_loop_shift start period hperiodPositive m]

theorem finiteCarrierSelectedLasso_consistent_of_bounded_index_functional
    {Q : Type x}
    {Move : Type y}
    (stateAt : Nat -> Q)
    (moveAt : Nat -> Move)
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (hfunctional :
      ∀ i j : Nat,
        i < start + period ->
        j < start + period ->
        stateAt i = stateAt j ->
          moveAt i = moveAt j) :
    ∀ i j : Nat,
      finiteCarrierSelectedLassoStateStream stateAt start period i =
        finiteCarrierSelectedLassoStateStream stateAt start period j ->
      finiteCarrierSelectedLassoMoveStream moveAt start period i =
        finiteCarrierSelectedLassoMoveStream moveAt start period j := by
  intro i j hstate
  exact
    hfunctional
      (selectedLassoIndex start period i)
      (selectedLassoIndex start period j)
      (selectedLassoIndex_lt_start_add_period start period hperiodPositive i)
      (selectedLassoIndex_lt_start_add_period start period hperiodPositive j)
      hstate

theorem finiteCarrierSelectedLasso_step_of_bounded_nextIndex_step
    {Q : Type x}
    {Move : Type y}
    (step : Q -> Move -> Q)
    (stateAt : Nat -> Q)
    (moveAt : Nat -> Move)
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (hstepBounded :
      ∀ k : Nat,
        k < start + period ->
          stateAt (selectedLassoNextIndex start period k) =
            step (stateAt k) (moveAt k)) :
    ∀ n : Nat,
      finiteCarrierSelectedLassoStateStream stateAt start period (n + 1) =
        step
          (finiteCarrierSelectedLassoStateStream stateAt start period n)
          (finiteCarrierSelectedLassoMoveStream moveAt start period n) := by
  intro n
  let k := selectedLassoIndex start period n
  have hk : k < start + period :=
    selectedLassoIndex_lt_start_add_period start period hperiodPositive n
  have hnext :
      selectedLassoIndex start period (n + 1) =
        selectedLassoNextIndex start period k := by
    simpa [k] using
      selectedLassoIndex_succ_eq_nextIndex start period hperiodPositive n
  change
    stateAt (selectedLassoIndex start period (n + 1)) =
      step
        (stateAt (selectedLassoIndex start period n))
        (moveAt (selectedLassoIndex start period n))
  rw [hnext]
  simpa [k] using hstepBounded k hk

theorem finiteCarrierSelectedLasso_dpaStep_of_bounded_nextIndex_dpaStep
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (stateAt : Nat -> Q)
    (moveAt : Nat -> Move)
    (dpaOf : Q -> A.State)
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (hdpaStepBounded :
      ∀ k : Nat,
        k < start + period ->
          dpaOf (stateAt (selectedLassoNextIndex start period k)) =
            A.step (dpaOf (stateAt k)) (emit (stateAt k) (moveAt k))) :
    ∀ n : Nat,
      dpaOf
          (finiteCarrierSelectedLassoStateStream stateAt start period
            (n + 1)) =
        A.step
          (dpaOf
            (finiteCarrierSelectedLassoStateStream stateAt start period n))
          (finiteCarrierWord emit
            (finiteCarrierSelectedLassoStateStream stateAt start period)
            (finiteCarrierSelectedLassoMoveStream moveAt start period) n) := by
  intro n
  let k := selectedLassoIndex start period n
  have hk : k < start + period :=
    selectedLassoIndex_lt_start_add_period start period hperiodPositive n
  have hnext :
      selectedLassoIndex start period (n + 1) =
        selectedLassoNextIndex start period k := by
    simpa [k] using
      selectedLassoIndex_succ_eq_nextIndex start period hperiodPositive n
  change
    dpaOf (stateAt (selectedLassoIndex start period (n + 1))) =
      A.step (dpaOf (stateAt (selectedLassoIndex start period n)))
        (finiteCarrierWord emit
          (finiteCarrierSelectedLassoStateStream stateAt start period)
          (finiteCarrierSelectedLassoMoveStream moveAt start period) n)
  rw [hnext]
  simpa [k, finiteCarrierWord, finiteCarrierSelectedLassoStateStream,
    finiteCarrierSelectedLassoMoveStream] using hdpaStepBounded k hk

/--
Generic selected-lasso reflection for a non-stuttering finite carrier.

This is the carrier-`Q` analogue of the backend selected-lasso adapter: bounded
selected edge laws, bounded label functionality, DPA progress, and an odd
lower-bounding cycle witness are sufficient to build a memoryless `Q` code
whose emitted word is rejected.
-/
theorem exists_finiteCarrierCode_rejected_playWord_of_selected_lasso_indices_of_bounded_edges_functional_cycleWitness_dpaProgress_lowerBound
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    [Fintype Q]
    (initial : Q)
    (step : Q -> Move -> Q)
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (stateAt : Nat -> Q)
    (moveAt : Nat -> Move)
    (dpaOf : Q -> A.State)
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (hinit : stateAt 0 = initial)
    (hstepBounded :
      ∀ k : Nat,
        k < start + period ->
          stateAt (selectedLassoNextIndex start period k) =
            step (stateAt k) (moveAt k))
    (hfunctional :
      ∀ i j : Nat,
        i < start + period ->
        j < start + period ->
        stateAt i = stateAt j ->
          moveAt i = moveAt j)
    (hdpaInit : dpaOf (stateAt 0) = A.initial)
    (hdpaStepBounded :
      ∀ k : Nat,
        k < start + period ->
          dpaOf (stateAt (selectedLassoNextIndex start period k)) =
            A.step (dpaOf (stateAt k)) (emit (stateAt k) (moveAt k)))
    (witness : Nat)
    (hwitnessLt : witness < period)
    {p : Nat}
    (hwitnessPriority : A.priority (dpaOf (stateAt (start + witness))) = p)
    (hcycleLower :
      ∀ i : Nat,
        i < period ->
          p ≤ A.priority (dpaOf (stateAt (start + i))))
    (hpOdd : ¬ DetParityAutomaton.NatEven p) :
    ∃ code : Q -> Move,
      ¬ A.Accepts (finiteCarrierPlayWord initial step emit code) := by
  let selectedState :=
    finiteCarrierSelectedLassoStateStream stateAt start period
  let selectedMove :=
    finiteCarrierSelectedLassoMoveStream moveAt start period
  have hselectedInit : selectedState 0 = initial := by
    simpa [selectedState, finiteCarrierSelectedLassoStateStream] using hinit
  have hselectedStep :
      ∀ n : Nat,
        selectedState (n + 1) =
          step (selectedState n) (selectedMove n) := by
    simpa [selectedState, selectedMove] using
      finiteCarrierSelectedLasso_step_of_bounded_nextIndex_step
        step stateAt moveAt start period hperiodPositive hstepBounded
  have hselectedConsistent :
      ∀ i j : Nat,
        selectedState i = selectedState j ->
          selectedMove i = selectedMove j := by
    simpa [selectedState, selectedMove] using
      finiteCarrierSelectedLasso_consistent_of_bounded_index_functional
        stateAt moveAt start period hperiodPositive hfunctional
  have hdpaSelectedInit : dpaOf (selectedState 0) = A.initial := by
    simpa [selectedState, finiteCarrierSelectedLassoStateStream] using hdpaInit
  have hdpaSelectedStep :
      ∀ n : Nat,
        dpaOf (selectedState (n + 1)) =
          A.step (dpaOf (selectedState n))
            (finiteCarrierWord emit selectedState selectedMove n) := by
    simpa [selectedState, selectedMove] using
      finiteCarrierSelectedLasso_dpaStep_of_bounded_nextIndex_dpaStep
        emit A stateAt moveAt dpaOf start period hperiodPositive
        hdpaStepBounded
  have hwitnessPrioritySelected :
      A.priority (dpaOf (selectedState (start + witness))) = p := by
    simpa [selectedState, finiteCarrierSelectedLassoStateStream,
      selectedLassoIndex_cycle start period witness hwitnessLt] using
      hwitnessPriority
  have hcycleLowerSelected :
      ∀ i : Nat,
        i < period ->
          p ≤ A.priority (dpaOf (selectedState (start + i))) := by
    intro i hi
    simpa [selectedState, finiteCarrierSelectedLassoStateStream,
      selectedLassoIndex_cycle start period i hi] using hcycleLower i hi
  exact
    exists_finiteCarrierCode_rejected_playWord_of_consistent_looping_stateStream_of_dpaProgress_cycleWitness_lowerBound
      initial step emit A selectedState selectedMove dpaOf
      hdpaSelectedInit hdpaSelectedStep
      hselectedInit hselectedStep hselectedConsistent
      start period hperiodPositive
      (by
        simpa [selectedState] using
          finiteCarrierSelectedLassoStateStream_loop_shift
            stateAt start period hperiodPositive)
      (by
        simpa [selectedMove] using
          finiteCarrierSelectedLassoMoveStream_loop_shift
            moveAt start period hperiodPositive)
      witness hwitnessLt
      hwitnessPrioritySelected hcycleLowerSelected hpOdd

/--
Finite-window functionality of selected labels implies the global consistency
condition needed by `environmentCodeOfStateStream` for the wrapped lasso stream.
-/
theorem selectedLasso_consistent_of_bounded_index_functional
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (stateAt : Nat -> GameState T)
    (envAt : EnvironmentSequence In₁ In₂)
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (hfunctional :
      ∀ i j : Nat,
        i < start + period ->
        j < start + period ->
        stateAt i = stateAt j ->
          envAt i = envAt j) :
    ∀ i j : Nat,
      selectedLassoStateStream stateAt start period i =
        selectedLassoStateStream stateAt start period j ->
      selectedLassoEnvironment envAt start period i =
        selectedLassoEnvironment envAt start period j := by
  intro i j hstate
  exact
    hfunctional
      (selectedLassoIndex start period i)
      (selectedLassoIndex start period j)
      (selectedLassoIndex_lt_start_add_period start period hperiodPositive i)
      (selectedLassoIndex_lt_start_add_period start period hperiodPositive j)
      hstate

theorem selectedLasso_bounded_index_functional_of_bounded_injective
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (stateAt : Nat -> GameState T)
    (envAt : EnvironmentSequence In₁ In₂)
    (start period : Nat)
    (hinjective :
      ∀ i j : Nat,
        i < start + period ->
        j < start + period ->
        stateAt i = stateAt j ->
          i = j) :
    ∀ i j : Nat,
      i < start + period ->
      j < start + period ->
      stateAt i = stateAt j ->
        envAt i = envAt j := by
  intro i j hi hj hstate
  have hij := hinjective i j hi hj hstate
  subst j
  rfl

/--
A loop-erased prefix and a simple cycle, disjoint before the cycle entry, make
the whole selected prefix/cycle window injective.
-/
theorem selectedLasso_bounded_index_injective_of_prefix_cycle_simple_disjoint
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (stateAt : Nat -> GameState T)
    (start period : Nat)
    (hprefixSimple :
      ∀ i j : Nat,
        i < start ->
        j < start ->
        stateAt i = stateAt j ->
          i = j)
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        stateAt (start + i) = stateAt (start + j) ->
          i = j)
    (hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < start ->
        j < period ->
          stateAt i ≠ stateAt (start + j)) :
    ∀ i j : Nat,
      i < start + period ->
      j < start + period ->
      stateAt i = stateAt j ->
        i = j := by
  intro i j hiWindow hjWindow hstate
  by_cases hiPrefix : i < start
  · by_cases hjPrefix : j < start
    · exact hprefixSimple i j hiPrefix hjPrefix hstate
    · let jCycle := j - start
      have hjCycleLt : jCycle < period := by
        dsimp [jCycle]
        omega
      have hjEq : j = start + jCycle := by
        dsimp [jCycle]
        omega
      have hstateCycle : stateAt i = stateAt (start + jCycle) := by
        simpa [hjEq] using hstate
      exact False.elim
        ((hprefixCycleDisjoint i jCycle hiPrefix hjCycleLt) hstateCycle)
  · by_cases hjPrefix : j < start
    · let iCycle := i - start
      have hiCycleLt : iCycle < period := by
        dsimp [iCycle]
        omega
      have hiEq : i = start + iCycle := by
        dsimp [iCycle]
        omega
      have hstateCycle : stateAt j = stateAt (start + iCycle) := by
        simpa [hiEq] using hstate.symm
      exact False.elim
        ((hprefixCycleDisjoint j iCycle hjPrefix hiCycleLt) hstateCycle)
    · let iCycle := i - start
      let jCycle := j - start
      have hiCycleLt : iCycle < period := by
        dsimp [iCycle]
        omega
      have hjCycleLt : jCycle < period := by
        dsimp [jCycle]
        omega
      have hiEq : i = start + iCycle := by
        dsimp [iCycle]
        omega
      have hjEq : j = start + jCycle := by
        dsimp [jCycle]
        omega
      have hstateCycle :
          stateAt (start + iCycle) = stateAt (start + jCycle) := by
        simpa [hiEq, hjEq] using hstate
      have hcyclesEq :
          iCycle = jCycle :=
        hcycleSimple iCycle jCycle hiCycleLt hjCycleLt hstateCycle
      omega

theorem selectedLasso_bounded_index_functional_of_prefix_cycle_simple_disjoint
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    (stateAt : Nat -> GameState T)
    (envAt : EnvironmentSequence In₁ In₂)
    (start period : Nat)
    (hprefixSimple :
      ∀ i j : Nat,
        i < start ->
        j < start ->
        stateAt i = stateAt j ->
          i = j)
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        stateAt (start + i) = stateAt (start + j) ->
          i = j)
    (hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < start ->
        j < period ->
          stateAt i ≠ stateAt (start + j)) :
    ∀ i j : Nat,
      i < start + period ->
      j < start + period ->
      stateAt i = stateAt j ->
        envAt i = envAt j := by
  exact
    selectedLasso_bounded_index_functional_of_bounded_injective
      stateAt envAt start period
      (selectedLasso_bounded_index_injective_of_prefix_cycle_simple_disjoint
        stateAt start period
        hprefixSimple hcycleSimple hprefixCycleDisjoint)

theorem selectedLasso_step_of_bounded_nextIndex_step
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : RoundAwareControllerCode T)
    (stateAt : Nat -> GameState T)
    (envAt : EnvironmentSequence In₁ In₂)
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (hstepBounded :
      ∀ k : Nat,
        k < start + period ->
          stateAt (selectedLassoNextIndex start period k) =
            roundAwareGameTransition T controller
              (stateAt k) (envAt k)) :
    ∀ n : Nat,
      selectedLassoStateStream stateAt start period (n + 1) =
        roundAwareGameTransition T controller
          (selectedLassoStateStream stateAt start period n)
          (selectedLassoEnvironment envAt start period n) := by
  intro n
  let k := selectedLassoIndex start period n
  have hk : k < start + period :=
    selectedLassoIndex_lt_start_add_period start period hperiodPositive n
  have hnext :
      selectedLassoIndex start period (n + 1) =
        selectedLassoNextIndex start period k := by
    simpa [k] using
      selectedLassoIndex_succ_eq_nextIndex start period hperiodPositive n
  change
    stateAt (selectedLassoIndex start period (n + 1)) =
      roundAwareGameTransition T controller
        (stateAt (selectedLassoIndex start period n))
        (envAt (selectedLassoIndex start period n))
  rw [hnext]
  simpa [k] using hstepBounded k hk

theorem selectedLasso_dpaStep_of_bounded_nextIndex_dpaStep
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateAt : Nat -> GameState T)
    (envAt : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (hdpaStepBounded :
      ∀ k : Nat,
        k < start + period ->
          dpaOf (stateAt (selectedLassoNextIndex start period k)) =
            A.step (dpaOf (stateAt k))
              {
                inputOne := (envAt k).inputOne
                inputTwo := (envAt k).inputTwo
                graph := (envAt k).graph
                outputOne := (controller (stateAt k) (envAt k)).1
                outputTwo := (controller (stateAt k) (envAt k)).2
              }) :
    ∀ n : Nat,
      dpaOf (selectedLassoStateStream stateAt start period (n + 1)) =
        A.step
          (dpaOf (selectedLassoStateStream stateAt start period n))
          (roundAwareWordOfStateStream T controller
            (selectedLassoStateStream stateAt start period)
            (selectedLassoEnvironment envAt start period) n) := by
  intro n
  let k := selectedLassoIndex start period n
  have hk : k < start + period :=
    selectedLassoIndex_lt_start_add_period start period hperiodPositive n
  have hnext :
      selectedLassoIndex start period (n + 1) =
        selectedLassoNextIndex start period k := by
    simpa [k] using
      selectedLassoIndex_succ_eq_nextIndex start period hperiodPositive n
  change
    dpaOf (stateAt (selectedLassoIndex start period (n + 1))) =
      A.step (dpaOf (stateAt (selectedLassoIndex start period n)))
        (roundAwareWordOfStateStream T controller
          (selectedLassoStateStream stateAt start period)
          (selectedLassoEnvironment envAt start period) n)
  rw [hnext]
  simpa [k, roundAwareWordOfStateStream, selectedLassoStateStream,
    selectedLassoEnvironment] using hdpaStepBounded k hk

/--
Selected finite-lasso adapter.

The caller supplies the finite selected prefix/cycle through `stateAt` and
`envAt`; this theorem wraps them into the ultimately periodic streams consumed
by the lower-bound lasso theorem.  The remaining hypotheses are exactly the
finite lasso well-formedness obligations: initial state, transition coherence,
functional environment labels on selected states, DPA-progress coherence, and
the odd lower-bound cycle priority condition.
-/
theorem exists_environmentCode_rejected_roundAwareGameExecution_of_selected_lasso_indices_of_dpaProgress_lowerBound
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateAt : Nat -> GameState T)
    (envAt : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (hinit :
      selectedLassoStateStream stateAt start period 0 =
        Sum.inl initialBoundary)
    (hstep :
      ∀ n : Nat,
        selectedLassoStateStream stateAt start period (n + 1) =
          roundAwareGameTransition T controller
            (selectedLassoStateStream stateAt start period n)
            (selectedLassoEnvironment envAt start period n))
    (hconsistent :
      ∀ i j : Nat,
        selectedLassoStateStream stateAt start period i =
          selectedLassoStateStream stateAt start period j ->
        selectedLassoEnvironment envAt start period i =
          selectedLassoEnvironment envAt start period j)
    (hdpaInit :
      dpaOf (selectedLassoStateStream stateAt start period 0) = A.initial)
    (hdpaStep :
      ∀ n : Nat,
        dpaOf (selectedLassoStateStream stateAt start period (n + 1)) =
          A.step
            (dpaOf (selectedLassoStateStream stateAt start period n))
            (roundAwareWordOfStateStream T controller
              (selectedLassoStateStream stateAt start period)
              (selectedLassoEnvironment envAt start period) n))
    {p : Nat}
    (hentryPriority : A.priority (dpaOf (stateAt start)) = p)
    (hcycleLower :
      ∀ i : Nat,
        i < period ->
          p ≤ A.priority (dpaOf (stateAt (start + i))))
    (hpOdd : ¬ DetParityAutomaton.NatEven p) :
    ∃ environment : EnvironmentCode T,
      ¬ A.Accepts
        (roundAwareGameExecution T initialBoundary controller environment) := by
  have hentryPriorityStream :
      A.priority
          (dpaOf (selectedLassoStateStream stateAt start period start)) = p := by
    simpa [selectedLassoStateStream] using hentryPriority
  have hcycleLowerStream :
      ∀ i : Nat,
        i < period ->
          p ≤
            A.priority
              (dpaOf
                (selectedLassoStateStream stateAt start period (start + i))) := by
    intro i hi
    simpa [selectedLassoStateStream,
      selectedLassoIndex_cycle start period i hi] using hcycleLower i hi
  exact
    exists_environmentCode_rejected_roundAwareGameExecution_of_consistent_looping_stateStream_of_dpaProgress_lowerBound
      T initialBoundary controller A
      (selectedLassoStateStream stateAt start period)
      (selectedLassoEnvironment envAt start period)
      dpaOf hdpaInit hdpaStep hinit hstep hconsistent
      start period hperiodPositive
      (selectedLassoStateStream_loop_shift stateAt start period hperiodPositive)
      (selectedLassoEnvironment_loop_shift envAt start period hperiodPositive)
      hentryPriorityStream hcycleLowerStream hpOdd

/--
Selected-lasso adapter with memoryless functionality stated on the finite
prefix/cycle window.

This is the form expected from the simple-cycle extraction: the caller proves
that within the selected bounded window, equal selected states carry the same
environment label.  The theorem turns that finite-window condition into the
global repeat-consistency needed by the memoryless environment code.
-/
theorem exists_environmentCode_rejected_roundAwareGameExecution_of_selected_lasso_indices_of_bounded_functional_dpaProgress_lowerBound
