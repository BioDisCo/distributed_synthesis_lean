/--
It is enough to realize every losing lambda-compatible word as a finite
round-aware execution.  Language equivalence then turns rejection of the
compatible word into rejection of that finite-game play.
-/
theorem roundAwareLambdaControllerCompatibleCounterexamplesReflected_of_rejectedCompatibleWordsRepresentable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hautomaton :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        T.automaton.Accepts word ↔ A.Accepts word)
    (hrepresentRejected :
      ∀ (env : EnvironmentSequence In₁ In₂)
        (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          RoundAwareLambdaControllerCompatibleExecution
            T historyOne historyTwo fringeOne fringeTwo controller
            historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
            σ env word ->
          ¬ A.Accepts word ->
            ∃ environment : EnvironmentCode T,
              roundAwareGameExecution T initialBoundary controller.1
                environment =
                word) :
    RoundAwareLambdaControllerCompatibleCounterexamplesReflectedByEnvironmentCode
      T initialBoundary historyOne historyTwo fringeOne fringeTwo controller
      historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
      σ A := by
  intro env word hcompatible hreject
  rcases hrepresentRejected env word hcompatible hreject with
    ⟨environment, hword⟩
  refine ⟨environment, ?_⟩
  intro hwins
  have haccT :
      T.automaton.Accepts
        (roundAwareGameExecution T initialBoundary controller.1 environment) :=
    (roundAwareGameWins_iff_accepts
      T initialBoundary controller.1 environment).mp hwins
  have haccA : A.Accepts word := by
    rw [← hword]
    exact
      (hautomaton
        (roundAwareGameExecution
          T initialBoundary controller.1 environment)).mp haccT
  exact hreject haccA

