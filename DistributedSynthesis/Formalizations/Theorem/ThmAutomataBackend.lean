No-direct lambda-local rotating backend from prefix-state repeat consistency
and prefix-state summary/fringe tracking for rejected self-compatible words.

This is the sharpest no-direct interface after the carried-bit reduction:
exact finite replay is derived internally from the concrete prefix state stream
by `FiniteEpochTransformer.noDirect_rejectedRepresentable_of_prefixConsistent_and_prefixTracking`.
-/
noncomputable def ofNoDirectActualLambdaChoicesAndRejectedPrefixConsistentTracking
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (Branch : Proc -> Type b)
    (Label : Proc -> Type x)
    (target :
      (d : Proc) -> InputFreeParityTreeAutomaton.{b, x, y} (Branch d) (Label d))
    (targetNonempty :
      ∀ d : Proc,
        ∃ tree : LabeledTree (Branch d) (Label d),
          (target d).acceptsTree tree)
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (hautomaton :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        uniform.noDirectEpochTransformer.automaton.Accepts word ↔ A.Accepts word)
    (historyOne :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> R₂)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (dynamicHierarchy parityObjective : Prop)
    (dynamicHierarchy_proof : dynamicHierarchy)
    (parityObjective_proof : parityObjective)
    (actualConsistent :
      ∀ controller :
          uniform.noDirectEpochTransformer.RoundAwareLambdaControllerCode
            historyOne historyTwo fringeOne fringeTwo,
        ∀ env : EnvironmentSequence In₁ In₂,
          ∀ i j : Nat,
            uniform.noDirectEpochStateStream initialBoundary
                (FiniteEpochTransformer.strategyOfRoundAwareLambdaController
                  uniform.noDirectEpochTransformer
                  historyOne historyTwo fringeOne fringeTwo controller
                  historyOfViewOne historyOfViewTwo
                  fringeOfViewOne fringeOfViewTwo
                  defaultOne defaultTwo)
                env i =
              uniform.noDirectEpochStateStream initialBoundary
                (FiniteEpochTransformer.strategyOfRoundAwareLambdaController
                  uniform.noDirectEpochTransformer
                  historyOne historyTwo fringeOne fringeTwo controller
                  historyOfViewOne historyOfViewTwo
                  fringeOfViewOne fringeOfViewTwo
                  defaultOne defaultTwo)
                env j ->
            env i = env j)
    (actualSummaries :
      ∀ controller :
          uniform.noDirectEpochTransformer.RoundAwareLambdaControllerCode
            historyOne historyTwo fringeOne fringeTwo,
        ∀ env : EnvironmentSequence In₁ In₂,
          ∀ n : Nat,
            let σ :=
              FiniteEpochTransformer.strategyOfRoundAwareLambdaController
                uniform.noDirectEpochTransformer
                historyOne historyTwo fringeOne fringeTwo controller
                historyOfViewOne historyOfViewTwo
                fringeOfViewOne fringeOfViewTwo
                defaultOne defaultTwo
            let state := uniform.noDirectEpochStateStream initialBoundary σ env n
            historyOne state (env n) =
                historyOfViewOne
                  (nextView Proc.one (executionPrefix σ env n) (env n)) ∧
              fringeOne state (env n) =
                fringeOfViewOne
                  (nextView Proc.one (executionPrefix σ env n) (env n)) ∧
              historyTwo state (env n) =
                historyOfViewTwo
                  (nextView Proc.two (executionPrefix σ env n) (env n)) ∧
              fringeTwo state (env n) =
                fringeOfViewTwo
                  (nextView Proc.two (executionPrefix σ env n) (env n)))
    (rejectedPrefixConsistent :
      ∀ controller :
          uniform.noDirectEpochTransformer.RoundAwareLambdaControllerCode
            historyOne historyTwo fringeOne fringeTwo,
        ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
          FiniteEpochTransformer.RoundAwareLambdaControllerSelfCompatibleExecution
            uniform.noDirectEpochTransformer
            historyOne historyTwo fringeOne fringeTwo controller
            historyOfViewOne historyOfViewTwo
            fringeOfViewOne fringeOfViewTwo
            word ->
          ¬ A.Accepts word ->
            ∀ i j : Nat,
              uniform.noDirectEpochStateAfterHistory initialBoundary
                  (FiniteEpochTransformer.wordPrefix word i) =
                uniform.noDirectEpochStateAfterHistory initialBoundary
                  (FiniteEpochTransformer.wordPrefix word j) ->
              FiniteEpochTransformer.environmentRoundOfWord word i =
                FiniteEpochTransformer.environmentRoundOfWord word j)
    (rejectedPrefixTracking :
      ∀ controller :
          uniform.noDirectEpochTransformer.RoundAwareLambdaControllerCode
            historyOne historyTwo fringeOne fringeTwo,
        ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
          FiniteEpochTransformer.RoundAwareLambdaControllerSelfCompatibleExecution
            uniform.noDirectEpochTransformer
            historyOne historyTwo fringeOne fringeTwo controller
            historyOfViewOne historyOfViewTwo
            fringeOfViewOne fringeOfViewTwo
            word ->
          ¬ A.Accepts word ->
            ∀ n : Nat,
              let state :=
                uniform.noDirectEpochStateAfterHistory initialBoundary
                  (FiniteEpochTransformer.wordPrefix word n)
              let envRound :=
                FiniteEpochTransformer.environmentRoundOfWord word n
              historyOne state envRound =
                  historyOfViewOne
                    (nextView Proc.one
                      (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
                fringeOne state envRound =
                  fringeOfViewOne
                    (nextView Proc.one
                      (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
                historyTwo state envRound =
                  historyOfViewTwo
                    (nextView Proc.two
                      (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
                fringeTwo state envRound =
                  fringeOfViewTwo
                    (nextView Proc.two
                      (FiniteEpochTransformer.wordPrefix word n) envRound))
    (matchingControllers :
      ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∃ controller :
          uniform.noDirectEpochTransformer.RoundAwareLambdaControllerCode
            historyOne historyTwo fringeOne fringeTwo,
          FiniteEpochTransformer.RoundAwareLambdaControllerStrategyMatchesFiniteViews
            uniform.noDirectEpochTransformer
            historyOne historyTwo fringeOne fringeTwo controller
            historyOfViewOne historyOfViewTwo
            fringeOfViewOne fringeOfViewTwo σ ∧
          ∀ environment : uniform.noDirectEpochTransformer.EnvironmentCode,
            ∀ n : Nat,
              let env : EnvironmentSequence In₁ In₂ :=
                uniform.noDirectEpochTransformer.roundAwareEnvironmentSequenceOfGamePlay
                  initialBoundary controller.1 environment
              let state :=
                uniform.noDirectEpochTransformer.roundAwareGameStateStream
                  initialBoundary controller.1 environment n
              let envRound := environment state
              historyOne state envRound =
                  historyOfViewOne
                    (nextView Proc.one
                      (executionPrefix σ env n) (env n)) ∧
                fringeOne state envRound =
                  fringeOfViewOne
                    (nextView Proc.one
                      (executionPrefix σ env n) (env n)) ∧
                historyTwo state envRound =
                  historyOfViewTwo
                    (nextView Proc.two
                      (executionPrefix σ env n) (env n)) ∧
                fringeTwo state envRound =
                  fringeOfViewTwo
                    (nextView Proc.two
                      (executionPrefix σ env n) (env n))) :
    RoundAwareLambdaRotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y, z} A :=
  ofNoDirectActualLambdaChoicesAndRejectedRepresentable
    A Branch Label target targetNonempty
    uniform initialBoundary hautomaton
    historyOne historyTwo fringeOne fringeTwo
    historyOfViewOne historyOfViewTwo
    fringeOfViewOne fringeOfViewTwo
    defaultOne defaultTwo
    dynamicHierarchy parityObjective
    dynamicHierarchy_proof parityObjective_proof
    actualConsistent actualSummaries
    (fun controller =>
      FiniteEpochTransformer.noDirect_rejectedRepresentable_of_prefixConsistent_and_prefixTracking
        uniform initialBoundary
        historyOne historyTwo fringeOne fringeTwo controller
        historyOfViewOne historyOfViewTwo
        fringeOfViewOne fringeOfViewTwo
        A
        (rejectedPrefixConsistent controller)
        (rejectedPrefixTracking controller))
    matchingControllers

/--
Build the lambda-local rotating backend from actual synchronized lambda choices
only.

For the current lambda-compatible interface the rejected-compatible branch is
derived internally from actual synchronized choices, via
`RoundAwareLambdaEpochGameAbstractionCertificate.ofTransformerWithActualLambdaChoicesAndFiniteViewStateDecoders`.
-/
noncomputable def ofActualLambdaChoicesAndFiniteViewStateDecoders
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (Branch : Proc -> Type b)
    (Label : Proc -> Type x)
    (target :
      (d : Proc) -> InputFreeParityTreeAutomaton.{b, x, y} (Branch d) (Label d))
    (targetNonempty :
      ∀ d : Proc,
        ∃ tree : LabeledTree (Branch d) (Label d),
          (target d).acceptsTree tree)
    (transformer :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
