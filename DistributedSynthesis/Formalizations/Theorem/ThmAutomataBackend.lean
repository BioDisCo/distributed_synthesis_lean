/-!
# Automata backend certificates

This file isolates the remaining automata-theoretic backend needed after the
LTL-to-alternating-automaton front end: conversion/determinization to a
deterministic parity automaton and compilation of that DPA objective to the
finite dynamic-hierarchy game used by the main theorem.
-/

namespace DistributedSynthesis

universe u v w a b x y z

namespace InputFreeParityTreeAutomaton

/--
The one-state input-free tree automaton accepting every `PUnit`-labeled tree.

Some rotating-rational-run backend records carry accepted target automata only
so the rational-run side can be discharged by nonemptiness.  When no additional
target structure is needed, this canonical target removes that administrative
input without changing the finite-game abstraction content.
-/
def trivialAccepted :
    InputFreeParityTreeAutomaton.{0, 0, 0} PUnit PUnit where
  alphabetFinite := inferInstance
  branchFinite := inferInstance
  State := PUnit
  stateFinite := inferInstance
  acceptsTree := fun _ => True
  acceptsRationalTree := fun _ => True
  rationality := fun _ =>
    ⟨{
        Control := PUnit
        controlFinite := inferInstance
        labelOf := fun _ => PUnit.unit
      },
      trivial⟩
  transitionRationality := fun _ =>
    ⟨{
        Control := PUnit
        controlFinite := inferInstance
        initial := PUnit.unit
        step := fun _ _ => PUnit.unit
        labelOf := fun _ => PUnit.unit
      },
      trivial⟩

/-- The canonical accepted-all target is nonempty. -/
theorem trivialAccepted_nonempty :
    ∃ tree : LabeledTree PUnit PUnit, trivialAccepted.acceptsTree tree :=
  ⟨fun _ => PUnit.unit, trivial⟩

end InputFreeParityTreeAutomaton

/- Generic automata interfaces and support constructions are re-exported
from DistributedSynthesis.Library.Automata.AlternatingSupport above. -/

/-- A certified compilation of a DPA objective to a finite dynamic-hierarchy game. -/
structure DPAToFiniteGameCompilation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    (Out₂ : Type a)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  finiteGame : FiniteDynamicHierarchyParityGame.{b, max u v w a}
  realizabilityEquivalent :
    finiteGame.realizable ↔
      ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution σ env)

/--
A finite-game compilation whose correctness proof is stated in the form used by
round-by-round DPA tracking: after a fixed finite prefix length, the finite game
checks acceptance from the DPA state reached on that prefix against the
remaining suffix.

The ordinary DPA finite-game compilation is derived below using the DPA
finite-prefix semantic law.
-/
structure DPATrackingFiniteGameCompilation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    (Out₂ : Type a)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  prefixLength : Nat
  finiteGame : FiniteDynamicHierarchyParityGame.{b, max u v w a}
  trackingRealizabilityEquivalent :
    finiteGame.realizable ↔
      ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∀ env : EnvironmentSequence In₁ In₂,
          A.AcceptsFrom
            (A.run (execution σ env) prefixLength)
            (OmegaWord.drop (execution σ env) prefixLength)

/--
A uniform finite-game compiler for deterministic parity objectives over round
records.

Constructing this record is the paper-specific finite-game backend theorem:
every DPA objective over executions must be represented by an equivalent finite
dynamic-hierarchy parity game.
-/
structure DPAFiniteGameCompiler
    (In₁ : Type u)
    (In₂ : Type v)
    (Out₁ : Type w)
    (Out₂ : Type a) where
  compile :
    ∀ A : DetParityAutomaton.{max u v w a, x}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      DPAToFiniteGameCompilation.{u, v, w, a, b, x} Out₂ A

/--
A uniform tracking-style finite-game compiler for deterministic parity
objectives over round records.

This is the shape naturally produced by constructions that carry the DPA state
for a finite prefix before checking the omega suffix.
-/
structure DPATrackingFiniteGameCompiler
    (In₁ : Type u)
    (In₂ : Type v)
    (Out₁ : Type w)
    (Out₂ : Type a) where
  compile :
    ∀ A : DetParityAutomaton.{max u v w a, x}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      DPATrackingFiniteGameCompilation.{u, v, w, a, b, x} Out₂ A

/--
A concrete finite strategy abstraction for a DPA objective.

This is the semantic shape of the paper-specific epoch-abstraction game.  The
finite carriers are the controller and environment abstractions of the infinite
strategy spaces; `wins` is the finite parity-game outcome relation.  The two
correctness fields are deliberately stated in the realizability direction needed
by synthesis:

* every finite winning controller code denotes a real distributed strategy that
  satisfies the DPA objective against all real environments;
* every real winning distributed strategy is represented by some finite
  controller code that wins the finite game.

Instantiating this certificate for all DPAs is the concrete finite-game backend
missing from the arbitrary-LTL route.
-/
structure DPAFiniteStrategyAbstraction
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    (Out₂ : Type a)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  ControllerCode : Type b
  EnvironmentCode : Type (max u v w a)
  controllerFinite : Fintype ControllerCode
  environmentFinite : Fintype EnvironmentCode
  wins : ControllerCode -> EnvironmentCode -> Prop
  winsDecidable : ∀ controller environment, Decidable (wins controller environment)
  controllerStrategy : ControllerCode -> StrategyPair In₁ In₂ Out₁ Out₂
  dynamicHierarchy : Prop
  parityObjective : Prop
  dynamicHierarchy_proof : dynamicHierarchy
  parityObjective_proof : parityObjective
  sound :
    ∀ controller,
      (∀ environment : EnvironmentCode, wins controller environment) ->
        ∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution (controllerStrategy controller) env)
  complete :
    ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      (∀ env : EnvironmentSequence In₁ In₂, A.Accepts (execution σ env)) ->
        ∃ controller : ControllerCode,
          ∀ environment : EnvironmentCode, wins controller environment

attribute [instance] DPAFiniteStrategyAbstraction.controllerFinite
attribute [instance] DPAFiniteStrategyAbstraction.environmentFinite
attribute [instance] DPAFiniteStrategyAbstraction.winsDecidable

namespace FiniteEpochTransformer

/-- The rotating epoch state used by the finite game for a DPA objective. -/
abbrev GameState
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂) :=
  EpochRotatingAccessState T.boundary (T.within Proc.one) (T.within Proc.two)

theorem gameState_fintype
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, x}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂) :
    Nonempty (Fintype (GameState T)) :=
  epoch_transformer_rotating_state_finite T

/-- A finite controller code chooses both process outputs from the epoch state. -/
abbrev ControllerCode
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂) :=
  GameState T -> Out₁ × Out₂

/-- A finite environment code chooses the next input/graph move from the epoch state. -/
abbrev EnvironmentCode
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂) :=
  GameState T -> EnvironmentRound In₁ In₂

theorem controllerCode_fintype
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype Out₁]
    [Fintype Out₂]
    (T :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, x}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂) :
    Nonempty (Fintype (ControllerCode T)) := by
  classical
  rcases gameState_fintype T with ⟨stateFinite⟩
  letI : Fintype (GameState T) := stateFinite
  exact ⟨inferInstance⟩

theorem environmentCode_fintype
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, x}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂) :
    Nonempty (Fintype (EnvironmentCode T)) := by
  classical
  rcases gameState_fintype T with ⟨stateFinite⟩
  letI : Fintype (GameState T) := stateFinite
  exact ⟨inferInstance⟩

/-- One transition of the finite epoch game induced by controller and environment codes. -/
def gameTransition
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : ControllerCode T)
    (state : GameState T)
    (environment : EnvironmentRound In₁ In₂) :
    GameState T :=
  match state with
  | Sum.inl boundary =>
      let output := controller state
      match environment.graph with
      | .left =>
          Sum.inr (Sum.inl
            (T.update Proc.one (T.init Proc.one boundary)
              environment.inputOne environment.inputTwo output.1 output.2))
      | .right =>
          Sum.inr (Sum.inr
            (T.update Proc.two (T.init Proc.two boundary)
              environment.inputOne environment.inputTwo output.1 output.2))
      | .both =>
          Sum.inl
            (T.close Proc.one (T.init Proc.one boundary) Graph.both
              {
                inputOne := environment.inputOne
                inputTwo := environment.inputTwo
                outputOne := output.1
                outputTwo := output.2
              })
  | Sum.inr (Sum.inl withinOne) =>
      let output := controller state
      let withinOne' :=
        T.update Proc.one withinOne
          environment.inputOne environment.inputTwo output.1 output.2
      match environment.graph with
      | .left => Sum.inr (Sum.inl withinOne')
      | graph =>
          Sum.inl
            (T.close Proc.one withinOne graph
              {
                inputOne := environment.inputOne
                inputTwo := environment.inputTwo
                outputOne := output.1
                outputTwo := output.2
              })
  | Sum.inr (Sum.inr withinTwo) =>
      let output := controller state
      let withinTwo' :=
        T.update Proc.two withinTwo
          environment.inputOne environment.inputTwo output.1 output.2
      match environment.graph with
      | .right => Sum.inr (Sum.inr withinTwo')
      | graph =>
          Sum.inl
            (T.close Proc.two withinTwo graph
              {
                inputOne := environment.inputOne
                inputTwo := environment.inputTwo
                outputOne := output.1
                outputTwo := output.2
              })

/--
Run the finite epoch-game transition from an arbitrary current state over a
finite environment history.

This is the formal analogue of the path/node maps used in the journal game
reduction: a finite input history determines the abstract game state reached
under a fixed finite controller.
-/
def gameStateAfterFrom
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T) :
    GameState T -> List (EnvironmentRound In₁ In₂) -> GameState T
  | state, [] => state
  | state, env :: history =>
      gameStateAfterFrom T initialBoundary controller
        (gameTransition T controller state env)
        history

/--
The epoch-game state reached from the initial boundary after a finite
environment history.
-/
def gameStateAfter
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (history : List (EnvironmentRound In₁ In₂)) : GameState T :=
  gameStateAfterFrom T initialBoundary controller
    (Sum.inl initialBoundary) history

@[simp]
theorem gameStateAfterFrom_nil
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (state : GameState T) :
    gameStateAfterFrom T initialBoundary controller state [] = state := rfl

@[simp]
theorem gameStateAfterFrom_cons
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (state : GameState T)
    (env : EnvironmentRound In₁ In₂)
    (history : List (EnvironmentRound In₁ In₂)) :
    gameStateAfterFrom T initialBoundary controller state (env :: history) =
      gameStateAfterFrom T initialBoundary controller
        (gameTransition T controller state env)
        history := rfl

@[simp]
theorem gameStateAfter_nil
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T) :
    gameStateAfter T initialBoundary controller
        ([] : List (EnvironmentRound In₁ In₂)) =
      Sum.inl initialBoundary := rfl

@[simp]
theorem gameStateAfter_cons
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (env : EnvironmentRound In₁ In₂)
    (history : List (EnvironmentRound In₁ In₂)) :
    gameStateAfter T initialBoundary controller (env :: history) =
      gameStateAfterFrom T initialBoundary controller
        (gameTransition T controller (Sum.inl initialBoundary) env)
        history := rfl

/--
Running a concatenated finite environment history is the same as first running
the prefix and then continuing from the reached state.
-/
theorem gameStateAfterFrom_append
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (state : GameState T)
    (pref suff : List (EnvironmentRound In₁ In₂)) :
    gameStateAfterFrom T initialBoundary controller state (pref ++ suff) =
      gameStateAfterFrom T initialBoundary controller
        (gameStateAfterFrom T initialBoundary controller state pref)
        suff := by
  induction pref generalizing state with
  | nil => rfl
  | cons env pref ih =>
      simp [gameStateAfterFrom_cons, ih]

/--
The initial-boundary version of `gameStateAfterFrom_append`.
-/
theorem gameStateAfter_append
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (pref suff : List (EnvironmentRound In₁ In₂)) :
    gameStateAfter T initialBoundary controller (pref ++ suff) =
      gameStateAfterFrom T initialBoundary controller
        (gameStateAfter T initialBoundary controller pref)
        suff := by
  exact
    gameStateAfterFrom_append T initialBoundary controller
      (Sum.inl initialBoundary) pref suff

/--
Appending one environment move to a finite history advances the reached
epoch-game state by one finite-game transition.
-/
theorem gameStateAfter_append_singleton
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (history : List (EnvironmentRound In₁ In₂))
    (env : EnvironmentRound In₁ In₂) :
    gameStateAfter T initialBoundary controller (history ++ [env]) =
      gameTransition T controller
        (gameStateAfter T initialBoundary controller history)
        env := by
  rw [gameStateAfter_append]
  rfl

/-- A state is reachable under a fixed finite controller from the initial boundary. -/
def ReachableGameState
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (state : GameState T) : Prop :=
  ∃ history : List (EnvironmentRound In₁ In₂),
    gameStateAfter T initialBoundary controller history = state

theorem reachableGameState_initial
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T) :
    ReachableGameState T initialBoundary controller (Sum.inl initialBoundary) := by
  exact ⟨[], rfl⟩

/--
Reachability is closed under one finite-game transition.  This is the
representative-history extension lemma corresponding to extending the journal
access string by one environment action.
-/
theorem reachableGameState_transition
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    {state : GameState T}
    (env : EnvironmentRound In₁ In₂)
    (hreachable : ReachableGameState T initialBoundary controller state) :
    ReachableGameState T initialBoundary controller
      (gameTransition T controller state env) := by
  rcases hreachable with ⟨history, hhistory⟩
  refine ⟨history ++ [env], ?_⟩
  rw [gameStateAfter_append_singleton]
  rw [hhistory]

/--
Choose the finite access history for a reachable state, and use the empty
history for unreachable states.  This matches the representative-word choice
in the journal reduction, where unreachable abstract states are harmless.
-/
noncomputable def accessHistory
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (state : GameState T) : List (EnvironmentRound In₁ In₂) := by
  classical
  exact
    if h : ReachableGameState T initialBoundary controller state then
      Classical.choose h
    else
      []

theorem accessHistory_reaches_of_reachable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (state : GameState T)
    (hreachable : ReachableGameState T initialBoundary controller state) :
    gameStateAfter T initialBoundary controller
        (accessHistory T initialBoundary controller state) =
      state := by
  classical
  simp [accessHistory, hreachable, Classical.choose_spec hreachable]

theorem accessHistory_initial_reaches
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T) :
    gameStateAfter T initialBoundary controller
        (accessHistory T initialBoundary controller (Sum.inl initialBoundary)) =
      Sum.inl initialBoundary :=
  accessHistory_reaches_of_reachable T initialBoundary controller
    (Sum.inl initialBoundary)
    (reachableGameState_initial T initialBoundary controller)

/--
The chosen access history for a reachable state can itself be extended by one
environment move to reach the corresponding successor state.
-/
theorem accessHistory_transition_reaches
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    {state : GameState T}
    (env : EnvironmentRound In₁ In₂)
    (hreachable : ReachableGameState T initialBoundary controller state) :
    gameStateAfter T initialBoundary controller
        (accessHistory T initialBoundary controller state ++ [env]) =
      gameTransition T controller state env := by
  rw [gameStateAfter_append_singleton]
  rw [accessHistory_reaches_of_reachable T initialBoundary controller state hreachable]

/--
Recover the epoch-game state that a process can compute from its local view.

The `noRecv` cases require a dummy input for the process that was not observed
in the local view.  This definition therefore makes the needed nonemptiness of
both input alphabets explicit via `Inhabited`.
-/
noncomputable def epochStateFromView
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T) :
    (d : Proc) -> View In₁ In₂ d -> GameState T
  | _, .empty _ => Sum.inl initialBoundary
  | Proc.one, .noRecv prevView (PSum.inl inputOne) =>
      gameTransition T controller
        (epochStateFromView T initialBoundary controller Proc.one prevView)
        {
          inputOne := inputOne
          inputTwo := default
          graph := Graph.right
        }
  | Proc.one, .recv prevSelf (PSum.inl inputOne) _ (PSum.inr inputTwo) =>
      gameTransition T controller
        (epochStateFromView T initialBoundary controller Proc.one prevSelf)
        {
          inputOne := inputOne
          inputTwo := inputTwo
          graph := Graph.left
        }
  | Proc.two, .noRecv prevView (PSum.inr inputTwo) =>
      gameTransition T controller
        (epochStateFromView T initialBoundary controller Proc.two prevView)
        {
          inputOne := default
          inputTwo := inputTwo
          graph := Graph.left
        }
  | Proc.two, .recv prevSelf (PSum.inr inputTwo) _ (PSum.inl inputOne) =>
      gameTransition T controller
        (epochStateFromView T initialBoundary controller Proc.two prevSelf)
        {
          inputOne := inputOne
          inputTwo := inputTwo
          graph := Graph.right
        }
  | _, _ => Sum.inl initialBoundary

/--
Decode a finite epoch-game controller code into ordinary local strategies by
first reconstructing the process-visible epoch state from the local view.
-/
noncomputable def controllerStrategyOf
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T) :
    StrategyPair In₁ In₂ Out₁ Out₂ where
  one := fun view =>
    (controller
      (epochStateFromView T initialBoundary controller Proc.one view)).1
  two := fun view =>
    (controller
      (epochStateFromView T initialBoundary controller Proc.two view)).2

/--
All epoch-game states compatible with a process local view.

Unlike `epochStateFromView`, this finite-set decoder records the real local
uncertainty.  A `noRecv` view hides the other process input, so the definition
ranges over all such inputs.  A `recv` view does not distinguish the one-sided
receive graph from a synchronizing `.both` graph, so both graph cases are kept.
-/
noncomputable def possibleEpochStatesFromView
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T) :
    (d : Proc) -> View In₁ In₂ d -> Finset (GameState T)
  | _, .empty _ => {Sum.inl initialBoundary}
  | Proc.one, .noRecv prevView (PSum.inl inputOne) =>
      let prevStates :=
        possibleEpochStatesFromView T initialBoundary controller Proc.one prevView
      prevStates.biUnion (fun state =>
        (Finset.univ : Finset In₂).image (fun inputTwo =>
          gameTransition T controller state
            {
              inputOne := inputOne
              inputTwo := inputTwo
              graph := Graph.right
            }))
  | Proc.one, .recv prevSelf (PSum.inl inputOne) _ (PSum.inr inputTwo) =>
      let prevStates :=
        possibleEpochStatesFromView T initialBoundary controller Proc.one prevSelf
      prevStates.biUnion (fun state =>
        ({Graph.left, Graph.both} : Finset Graph).image (fun graph =>
          gameTransition T controller state
            {
              inputOne := inputOne
              inputTwo := inputTwo
              graph := graph
            }))
  | Proc.two, .noRecv prevView (PSum.inr inputTwo) =>
      let prevStates :=
        possibleEpochStatesFromView T initialBoundary controller Proc.two prevView
      prevStates.biUnion (fun state =>
        (Finset.univ : Finset In₁).image (fun inputOne =>
          gameTransition T controller state
            {
              inputOne := inputOne
              inputTwo := inputTwo
              graph := Graph.left
            }))
  | Proc.two, .recv prevSelf (PSum.inr inputTwo) _ (PSum.inl inputOne) =>
      let prevStates :=
        possibleEpochStatesFromView T initialBoundary controller Proc.two prevSelf
      prevStates.biUnion (fun state =>
        ({Graph.right, Graph.both} : Finset Graph).image (fun graph =>
          gameTransition T controller state
            {
              inputOne := inputOne
              inputTwo := inputTwo
              graph := graph
            }))
  | _, _ => {Sum.inl initialBoundary}

/--
The singleton decoder used to extract an ordinary strategy always chooses one
state from the uncertainty-aware finite possible-state set.
-/
theorem epochStateFromView_mem_possibleEpochStatesFromView
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T) :
    ∀ (d : Proc) (view : View In₁ In₂ d),
      epochStateFromView T initialBoundary controller d view ∈
        possibleEpochStatesFromView T initialBoundary controller d view
  | _, .empty _ => by
      simp [epochStateFromView, possibleEpochStatesFromView]
  | Proc.one, .noRecv prevView (PSum.inl inputOne) => by
      classical
      have hprev :=
        epochStateFromView_mem_possibleEpochStatesFromView
          T initialBoundary controller Proc.one prevView
      exact Finset.mem_biUnion.mpr
        ⟨epochStateFromView T initialBoundary controller Proc.one prevView, hprev,
          Finset.mem_image.mpr
            ⟨default, by simp, rfl⟩⟩
  | Proc.one, .recv prevSelf (PSum.inl inputOne) prevOther (PSum.inr inputTwo) => by
      classical
      have hprev :=
        epochStateFromView_mem_possibleEpochStatesFromView
          T initialBoundary controller Proc.one prevSelf
      exact Finset.mem_biUnion.mpr
        ⟨epochStateFromView T initialBoundary controller Proc.one prevSelf, hprev,
          Finset.mem_image.mpr
            ⟨Graph.left, by simp, rfl⟩⟩
  | Proc.two, .noRecv prevView (PSum.inr inputTwo) => by
      classical
      have hprev :=
        epochStateFromView_mem_possibleEpochStatesFromView
          T initialBoundary controller Proc.two prevView
      exact Finset.mem_biUnion.mpr
        ⟨epochStateFromView T initialBoundary controller Proc.two prevView, hprev,
          Finset.mem_image.mpr
            ⟨default, by simp, rfl⟩⟩
  | Proc.two, .recv prevSelf (PSum.inr inputTwo) prevOther (PSum.inl inputOne) => by
      classical
      have hprev :=
        epochStateFromView_mem_possibleEpochStatesFromView
          T initialBoundary controller Proc.two prevSelf
      exact Finset.mem_biUnion.mpr
        ⟨epochStateFromView T initialBoundary controller Proc.two prevSelf, hprev,
          Finset.mem_image.mpr
            ⟨Graph.right, by simp, rfl⟩⟩
  | Proc.one, .noRecv _ (PSum.inr _) => by
      exact Finset.mem_singleton.mpr rfl
  | Proc.two, .noRecv _ (PSum.inl _) => by
      exact Finset.mem_singleton.mpr rfl
  | Proc.one, .recv _ (PSum.inl _) _ (PSum.inl _) => by
      exact Finset.mem_singleton.mpr rfl
  | Proc.one, .recv _ (PSum.inr _) _ _ => by
      exact Finset.mem_singleton.mpr rfl
  | Proc.two, .recv _ (PSum.inr _) _ (PSum.inr _) => by
      exact Finset.mem_singleton.mpr rfl
  | Proc.two, .recv _ (PSum.inl _) _ _ => by
      exact Finset.mem_singleton.mpr rfl

/--
Every state in the uncertainty-aware possible-state set for a local view is
reachable by some finite environment history under the same controller.

This is the reachability half of the journal representative-history invariant:
the finite uncertainty set contains only states for which an access history can
be chosen.
-/
theorem possibleEpochStatesFromView_reachable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T) :
    ∀ (d : Proc) (view : View In₁ In₂ d) {state : GameState T},
      state ∈ possibleEpochStatesFromView T initialBoundary controller d view ->
        ReachableGameState T initialBoundary controller state
  | _, .empty _, state, hstate => by
      have hstateEq : state = Sum.inl initialBoundary := by
        simpa [possibleEpochStatesFromView] using hstate
      subst state
      exact reachableGameState_initial T initialBoundary controller
  | Proc.one, .noRecv prevView (PSum.inl inputOne), state, hstate => by
      classical
      rcases Finset.mem_biUnion.mp hstate with
        ⟨prevState, hprevState, hstateImage⟩
      rcases Finset.mem_image.mp hstateImage with
        ⟨inputTwo, _hinputTwo, rfl⟩
      exact
        reachableGameState_transition
          T initialBoundary controller
          {
            inputOne := inputOne
            inputTwo := inputTwo
            graph := Graph.right
          }
          (possibleEpochStatesFromView_reachable
            T initialBoundary controller Proc.one prevView hprevState)
  | Proc.one, .recv prevSelf (PSum.inl inputOne) _ (PSum.inr inputTwo), state, hstate => by
      classical
      rcases Finset.mem_biUnion.mp hstate with
        ⟨prevState, hprevState, hstateImage⟩
      rcases Finset.mem_image.mp hstateImage with
        ⟨graph, _hgraph, rfl⟩
      exact
        reachableGameState_transition
          T initialBoundary controller
          {
            inputOne := inputOne
            inputTwo := inputTwo
            graph := graph
          }
          (possibleEpochStatesFromView_reachable
            T initialBoundary controller Proc.one prevSelf hprevState)
  | Proc.two, .noRecv prevView (PSum.inr inputTwo), state, hstate => by
      classical
      rcases Finset.mem_biUnion.mp hstate with
        ⟨prevState, hprevState, hstateImage⟩
      rcases Finset.mem_image.mp hstateImage with
        ⟨inputOne, _hinputOne, rfl⟩
      exact
        reachableGameState_transition
          T initialBoundary controller
          {
            inputOne := inputOne
            inputTwo := inputTwo
            graph := Graph.left
          }
          (possibleEpochStatesFromView_reachable
            T initialBoundary controller Proc.two prevView hprevState)
  | Proc.two, .recv prevSelf (PSum.inr inputTwo) _ (PSum.inl inputOne), state, hstate => by
      classical
      rcases Finset.mem_biUnion.mp hstate with
        ⟨prevState, hprevState, hstateImage⟩
      rcases Finset.mem_image.mp hstateImage with
        ⟨graph, _hgraph, rfl⟩
      exact
        reachableGameState_transition
          T initialBoundary controller
          {
            inputOne := inputOne
            inputTwo := inputTwo
            graph := graph
          }
          (possibleEpochStatesFromView_reachable
            T initialBoundary controller Proc.two prevSelf hprevState)
  | Proc.one, .noRecv _ (PSum.inr _), state, hstate => by
      have hstateEq : state = Sum.inl initialBoundary := by
        simpa [possibleEpochStatesFromView] using hstate
      subst state
      exact reachableGameState_initial T initialBoundary controller
  | Proc.two, .noRecv _ (PSum.inl _), state, hstate => by
      have hstateEq : state = Sum.inl initialBoundary := by
        simpa [possibleEpochStatesFromView] using hstate
      subst state
      exact reachableGameState_initial T initialBoundary controller
  | Proc.one, .recv _ (PSum.inl _) _ (PSum.inl _), state, hstate => by
      have hstateEq : state = Sum.inl initialBoundary := by
        simpa [possibleEpochStatesFromView] using hstate
      subst state
      exact reachableGameState_initial T initialBoundary controller
  | Proc.one, .recv _ (PSum.inr _) _ _, state, hstate => by
      have hstateEq : state = Sum.inl initialBoundary := by
        simpa [possibleEpochStatesFromView] using hstate
      subst state
      exact reachableGameState_initial T initialBoundary controller
  | Proc.two, .recv _ (PSum.inr _) _ (PSum.inr _), state, hstate => by
      have hstateEq : state = Sum.inl initialBoundary := by
        simpa [possibleEpochStatesFromView] using hstate
      subst state
      exact reachableGameState_initial T initialBoundary controller
  | Proc.two, .recv _ (PSum.inl _) _ _, state, hstate => by
      have hstateEq : state = Sum.inl initialBoundary := by
        simpa [possibleEpochStatesFromView] using hstate
      subst state
      exact reachableGameState_initial T initialBoundary controller

/--
Process-one output of the decoded strategy is produced at a state contained in
the uncertainty-aware possible-state set for the same local view.
-/
theorem controllerStrategyOf_one_output_from_possibleState
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (view : View In₁ In₂ Proc.one) :
    ∃ state ∈ possibleEpochStatesFromView
        T initialBoundary controller Proc.one view,
      (controllerStrategyOf T initialBoundary controller).one view =
        (controller state).1 := by
  exact
    ⟨epochStateFromView T initialBoundary controller Proc.one view,
      epochStateFromView_mem_possibleEpochStatesFromView
        T initialBoundary controller Proc.one view,
      rfl⟩

/--
Process-two output of the decoded strategy is produced at a state contained in
the uncertainty-aware possible-state set for the same local view.
-/
theorem controllerStrategyOf_two_output_from_possibleState
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (view : View In₁ In₂ Proc.two) :
    ∃ state ∈ possibleEpochStatesFromView
        T initialBoundary controller Proc.two view,
      (controllerStrategyOf T initialBoundary controller).two view =
        (controller state).2 := by
  exact
    ⟨epochStateFromView T initialBoundary controller Proc.two view,
      epochStateFromView_mem_possibleEpochStatesFromView
        T initialBoundary controller Proc.two view,
      rfl⟩

/--
A concrete round is compatible with the uncertainty-aware decoded-controller
view state if its inputs and graph are the current environment move, and its
two outputs are selected by the finite controller at states compatible with
the two local views.
-/
def CompatibleDecodedRound
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (viewOne : View In₁ In₂ Proc.one)
    (viewTwo : View In₁ In₂ Proc.two)
    (env : EnvironmentRound In₁ In₂)
    (round : RoundRecord In₁ In₂ Graph Out₁ Out₂) : Prop :=
  ∃ stateOne ∈ possibleEpochStatesFromView
      T initialBoundary controller Proc.one viewOne,
    ∃ stateTwo ∈ possibleEpochStatesFromView
        T initialBoundary controller Proc.two viewTwo,
      round =
        {
          inputOne := env.inputOne
          inputTwo := env.inputTwo
          graph := env.graph
          outputOne := (controller stateOne).1
          outputTwo := (controller stateTwo).2
        }

/--
A compatible decoded round can be witnessed by reachable epoch-game states,
and the canonical representative access histories chosen for those states
indeed reach them.

This is the local representative-history fact needed before assembling a
coherent decoded execution stream.
-/
theorem compatibleDecodedRound_exists_accessHistories
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (viewOne : View In₁ In₂ Proc.one)
    (viewTwo : View In₁ In₂ Proc.two)
    (env : EnvironmentRound In₁ In₂)
    (round : RoundRecord In₁ In₂ Graph Out₁ Out₂)
    (hround :
      CompatibleDecodedRound T initialBoundary controller
        viewOne viewTwo env round) :
    ∃ stateOne ∈ possibleEpochStatesFromView
        T initialBoundary controller Proc.one viewOne,
      ∃ stateTwo ∈ possibleEpochStatesFromView
          T initialBoundary controller Proc.two viewTwo,
        gameStateAfter T initialBoundary controller
            (accessHistory T initialBoundary controller stateOne) =
          stateOne ∧
        gameStateAfter T initialBoundary controller
            (accessHistory T initialBoundary controller stateTwo) =
          stateTwo ∧
        round =
          {
            inputOne := env.inputOne
            inputTwo := env.inputTwo
            graph := env.graph
            outputOne := (controller stateOne).1
            outputTwo := (controller stateTwo).2
          } := by
  rcases hround with
    ⟨stateOne, hstateOne, stateTwo, hstateTwo, hroundEq⟩
  have hreachableOne :
      ReachableGameState T initialBoundary controller stateOne :=
    possibleEpochStatesFromView_reachable
      T initialBoundary controller Proc.one viewOne hstateOne
  have hreachableTwo :
      ReachableGameState T initialBoundary controller stateTwo :=
    possibleEpochStatesFromView_reachable
      T initialBoundary controller Proc.two viewTwo hstateTwo
  exact
    ⟨stateOne, hstateOne, stateTwo, hstateTwo,
      accessHistory_reaches_of_reachable
        T initialBoundary controller stateOne hreachableOne,
      accessHistory_reaches_of_reachable
        T initialBoundary controller stateTwo hreachableTwo,
      hroundEq⟩

/--
An omega word is compatible with the decoded controller execution if every
letter is a concrete environment move whose outputs can be read from finite
controller states compatible with the two actual local views at that time.
-/
def CompatibleDecodedExecution
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)) : Prop :=
  ∀ n,
    CompatibleDecodedRound T initialBoundary controller
      (currentView Proc.one
        (executionPrefix
          (controllerStrategyOf T initialBoundary controller) env (n + 1)))
      (currentView Proc.two
        (executionPrefix
          (controllerStrategyOf T initialBoundary controller) env (n + 1)))
      (env n)
      (word n)

/--
Pointwise representative access histories for a compatible decoded execution.

At each round, the two controller states witnessing output compatibility are
reachable by the chosen access histories.  This is still weaker than the final
single coherent epoch-game state stream, but it removes the reachability part
of the finite-game soundness obligation.
-/
def CompatibleDecodedExecutionAccessHistories
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)) : Prop :=
  ∀ n : Nat,
    ∃ stateOne ∈ possibleEpochStatesFromView
        T initialBoundary controller Proc.one
          (currentView Proc.one
            (executionPrefix
              (controllerStrategyOf T initialBoundary controller) env (n + 1))),
      ∃ stateTwo ∈ possibleEpochStatesFromView
          T initialBoundary controller Proc.two
            (currentView Proc.two
              (executionPrefix
                (controllerStrategyOf T initialBoundary controller) env (n + 1))),
        gameStateAfter T initialBoundary controller
            (accessHistory T initialBoundary controller stateOne) =
          stateOne ∧
        gameStateAfter T initialBoundary controller
            (accessHistory T initialBoundary controller stateTwo) =
          stateTwo ∧
        word n =
          {
            inputOne := (env n).inputOne
            inputTwo := (env n).inputTwo
            graph := (env n).graph
            outputOne := (controller stateOne).1
            outputTwo := (controller stateTwo).2
          }

/--
Every compatible decoded execution has pointwise reachable representative
access histories for the states that justify its two outputs.
-/
theorem compatibleDecodedExecution_accessHistories
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hcompatible :
      CompatibleDecodedExecution T initialBoundary controller env word) :
    CompatibleDecodedExecutionAccessHistories
      T initialBoundary controller env word := by
  intro n
  exact
    compatibleDecodedRound_exists_accessHistories
      T initialBoundary controller
      (currentView Proc.one
        (executionPrefix
          (controllerStrategyOf T initialBoundary controller) env (n + 1)))
      (currentView Proc.two
        (executionPrefix
          (controllerStrategyOf T initialBoundary controller) env (n + 1)))
      (env n)
      (word n)
      (hcompatible n)

/--
Skolemized representative-state streams for a compatible decoded execution.

Instead of a pointwise existential at each time, this gives two explicit
streams of reachable epoch-game states, one witnessing process one's output
and one witnessing process two's output.  The remaining coherent-stream proof
has to show when these local witness streams can be synchronized into one
repeat-consistent global epoch-game stream.
-/
theorem exists_compatibleDecodedExecution_stateChoiceStreams
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hcompatible :
      CompatibleDecodedExecution T initialBoundary controller env word) :
    ∃ stateOne : Nat -> GameState T,
      ∃ stateTwo : Nat -> GameState T,
        ∀ n : Nat,
          stateOne n ∈ possibleEpochStatesFromView
              T initialBoundary controller Proc.one
                (currentView Proc.one
                  (executionPrefix
                    (controllerStrategyOf T initialBoundary controller)
                    env (n + 1))) ∧
          stateTwo n ∈ possibleEpochStatesFromView
              T initialBoundary controller Proc.two
                (currentView Proc.two
                  (executionPrefix
                    (controllerStrategyOf T initialBoundary controller)
                    env (n + 1))) ∧
          gameStateAfter T initialBoundary controller
              (accessHistory T initialBoundary controller (stateOne n)) =
            stateOne n ∧
          gameStateAfter T initialBoundary controller
              (accessHistory T initialBoundary controller (stateTwo n)) =
            stateTwo n ∧
          word n =
            {
              inputOne := (env n).inputOne
              inputTwo := (env n).inputTwo
              graph := (env n).graph
              outputOne := (controller (stateOne n)).1
              outputTwo := (controller (stateTwo n)).2
            } := by
  classical
  let witness :=
    compatibleDecodedExecution_accessHistories
      T initialBoundary controller env word hcompatible
  let stateOne : Nat -> GameState T := fun n => Classical.choose (witness n)
  let stateTwo : Nat -> GameState T := fun n =>
    Classical.choose (Classical.choose_spec (witness n)).2
  refine ⟨stateOne, stateTwo, ?_⟩
  intro n
  have hstateOne := Classical.choose_spec (witness n)
  have hstateTwo := Classical.choose_spec hstateOne.2
  exact
    ⟨hstateOne.1,
      hstateTwo.1,
      hstateTwo.2.1,
      hstateTwo.2.2.1,
      hstateTwo.2.2.2⟩

/--
The semantic soundness obligation for a decoded finite controller, stated at
the compatible-execution boundary.

This is the right target for the epoch-game proof: the local strategy extracted
from a finite controller may choose states from the uncertainty set induced by
each process view, so the finite game has to prove acceptance for all omega
words compatible with those choices.
-/
def CompatibleDecodedControllerSound
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) : Prop :=
  ∀ (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
      CompatibleDecodedExecution T initialBoundary controller env word ->
        A.Accepts word

/--
One concrete execution step of the decoded ordinary strategy takes both outputs
from controller states compatible with the two freshly updated local views.
-/
theorem nextRound_controllerStrategyOf_outputs_from_possibleStates
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (h : History In₁ In₂ Graph Out₁ Out₂)
    (env : EnvironmentRound In₁ In₂) :
    ∃ stateOne ∈ possibleEpochStatesFromView
        T initialBoundary controller Proc.one
          (nextView Proc.one h env),
      ∃ stateTwo ∈ possibleEpochStatesFromView
          T initialBoundary controller Proc.two
            (nextView Proc.two h env),
        nextRound (controllerStrategyOf T initialBoundary controller) h env =
          {
            inputOne := env.inputOne
            inputTwo := env.inputTwo
            graph := env.graph
            outputOne := (controller stateOne).1
            outputTwo := (controller stateTwo).2
          } := by
  refine
    ⟨epochStateFromView T initialBoundary controller Proc.one
        (nextView Proc.one h env),
      epochStateFromView_mem_possibleEpochStatesFromView
        T initialBoundary controller Proc.one
          (nextView Proc.one h env),
      epochStateFromView T initialBoundary controller Proc.two
        (nextView Proc.two h env),
      epochStateFromView_mem_possibleEpochStatesFromView
        T initialBoundary controller Proc.two
          (nextView Proc.two h env),
      ?_⟩
  rfl

/--
The next round generated by the decoded controller is compatible with the
possible-state interpretation of the freshly updated views.
-/
theorem nextRound_controllerStrategyOf_compatibleDecodedRound
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (h : History In₁ In₂ Graph Out₁ Out₂)
    (env : EnvironmentRound In₁ In₂) :
    CompatibleDecodedRound T initialBoundary controller
      (nextView Proc.one h env)
      (nextView Proc.two h env)
      env
      (nextRound (controllerStrategyOf T initialBoundary controller) h env) := by
  rcases nextRound_controllerStrategyOf_outputs_from_possibleStates
      T initialBoundary controller h env with
    ⟨stateOne, hstateOne, stateTwo, hstateTwo, hround⟩
  exact ⟨stateOne, hstateOne, stateTwo, hstateTwo, hround⟩

/--
At every step of a real execution prefix generated by the decoded controller,
the next round's outputs come from controller states compatible with the actual
local views after that step.
-/
theorem executionPrefix_controllerStrategyOf_outputs_from_possibleStates
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (env : EnvironmentSequence In₁ In₂)
    (n : Nat) :
    ∃ stateOne ∈ possibleEpochStatesFromView
        T initialBoundary controller Proc.one
          (currentView Proc.one
            (executionPrefix
              (controllerStrategyOf T initialBoundary controller) env (n + 1))),
      ∃ stateTwo ∈ possibleEpochStatesFromView
          T initialBoundary controller Proc.two
            (currentView Proc.two
              (executionPrefix
                (controllerStrategyOf T initialBoundary controller) env (n + 1))),
        nextRound
            (controllerStrategyOf T initialBoundary controller)
            (executionPrefix
              (controllerStrategyOf T initialBoundary controller) env n)
            (env n) =
          {
            inputOne := (env n).inputOne
            inputTwo := (env n).inputTwo
            graph := (env n).graph
            outputOne := (controller stateOne).1
            outputTwo := (controller stateTwo).2
          } := by
  simpa using
    nextRound_controllerStrategyOf_outputs_from_possibleStates
      T initialBoundary controller
      (executionPrefix
        (controllerStrategyOf T initialBoundary controller) env n)
      (env n)

/--
The omega execution word generated by the decoded controller has, at every
time, outputs selected from controller states compatible with the actual local
views reached by the corresponding finite execution prefix.
-/
theorem execution_controllerStrategyOf_outputs_from_possibleStates
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (env : EnvironmentSequence In₁ In₂)
    (n : Nat) :
    ∃ stateOne ∈ possibleEpochStatesFromView
        T initialBoundary controller Proc.one
          (currentView Proc.one
            (executionPrefix
              (controllerStrategyOf T initialBoundary controller) env (n + 1))),
      ∃ stateTwo ∈ possibleEpochStatesFromView
          T initialBoundary controller Proc.two
            (currentView Proc.two
              (executionPrefix
                (controllerStrategyOf T initialBoundary controller) env (n + 1))),
        execution (controllerStrategyOf T initialBoundary controller) env n =
          {
            inputOne := (env n).inputOne
            inputTwo := (env n).inputTwo
            graph := (env n).graph
            outputOne := (controller stateOne).1
            outputTwo := (controller stateTwo).2
          } := by
  simpa [execution_apply] using
    executionPrefix_controllerStrategyOf_outputs_from_possibleStates
      T initialBoundary controller env n

/--
The omega execution word generated by the decoded controller is pointwise a
compatible decoded round for the actual views reached by its finite prefixes.
-/
theorem execution_controllerStrategyOf_compatibleDecodedRound
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (env : EnvironmentSequence In₁ In₂)
    (n : Nat) :
    CompatibleDecodedRound T initialBoundary controller
      (currentView Proc.one
        (executionPrefix
          (controllerStrategyOf T initialBoundary controller) env (n + 1)))
      (currentView Proc.two
        (executionPrefix
          (controllerStrategyOf T initialBoundary controller) env (n + 1)))
      (env n)
      (execution (controllerStrategyOf T initialBoundary controller) env n) := by
  rcases execution_controllerStrategyOf_outputs_from_possibleStates
      T initialBoundary controller env n with
    ⟨stateOne, hstateOne, stateTwo, hstateTwo, hround⟩
  exact ⟨stateOne, hstateOne, stateTwo, hstateTwo, hround⟩

/--
The whole omega execution word generated by the decoded controller satisfies
the compatible decoded-execution predicate.
-/
theorem execution_controllerStrategyOf_compatibleDecodedExecution
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (env : EnvironmentSequence In₁ In₂) :
    CompatibleDecodedExecution T initialBoundary controller env
      (execution (controllerStrategyOf T initialBoundary controller) env) := by
  intro n
  exact execution_controllerStrategyOf_compatibleDecodedRound
    T initialBoundary controller env n

/--
A compatible-execution soundness proof immediately yields ordinary semantic
soundness for the decoded local strategy.
-/
theorem controllerStrategyOf_sound_of_compatibleDecodedControllerSound
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hsound :
      CompatibleDecodedControllerSound T initialBoundary controller A) :
    ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts
        (execution (controllerStrategyOf T initialBoundary controller) env) := by
  intro env
  exact hsound env
    (execution (controllerStrategyOf T initialBoundary controller) env)
    (execution_controllerStrategyOf_compatibleDecodedExecution
      T initialBoundary controller env)

/--
Compatible decoded-controller soundness is invariant under replacing the DPA
objective by a language-equivalent one.
-/
theorem compatibleDecodedControllerSound_transferLanguage
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    {A B : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (hsound :
      CompatibleDecodedControllerSound T initialBoundary controller A)
    (sameLanguage :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        B.Accepts word ↔ A.Accepts word) :
    CompatibleDecodedControllerSound T initialBoundary controller B := by
  intro env word hcompatible
  exact (sameLanguage word).mpr (hsound env word hcompatible)

/--
The DPA run over the decoded-controller execution steps through a round whose
outputs are selected from controller states compatible with the actual local
views.
-/
theorem dpa_run_succ_controllerStrategyOf_outputs_from_possibleStates
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (env : EnvironmentSequence In₁ In₂)
    (n : Nat) :
    ∃ stateOne ∈ possibleEpochStatesFromView
        T initialBoundary controller Proc.one
          (currentView Proc.one
            (executionPrefix
              (controllerStrategyOf T initialBoundary controller) env (n + 1))),
      ∃ stateTwo ∈ possibleEpochStatesFromView
          T initialBoundary controller Proc.two
            (currentView Proc.two
              (executionPrefix
                (controllerStrategyOf T initialBoundary controller) env (n + 1))),
        A.run (execution (controllerStrategyOf T initialBoundary controller) env)
            (n + 1) =
          A.step
            (A.run (execution (controllerStrategyOf T initialBoundary controller) env) n)
            {
              inputOne := (env n).inputOne
              inputTwo := (env n).inputTwo
              graph := (env n).graph
              outputOne := (controller stateOne).1
              outputTwo := (controller stateTwo).2
            } := by
  rcases execution_controllerStrategyOf_outputs_from_possibleStates
      T initialBoundary controller env n with
    ⟨stateOne, hstateOne, stateTwo, hstateTwo, hround⟩
  exact
    ⟨stateOne, hstateOne, stateTwo, hstateTwo, by
      calc
        A.run (execution (controllerStrategyOf T initialBoundary controller) env)
            (n + 1)
            =
          A.step
            (A.run (execution (controllerStrategyOf T initialBoundary controller) env) n)
            (execution (controllerStrategyOf T initialBoundary controller) env n) := rfl
        _ =
          A.step
            (A.run (execution (controllerStrategyOf T initialBoundary controller) env) n)
            {
              inputOne := (env n).inputOne
              inputTwo := (env n).inputTwo
              graph := (env n).graph
              outputOne := (controller stateOne).1
              outputTwo := (controller stateTwo).2
            } := by
              rw [hround]⟩

/--
The priority seen by the DPA after one decoded-controller step is the priority
of a transition labelled by a round whose outputs come from compatible
possible-state controller states.
-/
theorem dpa_priority_succ_controllerStrategyOf_outputs_from_possibleStates
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (env : EnvironmentSequence In₁ In₂)
    (n : Nat) :
    ∃ stateOne ∈ possibleEpochStatesFromView
        T initialBoundary controller Proc.one
          (currentView Proc.one
            (executionPrefix
              (controllerStrategyOf T initialBoundary controller) env (n + 1))),
      ∃ stateTwo ∈ possibleEpochStatesFromView
          T initialBoundary controller Proc.two
            (currentView Proc.two
              (executionPrefix
                (controllerStrategyOf T initialBoundary controller) env (n + 1))),
        A.priority
            (A.run (execution (controllerStrategyOf T initialBoundary controller) env)
              (n + 1)) =
          A.priority
            (A.step
              (A.run (execution (controllerStrategyOf T initialBoundary controller) env) n)
              {
                inputOne := (env n).inputOne
                inputTwo := (env n).inputTwo
                graph := (env n).graph
                outputOne := (controller stateOne).1
                outputTwo := (controller stateTwo).2
              }) := by
  rcases dpa_run_succ_controllerStrategyOf_outputs_from_possibleStates
      T initialBoundary controller A env n with
    ⟨stateOne, hstateOne, stateTwo, hstateTwo, hrun⟩
  exact
    ⟨stateOne, hstateOne, stateTwo, hstateTwo, by
      simpa using congrArg A.priority hrun⟩

/--
The DPA run over the decoded-controller execution has a successor step labelled
by a compatible decoded round.
-/
theorem dpa_run_succ_controllerStrategyOf_compatibleDecodedRound
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (env : EnvironmentSequence In₁ In₂)
    (n : Nat) :
    ∃ round,
      CompatibleDecodedRound T initialBoundary controller
        (currentView Proc.one
          (executionPrefix
            (controllerStrategyOf T initialBoundary controller) env (n + 1)))
        (currentView Proc.two
          (executionPrefix
            (controllerStrategyOf T initialBoundary controller) env (n + 1)))
        (env n)
        round ∧
      A.run (execution (controllerStrategyOf T initialBoundary controller) env)
          (n + 1) =
        A.step
          (A.run (execution (controllerStrategyOf T initialBoundary controller) env) n)
          round := by
  refine
    ⟨execution (controllerStrategyOf T initialBoundary controller) env n,
      execution_controllerStrategyOf_compatibleDecodedRound
        T initialBoundary controller env n,
      rfl⟩

/--
The priority seen after one decoded-controller DPA step is the priority of a
transition labelled by a compatible decoded round.
-/
theorem dpa_priority_succ_controllerStrategyOf_compatibleDecodedRound
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (env : EnvironmentSequence In₁ In₂)
    (n : Nat) :
    ∃ round,
      CompatibleDecodedRound T initialBoundary controller
        (currentView Proc.one
          (executionPrefix
            (controllerStrategyOf T initialBoundary controller) env (n + 1)))
        (currentView Proc.two
          (executionPrefix
            (controllerStrategyOf T initialBoundary controller) env (n + 1)))
        (env n)
        round ∧
      A.priority
          (A.run (execution (controllerStrategyOf T initialBoundary controller) env)
            (n + 1)) =
        A.priority
          (A.step
            (A.run (execution (controllerStrategyOf T initialBoundary controller) env) n)
            round) := by
  rcases dpa_run_succ_controllerStrategyOf_compatibleDecodedRound
      T initialBoundary controller A env n with
    ⟨round, hroundCompatible, hrun⟩
  exact ⟨round, hroundCompatible, by simpa using congrArg A.priority hrun⟩

/-- The epoch-game state stream generated by finite controller/environment codes. -/
def gameStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T) :
    Nat -> GameState T
  | 0 => Sum.inl initialBoundary
  | n + 1 =>
      let state := gameStateStream T initialBoundary controller environment n
      gameTransition T controller state (environment state)

@[simp] theorem gameStateStream_zero
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T) :
    gameStateStream T initialBoundary controller environment 0 =
      Sum.inl initialBoundary :=
  rfl

@[simp] theorem gameStateStream_succ
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (n : Nat) :
    gameStateStream T initialBoundary controller environment (n + 1) =
      gameTransition T controller
        (gameStateStream T initialBoundary controller environment n)
        (environment
          (gameStateStream T initialBoundary controller environment n)) :=
  rfl

/--
The finite environment prefix that generates the first `n` transitions of a
finite epoch-game play.
-/
def gameEnvironmentHistory
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T) :
    Nat -> List (EnvironmentRound In₁ In₂)
  | 0 => []
  | n + 1 =>
      gameEnvironmentHistory T initialBoundary controller environment n ++
        [environment (gameStateStream T initialBoundary controller environment n)]

@[simp] theorem gameEnvironmentHistory_zero
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T) :
    gameEnvironmentHistory T initialBoundary controller environment 0 = [] :=
  rfl

@[simp] theorem gameEnvironmentHistory_succ
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (n : Nat) :
    gameEnvironmentHistory T initialBoundary controller environment (n + 1) =
      gameEnvironmentHistory T initialBoundary controller environment n ++
        [environment (gameStateStream T initialBoundary controller environment n)] :=
  rfl

theorem gameStateAfter_gameEnvironmentHistory
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (n : Nat) :
    gameStateAfter T initialBoundary controller
        (gameEnvironmentHistory T initialBoundary controller environment n) =
      gameStateStream T initialBoundary controller environment n := by
  induction n with
  | zero =>
      rfl
  | succ n ih =>
      rw [gameEnvironmentHistory_succ]
      rw [gameStateAfter_append_singleton]
      rw [ih]
      rfl

theorem gameStateStream_reachable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (n : Nat) :
    ReachableGameState T initialBoundary controller
      (gameStateStream T initialBoundary controller environment n) :=
  ⟨gameEnvironmentHistory T initialBoundary controller environment n,
    gameStateAfter_gameEnvironmentHistory T initialBoundary controller environment n⟩

theorem accessHistory_gameStateStream_reaches
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (n : Nat) :
    gameStateAfter T initialBoundary controller
        (accessHistory T initialBoundary controller
          (gameStateStream T initialBoundary controller environment n)) =
      gameStateStream T initialBoundary controller environment n :=
  accessHistory_reaches_of_reachable T initialBoundary controller
    (gameStateStream T initialBoundary controller environment n)
    (gameStateStream_reachable T initialBoundary controller environment n)

theorem accessHistory_gameStateStream_transition_reaches
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (n : Nat) :
    gameStateAfter T initialBoundary controller
        (accessHistory T initialBoundary controller
            (gameStateStream T initialBoundary controller environment n) ++
          [environment (gameStateStream T initialBoundary controller environment n)]) =
      gameStateStream T initialBoundary controller environment (n + 1) := by
  rw [accessHistory_transition_reaches T initialBoundary controller
    (environment (gameStateStream T initialBoundary controller environment n))
    (gameStateStream_reachable T initialBoundary controller environment n)]
  rfl

/-- The omega execution generated by finite epoch-game codes. -/
def gameExecution
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T) :
    OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) :=
  fun n =>
    let state := gameStateStream T initialBoundary controller environment n
    let envRound := environment state
    let output := controller state
    {
      inputOne := envRound.inputOne
      inputTwo := envRound.inputTwo
      graph := envRound.graph
      outputOne := output.1
      outputTwo := output.2
    }

@[simp] theorem gameExecution_apply
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (n : Nat) :
    gameExecution T initialBoundary controller environment n =
      let state := gameStateStream T initialBoundary controller environment n
      let envRound := environment state
      let output := controller state
      {
        inputOne := envRound.inputOne
        inputTwo := envRound.inputTwo
        graph := envRound.graph
        outputOne := output.1
        outputTwo := output.2
      } :=
  rfl

/--
The real environment sequence read off from a finite epoch-game play.

At time `n`, the finite game is in `gameStateStream ... n`; the finite
environment code chooses the corresponding environment round for that state.
-/
def environmentSequenceOfGamePlay
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T) :
    EnvironmentSequence In₁ In₂ :=
  fun n => environment (gameStateStream T initialBoundary controller environment n)

@[simp] theorem environmentSequenceOfGamePlay_apply
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (n : Nat) :
    environmentSequenceOfGamePlay T initialBoundary controller environment n =
      environment (gameStateStream T initialBoundary controller environment n) :=
  rfl

/--
Pointwise output agreement sufficient for a finite controller to simulate an
ordinary distributed strategy along one finite-game environment code.
-/
def GameExecutionMatchesStrategyForEnvironment
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) : Prop :=
  ∀ n : Nat,
    let env := environmentSequenceOfGamePlay
      T initialBoundary controller environment
    (controller (gameStateStream T initialBoundary controller environment n)).1 =
        σ.one (nextView Proc.one (executionPrefix σ env n) (env n)) ∧
      (controller (gameStateStream T initialBoundary controller environment n)).2 =
        σ.two (nextView Proc.two (executionPrefix σ env n) (env n))

/--
A finite controller simulates a distributed strategy at the execution-language
boundary when every finite-game environment code produces an omega word that
also appears as a real execution of the distributed strategy.
-/
def GameExecutionControllerSimulatesStrategy
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) : Prop :=
  ∀ environment : EnvironmentCode T,
    ∃ env : EnvironmentSequence In₁ In₂,
      gameExecution T initialBoundary controller environment = execution σ env

theorem gameExecution_eq_execution_of_matchesStrategyForEnvironment
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (hmatch :
      GameExecutionMatchesStrategyForEnvironment
        T initialBoundary controller environment σ) :
    gameExecution T initialBoundary controller environment =
      execution σ
        (environmentSequenceOfGamePlay
          T initialBoundary controller environment) := by
  funext n
  let env := environmentSequenceOfGamePlay T initialBoundary controller environment
  have hmatchN := hmatch n
  rw [execution_apply]
  simp [gameExecution, nextRound, environmentSequenceOfGamePlay,
    hmatchN.1, hmatchN.2]

/--
Controller-level output agreement with a distributed strategy implies the
simulation boundary used by finite-game completeness.
-/
theorem gameExecutionControllerSimulatesStrategy_of_matchesStrategy
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (hmatch :
      ∀ environment : EnvironmentCode T,
        GameExecutionMatchesStrategyForEnvironment
          T initialBoundary controller environment σ) :
    GameExecutionControllerSimulatesStrategy
      T initialBoundary controller σ := by
  intro environment
  exact
    ⟨environmentSequenceOfGamePlay T initialBoundary controller environment,
      gameExecution_eq_execution_of_matchesStrategyForEnvironment
        T initialBoundary controller environment σ (hmatch environment)⟩

/--
Controller-realization boundary for finite-game completeness.

For every distributed strategy, choose a finite controller whose outputs agree
with that strategy along every finite-game environment play.  This is stronger
and more operational than `GameExecutionControllerSimulatesStrategy`, and is
the form usually proved from a concrete finite-state construction of
controllers.
-/
def GameExecutionStrategiesHaveMatchingControllers
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary) : Prop :=
  ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
    ∃ controller : ControllerCode T,
      ∀ environment : EnvironmentCode T,
        GameExecutionMatchesStrategyForEnvironment
          T initialBoundary controller environment σ

/--
The state-only matching-controller boundary forces every strategy's first
process-1 output to be independent of the first environment move.

At time zero the finite game is always at `Sum.inl initialBoundary`; a
state-only controller therefore chooses one fixed process-1 output before the
arbitrary initial input/graph has been reflected in the game state.
-/
theorem gameExecutionStrategiesHaveMatchingControllers_initial_one_output_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (hmatch :
      GameExecutionStrategiesHaveMatchingControllers T initialBoundary)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (envA envB : EnvironmentRound In₁ In₂) :
    σ.one (nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envA) =
      σ.one (nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envB) := by
  rcases hmatch σ with ⟨controller, hcontroller⟩
  let environmentA : EnvironmentCode T := fun _ => envA
  let environmentB : EnvironmentCode T := fun _ => envB
  have hA := (hcontroller environmentA 0).1
  have hB := (hcontroller environmentB 0).1
  have hA' :
      (controller (Sum.inl initialBoundary)).1 =
        σ.one (nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envA) := by
    simpa [environmentA, environmentSequenceOfGamePlay] using hA
  have hB' :
      (controller (Sum.inl initialBoundary)).1 =
        σ.one (nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envB) := by
    simpa [environmentB, environmentSequenceOfGamePlay] using hB
  exact hA'.symm.trans hB'

/-- Process-2 version of `gameExecutionStrategiesHaveMatchingControllers_initial_one_output_eq`. -/
theorem gameExecutionStrategiesHaveMatchingControllers_initial_two_output_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (hmatch :
      GameExecutionStrategiesHaveMatchingControllers T initialBoundary)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (envA envB : EnvironmentRound In₁ In₂) :
    σ.two (nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envA) =
      σ.two (nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envB) := by
  rcases hmatch σ with ⟨controller, hcontroller⟩
  let environmentA : EnvironmentCode T := fun _ => envA
  let environmentB : EnvironmentCode T := fun _ => envB
  have hA := (hcontroller environmentA 0).2
  have hB := (hcontroller environmentB 0).2
  have hA' :
      (controller (Sum.inl initialBoundary)).2 =
        σ.two (nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envA) := by
    simpa [environmentA, environmentSequenceOfGamePlay] using hA
  have hB' :
      (controller (Sum.inl initialBoundary)).2 =
        σ.two (nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envB) := by
    simpa [environmentB, environmentSequenceOfGamePlay] using hB
  exact hA'.symm.trans hB'

/--
If some process-1 strategy distinguishes two possible first-round views, then
the state-only matching-controller boundary is false.
-/
theorem not_gameExecutionStrategiesHaveMatchingControllers_of_initial_one_output_ne
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (envA envB : EnvironmentRound In₁ In₂)
    (hne :
      σ.one (nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envA) ≠
        σ.one (nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envB)) :
    ¬ GameExecutionStrategiesHaveMatchingControllers T initialBoundary := by
  intro hmatch
  exact hne
    (gameExecutionStrategiesHaveMatchingControllers_initial_one_output_eq
      T initialBoundary hmatch σ envA envB)

/--
If some process-2 strategy distinguishes two possible first-round views, then
the state-only matching-controller boundary is false.
-/
theorem not_gameExecutionStrategiesHaveMatchingControllers_of_initial_two_output_ne
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (envA envB : EnvironmentRound In₁ In₂)
    (hne :
      σ.two (nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envA) ≠
        σ.two (nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envB)) :
    ¬ GameExecutionStrategiesHaveMatchingControllers T initialBoundary := by
  intro hmatch
  exact hne
    (gameExecutionStrategiesHaveMatchingControllers_initial_two_output_eq
      T initialBoundary hmatch σ envA envB)

/--
Round-aware finite controllers choose outputs after seeing the current
environment round chosen from the current epoch state.

This is the corrected timing for the completeness side: distributed strategies
may depend on the current input/receive event, so the finite controller needs
the current finite environment move in addition to the epoch state.
-/
abbrev RoundAwareControllerCode
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂) :=
  GameState T -> EnvironmentRound In₁ In₂ -> Out₁ × Out₂

theorem roundAwareControllerCode_fintype
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (T :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, x}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂) :
    Nonempty (Fintype (RoundAwareControllerCode T)) := by
  classical
  rcases gameState_fintype T with ⟨stateFinite⟩
  letI : Fintype (GameState T) := stateFinite
  exact ⟨inferInstance⟩

/--
For a fixed finite environment code, a round-aware controller specializes to an
ordinary state-only controller by applying it to the environment move chosen at
that state.
-/
def roundAwareControllerAtEnvironment
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentCode T) :
    ControllerCode T :=
  fun state => controller state (environment state)

/-- One transition of the round-aware finite epoch game. -/
def roundAwareGameTransition
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : RoundAwareControllerCode T)
    (state : GameState T)
    (environment : EnvironmentRound In₁ In₂) :
    GameState T :=
  match state with
  | Sum.inl boundary =>
      let output := controller state environment
      match environment.graph with
      | .left =>
          Sum.inr (Sum.inl
            (T.update Proc.one (T.init Proc.one boundary)
              environment.inputOne environment.inputTwo output.1 output.2))
      | .right =>
          Sum.inr (Sum.inr
            (T.update Proc.two (T.init Proc.two boundary)
              environment.inputOne environment.inputTwo output.1 output.2))
      | .both =>
          Sum.inl
            (T.close Proc.one (T.init Proc.one boundary) Graph.both
              {
                inputOne := environment.inputOne
                inputTwo := environment.inputTwo
                outputOne := output.1
                outputTwo := output.2
              })
  | Sum.inr (Sum.inl withinOne) =>
      let output := controller state environment
      let withinOne' :=
        T.update Proc.one withinOne
          environment.inputOne environment.inputTwo output.1 output.2
      match environment.graph with
      | .left => Sum.inr (Sum.inl withinOne')
      | graph =>
          Sum.inl
            (T.close Proc.one withinOne graph
              {
                inputOne := environment.inputOne
                inputTwo := environment.inputTwo
                outputOne := output.1
                outputTwo := output.2
              })
  | Sum.inr (Sum.inr withinTwo) =>
      let output := controller state environment
      let withinTwo' :=
        T.update Proc.two withinTwo
          environment.inputOne environment.inputTwo output.1 output.2
      match environment.graph with
      | .right => Sum.inr (Sum.inr withinTwo')
      | graph =>
          Sum.inl
            (T.close Proc.two withinTwo graph
              {
                inputOne := environment.inputOne
                inputTwo := environment.inputTwo
                outputOne := output.1
                outputTwo := output.2
              })

/--
At a boundary state, a synchronizing `.both` round is a stutter for the current
round-aware epoch-game transition.

The boundary state absorbs the synchronizing round as an empty epoch closed by
the `.both` letter, so the boundary access state advances on every round, as
required by the epoch-transformer fold of the paper.
-/
theorem roundAwareGameTransition_initialBoundary_both
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentRound In₁ In₂)
    (hboth : environment.graph = Graph.both) :
    roundAwareGameTransition T controller (Sum.inl initialBoundary) environment =
      Sum.inl
        (T.close Proc.one (T.init Proc.one initialBoundary) Graph.both
          {
            inputOne := environment.inputOne
            inputTwo := environment.inputTwo
            outputOne :=
              (controller (Sum.inl initialBoundary) environment).1
            outputTwo :=
              (controller (Sum.inl initialBoundary) environment).2
          }) := by
  cases environment with
  | mk inputOne inputTwo graph =>
      cases graph <;> simp [roundAwareGameTransition] at hboth ⊢

/--
The no-direct epoch transition is the backend round-aware game transition for
the concrete transformer induced by the uniform one-directional construction.
-/
theorem noDirectEpochStateTransition_eq_roundAwareGameTransition
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller :
      RoundAwareControllerCode uniform.noDirectEpochTransformer)
    (state : GameState uniform.noDirectEpochTransformer)
    (environment : EnvironmentRound In₁ In₂) :
    uniform.noDirectEpochStateTransition state
        {
          inputOne := environment.inputOne
          inputTwo := environment.inputTwo
          graph := environment.graph
          outputOne := (controller state environment).1
          outputTwo := (controller state environment).2
        } =
      roundAwareGameTransition
        uniform.noDirectEpochTransformer controller state environment := by
  cases environment with
  | mk inputOne inputTwo graph =>
  cases state with
  | inl boundary =>
      cases graph <;>
        simp [
          roundAwareGameTransition,
          UniformOneDirectionalFiniteIndexLemma.noDirectEpochStateTransition,
          UniformOneDirectionalFiniteIndexLemma.noDirectEpochTransformer,
          roundRecordClosingLetter
        ]
  | inr side =>
      cases side with
      | inl summaryOne =>
          cases graph <;>
            simp [
              roundAwareGameTransition,
              UniformOneDirectionalFiniteIndexLemma.noDirectEpochStateTransition,
              UniformOneDirectionalFiniteIndexLemma.noDirectEpochTransformer,
              roundRecordClosingLetter
            ]
      | inr summaryTwo =>
          cases graph <;>
            simp [
              roundAwareGameTransition,
              UniformOneDirectionalFiniteIndexLemma.noDirectEpochStateTransition,
              UniformOneDirectionalFiniteIndexLemma.noDirectEpochTransformer,
              roundRecordClosingLetter
            ]

/--
If a round-aware controller agrees with the decoded strategy outputs along the
concrete no-direct stream, that stream follows the backend game transition.
-/
theorem noDirectEpochStateStream_succ_eq_roundAwareGameTransition_of_controller_matches
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (controller :
      RoundAwareControllerCode uniform.noDirectEpochTransformer)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (hmatch :
      ∀ n : Nat,
        controller
            (uniform.noDirectEpochStateStream initialBoundary σ env n)
            (env n) =
          (σ.one (nextView Proc.one (executionPrefix σ env n) (env n)),
            σ.two (nextView Proc.two (executionPrefix σ env n) (env n)))) :
    ∀ n : Nat,
      uniform.noDirectEpochStateStream initialBoundary σ env (n + 1) =
        roundAwareGameTransition uniform.noDirectEpochTransformer controller
          (uniform.noDirectEpochStateStream initialBoundary σ env n)
          (env n) := by
  intro n
  rw [
    UniformOneDirectionalFiniteIndexLemma.noDirectEpochStateStream_succ,
    ← noDirectEpochStateTransition_eq_roundAwareGameTransition
      uniform controller
        (uniform.noDirectEpochStateStream initialBoundary σ env n)
        (env n)
  ]
  have hm := hmatch n
  cases henv : env n with
  | mk inputOne inputTwo graph =>
      simp [henv] at hm
      simp [nextRound, henv, hm]

/-- State stream for the round-aware finite epoch game. -/
def roundAwareGameStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentCode T) :
    Nat -> GameState T
  | 0 => Sum.inl initialBoundary
  | n + 1 =>
      let state := roundAwareGameStateStream T initialBoundary controller environment n
      roundAwareGameTransition T controller state (environment state)

@[simp]
theorem roundAwareGameStateStream_zero
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentCode T) :
    roundAwareGameStateStream T initialBoundary controller environment 0 =
      Sum.inl initialBoundary :=
  rfl

@[simp]
theorem roundAwareGameStateStream_succ
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentCode T)
    (n : Nat) :
    roundAwareGameStateStream T initialBoundary controller environment (n + 1) =
      roundAwareGameTransition T controller
        (roundAwareGameStateStream T initialBoundary controller environment n)
        (environment
          (roundAwareGameStateStream T initialBoundary controller environment n)) :=
  rfl

/--
For a fixed finite environment code, the round-aware state stream is exactly
the ordinary state stream for the specialized state-only controller.
-/
theorem roundAwareGameStateStream_eq_gameStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentCode T)
    (n : Nat) :
    roundAwareGameStateStream T initialBoundary controller environment n =
      gameStateStream T initialBoundary
        (roundAwareControllerAtEnvironment T controller environment)
        environment n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [roundAwareGameStateStream_succ, gameStateStream_succ, ih]
      rfl

/-- The real environment sequence read off from a round-aware finite play. -/
def roundAwareEnvironmentSequenceOfGamePlay
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentCode T) :
    EnvironmentSequence In₁ In₂ :=
  fun n => environment
    (roundAwareGameStateStream T initialBoundary controller environment n)

/-- The omega word generated by round-aware finite epoch-game codes. -/
def roundAwareGameExecution
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentCode T) :
    OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) :=
  fun n =>
    let state := roundAwareGameStateStream T initialBoundary controller environment n
    let envRound := environment state
    let output := controller state envRound
    {
      inputOne := envRound.inputOne
      inputTwo := envRound.inputTwo
      graph := envRound.graph
      outputOne := output.1
      outputTwo := output.2
    }

/--
For a fixed finite environment code, the round-aware execution is the ordinary
finite-game execution of the specialized state-only controller.
-/
theorem roundAwareGameExecution_eq_gameExecution
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentCode T) :
    roundAwareGameExecution T initialBoundary controller environment =
      gameExecution T initialBoundary
        (roundAwareControllerAtEnvironment T controller environment)
        environment := by
  funext n
  simp [roundAwareGameExecution, gameExecution,
    roundAwareGameStateStream_eq_gameStateStream,
    roundAwareControllerAtEnvironment]

/-- Pointwise output agreement for a round-aware finite controller. -/
def RoundAwareGameExecutionMatchesStrategyForEnvironment
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentCode T)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) : Prop :=
  ∀ n : Nat,
    let env := roundAwareEnvironmentSequenceOfGamePlay
      T initialBoundary controller environment
    let state := roundAwareGameStateStream
      T initialBoundary controller environment n
    let envRound := environment state
    (controller state envRound).1 =
        σ.one (nextView Proc.one (executionPrefix σ env n) (env n)) ∧
      (controller state envRound).2 =
        σ.two (nextView Proc.two (executionPrefix σ env n) (env n))

/--
Pointwise round-aware output agreement implies equality between the
round-aware finite-game execution and the real execution of the distributed
strategy.
-/
theorem roundAwareGameExecution_eq_execution_of_matchesStrategyForEnvironment
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentCode T)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (hmatch :
      RoundAwareGameExecutionMatchesStrategyForEnvironment
        T initialBoundary controller environment σ) :
    roundAwareGameExecution T initialBoundary controller environment =
      execution σ
        (roundAwareEnvironmentSequenceOfGamePlay
          T initialBoundary controller environment) := by
  funext n
  let env := roundAwareEnvironmentSequenceOfGamePlay
    T initialBoundary controller environment
  let state := roundAwareGameStateStream
    T initialBoundary controller environment n
  let envRound := environment state
  have hmatchN := hmatch n
  rw [execution_apply]
  simp [roundAwareGameExecution, nextRound,
    roundAwareEnvironmentSequenceOfGamePlay, hmatchN.1, hmatchN.2]

/--
Round-aware state/round decoders are sufficient for pointwise matching of every
distributed strategy.
-/
def RoundAwareGameExecutionStateViewDecodersSimulateStrategies
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two) :
    Prop :=
  ∀ (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (environment : EnvironmentCode T)
    (n : Nat),
      let controller : RoundAwareControllerCode T :=
        fun state envRound =>
          (σ.one (viewOne state envRound),
            σ.two (viewTwo state envRound))
      let env : EnvironmentSequence In₁ In₂ :=
        roundAwareEnvironmentSequenceOfGamePlay
          T initialBoundary controller environment
      let state :=
        roundAwareGameStateStream
          T initialBoundary controller environment n
      let envRound := environment state
      viewOne state envRound =
          nextView Proc.one (executionPrefix σ env n) (env n) ∧
        viewTwo state envRound =
          nextView Proc.two (executionPrefix σ env n) (env n)

/--
A round-aware finite controller is locally observable through the supplied
state/round view decoders when each process output depends only on that
process's decoded local view.

This is the finite-controller restriction missing from the raw
`RoundAwareControllerCode` interface: the full environment round may contain
information hidden from one process, so sound finite controllers must respect
the decoded local-view equivalence.
-/
def RoundAwareControllerLocallyObservable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareControllerCode T) : Prop :=
  (∀ stateA envA stateB envB,
    viewOne stateA envA = viewOne stateB envB ->
      (controller stateA envA).1 = (controller stateB envB).1) ∧
  (∀ stateA envA stateB envB,
    viewTwo stateA envA = viewTwo stateB envB ->
      (controller stateA envA).2 = (controller stateB envB).2)

/--
The locally observable round-aware controller carrier for fixed view decoders.
-/
abbrev RoundAwareLocalControllerCode
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two) :=
  { controller : RoundAwareControllerCode T //
      RoundAwareControllerLocallyObservable T viewOne viewTwo controller }

theorem roundAwareLocalControllerCode_fintype
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (T :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, x}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two) :
    Nonempty (Fintype (RoundAwareLocalControllerCode T viewOne viewTwo)) := by
  classical
  rcases roundAwareControllerCode_fintype T with ⟨controllerFinite⟩
  letI : Fintype (RoundAwareControllerCode T) := controllerFinite
  exact ⟨inferInstance⟩

/--
The controller obtained by evaluating a distributed strategy on the decoded
views is locally observable by construction.
-/
theorem roundAwareControllerLocallyObservable_of_strategy
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) :
    RoundAwareControllerLocallyObservable T viewOne viewTwo
      (fun state envRound =>
        (σ.one (viewOne state envRound),
          σ.two (viewTwo state envRound))) := by
  constructor
  · intro stateA envA stateB envB hview
    simp [hview]
  · intro stateA envA stateB envB hview
    simp [hview]

/--
Round-aware controller obtained from finite contingent local actions.

This is the Lean version of the journal-paper lambda trick at the controller
boundary: each process observes a finite history summary and chooses a finite
function of the current fringe value; the current concrete fringe selects the
branch applied in this round.
-/
def roundAwareControllerOfContingentStrategy
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (strategy :
      ContingentStrategyPair H₁ H₂ R₁ R₂ Out₁ Out₂) :
    RoundAwareControllerCode T :=
  fun state envRound =>
    (strategy.one (historyOne state envRound) (fringeOne state envRound),
      strategy.two (historyTwo state envRound) (fringeTwo state envRound))

/--
Finite-lambda local observability.

The finite local history summary chooses the lambda table; the current
one-round fringe value is only the argument at which that table is evaluated.
Thus two indistinguishable finite summaries must induce the same output at
equal fringe arguments, without requiring a finite state to decode the whole
recursive local `View`.
-/
def RoundAwareControllerLocallyObservableByFiniteLambda
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller : RoundAwareControllerCode T) : Prop :=
  (∀ stateA envA stateB envB,
    historyOne stateA envA = historyOne stateB envB ->
    fringeOne stateA envA = fringeOne stateB envB ->
      (controller stateA envA).1 = (controller stateB envB).1) ∧
  (∀ stateA envA stateB envB,
    historyTwo stateA envA = historyTwo stateB envB ->
    fringeTwo stateA envA = fringeTwo stateB envB ->
      (controller stateA envA).2 = (controller stateB envB).2)

/--
Round-aware controllers whose outputs respect finite lambda
indistinguishability.
-/
abbrev RoundAwareLambdaControllerCode
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂) :=
  { controller : RoundAwareControllerCode T //
      RoundAwareControllerLocallyObservableByFiniteLambda
        T historyOne historyTwo fringeOne fringeTwo controller }

theorem roundAwareLambdaControllerCode_fintype
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (T :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂) :
    Nonempty
      (Fintype
        (RoundAwareLambdaControllerCode
          T historyOne historyTwo fringeOne fringeTwo)) := by
  classical
  rcases roundAwareControllerCode_fintype T with ⟨controllerFinite⟩
  letI : Fintype (RoundAwareControllerCode T) := controllerFinite
  exact ⟨inferInstance⟩

/--
The contingent/lambda controller is finite-lambda locally observable by
construction.
-/
theorem roundAwareControllerLocallyObservableByFiniteLambda_of_contingentStrategy
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (strategy :
      ContingentStrategyPair H₁ H₂ R₁ R₂ Out₁ Out₂) :
    RoundAwareControllerLocallyObservableByFiniteLambda
      T historyOne historyTwo fringeOne fringeTwo
      (roundAwareControllerOfContingentStrategy
        T historyOne historyTwo fringeOne fringeTwo strategy) := by
  constructor
  · intro stateA envA stateB envB hhistory hfringe
    simp [roundAwareControllerOfContingentStrategy, hhistory, hfringe]
  · intro stateA envA stateB envB hhistory hfringe
    simp [roundAwareControllerOfContingentStrategy, hhistory, hfringe]

/--
Pack a contingent/lambda strategy directly into the finite-lambda local
controller carrier.  This is the finite no-direct interface used by the
journal-paper lambda intuition: equality of finite local summaries means the
same lambda table is chosen.
-/
def roundAwareLambdaControllerOfContingentStrategy
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (strategy :
      ContingentStrategyPair H₁ H₂ R₁ R₂ Out₁ Out₂) :
    RoundAwareLambdaControllerCode
      T historyOne historyTwo fringeOne fringeTwo :=
  ⟨roundAwareControllerOfContingentStrategy
      T historyOne historyTwo fringeOne fringeTwo strategy,
    roundAwareControllerLocallyObservableByFiniteLambda_of_contingentStrategy
      T historyOne historyTwo fringeOne fringeTwo strategy⟩

@[simp]
theorem roundAwareLambdaControllerOfContingentStrategy_apply
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (strategy :
      ContingentStrategyPair H₁ H₂ R₁ R₂ Out₁ Out₂)
    (state : GameState T)
    (envRound : EnvironmentRound In₁ In₂) :
    (roundAwareLambdaControllerOfContingentStrategy
        T historyOne historyTwo fringeOne fringeTwo strategy).1
        state envRound =
      (strategy.one (historyOne state envRound) (fringeOne state envRound),
        strategy.two (historyTwo state envRound) (fringeTwo state envRound)) := by
  rfl

theorem roundAwareLambdaController_one_eq_of_local_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    {stateA stateB : GameState T}
    {envA envB : EnvironmentRound In₁ In₂}
    (hhistory :
      historyOne stateA envA = historyOne stateB envB)
    (hfringe :
      fringeOne stateA envA = fringeOne stateB envB) :
    (controller.1 stateA envA).1 = (controller.1 stateB envB).1 :=
  controller.2.1 stateA envA stateB envB hhistory hfringe

theorem roundAwareLambdaController_two_eq_of_local_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    {stateA stateB : GameState T}
    {envA envB : EnvironmentRound In₁ In₂}
    (hhistory :
      historyTwo stateA envA = historyTwo stateB envB)
    (hfringe :
      fringeTwo stateA envA = fringeTwo stateB envB) :
    (controller.1 stateA envA).2 = (controller.1 stateB envB).2 :=
  controller.2.2 stateA envA stateB envB hhistory hfringe

/--
Finite-lambda controllers specialize to the older full-view-local carrier
whenever equality of decoded full views implies equality of the finite local
summary and the current fringe argument.
-/
def roundAwareLocalControllerOfLambdaController
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (decodeOne :
      ∀ stateA envA stateB envB,
        viewOne stateA envA = viewOne stateB envB ->
          historyOne stateA envA = historyOne stateB envB ∧
            fringeOne stateA envA = fringeOne stateB envB)
    (decodeTwo :
      ∀ stateA envA stateB envB,
        viewTwo stateA envA = viewTwo stateB envB ->
          historyTwo stateA envA = historyTwo stateB envB ∧
            fringeTwo stateA envA = fringeTwo stateB envB) :
    RoundAwareLocalControllerCode T viewOne viewTwo :=
  ⟨controller.1,
    by
      constructor
      · intro stateA envA stateB envB hview
        rcases decodeOne stateA envA stateB envB hview with
          ⟨hhistory, hfringe⟩
        exact controller.2.1 stateA envA stateB envB hhistory hfringe
      · intro stateA envA stateB envB hview
        rcases decodeTwo stateA envA stateB envB hview with
          ⟨hhistory, hfringe⟩
        exact controller.2.2 stateA envA stateB envB hhistory hfringe⟩

@[simp]
theorem roundAwareLocalControllerOfLambdaController_apply
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
