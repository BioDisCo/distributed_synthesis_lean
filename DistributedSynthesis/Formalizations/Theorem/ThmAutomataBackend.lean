/--
Rejected finite-carrier progress streams contain recurrent return indices after
the no-lower-priority cutoff.
-/
theorem exists_recurrent_return_finiteCarrierState_min_priority_not_even_and_eventually_ge_of_not_accepts_of_dpaProgress
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (stateStream : Nat -> Q)
    (moveStream : Nat -> Move)
    (dpaOf : Q -> A.State)
    [Fintype Q]
    (hdpaInit : dpaOf (stateStream 0) = A.initial)
    (hdpaStep :
      ∀ n : Nat,
        dpaOf (stateStream (n + 1)) =
          A.step (dpaOf (stateStream n))
            (finiteCarrierWord emit stateStream moveStream n))
    (hreject :
      ¬ A.Accepts (finiteCarrierWord emit stateStream moveStream)) :
    ∃ p : Nat,
      ∃ recurrentState : Q,
        ∃ start : Nat,
          ∃ stop : Nat,
            start < stop ∧
              A.priority (dpaOf recurrentState) = p ∧
                stateStream start = recurrentState ∧
                  stateStream stop = recurrentState ∧
                    (∀ k : Nat,
                      start ≤ k ->
                        p ≤ A.priority (dpaOf (stateStream k))) ∧
                      ¬ DetParityAutomaton.NatEven p := by
  rcases
      exists_recurrent_finiteCarrierState_min_priority_not_even_and_eventually_ge_of_not_accepts_of_dpaProgress
        emit A stateStream moveStream dpaOf hdpaInit hdpaStep hreject with
    ⟨p, recurrentState, cutoff, hrecurrentPriority, hrecurrentSeen,
      hpriorityFromCutoff, hpOdd⟩
  rcases hrecurrentSeen cutoff with
    ⟨start, hcutoffStart, hstartState⟩
  rcases hrecurrentSeen (start + 1) with
    ⟨stop, hstartStop, hstopState⟩
  refine
    ⟨p, recurrentState, start, stop, ?_, hrecurrentPriority,
      hstartState, hstopState, ?_, hpOdd⟩
  · omega
  · intro k hk
    exact hpriorityFromCutoff k (by omega)

/--
Generic finite-carrier lasso reflection.

If an ultimately periodic labelled path through an arbitrary finite carrier has
an odd DPA-priority witness on its cycle and no smaller cycle priority, then the
memoryless carrier code induced by the selected labels generates a rejected
omega word.
-/
theorem exists_finiteCarrierCode_rejected_playWord_of_consistent_looping_stateStream_of_dpaRun_cycleWitness_lowerBound
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    [Fintype Q]
    (initial : Q)
    (step : Q -> Move -> Q)
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (stateStream : Nat -> Q)
    (moveStream : Nat -> Move)
    (dpaOf : Q -> A.State)
    (hdpaRun :
      ∀ n : Nat,
        dpaOf (stateStream n) =
          A.run (finiteCarrierWord emit stateStream moveStream) n)
    (hinit : stateStream 0 = initial)
    (hstep :
      ∀ n : Nat,
        stateStream (n + 1) = step (stateStream n) (moveStream n))
    (hconsistent :
      ∀ i j : Nat, stateStream i = stateStream j -> moveStream i = moveStream j)
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (hstateShift :
      ∀ m : Nat,
        stateStream (start + period + m) = stateStream (start + m))
    (hmoveShift :
      ∀ m : Nat,
        moveStream (start + period + m) = moveStream (start + m))
    (witness : Nat)
    (hwitnessLt : witness < period)
    {p : Nat}
    (hwitnessPriority :
      A.priority (dpaOf (stateStream (start + witness))) = p)
    (hcycleLower :
      ∀ i : Nat,
        i < period ->
          p ≤ A.priority (dpaOf (stateStream (start + i))))
    (hpOdd : ¬ DetParityAutomaton.NatEven p) :
    ∃ code : Q -> Move,
      ¬ A.Accepts (finiteCarrierPlayWord initial step emit code) := by
  let word := finiteCarrierWord emit stateStream moveStream
  have hwordShift :
      ∀ m : Nat, word (start + period + m) = word (start + m) := by
    intro m
    simpa [word] using
      finiteCarrierWord_loop_shift
        emit stateStream moveStream start period
        hstateShift hmoveShift m
  have hrunLoop :
      A.run word (start + period) = A.run word start := by
    calc
      A.run word (start + period)
          = dpaOf (stateStream (start + period)) := by
            exact (hdpaRun (start + period)).symm
      _ = dpaOf (stateStream start) := by
            exact congrArg dpaOf (by simpa using hstateShift 0)
      _ = A.run word start := by
            exact hdpaRun start
  have hperiodic :
      ∀ i n : Nat,
        i < period ->
          A.priority (A.run word (start + i + n * period)) =
            A.priority (A.run word (start + i)) :=
    A.priority_periodic_of_run_loop word start period
      hrunLoop hwordShift
  have hcover :
      ∀ k : Nat,
        start ≤ k ->
          ∃ i : Nat,
            i < period ∧
              A.priority (A.run word k) =
                A.priority (A.run word (start + i)) := by
    intro k hk
    let d := k - start
    let i := d % period
    let n := d / period
    refine ⟨i, Nat.mod_lt d hperiodPositive, ?_⟩
    have hdecomp : d = i + n * period := by
      simpa [i, n, Nat.mul_comm] using
        (Nat.mod_add_div d period).symm
    have hk_eq : k = start + i + n * period := by
      have hkstart : k = start + d := by omega
      omega
    rw [hk_eq]
    exact hperiodic i n (Nat.mod_lt d hperiodPositive)
  have hodd :
      ¬ DetParityAutomaton.NatEven
        (((Finset.range period).image
          (fun i : Nat =>
            A.priority (A.run word (start + i)))).min'
          (Finset.image_nonempty.mpr
            (Finset.nonempty_range_iff.mpr (Nat.ne_of_gt hperiodPositive)))) := by
    exact
      DetParityAutomaton.not_natEven_cycle_priority_min_of_witness_priority_le_all
        period
        (fun i : Nat => A.priority (A.run word (start + i)))
        hperiodPositive witness hwitnessLt
        (by
          change A.priority (A.run word (start + witness)) = p
          rw [← hdpaRun (start + witness)]
          exact hwitnessPriority)
        (by
          intro i hi
          change p ≤ A.priority (A.run word (start + i))
          rw [← hdpaRun (start + i)]
          exact hcycleLower i hi)
        hpOdd
  let code := finiteCarrierCodeOfStateStream stateStream moveStream
  refine ⟨code, ?_⟩
  have hplay :
      finiteCarrierPlayWord initial step emit code = word := by
    simpa [code, word] using
      finiteCarrierPlayWord_codeOfStateStream_eq
        initial step emit stateStream moveStream hinit hstep hconsistent
  intro hacc
  have haccStream : A.Accepts word := by
    simpa [hplay] using hacc
  have hcriterion :
      A.Accepts word ↔
        DetParityAutomaton.NatEven
          (((Finset.range period).image
            (fun i : Nat =>
              A.priority (A.run word (start + i)))).min'
            (Finset.image_nonempty.mpr
              (Finset.nonempty_range_iff.mpr
                (Nat.ne_of_gt hperiodPositive)))) := by
    exact
      A.acceptsFrom_iff_eventual_periodic_cycle_priority_min_even
        A.initial word start period hperiodPositive hcover hperiodic
  exact hodd (hcriterion.mp haccStream)

/--
Initial/step DPA-progress form of the generic finite-carrier lasso reflection.
-/
theorem exists_finiteCarrierCode_rejected_playWord_of_consistent_looping_stateStream_of_dpaProgress_cycleWitness_lowerBound
    {Q : Type x}
    {Move : Type y}
