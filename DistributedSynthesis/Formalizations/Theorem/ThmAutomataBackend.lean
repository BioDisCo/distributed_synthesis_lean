        A cert.toLanguageCertificate)
    (gameCompiler :
      DPATrackingFiniteGameCompiler.{u, v, w, a, y, x}
        In₁ In₂ Out₁ Out₂) :
    EffectiveParitySpecification.{u, v, w, a, y, max u v w a} In₁ In₂ Out₁ Out₂ :=
  (det.toRunCompilation).toEffectiveParitySpecificationFromTrackingCompiler
    gameCompiler

/-- DPA synthesis is decidable once its finite dynamic-hierarchy game has been compiled. -/
noncomputable def dpa_synthesis_problem_decidable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (compilation : DPAToFiniteGameCompilation.{u, v, w, a, b} Out₂ A) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  effective_parity_synthesis_problem_decidable
    compilation.toEffectiveParitySpecification

/--
The prefix-state-tracked DPA specification is decidable from the same finite
game compilation, since it is equivalent to the ordinary DPA objective.
-/
noncomputable def dpa_prefix_synthesis_problem_decidable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (compilation : DPAToFiniteGameCompilation.{u, v, w, a, b} Out₂ A)
    (n : Nat) :
    Decidable (SynthesisProblem (dpaSpecificationAfterPrefix A n)) :=
  effective_parity_synthesis_problem_decidable
    (compilation.toEffectiveParitySpecificationAfterPrefix n)

/--
DPA synthesis is decidable from a tracking-style finite-game compilation.
-/
noncomputable def dpa_tracking_synthesis_problem_decidable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (compilation :
      DPATrackingFiniteGameCompilation.{u, v, w, a, b} Out₂ A) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  dpa_synthesis_problem_decidable
    compilation.toDPAToFiniteGameCompilation

/--
APA run-tree synthesis is decidable once the APA has been determinized in
run-semantics form and the resulting DPA has been compiled to a finite game.
-/
noncomputable def apa_run_synthesis_problem_decidable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : AlternatingParityAutomaton.{max u v w a, b}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (det : APARunToDPACompilation.{max u v w a, b, x} A)
    (gameCompilation :
      DPAToFiniteGameCompilation.{u, v, w, a, y} Out₂ det.dpa) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          A.Accepts word)) :=
  effective_parity_synthesis_problem_decidable
    (det.toEffectiveParitySpecification gameCompilation)

/--
APA run-tree synthesis is decidable from a run-semantics determinization and a
tracking-style finite-game compilation of the resulting DPA.
-/
noncomputable def apa_run_tracking_synthesis_problem_decidable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : AlternatingParityAutomaton.{max u v w a, b}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (det : APARunToDPACompilation.{max u v w a, b, x} A)
    (gameCompilation :
      DPATrackingFiniteGameCompilation.{u, v, w, a, y} Out₂ det.dpa) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          A.Accepts word)) :=
  effective_parity_synthesis_problem_decidable
    (det.toEffectiveParitySpecificationFromTracking gameCompilation)

/--
APA run-tree synthesis is decidable from the state-wise determinization route,
provided the run-language certificate identifies state languages with
run-tree acceptance from each state.
-/
noncomputable def apa_statewise_run_synthesis_problem_decidable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : AlternatingParityAutomaton.{max u v w a, b}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {cert : A.RunLanguageCertificate}
    (det :
      APAToDPAStateCompilation.{max u v w a, b, x}
        A cert.toLanguageCertificate)
    (gameCompilation :
      DPAToFiniteGameCompilation.{u, v, w, a, y} Out₂ det.dpa) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          A.Accepts word)) :=
  apa_run_synthesis_problem_decidable det.toRunCompilation gameCompilation

/--
APA run-tree synthesis is decidable from the state-wise determinization route
and a tracking-style finite-game compilation of the resulting DPA.
-/
noncomputable def apa_statewise_run_tracking_synthesis_problem_decidable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : AlternatingParityAutomaton.{max u v w a, b}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {cert : A.RunLanguageCertificate}
    (det :
      APAToDPAStateCompilation.{max u v w a, b, x}
        A cert.toLanguageCertificate)
    (gameCompilation :
      DPATrackingFiniteGameCompilation.{u, v, w, a, y} Out₂ det.dpa) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          A.Accepts word)) :=
  apa_run_tracking_synthesis_problem_decidable det.toRunCompilation gameCompilation

end DistributedSynthesis
