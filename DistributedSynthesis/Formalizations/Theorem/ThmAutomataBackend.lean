Paper-facing alias for the lambda replay bridge.
-/
theorem roundAwareLambdaController_rejectedCompatibleWordsRepresentable_of_lambdaChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hlambda :
      ∀ (env : EnvironmentSequence In₁ In₂)
        (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          RoundAwareLambdaControllerCompatibleExecution
            T historyOne historyTwo fringeOne fringeTwo controller
            historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
            σ env word ->
          ¬ A.Accepts word ->
            ∃ stateStream : Nat -> GameState T,
              RoundAwareLambdaControllerCompatibleExecutionLambdaChoices
                T initialBoundary
                historyOne historyTwo fringeOne fringeTwo controller
                historyOfViewOne historyOfViewTwo
                fringeOfViewOne fringeOfViewTwo
                σ env word stateStream) :
    ∀ (env : EnvironmentSequence In₁ In₂)
      (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
        RoundAwareLambdaControllerCompatibleExecution
          T historyOne historyTwo fringeOne fringeTwo controller
          historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
          σ env word ->
        ¬ A.Accepts word ->
          ∃ environment : EnvironmentCode T,
            roundAwareGameExecution T initialBoundary controller.1
              environment =
              word :=
  roundAwareLambdaController_rejectedCompatibleWordsRepresentable_of_synchronizedStateChoices
    T initialBoundary
    historyOne historyTwo fringeOne fringeTwo controller
    historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
    σ A hlambda

end FiniteEpochTransformer

/--
A semantic certificate that the finite epoch game induced by a transformer is
the finite strategy abstraction for a DPA objective.

This record is intentionally not a new theorem hiding the hard paper argument:
the two fields `sound` and `complete` are exactly the continuation/execution
invariant obligations of the epoch construction.  The definitions of the finite
controller/environment spaces, transition system, omega execution, and winning
predicate are fixed by `FiniteEpochTransformer.game*`; this certificate only
supplies the semantic bridge to real executions.
-/
structure EpochGameAbstractionCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  transformer :
    FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂
  initialBoundary : transformer.boundary
  winsDecidable :
    ∀ controller : transformer.ControllerCode,
      ∀ environment : transformer.EnvironmentCode,
        Decidable (transformer.gameWins initialBoundary controller environment)
  controllerStrategy :
    transformer.ControllerCode -> StrategyPair In₁ In₂ Out₁ Out₂
  dynamicHierarchy : Prop
  parityObjective : Prop
  dynamicHierarchy_proof : dynamicHierarchy
  parityObjective_proof : parityObjective
  sound :
    ∀ controller,
      (∀ environment : transformer.EnvironmentCode,
        transformer.gameWins initialBoundary controller environment) ->
        ∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution (controllerStrategy controller) env)
  complete :
    ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      (∀ env : EnvironmentSequence In₁ In₂, A.Accepts (execution σ env)) ->
        ∃ controller : transformer.ControllerCode,
          ∀ environment : transformer.EnvironmentCode,
            transformer.gameWins initialBoundary controller environment

namespace EpochGameAbstractionCertificate

/--
Build an epoch-game abstraction certificate from the genuine semantic bridge
obligations, filling the fixed-play game-outcome decidability automatically
from the finite combined epoch/DPA state loop.
-/
noncomputable def ofTransformer
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (transformer :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : transformer.boundary)
    (controllerStrategy :
      transformer.ControllerCode -> StrategyPair In₁ In₂ Out₁ Out₂)
    (dynamicHierarchy parityObjective : Prop)
    (dynamicHierarchy_proof : dynamicHierarchy)
    (parityObjective_proof : parityObjective)
    (sound :
      ∀ controller,
        (∀ environment : transformer.EnvironmentCode,
          transformer.gameWins initialBoundary controller environment) ->
          ∀ env : EnvironmentSequence In₁ In₂,
            A.Accepts (execution (controllerStrategy controller) env))
    (complete :
      ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        (∀ env : EnvironmentSequence In₁ In₂, A.Accepts (execution σ env)) ->
          ∃ controller : transformer.ControllerCode,
            ∀ environment : transformer.EnvironmentCode,
              transformer.gameWins initialBoundary controller environment) :
    EpochGameAbstractionCertificate.{u, v, w, a} A where
  transformer := transformer
  initialBoundary := initialBoundary
  winsDecidable :=
    fun controller environment =>
      transformer.gameWinsDecidableByStateLoop
        initialBoundary controller environment
  controllerStrategy := controllerStrategy
  dynamicHierarchy := dynamicHierarchy
  parityObjective := parityObjective
  dynamicHierarchy_proof := dynamicHierarchy_proof
  parityObjective_proof := parityObjective_proof
  sound := sound
  complete := complete

/--
Build the epoch-game abstraction certificate from the two semantic boundary
lemmas isolated for the journal/rational-run proof:

* finite-game winning implies compatible decoded-controller soundness;
* every real winning distributed strategy has an accepted finite-game
  controller representative.
-/
noncomputable def ofTransformerWithDecodedBoundaries
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (transformer :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (FiniteEpochTransformer.GameState transformer)]
    (initialBoundary : transformer.boundary)
    (hautomaton :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        transformer.automaton.Accepts word ↔ A.Accepts word)
    (dynamicHierarchy parityObjective : Prop)
    (dynamicHierarchy_proof : dynamicHierarchy)
    (parityObjective_proof : parityObjective)
    (soundBoundary :
      ∀ controller : transformer.ControllerCode,
        (∀ environment : transformer.EnvironmentCode,
          transformer.gameWins initialBoundary controller environment) ->
          FiniteEpochTransformer.CompatibleDecodedControllerSound
            transformer initialBoundary controller A)
    (completeBoundary :
      FiniteEpochTransformer.GameExecutionControllerComplete
        transformer initialBoundary A) :
    EpochGameAbstractionCertificate.{u, v, w, a} A :=
  ofTransformer A transformer initialBoundary
    (FiniteEpochTransformer.controllerStrategyOf transformer initialBoundary)
    dynamicHierarchy parityObjective
    dynamicHierarchy_proof parityObjective_proof
    (fun controller =>
      FiniteEpochTransformer.controllerStrategyOf_sound_of_gameWins_compatibleDecodedControllerSound
        transformer initialBoundary controller A (soundBoundary controller))
    (FiniteEpochTransformer.complete_of_gameExecutionControllerComplete
      transformer initialBoundary A hautomaton completeBoundary)

/--
Variant of `ofTransformerWithDecodedBoundaries` where completeness is supplied
