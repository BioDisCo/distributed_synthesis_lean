theorem noDirect_rejectedPrefixTracking_of_historyPrefixSummaries
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
