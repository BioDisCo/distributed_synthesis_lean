    (cert :
      RoundAwareLocalRotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y} A)
    (d : Proc) :
    RationalAcceptedBy (cert.target d) := by
  exact rational_run (cert.target d) (cert.targetNonempty d)

