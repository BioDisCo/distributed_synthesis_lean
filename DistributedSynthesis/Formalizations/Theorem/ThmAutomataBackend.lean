-/
theorem exists_environmentCode_rejected_roundAwareGameExecution_of_consistent_periodic_stateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
