/-
Generic finite-carrier producer.

The raw `GameState T` theorem above is not the final Bérard boundary, because
raw no-direct states can stutter at the initial `.both` boundary.  The following
carrier-`Q` theorem is the non-stuttering replacement: any rejected coherent
finite-carrier stream whose DPA decoder advances on every emitted letter yields
a rejected memoryless `Q -> Move` code.
-/

/--
Pure loop-erasure output for one recurrent return in an arbitrary finite
carrier.

The witness retains original source edges: each selected bounded index stores a
source edge time, the selected source state/move are copied from that edge, and
the selected successor is the source edge target.
-/
structure FiniteCarrierLoopErasedRecurrentReturnLassoWitness
    {Q : Type x}
    {Move : Type y}
    (sourceState : Nat -> Q)
    (sourceMove : Nat -> Move)
    (recurrentState : Q)
    (returnStart returnStop : Nat) where
  stateAt : Nat -> Q
  moveAt : Nat -> Move
  edgeTime : Nat -> Nat
  start : Nat
  period : Nat
  witness : Nat
  periodPositive : 0 < period
  selectedInit : stateAt 0 = sourceState 0
  selectedSource :
    ∀ k : Nat,
      k < start + period ->
        stateAt k = sourceState (edgeTime k)
  selectedMove :
    ∀ k : Nat,
      k < start + period ->
        moveAt k = sourceMove (edgeTime k)
  selectedTarget :
    ∀ k : Nat,
      k < start + period ->
        stateAt (selectedLassoNextIndex start period k) =
          sourceState (edgeTime k + 1)
  prefixSimple :
    ∀ i j : Nat,
      i < start ->
      j < start ->
      stateAt i = stateAt j ->
      i = j
  cycleSimple :
    ∀ i j : Nat,
      i < period ->
      j < period ->
      stateAt (start + i) = stateAt (start + j) ->
      i = j
  prefixCycleDisjoint :
    ∀ i j : Nat,
      i < start ->
      j < period ->
      stateAt i ≠ stateAt (start + j)
  witnessLt : witness < period
  witnessState :
    sourceState (edgeTime (start + witness)) = recurrentState
  cycleEdgeAfterReturnStart :
    ∀ i : Nat,
      i < period ->
        returnStart ≤ edgeTime (start + i)
  cycleEdgeBeforeReturnStop :
    ∀ i : Nat,
      i < period ->
        edgeTime (start + i) + 1 ≤ returnStop

/-- Selected source-edge times build a generic pure loop-erasure witness. -/
theorem exists_finiteCarrierLoopErasedRecurrentReturnLassoWitness_of_selectedEdgeTimes
    {Q : Type x}
    {Move : Type y}
    (sourceState : Nat -> Q)
    (sourceMove : Nat -> Move)
    (recurrentState : Q)
    {returnStart returnStop : Nat}
    (edgeTime : Nat -> Nat)
    (start period witness : Nat)
    (hperiodPositive : 0 < period)
    (hselectedInit : sourceState (edgeTime 0) = sourceState 0)
    (hselectedTarget :
      ∀ k : Nat,
        k < start + period ->
          sourceState (edgeTime (selectedLassoNextIndex start period k)) =
            sourceState (edgeTime k + 1))
    (hprefixSimple :
      ∀ i j : Nat,
        i < start ->
        j < start ->
        sourceState (edgeTime i) = sourceState (edgeTime j) ->
          i = j)
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        sourceState (edgeTime (start + i)) =
          sourceState (edgeTime (start + j)) ->
          i = j)
    (hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < start ->
        j < period ->
          sourceState (edgeTime i) ≠
            sourceState (edgeTime (start + j)))
    (hwitnessLt : witness < period)
    (hwitnessState :
      sourceState (edgeTime (start + witness)) = recurrentState)
    (hcycleEdgeAfterReturnStart :
      ∀ i : Nat,
        i < period ->
          returnStart ≤ edgeTime (start + i))
    (hcycleEdgeBeforeReturnStop :
      ∀ i : Nat,
        i < period ->
          edgeTime (start + i) + 1 ≤ returnStop) :
    Nonempty
      (FiniteCarrierLoopErasedRecurrentReturnLassoWitness
        sourceState sourceMove recurrentState returnStart returnStop) := by
  refine
    ⟨{
      stateAt := fun n => sourceState (edgeTime n)
      moveAt := fun n => sourceMove (edgeTime n)
      edgeTime := edgeTime
      start := start
      period := period
      witness := witness
      periodPositive := hperiodPositive
      selectedInit := hselectedInit
      selectedSource := ?_
      selectedMove := ?_
      selectedTarget := hselectedTarget
      prefixSimple := hprefixSimple
      cycleSimple := hcycleSimple
      prefixCycleDisjoint := hprefixCycleDisjoint
      witnessLt := hwitnessLt
      witnessState := hwitnessState
      cycleEdgeAfterReturnStart := hcycleEdgeAfterReturnStart
      cycleEdgeBeforeReturnStop := hcycleEdgeBeforeReturnStop
    }⟩
  · intro k _hk
    rfl
  · intro k _hk
    rfl

/--
Assemble a generic retained prefix and rotated simple retained cycle into the
pure finite-carrier recurrent-return witness.
-/
theorem exists_finiteCarrierLoopErasedRecurrentReturnLassoWitness_of_simple_prefix_and_rotated_simple_retainedCycle
    {Q : Type x}
    {Move : Type y}
    (sourceState : Nat -> Q)
    (sourceMove : Nat -> Move)
    (recurrentState : Q)
    {returnStart returnStop : Nat}
    (prefixEdgeTime cycleEdgeTime : Nat -> Nat)
    (start period witness : Nat)
    (hperiodPositive : 0 < period)
    (hselectedInit :
      sourceState
          (prefixCycleLassoEdgeTime prefixEdgeTime cycleEdgeTime start 0) =
        sourceState 0)
    (hprefixTarget :
      ∀ k : Nat,
        k < start ->
          sourceState
              (prefixCycleLassoEdgeTime prefixEdgeTime cycleEdgeTime start
                (k + 1)) =
            sourceState (prefixEdgeTime k + 1))
    (hcycleTarget :
      ∀ i : Nat,
        i < period ->
          sourceState (cycleEdgeTime (selectedLassoNextIndex 0 period i)) =
            sourceState (cycleEdgeTime i + 1))
    (hprefixSimple :
      ∀ i j : Nat,
        i < start ->
        j < start ->
        sourceState (prefixEdgeTime i) = sourceState (prefixEdgeTime j) ->
          i = j)
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        sourceState (cycleEdgeTime i) = sourceState (cycleEdgeTime j) ->
          i = j)
    (hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < start ->
        j < period ->
          sourceState (prefixEdgeTime i) ≠ sourceState (cycleEdgeTime j))
    (hwitnessLt : witness < period)
    (hwitnessState :
      sourceState (cycleEdgeTime witness) = recurrentState)
    (hcycleEdgeAfterReturnStart :
      ∀ i : Nat,
        i < period ->
          returnStart ≤ cycleEdgeTime i)
    (hcycleEdgeBeforeReturnStop :
      ∀ i : Nat,
        i < period ->
          cycleEdgeTime i + 1 ≤ returnStop) :
    Nonempty
      (FiniteCarrierLoopErasedRecurrentReturnLassoWitness
        sourceState sourceMove recurrentState returnStart returnStop) := by
  let edgeTime := prefixCycleLassoEdgeTime prefixEdgeTime cycleEdgeTime start
  refine
    exists_finiteCarrierLoopErasedRecurrentReturnLassoWitness_of_selectedEdgeTimes
      sourceState sourceMove recurrentState edgeTime start period witness
      hperiodPositive ?_ ?_ ?_ ?_ ?_ hwitnessLt ?_ ?_ ?_
  · exact hselectedInit
  · intro k hk
    by_cases hkPrefix : k < start
    · have hnext :
          selectedLassoNextIndex start period k = k + 1 := by
        simp [selectedLassoNextIndex, hkPrefix]
      rw [hnext]
      dsimp [edgeTime]
      simpa [prefixCycleLassoEdgeTime, hkPrefix] using
        hprefixTarget k hkPrefix
    · let i := k - start
      have hi : i < period := by
        dsimp [i]
        omega
      have hkEq : k = start + i := by
        dsimp [i]
        omega
      have hnext :
          selectedLassoNextIndex start period k =
            start + selectedLassoNextIndex 0 period i := by
        rw [hkEq]
        simp [selectedLassoNextIndex]
      dsimp [edgeTime]
      rw [hnext]
      simpa [prefixCycleLassoEdgeTime, hkPrefix, i] using hcycleTarget i hi
  · intro i j hi hj hstate
    apply hprefixSimple i j hi hj
    simpa [edgeTime, prefixCycleLassoEdgeTime, hi, hj] using hstate
  · intro i j hi hj hstate
    apply hcycleSimple i j hi hj
    simpa [edgeTime, prefixCycleLassoEdgeTime] using hstate
  · intro i j hi hj hstate
    exact
      hprefixCycleDisjoint i j hi hj
        (by simpa [edgeTime, prefixCycleLassoEdgeTime, hi] using hstate)
  · simpa [edgeTime, prefixCycleLassoEdgeTime] using hwitnessState
  · intro i hi
    simpa [edgeTime, prefixCycleLassoEdgeTime] using
      hcycleEdgeAfterReturnStart i hi
  · intro i hi
    simpa [edgeTime, prefixCycleLassoEdgeTime] using
      hcycleEdgeBeforeReturnStop i hi

/--
Assemble a retained prefix and rotated simple retained cycle for a generic
carrier, first loop-erasing the retained prefix while preserving disjointness.
-/
theorem exists_finiteCarrierLoopErasedRecurrentReturnLassoWitness_of_retainedPrefixAndRotatedSimpleCycle_disjoint
    {Q : Type x}
    {Move : Type y}
    (sourceState : Nat -> Q)
    (sourceMove : Nat -> Move)
    (recurrentState : Q)
    {returnStart returnStop : Nat}
    (prefixEdgeTime cycleEdgeTime : Nat -> Nat)
    (start period witness : Nat)
    (hperiodPositive : 0 < period)
    (hselectedInit :
      sourceState
          (retainedPrefixVertexEdgeTime prefixEdgeTime (cycleEdgeTime 0)
            start 0) =
        sourceState 0)
    (hprefixTarget :
      ∀ k : Nat,
        k < start ->
          sourceState
              (retainedPrefixVertexEdgeTime prefixEdgeTime (cycleEdgeTime 0)
                start (k + 1)) =
            sourceState (prefixEdgeTime k + 1))
    (hcycleTarget :
      ∀ i : Nat,
        i < period ->
          sourceState (cycleEdgeTime (selectedLassoNextIndex 0 period i)) =
            sourceState (cycleEdgeTime i + 1))
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        sourceState (cycleEdgeTime i) = sourceState (cycleEdgeTime j) ->
          i = j)
    (hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < start ->
        j < period ->
          sourceState (prefixEdgeTime i) ≠ sourceState (cycleEdgeTime j))
    (hwitnessLt : witness < period)
    (hwitnessState :
      sourceState (cycleEdgeTime witness) = recurrentState)
    (hcycleEdgeAfterReturnStart :
      ∀ i : Nat,
        i < period ->
          returnStart ≤ cycleEdgeTime i)
    (hcycleEdgeBeforeReturnStop :
      ∀ i : Nat,
        i < period ->
          cycleEdgeTime i + 1 ≤ returnStop) :
    Nonempty
      (FiniteCarrierLoopErasedRecurrentReturnLassoWitness
        sourceState sourceMove recurrentState returnStart returnStop) := by
  rcases
      exists_simple_retainedPrefixEdgeTime_of_retainedPrefix_preserving_cycleDisjoint
        sourceState prefixEdgeTime cycleEdgeTime (cycleEdgeTime 0)
        (sourceState 0) hselectedInit hprefixTarget
        hprefixCycleDisjoint with
    ⟨simpleStart, simplePrefixEdgeTime, _hsimpleLe, hsimpleInit,
      hsimpleTarget, hsimplePrefix, hsimpleDisjoint⟩
  exact
    exists_finiteCarrierLoopErasedRecurrentReturnLassoWitness_of_simple_prefix_and_rotated_simple_retainedCycle
      sourceState sourceMove recurrentState simplePrefixEdgeTime cycleEdgeTime
      simpleStart period witness hperiodPositive
      (by
        simpa [prefixCycleLassoEdgeTime, retainedPrefixVertexEdgeTime] using
          hsimpleInit)
      (by
        intro k hk
        by_cases hnext : k + 1 < simpleStart
        · simpa [prefixCycleLassoEdgeTime, retainedPrefixVertexEdgeTime,
            hnext] using hsimpleTarget k hk
        · have hnextEq : k + 1 = simpleStart := by
            omega
          have hoffset : k + 1 - simpleStart = 0 := by
            omega
          have hvertex :
              prefixCycleLassoEdgeTime simplePrefixEdgeTime cycleEdgeTime
                  simpleStart (k + 1) =
                retainedPrefixVertexEdgeTime simplePrefixEdgeTime
                  (cycleEdgeTime 0) simpleStart (k + 1) := by
            simp [prefixCycleLassoEdgeTime, retainedPrefixVertexEdgeTime,
              hnext, hoffset]
          rw [hvertex]
          exact hsimpleTarget k hk)
      hcycleTarget hsimplePrefix hcycleSimple hsimpleDisjoint hwitnessLt
      hwitnessState hcycleEdgeAfterReturnStart hcycleEdgeBeforeReturnStop

/--
Assemble a generic loop-erased recurrent-return witness from a simple retained
return cycle and the original identity prefix.
-/
theorem exists_finiteCarrierLoopErasedRecurrentReturnLassoWitness_of_simple_retainedCycle_and_identityPrefix
    {Q : Type x}
    {Move : Type y}
    (sourceState : Nat -> Q)
    (sourceMove : Nat -> Move)
    (recurrentState : Q)
    {returnStart returnStop period : Nat}
    (cycleEdgeTime : Nat -> Nat)
    (hperiodPositive : 0 < period)
    (hcycleEntry :
      cycleEdgeTime 0 = returnStart)
    (hwitnessEntry :
      sourceState (cycleEdgeTime 0) = recurrentState)
    (hcycleTarget :
      ∀ n : Nat,
        n < period ->
          sourceState
              (cycleEdgeTime (selectedLassoNextIndex 0 period n)) =
            sourceState (cycleEdgeTime n + 1))
    (hcycleEdgeAfterReturnStart :
      ∀ n : Nat,
        n < period ->
          returnStart ≤ cycleEdgeTime n)
    (hcycleEdgeBeforeReturnStop :
      ∀ n : Nat,
        n < period ->
          cycleEdgeTime n + 1 ≤ returnStop)
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        sourceState (cycleEdgeTime i) = sourceState (cycleEdgeTime j) ->
          i = j) :
    Nonempty
      (FiniteCarrierLoopErasedRecurrentReturnLassoWitness
        sourceState sourceMove recurrentState returnStart returnStop) := by
  rcases
      exists_first_prefix_cycle_hit
        sourceState (fun n : Nat => n) cycleEdgeTime
        (start := returnStart) (period := period)
        (by
          refine ⟨returnStart, 0, le_rfl, hperiodPositive, ?_⟩
          simpa [hcycleEntry]) with
    ⟨hit, cHit, hhitLe, hcHit, hhitState, hfirstDisjoint⟩
  let rotatedCycleEdgeTime :=
    rotatedRetainedCycleEdgeTime cycleEdgeTime period cHit
  let witness := rotatedCycleWitnessOffset period cHit
  rcases
      rotatedRetainedCycleEdgeTime_properties
        sourceState cycleEdgeTime recurrentState hperiodPositive hcHit
        hwitnessEntry hcycleTarget hcycleEdgeAfterReturnStart
        hcycleEdgeBeforeReturnStop hcycleSimple with
    ⟨hrotEntry, hwitnessLt, hwitnessState, hrotBounds, hrotTarget,
      hrotSimple⟩
  have hhitTerminal :
      sourceState hit = sourceState (rotatedCycleEdgeTime 0) := by
    exact hhitState.trans (congrArg sourceState hrotEntry.symm)
  have hselectedInit :
      sourceState
          (retainedPrefixVertexEdgeTime (fun n : Nat => n)
            (rotatedCycleEdgeTime 0) hit 0) =
        sourceState 0 :=
    retainedPrefixVertexEdgeTime_id_selectedInit_of_terminal_hit
      sourceState hhitTerminal
  have hprefixTarget :
      ∀ k : Nat,
        k < hit ->
          sourceState
              (retainedPrefixVertexEdgeTime (fun n : Nat => n)
                (rotatedCycleEdgeTime 0) hit (k + 1)) =
            sourceState ((fun n : Nat => n) k + 1) :=
    retainedPrefixVertexEdgeTime_id_target_of_terminal_hit
      sourceState hhitTerminal
  have hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < hit ->
        j < period ->
          sourceState ((fun n : Nat => n) i) ≠
            sourceState (rotatedCycleEdgeTime j) := by
    simpa [rotatedCycleEdgeTime] using
      firstHit_disjoint_rotatedRetainedCycle
        sourceState (fun n : Nat => n) cycleEdgeTime
        hperiodPositive hfirstDisjoint
  exact
    exists_finiteCarrierLoopErasedRecurrentReturnLassoWitness_of_retainedPrefixAndRotatedSimpleCycle_disjoint
      sourceState sourceMove recurrentState (fun n : Nat => n)
      rotatedCycleEdgeTime hit period witness hperiodPositive
      hselectedInit hprefixTarget hrotTarget hrotSimple
      hprefixCycleDisjoint hwitnessLt hwitnessState
      (fun i hi => (hrotBounds i hi).1)
      (fun i hi => (hrotBounds i hi).2)

/--
Every finite recurrent return in an arbitrary carrier admits a loop-erased
retained-lasso witness.
-/
theorem exists_finiteCarrierLoopErasedRecurrentReturnLassoWitness_of_recurrentReturn
    {Q : Type x}
    {Move : Type y}
    (sourceState : Nat -> Q)
    (sourceMove : Nat -> Move)
    (recurrentState : Q)
    {returnStart returnStop : Nat}
    (hreturnLt : returnStart < returnStop)
    (hreturnStart : sourceState returnStart = recurrentState)
    (hreturnStop : sourceState returnStop = recurrentState) :
    Nonempty
      (FiniteCarrierLoopErasedRecurrentReturnLassoWitness
        sourceState sourceMove recurrentState returnStart returnStop) := by
  let period := returnStop - returnStart
  let baseCycleEdgeTime : Nat -> Nat := fun n => returnStart + n
  have hperiodPositive : 0 < period := by
    dsimp [period]
    omega
  have hbaseTarget :
      ∀ n : Nat,
        n < period ->
          sourceState
              (baseCycleEdgeTime
                (selectedLassoNextIndex 0 period n)) =
            sourceState (baseCycleEdgeTime n + 1) := by
    intro n hn
    by_cases hlast : n + 1 = period
    · have hnext :
          selectedLassoNextIndex 0 period n = 0 := by
        simpa using
          selectedLassoNextIndex_eq_start_of_last
            0 period n (by omega) (by simpa using hlast)
      rw [hnext]
      have hleft : baseCycleEdgeTime 0 = returnStart := by
        rfl
      have hright : baseCycleEdgeTime n + 1 = returnStop := by
        dsimp [baseCycleEdgeTime, period] at hlast ⊢
        omega
      rw [hleft, hright]
      exact hreturnStart.trans hreturnStop.symm
    · have hnext :
          selectedLassoNextIndex 0 period n = n + 1 :=
        selectedLassoNextIndex_eq_succ_of_not_last
          0 period n (by omega) (by simpa using hlast)
      rw [hnext]
      have hsucc :
          baseCycleEdgeTime (n + 1) = baseCycleEdgeTime n + 1 := by
        dsimp [baseCycleEdgeTime]
        omega
      rw [hsucc]
  have hbaseAfter :
      ∀ n : Nat,
        n < period ->
          returnStart ≤ baseCycleEdgeTime n := by
    intro n _hn
    dsimp [baseCycleEdgeTime]
    omega
  have hbaseBefore :
      ∀ n : Nat,
        n < period ->
          baseCycleEdgeTime n + 1 ≤ returnStop := by
    intro n hn
    dsimp [baseCycleEdgeTime, period] at hn ⊢
    omega
  rcases
      exists_simple_retainedCycleEdgeTime_of_retainedCycle
        sourceState baseCycleEdgeTime hperiodPositive hbaseTarget
        hbaseAfter hbaseBefore with
    ⟨simplePeriod, simpleEdgeTime, hsimplePeriodPositive, _hsimpleLe,
      hsimpleEntry, hsimpleBounds, hsimpleTarget, hsimpleSimple⟩
  have hsimpleEntryReturnStart :
      simpleEdgeTime 0 = returnStart := by
    exact hsimpleEntry.trans (by rfl)
  have hwitnessEntry :
      sourceState (simpleEdgeTime 0) = recurrentState := by
    rw [hsimpleEntryReturnStart]
    exact hreturnStart
  exact
    exists_finiteCarrierLoopErasedRecurrentReturnLassoWitness_of_simple_retainedCycle_and_identityPrefix
      sourceState sourceMove recurrentState simpleEdgeTime
      hsimplePeriodPositive hsimpleEntryReturnStart hwitnessEntry
      hsimpleTarget
      (fun n hn => (hsimpleBounds n hn).1)
      (fun n hn => (hsimpleBounds n hn).2)
      hsimpleSimple

/-- Generic bounded-window injectivity for a simple/disjoint selected lasso. -/
theorem finiteCarrierSelectedLasso_bounded_index_injective_of_prefix_cycle_simple_disjoint
    {Q : Type x}
    (stateAt : Nat -> Q)
    (start period : Nat)
    (hprefixSimple :
      ∀ i j : Nat,
        i < start ->
        j < start ->
        stateAt i = stateAt j ->
          i = j)
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        stateAt (start + i) = stateAt (start + j) ->
          i = j)
    (hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < start ->
        j < period ->
          stateAt i ≠ stateAt (start + j)) :
    ∀ i j : Nat,
      i < start + period ->
      j < start + period ->
      stateAt i = stateAt j ->
        i = j := by
  intro i j hiWindow hjWindow hstate
  by_cases hiPrefix : i < start
  · by_cases hjPrefix : j < start
    · exact hprefixSimple i j hiPrefix hjPrefix hstate
    · let jCycle := j - start
      have hjCycleLt : jCycle < period := by
        dsimp [jCycle]
        omega
      have hjEq : j = start + jCycle := by
        dsimp [jCycle]
        omega
      have hstateCycle : stateAt i = stateAt (start + jCycle) := by
        simpa [hjEq] using hstate
      exact False.elim
        ((hprefixCycleDisjoint i jCycle hiPrefix hjCycleLt) hstateCycle)
  · by_cases hjPrefix : j < start
    · let iCycle := i - start
      have hiCycleLt : iCycle < period := by
        dsimp [iCycle]
        omega
      have hiEq : i = start + iCycle := by
        dsimp [iCycle]
        omega
      have hstateCycle : stateAt j = stateAt (start + iCycle) := by
        simpa [hiEq] using hstate.symm
      exact False.elim
        ((hprefixCycleDisjoint j iCycle hjPrefix hiCycleLt) hstateCycle)
    · let iCycle := i - start
      let jCycle := j - start
      have hiCycleLt : iCycle < period := by
        dsimp [iCycle]
        omega
      have hjCycleLt : jCycle < period := by
        dsimp [jCycle]
        omega
      have hiEq : i = start + iCycle := by
        dsimp [iCycle]
        omega
      have hjEq : j = start + jCycle := by
        dsimp [jCycle]
        omega
      have hstateCycle :
          stateAt (start + iCycle) = stateAt (start + jCycle) := by
        simpa [hiEq, hjEq] using hstate
      have hcyclesEq :
          iCycle = jCycle :=
        hcycleSimple iCycle jCycle hiCycleLt hjCycleLt hstateCycle
      omega

/--
Simple/disjoint selected-lasso shape makes moves functional on selected carrier
states.
-/
theorem finiteCarrierSelectedLasso_bounded_index_functional_of_prefix_cycle_simple_disjoint
    {Q : Type x}
    {Move : Type y}
    (stateAt : Nat -> Q)
    (moveAt : Nat -> Move)
    (start period : Nat)
    (hprefixSimple :
      ∀ i j : Nat,
        i < start ->
        j < start ->
        stateAt i = stateAt j ->
          i = j)
    (hcycleSimple :
      ∀ i j : Nat,
        i < period ->
        j < period ->
        stateAt (start + i) = stateAt (start + j) ->
          i = j)
    (hprefixCycleDisjoint :
      ∀ i j : Nat,
        i < start ->
        j < period ->
          stateAt i ≠ stateAt (start + j)) :
    ∀ i j : Nat,
      i < start + period ->
      j < start + period ->
      stateAt i = stateAt j ->
        moveAt i = moveAt j := by
  intro i j hi hj hstate
  have hij :
      i = j :=
    finiteCarrierSelectedLasso_bounded_index_injective_of_prefix_cycle_simple_disjoint
      stateAt start period hprefixSimple hcycleSimple hprefixCycleDisjoint
      i j hi hj hstate
  subst j
  rfl

/--
Rejected coherent finite-carrier DPA-progress streams produce a rejected
memoryless finite-carrier code.

This is the generic enriched-carrier backend theorem: recurrence, retained-edge
loop erasure, selected-lasso functionality, and finite-code realization are all
internal Lean steps.
-/
theorem exists_finiteCarrierCode_rejected_playWord_of_rejected_dpaProgress_stateStream
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    [Fintype Q]
    (initial : Q)
    (step : Q -> Move -> Q)
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (sourceState : Nat -> Q)
    (sourceMove : Nat -> Move)
    (dpaOf : Q -> A.State)
    (hsourceInit : sourceState 0 = initial)
    (hsourceStep :
      ∀ n : Nat,
        sourceState (n + 1) = step (sourceState n) (sourceMove n))
    (hdpaSourceInit : dpaOf (sourceState 0) = A.initial)
    (hdpaSourceStep :
      ∀ n : Nat,
        dpaOf (sourceState (n + 1)) =
          A.step (dpaOf (sourceState n))
            (finiteCarrierWord emit sourceState sourceMove n))
    (hreject :
      ¬ A.Accepts (finiteCarrierWord emit sourceState sourceMove)) :
    ∃ code : Q -> Move,
      ¬ A.Accepts (finiteCarrierPlayWord initial step emit code) := by
  rcases
      exists_recurrent_return_finiteCarrierState_min_priority_not_even_and_eventually_ge_of_not_accepts_of_dpaProgress
        emit A sourceState sourceMove dpaOf
        hdpaSourceInit hdpaSourceStep hreject with
    ⟨p, recurrentState, returnStart, returnStop, hreturnLt,
      hrecurrentPriority, hreturnStart, hreturnStop, hcycleLowerFromReturn,
      hpOdd⟩
  rcases
      exists_finiteCarrierLoopErasedRecurrentReturnLassoWitness_of_recurrentReturn
        sourceState sourceMove recurrentState hreturnLt
        hreturnStart hreturnStop with
    ⟨lasso⟩
  have hinit : lasso.stateAt 0 = initial := by
    rw [lasso.selectedInit, hsourceInit]
  have hstepBounded :
      ∀ k : Nat,
        k < lasso.start + lasso.period ->
          lasso.stateAt
              (selectedLassoNextIndex lasso.start lasso.period k) =
            step (lasso.stateAt k) (lasso.moveAt k) := by
    intro k hk
    calc
      lasso.stateAt (selectedLassoNextIndex lasso.start lasso.period k)
          = sourceState (lasso.edgeTime k + 1) :=
            lasso.selectedTarget k hk
      _ = step (sourceState (lasso.edgeTime k))
            (sourceMove (lasso.edgeTime k)) :=
            hsourceStep (lasso.edgeTime k)
      _ = step (lasso.stateAt k) (lasso.moveAt k) := by
            rw [lasso.selectedSource k hk, lasso.selectedMove k hk]
  have hfunctional :
      ∀ i j : Nat,
        i < lasso.start + lasso.period ->
        j < lasso.start + lasso.period ->
        lasso.stateAt i = lasso.stateAt j ->
          lasso.moveAt i = lasso.moveAt j :=
    finiteCarrierSelectedLasso_bounded_index_functional_of_prefix_cycle_simple_disjoint
      lasso.stateAt lasso.moveAt lasso.start lasso.period
      lasso.prefixSimple lasso.cycleSimple lasso.prefixCycleDisjoint
  have hdpaInit : dpaOf (lasso.stateAt 0) = A.initial := by
    rw [lasso.selectedInit, hdpaSourceInit]
  have hdpaStepBounded :
      ∀ k : Nat,
        k < lasso.start + lasso.period ->
          dpaOf
              (lasso.stateAt
                (selectedLassoNextIndex lasso.start lasso.period k)) =
            A.step (dpaOf (lasso.stateAt k))
              (emit (lasso.stateAt k) (lasso.moveAt k)) := by
    intro k hk
    calc
      dpaOf
          (lasso.stateAt
            (selectedLassoNextIndex lasso.start lasso.period k))
          = dpaOf (sourceState (lasso.edgeTime k + 1)) := by
            rw [lasso.selectedTarget k hk]
      _ = A.step (dpaOf (sourceState (lasso.edgeTime k)))
            (finiteCarrierWord emit sourceState sourceMove
              (lasso.edgeTime k)) :=
            hdpaSourceStep (lasso.edgeTime k)
      _ = A.step (dpaOf (lasso.stateAt k))
            (emit (lasso.stateAt k) (lasso.moveAt k)) := by
            rw [lasso.selectedSource k hk, lasso.selectedMove k hk]
            simp [finiteCarrierWord]
  have hwitnessPriority :
      A.priority
          (dpaOf (lasso.stateAt (lasso.start + lasso.witness))) = p := by
    have hwWindow :
        lasso.start + lasso.witness < lasso.start + lasso.period := by
      exact Nat.add_lt_add_left lasso.witnessLt lasso.start
    calc
      A.priority (dpaOf (lasso.stateAt (lasso.start + lasso.witness)))
          =
            A.priority
              (dpaOf
                (sourceState
                  (lasso.edgeTime (lasso.start + lasso.witness)))) := by
            rw [lasso.selectedSource (lasso.start + lasso.witness) hwWindow]
      _ = A.priority (dpaOf recurrentState) := by
            rw [lasso.witnessState]
      _ = p := hrecurrentPriority
  have hcycleLower :
      ∀ i : Nat,
        i < lasso.period ->
          p ≤ A.priority (dpaOf (lasso.stateAt (lasso.start + i))) := by
    intro i hi
    have hiWindow : lasso.start + i < lasso.start + lasso.period := by
      omega
    calc
      p ≤
          A.priority
            (dpaOf
              (sourceState (lasso.edgeTime (lasso.start + i)))) :=
        hcycleLowerFromReturn
          (lasso.edgeTime (lasso.start + i))
          (lasso.cycleEdgeAfterReturnStart i hi)
      _ =
          A.priority (dpaOf (lasso.stateAt (lasso.start + i))) := by
        rw [lasso.selectedSource (lasso.start + i) hiWindow]
  exact
    exists_finiteCarrierCode_rejected_playWord_of_selected_lasso_indices_of_bounded_edges_functional_cycleWitness_dpaProgress_lowerBound
      initial step emit A lasso.stateAt lasso.moveAt dpaOf
      lasso.start lasso.period lasso.periodPositive
      hinit hstepBounded hfunctional hdpaInit hdpaStepBounded
      lasso.witness lasso.witnessLt
      (p := p) hwitnessPriority hcycleLower hpOdd

/-
Finite-carrier parity outcome certificates.

The generic `Q` reflection above supplies rejected memoryless environment
codes.  The next backend ingredient is that fixed `Q`-codes have decidable DPA
outcomes, because the combined finite carrier/DPA run state eventually loops.
-/

/-- Combined finite-carrier state and DPA run state for a fixed memoryless code. -/
def finiteCarrierDPAStateStream
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (initial : Q)
    (step : Q -> Move -> Q)
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (code : Q -> Move) :
    Nat -> Q × A.State :=
  fun n =>
    (finiteCarrierStateStream initial step code n,
      A.run (finiteCarrierPlayWord initial step emit code) n)

theorem finiteCarrierDPAStateStream_succ
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (initial : Q)
    (step : Q -> Move -> Q)
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (code : Q -> Move)
    (n : Nat) :
    finiteCarrierDPAStateStream initial step emit A code (n + 1) =
      (step
          (finiteCarrierDPAStateStream initial step emit A code n).1
          (code (finiteCarrierDPAStateStream initial step emit A code n).1),
        A.step
          (finiteCarrierDPAStateStream initial step emit A code n).2
          (emit
            (finiteCarrierDPAStateStream initial step emit A code n).1
            (code
              (finiteCarrierDPAStateStream initial step emit A code n).1))) := by
  ext <;>
    simp [finiteCarrierDPAStateStream, finiteCarrierStateStream_succ,
      finiteCarrierPlayWord, finiteCarrierWord, finiteCarrierMoveStream,
      A.run_succ]

theorem finiteCarrierDPAStateStream_loop_shift
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (initial : Q)
    (step : Q -> Move -> Q)
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (code : Q -> Move)
    (start period : Nat)
    (hloop :
      finiteCarrierDPAStateStream initial step emit A code
          (start + period) =
        finiteCarrierDPAStateStream initial step emit A code start) :
    ∀ m : Nat,
      finiteCarrierDPAStateStream initial step emit A code
          (start + period + m) =
        finiteCarrierDPAStateStream initial step emit A code (start + m) := by
  intro m
  induction m with
  | zero =>
      simpa using hloop
  | succ m ih =>
      have hstepEq :=
        congrArg
          (fun s : Q × A.State =>
            (step s.1 (code s.1),
              A.step s.2 (emit s.1 (code s.1)))) ih
      have hleft :
          start + period + (m + 1) =
            (start + period + m) + 1 := by
        omega
      have hright : start + (m + 1) = (start + m) + 1 := by
        omega
      rw [hleft, hright]
      rw [finiteCarrierDPAStateStream_succ,
        finiteCarrierDPAStateStream_succ]
      exact hstepEq

/--
A finite priority-loop certificate for a fixed finite-carrier code.
-/
structure FiniteCarrierPriorityLoopCertificate
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (initial : Q)
    (step : Q -> Move -> Q)
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (code : Q -> Move) where
  start : Nat
  period : Nat
  period_pos : 0 < period
  cover :
    ∀ k : Nat,
      start ≤ k ->
        ∃ i : Nat,
          i < period ∧
            A.priority
              (A.run (finiteCarrierPlayWord initial step emit code) k) =
              A.priority
                (A.run (finiteCarrierPlayWord initial step emit code)
                  (start + i))
  periodic :
    ∀ i n : Nat,
      i < period ->
        A.priority
          (A.run (finiteCarrierPlayWord initial step emit code)
            (start + i + n * period)) =
          A.priority
            (A.run (finiteCarrierPlayWord initial step emit code)
              (start + i))

namespace FiniteCarrierPriorityLoopCertificate

def cyclePriorities
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    {initial : Q}
    {step : Q -> Move -> Q}
    {emit : Q -> Move -> Alphabet}
    {A : DetParityAutomaton.{z, b} Alphabet}
    {code : Q -> Move}
    (cert :
      FiniteCarrierPriorityLoopCertificate initial step emit A code) :
    Finset Nat :=
  (Finset.range cert.period).image
    (fun i : Nat =>
      A.priority
        (A.run (finiteCarrierPlayWord initial step emit code)
          (cert.start + i)))

theorem cyclePriorities_nonempty
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    {initial : Q}
    {step : Q -> Move -> Q}
    {emit : Q -> Move -> Alphabet}
    {A : DetParityAutomaton.{z, b} Alphabet}
    {code : Q -> Move}
    (cert :
      FiniteCarrierPriorityLoopCertificate initial step emit A code) :
    cert.cyclePriorities.Nonempty :=
  Finset.image_nonempty.mpr
    (Finset.nonempty_range_iff.mpr (Nat.ne_of_gt cert.period_pos))

def cycleMinEven
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    {initial : Q}
    {step : Q -> Move -> Q}
    {emit : Q -> Move -> Alphabet}
    {A : DetParityAutomaton.{z, b} Alphabet}
    {code : Q -> Move}
    (cert :
      FiniteCarrierPriorityLoopCertificate initial step emit A code) :
    Prop :=
  DetParityAutomaton.NatEven
    (cert.cyclePriorities.min' cert.cyclePriorities_nonempty)

theorem accepts_iff
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    {initial : Q}
    {step : Q -> Move -> Q}
    {emit : Q -> Move -> Alphabet}
    {A : DetParityAutomaton.{z, b} Alphabet}
    {code : Q -> Move}
    (cert :
      FiniteCarrierPriorityLoopCertificate initial step emit A code) :
    A.Accepts (finiteCarrierPlayWord initial step emit code) ↔
      cert.cycleMinEven := by
  change
    A.AcceptsFrom A.initial (finiteCarrierPlayWord initial step emit code) ↔
      DetParityAutomaton.NatEven
        (((Finset.range cert.period).image
          (fun i : Nat =>
            A.priority
              (A.run (finiteCarrierPlayWord initial step emit code)
                (cert.start + i)))).min'
            (Finset.image_nonempty.mpr
              (Finset.nonempty_range_iff.mpr
                (Nat.ne_of_gt cert.period_pos))))
  exact
    A.acceptsFrom_iff_eventual_periodic_cycle_priority_min_even
      A.initial (finiteCarrierPlayWord initial step emit code)
      cert.start cert.period cert.period_pos cert.cover cert.periodic

noncomputable def acceptsDecidable
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    {initial : Q}
    {step : Q -> Move -> Q}
    {emit : Q -> Move -> Alphabet}
    {A : DetParityAutomaton.{z, b} Alphabet}
    {code : Q -> Move}
    (cert :
      FiniteCarrierPriorityLoopCertificate initial step emit A code) :
    Decidable (A.Accepts (finiteCarrierPlayWord initial step emit code)) := by
  classical
  exact decidable_of_iff cert.cycleMinEven cert.accepts_iff.symm

end FiniteCarrierPriorityLoopCertificate

/--
A finite combined-state loop certificate for a fixed finite-carrier code.
-/
structure FiniteCarrierStateLoopCertificate
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (initial : Q)
    (step : Q -> Move -> Q)
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (code : Q -> Move) where
  start : Nat
  period : Nat
  period_pos : 0 < period
  loop_eq :
    finiteCarrierDPAStateStream initial step emit A code (start + period) =
      finiteCarrierDPAStateStream initial step emit A code start

namespace FiniteCarrierStateLoopCertificate

theorem state_periodic
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    {initial : Q}
    {step : Q -> Move -> Q}
    {emit : Q -> Move -> Alphabet}
    {A : DetParityAutomaton.{z, b} Alphabet}
    {code : Q -> Move}
    (cert :
      FiniteCarrierStateLoopCertificate initial step emit A code)
    (i n : Nat) :
    finiteCarrierDPAStateStream initial step emit A code
        (cert.start + i + n * cert.period) =
      finiteCarrierDPAStateStream initial step emit A code
        (cert.start + i) := by
  induction n with
  | zero =>
      simp
  | succ n ih =>
      have hshift :=
        finiteCarrierDPAStateStream_loop_shift
          initial step emit A code cert.start cert.period cert.loop_eq
          (i + n * cert.period)
      have hleft :
          cert.start + i + (n + 1) * cert.period =
            cert.start + cert.period + (i + n * cert.period) := by
        rw [Nat.succ_mul]
        omega
      have hright :
          cert.start + (i + n * cert.period) =
            cert.start + i + n * cert.period := by
        omega
      rw [hleft, hshift, hright]
      exact ih

theorem priority_periodic
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    {initial : Q}
    {step : Q -> Move -> Q}
    {emit : Q -> Move -> Alphabet}
    {A : DetParityAutomaton.{z, b} Alphabet}
    {code : Q -> Move}
    (cert :
      FiniteCarrierStateLoopCertificate initial step emit A code)
    (i n : Nat) :
    A.priority
        (A.run (finiteCarrierPlayWord initial step emit code)
          (cert.start + i + n * cert.period)) =
      A.priority
        (A.run (finiteCarrierPlayWord initial step emit code)
          (cert.start + i)) := by
  have hstate := cert.state_periodic i n
  exact congrArg (fun state : Q × A.State => A.priority state.2) hstate

def toPriorityLoopCertificate
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    {initial : Q}
    {step : Q -> Move -> Q}
    {emit : Q -> Move -> Alphabet}
    {A : DetParityAutomaton.{z, b} Alphabet}
    {code : Q -> Move}
    (cert :
      FiniteCarrierStateLoopCertificate initial step emit A code) :
    FiniteCarrierPriorityLoopCertificate initial step emit A code where
  start := cert.start
  period := cert.period
  period_pos := cert.period_pos
  cover := by
    intro k hk
    let d := k - cert.start
    let i := d % cert.period
    let n := d / cert.period
    refine ⟨i, Nat.mod_lt d cert.period_pos, ?_⟩
    have hdecomp : d = i + n * cert.period := by
      simpa [i, n, Nat.mul_comm] using
        (Nat.mod_add_div d cert.period).symm
    have hk_eq : k = cert.start + i + n * cert.period := by
      have hkstart : k = cert.start + d := by
        omega
      omega
    rw [hk_eq]
    exact cert.priority_periodic i n
  periodic := by
    intro i n _hi
    exact cert.priority_periodic i n

theorem accepts_iff
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    {initial : Q}
    {step : Q -> Move -> Q}
    {emit : Q -> Move -> Alphabet}
    {A : DetParityAutomaton.{z, b} Alphabet}
    {code : Q -> Move}
    (cert :
      FiniteCarrierStateLoopCertificate initial step emit A code) :
    A.Accepts (finiteCarrierPlayWord initial step emit code) ↔
      cert.toPriorityLoopCertificate.cycleMinEven :=
  cert.toPriorityLoopCertificate.accepts_iff

noncomputable def acceptsDecidable
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    {initial : Q}
    {step : Q -> Move -> Q}
    {emit : Q -> Move -> Alphabet}
    {A : DetParityAutomaton.{z, b} Alphabet}
    {code : Q -> Move}
    (cert :
      FiniteCarrierStateLoopCertificate initial step emit A code) :
    Decidable (A.Accepts (finiteCarrierPlayWord initial step emit code)) :=
  cert.toPriorityLoopCertificate.acceptsDecidable

end FiniteCarrierStateLoopCertificate

/--
Every fixed memoryless code over a finite carrier has a repeated combined
carrier/DPA state, hence a concrete loop certificate.
-/
theorem exists_finiteCarrierStateLoopCertificate
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    [Fintype Q]
    (initial : Q)
    (step : Q -> Move -> Q)
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (code : Q -> Move) :
    Nonempty
      (FiniteCarrierStateLoopCertificate initial step emit A code) := by
  classical
  letI : Fintype A.State := A.stateFinite
  let Combined := Q × A.State
  letI : Fintype Combined := inferInstance
  let stream : Nat -> Combined :=
    finiteCarrierDPAStateStream initial step emit A code
  let n := Fintype.card Combined
  have hcard : Fintype.card Combined < Fintype.card (Fin (n + 1)) := by
    simp [n]
  obtain ⟨x, y, hxy, hEq⟩ :=
    Fintype.exists_ne_map_eq_of_card_lt
      (fun i : Fin (n + 1) => stream i.1) hcard
  have hval_ne : x.1 ≠ y.1 := by
    intro h
    exact hxy (Fin.ext h)
  rcases lt_or_gt_of_ne hval_ne with hlt | hgt
  · have hsum : x.1 + (y.1 - x.1) = y.1 :=
      Nat.add_sub_of_le (Nat.le_of_lt hlt)
    refine
      ⟨{
        start := x.1
        period := y.1 - x.1
        period_pos := Nat.sub_pos_of_lt hlt
        loop_eq := ?_
      }⟩
    change stream (x.1 + (y.1 - x.1)) = stream x.1
    rw [hsum]
    exact hEq.symm
  · have hsum : y.1 + (x.1 - y.1) = x.1 :=
      Nat.add_sub_of_le (Nat.le_of_lt hgt)
    refine
      ⟨{
        start := y.1
        period := x.1 - y.1
        period_pos := Nat.sub_pos_of_lt hgt
        loop_eq := ?_
      }⟩
    change stream (y.1 + (x.1 - y.1)) = stream y.1
    rw [hsum]
    exact hEq

noncomputable def finiteCarrierStateLoopCertificate
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    [Fintype Q]
    (initial : Q)
    (step : Q -> Move -> Q)
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (code : Q -> Move) :
    FiniteCarrierStateLoopCertificate initial step emit A code :=
  Classical.choice
    (exists_finiteCarrierStateLoopCertificate initial step emit A code)

/--
The DPA outcome of a fixed memoryless finite-carrier play is decidable by the
combined finite carrier/DPA-state loop.
-/
noncomputable def finiteCarrierAcceptsDecidableByStateLoop
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    [Fintype Q]
    (initial : Q)
    (step : Q -> Move -> Q)
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (code : Q -> Move) :
    Decidable (A.Accepts (finiteCarrierPlayWord initial step emit code)) :=
  (finiteCarrierStateLoopCertificate initial step emit A code).acceptsDecidable

/- The coherent round-aware state-stream invariant yields decoded
environment-code representability for local controllers. -/
theorem roundAwareLocalControllerDecodedEnvironmentRepresentable_of_coherentStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (hcoherent :
      ∀ env : EnvironmentSequence In₁ In₂,
        ∃ stateStream : Nat -> GameState T,
          RoundAwareLocalControllerDecodedEnvironmentCoherentStateStream
            T initialBoundary viewOne viewTwo controller σ env stateStream) :
    RoundAwareLocalControllerDecodedEnvironmentRepresentable
      T initialBoundary viewOne viewTwo controller σ := by
  intro env
  rcases hcoherent env with ⟨stateStream, hstream⟩
  rcases hstream with ⟨hinit, hstep, hconsistent, hviews⟩
  let environment := environmentCodeOfStateStream T stateStream env
  refine ⟨environment, ?_, ?_⟩
  · funext n
    have hstate :
        roundAwareGameStateStream T initialBoundary controller.1
            environment n =
          stateStream n :=
      roundAwareGameStateStream_environmentCodeOfStateStream_eq
        T initialBoundary controller.1 stateStream env
        hinit hstep hconsistent n
    have henv :
        environment (stateStream n) = env n :=
      environmentCodeOfStateStream_apply_of_consistent
        T stateStream env hconsistent n
    simp [roundAwareEnvironmentSequenceOfGamePlay, environment, hstate, henv]
  · intro n
    have hstate :
        roundAwareGameStateStream T initialBoundary controller.1
            environment n =
          stateStream n :=
      roundAwareGameStateStream_environmentCodeOfStateStream_eq
        T initialBoundary controller.1 stateStream env
        hinit hstep hconsistent n
    have henv :
        environment (stateStream n) = env n :=
      environmentCodeOfStateStream_apply_of_consistent
        T stateStream env hconsistent n
    have hview := hviews n
    change
      viewOne
          (roundAwareGameStateStream
            T initialBoundary controller.1 environment n)
          (environment
            (roundAwareGameStateStream
              T initialBoundary controller.1 environment n)) =
          nextView Proc.one (executionPrefix σ env n) (env n) ∧
        viewTwo
          (roundAwareGameStateStream
            T initialBoundary controller.1 environment n)
          (environment
            (roundAwareGameStateStream
              T initialBoundary controller.1 environment n)) =
          nextView Proc.two (executionPrefix σ env n) (env n)
    rw [hstate, henv]
    exact hview

theorem gameStateStream_environmentCodeOfStateStream_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (hinit : stateStream 0 = Sum.inl initialBoundary)
    (hstep :
      ∀ n : Nat,
        stateStream (n + 1) =
          gameTransition T controller (stateStream n) (env n))
    (hconsistent :
      ∀ i j : Nat, stateStream i = stateStream j -> env i = env j)
    (n : Nat) :
    gameStateStream T initialBoundary controller
        (environmentCodeOfStateStream T stateStream env) n =
      stateStream n := by
  induction n with
  | zero =>
      simpa using hinit.symm
  | succ n ih =>
      rw [gameStateStream_succ]
      rw [ih]
      rw [environmentCodeOfStateStream_apply_of_consistent
        T stateStream env hconsistent n]
      exact (hstep n).symm

/--
A coherent abstract state stream whose repeated states choose the same
environment move induces a finite environment code reproducing the target word.
-/
theorem exists_environmentCode_gameExecution_eq_of_consistent_stateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hinit : stateStream 0 = Sum.inl initialBoundary)
    (hstep :
      ∀ n : Nat,
        stateStream (n + 1) =
          gameTransition T controller (stateStream n) (env n))
    (hconsistent :
      ∀ i j : Nat, stateStream i = stateStream j -> env i = env j)
    (hword :
      ∀ n : Nat,
        word n =
          {
            inputOne := (env n).inputOne
            inputTwo := (env n).inputTwo
            graph := (env n).graph
            outputOne := (controller (stateStream n)).1
            outputTwo := (controller (stateStream n)).2
          }) :
    ∃ environment : EnvironmentCode T,
      gameExecution T initialBoundary controller environment = word := by
  classical
  let environment := environmentCodeOfStateStream T stateStream env
  refine ⟨environment, ?_⟩
  funext n
  have hstate :
      gameStateStream T initialBoundary controller environment n =
        stateStream n :=
    gameStateStream_environmentCodeOfStateStream_eq
      T initialBoundary controller stateStream env hinit hstep hconsistent n
  have henv :
      environment (stateStream n) = env n :=
    environmentCodeOfStateStream_apply_of_consistent
      T stateStream env hconsistent n
  rw [hword n]
  simp [gameExecution, environment, hstate, henv]

/--
Representation boundary for decoded-controller soundness.

Every omega word compatible with the local uncertainty of the decoded
controller must be reproducible as an ordinary finite-game execution for some
finite environment code.  This is the exact finite-game/environment-code
coverage theorem needed in the soundness direction of the journal reduction.
-/
def CompatibleDecodedExecutionRepresentable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T) : Prop :=
  ∀ (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
      CompatibleDecodedExecution T initialBoundary controller env word ->
        ∃ environment : EnvironmentCode T,
          gameExecution T initialBoundary controller environment = word

/--
The state-stream invariant sufficient to represent a compatible decoded
execution by a finite environment code.

This is the local target left by the finite-memory/journal argument: construct
an abstract epoch-game state stream that follows the concrete environment
moves, emits the target word through the controller at that state, and assigns
the same next environment move whenever the same abstract state recurs.
-/
def CompatibleDecodedExecutionCoherentStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T) : Prop :=
  stateStream 0 = Sum.inl initialBoundary ∧
    (∀ n : Nat,
      stateStream (n + 1) =
        gameTransition T controller (stateStream n) (env n)) ∧
    (∀ i j : Nat, stateStream i = stateStream j -> env i = env j) ∧
    (∀ n : Nat,
      word n =
        {
          inputOne := (env n).inputOne
          inputTwo := (env n).inputTwo
          graph := (env n).graph
          outputOne := (controller (stateStream n)).1
          outputTwo := (controller (stateStream n)).2
        })

/--
Controller-level coherent-state-stream boundary.

This is the paper-facing finite-memory obligation for the soundness direction:
each compatible decoded execution must provide an abstract epoch-game state stream
following the same inputs and producing the same word through the finite
controller.
-/
def CompatibleDecodedControllerCoherentStateStreams
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T) : Prop :=
  ∀ (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
      CompatibleDecodedExecution T initialBoundary controller env word ->
        ∃ stateStream : Nat -> GameState T,
          CompatibleDecodedExecutionCoherentStateStream
            T initialBoundary controller env word stateStream

/--
Synchronized state-choice boundary for a compatible decoded execution.

The earlier `exists_compatibleDecodedExecution_stateChoiceStreams` theorem gives
separate process-one and process-two witness streams.  This predicate states
the extra journal/finite-memory invariant needed to merge them: the same
abstract epoch-game state witnesses both outputs, follows the concrete
environment moves, and chooses equal environment moves whenever that abstract
state repeats.
-/
def CompatibleDecodedExecutionSynchronizedStateChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T) : Prop :=
  stateStream 0 = Sum.inl initialBoundary ∧
    (∀ n : Nat,
      stateStream (n + 1) =
        gameTransition T controller (stateStream n) (env n)) ∧
    (∀ i j : Nat, stateStream i = stateStream j -> env i = env j) ∧
    (∀ n : Nat,
      stateStream n ∈ possibleEpochStatesFromView
          T initialBoundary controller Proc.one
            (currentView Proc.one
              (executionPrefix
                (controllerStrategyOf T initialBoundary controller)
                env (n + 1))) ∧
      stateStream n ∈ possibleEpochStatesFromView
          T initialBoundary controller Proc.two
            (currentView Proc.two
              (executionPrefix
                (controllerStrategyOf T initialBoundary controller)
                env (n + 1))) ∧
      word n =
        {
          inputOne := (env n).inputOne
          inputTwo := (env n).inputTwo
          graph := (env n).graph
          outputOne := (controller (stateStream n)).1
          outputTwo := (controller (stateStream n)).2
        })

/--
The synchronized state-choice invariant is genuinely a strengthening of
compatible decoded execution: at every round, the single synchronized state
witnesses both local possible-state sets and reproduces the word's outputs.
-/
theorem compatibleDecodedExecution_of_synchronizedStateChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (hsync :
      CompatibleDecodedExecutionSynchronizedStateChoices
        T initialBoundary controller env word stateStream) :
    CompatibleDecodedExecution T initialBoundary controller env word := by
  intro n
  rcases hsync with ⟨_hinit, _hstep, _hconsistent, hchoice⟩
  exact
    ⟨stateStream n,
      (hchoice n).1,
      stateStream n,
      (hchoice n).2.1,
      (hchoice n).2.2⟩

/--
The synchronized state-choice invariant is exactly strong enough to discharge
the coherent-state-stream obligation used by the finite environment-code
representation theorem.
-/
theorem compatibleDecodedExecutionCoherentStateStream_of_synchronizedStateChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (hsync :
      CompatibleDecodedExecutionSynchronizedStateChoices
        T initialBoundary controller env word stateStream) :
    CompatibleDecodedExecutionCoherentStateStream
      T initialBoundary controller env word stateStream := by
  rcases hsync with ⟨hinit, hstep, hconsistent, hchoice⟩
  exact ⟨hinit, hstep, hconsistent, fun n => (hchoice n).2.2⟩

/--
Controller-level synchronized state choices imply the coherent-state-stream
boundary consumed by the certificate constructors.
-/
theorem compatibleDecodedControllerCoherentStateStreams_of_synchronizedStateChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (hsync :
      ∀ (env : EnvironmentSequence In₁ In₂)
        (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          CompatibleDecodedExecution T initialBoundary controller env word ->
            ∃ stateStream : Nat -> GameState T,
              CompatibleDecodedExecutionSynchronizedStateChoices
                T initialBoundary controller env word stateStream) :
    CompatibleDecodedControllerCoherentStateStreams
      T initialBoundary controller := by
  intro env word hcompatible
  rcases hsync env word hcompatible with ⟨stateStream, hstream⟩
  exact
    ⟨stateStream,
      compatibleDecodedExecutionCoherentStateStream_of_synchronizedStateChoices
        T initialBoundary controller env word stateStream hstream⟩

theorem exists_environmentCode_gameExecution_eq_of_coherentStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    {stateStream : Nat -> GameState T}
    (hstream :
      CompatibleDecodedExecutionCoherentStateStream
        T initialBoundary controller env word stateStream) :
    ∃ environment : EnvironmentCode T,
      gameExecution T initialBoundary controller environment = word := by
  rcases hstream with ⟨hinit, hstep, hconsistent, hword⟩
  exact
    exists_environmentCode_gameExecution_eq_of_consistent_stateStream
      T initialBoundary controller stateStream env word
      hinit hstep hconsistent hword

/--
To prove compatible decoded executions representable, it is enough to construct
the coherent abstract state stream for each compatible decoded execution.
-/
theorem compatibleDecodedExecutionRepresentable_of_coherentStateStreams
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (hcoherent :
      ∀ (env : EnvironmentSequence In₁ In₂)
        (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          CompatibleDecodedExecution T initialBoundary controller env word ->
            ∃ stateStream : Nat -> GameState T,
              CompatibleDecodedExecutionCoherentStateStream
                T initialBoundary controller env word stateStream) :
    CompatibleDecodedExecutionRepresentable T initialBoundary controller := by
  intro env word hcompatible
  rcases hcoherent env word hcompatible with ⟨stateStream, hstream⟩
  exact
    exists_environmentCode_gameExecution_eq_of_coherentStateStream
      T initialBoundary controller env word hstream

/--
The named controller-level coherent-state-stream boundary implies the
finite-environment-code representation boundary used by game soundness.
-/
theorem compatibleDecodedExecutionRepresentable_of_controllerCoherentStateStreams
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (hcoherent :
      CompatibleDecodedControllerCoherentStateStreams
        T initialBoundary controller) :
    CompatibleDecodedExecutionRepresentable T initialBoundary controller :=
  compatibleDecodedExecutionRepresentable_of_coherentStateStreams
    T initialBoundary controller hcoherent

/--
Controller-level synchronized state choices imply finite environment-code
representability directly.

This is the transitive form consumed by the soundness side of the epoch-game
certificate: the synchronized stream gives a coherent stream, and the coherent
stream determines a finite environment code by repeat consistency.
-/
theorem compatibleDecodedExecutionRepresentable_of_synchronizedStateChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (hsync :
      ∀ (env : EnvironmentSequence In₁ In₂)
        (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          CompatibleDecodedExecution T initialBoundary controller env word ->
            ∃ stateStream : Nat -> GameState T,
              CompatibleDecodedExecutionSynchronizedStateChoices
                T initialBoundary controller env word stateStream) :
    CompatibleDecodedExecutionRepresentable T initialBoundary controller :=
  compatibleDecodedExecutionRepresentable_of_controllerCoherentStateStreams
    T initialBoundary controller
    (compatibleDecodedControllerCoherentStateStreams_of_synchronizedStateChoices
      T initialBoundary controller hsync)

/--
The combined finite state of the epoch game and the DPA run.

This is the finite transition graph whose loops decide `gameWins`: the epoch
state determines the next round record, and the DPA state determines the next
DPA state after reading that record.
-/
def gameAutomatonStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T) :
    Nat -> GameState T × T.automaton.State :=
  fun n =>
    (gameStateStream T initialBoundary controller environment n,
      T.automaton.run
        (gameExecution T initialBoundary controller environment) n)

@[simp] theorem gameAutomatonStateStream_fst
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (n : Nat) :
    (gameAutomatonStateStream T initialBoundary controller environment n).1 =
      gameStateStream T initialBoundary controller environment n :=
  rfl

@[simp] theorem gameAutomatonStateStream_snd
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (n : Nat) :
    (gameAutomatonStateStream T initialBoundary controller environment n).2 =
      T.automaton.run
        (gameExecution T initialBoundary controller environment) n :=
  rfl

@[simp] theorem gameAutomatonStateStream_succ
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (n : Nat) :
    gameAutomatonStateStream T initialBoundary controller environment (n + 1) =
      let current :=
        gameAutomatonStateStream T initialBoundary controller environment n
      let envRound := environment current.1
      let output := controller current.1
      (gameTransition T controller current.1 envRound,
        T.automaton.step current.2
          {
            inputOne := envRound.inputOne
            inputTwo := envRound.inputTwo
            graph := envRound.graph
            outputOne := output.1
            outputTwo := output.2
          }) := by
  rfl

/--
A repeated combined epoch/DPA state makes the whole combined stream periodic
from that point on.
-/
theorem gameAutomatonStateStream_loop_shift
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (start period : Nat)
    (hloop :
      gameAutomatonStateStream T initialBoundary controller environment
          (start + period) =
        gameAutomatonStateStream T initialBoundary controller environment
          start) :
    ∀ m : Nat,
      gameAutomatonStateStream T initialBoundary controller environment
          (start + period + m) =
        gameAutomatonStateStream T initialBoundary controller environment
          (start + m) := by
  intro m
  induction m with
  | zero =>
      simpa [Nat.add_assoc] using hloop
  | succ m ih =>
      have hleft :
          start + period + (m + 1) = (start + period + m) + 1 := by
        omega
      have hright : start + (m + 1) = (start + m) + 1 := by
        omega
      rw [hleft, hright]
      simp [ih]

/-- The finite epoch-game winning predicate induced by the transformer's DPA. -/
def gameWins
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T) : Prop :=
  T.automaton.Accepts (gameExecution T initialBoundary controller environment)

/--
The round-aware finite-game winning predicate.  For each fixed finite
environment code this is just the ordinary `gameWins` predicate for the
state-only controller obtained by feeding the round-aware controller the
environment move chosen at the current state.
-/
def roundAwareGameWins
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentCode T) : Prop :=
  gameWins T initialBoundary
    (roundAwareControllerAtEnvironment T controller environment)
    environment

/-- Round-aware game winning is exactly acceptance of the round-aware execution. -/
theorem roundAwareGameWins_iff_accepts
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentCode T) :
    roundAwareGameWins T initialBoundary controller environment ↔
      T.automaton.Accepts
        (roundAwareGameExecution T initialBoundary controller environment) := by
  unfold roundAwareGameWins gameWins
  rw [roundAwareGameExecution_eq_gameExecution]

/--
Transfer the epoch-game winning predicate from the transformer's automaton to a
language-equivalent DPA.
-/
theorem gameWins_iff_accepts_of_automaton_equiv
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hautomaton :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        T.automaton.Accepts word ↔ A.Accepts word) :
    gameWins T initialBoundary controller environment ↔
      A.Accepts (gameExecution T initialBoundary controller environment) := by
  unfold gameWins
  exact hautomaton _

/--
Transfer the round-aware winning predicate from the transformer's automaton to
a language-equivalent DPA.
-/
theorem roundAwareGameWins_iff_accepts_of_automaton_equiv
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hautomaton :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        T.automaton.Accepts word ↔ A.Accepts word) :
    roundAwareGameWins T initialBoundary controller environment ↔
      A.Accepts
        (roundAwareGameExecution T initialBoundary controller environment) := by
  rw [roundAwareGameWins_iff_accepts]
  exact hautomaton _

/--
The semantic completeness obligation for the epoch game, stated at the
finite-game execution boundary.

This is the shape supplied by the journal/rational-run construction: from any
real winning distributed strategy it builds a finite controller code whose
finite epoch-game executions are accepted for every finite environment code.
-/
def GameExecutionControllerComplete
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) : Prop :=
  ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
    (∀ env : EnvironmentSequence In₁ In₂, A.Accepts (execution σ env)) ->
      ∃ controller : ControllerCode T,
        ∀ environment : EnvironmentCode T,
          A.Accepts (gameExecution T initialBoundary controller environment)

/--
Round-aware semantic completeness boundary: every real winning distributed
strategy has a round-aware finite controller whose round-aware finite-game
executions satisfy the DPA objective for every finite environment code.
-/
def RoundAwareGameExecutionControllerComplete
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) : Prop :=
  ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
    (∀ env : EnvironmentSequence In₁ In₂, A.Accepts (execution σ env)) ->
      ∃ controller : RoundAwareControllerCode T,
        ∀ environment : EnvironmentCode T,
          A.Accepts
            (roundAwareGameExecution T initialBoundary controller environment)

/--
Round-aware matching controllers imply the round-aware semantic completeness
boundary.
-/
theorem roundAwareGameExecutionControllerComplete_of_matchingControllers
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hmatch :
      ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∃ controller : RoundAwareControllerCode T,
          ∀ environment : EnvironmentCode T,
            RoundAwareGameExecutionMatchesStrategyForEnvironment
              T initialBoundary controller environment σ) :
    RoundAwareGameExecutionControllerComplete T initialBoundary A := by
  intro σ hσ
  rcases hmatch σ with ⟨controller, hcontroller⟩
  refine ⟨controller, ?_⟩
  intro environment
  rw [roundAwareGameExecution_eq_execution_of_matchesStrategyForEnvironment
    T initialBoundary controller environment σ (hcontroller environment)]
  exact hσ
    (roundAwareEnvironmentSequenceOfGamePlay
      T initialBoundary controller environment)

/--
Finite-lambda state summaries imply the round-aware semantic completeness
boundary.

This is the lambda-side replacement for the too-strong `stateViewDecoders`
completeness premise.  The finite game state does not decode the whole local
view.  Instead, for every distributed strategy, a finite-lambda controller is
supplied whose outputs agree with that strategy whenever the finite summary
and fringe argument match the full local view, and the generated finite play
maintains exactly those finite matches.
-/
theorem roundAwareGameExecutionControllerComplete_of_lambdaFiniteViewStateDecoders
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (hcontrollers :
      ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∃ controller :
          RoundAwareLambdaControllerCode
            T historyOne historyTwo fringeOne fringeTwo,
          RoundAwareLambdaControllerStrategyMatchesFiniteViews
            T historyOne historyTwo fringeOne fringeTwo controller
            historyOfViewOne historyOfViewTwo
            fringeOfViewOne fringeOfViewTwo σ ∧
          ∀ environment : EnvironmentCode T,
            ∀ n : Nat,
              let env : EnvironmentSequence In₁ In₂ :=
                roundAwareEnvironmentSequenceOfGamePlay
                  T initialBoundary controller.1 environment
              let state :=
                roundAwareGameStateStream
                  T initialBoundary controller.1 environment n
              let envRound := environment state
              historyOne state envRound =
                  historyOfViewOne
                    (nextView Proc.one
                      (executionPrefix σ env n) (env n)) ∧
                fringeOne state envRound =
                  fringeOfViewOne
                    (nextView Proc.one
                      (executionPrefix σ env n) (env n)) ∧
                historyTwo state envRound =
                  historyOfViewTwo
                    (nextView Proc.two
                      (executionPrefix σ env n) (env n)) ∧
                fringeTwo state envRound =
                  fringeOfViewTwo
                    (nextView Proc.two
                      (executionPrefix σ env n) (env n))) :
    RoundAwareGameExecutionControllerComplete T initialBoundary A := by
  intro σ hσ
  rcases hcontrollers σ with ⟨controller, hmatchFinite, hstates⟩
  refine ⟨controller.1, ?_⟩
  intro environment
  have hmatch :
      RoundAwareGameExecutionMatchesStrategyForEnvironment
        T initialBoundary controller.1 environment σ := by
    intro n
    let env : EnvironmentSequence In₁ In₂ :=
      roundAwareEnvironmentSequenceOfGamePlay
        T initialBoundary controller.1 environment
    let state :=
      roundAwareGameStateStream
        T initialBoundary controller.1 environment n
    let envRound := environment state
    rcases hstates environment n with
      ⟨hhistoryOne, hfringeOne, hhistoryTwo, hfringeTwo⟩
    constructor
    · exact
        hmatchFinite.1 state envRound
          (nextView Proc.one (executionPrefix σ env n) (env n))
          hhistoryOne hfringeOne
    · exact
        hmatchFinite.2 state envRound
          (nextView Proc.two (executionPrefix σ env n) (env n))
          hhistoryTwo hfringeTwo
  rw [roundAwareGameExecution_eq_execution_of_matchesStrategyForEnvironment
    T initialBoundary controller.1 environment σ hmatch]
  exact hσ
    (roundAwareEnvironmentSequenceOfGamePlay
      T initialBoundary controller.1 environment)

/--
The game-completeness boundary follows from the standard simulation direction:
translate each distributed strategy into a finite controller whose finite-game
executions are all real executions of the original strategy.
-/
theorem gameExecutionControllerComplete_of_controllerSimulation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hsimulate :
      ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∃ controller : ControllerCode T,
          GameExecutionControllerSimulatesStrategy
            T initialBoundary controller σ) :
    GameExecutionControllerComplete T initialBoundary A := by
  intro σ hσ
  rcases hsimulate σ with ⟨controller, hcontroller⟩
  refine ⟨controller, ?_⟩
  intro environment
  rcases hcontroller environment with ⟨env, hword⟩
  rw [hword]
  exact hσ env

/--
The game-completeness boundary also follows from the more operational
matching-controller construction.
-/
theorem gameExecutionControllerComplete_of_matchingControllers
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hmatch :
      GameExecutionStrategiesHaveMatchingControllers T initialBoundary) :
    GameExecutionControllerComplete T initialBoundary A :=
  gameExecutionControllerComplete_of_controllerSimulation
    T initialBoundary A
    (gameExecutionControllerSimulation_of_matchingControllers
      T initialBoundary hmatch)

/--
Finite-game execution completeness is invariant under replacing the DPA
objective by a language-equivalent one.
-/
theorem gameExecutionControllerComplete_transferLanguage
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    {A B : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (hcomplete : GameExecutionControllerComplete T initialBoundary A)
    (sameLanguage :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        B.Accepts word ↔ A.Accepts word) :
    GameExecutionControllerComplete T initialBoundary B := by
  intro σ hσ
  rcases hcomplete σ
      (fun env => (sameLanguage (execution σ env)).mp (hσ env)) with
    ⟨controller, hcontroller⟩
  exact
    ⟨controller, fun environment =>
      (sameLanguage (gameExecution T initialBoundary controller environment)).mpr
        (hcontroller environment)⟩

/--
A finite-game-execution completeness proof for a language-equivalent DPA
immediately gives the `complete` field expected by
`EpochGameAbstractionCertificate.ofTransformer`.
-/
theorem complete_of_gameExecutionControllerComplete
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hautomaton :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        T.automaton.Accepts word ↔ A.Accepts word)
    (hcomplete : GameExecutionControllerComplete T initialBoundary A) :
    ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      (∀ env : EnvironmentSequence In₁ In₂, A.Accepts (execution σ env)) ->
        ∃ controller : ControllerCode T,
          ∀ environment : EnvironmentCode T,
            gameWins T initialBoundary controller environment := by
  intro σ hσ
  rcases hcomplete σ hσ with ⟨controller, hcontroller⟩
  exact
    ⟨controller, fun environment =>
      (gameWins_iff_accepts_of_automaton_equiv
        T initialBoundary controller environment A hautomaton).mpr
        (hcontroller environment)⟩

/--
If every compatible decoded execution is represented by a finite environment
code, then winning against all finite environment codes proves the compatible
decoded-controller soundness boundary.
-/
theorem compatibleDecodedControllerSound_of_gameWins_and_representable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hautomaton :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        T.automaton.Accepts word ↔ A.Accepts word)
    (hwins :
      ∀ environment : EnvironmentCode T,
        gameWins T initialBoundary controller environment)
    (hrepresentable :
      CompatibleDecodedExecutionRepresentable T initialBoundary controller) :
    CompatibleDecodedControllerSound T initialBoundary controller A := by
  intro env word hcompatible
  rcases hrepresentable env word hcompatible with ⟨environment, hword⟩
  apply (hautomaton word).mp
  rw [← hword]
  exact hwins environment

/--
Finite-game winning plus synchronized decoded state choices gives the decoded
controller soundness boundary directly.

This is the soundness half of the synchronized-choice route, with the
representability bridge folded in.
-/
theorem compatibleDecodedControllerSound_of_gameWins_and_synchronizedStateChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hautomaton :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        T.automaton.Accepts word ↔ A.Accepts word)
    (hwins :
      ∀ environment : EnvironmentCode T,
        gameWins T initialBoundary controller environment)
    (hsync :
      ∀ (env : EnvironmentSequence In₁ In₂)
        (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          CompatibleDecodedExecution T initialBoundary controller env word ->
            ∃ stateStream : Nat -> GameState T,
              CompatibleDecodedExecutionSynchronizedStateChoices
                T initialBoundary controller env word stateStream) :
    CompatibleDecodedControllerSound T initialBoundary controller A :=
  compatibleDecodedControllerSound_of_gameWins_and_representable
    T initialBoundary controller A hautomaton hwins
    (compatibleDecodedExecutionRepresentable_of_synchronizedStateChoices
      T initialBoundary controller hsync)

/--
If winning all finite environment codes implies compatible-execution soundness,
then it gives exactly the ordinary `sound` field expected by
`EpochGameAbstractionCertificate.ofTransformer` for the decoded controller.
-/
theorem controllerStrategyOf_sound_of_gameWins_compatibleDecodedControllerSound
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (GameState T)]
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hbridge :
      (∀ environment : EnvironmentCode T,
        gameWins T initialBoundary controller environment) ->
        CompatibleDecodedControllerSound T initialBoundary controller A) :
    (∀ environment : EnvironmentCode T,
      gameWins T initialBoundary controller environment) ->
      ∀ env : EnvironmentSequence In₁ In₂,
        A.Accepts
          (execution (controllerStrategyOf T initialBoundary controller) env) := by
  intro hwins
  exact
    controllerStrategyOf_sound_of_compatibleDecodedControllerSound
      T initialBoundary controller A (hbridge hwins)

/--
Finite recurring-priority criterion for the epoch-game winning predicate.

Once a finite-state analysis of `gameStateStream` supplies a finite set of
priorities that are exactly the eventual recurring priorities, `gameWins`
reduces to checking whether the minimum of that set is even.
-/
theorem gameWins_iff_eventual_recurring_finset_min_even
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (recurring : Finset Nat)
    (hrecurringNonempty : recurring.Nonempty)
    (heventual :
      ∃ N : Nat,
        ∀ k : Nat,
          N ≤ k ->
            T.automaton.priority
              (T.automaton.run
                (gameExecution T initialBoundary controller environment) k) ∈
              recurring)
    (hfrequent :
      ∀ p : Nat,
        p ∈ recurring ->
          T.automaton.PrioritySeenInfinitelyOften
            (gameExecution T initialBoundary controller environment) p) :
    gameWins T initialBoundary controller environment ↔
      DetParityAutomaton.NatEven (recurring.min' hrecurringNonempty) := by
  exact
    T.automaton.acceptsFrom_iff_eventual_recurring_finset_min_even
      T.automaton.initial
      (gameExecution T initialBoundary controller environment)
      recurring hrecurringNonempty heventual hfrequent

/--
Cycle-priority criterion for finite epoch-game executions.

After the finite transition graph analysis has found a non-empty eventual
cycle, it is enough to show that every later automaton priority is one of the
cycle priorities and that each cycle priority recurs infinitely often.  The
finite game outcome is then parity of the least cycle priority.
-/
theorem gameWins_iff_eventual_cycle_priority_min_even
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (hcover :
      ∀ k : Nat,
        start ≤ k ->
          ∃ i : Nat,
            i < period ∧
              T.automaton.priority
                (T.automaton.run
                  (gameExecution T initialBoundary controller environment) k) =
                T.automaton.priority
                  (T.automaton.run
                    (gameExecution T initialBoundary controller environment)
                    (start + i)))
    (hcycleFrequent :
      ∀ i : Nat,
        i < period ->
          T.automaton.PrioritySeenInfinitelyOften
            (gameExecution T initialBoundary controller environment)
            (T.automaton.priority
              (T.automaton.run
                (gameExecution T initialBoundary controller environment)
                (start + i)))) :
    gameWins T initialBoundary controller environment ↔
      DetParityAutomaton.NatEven
        (((Finset.range period).image
          (fun i : Nat =>
            T.automaton.priority
              (T.automaton.run
                (gameExecution T initialBoundary controller environment)
                (start + i)))).min'
            (Finset.image_nonempty.mpr
              (Finset.nonempty_range_iff.mpr (Nat.ne_of_gt hperiodPositive)))) := by
  exact
    T.automaton.acceptsFrom_iff_eventual_cycle_priority_min_even
      T.automaton.initial
      (gameExecution T initialBoundary controller environment)
      start period hperiodPositive hcover hcycleFrequent

/--
Cycle-priority criterion for finite epoch-game executions with an explicit
periodicity proof.

This is the form expected from a concrete finite transition-graph loop:
coverage identifies the cycle-window priorities as the eventual priority set,
and periodicity proves each of those priorities recurs forever.
-/
theorem gameWins_iff_eventual_periodic_cycle_priority_min_even
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T)
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (hcover :
      ∀ k : Nat,
        start ≤ k ->
          ∃ i : Nat,
            i < period ∧
              T.automaton.priority
                (T.automaton.run
                  (gameExecution T initialBoundary controller environment) k) =
                T.automaton.priority
                  (T.automaton.run
                    (gameExecution T initialBoundary controller environment)
                    (start + i)))
    (hperiodic :
      ∀ i n : Nat,
        i < period ->
          T.automaton.priority
            (T.automaton.run
              (gameExecution T initialBoundary controller environment)
              (start + i + n * period)) =
            T.automaton.priority
              (T.automaton.run
                (gameExecution T initialBoundary controller environment)
                (start + i))) :
    gameWins T initialBoundary controller environment ↔
      DetParityAutomaton.NatEven
        (((Finset.range period).image
          (fun i : Nat =>
            T.automaton.priority
              (T.automaton.run
                (gameExecution T initialBoundary controller environment)
                (start + i)))).min'
            (Finset.image_nonempty.mpr
              (Finset.nonempty_range_iff.mpr (Nat.ne_of_gt hperiodPositive)))) := by
  exact
    T.automaton.acceptsFrom_iff_eventual_periodic_cycle_priority_min_even
      T.automaton.initial
      (gameExecution T initialBoundary controller environment)
      start period hperiodPositive hcover hperiodic

/--
A concrete finite-loop certificate for the DPA priorities generated by an
epoch-game controller/environment pair.

This is the intended output of the finite transition-graph analysis: `start`
and `period` identify a non-empty eventual cycle, `cover` says every later
priority is represented in that cycle window, and `periodic` says the cycle
window priorities repeat forever.
-/
structure PriorityLoopCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T) where
  start : Nat
  period : Nat
  period_pos : 0 < period
  cover :
    ∀ k : Nat,
      start ≤ k ->
        ∃ i : Nat,
          i < period ∧
            T.automaton.priority
              (T.automaton.run
                (gameExecution T initialBoundary controller environment) k) =
              T.automaton.priority
                (T.automaton.run
                  (gameExecution T initialBoundary controller environment)
                  (start + i))
  periodic :
    ∀ i n : Nat,
      i < period ->
        T.automaton.priority
          (T.automaton.run
            (gameExecution T initialBoundary controller environment)
            (start + i + n * period)) =
          T.automaton.priority
            (T.automaton.run
              (gameExecution T initialBoundary controller environment)
              (start + i))

namespace PriorityLoopCertificate

/-- The finite set of priorities occurring in the certified cycle window. -/
def cyclePriorities
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    {initialBoundary : T.boundary}
    {controller : ControllerCode T}
    {environment : EnvironmentCode T}
    (cert :
      PriorityLoopCertificate T initialBoundary controller environment) :
    Finset Nat :=
  (Finset.range cert.period).image
    (fun i : Nat =>
      T.automaton.priority
        (T.automaton.run
          (gameExecution T initialBoundary controller environment)
          (cert.start + i)))

/-- The certified cycle-priority set is non-empty. -/
theorem cyclePriorities_nonempty
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    {initialBoundary : T.boundary}
    {controller : ControllerCode T}
    {environment : EnvironmentCode T}
    (cert :
      PriorityLoopCertificate T initialBoundary controller environment) :
    cert.cyclePriorities.Nonempty :=
  Finset.image_nonempty.mpr
    (Finset.nonempty_range_iff.mpr (Nat.ne_of_gt cert.period_pos))

/-- The finite parity outcome computed from the certified cycle. -/
def cycleMinEven
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    {initialBoundary : T.boundary}
    {controller : ControllerCode T}
    {environment : EnvironmentCode T}
    (cert :
      PriorityLoopCertificate T initialBoundary controller environment) :
    Prop :=
  DetParityAutomaton.NatEven
    (cert.cyclePriorities.min' cert.cyclePriorities_nonempty)

/--
A loop certificate decides the epoch-game winning predicate by the parity of
the least certified cycle priority.
-/
theorem gameWins_iff
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    {initialBoundary : T.boundary}
    {controller : ControllerCode T}
    {environment : EnvironmentCode T}
    (cert :
      PriorityLoopCertificate T initialBoundary controller environment) :
    gameWins T initialBoundary controller environment ↔ cert.cycleMinEven := by
  change
    gameWins T initialBoundary controller environment ↔
      DetParityAutomaton.NatEven
        (((Finset.range cert.period).image
          (fun i : Nat =>
            T.automaton.priority
              (T.automaton.run
                (gameExecution T initialBoundary controller environment)
                (cert.start + i)))).min'
            (Finset.image_nonempty.mpr
              (Finset.nonempty_range_iff.mpr
                (Nat.ne_of_gt cert.period_pos))))
  exact
    gameWins_iff_eventual_periodic_cycle_priority_min_even
      T initialBoundary controller environment
      cert.start cert.period cert.period_pos cert.cover cert.periodic

/-- A concrete loop certificate supplies a decidable finite-game outcome. -/
noncomputable def gameWinsDecidable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    {initialBoundary : T.boundary}
    {controller : ControllerCode T}
    {environment : EnvironmentCode T}
    (cert :
      PriorityLoopCertificate T initialBoundary controller environment) :
    Decidable (gameWins T initialBoundary controller environment) := by
  classical
  exact decidable_of_iff cert.cycleMinEven cert.gameWins_iff.symm

end PriorityLoopCertificate

/--
A loop certificate at the actual finite graph level: the pair consisting of
the epoch-game state and the DPA run state repeats after `period` steps.

This is the certificate a finite-state loop search should produce.  The
priority-level loop certificate above is derived from it.
-/
structure StateLoopCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T) where
  start : Nat
  period : Nat
  period_pos : 0 < period
  loop_eq :
    gameAutomatonStateStream T initialBoundary controller environment
        (start + period) =
      gameAutomatonStateStream T initialBoundary controller environment start

namespace StateLoopCertificate

/-- A combined-state loop repeats every cycle from the loop start. -/
theorem state_periodic
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    {initialBoundary : T.boundary}
    {controller : ControllerCode T}
    {environment : EnvironmentCode T}
    (cert :
      StateLoopCertificate T initialBoundary controller environment)
    (i n : Nat) :
    gameAutomatonStateStream T initialBoundary controller environment
        (cert.start + i + n * cert.period) =
      gameAutomatonStateStream T initialBoundary controller environment
        (cert.start + i) := by
  induction n with
  | zero =>
      simp
  | succ n ih =>
      have hshift :=
        gameAutomatonStateStream_loop_shift
          T initialBoundary controller environment
          cert.start cert.period cert.loop_eq
          (i + n * cert.period)
      have hleft :
          cert.start + i + (n + 1) * cert.period =
            cert.start + cert.period + (i + n * cert.period) := by
        rw [Nat.succ_mul]
        omega
      have hright :
          cert.start + (i + n * cert.period) =
            cert.start + i + n * cert.period := by
        omega
      rw [hleft, hshift, hright]
      exact ih

/-- The DPA priority is periodic along a certified combined-state loop. -/
theorem priority_periodic
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    {initialBoundary : T.boundary}
    {controller : ControllerCode T}
    {environment : EnvironmentCode T}
    (cert :
      StateLoopCertificate T initialBoundary controller environment)
    (i n : Nat) :
    T.automaton.priority
        (T.automaton.run
          (gameExecution T initialBoundary controller environment)
          (cert.start + i + n * cert.period)) =
      T.automaton.priority
        (T.automaton.run
          (gameExecution T initialBoundary controller environment)
          (cert.start + i)) := by
  have hstate := cert.state_periodic i n
  exact congrArg (fun state => T.automaton.priority state.2) hstate

/-- A combined-state loop yields the priority-loop certificate consumed by `gameWins`. -/
def toPriorityLoopCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    {initialBoundary : T.boundary}
    {controller : ControllerCode T}
    {environment : EnvironmentCode T}
    (cert :
      StateLoopCertificate T initialBoundary controller environment) :
    PriorityLoopCertificate T initialBoundary controller environment where
  start := cert.start
  period := cert.period
  period_pos := cert.period_pos
  cover := by
    intro k hk
    let d := k - cert.start
    let i := d % cert.period
    let n := d / cert.period
    refine ⟨i, Nat.mod_lt d cert.period_pos, ?_⟩
    have hdecomp : d = i + n * cert.period := by
      simpa [i, n, Nat.mul_comm] using
        (Nat.mod_add_div d cert.period).symm
    have hk_eq : k = cert.start + i + n * cert.period := by
      have hkstart : k = cert.start + d := by
        omega
      omega
    rw [hk_eq]
    exact cert.priority_periodic i n
  periodic := by
    intro i n _hi
    exact cert.priority_periodic i n

/-- A combined-state loop decides `gameWins` through its derived priority loop. -/
theorem gameWins_iff
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    {initialBoundary : T.boundary}
    {controller : ControllerCode T}
    {environment : EnvironmentCode T}
    (cert :
      StateLoopCertificate T initialBoundary controller environment) :
    gameWins T initialBoundary controller environment ↔
      cert.toPriorityLoopCertificate.cycleMinEven :=
  cert.toPriorityLoopCertificate.gameWins_iff

/-- A combined-state loop supplies a decidable finite-game outcome. -/
noncomputable def gameWinsDecidable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂}
    {initialBoundary : T.boundary}
    {controller : ControllerCode T}
    {environment : EnvironmentCode T}
    (cert :
      StateLoopCertificate T initialBoundary controller environment) :
    Decidable (gameWins T initialBoundary controller environment) :=
  cert.toPriorityLoopCertificate.gameWinsDecidable

end StateLoopCertificate

/--
Every fixed finite controller/environment play has a repeated combined
epoch/DPA state, hence a concrete state-loop certificate.
-/
theorem exists_stateLoopCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T) :
    Nonempty (StateLoopCertificate T initialBoundary controller environment) := by
  classical
  rcases gameState_fintype T with ⟨gameFinite⟩
  letI : Fintype (GameState T) := gameFinite
  letI : Fintype T.automaton.State := T.automaton.stateFinite
  let Combined := GameState T × T.automaton.State
  letI : Fintype Combined := inferInstance
  let stream : Nat -> Combined :=
    fun n => gameAutomatonStateStream T initialBoundary controller environment n
  let n := Fintype.card Combined
  have hcard : Fintype.card Combined < Fintype.card (Fin (n + 1)) := by
    simp [n]
  obtain ⟨x, y, hxy, hEq⟩ :=
    Fintype.exists_ne_map_eq_of_card_lt
      (fun i : Fin (n + 1) => stream i.1) hcard
  have hval_ne : x.1 ≠ y.1 := by
    intro h
    exact hxy (Fin.ext h)
  rcases lt_or_gt_of_ne hval_ne with hlt | hgt
  · have hsum : x.1 + (y.1 - x.1) = y.1 :=
      Nat.add_sub_of_le (Nat.le_of_lt hlt)
    refine ⟨
      { start := x.1
        period := y.1 - x.1
        period_pos := Nat.sub_pos_of_lt hlt
        loop_eq := ?_ }⟩
    change stream (x.1 + (y.1 - x.1)) = stream x.1
    rw [hsum]
    exact hEq.symm
  · have hsum : y.1 + (x.1 - y.1) = x.1 :=
      Nat.add_sub_of_le (Nat.le_of_lt hgt)
    refine ⟨
      { start := y.1
        period := x.1 - y.1
        period_pos := Nat.sub_pos_of_lt hgt
        loop_eq := ?_ }⟩
    change stream (y.1 + (x.1 - y.1)) = stream y.1
    rw [hsum]
    exact hEq

/-- Choose the finite-state loop certificate for a fixed controller/environment play. -/
noncomputable def stateLoopCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T) :
    StateLoopCertificate T initialBoundary controller environment :=
  Classical.choice
    (exists_stateLoopCertificate T initialBoundary controller environment)

/--
For fixed finite controller/environment codes, the DPA objective compiled to
the epoch game is decidable because the finite combined state graph must loop.
-/
noncomputable def gameWinsDecidableByStateLoop
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : ControllerCode T)
    (environment : EnvironmentCode T) :
    Decidable (gameWins T initialBoundary controller environment) :=
  (stateLoopCertificate T initialBoundary controller environment).gameWinsDecidable

/--
Round-aware finite-game winning is decidable by specializing the round-aware
controller to the fixed finite environment code and reusing the ordinary
combined epoch/DPA state loop.
-/
noncomputable def roundAwareGameWinsDecidableByStateLoop
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (environment : EnvironmentCode T) :
    Decidable (roundAwareGameWins T initialBoundary controller environment) :=
  gameWinsDecidableByStateLoop T initialBoundary
    (roundAwareControllerAtEnvironment T controller environment)
    environment

/--
A round-aware finite-game-execution completeness proof gives the `complete`
field expected by the round-aware epoch abstraction certificate.
-/
theorem complete_of_roundAwareGameExecutionControllerComplete
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hautomaton :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        T.automaton.Accepts word ↔ A.Accepts word)
    (hcomplete : RoundAwareGameExecutionControllerComplete T initialBoundary A) :
    ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      (∀ env : EnvironmentSequence In₁ In₂, A.Accepts (execution σ env)) ->
        ∃ controller : RoundAwareControllerCode T,
          ∀ environment : EnvironmentCode T,
            roundAwareGameWins T initialBoundary controller environment := by
  intro σ hσ
  rcases hcomplete σ hσ with ⟨controller, hcontroller⟩
  exact
    ⟨controller, fun environment =>
      (roundAwareGameWins_iff_accepts_of_automaton_equiv
        T initialBoundary controller environment A hautomaton).mpr
        (hcontroller environment)⟩

/--
Representability of the real executions decoded from a round-aware finite
controller.

For every real environment sequence, the execution of the decoded distributed
strategy must coincide with some finite-environment-code play of the same
round-aware finite controller.
-/
def RoundAwareControllerExecutionRepresentable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) : Prop :=
  ∀ env : EnvironmentSequence In₁ In₂,
    ∃ environment : EnvironmentCode T,
      roundAwareGameExecution T initialBoundary controller environment =
        execution σ env

/--
Decoded environment-code representability plus pointwise decoded-view strategy
agreement implies execution representability.
-/
theorem roundAwareControllerExecutionRepresentable_of_decodedEnvironmentRepresentable_and_matchesDecodedViews
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (hmatchViews :
      RoundAwareLocalControllerStrategyMatchesDecodedViews
        T viewOne viewTwo controller σ)
    (hdecoded :
      RoundAwareLocalControllerDecodedEnvironmentRepresentable
        T initialBoundary viewOne viewTwo controller σ) :
    RoundAwareControllerExecutionRepresentable
      T initialBoundary controller.1 σ := by
  intro env
  rcases hdecoded env with ⟨environment, henv, hviews⟩
  refine ⟨environment, ?_⟩
  have hmatch :
      RoundAwareGameExecutionMatchesStrategyForEnvironment
        T initialBoundary controller.1 environment σ := by
    intro n
    let env' :=
      roundAwareEnvironmentSequenceOfGamePlay
        T initialBoundary controller.1 environment
    let state :=
      roundAwareGameStateStream
        T initialBoundary controller.1 environment n
    let envRound := environment state
    have henv_n : env' n = env n := congrFun henv n
    have hprefix :
        executionPrefix σ env' n = executionPrefix σ env n := by
      change
        executionPrefix σ
            (roundAwareEnvironmentSequenceOfGamePlay
              T initialBoundary controller.1 environment) n =
          executionPrefix σ env n
      rw [henv]
    have hview := hviews n
    have hout := hmatchViews state envRound
    constructor
    · change
        (controller.1 state envRound).1 =
          σ.one (nextView Proc.one (executionPrefix σ env' n) (env' n))
      rw [hout.1, henv_n, hprefix, ← hview.1]
    · change
        (controller.1 state envRound).2 =
          σ.two (nextView Proc.two (executionPrefix σ env' n) (env' n))
      rw [hout.2, henv_n, hprefix, ← hview.2]
  rw [roundAwareGameExecution_eq_execution_of_matchesStrategyForEnvironment
    T initialBoundary controller.1 environment σ hmatch]
  rw [henv]

/--
Decoded environment-code representability implies execution representability
for the distributed strategy induced by a locally observable controller.
-/
theorem roundAwareControllerExecutionRepresentable_of_decodedEnvironmentRepresentable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (hdecoded :
      RoundAwareLocalControllerDecodedEnvironmentRepresentable
        T initialBoundary viewOne viewTwo controller
        (strategyOfRoundAwareLocalController
          T viewOne viewTwo controller defaultOne defaultTwo)) :
    RoundAwareControllerExecutionRepresentable
      T initialBoundary controller.1
      (strategyOfRoundAwareLocalController
        T viewOne viewTwo controller defaultOne defaultTwo) := by
  intro env
  let σ :=
    strategyOfRoundAwareLocalController
      T viewOne viewTwo controller defaultOne defaultTwo
  rcases hdecoded env with ⟨environment, henv, hviews⟩
  refine ⟨environment, ?_⟩
  have hmatch :
      RoundAwareGameExecutionMatchesStrategyForEnvironment
        T initialBoundary controller.1 environment σ := by
    intro n
    let env' :=
      roundAwareEnvironmentSequenceOfGamePlay
        T initialBoundary controller.1 environment
    let state :=
      roundAwareGameStateStream
        T initialBoundary controller.1 environment n
    let envRound := environment state
    have henv_n : env' n = env n := congrFun henv n
    have hprefix :
        executionPrefix σ env' n = executionPrefix σ env n := by
      change
        executionPrefix σ
            (roundAwareEnvironmentSequenceOfGamePlay
              T initialBoundary controller.1 environment) n =
          executionPrefix σ env n
      rw [henv]
    have hview := hviews n
    constructor
    · change
        (controller.1 state envRound).1 =
          σ.one (nextView Proc.one (executionPrefix σ env' n) (env' n))
      rw [henv_n, hprefix, ← hview.1]
      exact
        (strategyOneOfRoundAwareLocalController_apply_decoded
          T viewOne viewTwo controller defaultOne state envRound).symm
    · change
        (controller.1 state envRound).2 =
          σ.two (nextView Proc.two (executionPrefix σ env' n) (env' n))
      rw [henv_n, hprefix, ← hview.2]
      exact
        (strategyTwoOfRoundAwareLocalController_apply_decoded
          T viewOne viewTwo controller defaultTwo state envRound).symm
  rw [roundAwareGameExecution_eq_execution_of_matchesStrategyForEnvironment
    T initialBoundary controller.1 environment σ hmatch]
  rw [henv]

/--
Any representable round-aware controller is locally observable at the first
process-1 output: two first-round environment moves that produce the same
process-1 local view must force the same process-1 output from the initial
finite state.
-/
theorem roundAwareControllerExecutionRepresentable_initial_one_output_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (hrepresentable :
      RoundAwareControllerExecutionRepresentable
        T initialBoundary controller σ)
    (envA envB : EnvironmentRound In₁ In₂)
    (hview :
      nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envA =
        nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envB) :
    (controller (Sum.inl initialBoundary) envA).1 =
      (controller (Sum.inl initialBoundary) envB).1 := by
  let envSeqA : EnvironmentSequence In₁ In₂ := fun _ => envA
  let envSeqB : EnvironmentSequence In₁ In₂ := fun _ => envB
  rcases hrepresentable envSeqA with ⟨environmentA, hwordA⟩
  rcases hrepresentable envSeqB with ⟨environmentB, hwordB⟩
  have hA0 := congrFun hwordA 0
  have hB0 := congrFun hwordB 0
  simp [roundAwareGameExecution, execution_apply, nextRound, envSeqA] at hA0
  simp [roundAwareGameExecution, execution_apply, nextRound, envSeqB] at hB0
  have hEnvA :
      environmentA (Sum.inl initialBoundary) = envA := by
    cases hEA : environmentA (Sum.inl initialBoundary)
    cases envA
    simp [hEA] at hA0 ⊢
    exact ⟨hA0.1, hA0.2.1, hA0.2.2.1⟩
  have hEnvB :
      environmentB (Sum.inl initialBoundary) = envB := by
    cases hEB : environmentB (Sum.inl initialBoundary)
    cases envB
    simp [hEB] at hB0 ⊢
    exact ⟨hB0.1, hB0.2.1, hB0.2.2.1⟩
  have hOutA :
      (controller (Sum.inl initialBoundary) envA).1 =
        σ.one (nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envA) := by
    have hout := hA0.2.2.2.1
    simpa [hEnvA] using hout
  have hOutB :
      (controller (Sum.inl initialBoundary) envB).1 =
        σ.one (nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envB) := by
    have hout := hB0.2.2.2.1
    simpa [hEnvB] using hout
  calc
    (controller (Sum.inl initialBoundary) envA).1 =
        σ.one (nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envA) := hOutA
    _ =
        σ.one (nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envB) := by
          rw [hview]
    _ = (controller (Sum.inl initialBoundary) envB).1 := hOutB.symm

/-- Process-2 version of `roundAwareControllerExecutionRepresentable_initial_one_output_eq`. -/
theorem roundAwareControllerExecutionRepresentable_initial_two_output_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (hrepresentable :
      RoundAwareControllerExecutionRepresentable
        T initialBoundary controller σ)
    (envA envB : EnvironmentRound In₁ In₂)
    (hview :
      nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envA =
        nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envB) :
    (controller (Sum.inl initialBoundary) envA).2 =
      (controller (Sum.inl initialBoundary) envB).2 := by
  let envSeqA : EnvironmentSequence In₁ In₂ := fun _ => envA
  let envSeqB : EnvironmentSequence In₁ In₂ := fun _ => envB
  rcases hrepresentable envSeqA with ⟨environmentA, hwordA⟩
  rcases hrepresentable envSeqB with ⟨environmentB, hwordB⟩
  have hA0 := congrFun hwordA 0
  have hB0 := congrFun hwordB 0
  simp [roundAwareGameExecution, execution_apply, nextRound, envSeqA] at hA0
  simp [roundAwareGameExecution, execution_apply, nextRound, envSeqB] at hB0
  have hEnvA :
      environmentA (Sum.inl initialBoundary) = envA := by
    cases hEA : environmentA (Sum.inl initialBoundary)
    cases envA
    simp [hEA] at hA0 ⊢
    exact ⟨hA0.1, hA0.2.1, hA0.2.2.1⟩
  have hEnvB :
      environmentB (Sum.inl initialBoundary) = envB := by
    cases hEB : environmentB (Sum.inl initialBoundary)
    cases envB
    simp [hEB] at hB0 ⊢
    exact ⟨hB0.1, hB0.2.1, hB0.2.2.1⟩
  have hOutA :
      (controller (Sum.inl initialBoundary) envA).2 =
        σ.two (nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envA) := by
    have hout := hA0.2.2.2.2
    simpa [hEnvA] using hout
  have hOutB :
      (controller (Sum.inl initialBoundary) envB).2 =
        σ.two (nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envB) := by
    have hout := hB0.2.2.2.2
    simpa [hEnvB] using hout
  calc
    (controller (Sum.inl initialBoundary) envA).2 =
        σ.two (nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envA) := hOutA
    _ =
        σ.two (nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envB) := by
          rw [hview]
    _ = (controller (Sum.inl initialBoundary) envB).2 := hOutB.symm

/--
If the initial process-1 output distinguishes `.left` from `.both` while the
process-1 first-round view is the same, no distributed strategy can represent
that round-aware finite controller.
-/
theorem not_roundAwareControllerExecutionRepresentable_of_initial_one_left_both_output_ne
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (inputOne : In₁)
    (inputTwo : In₂)
    (hne :
      (controller (Sum.inl initialBoundary)
          { inputOne := inputOne, inputTwo := inputTwo, graph := Graph.left }).1 ≠
        (controller (Sum.inl initialBoundary)
          { inputOne := inputOne, inputTwo := inputTwo, graph := Graph.both }).1) :
    ¬ ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      RoundAwareControllerExecutionRepresentable
        T initialBoundary controller σ := by
  intro h
  rcases h with ⟨σ, hrepresentable⟩
  exact hne
    (roundAwareControllerExecutionRepresentable_initial_one_output_eq
      T initialBoundary controller σ hrepresentable
      { inputOne := inputOne, inputTwo := inputTwo, graph := Graph.left }
      { inputOne := inputOne, inputTwo := inputTwo, graph := Graph.both }
      (by simp [nextView, advanceViewsWithEnvironment]))

