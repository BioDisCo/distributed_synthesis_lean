/--
Round-aware finite-game winning plus execution representability gives the
semantic soundness field required by the finite-game certificate.
-/
theorem roundAwareControllerSound_of_gameWins_and_representable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hautomaton :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        T.automaton.Accepts word ↔ A.Accepts word)
    (hwins :
      ∀ environment : EnvironmentCode T,
        roundAwareGameWins T initialBoundary controller environment)
    (hrepresentable :
      RoundAwareControllerExecutionRepresentable
        T initialBoundary controller σ) :
    ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution σ env) := by
  intro env
  rcases hrepresentable env with ⟨environment, hword⟩
  have hacc :
      A.Accepts
        (roundAwareGameExecution T initialBoundary controller environment) :=
    (roundAwareGameWins_iff_accepts_of_automaton_equiv
      T initialBoundary controller environment A hautomaton).mp
      (hwins environment)
  rw [← hword]
  exact hacc

/--
Contrapositive soundness boundary for round-aware finite games.

Instead of requiring every real environment sequence to be replayed exactly by
a finite memoryless environment code, it is enough to reflect every real
counterexample to a finite environment code that also loses the finite game.
This is the shape supplied by a finite-retraction/memoryless-spoiler argument.
-/
def RoundAwareControllerCounterexamplesReflectedByEnvironmentCode
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) :
    Prop :=
  ∀ env : EnvironmentSequence In₁ In₂,
    ¬ A.Accepts (execution σ env) ->
      ∃ environment : EnvironmentCode T,
        ¬ roundAwareGameWins T initialBoundary controller environment

theorem roundAwareControllerSound_of_gameWins_and_counterexamplesReflected
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hwins :
      ∀ environment : EnvironmentCode T,
        roundAwareGameWins T initialBoundary controller environment)
    (hreflect :
      RoundAwareControllerCounterexamplesReflectedByEnvironmentCode
        T initialBoundary controller σ A) :
    ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution σ env) := by
  intro env
  by_contra hbad
  rcases hreflect env hbad with ⟨environment, hlose⟩
  exact hlose (hwins environment)

/--
Compatible losing executions are reflected by finite environment codes.

This is the finite-retraction/memoryless-spoiler obligation for the local
round-aware controller interface.
-/
def RoundAwareLocalControllerCompatibleCounterexamplesReflectedByEnvironmentCode
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) :
    Prop :=
  ∀ (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
      RoundAwareLocalControllerCompatibleDecodedExecution
        T viewOne viewTwo controller σ env word ->
        ¬ A.Accepts word ->
          ∃ environment : EnvironmentCode T,
            ¬ roundAwareGameWins T initialBoundary controller.1 environment

/--
Compatible losing executions are reflected by finite environment codes whose
generated plays are rejected by the DPA objective.

This is the Lean boundary matching the enriched-lasso proof: the lasso need not
replay the rejected compatible word exactly.  It only has to produce some
finite environment code whose round-aware finite-game execution is rejected by
the same deterministic parity automaton.
-/
def RoundAwareLocalControllerCompatibleRejectedFiniteGamePlaysReflectedByEnvironmentCode
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) :
    Prop :=
  ∀ (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
      RoundAwareLocalControllerCompatibleDecodedExecution
        T viewOne viewTwo controller σ env word ->
        ¬ A.Accepts word ->
          ∃ environment : EnvironmentCode T,
            ¬ A.Accepts
              (roundAwareGameExecution T initialBoundary controller.1 environment)

/--
Enriched DPA-progress stream boundary for compatible rejected words.

For each compatible rejected decoded word, the upstream observer construction
must provide one finite-state source stream following the real environment
rounds, whose emitted round-aware word is the rejected word, and whose decoded
DPA component obeys the DPA transition equations.  The checked loop-erasure
producer below then turns such a stream into a rejected finite environment code.
-/
def RoundAwareLocalControllerCompatibleRejectedDPAProgressStateStreams
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (dpaOf : GameState T -> A.State) : Prop :=
  ∀ (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
      RoundAwareLocalControllerCompatibleDecodedExecution
        T viewOne viewTwo controller σ env word ->
      ¬ A.Accepts word ->
        ∃ sourceState : Nat -> GameState T,
          sourceState 0 = Sum.inl initialBoundary ∧
            (∀ n : Nat,
              sourceState (n + 1) =
                roundAwareGameTransition
                  T controller.1 (sourceState n) (env n)) ∧
              word =
                roundAwareWordOfStateStream
                  T controller.1 sourceState env ∧
                dpaOf (sourceState 0) = A.initial ∧
                  (∀ n : Nat,
                    dpaOf (sourceState (n + 1)) =
                      A.step (dpaOf (sourceState n))
                        (roundAwareWordOfStateStream
                          T controller.1 sourceState env n))

/--
Controller-uniform selected-lasso extraction implies the rejected finite-game
play reflection predicate consumed by the enriched backend route.

The remaining mathematical work is therefore concentrated in proving
`hselected`: from a compatible rejected decoded word, extract the finite
selected-lasso data record.
-/
theorem roundAwareLocalControllerCompatibleRejectedFiniteGamePlaysReflected_of_selected_lasso_cycleWitnessData
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (dpaOf : GameState T -> A.State)
    (hselected :
      ∀ (env : EnvironmentSequence In₁ In₂)
        (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          RoundAwareLocalControllerCompatibleDecodedExecution
            T viewOne viewTwo controller σ env word ->
          ¬ A.Accepts word ->
            Nonempty
              (RoundAwareSelectedLassoCycleWitnessData
                T initialBoundary controller.1 A dpaOf)) :
    RoundAwareLocalControllerCompatibleRejectedFiniteGamePlaysReflectedByEnvironmentCode
      T initialBoundary viewOne viewTwo controller σ A := by
  intro env word hcompatible hreject
  rcases hselected env word hcompatible hreject with ⟨data⟩
  exact
    exists_environmentCode_rejected_roundAwareGameExecution_of_selected_lasso_cycleWitnessData
      T initialBoundary controller.1 A dpaOf data

/--
Controller-uniform enriched DPA-progress streams imply rejected finite-game play
reflection.

This is the upstream boundary after the loop-erasure closure: callers no longer
provide selected lassos or loop-erasure certificates.  They provide the coherent
enriched stream for each compatible rejected word, and Lean performs recurrence,
loop erasure, selected-lasso assembly, and finite-code construction internally.
-/
theorem roundAwareLocalControllerCompatibleRejectedFiniteGamePlaysReflected_of_rejected_dpaProgress_stateStreams
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (dpaOf : GameState T -> A.State)
    [Fintype (GameState T)]
    (hstreams :
      RoundAwareLocalControllerCompatibleRejectedDPAProgressStateStreams
        T initialBoundary viewOne viewTwo controller σ A dpaOf) :
    RoundAwareLocalControllerCompatibleRejectedFiniteGamePlaysReflectedByEnvironmentCode
      T initialBoundary viewOne viewTwo controller σ A := by
  intro env word hcompatible hreject
  rcases hstreams env word hcompatible hreject with
    ⟨sourceState, hsourceInit, hsourceStep, hword,
      hdpaSourceInit, hdpaSourceStep⟩
  have hrejectStream :
      ¬ A.Accepts
        (roundAwareWordOfStateStream T controller.1 sourceState env) := by
    simpa [hword] using hreject
  exact
    exists_environmentCode_rejected_roundAwareGameExecution_of_rejected_dpaProgress_stateStream
      T initialBoundary controller.1 A sourceState env dpaOf
      hsourceInit hsourceStep hdpaSourceInit hdpaSourceStep hrejectStream

/--
A DPA-rejected finite-game play is a losing finite-game environment code.

This converts the enriched-lasso reflection target into the existing
counterexample-reflection interface consumed by the backend compilers.
-/
theorem roundAwareLocalControllerCompatibleCounterexamplesReflected_of_rejectedFiniteGamePlaysReflected
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hautomaton :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        T.automaton.Accepts word ↔ A.Accepts word)
    (hreflect :
      RoundAwareLocalControllerCompatibleRejectedFiniteGamePlaysReflectedByEnvironmentCode
        T initialBoundary viewOne viewTwo controller σ A) :
    RoundAwareLocalControllerCompatibleCounterexamplesReflectedByEnvironmentCode
      T initialBoundary viewOne viewTwo controller σ A := by
  intro env word hcompatible hreject
  rcases hreflect env word hcompatible hreject with
    ⟨environment, hrejectFinite⟩
  refine ⟨environment, ?_⟩
  intro hwins
  have haccT :
      T.automaton.Accepts
        (roundAwareGameExecution T initialBoundary controller.1 environment) :=
    (roundAwareGameWins_iff_accepts
      T initialBoundary controller.1 environment).mp hwins
  have haccA :
      A.Accepts
        (roundAwareGameExecution T initialBoundary controller.1 environment) :=
    (hautomaton
      (roundAwareGameExecution T initialBoundary controller.1 environment)).mp
      haccT
  exact hrejectFinite haccA

/--
It is enough to realize every losing compatible word as one finite round-aware
execution.  Language equivalence then turns rejection of the compatible word
into rejection of the finite-game play.
-/
theorem roundAwareLocalControllerCompatibleCounterexamplesReflected_of_rejectedCompatibleWordsRepresentable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hautomaton :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        T.automaton.Accepts word ↔ A.Accepts word)
    (hrepresentRejected :
      ∀ (env : EnvironmentSequence In₁ In₂)
        (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          RoundAwareLocalControllerCompatibleDecodedExecution
            T viewOne viewTwo controller σ env word ->
          ¬ A.Accepts word ->
            ∃ environment : EnvironmentCode T,
              roundAwareGameExecution T initialBoundary controller.1 environment =
                word) :
    RoundAwareLocalControllerCompatibleCounterexamplesReflectedByEnvironmentCode
      T initialBoundary viewOne viewTwo controller σ A := by
  intro env word hcompatible hreject
  rcases hrepresentRejected env word hcompatible hreject with
    ⟨environment, hword⟩
  refine ⟨environment, ?_⟩
  intro hwins
  have haccT :
      T.automaton.Accepts
        (roundAwareGameExecution T initialBoundary controller.1 environment) :=
    (roundAwareGameWins_iff_accepts
      T initialBoundary controller.1 environment).mp hwins
  have haccA : A.Accepts word := by
    rw [← hword]
    exact (hautomaton
      (roundAwareGameExecution T initialBoundary controller.1 environment)).mp
      haccT
  exact hreject haccA

/--
Synchronized lambda choices for a local round-aware compatible execution.

This is the concrete coherent finite-retraction invariant in the notation of
the journal paper: one abstract state stream carries the finite lambda-style
contingent action for the hidden current fringe bit, follows the real
environment moves, repeats only with the same next environment move, decodes
both local views, and produces the compatible word.  Local observability is the
indistinguishability guard: histories with the same non-fringe local view use
the same lambda, while the hidden arrow/receipt bit is applied only afterward.
-/
def RoundAwareLocalControllerCompatibleDecodedExecutionSynchronizedStateChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T) : Prop :=
  stateStream 0 = Sum.inl initialBoundary ∧
    (∀ n : Nat,
      stateStream (n + 1) =
        roundAwareGameTransition T controller.1 (stateStream n) (env n)) ∧
    (∀ i j : Nat, stateStream i = stateStream j -> env i = env j) ∧
    (∀ n : Nat,
      viewOne (stateStream n) (env n) =
          nextView Proc.one (executionPrefix σ env n) (env n) ∧
        viewTwo (stateStream n) (env n) =
          nextView Proc.two (executionPrefix σ env n) (env n) ∧
        word n =
          {
            inputOne := (env n).inputOne
            inputTwo := (env n).inputTwo
            graph := (env n).graph
            outputOne := (controller.1 (stateStream n) (env n)).1
            outputTwo := (controller.1 (stateStream n) (env n)).2
