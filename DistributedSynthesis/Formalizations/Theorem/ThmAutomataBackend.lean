/--
The accepted-tree side of the local-observable rotating target can be
rationalized by the regular-tree rational-run lemma.
-/
theorem rationalAccepted
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
