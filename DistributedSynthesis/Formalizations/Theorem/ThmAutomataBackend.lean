/--
Synchronized finite-lambda choices for a lambda-compatible execution.

The single state stream follows the round-aware finite transition, is
consistent enough to be turned into a memoryless finite environment code, and
at every position carries the finite summaries/fringe arguments for both
process local views.  This is the concrete state-stream invariant the
no-direct proof should supply for rejected lambda-compatible words.
-/
def RoundAwareLambdaControllerCompatibleExecutionSynchronizedStateChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T) : Prop :=
  stateStream 0 = Sum.inl initialBoundary ∧
    (∀ n : Nat,
      stateStream (n + 1) =
        roundAwareGameTransition T controller.1 (stateStream n) (env n)) ∧
    (∀ i j : Nat, stateStream i = stateStream j -> env i = env j) ∧
    (∀ n : Nat,
      historyOne (stateStream n) (env n) =
          historyOfViewOne
            (nextView Proc.one (executionPrefix σ env n) (env n)) ∧
        fringeOne (stateStream n) (env n) =
          fringeOfViewOne
            (nextView Proc.one (executionPrefix σ env n) (env n)) ∧
        historyTwo (stateStream n) (env n) =
          historyOfViewTwo
            (nextView Proc.two (executionPrefix σ env n) (env n)) ∧
        fringeTwo (stateStream n) (env n) =
          fringeOfViewTwo
            (nextView Proc.two (executionPrefix σ env n) (env n)) ∧
        word n =
          {
            inputOne := (env n).inputOne
            inputTwo := (env n).inputTwo
            graph := (env n).graph
            outputOne := (controller.1 (stateStream n) (env n)).1
            outputTwo := (controller.1 (stateStream n) (env n)).2
          })

