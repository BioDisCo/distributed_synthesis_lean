      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (hsync :
      RoundAwareLambdaControllerCompatibleExecutionSynchronizedStateChoices
        T initialBoundary historyOne historyTwo fringeOne fringeTwo controller
        historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
        σ env word stateStream) :
    RoundAwareLambdaControllerCompatibleExecution
      T historyOne historyTwo fringeOne fringeTwo controller
      historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
      σ env word := by
  intro n
  rcases hsync with ⟨_hinit, _hstep, _hconsistent, hchoice⟩
  exact
    ⟨stateStream n,
      (hchoice n).1,
      (hchoice n).2.1,
      stateStream n,
      (hchoice n).2.2.1,
      (hchoice n).2.2.2.1,
      (hchoice n).2.2.2.2⟩

/-- The environment move carried by a concrete omega-word round. -/
def environmentRoundOfWord
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (n : Nat) : EnvironmentRound In₁ In₂ :=
  {
    inputOne := (word n).inputOne
    inputTwo := (word n).inputTwo
    graph := (word n).graph
  }

/-- The environment sequence obtained by forgetting the outputs of a word. -/
def environmentSequenceOfWord
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)) :
    EnvironmentSequence In₁ In₂ :=
  fun n => environmentRoundOfWord word n

/--
In a compatible decoded local execution, the explicit environment sequence is
exactly the sequence of input/graph fields carried by the word.

Compatibility may choose separate finite witness states for the two outputs,
but the input fields of each word letter are fixed to be the supplied
environment round.
-/
theorem roundAwareLocalControllerCompatibleDecodedExecution_environmentRoundOfWord_eq_env
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hcompatible :
      RoundAwareLocalControllerCompatibleDecodedExecution
        T viewOne viewTwo controller σ env word) :
    ∀ n : Nat, environmentRoundOfWord word n = env n := by
  intro n
  rcases hcompatible n with
    ⟨stateOne, hviewOne, stateTwo, hviewTwo, hword⟩
  simp [environmentRoundOfWord, hword]

/--
For a candidate word, the non-fringe payloads and receipt tags of the two
next views at two prefix positions determine equality of the two environment
rounds.  This is the operational consistency fact used by the one-bit
`lambda` carrier: the hidden bit is the receipt tag, while the non-fringe
payload carries the current private inputs and the graph shape.
-/
theorem environmentRoundOfWord_eq_of_prefix_nextView_nonFringe_receiptTag_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (prefixFn : Nat -> History In₁ In₂ Graph Out₁ Out₂)
    (i j : Nat)
    (honeNonFringe :
      (nextView Proc.one (prefixFn i) (environmentRoundOfWord word i)).nonFringe =
        (nextView Proc.one (prefixFn j) (environmentRoundOfWord word j)).nonFringe)
    (honeReceipt :
      (nextView Proc.one (prefixFn i) (environmentRoundOfWord word i)).receiptTag =
        (nextView Proc.one (prefixFn j) (environmentRoundOfWord word j)).receiptTag)
    (htwoNonFringe :
      (nextView Proc.two (prefixFn i) (environmentRoundOfWord word i)).nonFringe =
        (nextView Proc.two (prefixFn j) (environmentRoundOfWord word j)).nonFringe)
    (htwoReceipt :
      (nextView Proc.two (prefixFn i) (environmentRoundOfWord word i)).receiptTag =
        (nextView Proc.two (prefixFn j) (environmentRoundOfWord word j)).receiptTag) :
    environmentRoundOfWord word i = environmentRoundOfWord word j :=
  environmentRound_eq_of_nextView_nonFringe_receiptTag_eq
    honeNonFringe honeReceipt htwoNonFringe htwoReceipt

/-- The finite history prefix of a concrete omega word. -/
def wordPrefix
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)) :
    Nat -> History In₁ In₂ Graph Out₁ Out₂
  | 0 => []
  | n + 1 => History.append (wordPrefix word n) (word n)

/--
Word-internal environment consistency implies consistency of the decoded
environment sequence for compatible decoded local executions.
-/
theorem roundAwareLocalControllerCompatibleDecodedExecution_prefixConsistent_of_environmentRoundOfWord
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (viewOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.one)
    (viewTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.two)
    (controller :
      RoundAwareLocalControllerCode
        uniform.noDirectEpochTransformer viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hcompatible :
      RoundAwareLocalControllerCompatibleDecodedExecution
        uniform.noDirectEpochTransformer viewOne viewTwo controller σ env word)
    (hwordConsistent :
      ∀ i j : Nat,
        uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word i) =
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word j) ->
        environmentRoundOfWord word i = environmentRoundOfWord word j) :
    ∀ i j : Nat,
      uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word i) =
        uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word j) ->
      env i = env j := by
  intro i j hstate
  have henvOfWord :=
    roundAwareLocalControllerCompatibleDecodedExecution_environmentRoundOfWord_eq_env
      uniform.noDirectEpochTransformer viewOne viewTwo controller σ env word
      hcompatible
  calc
    env i = environmentRoundOfWord word i := (henvOfWord i).symm
    _ = environmentRoundOfWord word j := hwordConsistent i j hstate
    _ = env j := henvOfWord j

/-- Prefix-specialized form of `environmentRoundOfWord_eq_of_prefix_nextView_nonFringe_receiptTag_eq`. -/
theorem environmentRoundOfWord_eq_of_wordPrefix_nextView_nonFringe_receiptTag_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (i j : Nat)
    (honeNonFringe :
      (nextView Proc.one (wordPrefix word i) (environmentRoundOfWord word i)).nonFringe =
        (nextView Proc.one (wordPrefix word j) (environmentRoundOfWord word j)).nonFringe)
    (honeReceipt :
      (nextView Proc.one (wordPrefix word i) (environmentRoundOfWord word i)).receiptTag =
        (nextView Proc.one (wordPrefix word j) (environmentRoundOfWord word j)).receiptTag)
    (htwoNonFringe :
      (nextView Proc.two (wordPrefix word i) (environmentRoundOfWord word i)).nonFringe =
        (nextView Proc.two (wordPrefix word j) (environmentRoundOfWord word j)).nonFringe)
    (htwoReceipt :
      (nextView Proc.two (wordPrefix word i) (environmentRoundOfWord word i)).receiptTag =
        (nextView Proc.two (wordPrefix word j) (environmentRoundOfWord word j)).receiptTag) :
    environmentRoundOfWord word i = environmentRoundOfWord word j :=
  environmentRoundOfWord_eq_of_prefix_nextView_nonFringe_receiptTag_eq
    word (wordPrefix word) i j
    honeNonFringe honeReceipt htwoNonFringe htwoReceipt

/--
For the concrete `lambda` carrier whose finite history component is the
current non-fringe view and whose fringe component is the current receipt tag,
stable tracked data on equal prefix states implies the repeat-consistency
condition required by the rejected self-compatible replay theorem.

This isolates the remaining epoch-relative content: prove that equality of
the no-direct prefix states preserves the four tracked quantities.  The
environment equality then follows from
`environmentRoundOfWord_eq_of_wordPrefix_nextView_nonFringe_receiptTag_eq`.
-/
theorem noDirect_rejectedPrefixConsistent_of_currentNonFringeReceipt_stable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (historyOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> List (NonFringeView In₁ In₂ Proc.one))
    (historyTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> List (NonFringeView In₁ In₂ Proc.two))
    (fringeOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> ReceiptTag)
    (fringeTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> ReceiptTag)
    (htrack :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
          ∀ n : Nat,
            let state :=
              uniform.noDirectEpochStateAfterHistory initialBoundary
                (wordPrefix word n)
            let envRound := environmentRoundOfWord word n
            historyOne state envRound =
                [(nextView Proc.one (wordPrefix word n) envRound).nonFringe] ∧
              fringeOne state envRound =
                (nextView Proc.one (wordPrefix word n) envRound).receiptTag ∧
              historyTwo state envRound =
                [(nextView Proc.two (wordPrefix word n) envRound).nonFringe] ∧
              fringeTwo state envRound =
                (nextView Proc.two (wordPrefix word n) envRound).receiptTag)
    (hstable :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
          ∀ i j : Nat,
            let stateI :=
              uniform.noDirectEpochStateAfterHistory initialBoundary
                (wordPrefix word i)
            let stateJ :=
              uniform.noDirectEpochStateAfterHistory initialBoundary
                (wordPrefix word j)
            let envI := environmentRoundOfWord word i
            let envJ := environmentRoundOfWord word j
            stateI = stateJ ->
              historyOne stateI envI = historyOne stateJ envJ ∧
                fringeOne stateI envI = fringeOne stateJ envJ ∧
                historyTwo stateI envI = historyTwo stateJ envJ ∧
                fringeTwo stateI envI = fringeTwo stateJ envJ) :
    ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ i j : Nat,
          uniform.noDirectEpochStateAfterHistory initialBoundary
              (wordPrefix word i) =
            uniform.noDirectEpochStateAfterHistory initialBoundary
              (wordPrefix word j) ->
          environmentRoundOfWord word i = environmentRoundOfWord word j := by
  intro word i j hstate
  let stateI :=
    uniform.noDirectEpochStateAfterHistory initialBoundary
      (wordPrefix word i)
  let stateJ :=
    uniform.noDirectEpochStateAfterHistory initialBoundary
      (wordPrefix word j)
  let envI := environmentRoundOfWord word i
  let envJ := environmentRoundOfWord word j
  rcases htrack word i with
    ⟨hhistoryOneI, hfringeOneI, hhistoryTwoI, hfringeTwoI⟩
  rcases htrack word j with
    ⟨hhistoryOneJ, hfringeOneJ, hhistoryTwoJ, hfringeTwoJ⟩
  rcases hstable word i j hstate with
    ⟨hhistoryOneStable, hfringeOneStable,
      hhistoryTwoStable, hfringeTwoStable⟩
  have honeNonFringe :
      (nextView Proc.one (wordPrefix word i) (environmentRoundOfWord word i)).nonFringe =
        (nextView Proc.one (wordPrefix word j) (environmentRoundOfWord word j)).nonFringe := by
    have hlist :
        [(nextView Proc.one (wordPrefix word i) (environmentRoundOfWord word i)).nonFringe] =
          [(nextView Proc.one (wordPrefix word j) (environmentRoundOfWord word j)).nonFringe] := by
      simpa [stateI, stateJ, envI, envJ] using
        calc
          [(nextView Proc.one (wordPrefix word i) (environmentRoundOfWord word i)).nonFringe]
              = historyOne stateI envI := by
                  simpa [stateI, envI] using hhistoryOneI.symm
          _ = historyOne stateJ envJ := hhistoryOneStable
          _ = [(nextView Proc.one (wordPrefix word j) (environmentRoundOfWord word j)).nonFringe] := by
                  simpa [stateJ, envJ] using hhistoryOneJ
    simpa using hlist
  have honeReceipt :
      (nextView Proc.one (wordPrefix word i) (environmentRoundOfWord word i)).receiptTag =
        (nextView Proc.one (wordPrefix word j) (environmentRoundOfWord word j)).receiptTag := by
    simpa [stateI, stateJ, envI, envJ] using
      calc
        (nextView Proc.one (wordPrefix word i) (environmentRoundOfWord word i)).receiptTag
            = fringeOne stateI envI := by
                simpa [stateI, envI] using hfringeOneI.symm
        _ = fringeOne stateJ envJ := hfringeOneStable
        _ = (nextView Proc.one (wordPrefix word j) (environmentRoundOfWord word j)).receiptTag := by
                simpa [stateJ, envJ] using hfringeOneJ
  have htwoNonFringe :
      (nextView Proc.two (wordPrefix word i) (environmentRoundOfWord word i)).nonFringe =
        (nextView Proc.two (wordPrefix word j) (environmentRoundOfWord word j)).nonFringe := by
    have hlist :
        [(nextView Proc.two (wordPrefix word i) (environmentRoundOfWord word i)).nonFringe] =
          [(nextView Proc.two (wordPrefix word j) (environmentRoundOfWord word j)).nonFringe] := by
      simpa [stateI, stateJ, envI, envJ] using
        calc
          [(nextView Proc.two (wordPrefix word i) (environmentRoundOfWord word i)).nonFringe]
              = historyTwo stateI envI := by
                  simpa [stateI, envI] using hhistoryTwoI.symm
          _ = historyTwo stateJ envJ := hhistoryTwoStable
          _ = [(nextView Proc.two (wordPrefix word j) (environmentRoundOfWord word j)).nonFringe] := by
                  simpa [stateJ, envJ] using hhistoryTwoJ
    simpa using hlist
  have htwoReceipt :
      (nextView Proc.two (wordPrefix word i) (environmentRoundOfWord word i)).receiptTag =
        (nextView Proc.two (wordPrefix word j) (environmentRoundOfWord word j)).receiptTag := by
    simpa [stateI, stateJ, envI, envJ] using
      calc
        (nextView Proc.two (wordPrefix word i) (environmentRoundOfWord word i)).receiptTag
            = fringeTwo stateI envI := by
                simpa [stateI, envI] using hfringeTwoI.symm
        _ = fringeTwo stateJ envJ := hfringeTwoStable
        _ = (nextView Proc.two (wordPrefix word j) (environmentRoundOfWord word j)).receiptTag := by
                simpa [stateJ, envJ] using hfringeTwoJ
  exact
    environmentRoundOfWord_eq_of_wordPrefix_nextView_nonFringe_receiptTag_eq
      word i j honeNonFringe honeReceipt htwoNonFringe htwoReceipt

/--
Direct-observer version of
`noDirect_rejectedPrefixConsistent_of_currentNonFringeReceipt_stable`.

The no-direct prefix state does not have to expose singleton history lists for
this consistency reduction.  It is enough to track the current non-fringe view
and receipt tag for each process and prove those four observers stable under
equal concrete prefix states.
-/
theorem noDirect_rejectedPrefixConsistent_of_currentNonFringeReceipt_observerStable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (nonFringeOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> NonFringeView In₁ In₂ Proc.one)
    (receiptOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> ReceiptTag)
    (nonFringeTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> NonFringeView In₁ In₂ Proc.two)
    (receiptTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> ReceiptTag)
    (htrack :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
          ∀ n : Nat,
            let state :=
              uniform.noDirectEpochStateAfterHistory initialBoundary
                (wordPrefix word n)
            let envRound := environmentRoundOfWord word n
            nonFringeOne state envRound =
                (nextView Proc.one (wordPrefix word n) envRound).nonFringe ∧
              receiptOne state envRound =
                (nextView Proc.one (wordPrefix word n) envRound).receiptTag ∧
              nonFringeTwo state envRound =
                (nextView Proc.two (wordPrefix word n) envRound).nonFringe ∧
              receiptTwo state envRound =
                (nextView Proc.two (wordPrefix word n) envRound).receiptTag)
    (hstable :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
          ∀ i j : Nat,
            let stateI :=
              uniform.noDirectEpochStateAfterHistory initialBoundary
                (wordPrefix word i)
            let stateJ :=
              uniform.noDirectEpochStateAfterHistory initialBoundary
                (wordPrefix word j)
            let envI := environmentRoundOfWord word i
            let envJ := environmentRoundOfWord word j
            stateI = stateJ ->
              nonFringeOne stateI envI = nonFringeOne stateJ envJ ∧
                receiptOne stateI envI = receiptOne stateJ envJ ∧
                nonFringeTwo stateI envI = nonFringeTwo stateJ envJ ∧
                receiptTwo stateI envI = receiptTwo stateJ envJ) :
    ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ i j : Nat,
          uniform.noDirectEpochStateAfterHistory initialBoundary
              (wordPrefix word i) =
            uniform.noDirectEpochStateAfterHistory initialBoundary
              (wordPrefix word j) ->
          environmentRoundOfWord word i = environmentRoundOfWord word j :=
  noDirect_rejectedPrefixConsistent_of_currentNonFringeReceipt_stable
    uniform initialBoundary
    (fun state envRound => [nonFringeOne state envRound])
    (fun state envRound => [nonFringeTwo state envRound])
    receiptOne receiptTwo
    (fun word n => by
      rcases htrack word n with
        ⟨honeNonFringe, honeReceipt, htwoNonFringe, htwoReceipt⟩
      exact
        ⟨by simp [honeNonFringe],
          honeReceipt,
          by simp [htwoNonFringe],
          htwoReceipt⟩)
    (fun word i j hstate => by
      rcases hstable word i j hstate with
        ⟨honeNonFringe, honeReceipt, htwoNonFringe, htwoReceipt⟩
      exact
        ⟨by simp [honeNonFringe],
          honeReceipt,
          by simp [htwoNonFringe],
          htwoReceipt⟩)

@[simp]
theorem wordPrefix_zero
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)) :
    wordPrefix word 0 = [] := rfl

@[simp]
theorem wordPrefix_succ
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (n : Nat) :
    wordPrefix word (n + 1) =
      History.append (wordPrefix word n) (word n) := rfl

@[simp]
theorem wordPrefix_execution
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (n : Nat) :
    wordPrefix (execution σ env) n = executionPrefix σ env n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      simp [wordPrefix_succ, executionPrefix_succ, execution_apply, ih]

/--
Actual local-view decoding can be stated uniformly as prefix-state decoding of
the generated execution word.

This is a bookkeeping bridge: `noDirectEpochStateStream` is definitionally the
no-direct state after the generated execution prefix, and `wordPrefix_execution`
identifies that generated word prefix with the ordinary execution prefix.
-/
theorem noDirectEpochStateStream_actualViews_of_executionPrefixViews
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (viewOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.one)
    (viewTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (hviews :
      ∀ n : Nat,
        let state :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix (execution σ env) n)
        viewOne state (env n) =
            nextView Proc.one (executionPrefix σ env n) (env n) ∧
          viewTwo state (env n) =
            nextView Proc.two (executionPrefix σ env n) (env n)) :
    ∀ n : Nat,
      viewOne
          (uniform.noDirectEpochStateStream initialBoundary σ env n)
          (env n) =
        nextView Proc.one (executionPrefix σ env n) (env n) ∧
      viewTwo
          (uniform.noDirectEpochStateStream initialBoundary σ env n)
          (env n) =
        nextView Proc.two (executionPrefix σ env n) (env n) := by
  intro n
  simpa [
    UniformOneDirectionalFiniteIndexLemma.noDirectEpochStateStream,
    wordPrefix_execution
  ] using hviews n

/--
An all-history prefix-state decoder implies the all-controller state-stream
actual-view decoder used by the local backend.

This is a useful theorem-facing bridge for concrete no-direct constructions:
instead of proving the state-stream equation separately for every locally
observable controller, it is enough to show that every finite history's
no-direct prefix state decodes the next local views for that history.
-/
theorem noDirectEpochStateStream_actualViews_of_historyPrefixViews
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (viewOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.one)
    (viewTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.two)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (hviews :
      ∀ (history : History In₁ In₂ Graph Out₁ Out₂)
        (env : EnvironmentRound In₁ In₂),
        viewOne
            (uniform.noDirectEpochStateAfterHistory initialBoundary history)
            env =
          nextView Proc.one history env ∧
        viewTwo
            (uniform.noDirectEpochStateAfterHistory initialBoundary history)
            env =
          nextView Proc.two history env) :
    ∀ controller :
        uniform.noDirectEpochTransformer.RoundAwareLocalControllerCode
          viewOne viewTwo,
      ∀ env : EnvironmentSequence In₁ In₂,
        ∀ n : Nat,
          let σ :=
            strategyOfRoundAwareLocalController
              uniform.noDirectEpochTransformer viewOne viewTwo controller
              defaultOne defaultTwo
          viewOne
              (uniform.noDirectEpochStateStream initialBoundary σ env n)
              (env n) =
            nextView Proc.one (executionPrefix σ env n) (env n) ∧
          viewTwo
              (uniform.noDirectEpochStateStream initialBoundary σ env n)
              (env n) =
            nextView Proc.two (executionPrefix σ env n) (env n) := by
  intro controller env n
  let σ :=
    strategyOfRoundAwareLocalController
      uniform.noDirectEpochTransformer viewOne viewTwo controller
      defaultOne defaultTwo
  simpa [
    σ,
    UniformOneDirectionalFiniteIndexLemma.noDirectEpochStateStream,
    wordPrefix_execution
  ] using hviews (executionPrefix σ env n) (env n)

