theorem noDirectEpochStateStream_actualFiniteViewStateWitnesses_of_actualSummaries
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (uniform :
