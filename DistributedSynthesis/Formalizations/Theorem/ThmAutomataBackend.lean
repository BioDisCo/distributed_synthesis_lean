          p ≤ A.priority (dpaOf (stateStream (start + i))))
    (hpOdd : ¬ DetParityAutomaton.NatEven p) :
    ∃ code : Q -> Move,
      ¬ A.Accepts (finiteCarrierPlayWord initial step emit code) := by
  exact
    exists_finiteCarrierCode_rejected_playWord_of_consistent_looping_stateStream_of_dpaRun_cycleWitness_lowerBound
      initial step emit A stateStream moveStream dpaOf
      (dpaOf_finiteCarrierStateStream_eq_run_finiteCarrierWord
