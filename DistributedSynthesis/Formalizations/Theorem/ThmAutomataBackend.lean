      uniform.noDirectEpochTransformer initialBoundary viewOne viewTwo :=
  roundAwareGameExecutionStateViewDecoders_of_noDirectStateStreamActualViews_currentFringe
    uniform initialBoundary viewOne viewTwo defaultOne defaultTwo
    (fun controller env n =>
      let σ :=
        strategyOfRoundAwareLocalController
          uniform.noDirectEpochTransformer viewOne viewTwo controller
