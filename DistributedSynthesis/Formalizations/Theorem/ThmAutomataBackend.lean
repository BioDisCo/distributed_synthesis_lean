/--
Rejected-compatible local lambda choices from concrete no-direct prefix states.

For a local/full-view compatible word, the compatible execution supplies one
finite witness state for each process.  If the concrete no-direct prefix state
decodes the same two one-sided views, local observability of the controller
forces the process outputs at the witnesses to agree with the outputs at the
concrete prefix state.  The concrete prefix-state stream is therefore already
the synchronized finite state/lambda stream for the rejected compatible word.
-/
theorem noDirectEpochStateAfterHistory_localCompatibleLambdaChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (viewOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.one)
    (viewTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.two)
    (controller :
      RoundAwareLocalControllerCode
        uniform.noDirectEpochTransformer viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hcompatible :
      RoundAwareLocalControllerCompatibleDecodedExecution
        uniform.noDirectEpochTransformer viewOne viewTwo controller σ env word)
    (hconsistent :
      ∀ i j : Nat,
        uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word i) =
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word j) ->
        env i = env j)
    (hviews :
      ∀ n : Nat,
        let state :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word n)
        viewOne state (env n) =
            nextView Proc.one (executionPrefix σ env n) (env n) ∧
          viewTwo state (env n) =
            nextView Proc.two (executionPrefix σ env n) (env n)) :
    RoundAwareLocalControllerCompatibleDecodedExecutionLambdaChoices
      uniform.noDirectEpochTransformer initialBoundary viewOne viewTwo
      controller σ env word
      (fun n =>
        uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word n)) := by
  refine ⟨?_, ?_, hconsistent, ?_⟩
  · rfl
  · intro n
    let state :=
      uniform.noDirectEpochStateAfterHistory initialBoundary
        (wordPrefix word n)
    let envRound := env n
    have hword :
        word n =
          {
            inputOne := envRound.inputOne
            inputTwo := envRound.inputTwo
            graph := envRound.graph
            outputOne := (controller.1 state envRound).1
            outputTwo := (controller.1 state envRound).2
          } := by
      rcases hcompatible n with
        ⟨stateOne, hviewOne, stateTwo, hviewTwo, hword⟩
      have hviews_n := hviews n
      have houtOne :
          (controller.1 stateOne (env n)).1 =
            (controller.1 state (env n)).1 :=
        controller.2.1 stateOne (env n) state (env n)
          (hviewOne.trans hviews_n.1.symm)
      have houtTwo :
          (controller.1 stateTwo (env n)).2 =
            (controller.1 state (env n)).2 :=
        controller.2.2 stateTwo (env n) state (env n)
          (hviewTwo.trans hviews_n.2.symm)
      simpa [envRound, hword, houtOne, houtTwo]
    change
      uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word (n + 1)) =
        roundAwareGameTransition uniform.noDirectEpochTransformer controller.1
          state envRound
    rw [wordPrefix_succ]
    rw [
      UniformOneDirectionalFiniteIndexLemma.noDirectEpochStateAfterHistory_append_round
        uniform initialBoundary (wordPrefix word n) (word n)
    ]
    rw [hword]
    change
      uniform.noDirectEpochStateTransition state
          {
            inputOne := envRound.inputOne
            inputTwo := envRound.inputTwo
            graph := envRound.graph
            outputOne := (controller.1 state envRound).1
            outputTwo := (controller.1 state envRound).2
          } =
        roundAwareGameTransition uniform.noDirectEpochTransformer controller.1
          state envRound
    exact
      noDirectEpochStateTransition_eq_roundAwareGameTransition
        uniform controller.1 state envRound
  · intro n
    have hviews_n := hviews n
    refine ⟨hviews_n.1, hviews_n.2, ?_⟩
    let state :=
      uniform.noDirectEpochStateAfterHistory initialBoundary
        (wordPrefix word n)
    let envRound := env n
    rcases hcompatible n with
      ⟨stateOne, hviewOne, stateTwo, hviewTwo, hword⟩
    have houtOne :
        (controller.1 stateOne (env n)).1 =
          (controller.1 state (env n)).1 :=
      controller.2.1 stateOne (env n) state (env n)
        (hviewOne.trans hviews_n.1.symm)
    have houtTwo :
        (controller.1 stateTwo (env n)).2 =
          (controller.1 state (env n)).2 :=
      controller.2.2 stateTwo (env n) state (env n)
        (hviewTwo.trans hviews_n.2.symm)
    simpa [state, envRound, hword, houtOne, houtTwo]

/--
Concrete no-direct prefix states give exact finite replay for a compatible
decoded word.

The only inputs are operational: the compatible decoded execution, repeat
consistency of the concrete no-direct prefix-state stream with the decoded
environment, and prefix-state decoding of both current local views.  The proof
first turns the concrete stream into synchronized lambda choices, then applies
the pure finite-replay lemma.
-/
theorem noDirectEpochStateAfterHistory_localCompatibleWordRepresentable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (viewOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.one)
    (viewTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.two)
    (controller :
      RoundAwareLocalControllerCode
        uniform.noDirectEpochTransformer viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hcompatible :
      RoundAwareLocalControllerCompatibleDecodedExecution
        uniform.noDirectEpochTransformer viewOne viewTwo controller σ env word)
    (hconsistent :
      ∀ i j : Nat,
        uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word i) =
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word j) ->
        env i = env j)
    (hviews :
      ∀ n : Nat,
        let state :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word n)
        viewOne state (env n) =
            nextView Proc.one (executionPrefix σ env n) (env n) ∧
          viewTwo state (env n) =
            nextView Proc.two (executionPrefix σ env n) (env n)) :
    ∃ environment : EnvironmentCode uniform.noDirectEpochTransformer,
      roundAwareGameExecution uniform.noDirectEpochTransformer
        initialBoundary controller.1 environment = word := by
  let stateStream : Nat -> GameState uniform.noDirectEpochTransformer :=
    fun n =>
      uniform.noDirectEpochStateAfterHistory initialBoundary
        (wordPrefix word n)
  have hstream :
      RoundAwareLocalControllerCompatibleDecodedExecutionLambdaChoices
        uniform.noDirectEpochTransformer initialBoundary viewOne viewTwo
        controller σ env word stateStream := by
    exact
      noDirectEpochStateAfterHistory_localCompatibleLambdaChoices
        uniform initialBoundary viewOne viewTwo controller σ env word
        hcompatible hconsistent hviews
  exact
    roundAwareLocalController_wordRepresentable_of_synchronizedStateChoices
      uniform.noDirectEpochTransformer initialBoundary viewOne viewTwo
      controller σ env word stateStream hstream

/--
Prefix-state local-view decoding and prefix-view stability imply repeat
consistency of the decoded environment sequence.

This is a purely local consistency reduction.  If equal concrete no-direct
prefix states decode the same pair of current local views under their two
environment rounds, then the two environment rounds are equal because the pair
of next local views determines the whole environment move.
-/
theorem noDirectEpochStateAfterHistory_localCompatiblePrefixConsistent_of_prefixViewsAndStable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (viewOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.one)
    (viewTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hviews :
      ∀ n : Nat,
        let state :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word n)
        viewOne state (env n) =
            nextView Proc.one (executionPrefix σ env n) (env n) ∧
          viewTwo state (env n) =
            nextView Proc.two (executionPrefix σ env n) (env n))
    (hstable :
      ∀ i j : Nat,
        let stateI :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word i)
        let stateJ :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word j)
        stateI = stateJ ->
          viewOne stateI (env i) = viewOne stateJ (env j) ∧
            viewTwo stateI (env i) = viewTwo stateJ (env j)) :
    ∀ i j : Nat,
      uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word i) =
        uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word j) ->
      env i = env j := by
  intro i j hstate
  let stateI :=
    uniform.noDirectEpochStateAfterHistory initialBoundary
      (wordPrefix word i)
  let stateJ :=
    uniform.noDirectEpochStateAfterHistory initialBoundary
      (wordPrefix word j)
  have hviewsI := hviews i
  have hviewsJ := hviews j
  rcases hstable i j hstate with ⟨hviewOneStable, hviewTwoStable⟩
  apply environmentRound_eq_of_nextView_eq
  · calc
      nextView Proc.one (executionPrefix σ env i) (env i)
          = viewOne stateI (env i) := by
              simpa [stateI] using hviewsI.1.symm
      _ = viewOne stateJ (env j) := hviewOneStable
      _ = nextView Proc.one (executionPrefix σ env j) (env j) := by
              simpa [stateJ] using hviewsJ.1
  · calc
      nextView Proc.two (executionPrefix σ env i) (env i)
          = viewTwo stateI (env i) := by
              simpa [stateI] using hviewsI.2.symm
      _ = viewTwo stateJ (env j) := hviewTwoStable
      _ = nextView Proc.two (executionPrefix σ env j) (env j) := by
              simpa [stateJ] using hviewsJ.2

/--
Prefix-state local-view decoding and stability of the projected current
observers imply repeat consistency of the decoded environment sequence.

This is the projected version of
`noDirectEpochStateAfterHistory_localCompatiblePrefixConsistent_of_prefixViewsAndStable`.
The branch-prefix view theorem supplies tracking of the projected observers
because they are just the non-fringe and receipt-tag projections of the decoded
full views.  The remaining stability premise therefore only has to preserve
those four projected fields under equal concrete no-direct prefix states.
-/
theorem noDirectEpochStateAfterHistory_localCompatiblePrefixConsistent_of_prefixViewObserversAndStable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (viewOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.one)
    (viewTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hviews :
      ∀ n : Nat,
        let state :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word n)
        viewOne state (env n) =
            nextView Proc.one (executionPrefix σ env n) (env n) ∧
          viewTwo state (env n) =
            nextView Proc.two (executionPrefix σ env n) (env n))
    (hstable :
      ∀ i j : Nat,
        let stateI :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word i)
        let stateJ :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word j)
        stateI = stateJ ->
          (viewOne stateI (env i)).nonFringe =
              (viewOne stateJ (env j)).nonFringe ∧
            (viewOne stateI (env i)).receiptTag =
              (viewOne stateJ (env j)).receiptTag ∧
            (viewTwo stateI (env i)).nonFringe =
              (viewTwo stateJ (env j)).nonFringe ∧
            (viewTwo stateI (env i)).receiptTag =
              (viewTwo stateJ (env j)).receiptTag) :
    ∀ i j : Nat,
      uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word i) =
        uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word j) ->
      env i = env j := by
  intro i j hstate
  let stateI :=
    uniform.noDirectEpochStateAfterHistory initialBoundary
      (wordPrefix word i)
  let stateJ :=
    uniform.noDirectEpochStateAfterHistory initialBoundary
      (wordPrefix word j)
  have hviewsI := hviews i
  have hviewsJ := hviews j
  rcases hstable i j hstate with
    ⟨honeNonFringeStable, honeReceiptStable,
      htwoNonFringeStable, htwoReceiptStable⟩
  apply environmentRound_eq_of_nextView_nonFringe_receiptTag_eq
  · calc
      (nextView Proc.one (executionPrefix σ env i) (env i)).nonFringe
          = (viewOne stateI (env i)).nonFringe := by
              simpa [stateI] using
                congrArg (fun view => view.nonFringe) hviewsI.1.symm
      _ = (viewOne stateJ (env j)).nonFringe := honeNonFringeStable
      _ = (nextView Proc.one (executionPrefix σ env j) (env j)).nonFringe := by
              simpa [stateJ] using
                congrArg (fun view => view.nonFringe) hviewsJ.1
  · calc
      (nextView Proc.one (executionPrefix σ env i) (env i)).receiptTag
          = (viewOne stateI (env i)).receiptTag := by
              simpa [stateI] using
                congrArg (fun view => view.receiptTag) hviewsI.1.symm
      _ = (viewOne stateJ (env j)).receiptTag := honeReceiptStable
      _ = (nextView Proc.one (executionPrefix σ env j) (env j)).receiptTag := by
              simpa [stateJ] using
                congrArg (fun view => view.receiptTag) hviewsJ.1
  · calc
      (nextView Proc.two (executionPrefix σ env i) (env i)).nonFringe
          = (viewTwo stateI (env i)).nonFringe := by
              simpa [stateI] using
                congrArg (fun view => view.nonFringe) hviewsI.2.symm
      _ = (viewTwo stateJ (env j)).nonFringe := htwoNonFringeStable
      _ = (nextView Proc.two (executionPrefix σ env j) (env j)).nonFringe := by
              simpa [stateJ] using
                congrArg (fun view => view.nonFringe) hviewsJ.2
  · calc
      (nextView Proc.two (executionPrefix σ env i) (env i)).receiptTag
          = (viewTwo stateI (env i)).receiptTag := by
              simpa [stateI] using
                congrArg (fun view => view.receiptTag) hviewsI.2.symm
      _ = (viewTwo stateJ (env j)).receiptTag := htwoReceiptStable
      _ = (nextView Proc.two (executionPrefix σ env j) (env j)).receiptTag := by
              simpa [stateJ] using
                congrArg (fun view => view.receiptTag) hviewsJ.2

/--
Prefix-state local-view decoding and pointwise state-factorization of the
projected current observers imply repeat consistency of the decoded environment
sequence.

This packages the previous projected-stability lemma in the form used by a
finite-memory certificate: the caller supplies four finite observations of the
concrete no-direct prefix state, and proves that the local decoders' non-fringe
and receipt-tag projections are exactly those observations along the branch.
Stability under equal prefix states is then just congruence of these four
state functions.
-/
theorem noDirectEpochStateAfterHistory_localCompatiblePrefixConsistent_of_prefixViewObserverFactors
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (viewOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.one)
    (viewTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (projectedOneNonFringe :
      GameState uniform.noDirectEpochTransformer ->
        NonFringeView In₁ In₂ Proc.one)
    (projectedOneReceipt :
      GameState uniform.noDirectEpochTransformer -> ReceiptTag)
    (projectedTwoNonFringe :
      GameState uniform.noDirectEpochTransformer ->
        NonFringeView In₁ In₂ Proc.two)
    (projectedTwoReceipt :
      GameState uniform.noDirectEpochTransformer -> ReceiptTag)
    (hviews :
      ∀ n : Nat,
        let state :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word n)
        viewOne state (env n) =
            nextView Proc.one (executionPrefix σ env n) (env n) ∧
          viewTwo state (env n) =
            nextView Proc.two (executionPrefix σ env n) (env n))
    (hfactor :
      ∀ n : Nat,
        let state :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word n)
        (viewOne state (env n)).nonFringe =
            projectedOneNonFringe state ∧
          (viewOne state (env n)).receiptTag =
            projectedOneReceipt state ∧
          (viewTwo state (env n)).nonFringe =
            projectedTwoNonFringe state ∧
          (viewTwo state (env n)).receiptTag =
            projectedTwoReceipt state) :
    ∀ i j : Nat,
      uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word i) =
        uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word j) ->
      env i = env j :=
  noDirectEpochStateAfterHistory_localCompatiblePrefixConsistent_of_prefixViewObserversAndStable
    uniform initialBoundary viewOne viewTwo σ env word hviews
    (fun i j hstate => by
      let stateI :=
        uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word i)
      let stateJ :=
        uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word j)
      have hstate' : stateI = stateJ := by
        simpa [stateI, stateJ] using hstate
      rcases hfactor i with
        ⟨honeNonFringeI, honeReceiptI,
          htwoNonFringeI, htwoReceiptI⟩
      rcases hfactor j with
        ⟨honeNonFringeJ, honeReceiptJ,
          htwoNonFringeJ, htwoReceiptJ⟩
      have honeNonFringeI' :
          (viewOne stateI (env i)).nonFringe =
            projectedOneNonFringe stateI := by
        simpa [stateI] using honeNonFringeI
      have honeReceiptI' :
          (viewOne stateI (env i)).receiptTag =
            projectedOneReceipt stateI := by
        simpa [stateI] using honeReceiptI
      have htwoNonFringeI' :
          (viewTwo stateI (env i)).nonFringe =
            projectedTwoNonFringe stateI := by
        simpa [stateI] using htwoNonFringeI
      have htwoReceiptI' :
          (viewTwo stateI (env i)).receiptTag =
            projectedTwoReceipt stateI := by
        simpa [stateI] using htwoReceiptI
      have honeNonFringeJ' :
          (viewOne stateJ (env j)).nonFringe =
            projectedOneNonFringe stateJ := by
        simpa [stateJ] using honeNonFringeJ
      have honeReceiptJ' :
          (viewOne stateJ (env j)).receiptTag =
            projectedOneReceipt stateJ := by
        simpa [stateJ] using honeReceiptJ
      have htwoNonFringeJ' :
          (viewTwo stateJ (env j)).nonFringe =
            projectedTwoNonFringe stateJ := by
        simpa [stateJ] using htwoNonFringeJ
      have htwoReceiptJ' :
          (viewTwo stateJ (env j)).receiptTag =
            projectedTwoReceipt stateJ := by
        simpa [stateJ] using htwoReceiptJ
      exact
        ⟨calc
            (viewOne stateI (env i)).nonFringe
                = projectedOneNonFringe stateI := honeNonFringeI'
            _ = projectedOneNonFringe stateJ := by
                  simpa using congrArg projectedOneNonFringe hstate'
            _ = (viewOne stateJ (env j)).nonFringe := honeNonFringeJ'.symm,
          calc
            (viewOne stateI (env i)).receiptTag
                = projectedOneReceipt stateI := honeReceiptI'
            _ = projectedOneReceipt stateJ := by
                  simpa using congrArg projectedOneReceipt hstate'
            _ = (viewOne stateJ (env j)).receiptTag := honeReceiptJ'.symm,
          calc
            (viewTwo stateI (env i)).nonFringe
                = projectedTwoNonFringe stateI := htwoNonFringeI'
            _ = projectedTwoNonFringe stateJ := by
                  simpa using congrArg projectedTwoNonFringe hstate'
            _ = (viewTwo stateJ (env j)).nonFringe := htwoNonFringeJ'.symm,
          calc
            (viewTwo stateI (env i)).receiptTag
                = projectedTwoReceipt stateI := htwoReceiptI'
            _ = projectedTwoReceipt stateJ := by
                  simpa using congrArg projectedTwoReceipt hstate'
            _ = (viewTwo stateJ (env j)).receiptTag := htwoReceiptJ'.symm⟩)

/--
Packed version of
`noDirectEpochStateAfterHistory_localCompatiblePrefixConsistent_of_prefixViewObserverFactors`.

This observer-pair bridge records, for each process, the current non-fringe
view together with its current receipt tag as one projected pair.  The pair is
not itself a finite carrier; this lemma only splits those two packed projections
into the four factor laws consumed by the existing repeat-consistency bridge.
-/
theorem noDirectEpochStateAfterHistory_localCompatiblePrefixConsistent_of_prefixViewObserverPairFactors
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (viewOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.one)
    (viewTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (projectedOneSummary :
      GameState uniform.noDirectEpochTransformer ->
        NonFringeView In₁ In₂ Proc.one × ReceiptTag)
    (projectedTwoSummary :
      GameState uniform.noDirectEpochTransformer ->
        NonFringeView In₁ In₂ Proc.two × ReceiptTag)
    (hviews :
      ∀ n : Nat,
        let state :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word n)
        viewOne state (env n) =
            nextView Proc.one (executionPrefix σ env n) (env n) ∧
          viewTwo state (env n) =
            nextView Proc.two (executionPrefix σ env n) (env n))
    (hfactor :
      ∀ n : Nat,
        let state :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (wordPrefix word n)
        ((viewOne state (env n)).nonFringe,
            (viewOne state (env n)).receiptTag) =
            projectedOneSummary state ∧
          ((viewTwo state (env n)).nonFringe,
            (viewTwo state (env n)).receiptTag) =
            projectedTwoSummary state) :
    ∀ i j : Nat,
      uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word i) =
        uniform.noDirectEpochStateAfterHistory initialBoundary
          (wordPrefix word j) ->
      env i = env j :=
  noDirectEpochStateAfterHistory_localCompatiblePrefixConsistent_of_prefixViewObserverFactors
    uniform initialBoundary viewOne viewTwo σ env word
    (fun state => (projectedOneSummary state).1)
    (fun state => (projectedOneSummary state).2)
    (fun state => (projectedTwoSummary state).1)
    (fun state => (projectedTwoSummary state).2)
    hviews
    (fun n => by
      rcases hfactor n with ⟨hone, htwo⟩
      exact
        ⟨by simpa using congrArg Prod.fst hone,
          by simpa using congrArg Prod.snd hone,
          by simpa using congrArg Prod.fst htwo,
          by simpa using congrArg Prod.snd htwo⟩)

/--
Decoded-summary version of
`noDirectEpochStateAfterHistory_localCompatiblePrefixConsistent_of_prefixViewObserverPairFactors`.

This is the decoded-summary form of the observer bridge.  The caller supplies a
state summary for each process and a decoder from that summary to the packed
current observer `(nonFringe, receiptTag)`.  If the decoded summaries agree
with the local decoders along the rejected branch, Lean obtains the same repeat
consistency as in the packed-observer formulation.  Finite-memory applications
instantiate the summary types with finite carriers.
-/
theorem noDirectEpochStateAfterHistory_localCompatiblePrefixConsistent_of_prefixViewDecodedSummaryFactors
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {Summary₁ : Type b}
    {Summary₂ : Type x}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (viewOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.one)
    (viewTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (summaryOne :
      GameState uniform.noDirectEpochTransformer -> Summary₁)
    (summaryTwo :
      GameState uniform.noDirectEpochTransformer -> Summary₂)
    (decodeOne :
