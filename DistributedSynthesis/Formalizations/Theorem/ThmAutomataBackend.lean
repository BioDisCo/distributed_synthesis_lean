/--
State-stream actual-view decoding for every locally observable controller
already supplies the full round-aware state-view decoder simulation.

For an arbitrary distributed strategy `σ`, instantiate the local controller
that evaluates `σ` on the decoded current views.  The state-stream premise
shows that the strategy extracted from that local controller sees the real
views on its no-direct stream.  Along that stream the extracted strategy and
`σ` have the same prefixes, so the same decoded views also witness the
round-aware finite-game play generated by the original `σ`.
-/
theorem roundAwareGameExecutionStateViewDecoders_of_noDirectStateStreamActualViews_currentFringe
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (viewOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.one)
    (viewTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ ->
          View In₁ In₂ Proc.two)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (actualViews :
      ∀ controller :
          uniform.noDirectEpochTransformer.RoundAwareLocalControllerCode
            viewOne viewTwo,
        ∀ env : EnvironmentSequence In₁ In₂,
          ∀ n : Nat,
            let σ :=
              strategyOfRoundAwareLocalController
                uniform.noDirectEpochTransformer viewOne viewTwo controller
                defaultOne defaultTwo
            viewOne
                (uniform.noDirectEpochStateStream initialBoundary σ env n)
                (env n) =
              nextView Proc.one (executionPrefix σ env n) (env n) ∧
            viewTwo
                (uniform.noDirectEpochStateStream initialBoundary σ env n)
                (env n) =
              nextView Proc.two (executionPrefix σ env n) (env n)) :
    RoundAwareGameExecutionStateViewDecodersSimulateStrategies
      uniform.noDirectEpochTransformer initialBoundary viewOne viewTwo := by
  intro σ environment n
  let T := uniform.noDirectEpochTransformer
  let controller : RoundAwareLocalControllerCode T viewOne viewTwo :=
    roundAwareLocalControllerOfStrategyViaCurrentFringe
      T viewOne viewTwo σ
  let env : EnvironmentSequence In₁ In₂ :=
    roundAwareEnvironmentSequenceOfGamePlay
      T initialBoundary controller.1 environment
  let σ' : StrategyPair In₁ In₂ Out₁ Out₂ :=
    strategyOfRoundAwareLocalController
      T viewOne viewTwo controller defaultOne defaultTwo
  have hprefix : ∀ k : Nat,
      executionPrefix σ' env k = executionPrefix σ env k := by
    intro k
    induction k with
    | zero => rfl
    | succ k ih =>
        let state :=
          uniform.noDirectEpochStateStream initialBoundary σ' env k
        have hviews := actualViews controller env k
        have hone :
            σ'.one (nextView Proc.one (executionPrefix σ env k) (env k)) =
              σ.one (nextView Proc.one (executionPrefix σ env k) (env k)) := by
          have hdecoded :
              σ'.one (viewOne state (env k)) =
                (controller.1 state (env k)).1 := by
            exact
              strategyOneOfRoundAwareLocalController_apply_decoded
                T viewOne viewTwo controller defaultOne state (env k)
          have hcontroller :
              (controller.1 state (env k)).1 =
                σ.one (viewOne state (env k)) := by
            simp [controller]
          have hview :
              viewOne state (env k) =
                nextView Proc.one (executionPrefix σ env k) (env k) := by
            simpa [state, σ', T, ih] using hviews.1
          rw [← hview, hdecoded, hcontroller]
        have htwo :
            σ'.two (nextView Proc.two (executionPrefix σ env k) (env k)) =
              σ.two (nextView Proc.two (executionPrefix σ env k) (env k)) := by
          have hdecoded :
              σ'.two (viewTwo state (env k)) =
                (controller.1 state (env k)).2 := by
            exact
              strategyTwoOfRoundAwareLocalController_apply_decoded
                T viewOne viewTwo controller defaultTwo state (env k)
          have hcontroller :
              (controller.1 state (env k)).2 =
                σ.two (viewTwo state (env k)) := by
            simp [controller]
          have hview :
              viewTwo state (env k) =
                nextView Proc.two (executionPrefix σ env k) (env k) := by
            simpa [state, σ', T, ih] using hviews.2
          rw [← hview, hdecoded, hcontroller]
        rw [executionPrefix_succ, executionPrefix_succ, ih]
        simp [nextRound, hone, htwo]
  have hmatch :
      ∀ k : Nat,
        controller.1
            (uniform.noDirectEpochStateStream initialBoundary σ' env k)
            (env k) =
          (σ'.one (nextView Proc.one (executionPrefix σ' env k) (env k)),
            σ'.two (nextView Proc.two (executionPrefix σ' env k) (env k))) := by
    intro k
    let state :=
      uniform.noDirectEpochStateStream initialBoundary σ' env k
    have hone :
        σ'.one (viewOne state (env k)) =
          (controller.1 state (env k)).1 := by
      exact
        strategyOneOfRoundAwareLocalController_apply_decoded
          T viewOne viewTwo controller defaultOne state (env k)
    have htwo :
        σ'.two (viewTwo state (env k)) =
          (controller.1 state (env k)).2 := by
      exact
        strategyTwoOfRoundAwareLocalController_apply_decoded
          T viewOne viewTwo controller defaultTwo state (env k)
    have hviews := actualViews controller env k
    exact
      Prod.ext
        (by simpa [state] using hone.symm.trans (congrArg σ'.one hviews.1))
        (by simpa [state] using htwo.symm.trans (congrArg σ'.two hviews.2))
  have hstate : ∀ k : Nat,
      roundAwareGameStateStream T initialBoundary controller.1 environment k =
        uniform.noDirectEpochStateStream initialBoundary σ' env k := by
    intro k
    induction k with
    | zero =>
        rfl
    | succ k ih =>
        rw [roundAwareGameStateStream_succ]
        rw [ih]
        have henv :
            environment
                (uniform.noDirectEpochStateStream initialBoundary σ' env k) =
              env k := by
          rw [← ih]
          rfl
        rw [henv]
        exact
          (noDirectEpochStateStream_succ_eq_roundAwareGameTransition_of_controller_matches
            uniform initialBoundary controller.1 σ' env hmatch k).symm
  have hcontroller_eq :
      controller.1 =
        (fun state envRound =>
          (σ.one (viewOne state envRound),
            σ.two (viewTwo state envRound))) := by
    funext state envRound
    simp [controller]
  let targetController : RoundAwareControllerCode uniform.noDirectEpochTransformer :=
    fun state envRound =>
      (σ.one (viewOne state envRound),
        σ.two (viewTwo state envRound))
  have htargetController : targetController = controller.1 := by
    funext state envRound
    simp [targetController, hcontroller_eq]
  have henv_eq :
      roundAwareEnvironmentSequenceOfGamePlay
          uniform.noDirectEpochTransformer initialBoundary
          targetController environment =
        env := by
    rw [htargetController]
  have hviews := actualViews controller env n
  constructor
  · have hview :
        viewOne
            (uniform.noDirectEpochStateStream initialBoundary σ' env n)
            (env n) =
          nextView Proc.one (executionPrefix σ env n) (env n) := by
        simpa [σ', T, hprefix n] using hviews.1
    change
      viewOne
          (roundAwareGameStateStream
            uniform.noDirectEpochTransformer initialBoundary
            targetController environment n)
          (roundAwareEnvironmentSequenceOfGamePlay
            uniform.noDirectEpochTransformer initialBoundary
            targetController environment n) =
        nextView Proc.one
          (executionPrefix σ
            (roundAwareEnvironmentSequenceOfGamePlay
              uniform.noDirectEpochTransformer initialBoundary
              targetController environment) n)
          (roundAwareEnvironmentSequenceOfGamePlay
            uniform.noDirectEpochTransformer initialBoundary
            targetController environment n)
    rw [henv_eq, htargetController, hstate n]
    exact hview
  · have hview :
        viewTwo
            (uniform.noDirectEpochStateStream initialBoundary σ' env n)
            (env n) =
          nextView Proc.two (executionPrefix σ env n) (env n) := by
        simpa [σ', T, hprefix n] using hviews.2
    change
      viewTwo
          (roundAwareGameStateStream
            uniform.noDirectEpochTransformer initialBoundary
            targetController environment n)
          (roundAwareEnvironmentSequenceOfGamePlay
            uniform.noDirectEpochTransformer initialBoundary
            targetController environment n) =
        nextView Proc.two
          (executionPrefix σ
            (roundAwareEnvironmentSequenceOfGamePlay
              uniform.noDirectEpochTransformer initialBoundary
              targetController environment) n)
          (roundAwareEnvironmentSequenceOfGamePlay
            uniform.noDirectEpochTransformer initialBoundary
            targetController environment n)
    rw [henv_eq, htargetController, hstate n]
    exact hview

/--
Actual-prefix local-view decoding for every locally observable controller
already supplies the full round-aware state-view decoder simulation.

This is the prefix-state variant of
`roundAwareGameExecutionStateViewDecoders_of_noDirectStateStreamActualViews_currentFringe`.
The proof first transports actual-prefix decoding to the concrete no-direct
state stream and then applies the state-stream decoder theorem.
-/
theorem roundAwareGameExecutionStateViewDecoders_of_actualPrefixViews_currentFringe
    {In₁ : Type u}
