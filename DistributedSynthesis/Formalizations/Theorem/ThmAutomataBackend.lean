    DPAToFiniteGameCompilation.{u, v, w, a, max u v w a} Out₂ A := by
  let abstraction := cert.toDPAFiniteStrategyAbstraction
  exact
    {
      finiteGame :=
        {
          ControllerStrategy := abstraction.ControllerCode
          EnvironmentStrategy := abstraction.EnvironmentCode
          controllerFinite := abstraction.controllerFinite
          environmentFinite := abstraction.environmentFinite
          wins := abstraction.wins
          winsDecidable := abstraction.winsDecidable
          dynamicHierarchy := abstraction.dynamicHierarchy
          parityObjective := abstraction.parityObjective
          dynamicHierarchy_proof := abstraction.dynamicHierarchy_proof
          parityObjective_proof := abstraction.parityObjective_proof
        }
      realizabilityEquivalent := by
        constructor
        · intro h
          rcases h with ⟨controller, hwins⟩
          exact
            ⟨abstraction.controllerStrategy controller,
              abstraction.sound controller hwins⟩
        · intro h
          rcases h with ⟨σ, hσ⟩
          rcases abstraction.complete σ hσ with ⟨controller, hwins⟩
          exact ⟨controller, hwins⟩
    }

end RoundAwareLocalEpochGameAbstractionCertificate

/--
Paper-facing local-observable round-aware rotating rational-run backend for
one DPA objective.

This is the finite-game compilation certificate after the raw round-aware-controller
obstruction.  The rational-run target data remain explicit, but the finite
controller carrier is the locally observable subtype determined by the decoded
local views `viewOne` and `viewTwo`.
-/
structure RoundAwareLocalRotatingRationalRunEpochBackendCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  Branch : Proc -> Type b
  Label : Proc -> Type x
  target :
    (d : Proc) -> InputFreeParityTreeAutomaton.{b, x, y} (Branch d) (Label d)
  targetNonempty :
    ∀ d : Proc,
      ∃ tree : LabeledTree (Branch d) (Label d),
        (target d).acceptsTree tree
  transformer :
    FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂
  gameStateDecidable :
    DecidableEq (FiniteEpochTransformer.GameState transformer)
  initialBoundary : transformer.boundary
  automaton_equiv :
    ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      transformer.automaton.Accepts word ↔ A.Accepts word
  viewOne :
    FiniteEpochTransformer.GameState transformer ->
      EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one
  viewTwo :
    FiniteEpochTransformer.GameState transformer ->
      EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two
  controllerStrategy :
    transformer.RoundAwareLocalControllerCode viewOne viewTwo ->
      StrategyPair In₁ In₂ Out₁ Out₂
  dynamicHierarchy : Prop
  parityObjective : Prop
  dynamicHierarchy_proof : dynamicHierarchy
  parityObjective_proof : parityObjective
  sound :
    ∀ controller,
      (∀ environment : transformer.EnvironmentCode,
        transformer.roundAwareGameWins
          initialBoundary controller.1 environment) ->
        ∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution (controllerStrategy controller) env)
  stateViewDecoders :
    FiniteEpochTransformer.RoundAwareGameExecutionStateViewDecodersSimulateStrategies
      transformer initialBoundary viewOne viewTwo

