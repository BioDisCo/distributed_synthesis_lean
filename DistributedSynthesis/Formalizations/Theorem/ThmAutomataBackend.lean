/-- The round-aware epoch certificate directly yields a finite-game compilation. -/
noncomputable def toDPAToFiniteGameCompilation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert : RoundAwareEpochGameAbstractionCertificate.{u, v, w, a} A) :
    DPAToFiniteGameCompilation.{u, v, w, a, max u v w a} Out₂ A := by
  let abstraction := cert.toDPAFiniteStrategyAbstraction
  exact
    {
      finiteGame :=
        {
          ControllerStrategy := abstraction.ControllerCode
          EnvironmentStrategy := abstraction.EnvironmentCode
          controllerFinite := abstraction.controllerFinite
          environmentFinite := abstraction.environmentFinite
          wins := abstraction.wins
          winsDecidable := abstraction.winsDecidable
          dynamicHierarchy := abstraction.dynamicHierarchy
          parityObjective := abstraction.parityObjective
          dynamicHierarchy_proof := abstraction.dynamicHierarchy_proof
          parityObjective_proof := abstraction.parityObjective_proof
        }
      realizabilityEquivalent := by
        constructor
        · intro h
          rcases h with ⟨controller, hwins⟩
          exact
            ⟨abstraction.controllerStrategy controller,
              abstraction.sound controller hwins⟩
        · intro h
          rcases h with ⟨σ, hσ⟩
          rcases abstraction.complete σ hσ with ⟨controller, hwins⟩
          exact ⟨controller, hwins⟩
    }

