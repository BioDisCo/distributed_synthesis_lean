    RoundAwareLambdaControllerSelfCompatibleCounterexamplesReflectedByEnvironmentCode
      T initialBoundary historyOne historyTwo fringeOne fringeTwo controller
      historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
      A := by
  intro word hcompatible hreject
  rcases hrepresentRejected word hcompatible hreject with
    ⟨environment, hword⟩
  refine ⟨environment, ?_⟩
  intro hwins
  have haccT :
      T.automaton.Accepts
