      hinit hstep hconsistent start period hperiodPositive
      hstateShift hmoveShift witness hwitnessLt
      hwitnessPriority hcycleLower hpOdd

/--
A coherent abstract round-aware state stream is realized by the finite
environment code induced from its state labels.
-/
theorem roundAwareGameExecution_environmentCodeOfStateStream_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (hinit : stateStream 0 = Sum.inl initialBoundary)
    (hstep :
      ∀ n : Nat,
        stateStream (n + 1) =
          roundAwareGameTransition T controller (stateStream n) (env n))
    (hconsistent :
      ∀ i j : Nat, stateStream i = stateStream j -> env i = env j) :
    roundAwareGameExecution T initialBoundary controller
        (environmentCodeOfStateStream T stateStream env) =
      roundAwareWordOfStateStream T controller stateStream env := by
  funext n
  have hstate :
