                    uniform.noDirectEpochTransformer viewOne viewTwo controller
                    defaultOne defaultTwo)
                  env n)
                (env n))
    (rejectedCompatibleLambdaChoices :
      ∀ controller :
          uniform.noDirectEpochTransformer.RoundAwareLocalControllerCode
            viewOne viewTwo,
        ∀ (env : EnvironmentSequence In₁ In₂)
          (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          FiniteEpochTransformer.RoundAwareLocalControllerCompatibleDecodedExecution
            uniform.noDirectEpochTransformer viewOne viewTwo controller
            (FiniteEpochTransformer.strategyOfRoundAwareLocalController
              uniform.noDirectEpochTransformer viewOne viewTwo controller
              defaultOne defaultTwo)
            env word ->
          ¬ A.Accepts word ->
            ∃ stateStream :
              Nat -> FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer,
              FiniteEpochTransformer.RoundAwareLocalControllerCompatibleDecodedExecutionLambdaChoices
                uniform.noDirectEpochTransformer initialBoundary viewOne viewTwo
                controller
                (FiniteEpochTransformer.strategyOfRoundAwareLocalController
                  uniform.noDirectEpochTransformer viewOne viewTwo controller
                  defaultOne defaultTwo)
                env word stateStream)
    (stateViewDecoders :
      FiniteEpochTransformer.RoundAwareGameExecutionStateViewDecodersSimulateStrategies
        uniform.noDirectEpochTransformer initialBoundary viewOne viewTwo) :
    RoundAwareLocalRotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y} A :=
  ofRejectedCompatibleSynchronizedStateChoicesAndStateViewDecoders
    A Branch Label target targetNonempty
    uniform.noDirectEpochTransformer gameStateDecidable initialBoundary
    automaton_equiv viewOne viewTwo defaultOne defaultTwo
    dynamicHierarchy parityObjective dynamicHierarchy_proof parityObjective_proof
    (fun controller =>
      FiniteEpochTransformer.noDirectEpochStateStream_actualViewStateWitnesses_strategyOf
        uniform initialBoundary viewOne viewTwo controller defaultOne defaultTwo
        (actualViews controller))
    rejectedCompatibleLambdaChoices
    stateViewDecoders

/--
No-direct rotating backend constructor where the rejected-compatible branch is
already given as exact finite environment-code replay.

This is the direct exact-replay variant of
`ofNoDirectActualViewsAndRejectedLambdaChoicesAndStateViewDecoders`.
-/
noncomputable def ofNoDirectActualViewsAndRejectedCompatibleWordsRepresentableAndStateViewDecoders
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (Branch : Proc -> Type b)
    (Label : Proc -> Type x)
    (target :
      (d : Proc) -> InputFreeParityTreeAutomaton.{b, x, y} (Branch d) (Label d))
    (targetNonempty :
      ∀ d : Proc,
        ∃ tree : LabeledTree (Branch d) (Label d),
          (target d).acceptsTree tree)
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (gameStateDecidable :
      DecidableEq (FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer))
    (initialBoundary : uniform.boundary)
    (automaton_equiv :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        uniform.noDirectEpochTransformer.automaton.Accepts word ↔ A.Accepts word)
    (viewOne :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (dynamicHierarchy parityObjective : Prop)
    (dynamicHierarchy_proof : dynamicHierarchy)
    (parityObjective_proof : parityObjective)
    (actualViews :
      ∀ controller :
          uniform.noDirectEpochTransformer.RoundAwareLocalControllerCode
            viewOne viewTwo,
        ∀ env : EnvironmentSequence In₁ In₂,
          ∀ n : Nat,
            viewOne
                (uniform.noDirectEpochStateStream initialBoundary
                  (FiniteEpochTransformer.strategyOfRoundAwareLocalController
                    uniform.noDirectEpochTransformer viewOne viewTwo controller
                    defaultOne defaultTwo)
                  env n)
                (env n) =
              nextView Proc.one
                (executionPrefix
                  (FiniteEpochTransformer.strategyOfRoundAwareLocalController
                    uniform.noDirectEpochTransformer viewOne viewTwo controller
                    defaultOne defaultTwo)
                  env n)
                (env n) ∧
            viewTwo
                (uniform.noDirectEpochStateStream initialBoundary
                  (FiniteEpochTransformer.strategyOfRoundAwareLocalController
                    uniform.noDirectEpochTransformer viewOne viewTwo controller
                    defaultOne defaultTwo)
                  env n)
                (env n) =
              nextView Proc.two
                (executionPrefix
                  (FiniteEpochTransformer.strategyOfRoundAwareLocalController
                    uniform.noDirectEpochTransformer viewOne viewTwo controller
                    defaultOne defaultTwo)
                  env n)
                (env n))
    (representRejectedCompatibleWords :
      ∀ controller :
          uniform.noDirectEpochTransformer.RoundAwareLocalControllerCode
            viewOne viewTwo,
        ∀ (env : EnvironmentSequence In₁ In₂)
          (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          FiniteEpochTransformer.RoundAwareLocalControllerCompatibleDecodedExecution
            uniform.noDirectEpochTransformer viewOne viewTwo controller
            (FiniteEpochTransformer.strategyOfRoundAwareLocalController
              uniform.noDirectEpochTransformer viewOne viewTwo controller
              defaultOne defaultTwo)
            env word ->
          ¬ A.Accepts word ->
            ∃ environment : uniform.noDirectEpochTransformer.EnvironmentCode,
              uniform.noDirectEpochTransformer.roundAwareGameExecution
                initialBoundary controller.1 environment = word)
    (stateViewDecoders :
      FiniteEpochTransformer.RoundAwareGameExecutionStateViewDecodersSimulateStrategies
        uniform.noDirectEpochTransformer initialBoundary viewOne viewTwo) :
    RoundAwareLocalRotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y} A :=
  ofRejectedCompatibleWordsRepresentableAndStateViewDecoders
    A Branch Label target targetNonempty
    uniform.noDirectEpochTransformer gameStateDecidable initialBoundary
    automaton_equiv viewOne viewTwo defaultOne defaultTwo
    dynamicHierarchy parityObjective dynamicHierarchy_proof parityObjective_proof
    (fun controller =>
      FiniteEpochTransformer.noDirectEpochStateStream_actualViewStateWitnesses_strategyOf
        uniform initialBoundary viewOne viewTwo controller defaultOne defaultTwo
        (actualViews controller))
    representRejectedCompatibleWords
    stateViewDecoders

end RoundAwareLocalRotatingRationalRunEpochBackendCertificate

/--
Journal/rational-run backend certificate for one DPA objective.

This is the paper-faithful target for gap2: the rotating rational-run targets
are explicit, their accepted-tree nonemptiness yields rational accepted runs,
and the resulting epoch transformer is accompanied by the two decoded-boundary
proofs needed by `EpochGameAbstractionCertificate.ofTransformerWithDecodedBoundaries`.
-/
structure RotatingRationalRunEpochBackendCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  Branch : Proc -> Type b
  Label : Proc -> Type x
  target :
    (d : Proc) -> InputFreeParityTreeAutomaton.{b, x, y} (Branch d) (Label d)
  targetNonempty :
    ∀ d : Proc,
      ∃ tree : LabeledTree (Branch d) (Label d),
        (target d).acceptsTree tree
  transformer :
    FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂
  gameStateDecidable :
    DecidableEq (FiniteEpochTransformer.GameState transformer)
  initialBoundary : transformer.boundary
  automaton_equiv :
    ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      transformer.automaton.Accepts word ↔ A.Accepts word
  dynamicHierarchy : Prop
  parityObjective : Prop
  dynamicHierarchy_proof : dynamicHierarchy
  parityObjective_proof : parityObjective
  soundBoundary :
    letI : DecidableEq (FiniteEpochTransformer.GameState transformer) :=
      gameStateDecidable
    ∀ controller : transformer.ControllerCode,
      (∀ environment : transformer.EnvironmentCode,
        transformer.gameWins initialBoundary controller environment) ->
        FiniteEpochTransformer.CompatibleDecodedControllerSound
          transformer initialBoundary controller A
  completeBoundary :
    FiniteEpochTransformer.GameExecutionControllerComplete
      transformer initialBoundary A

namespace RotatingRationalRunEpochBackendCertificate

/--
The accepted-tree side of the journal target can always be rationalized by the
regular-tree rational-run lemma.
-/
theorem rationalAccepted
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert :
      RotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y} A)
    (d : Proc) :
    RationalAcceptedBy (cert.target d) := by
  exact rational_run (cert.target d) (cert.targetNonempty d)

/--
Reuse a rotating rational-run backend certificate for a language-equivalent
DPA objective.

The rational tree targets, epoch transformer, finite game, and hierarchy
obligations are unchanged.  Only the semantic DPA objective in the automaton
equivalence and decoded soundness/completeness boundaries is transported.
-/
def transferLanguage
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    {A B : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert :
      RotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y} A)
    (sameLanguage :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        B.Accepts word ↔ A.Accepts word) :
    RotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y} B where
  Branch := cert.Branch
  Label := cert.Label
  target := cert.target
  targetNonempty := cert.targetNonempty
  transformer := cert.transformer
  gameStateDecidable := cert.gameStateDecidable
  initialBoundary := cert.initialBoundary
  automaton_equiv := by
    intro word
    constructor
    · intro hword
      exact (sameLanguage word).mpr ((cert.automaton_equiv word).mp hword)
    · intro hword
      exact (cert.automaton_equiv word).mpr ((sameLanguage word).mp hword)
  dynamicHierarchy := cert.dynamicHierarchy
  parityObjective := cert.parityObjective
  dynamicHierarchy_proof := cert.dynamicHierarchy_proof
  parityObjective_proof := cert.parityObjective_proof
  soundBoundary := by
    letI : DecidableEq (FiniteEpochTransformer.GameState cert.transformer) :=
      cert.gameStateDecidable
    intro controller hwins
    exact
      FiniteEpochTransformer.compatibleDecodedControllerSound_transferLanguage
        cert.transformer cert.initialBoundary controller
        (cert.soundBoundary controller hwins)
        sameLanguage
  completeBoundary := by
    exact
      FiniteEpochTransformer.gameExecutionControllerComplete_transferLanguage
        cert.transformer cert.initialBoundary cert.completeBoundary
        sameLanguage

/-- A rotating rational-run backend certificate also compiles the priority-normalized DPA. -/
def shiftPriorityTwo
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert :
      RotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y} A) :
    RotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y}
      (A.shiftPriority 2) :=
  cert.transferLanguage
    (fun word => DetParityAutomaton.shiftPriority_two_accepts_iff A word)

/--
Build the journal/rational-run backend certificate from the two exact
paper-facing handoff obligations currently consumed by the main LTL route:
compatible decoded executions are representable by finite environment codes,
and real winning distributed strategies have finite-game controllers.

This is the narrowest constructor currently exposed at the
rotating-rational-run layer.  Coherent streams, synchronized choices,
controller simulation, and matching controllers remain useful stronger ways to
prove these two fields.
-/
noncomputable def ofRepresentableSound
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (Branch : Proc -> Type b)
    (Label : Proc -> Type x)
    (target :
      (d : Proc) -> InputFreeParityTreeAutomaton.{b, x, y} (Branch d) (Label d))
    (targetNonempty :
      ∀ d : Proc,
        ∃ tree : LabeledTree (Branch d) (Label d),
          (target d).acceptsTree tree)
    (transformer :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    [DecidableEq (FiniteEpochTransformer.GameState transformer)]
    (initialBoundary : transformer.boundary)
    (automaton_equiv :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        transformer.automaton.Accepts word ↔ A.Accepts word)
    (dynamicHierarchy parityObjective : Prop)
    (dynamicHierarchy_proof : dynamicHierarchy)
    (parityObjective_proof : parityObjective)
    (representable :
      ∀ controller : transformer.ControllerCode,
        FiniteEpochTransformer.CompatibleDecodedExecutionRepresentable
          transformer initialBoundary controller)
    (completeBoundary :
      FiniteEpochTransformer.GameExecutionControllerComplete
        transformer initialBoundary A) :
    RotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y} A where
  Branch := Branch
  Label := Label
  target := target
  targetNonempty := targetNonempty
  transformer := transformer
  gameStateDecidable := inferInstance
  initialBoundary := initialBoundary
  automaton_equiv := automaton_equiv
  dynamicHierarchy := dynamicHierarchy
  parityObjective := parityObjective
  dynamicHierarchy_proof := dynamicHierarchy_proof
  parityObjective_proof := parityObjective_proof
  soundBoundary := by
    intro controller hwins
    exact
      FiniteEpochTransformer.compatibleDecodedControllerSound_of_gameWins_and_representable
        transformer initialBoundary controller A automaton_equiv hwins
        (representable controller)
  completeBoundary := completeBoundary

