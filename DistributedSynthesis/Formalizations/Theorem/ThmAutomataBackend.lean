/--
An APA language certificate, after certified determinization and finite-game
compilation of the resulting DPA, induces an effective parity specification for
the APA's initial language.
-/
def APAToDPACompilation.toEffectiveParitySpecification
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : AlternatingParityAutomaton.{max u v w a, b}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {apaCert : A.LanguageCertificate}
    (det : APAToDPACompilation.{max u v w a, b, x} A apaCert)
    (gameCompilation :
      DPAToFiniteGameCompilation.{u, v, w, a, y} Out₂ det.dpa) :
    EffectiveParitySpecification.{u, v, w, a, y, max u v w a} In₁ In₂ Out₁ Out₂ where
  predicate := fun word => word ∈ apaCert.initialLanguage
  finiteGame := gameCompilation.finiteGame
  realizabilityEquivalent := by
    rw [gameCompilation.realizabilityEquivalent]
    constructor
    · intro h
      rcases h with ⟨σ, hσ⟩
      exact ⟨σ, fun env => (det.correct (execution σ env)).mp (hσ env)⟩
    · intro h
      rcases h with ⟨σ, hσ⟩
      exact ⟨σ, fun env => (det.correct (execution σ env)).mpr (hσ env)⟩

