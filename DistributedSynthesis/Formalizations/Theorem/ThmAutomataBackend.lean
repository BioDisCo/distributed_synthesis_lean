the environment is read from the candidate word itself.
-/
theorem roundAwareLambdaController_rejectedSelfCompatibleWordsRepresentable_of_synchronizedStateChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hsync :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
          RoundAwareLambdaControllerSelfCompatibleExecution
            T historyOne historyTwo fringeOne fringeTwo controller
            historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
            word ->
          ¬ A.Accepts word ->
            ∃ stateStream : Nat -> GameState T,
              RoundAwareLambdaControllerSelfCompatibleExecutionSynchronizedStateChoices
                T initialBoundary
                historyOne historyTwo fringeOne fringeTwo controller
                historyOfViewOne historyOfViewTwo
                fringeOfViewOne fringeOfViewTwo
                word stateStream) :
    ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        RoundAwareLambdaControllerSelfCompatibleExecution
          T historyOne historyTwo fringeOne fringeTwo controller
          historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
          word ->
        ¬ A.Accepts word ->
          ∃ environment : EnvironmentCode T,
            roundAwareGameExecution T initialBoundary controller.1
              environment =
              word := by
  intro word hcompatible hreject
  rcases hsync word hcompatible hreject with ⟨stateStream, hstream⟩
  rcases hstream with ⟨hinit, hstep, hconsistent, hchoice⟩
  let env := environmentSequenceOfWord word
  let environment := environmentCodeOfStateStream T stateStream env
  refine ⟨environment, ?_⟩
  funext n
  have hstate :
      roundAwareGameStateStream T initialBoundary controller.1
          environment n =
        stateStream n :=
    roundAwareGameStateStream_environmentCodeOfStateStream_eq
      T initialBoundary controller.1 stateStream env
      hinit hstep hconsistent n
  have henv :
      environment (stateStream n) = env n :=
    environmentCodeOfStateStream_apply_of_consistent
      T stateStream env hconsistent n
  rw [(hchoice n).2.2.2.2]
  simp [roundAwareGameExecution, environment, env, hstate, henv,
    environmentSequenceOfWord, environmentRoundOfWord]

