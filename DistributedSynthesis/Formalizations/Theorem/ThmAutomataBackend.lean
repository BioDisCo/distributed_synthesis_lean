        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (hsync :
      RoundAwareLocalControllerCompatibleDecodedExecutionSynchronizedStateChoices
        T initialBoundary viewOne viewTwo controller σ env word stateStream) :
    RoundAwareLocalControllerCompatibleDecodedExecution
      T viewOne viewTwo controller σ env word := by
  intro n
  rcases hsync with ⟨_hinit, _hstep, _hconsistent, hchoice⟩
  exact
    ⟨stateStream n,
      (hchoice n).1,
      stateStream n,
      (hchoice n).2.1,
      (hchoice n).2.2⟩

/--
Actual lambda-choice streams already contain the actual local-view witnesses.

This removes one independent obligation from the local finite-retraction
target: if the concrete epoch construction can supply a synchronized
lambda/state stream for the real execution of the decoded strategy, then the
two pointwise finite states decoding the actual process views are just that
same synchronized state.
-/
theorem roundAwareLocalControllerActualViewStateWitnesses_of_actualLambdaChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (hactualLambda :
      ∀ env : EnvironmentSequence In₁ In₂,
        ∃ stateStream : Nat -> GameState T,
          RoundAwareLocalControllerCompatibleDecodedExecutionLambdaChoices
            T initialBoundary viewOne viewTwo controller σ env
            (execution σ env) stateStream) :
    RoundAwareLocalControllerActualViewStateWitnesses
      T viewOne viewTwo σ := by
  intro env n
  rcases hactualLambda env with ⟨stateStream, hstream⟩
  rcases hstream with ⟨_hinit, _hstep, _hconsistent, hchoice⟩
  exact
    ⟨⟨stateStream n, (hchoice n).1⟩,
      ⟨stateStream n, (hchoice n).2.1⟩⟩

/--
A synchronized finite state/lambda stream already determines an exact finite
environment-code replay of the decoded word.

This is the purely operational core of rejected-compatible replay: no
automaton rejection or language-equivalence hypothesis is used once the
synchronized stream has supplied the initial state, transition, repeat
consistency, and per-round word equation.
-/
theorem roundAwareLocalController_wordRepresentable_of_synchronizedStateChoices
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (hstream :
      RoundAwareLocalControllerCompatibleDecodedExecutionSynchronizedStateChoices
        T initialBoundary viewOne viewTwo controller σ env word stateStream) :
    ∃ environment : EnvironmentCode T,
      roundAwareGameExecution T initialBoundary controller.1 environment =
        word := by
  rcases hstream with ⟨hinit, hstep, hconsistent, hchoice⟩
  let environment := environmentCodeOfStateStream T stateStream env
  refine ⟨environment, ?_⟩
  funext n
  have hstate :
      roundAwareGameStateStream T initialBoundary controller.1
          environment n =
        stateStream n :=
    roundAwareGameStateStream_environmentCodeOfStateStream_eq
      T initialBoundary controller.1 stateStream env
      hinit hstep hconsistent n
  have henv :
      environment (stateStream n) = env n :=
    environmentCodeOfStateStream_apply_of_consistent
      T stateStream env hconsistent n
  rw [(hchoice n).2.2]
  simp [roundAwareGameExecution, nextRound, environment, hstate, henv]

