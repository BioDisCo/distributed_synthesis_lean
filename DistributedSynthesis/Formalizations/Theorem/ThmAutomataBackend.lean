        transformer.automaton.Accepts word ↔ A.Accepts word)
    (dynamicHierarchy parityObjective : Prop)
    (dynamicHierarchy_proof : dynamicHierarchy)
    (parityObjective_proof : parityObjective)
    (coherentStateStreams :
      ∀ controller : transformer.ControllerCode,
        FiniteEpochTransformer.CompatibleDecodedControllerCoherentStateStreams
          transformer initialBoundary controller)
    (simulationBoundary :
      ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∃ controller : transformer.ControllerCode,
          FiniteEpochTransformer.GameExecutionControllerSimulatesStrategy
            transformer initialBoundary controller σ) :
    DPAToFiniteGameCompilation.{u, v, w, a, max u v w a} Out₂ A :=
