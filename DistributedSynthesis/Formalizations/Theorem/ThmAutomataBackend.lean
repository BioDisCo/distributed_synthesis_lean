        stateStream (start + period + m) = stateStream (start + m))
    (hmoveShift :
      ∀ m : Nat,
        moveStream (start + period + m) = moveStream (start + m))
    (witness : Nat)
    (hwitnessLt : witness < period)
    {p : Nat}
    (hwitnessPriority :
