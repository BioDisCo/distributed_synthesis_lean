      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        (d : Proc) -> InputFreeParityTreeAutomaton.{b, x, y}
          (Branch A d) (Label A d))
    (targetNonempty :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ d : Proc,
          ∃ tree : LabeledTree (Branch A d) (Label A d),
            (target A d).acceptsTree tree)
    (H₁ :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        Type b)
    (H₂ :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        Type x)
    (R₁ :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        Type y)
    (R₂ :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        Type z)
    (transformer :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        (transformer A).boundary)
    (automaton_equiv :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
          (transformer A).automaton.Accepts word ↔ A.Accepts word)
    (historyOne :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        FiniteEpochTransformer.GameState (transformer A) ->
          EnvironmentRound In₁ In₂ -> List (H₁ A))
    (historyTwo :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        FiniteEpochTransformer.GameState (transformer A) ->
          EnvironmentRound In₁ In₂ -> List (H₂ A))
    (fringeOne :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        FiniteEpochTransformer.GameState (transformer A) ->
          EnvironmentRound In₁ In₂ -> R₁ A)
    (fringeTwo :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        FiniteEpochTransformer.GameState (transformer A) ->
          EnvironmentRound In₁ In₂ -> R₂ A)
    (historyOfViewOne :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        View In₁ In₂ Proc.one -> List (H₁ A))
    (historyOfViewTwo :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        View In₁ In₂ Proc.two -> List (H₂ A))
    (fringeOfViewOne :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        View In₁ In₂ Proc.one -> R₁ A)
    (fringeOfViewTwo :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        View In₁ In₂ Proc.two -> R₂ A)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (dynamicHierarchy parityObjective :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        Prop)
    (dynamicHierarchy_proof :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        dynamicHierarchy A)
    (parityObjective_proof :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        parityObjective A)
    (actualFiniteViewStateWitnesses :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ controller :
          (transformer A).RoundAwareLambdaControllerCode
            (historyOne A) (historyTwo A) (fringeOne A) (fringeTwo A),
          FiniteEpochTransformer.RoundAwareLambdaControllerActualFiniteViewStateWitnesses
            (transformer A) (historyOne A) (historyTwo A)
            (fringeOne A) (fringeTwo A)
            (historyOfViewOne A) (historyOfViewTwo A)
            (fringeOfViewOne A) (fringeOfViewTwo A)
            (FiniteEpochTransformer.strategyOfRoundAwareLambdaController
              (transformer A) (historyOne A) (historyTwo A)
              (fringeOne A) (fringeTwo A) controller
              (historyOfViewOne A) (historyOfViewTwo A)
              (fringeOfViewOne A) (fringeOfViewTwo A)
              defaultOne defaultTwo))
    (rejectedSelfCompatibleLambdaChoices :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ controller :
          (transformer A).RoundAwareLambdaControllerCode
            (historyOne A) (historyTwo A) (fringeOne A) (fringeTwo A),
          ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
            FiniteEpochTransformer.RoundAwareLambdaControllerSelfCompatibleExecution
              (transformer A) (historyOne A) (historyTwo A)
              (fringeOne A) (fringeTwo A) controller
              (historyOfViewOne A) (historyOfViewTwo A)
              (fringeOfViewOne A) (fringeOfViewTwo A)
              word ->
            ¬ A.Accepts word ->
              ∃ stateStream : Nat -> FiniteEpochTransformer.GameState (transformer A),
                FiniteEpochTransformer.RoundAwareLambdaControllerSelfCompatibleExecutionLambdaChoices
                  (transformer A) (initialBoundary A)
                  (historyOne A) (historyTwo A)
                  (fringeOne A) (fringeTwo A) controller
                  (historyOfViewOne A) (historyOfViewTwo A)
                  (fringeOfViewOne A) (fringeOfViewTwo A)
                  word stateStream)
    (matchingControllers :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
          ∃ controller :
            (transformer A).RoundAwareLambdaControllerCode
              (historyOne A) (historyTwo A) (fringeOne A) (fringeTwo A),
            FiniteEpochTransformer.RoundAwareLambdaControllerStrategyMatchesFiniteViews
              (transformer A) (historyOne A) (historyTwo A)
              (fringeOne A) (fringeTwo A) controller
              (historyOfViewOne A) (historyOfViewTwo A)
              (fringeOfViewOne A) (fringeOfViewTwo A) σ ∧
            ∀ environment : (transformer A).EnvironmentCode,
              ∀ n : Nat,
                let env : EnvironmentSequence In₁ In₂ :=
                  (transformer A).roundAwareEnvironmentSequenceOfGamePlay
                    (initialBoundary A) controller.1 environment
                let state :=
                  (transformer A).roundAwareGameStateStream
                    (initialBoundary A) controller.1 environment n
                let envRound := environment state
                historyOne A state envRound =
                    historyOfViewOne A
                      (nextView Proc.one
                        (executionPrefix σ env n) (env n)) ∧
                  fringeOne A state envRound =
                    fringeOfViewOne A
                      (nextView Proc.one
                        (executionPrefix σ env n) (env n)) ∧
                  historyTwo A state envRound =
                    historyOfViewTwo A
                      (nextView Proc.two
                        (executionPrefix σ env n) (env n)) ∧
                  fringeTwo A state envRound =
                    fringeOfViewTwo A
                      (nextView Proc.two
                        (executionPrefix σ env n) (env n))) :
    DPARoundAwareLambdaRotatingRationalRunEpochCompiler.{u, v, w, a, b, x, y, z}
      In₁ In₂ Out₁ Out₂ where
  compile := fun A =>
    RoundAwareLambdaRotatingRationalRunEpochBackendCertificate.ofRejectedSelfCompatibleLambdaChoicesAndFiniteViewStateDecoders
      A (Branch A) (Label A) (target A) (targetNonempty A)
      (transformer A) (initialBoundary A) (automaton_equiv A)
      (historyOne A) (historyTwo A) (fringeOne A) (fringeTwo A)
      (historyOfViewOne A) (historyOfViewTwo A)
      (fringeOfViewOne A) (fringeOfViewTwo A)
      defaultOne defaultTwo
      (dynamicHierarchy A) (parityObjective A)
      (dynamicHierarchy_proof A) (parityObjective_proof A)
      (actualFiniteViewStateWitnesses A)
      (rejectedSelfCompatibleLambdaChoices A)
      (matchingControllers A)

end DPARoundAwareLambdaRotatingRationalRunEpochCompiler

/--
Uniform local-observable round-aware rotating rational-run backend for
deterministic parity objectives.

This is the finite-game compiler: it keeps the rotating
rational-run target data but exposes the finite game through locally observable
round-aware controllers.
-/
structure DPARoundAwareLocalRotatingRationalRunEpochCompiler
    (In₁ : Type u)
    (In₂ : Type v)
    (Out₁ : Type w)
    (Out₂ : Type a)
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂] where
  compile :
    ∀ A : DetParityAutomaton.{max u v w a, z}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      RoundAwareLocalRotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y} A

namespace DPARoundAwareLocalRotatingRationalRunEpochCompiler

/-- Forget the local rotating internals and expose the finite-game compiler. -/
noncomputable def toDPAFiniteGameCompiler
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (compiler :
      DPARoundAwareLocalRotatingRationalRunEpochCompiler.{u, v, w, a, b, x, y, z}
        In₁ In₂ Out₁ Out₂) :
    DPAFiniteGameCompiler.{u, v, w, a, max u v w a, z}
      In₁ In₂ Out₁ Out₂ where
  compile := fun A => (compiler.compile A).toDPAToFiniteGameCompilation

