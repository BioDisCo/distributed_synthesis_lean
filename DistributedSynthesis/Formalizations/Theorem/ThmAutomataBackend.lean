      fringeOfViewOne fringeOfViewTwo
      defaultOne defaultTwo
      dynamicHierarchy parityObjective
      dynamicHierarchy_proof parityObjective_proof
      actualLambdaChoices
      matchingControllers)

/-- The accepted-tree side is unchanged by the lambda-local finite game. -/
theorem rationalAccepted
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert :
      RoundAwareLambdaRotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y, z} A)
    (d : Proc) :
    RationalAcceptedBy (cert.target d) := by
  exact rational_run (cert.target d) (cert.targetNonempty d)

/-- The lambda-local rotating backend directly yields a finite-game compilation. -/
noncomputable def toDPAToFiniteGameCompilation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert :
      RoundAwareLambdaRotatingRationalRunEpochBackendCertificate.{u, v, w, a, b, x, y, z} A) :
    DPAToFiniteGameCompilation.{u, v, w, a, max u v w a} Out₂ A :=
  cert.epoch.toDPAToFiniteGameCompilation

end RoundAwareLambdaRotatingRationalRunEpochBackendCertificate

/--
Round-aware epoch-game certificate using the locally observable controller
subtype as the finite controller carrier.

This is the corrected certificate shape after the raw-controller obstruction:
the finite game ranges over controllers whose two outputs respect the decoded
local-view equivalence induced by `viewOne` and `viewTwo`.
-/
structure RoundAwareLocalEpochGameAbstractionCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  transformer :
    FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂
  initialBoundary : transformer.boundary
  viewOne :
    FiniteEpochTransformer.GameState transformer ->
      EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one
  viewTwo :
    FiniteEpochTransformer.GameState transformer ->
      EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two
  winsDecidable :
    ∀ controller : transformer.RoundAwareLocalControllerCode viewOne viewTwo,
      ∀ environment : transformer.EnvironmentCode,
        Decidable
          (transformer.roundAwareGameWins
            initialBoundary controller.1 environment)
  controllerStrategy :
    transformer.RoundAwareLocalControllerCode viewOne viewTwo ->
      StrategyPair In₁ In₂ Out₁ Out₂
  dynamicHierarchy : Prop
  parityObjective : Prop
  dynamicHierarchy_proof : dynamicHierarchy
  parityObjective_proof : parityObjective
  sound :
    ∀ controller,
      (∀ environment : transformer.EnvironmentCode,
        transformer.roundAwareGameWins
          initialBoundary controller.1 environment) ->
        ∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution (controllerStrategy controller) env)
  complete :
    ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      (∀ env : EnvironmentSequence In₁ In₂, A.Accepts (execution σ env)) ->
        ∃ controller : transformer.RoundAwareLocalControllerCode viewOne viewTwo,
          ∀ environment : transformer.EnvironmentCode,
            transformer.roundAwareGameWins
              initialBoundary controller.1 environment

namespace RoundAwareLocalEpochGameAbstractionCertificate

/--
Build the locally observable round-aware certificate from semantic soundness
and completeness, filling fixed-play decidability from the finite state loop.
-/
noncomputable def ofTransformer
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (transformer :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : transformer.boundary)
    (viewOne :
      FiniteEpochTransformer.GameState transformer ->
        EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      FiniteEpochTransformer.GameState transformer ->
        EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controllerStrategy :
      transformer.RoundAwareLocalControllerCode viewOne viewTwo ->
        StrategyPair In₁ In₂ Out₁ Out₂)
    (dynamicHierarchy parityObjective : Prop)
    (dynamicHierarchy_proof : dynamicHierarchy)
    (parityObjective_proof : parityObjective)
    (sound :
      ∀ controller,
        (∀ environment : transformer.EnvironmentCode,
          transformer.roundAwareGameWins
            initialBoundary controller.1 environment) ->
          ∀ env : EnvironmentSequence In₁ In₂,
            A.Accepts (execution (controllerStrategy controller) env))
    (complete :
      ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        (∀ env : EnvironmentSequence In₁ In₂, A.Accepts (execution σ env)) ->
          ∃ controller : transformer.RoundAwareLocalControllerCode viewOne viewTwo,
            ∀ environment : transformer.EnvironmentCode,
              transformer.roundAwareGameWins
                initialBoundary controller.1 environment) :
    RoundAwareLocalEpochGameAbstractionCertificate.{u, v, w, a} A where
  transformer := transformer
  initialBoundary := initialBoundary
  viewOne := viewOne
  viewTwo := viewTwo
  winsDecidable :=
    fun controller environment =>
      transformer.roundAwareGameWinsDecidableByStateLoop
        initialBoundary controller.1 environment
  controllerStrategy := controllerStrategy
  dynamicHierarchy := dynamicHierarchy
  parityObjective := parityObjective
  dynamicHierarchy_proof := dynamicHierarchy_proof
  parityObjective_proof := parityObjective_proof
  sound := sound
  complete := complete

/--
Build the locally observable round-aware certificate from an explicit semantic
soundness bridge and round-aware state-view decoders for completeness.
-/
noncomputable def ofTransformerWithSoundAndStateViewDecoders
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (transformer :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : transformer.boundary)
    (hautomaton :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        transformer.automaton.Accepts word ↔ A.Accepts word)
    (viewOne :
      FiniteEpochTransformer.GameState transformer ->
        EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      FiniteEpochTransformer.GameState transformer ->
        EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controllerStrategy :
      transformer.RoundAwareLocalControllerCode viewOne viewTwo ->
        StrategyPair In₁ In₂ Out₁ Out₂)
    (dynamicHierarchy parityObjective : Prop)
    (dynamicHierarchy_proof : dynamicHierarchy)
    (parityObjective_proof : parityObjective)
    (sound :
      ∀ controller,
        (∀ environment : transformer.EnvironmentCode,
          transformer.roundAwareGameWins
            initialBoundary controller.1 environment) ->
          ∀ env : EnvironmentSequence In₁ In₂,
            A.Accepts (execution (controllerStrategy controller) env))
    (stateViewDecoders :
      FiniteEpochTransformer.RoundAwareGameExecutionStateViewDecodersSimulateStrategies
        transformer initialBoundary viewOne viewTwo) :
    RoundAwareLocalEpochGameAbstractionCertificate.{u, v, w, a} A :=
  ofTransformer A transformer initialBoundary viewOne viewTwo controllerStrategy
    dynamicHierarchy parityObjective
    dynamicHierarchy_proof parityObjective_proof
    sound
    (fun σ hσ => by
      let rawController : transformer.RoundAwareControllerCode :=
        fun state envRound =>
          (σ.one (viewOne state envRound),
            σ.two (viewTwo state envRound))
      let localController :
          transformer.RoundAwareLocalControllerCode viewOne viewTwo :=
        ⟨rawController,
          FiniteEpochTransformer.roundAwareControllerLocallyObservable_of_strategy
            transformer viewOne viewTwo σ⟩
      refine ⟨localController, ?_⟩
      intro environment
      have hmatch :
          FiniteEpochTransformer.RoundAwareGameExecutionMatchesStrategyForEnvironment
            transformer initialBoundary rawController environment σ := by
        intro n
        let env : EnvironmentSequence In₁ In₂ :=
          FiniteEpochTransformer.roundAwareEnvironmentSequenceOfGamePlay
            transformer initialBoundary rawController environment
        let state :=
          FiniteEpochTransformer.roundAwareGameStateStream
            transformer initialBoundary rawController environment n
        let envRound := environment state
        have hview := stateViewDecoders σ environment n
        constructor
        · change
            σ.one (viewOne state envRound) =
              σ.one (nextView Proc.one (executionPrefix σ env n) (env n))
          rw [hview.1]
        · change
            σ.two (viewTwo state envRound) =
              σ.two (nextView Proc.two (executionPrefix σ env n) (env n))
          rw [hview.2]
      have hacc :
          A.Accepts
            (transformer.roundAwareGameExecution
              initialBoundary rawController environment) := by
        rw [FiniteEpochTransformer.roundAwareGameExecution_eq_execution_of_matchesStrategyForEnvironment
          transformer initialBoundary rawController environment σ hmatch]
        exact hσ
          (FiniteEpochTransformer.roundAwareEnvironmentSequenceOfGamePlay
            transformer initialBoundary rawController environment)
      exact
        (FiniteEpochTransformer.roundAwareGameWins_iff_accepts_of_automaton_equiv
          transformer initialBoundary rawController environment A hautomaton).mpr
          hacc)

/--
Build the locally observable round-aware certificate from subtype
representability and round-aware state-view decoders.
-/
noncomputable def ofTransformerWithRepresentableSoundAndStateViewDecoders
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (transformer :
      FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : transformer.boundary)
    (hautomaton :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        transformer.automaton.Accepts word ↔ A.Accepts word)
    (viewOne :
      FiniteEpochTransformer.GameState transformer ->
