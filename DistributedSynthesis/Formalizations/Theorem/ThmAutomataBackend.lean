      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        dynamicHierarchy A)
    (parityObjective_proof :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        parityObjective A)
    (synchronizedChoices :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        letI : DecidableEq (FiniteEpochTransformer.GameState (transformer A)) :=
          gameStateDecidable A
        ∀ controller : (transformer A).ControllerCode,
          ∀ (env : EnvironmentSequence In₁ In₂)
            (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
              FiniteEpochTransformer.CompatibleDecodedExecution
                (transformer A) (initialBoundary A) controller env word ->
                ∃ stateStream : Nat -> FiniteEpochTransformer.GameState (transformer A),
                  FiniteEpochTransformer.CompatibleDecodedExecutionSynchronizedStateChoices
                    (transformer A) (initialBoundary A) controller env word stateStream)
    (matchingControllers :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        letI : DecidableEq (FiniteEpochTransformer.GameState (transformer A)) :=
          gameStateDecidable A
        FiniteEpochTransformer.GameExecutionStrategiesHaveMatchingControllers
          (transformer A) (initialBoundary A)) :
    DPARotatingRationalRunEpochCompiler.{u, v, w, a, b, x, y, z}
      In₁ In₂ Out₁ Out₂ where
  compile := by
    intro A
    letI : DecidableEq (FiniteEpochTransformer.GameState (transformer A)) :=
      gameStateDecidable A
    exact
      RotatingRationalRunEpochBackendCertificate.ofSynchronizedStateChoicesAndMatchingControllers
          A (Branch A) (Label A) (target A) (targetNonempty A)
          (transformer A) (initialBoundary A) (automaton_equiv A)
          (dynamicHierarchy A) (parityObjective A)
          (dynamicHierarchy_proof A) (parityObjective_proof A)
          (synchronizedChoices A) (matchingControllers A)

/--
Uniform rotating-rational-run compiler from synchronized decoded state choices
and the standard controller-simulation completeness boundary.

This is the same compiler-level packaging as
`ofSynchronizedStateChoicesAndMatchingControllers`, but stops at the simulation
boundary instead of requiring pointwise matching finite controllers.
-/
noncomputable def ofSynchronizedStateChoicesAndControllerSimulation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (Branch :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        Proc -> Type b)
    (Label :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        Proc -> Type x)
    (target :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        (d : Proc) -> InputFreeParityTreeAutomaton.{b, x, y}
          (Branch A d) (Label A d))
    (targetNonempty :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ d : Proc,
          ∃ tree : LabeledTree (Branch A d) (Label A d),
            (target A d).acceptsTree tree)
    (transformer :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (gameStateDecidable :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        DecidableEq (FiniteEpochTransformer.GameState (transformer A)))
    (initialBoundary :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        (transformer A).boundary)
    (automaton_equiv :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
          (transformer A).automaton.Accepts word ↔ A.Accepts word)
    (dynamicHierarchy parityObjective :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        Prop)
    (dynamicHierarchy_proof :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        dynamicHierarchy A)
    (parityObjective_proof :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        parityObjective A)
    (synchronizedChoices :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        letI : DecidableEq (FiniteEpochTransformer.GameState (transformer A)) :=
          gameStateDecidable A
        ∀ controller : (transformer A).ControllerCode,
          ∀ (env : EnvironmentSequence In₁ In₂)
            (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
              FiniteEpochTransformer.CompatibleDecodedExecution
                (transformer A) (initialBoundary A) controller env word ->
                ∃ stateStream : Nat -> FiniteEpochTransformer.GameState (transformer A),
                  FiniteEpochTransformer.CompatibleDecodedExecutionSynchronizedStateChoices
                    (transformer A) (initialBoundary A) controller env word stateStream)
    (simulationBoundary :
      ∀ A : DetParityAutomaton.{max u v w a, z}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        letI : DecidableEq (FiniteEpochTransformer.GameState (transformer A)) :=
          gameStateDecidable A
        ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
          ∃ controller : (transformer A).ControllerCode,
            FiniteEpochTransformer.GameExecutionControllerSimulatesStrategy
              (transformer A) (initialBoundary A) controller σ) :
    DPARotatingRationalRunEpochCompiler.{u, v, w, a, b, x, y, z}
      In₁ In₂ Out₁ Out₂ where
  compile := by
    intro A
    letI : DecidableEq (FiniteEpochTransformer.GameState (transformer A)) :=
      gameStateDecidable A
    exact
      RotatingRationalRunEpochBackendCertificate.ofSynchronizedStateChoicesAndControllerSimulation
          A (Branch A) (Label A) (target A) (targetNonempty A)
          (transformer A) (initialBoundary A) (automaton_equiv A)
          (dynamicHierarchy A) (parityObjective A)
          (dynamicHierarchy_proof A) (parityObjective_proof A)
          (synchronizedChoices A) (simulationBoundary A)

end DPARotatingRationalRunEpochCompiler

/--
A uniform epoch-game compiler induces the ordinary DPA finite-game compiler.
-/
noncomputable def DPAEpochGameCompiler.toDPAFiniteGameCompiler
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (compiler :
      DPAEpochGameCompiler.{u, v, w, a, x} In₁ In₂ Out₁ Out₂) :
    DPAFiniteGameCompiler.{u, v, w, a, max u v w a, x}
      In₁ In₂ Out₁ Out₂ where
  compile := fun A => (compiler.compile A).toDPAToFiniteGameCompilation

/--
Reuse an epoch-game abstraction certificate for a language-equivalent DPA.

The transformer, finite epoch game, controller decoding, and all paper-facing
epoch obligations stay unchanged.  Only the semantic objective in the sound and
complete fields is transported across the DPA language equivalence.
-/
def EpochGameAbstractionCertificate.transferLanguage
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    {A B : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert : EpochGameAbstractionCertificate.{u, v, w, a} A)
    (sameLanguage :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        B.Accepts word ↔ A.Accepts word) :
    EpochGameAbstractionCertificate.{u, v, w, a} B where
  transformer := cert.transformer
  initialBoundary := cert.initialBoundary
  winsDecidable := cert.winsDecidable
  controllerStrategy := cert.controllerStrategy
  dynamicHierarchy := cert.dynamicHierarchy
  parityObjective := cert.parityObjective
  dynamicHierarchy_proof := cert.dynamicHierarchy_proof
  parityObjective_proof := cert.parityObjective_proof
  sound := by
    intro controller hwins env
    exact
      (sameLanguage (execution (cert.controllerStrategy controller) env)).mpr
        (cert.sound controller hwins env)
  complete := by
    intro σ hσ
    exact
      cert.complete σ
        (fun env => (sameLanguage (execution σ env)).mp (hσ env))

/-- An epoch-game abstraction certificate also compiles the priority-normalized DPA. -/
def EpochGameAbstractionCertificate.shiftPriorityTwo
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
