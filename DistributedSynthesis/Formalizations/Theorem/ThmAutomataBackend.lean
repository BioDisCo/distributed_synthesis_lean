    roundAwareGameStateStream_environmentCodeOfStateStream_eq
      T initialBoundary controller stateStream env
      hinit hstep hconsistent n
  have henv :
      environmentCodeOfStateStream T stateStream env (stateStream n) = env n :=
    environmentCodeOfStateStream_apply_of_consistent
      T stateStream env hconsistent n
  simp [roundAwareGameExecution, roundAwareWordOfStateStream, hstate, henv]

/--
