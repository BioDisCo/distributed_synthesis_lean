/--
The same DPA objective, evaluated after a finite prefix by carrying the DPA
state reached after `n` letters and reading the suffix from that state.
-/
def dpaSpecificationAfterPrefix
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (n : Nat) :
    Specification In₁ In₂ Out₁ Out₂ :=
  fun word => A.AcceptsFrom (A.run word n) (OmegaWord.drop word n)

/--
Tracking the DPA state for any finite prefix and then evaluating the remaining
suffix is equivalent to evaluating the original DPA objective from the initial
state.
-/
theorem dpaSpecificationAfterPrefix_iff
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (n : Nat)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)) :
    dpaSpecificationAfterPrefix A n word ↔ dpaSpecification A word := by
  change
    A.AcceptsFrom (A.runFrom A.initial word n) (OmegaWord.drop word n) ↔
      A.AcceptsFrom A.initial word
  exact DetParityAutomaton.acceptsFrom_runFrom_drop_iff A A.initial word n

/--
A tracking-style finite-game compilation is an ordinary DPA finite-game
compilation, because the tracked-prefix DPA objective is equivalent to the
initial-state objective.
-/
def DPATrackingFiniteGameCompilation.toDPAToFiniteGameCompilation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (compilation :
      DPATrackingFiniteGameCompilation.{u, v, w, a, b} Out₂ A) :
    DPAToFiniteGameCompilation.{u, v, w, a, b} Out₂ A where
  finiteGame := compilation.finiteGame
  realizabilityEquivalent := by
    rw [compilation.trackingRealizabilityEquivalent]
    constructor
    · intro h
      rcases h with ⟨σ, hσ⟩
      exact
        ⟨σ, fun env =>
          (dpaSpecificationAfterPrefix_iff
              A compilation.prefixLength (execution σ env)).mp (hσ env)⟩
    · intro h
      rcases h with ⟨σ, hσ⟩
      exact
        ⟨σ, fun env =>
          (dpaSpecificationAfterPrefix_iff
              A compilation.prefixLength (execution σ env)).mpr (hσ env)⟩

/--
An ordinary finite-game compilation is a tracking-style compilation with
prefix length zero.

This bridge keeps the two DPA finite-game interfaces interchangeable when no
nontrivial prefix tracking is needed.
-/
def DPAToFiniteGameCompilation.toTrackingFiniteGameCompilation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (compilation : DPAToFiniteGameCompilation.{u, v, w, a, b} Out₂ A) :
    DPATrackingFiniteGameCompilation.{u, v, w, a, b} Out₂ A where
  prefixLength := 0
  finiteGame := compilation.finiteGame
  trackingRealizabilityEquivalent := by
    rw [compilation.realizabilityEquivalent]
    constructor
    · intro h
      rcases h with ⟨σ, hσ⟩
      exact
        ⟨σ, fun env =>
          (dpaSpecificationAfterPrefix_iff A 0 (execution σ env)).mpr
            (hσ env)⟩
    · intro h
      rcases h with ⟨σ, hσ⟩
      exact
        ⟨σ, fun env =>
          (dpaSpecificationAfterPrefix_iff A 0 (execution σ env)).mp
            (hσ env)⟩

