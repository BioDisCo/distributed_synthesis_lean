/--
Round-aware journal/rational-run backend certificate for one DPA objective.

This keeps the same rotating tree targets and finite epoch transformer as the
state-only certificate, but uses the corrected round-aware finite controller
interface.  The soundness bridge is stated explicitly because it is the real
paper invariant: finite winning round-aware controllers must decode to real
distributed strategies satisfying the DPA objective.
-/
structure RoundAwareRotatingRationalRunEpochBackendCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  Branch : Proc -> Type b
  Label : Proc -> Type x
  target :
    (d : Proc) -> InputFreeParityTreeAutomaton.{b, x, y} (Branch d) (Label d)
  targetNonempty :
    ∀ d : Proc,
      ∃ tree : LabeledTree (Branch d) (Label d),
        (target d).acceptsTree tree
  transformer :
    FiniteEpochTransformer.{max u v w a, u, v, w, a, max u v w a}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂
  gameStateDecidable :
    DecidableEq (FiniteEpochTransformer.GameState transformer)
  initialBoundary : transformer.boundary
  automaton_equiv :
    ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      transformer.automaton.Accepts word ↔ A.Accepts word
  controllerStrategy :
    transformer.RoundAwareControllerCode -> StrategyPair In₁ In₂ Out₁ Out₂
  dynamicHierarchy : Prop
  parityObjective : Prop
  dynamicHierarchy_proof : dynamicHierarchy
  parityObjective_proof : parityObjective
  soundBoundary :
    letI : DecidableEq (FiniteEpochTransformer.GameState transformer) :=
      gameStateDecidable
    ∀ controller : transformer.RoundAwareControllerCode,
      (∀ environment : transformer.EnvironmentCode,
        transformer.roundAwareGameWins initialBoundary controller environment) ->
        ∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution (controllerStrategy controller) env)
  completeBoundary :
    FiniteEpochTransformer.RoundAwareGameExecutionControllerComplete
      transformer initialBoundary A

