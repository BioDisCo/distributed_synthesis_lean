/--
The current-fringe lambda controller matches the original distributed strategy
through the finite maps `view ↦ [view.nonFringe]` and
`view ↦ view.receiptTag`.
-/
theorem roundAwareLambdaControllerStrategyMatchesFiniteViews_of_currentFringe
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) :
    RoundAwareLambdaControllerStrategyMatchesFiniteViews
      T
      (fun state envRound => [(viewOne state envRound).nonFringe])
      (fun state envRound => [(viewTwo state envRound).nonFringe])
      (fun state envRound => (viewOne state envRound).receiptTag)
      (fun state envRound => (viewTwo state envRound).receiptTag)
      (roundAwareLambdaControllerOfStrategyViaCurrentFringe
        T viewOne viewTwo σ)
      (fun view => [view.nonFringe])
      (fun view => [view.nonFringe])
      (fun view => view.receiptTag)
      (fun view => view.receiptTag)
      σ := by
  constructor
  · intro state envRound view hhistory hfringe
    have hview : viewOne state envRound = view := by
      injection hhistory with hnonFringe
      have hreceipt :
          (viewOne state envRound).receiptTag = view.receiptTag := by
        simpa using hfringe
      calc
        viewOne state envRound =
            (viewOne state envRound).nonFringe.withReceiptTag
              (viewOne state envRound).receiptTag := by
                exact (View.withReceiptTag_nonFringe_receiptTag
                  (viewOne state envRound)).symm
        _ = view.nonFringe.withReceiptTag view.receiptTag := by
              rw [hnonFringe, hreceipt]
        _ = view := View.withReceiptTag_nonFringe_receiptTag view
    simp [hview]
  · intro state envRound view hhistory hfringe
    have hview : viewTwo state envRound = view := by
      injection hhistory with hnonFringe
      have hreceipt :
          (viewTwo state envRound).receiptTag = view.receiptTag := by
        simpa using hfringe
      calc
        viewTwo state envRound =
            (viewTwo state envRound).nonFringe.withReceiptTag
              (viewTwo state envRound).receiptTag := by
                exact (View.withReceiptTag_nonFringe_receiptTag
                  (viewTwo state envRound)).symm
        _ = view.nonFringe.withReceiptTag view.receiptTag := by
              rw [hnonFringe, hreceipt]
        _ = view := View.withReceiptTag_nonFringe_receiptTag view
    simp [hview]

/--
Choose an output for a decoded process-1 view from any finite state/round
preimage of that view.  If no preimage is available, use the supplied default.
Local observability proves below that the preimage choice is irrelevant on the
reachable decoded views.
-/
noncomputable def strategyOneOfRoundAwareLocalController
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (defaultOne : Out₁) :
    StrategyOne In₁ In₂ Out₁ :=
  fun view => by
    classical
    let P : Prop :=
      ∃ sample : GameState T × EnvironmentRound In₁ In₂,
        viewOne sample.1 sample.2 = view
    letI : Decidable P := Classical.propDecidable P
    exact
      if h : P then
        (controller.1 (Classical.choose h).1 (Classical.choose h).2).1
      else
        defaultOne

/-- Process-2 version of `strategyOneOfRoundAwareLocalController`. -/
noncomputable def strategyTwoOfRoundAwareLocalController
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (defaultTwo : Out₂) :
    StrategyTwo In₁ In₂ Out₂ :=
  fun view => by
    classical
    let P : Prop :=
      ∃ sample : GameState T × EnvironmentRound In₁ In₂,
        viewTwo sample.1 sample.2 = view
    letI : Decidable P := Classical.propDecidable P
    exact
      if h : P then
        (controller.1 (Classical.choose h).1 (Classical.choose h).2).2
      else
        defaultTwo

/--
Distributed strategy induced by a locally observable round-aware finite
controller and decoded local views.
-/
noncomputable def strategyOfRoundAwareLocalController
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (defaultOne : Out₁)
    (defaultTwo : Out₂) :
    StrategyPair In₁ In₂ Out₁ Out₂ where
  one := strategyOneOfRoundAwareLocalController
    T viewOne viewTwo controller defaultOne
  two := strategyTwoOfRoundAwareLocalController
    T viewOne viewTwo controller defaultTwo

theorem strategyOneOfRoundAwareLocalController_apply_decoded
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (defaultOne : Out₁)
    (state : GameState T)
    (envRound : EnvironmentRound In₁ In₂) :
    strategyOneOfRoundAwareLocalController
        T viewOne viewTwo controller defaultOne (viewOne state envRound) =
      (controller.1 state envRound).1 := by
  classical
  unfold strategyOneOfRoundAwareLocalController
  let P : Prop :=
    ∃ sample : GameState T × EnvironmentRound In₁ In₂,
      viewOne sample.1 sample.2 = viewOne state envRound
  letI : Decidable P := Classical.propDecidable P
  have hpre : P := ⟨(state, envRound), rfl⟩
  have hchosen :
      viewOne (Classical.choose hpre).1 (Classical.choose hpre).2 =
        viewOne state envRound :=
    Classical.choose_spec hpre
  have hlocal :=
    controller.2.1 (Classical.choose hpre).1 (Classical.choose hpre).2
      state envRound hchosen
  simp [P, hpre, hlocal]

theorem strategyTwoOfRoundAwareLocalController_apply_decoded
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (defaultTwo : Out₂)
    (state : GameState T)
    (envRound : EnvironmentRound In₁ In₂) :
    strategyTwoOfRoundAwareLocalController
        T viewOne viewTwo controller defaultTwo (viewTwo state envRound) =
      (controller.1 state envRound).2 := by
  classical
  unfold strategyTwoOfRoundAwareLocalController
  let P : Prop :=
    ∃ sample : GameState T × EnvironmentRound In₁ In₂,
      viewTwo sample.1 sample.2 = viewTwo state envRound
  letI : Decidable P := Classical.propDecidable P
  have hpre : P := ⟨(state, envRound), rfl⟩
  have hchosen :
      viewTwo (Classical.choose hpre).1 (Classical.choose hpre).2 =
        viewTwo state envRound :=
    Classical.choose_spec hpre
  have hlocal :=
    controller.2.2 (Classical.choose hpre).1 (Classical.choose hpre).2
      state envRound hchosen
  simp [P, hpre, hlocal]

/--
Coherent decoded environment-code representability for a local round-aware
controller and a chosen decoded distributed strategy.

For every real environment sequence, choose a finite environment code whose
generated finite play has the same environment word and whose decoded local
views match the real views of the chosen distributed strategy.
-/
def RoundAwareLocalControllerDecodedEnvironmentRepresentable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) : Prop :=
  ∀ env : EnvironmentSequence In₁ In₂,
    ∃ environment : EnvironmentCode T,
      roundAwareEnvironmentSequenceOfGamePlay
          T initialBoundary controller.1 environment = env ∧
      ∀ n : Nat,
        let state :=
          roundAwareGameStateStream
            T initialBoundary controller.1 environment n
        let envRound := environment state
        viewOne state envRound =
            nextView Proc.one (executionPrefix σ env n) (env n) ∧
          viewTwo state envRound =
            nextView Proc.two (executionPrefix σ env n) (env n)

/--
The decoded distributed strategy agrees pointwise with a locally observable
round-aware controller on the supplied state/round view decoders.
-/
def RoundAwareLocalControllerStrategyMatchesDecodedViews
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) : Prop :=
  ∀ state envRound,
    (controller.1 state envRound).1 = σ.one (viewOne state envRound) ∧
      (controller.1 state envRound).2 = σ.two (viewTwo state envRound)

/--
The current-fringe lambda controller is pointwise the original distributed
strategy evaluated on the decoded local views.
-/
theorem roundAwareLocalControllerStrategyMatchesDecodedViews_of_currentFringe
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) :
    RoundAwareLocalControllerStrategyMatchesDecodedViews
      T viewOne viewTwo
      (roundAwareLocalControllerOfStrategyViaCurrentFringe
        T viewOne viewTwo σ)
      σ := by
  intro state envRound
  simp [roundAwareLocalControllerOfStrategyViaCurrentFringe_apply]

/--
Pointwise compatibility of an omega word with a locally observable round-aware
controller and decoded local views.

This is weaker than exact replay by a finite environment code.  It only asks
that each real round has some finite retraction state whose decoded local views
are the real local views and whose controller outputs produce the word letter.
-/
def RoundAwareLocalControllerCompatibleDecodedExecution
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)) : Prop :=
  ∀ n : Nat,
    ∃ stateOne : GameState T,
      viewOne stateOne (env n) =
          nextView Proc.one (executionPrefix σ env n) (env n) ∧
        ∃ stateTwo : GameState T,
          viewTwo stateTwo (env n) =
              nextView Proc.two (executionPrefix σ env n) (env n) ∧
            word n =
              {
                inputOne := (env n).inputOne
                inputTwo := (env n).inputTwo
                graph := (env n).graph
                outputOne := (controller.1 stateOne (env n)).1
                outputTwo := (controller.1 stateTwo (env n)).2
              }

/--
The finite retraction supplies pointwise state witnesses for the actual local
views reached by a decoded strategy.
-/
def RoundAwareLocalControllerActualViewStateWitnesses
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) : Prop :=
  ∀ env : EnvironmentSequence In₁ In₂,
    ∀ n : Nat,
      (∃ stateOne : GameState T,
        viewOne stateOne (env n) =
          nextView Proc.one (executionPrefix σ env n) (env n)) ∧
      (∃ stateTwo : GameState T,
        viewTwo stateTwo (env n) =
          nextView Proc.two (executionPrefix σ env n) (env n))

/--
Full actual-view witnesses imply the finite current-fringe witnesses needed by
the lambda certificate route.
-/
theorem roundAwareLambdaControllerActualFiniteViewStateWitnesses_of_actualViewStateWitnesses
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwitnesses :
      RoundAwareLocalControllerActualViewStateWitnesses
        T viewOne viewTwo σ) :
    RoundAwareLambdaControllerActualFiniteViewStateWitnesses
      T
      (fun state envRound => [(viewOne state envRound).nonFringe])
      (fun state envRound => [(viewTwo state envRound).nonFringe])
      (fun state envRound => (viewOne state envRound).receiptTag)
      (fun state envRound => (viewTwo state envRound).receiptTag)
      (fun view => [view.nonFringe])
      (fun view => [view.nonFringe])
      (fun view => view.receiptTag)
      (fun view => view.receiptTag)
      σ := by
  intro env n
  rcases hwitnesses env n with
    ⟨⟨stateOne, hviewOne⟩, ⟨stateTwo, hviewTwo⟩⟩
  exact
    ⟨⟨stateOne,
        by simpa using congrArg (fun view => [view.nonFringe]) hviewOne,
        by simpa using congrArg (fun view => view.receiptTag) hviewOne⟩,
      ⟨stateTwo,
        by simpa using congrArg (fun view => [view.nonFringe]) hviewTwo,
        by simpa using congrArg (fun view => view.receiptTag) hviewTwo⟩⟩

/--
Round-aware state-view decoders provide the matching-controller input for the
finite current-fringe lambda certificate.

For each distributed strategy `σ`, choose the lambda controller that stores
the current non-fringe view as the finite summary and the current receipt tag
as the fringe argument.  The existing state-view decoder simulation then gives
exactly the finite-summary/fringe tracking required by the lambda completeness
bridge.
-/
theorem roundAwareLambdaControllerMatchingFiniteViews_of_currentFringe_stateViewDecoders
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (stateViewDecoders :
      RoundAwareGameExecutionStateViewDecodersSimulateStrategies
        T initialBoundary viewOne viewTwo) :
    ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      ∃ controller :
        RoundAwareLambdaControllerCode
          T
          (fun state envRound => [(viewOne state envRound).nonFringe])
          (fun state envRound => [(viewTwo state envRound).nonFringe])
          (fun state envRound => (viewOne state envRound).receiptTag)
          (fun state envRound => (viewTwo state envRound).receiptTag),
        RoundAwareLambdaControllerStrategyMatchesFiniteViews
          T
          (fun state envRound => [(viewOne state envRound).nonFringe])
          (fun state envRound => [(viewTwo state envRound).nonFringe])
          (fun state envRound => (viewOne state envRound).receiptTag)
          (fun state envRound => (viewTwo state envRound).receiptTag)
          controller
          (fun view => [view.nonFringe])
          (fun view => [view.nonFringe])
          (fun view => view.receiptTag)
          (fun view => view.receiptTag)
          σ ∧
        ∀ environment : EnvironmentCode T,
          ∀ n : Nat,
            let env : EnvironmentSequence In₁ In₂ :=
              roundAwareEnvironmentSequenceOfGamePlay
                T initialBoundary controller.1 environment
            let state :=
              roundAwareGameStateStream
                T initialBoundary controller.1 environment n
            let envRound := environment state
            (fun state envRound => [(viewOne state envRound).nonFringe])
                state envRound =
                (fun view => [view.nonFringe])
                  (nextView Proc.one
                    (executionPrefix σ env n) (env n)) ∧
              (fun state envRound => (viewOne state envRound).receiptTag)
                  state envRound =
                  (fun view => view.receiptTag)
                    (nextView Proc.one
                      (executionPrefix σ env n) (env n)) ∧
              (fun state envRound => [(viewTwo state envRound).nonFringe])
                  state envRound =
                  (fun view => [view.nonFringe])
                    (nextView Proc.two
                      (executionPrefix σ env n) (env n)) ∧
              (fun state envRound => (viewTwo state envRound).receiptTag)
                  state envRound =
                  (fun view => view.receiptTag)
                    (nextView Proc.two
                      (executionPrefix σ env n) (env n)) := by
  intro σ
  let controller :=
    roundAwareLambdaControllerOfStrategyViaCurrentFringe
      T viewOne viewTwo σ
  refine
    ⟨controller,
      roundAwareLambdaControllerStrategyMatchesFiniteViews_of_currentFringe
        T viewOne viewTwo σ,
      ?_⟩
  intro environment n
  have hcontroller :
      controller.1 =
        (fun state envRound =>
          (σ.one (viewOne state envRound),
            σ.two (viewTwo state envRound))) := by
    funext state envRound
    simp [controller]
  rw [hcontroller]
  rcases stateViewDecoders σ environment n with ⟨hviewOne, hviewTwo⟩
  exact
    ⟨congrArg (fun view => [view.nonFringe]) hviewOne,
      congrArg (fun view => view.receiptTag) hviewOne,
      congrArg (fun view => [view.nonFringe]) hviewTwo,
      congrArg (fun view => view.receiptTag) hviewTwo⟩

theorem roundAwareLocalControllerCompatibleDecodedExecution_of_actualViewStateWitnesses
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (hmatchViews :
      RoundAwareLocalControllerStrategyMatchesDecodedViews
        T viewOne viewTwo controller σ)
    (hwitnesses :
      RoundAwareLocalControllerActualViewStateWitnesses
        T viewOne viewTwo σ)
    (env : EnvironmentSequence In₁ In₂) :
    RoundAwareLocalControllerCompatibleDecodedExecution
      T viewOne viewTwo controller σ env (execution σ env) := by
  intro n
  rcases hwitnesses env n with ⟨⟨stateOne, hviewOne⟩, ⟨stateTwo, hviewTwo⟩⟩
  refine ⟨stateOne, hviewOne, stateTwo, hviewTwo, ?_⟩
  rw [execution_apply]
  have houtOne := (hmatchViews stateOne (env n)).1
  have houtTwo := (hmatchViews stateTwo (env n)).2
  simp [nextRound, hviewOne.symm, hviewTwo.symm, houtOne, houtTwo]

/--
If the current-fringe lambda controller has finite witnesses for the real
views of `σ`, then the canonical strategy extracted from that controller
generates the same finite execution prefixes as `σ`.
-/
theorem executionPrefix_strategyOf_currentFringe_eq_of_actualViewStateWitnesses
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (hwitnesses :
      RoundAwareLocalControllerActualViewStateWitnesses
        T viewOne viewTwo σ)
    (env : EnvironmentSequence In₁ In₂) :
    ∀ n : Nat,
      executionPrefix
          (strategyOfRoundAwareLocalController
            T viewOne viewTwo
            (roundAwareLocalControllerOfStrategyViaCurrentFringe
              T viewOne viewTwo σ)
            defaultOne defaultTwo)
          env n =
        executionPrefix σ env n := by
  intro n
  induction n with
  | zero => rfl
  | succ n ih =>
      let controller :=
        roundAwareLocalControllerOfStrategyViaCurrentFringe
          T viewOne viewTwo σ
      let decoded :=
        strategyOfRoundAwareLocalController
          T viewOne viewTwo controller defaultOne defaultTwo
      rcases hwitnesses env n with
        ⟨⟨stateOne, hviewOne⟩, ⟨stateTwo, hviewTwo⟩⟩
      have hone :
          decoded.one (nextView Proc.one (executionPrefix σ env n) (env n)) =
            σ.one (nextView Proc.one (executionPrefix σ env n) (env n)) := by
        have hdecoded :=
          strategyOneOfRoundAwareLocalController_apply_decoded
            T viewOne viewTwo controller defaultOne stateOne (env n)
        rw [← hviewOne]
        change
          strategyOneOfRoundAwareLocalController
              T viewOne viewTwo controller defaultOne
              (viewOne stateOne (env n)) =
            σ.one (viewOne stateOne (env n))
        rw [hdecoded]
        simp [controller, hviewOne]
      have htwo :
          decoded.two (nextView Proc.two (executionPrefix σ env n) (env n)) =
            σ.two (nextView Proc.two (executionPrefix σ env n) (env n)) := by
        have hdecoded :=
          strategyTwoOfRoundAwareLocalController_apply_decoded
            T viewOne viewTwo controller defaultTwo stateTwo (env n)
        rw [← hviewTwo]
        change
          strategyTwoOfRoundAwareLocalController
              T viewOne viewTwo controller defaultTwo
              (viewTwo stateTwo (env n)) =
            σ.two (viewTwo stateTwo (env n))
        rw [hdecoded]
        simp [controller, hviewTwo]
      rw [executionPrefix_succ, executionPrefix_succ, ih]
      change
        History.append (executionPrefix σ env n)
            (nextRound decoded (executionPrefix σ env n) (env n)) =
          History.append (executionPrefix σ env n)
            (nextRound σ (executionPrefix σ env n) (env n))
      simp [nextRound, hone, htwo]

/--
Actual-view witnesses transfer from a strategy `σ` to the canonical strategy
extracted from the current-fringe lambda controller built from `σ`.
-/
theorem roundAwareLocalControllerActualViewStateWitnesses_strategyOf_currentFringe
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (hwitnesses :
      RoundAwareLocalControllerActualViewStateWitnesses
        T viewOne viewTwo σ) :
    RoundAwareLocalControllerActualViewStateWitnesses
      T viewOne viewTwo
      (strategyOfRoundAwareLocalController
        T viewOne viewTwo
        (roundAwareLocalControllerOfStrategyViaCurrentFringe
          T viewOne viewTwo σ)
        defaultOne defaultTwo) := by
  intro env n
  have hpref :=
    executionPrefix_strategyOf_currentFringe_eq_of_actualViewStateWitnesses
      T viewOne viewTwo σ defaultOne defaultTwo hwitnesses env n
  simpa [hpref] using hwitnesses env n

theorem roundAwareLocalControllerStrategyMatchesDecodedViews_strategyOf
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (defaultOne : Out₁)
    (defaultTwo : Out₂) :
    RoundAwareLocalControllerStrategyMatchesDecodedViews
      T viewOne viewTwo controller
      (strategyOfRoundAwareLocalController
        T viewOne viewTwo controller defaultOne defaultTwo) := by
  intro state envRound
  constructor
  · exact
      (strategyOneOfRoundAwareLocalController_apply_decoded
        T viewOne viewTwo controller defaultOne state envRound).symm
  · exact
      (strategyTwoOfRoundAwareLocalController_apply_decoded
        T viewOne viewTwo controller defaultTwo state envRound).symm

/--
For the canonical decoded strategy, the pointwise compatible-execution
predicate is extensional: every compatible word is the actual generated
execution for the supplied environment sequence.
-/
theorem roundAwareLocalControllerCompatibleDecodedExecution_eq_execution_strategyOf
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hcompatible :
      RoundAwareLocalControllerCompatibleDecodedExecution
        T viewOne viewTwo controller
        (strategyOfRoundAwareLocalController
          T viewOne viewTwo controller defaultOne defaultTwo)
        env word) :
    word =
      execution
        (strategyOfRoundAwareLocalController
          T viewOne viewTwo controller defaultOne defaultTwo)
        env := by
  let σ :=
    strategyOfRoundAwareLocalController
      T viewOne viewTwo controller defaultOne defaultTwo
  change word = execution σ env
  have hcompatible' :
      RoundAwareLocalControllerCompatibleDecodedExecution
        T viewOne viewTwo controller σ env word := by
    simpa [σ] using hcompatible
  funext n
  rcases hcompatible' n with
    ⟨stateOne, hviewOne, stateTwo, hviewTwo, hword⟩
  rw [hword, execution_apply]
  have hone :
      σ.one (nextView Proc.one (executionPrefix σ env n) (env n)) =
        (controller.1 stateOne (env n)).1 := by
    change
      strategyOneOfRoundAwareLocalController
          T viewOne viewTwo controller defaultOne
          (nextView Proc.one (executionPrefix σ env n) (env n)) =
        (controller.1 stateOne (env n)).1
    rw [← hviewOne]
    exact
      strategyOneOfRoundAwareLocalController_apply_decoded
        T viewOne viewTwo controller defaultOne stateOne (env n)
  have htwo :
      σ.two (nextView Proc.two (executionPrefix σ env n) (env n)) =
        (controller.1 stateTwo (env n)).2 := by
    change
      strategyTwoOfRoundAwareLocalController
          T viewOne viewTwo controller defaultTwo
          (nextView Proc.two (executionPrefix σ env n) (env n)) =
        (controller.1 stateTwo (env n)).2
    rw [← hviewTwo]
    exact
      strategyTwoOfRoundAwareLocalController_apply_decoded
        T viewOne viewTwo controller defaultTwo stateTwo (env n)
  simp [nextRound, hone, htwo]

/--
The actual execution of the canonical strategy extracted from a current-fringe
lambda controller is compatible with that local controller, provided the
original strategy has actual-view finite witnesses.
-/
theorem roundAwareLocalControllerCompatibleDecodedExecution_strategyOf_currentFringe
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (hwitnesses :
      RoundAwareLocalControllerActualViewStateWitnesses
        T viewOne viewTwo σ)
    (env : EnvironmentSequence In₁ In₂) :
    RoundAwareLocalControllerCompatibleDecodedExecution
      T viewOne viewTwo
      (roundAwareLocalControllerOfStrategyViaCurrentFringe
        T viewOne viewTwo σ)
      (strategyOfRoundAwareLocalController
        T viewOne viewTwo
        (roundAwareLocalControllerOfStrategyViaCurrentFringe
          T viewOne viewTwo σ)
        defaultOne defaultTwo)
      env
      (execution
        (strategyOfRoundAwareLocalController
          T viewOne viewTwo
          (roundAwareLocalControllerOfStrategyViaCurrentFringe
            T viewOne viewTwo σ)
          defaultOne defaultTwo)
        env) :=
  roundAwareLocalControllerCompatibleDecodedExecution_of_actualViewStateWitnesses
    T viewOne viewTwo
    (roundAwareLocalControllerOfStrategyViaCurrentFringe
      T viewOne viewTwo σ)
    (strategyOfRoundAwareLocalController
      T viewOne viewTwo
      (roundAwareLocalControllerOfStrategyViaCurrentFringe
        T viewOne viewTwo σ)
      defaultOne defaultTwo)
    (roundAwareLocalControllerStrategyMatchesDecodedViews_strategyOf
      T viewOne viewTwo
      (roundAwareLocalControllerOfStrategyViaCurrentFringe
        T viewOne viewTwo σ)
      defaultOne defaultTwo)
    (roundAwareLocalControllerActualViewStateWitnesses_strategyOf_currentFringe
      T viewOne viewTwo σ defaultOne defaultTwo hwitnesses)
    env

/--
Coherent state-stream form of decoded local-controller environment
representability.

The stream follows the real environment sequence through the round-aware epoch
transition, repeats only with the same next environment move, and decodes both
real local views at every step.
-/
def RoundAwareLocalControllerDecodedEnvironmentCoherentStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (stateStream : Nat -> GameState T) : Prop :=
  stateStream 0 = Sum.inl initialBoundary ∧
    (∀ n : Nat,
      stateStream (n + 1) =
        roundAwareGameTransition T controller.1 (stateStream n) (env n)) ∧
    (∀ i j : Nat, stateStream i = stateStream j -> env i = env j) ∧
    (∀ n : Nat,
      viewOne (stateStream n) (env n) =
          nextView Proc.one (executionPrefix σ env n) (env n) ∧
        viewTwo (stateStream n) (env n) =
          nextView Proc.two (executionPrefix σ env n) (env n))

theorem roundAwareLocalControllerActualViewStateWitnesses_of_coherentStateStreams
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (hcoherent :
      ∀ env : EnvironmentSequence In₁ In₂,
        ∃ stateStream : Nat -> GameState T,
          RoundAwareLocalControllerDecodedEnvironmentCoherentStateStream
            T initialBoundary viewOne viewTwo controller σ env stateStream) :
    RoundAwareLocalControllerActualViewStateWitnesses
      T viewOne viewTwo σ := by
  intro env n
  rcases hcoherent env with ⟨stateStream, _hinit, _hstep, _hconsistent, hviews⟩
  exact
    ⟨⟨stateStream n, (hviews n).1⟩,
      ⟨stateStream n, (hviews n).2⟩⟩

theorem roundAwareLocalControllerActualViewStateWitnesses_of_decodedEnvironmentRepresentable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (hdecoded :
      RoundAwareLocalControllerDecodedEnvironmentRepresentable
        T initialBoundary viewOne viewTwo controller σ) :
    RoundAwareLocalControllerActualViewStateWitnesses
      T viewOne viewTwo σ := by
  intro env n
  rcases hdecoded env with ⟨environment, henv, hviews⟩
  let state :=
    roundAwareGameStateStream
      T initialBoundary controller.1 environment n
  have henv_n :
      environment state = env n := by
    change
      roundAwareEnvironmentSequenceOfGamePlay
          T initialBoundary controller.1 environment n = env n
    rw [henv]
  have hview := hviews n
  exact
    ⟨⟨state, by simpa [state, henv_n] using hview.1⟩,
      ⟨state, by simpa [state, henv_n] using hview.2⟩⟩

/--
Any exact decoded environment-code representation forces repeat consistency:
if the generated finite state repeats at two positions, then the real
environment move at those positions is equal.

This is the useful sanity check for the exact-replay route.  Arbitrary real
environment streams do not have this property for an arbitrary finite state
stream; the paper-facing finite-game proof must therefore supply a genuine
finite retraction/coherent stream, not just appeal to exact replay.
-/
theorem roundAwareLocalControllerDecodedEnvironmentRepresentable_state_repeat_env_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (controller : RoundAwareLocalControllerCode T viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (hrepresentable :
      RoundAwareLocalControllerDecodedEnvironmentRepresentable
        T initialBoundary viewOne viewTwo controller σ)
    (env : EnvironmentSequence In₁ In₂) :
    ∃ environment : EnvironmentCode T,
      roundAwareEnvironmentSequenceOfGamePlay
          T initialBoundary controller.1 environment = env ∧
      ∀ i j : Nat,
        roundAwareGameStateStream
            T initialBoundary controller.1 environment i =
          roundAwareGameStateStream
            T initialBoundary controller.1 environment j ->
        env i = env j := by
  rcases hrepresentable env with ⟨environment, henv, _hviews⟩
  refine ⟨environment, henv, ?_⟩
  intro i j hstate
  have hi :
      env i =
        environment
          (roundAwareGameStateStream
            T initialBoundary controller.1 environment i) := by
    exact (congrFun henv i).symm
  have hj :
      env j =
        environment
          (roundAwareGameStateStream
            T initialBoundary controller.1 environment j) := by
    exact (congrFun henv j).symm
  rw [hi, hj, hstate]

/--
If round-aware finite states decode the two real local views after the current
environment move, every distributed strategy has a matching round-aware finite
controller.
-/
theorem roundAwareGameExecutionStrategiesHaveMatchingControllers_of_stateViewDecoders
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (hviews :
      RoundAwareGameExecutionStateViewDecodersSimulateStrategies
        T initialBoundary viewOne viewTwo) :
    ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      ∃ controller : RoundAwareControllerCode T,
        ∀ environment : EnvironmentCode T,
          RoundAwareGameExecutionMatchesStrategyForEnvironment
            T initialBoundary controller environment σ := by
  intro σ
  let controller : RoundAwareControllerCode T :=
    fun state envRound =>
      (σ.one (viewOne state envRound), σ.two (viewTwo state envRound))
  refine ⟨controller, ?_⟩
  intro environment n
  let env : EnvironmentSequence In₁ In₂ :=
    roundAwareEnvironmentSequenceOfGamePlay
      T initialBoundary controller environment
  let state :=
    roundAwareGameStateStream
      T initialBoundary controller environment n
  let envRound := environment state
  have hview := hviews σ environment n
  constructor
  · change
      σ.one (viewOne state envRound) =
        σ.one (nextView Proc.one (executionPrefix σ env n) (env n))
    rw [hview.1]
  · change
      σ.two (viewTwo state envRound) =
        σ.two (nextView Proc.two (executionPrefix σ env n) (env n))
    rw [hview.2]

/--
The operational matching-controller boundary implies the controller-simulation
boundary used by the finite-game completeness proof.
-/
theorem gameExecutionControllerSimulation_of_matchingControllers
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (hmatch :
      GameExecutionStrategiesHaveMatchingControllers T initialBoundary) :
    ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      ∃ controller : ControllerCode T,
        GameExecutionControllerSimulatesStrategy
          T initialBoundary controller σ := by
  intro σ
  rcases hmatch σ with ⟨controller, hcontroller⟩
  exact
    ⟨controller,
      gameExecutionControllerSimulatesStrategy_of_matchesStrategy
        T initialBoundary controller σ hcontroller⟩

/--
State-view decoders are sufficient for the matching-controller completeness
boundary when they track the actual local views along every finite-game play.

This is the constructive content needed on the completeness side of the
epoch-game reduction: a finite epoch state must carry enough local-view
information to evaluate any real distributed strategy at the views reached by
the play induced from the finite environment code.
-/
def GameExecutionStateViewDecodersSimulateStrategies
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne : GameState T -> View In₁ In₂ Proc.one)
    (viewTwo : GameState T -> View In₁ In₂ Proc.two) : Prop :=
  ∀ (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (environment :
      EnvironmentCode
        (T := T))
    (n : Nat),
      let controller : ControllerCode T :=
        fun state => (σ.one (viewOne state), σ.two (viewTwo state))
      let env : EnvironmentSequence In₁ In₂ :=
        environmentSequenceOfGamePlay T initialBoundary controller environment
      viewOne (gameStateStream T initialBoundary controller environment n) =
          nextView Proc.one (executionPrefix σ env n) (env n) ∧
        viewTwo (gameStateStream T initialBoundary controller environment n) =
          nextView Proc.two (executionPrefix σ env n) (env n)

/--
The state-only decoder target forces all possible first-round process-1 views
to be equal.

This exposes the exact limitation of the current completeness target: at time
zero the finite epoch state is always the fixed initial boundary, while the
environment move is still arbitrary.  A decoder of type `GameState -> View`
therefore cannot distinguish different initial environment moves.
-/
theorem gameExecutionStateViewDecoders_initial_nextView_one_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne : GameState T -> View In₁ In₂ Proc.one)
    (viewTwo : GameState T -> View In₁ In₂ Proc.two)
    (hviews :
      GameExecutionStateViewDecodersSimulateStrategies
        T initialBoundary viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (envA envB : EnvironmentRound In₁ In₂) :
    nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envA =
      nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envB := by
  let environmentA : EnvironmentCode T := fun _ => envA
  let environmentB : EnvironmentCode T := fun _ => envB
  have hA := (hviews σ environmentA 0).1
  have hB := (hviews σ environmentB 0).1
  have hA' :
      viewOne (Sum.inl initialBoundary) =
        nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envA := by
    simpa [environmentA, environmentSequenceOfGamePlay] using hA
  have hB' :
      viewOne (Sum.inl initialBoundary) =
        nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envB := by
    simpa [environmentB, environmentSequenceOfGamePlay] using hB
  exact hA'.symm.trans hB'

/-- Process-2 version of `gameExecutionStateViewDecoders_initial_nextView_one_eq`. -/
theorem gameExecutionStateViewDecoders_initial_nextView_two_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne : GameState T -> View In₁ In₂ Proc.one)
    (viewTwo : GameState T -> View In₁ In₂ Proc.two)
    (hviews :
      GameExecutionStateViewDecodersSimulateStrategies
        T initialBoundary viewOne viewTwo)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (envA envB : EnvironmentRound In₁ In₂) :
    nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envA =
      nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envB := by
  let environmentA : EnvironmentCode T := fun _ => envA
  let environmentB : EnvironmentCode T := fun _ => envB
  have hA := (hviews σ environmentA 0).2
  have hB := (hviews σ environmentB 0).2
  have hA' :
      viewTwo (Sum.inl initialBoundary) =
        nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envA := by
    simpa [environmentA, environmentSequenceOfGamePlay] using hA
  have hB' :
      viewTwo (Sum.inl initialBoundary) =
        nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envB := by
    simpa [environmentB, environmentSequenceOfGamePlay] using hB
  exact hA'.symm.trans hB'

/--
If two initial environment moves induce different first-round process-1 views,
then no state-only decoder can satisfy
`GameExecutionStateViewDecodersSimulateStrategies`.
-/
theorem not_gameExecutionStateViewDecoders_of_initial_nextView_one_ne
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne : GameState T -> View In₁ In₂ Proc.one)
    (viewTwo : GameState T -> View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (envA envB : EnvironmentRound In₁ In₂)
    (hne :
      nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envA ≠
        nextView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) envB) :
    ¬ GameExecutionStateViewDecodersSimulateStrategies
        T initialBoundary viewOne viewTwo := by
  intro hviews
  exact hne
    (gameExecutionStateViewDecoders_initial_nextView_one_eq
      T initialBoundary viewOne viewTwo hviews σ envA envB)

/--
If two initial environment moves induce different first-round process-2 views,
then no state-only decoder can satisfy
`GameExecutionStateViewDecodersSimulateStrategies`.
-/
theorem not_gameExecutionStateViewDecoders_of_initial_nextView_two_ne
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne : GameState T -> View In₁ In₂ Proc.one)
    (viewTwo : GameState T -> View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (envA envB : EnvironmentRound In₁ In₂)
    (hne :
      nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envA ≠
        nextView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) envB) :
    ¬ GameExecutionStateViewDecodersSimulateStrategies
        T initialBoundary viewOne viewTwo := by
  intro hviews
  exact hne
    (gameExecutionStateViewDecoders_initial_nextView_two_eq
      T initialBoundary viewOne viewTwo hviews σ envA envB)

/--
If finite epoch states decode to the real local views along every play, every
distributed strategy has a matching finite controller.
-/
theorem gameExecutionStrategiesHaveMatchingControllers_of_stateViewDecoders
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne : GameState T -> View In₁ In₂ Proc.one)
    (viewTwo : GameState T -> View In₁ In₂ Proc.two)
    (hviews :
      GameExecutionStateViewDecodersSimulateStrategies
        T initialBoundary viewOne viewTwo) :
    GameExecutionStrategiesHaveMatchingControllers T initialBoundary := by
  intro σ
  let controller : ControllerCode T :=
    fun state => (σ.one (viewOne state), σ.two (viewTwo state))
  refine ⟨controller, ?_⟩
  intro environment n
  let env : EnvironmentSequence In₁ In₂ :=
    environmentSequenceOfGamePlay T initialBoundary controller environment
  have hview := hviews σ environment n
  constructor
  · change
      σ.one (viewOne
          (gameStateStream T initialBoundary controller environment n)) =
        σ.one (nextView Proc.one (executionPrefix σ env n) (env n))
    rw [hview.1]
  · change
      σ.two (viewTwo
          (gameStateStream T initialBoundary controller environment n)) =
        σ.two (nextView Proc.two (executionPrefix σ env n) (env n))
    rw [hview.2]

/--
State-view decoders also directly discharge the controller-simulation boundary
used by finite-game completeness.
-/
theorem gameExecutionControllerSimulation_of_stateViewDecoders
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (viewOne : GameState T -> View In₁ In₂ Proc.one)
    (viewTwo : GameState T -> View In₁ In₂ Proc.two)
    (hviews :
      GameExecutionStateViewDecodersSimulateStrategies
        T initialBoundary viewOne viewTwo) :
    ∀ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      ∃ controller : ControllerCode T,
        GameExecutionControllerSimulatesStrategy
          T initialBoundary controller σ :=
  gameExecutionControllerSimulation_of_matchingControllers
    T initialBoundary
    (gameExecutionStrategiesHaveMatchingControllers_of_stateViewDecoders
      T initialBoundary viewOne viewTwo hviews)

/--
The finite environment code induced by a coherent abstract state stream.

For states that occur on the stream it replays the corresponding concrete
environment move; unreachable states are assigned an arbitrary harmless move.
-/
noncomputable def environmentCodeOfStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂) :
    EnvironmentCode T := by
  classical
  exact fun state =>
    if h : ∃ n : Nat, stateStream n = state then
      env (Classical.choose h)
    else
      env 0

theorem environmentCodeOfStateStream_apply_of_consistent
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (hconsistent :
      ∀ i j : Nat, stateStream i = stateStream j -> env i = env j)
    (n : Nat) :
    environmentCodeOfStateStream T stateStream env (stateStream n) = env n := by
  classical
  unfold environmentCodeOfStateStream
  have hseen : ∃ k : Nat, stateStream k = stateStream n := ⟨n, rfl⟩
  simp [hseen, hconsistent (Classical.choose hseen) n (Classical.choose_spec hseen)]

theorem roundAwareGameStateStream_environmentCodeOfStateStream_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (hinit : stateStream 0 = Sum.inl initialBoundary)
    (hstep :
      ∀ n : Nat,
        stateStream (n + 1) =
          roundAwareGameTransition T controller (stateStream n) (env n))
    (hconsistent :
      ∀ i j : Nat, stateStream i = stateStream j -> env i = env j)
    (n : Nat) :
    roundAwareGameStateStream T initialBoundary controller
        (environmentCodeOfStateStream T stateStream env) n =
      stateStream n := by
  induction n with
  | zero =>
      simpa using hinit.symm
  | succ n ih =>
      rw [roundAwareGameStateStream_succ]
      rw [ih]
      rw [environmentCodeOfStateStream_apply_of_consistent
        T stateStream env hconsistent n]
      exact (hstep n).symm

/--
The omega word obtained by reading environment rounds and round-aware controller
outputs along an abstract state stream.
-/
def roundAwareWordOfStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : RoundAwareControllerCode T)
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂) :
    OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) :=
  fun n =>
    let envRound := env n
    let output := controller (stateStream n) envRound
    {
      inputOne := envRound.inputOne
      inputTwo := envRound.inputTwo
      graph := envRound.graph
      outputOne := output.1
      outputTwo := output.2
    }

/--
If an enriched game-state decoder `dpaOf` starts at the DPA initial state and
updates exactly like the DPA on the word read from the state stream, then it is
the DPA run along that stream.
-/
theorem dpaOf_stateStream_eq_run_roundAwareWordOfStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    (hdpaInit : dpaOf (stateStream 0) = A.initial)
    (hdpaStep :
      ∀ n : Nat,
        dpaOf (stateStream (n + 1)) =
          A.step (dpaOf (stateStream n))
            (roundAwareWordOfStateStream T controller stateStream env n)) :
    ∀ n : Nat,
      dpaOf (stateStream n) =
        A.run (roundAwareWordOfStateStream T controller stateStream env) n := by
  intro n
  induction n with
  | zero =>
      exact hdpaInit
  | succ n ih =>
      rw [hdpaStep n, A.run_succ, ih]

/--
A DPA priority seen infinitely often along an enriched state stream is carried by
some concrete enriched game state seen infinitely often.
-/
theorem exists_gameStateSeenInfinitelyOften_of_prioritySeenInfinitelyOften_roundAwareWordOfStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    [Fintype (GameState T)]
    {p : Nat}
    (hdpaRun :
      ∀ n : Nat,
        dpaOf (stateStream n) =
          A.run (roundAwareWordOfStateStream T controller stateStream env) n)
    (hp :
      A.PrioritySeenInfinitelyOften
        (roundAwareWordOfStateStream T controller stateStream env) p) :
    ∃ state : GameState T,
      A.priority (dpaOf state) = p ∧
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧ stateStream k = state := by
  classical
  let targets : Finset (GameState T) :=
    Finset.univ.filter (fun state => A.priority (dpaOf state) = p)
  have hfreq :
      ∀ n : Nat,
        ∃ k : Nat, n ≤ k ∧ stateStream k ∈ targets := by
    intro n
    rcases hp n with ⟨k, hk, hkprio⟩
    refine ⟨k, hk, ?_⟩
    have hprioState : A.priority (dpaOf (stateStream k)) = p := by
      rw [hdpaRun k]
      exact hkprio
    simp [targets, hprioState]
  rcases DetParityAutomaton.exists_seenInfinitelyOften_of_frequently_mem_finset
      (fun n : Nat => stateStream n) targets hfreq with
    ⟨state, hstateTarget, hstateSeen⟩
  refine ⟨state, ?_, hstateSeen⟩
  simpa [targets] using hstateTarget

/--
Rejected enriched-progress streams have a recurrent enriched game state whose
decoded DPA state carries the odd least recurring priority.
-/
theorem exists_recurrent_gameState_min_priority_not_even_of_not_accepts_roundAwareWordOfStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    [Fintype (GameState T)]
    (hdpaRun :
      ∀ n : Nat,
        dpaOf (stateStream n) =
          A.run (roundAwareWordOfStateStream T controller stateStream env) n)
    (hreject :
      ¬ A.Accepts (roundAwareWordOfStateStream T controller stateStream env)) :
    ∃ p : Nat,
      ∃ state : GameState T,
        A.priority (dpaOf state) = p ∧
          (∀ n : Nat, ∃ k : Nat, n ≤ k ∧ stateStream k = state) ∧
            (∀ q : Nat,
              A.PrioritySeenInfinitelyOften
                (roundAwareWordOfStateStream T controller stateStream env) q ->
              p ≤ q) ∧
              ¬ DetParityAutomaton.NatEven p := by
  rcases
      A.exists_min_prioritySeenInfinitelyOften_not_even_of_not_accepts
        (roundAwareWordOfStateStream T controller stateStream env) hreject with
    ⟨p, hpSeen, hpMin, hpOdd⟩
  rcases
      exists_gameStateSeenInfinitelyOften_of_prioritySeenInfinitelyOften_roundAwareWordOfStateStream
        T controller A stateStream env dpaOf hdpaRun hpSeen with
    ⟨state, hstatePriority, hstateSeen⟩
  exact ⟨p, state, hstatePriority, hstateSeen, hpMin, hpOdd⟩

/--
Version of the recurrent enriched-state extraction where DPA-progress coherence
is supplied by initial and step equations.
-/
theorem exists_recurrent_gameState_min_priority_not_even_of_not_accepts_roundAwareWordOfStateStream_of_dpaProgress
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    [Fintype (GameState T)]
    (hdpaInit : dpaOf (stateStream 0) = A.initial)
    (hdpaStep :
      ∀ n : Nat,
        dpaOf (stateStream (n + 1)) =
          A.step (dpaOf (stateStream n))
            (roundAwareWordOfStateStream T controller stateStream env n))
    (hreject :
      ¬ A.Accepts (roundAwareWordOfStateStream T controller stateStream env)) :
    ∃ p : Nat,
      ∃ state : GameState T,
        A.priority (dpaOf state) = p ∧
          (∀ n : Nat, ∃ k : Nat, n ≤ k ∧ stateStream k = state) ∧
            (∀ q : Nat,
              A.PrioritySeenInfinitelyOften
                (roundAwareWordOfStateStream T controller stateStream env) q ->
              p ≤ q) ∧
              ¬ DetParityAutomaton.NatEven p := by
  exact
    exists_recurrent_gameState_min_priority_not_even_of_not_accepts_roundAwareWordOfStateStream
      T controller A stateStream env dpaOf
      (dpaOf_stateStream_eq_run_roundAwareWordOfStateStream
        T controller A stateStream env dpaOf hdpaInit hdpaStep)
      hreject

/--
Rejected enriched-progress streams have a recurrent enriched game state carrying
the odd least recurring priority, and after a finite cutoff no lower decoded DPA
priority appears.
-/
theorem exists_recurrent_gameState_min_priority_not_even_and_eventually_ge_of_not_accepts_roundAwareWordOfStateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    [Fintype (GameState T)]
    (hdpaRun :
      ∀ n : Nat,
        dpaOf (stateStream n) =
          A.run (roundAwareWordOfStateStream T controller stateStream env) n)
    (hreject :
      ¬ A.Accepts (roundAwareWordOfStateStream T controller stateStream env)) :
    ∃ p : Nat,
      ∃ state : GameState T,
        ∃ N : Nat,
          A.priority (dpaOf state) = p ∧
            (∀ n : Nat, ∃ k : Nat, n ≤ k ∧ stateStream k = state) ∧
              (∀ k : Nat, N ≤ k -> p ≤ A.priority (dpaOf (stateStream k))) ∧
                ¬ DetParityAutomaton.NatEven p := by
  rcases
      exists_recurrent_gameState_min_priority_not_even_of_not_accepts_roundAwareWordOfStateStream
        T controller A stateStream env dpaOf hdpaRun hreject with
    ⟨p, state, hstatePriority, hstateSeen, hpMin, hpOdd⟩
  rcases
      A.exists_eventually_priority_ge_of_min_prioritySeenInfinitelyOften
        (roundAwareWordOfStateStream T controller stateStream env) hpMin with
    ⟨N, hN⟩
  refine ⟨p, state, N, hstatePriority, hstateSeen, ?_, hpOdd⟩
  intro k hk
  have hNk := hN k hk
  simpa [hdpaRun k] using hNk

/--
Version of the recurrent enriched-state/no-lower-cutoff extraction where
DPA-progress coherence is supplied by initial and step equations.
-/
theorem exists_recurrent_gameState_min_priority_not_even_and_eventually_ge_of_not_accepts_roundAwareWordOfStateStream_of_dpaProgress
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    [Fintype (GameState T)]
    (hdpaInit : dpaOf (stateStream 0) = A.initial)
    (hdpaStep :
      ∀ n : Nat,
        dpaOf (stateStream (n + 1)) =
          A.step (dpaOf (stateStream n))
            (roundAwareWordOfStateStream T controller stateStream env n))
    (hreject :
      ¬ A.Accepts (roundAwareWordOfStateStream T controller stateStream env)) :
    ∃ p : Nat,
      ∃ state : GameState T,
        ∃ N : Nat,
          A.priority (dpaOf state) = p ∧
            (∀ n : Nat, ∃ k : Nat, n ≤ k ∧ stateStream k = state) ∧
              (∀ k : Nat, N ≤ k -> p ≤ A.priority (dpaOf (stateStream k))) ∧
                ¬ DetParityAutomaton.NatEven p := by
  exact
    exists_recurrent_gameState_min_priority_not_even_and_eventually_ge_of_not_accepts_roundAwareWordOfStateStream
      T controller A stateStream env dpaOf
      (dpaOf_stateStream_eq_run_roundAwareWordOfStateStream
        T controller A stateStream env dpaOf hdpaInit hdpaStep)
      hreject

/--
Negative-form version of the enriched cutoff: after some finite prefix no
visited enriched state has decoded DPA priority below the odd least recurring
priority.
-/
theorem exists_recurrent_gameState_min_priority_not_even_and_eventually_not_lt_of_not_accepts_roundAwareWordOfStateStream_of_dpaProgress
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    [Fintype (GameState T)]
    (hdpaInit : dpaOf (stateStream 0) = A.initial)
    (hdpaStep :
      ∀ n : Nat,
        dpaOf (stateStream (n + 1)) =
          A.step (dpaOf (stateStream n))
            (roundAwareWordOfStateStream T controller stateStream env n))
    (hreject :
      ¬ A.Accepts (roundAwareWordOfStateStream T controller stateStream env)) :
    ∃ p : Nat,
      ∃ state : GameState T,
        ∃ N : Nat,
          A.priority (dpaOf state) = p ∧
            (∀ n : Nat, ∃ k : Nat, n ≤ k ∧ stateStream k = state) ∧
              (∀ k : Nat, N ≤ k -> ¬ A.priority (dpaOf (stateStream k)) < p) ∧
                ¬ DetParityAutomaton.NatEven p := by
  rcases
      exists_recurrent_gameState_min_priority_not_even_and_eventually_ge_of_not_accepts_roundAwareWordOfStateStream_of_dpaProgress
        T controller A stateStream env dpaOf hdpaInit hdpaStep hreject with
    ⟨p, state, N, hstatePriority, hstateSeen, hN, hpOdd⟩
  refine ⟨p, state, N, hstatePriority, hstateSeen, ?_, hpOdd⟩
  intro k hk hlt
  exact (Nat.not_lt_of_ge (hN k hk)) hlt

/--
Rejected enriched-progress streams contain recurrent return indices after the
no-lower-priority cutoff.

This is the recurrent-return step used before loop erasure: choose an enriched
state carrying the odd least recurring priority, then choose two occurrences of
that same state after the cutoff beyond which no smaller priority appears.
-/
theorem exists_recurrent_return_gameState_min_priority_not_even_and_eventually_ge_of_not_accepts_roundAwareWordOfStateStream_of_dpaProgress
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    [Fintype (GameState T)]
    (hdpaInit : dpaOf (stateStream 0) = A.initial)
    (hdpaStep :
      ∀ n : Nat,
        dpaOf (stateStream (n + 1)) =
          A.step (dpaOf (stateStream n))
            (roundAwareWordOfStateStream T controller stateStream env n))
    (hreject :
      ¬ A.Accepts (roundAwareWordOfStateStream T controller stateStream env)) :
    ∃ p : Nat,
      ∃ recurrentState : GameState T,
        ∃ start : Nat,
          ∃ stop : Nat,
            start < stop ∧
              A.priority (dpaOf recurrentState) = p ∧
                stateStream start = recurrentState ∧
                  stateStream stop = recurrentState ∧
                    (∀ k : Nat,
                      start ≤ k ->
                        p ≤ A.priority (dpaOf (stateStream k))) ∧
                      ¬ DetParityAutomaton.NatEven p := by
  rcases
      exists_recurrent_gameState_min_priority_not_even_and_eventually_ge_of_not_accepts_roundAwareWordOfStateStream_of_dpaProgress
        T controller A stateStream env dpaOf hdpaInit hdpaStep hreject with
    ⟨p, recurrentState, cutoff, hrecurrentPriority, hrecurrentSeen,
      hpriorityFromCutoff, hpOdd⟩
  rcases hrecurrentSeen cutoff with
    ⟨start, hcutoffStart, hstartState⟩
  rcases hrecurrentSeen (start + 1) with
    ⟨stop, hstartStop, hstopState⟩
  refine
    ⟨p, recurrentState, start, stop, ?_, hrecurrentPriority,
      hstartState, hstopState, ?_, hpOdd⟩
  · omega
  · intro k hk
    exact hpriorityFromCutoff k (by omega)

/--
If the abstract state stream and environment labels repeat after a loop, then so
does the generated round-aware omega word.
-/
theorem roundAwareWordOfStateStream_loop_shift
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (controller : RoundAwareControllerCode T)
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (start period : Nat)
    (hstateShift :
      ∀ m : Nat,
        stateStream (start + period + m) = stateStream (start + m))
    (henvShift :
      ∀ m : Nat, env (start + period + m) = env (start + m)) :
    ∀ m : Nat,
      roundAwareWordOfStateStream T controller stateStream env
          (start + period + m) =
        roundAwareWordOfStateStream T controller stateStream env
          (start + m) := by
  intro m
  simp [roundAwareWordOfStateStream, hstateShift m, henvShift m]

/-
Generic non-stuttering finite-carrier lasso consumer.

The final Bérard/generated-prefix route should instantiate this kind of carrier
with the enriched product observer state, not with the raw epoch `GameState`.
-/

/-- Finite carrier code induced by a labelled source stream. -/
noncomputable def finiteCarrierCodeOfStateStream
    {Q : Type x}
    {Move : Type y}
    (stateStream : Nat -> Q)
    (moveStream : Nat -> Move) :
    Q -> Move := by
  classical
  exact fun state =>
    if h : ∃ n : Nat, stateStream n = state then
      moveStream (Classical.choose h)
    else
      moveStream 0

theorem finiteCarrierCodeOfStateStream_apply_of_consistent
    {Q : Type x}
    {Move : Type y}
    (stateStream : Nat -> Q)
    (moveStream : Nat -> Move)
    (hconsistent :
      ∀ i j : Nat, stateStream i = stateStream j -> moveStream i = moveStream j)
    (n : Nat) :
    finiteCarrierCodeOfStateStream stateStream moveStream (stateStream n) =
      moveStream n := by
  classical
  unfold finiteCarrierCodeOfStateStream
  have hseen : ∃ k : Nat, stateStream k = stateStream n := ⟨n, rfl⟩
  simp [hseen,
    hconsistent (Classical.choose hseen) n (Classical.choose_spec hseen)]

/-- State stream generated by a finite labelled transition carrier and a code. -/
def finiteCarrierStateStream
    {Q : Type x}
    {Move : Type y}
    (initial : Q)
    (step : Q -> Move -> Q)
    (code : Q -> Move) :
    Nat -> Q
  | 0 => initial
  | n + 1 =>
      step
        (finiteCarrierStateStream initial step code n)
        (code (finiteCarrierStateStream initial step code n))

@[simp] theorem finiteCarrierStateStream_zero
    {Q : Type x}
    {Move : Type y}
    (initial : Q)
    (step : Q -> Move -> Q)
    (code : Q -> Move) :
    finiteCarrierStateStream initial step code 0 = initial := rfl

theorem finiteCarrierStateStream_succ
    {Q : Type x}
    {Move : Type y}
    (initial : Q)
    (step : Q -> Move -> Q)
    (code : Q -> Move)
    (n : Nat) :
    finiteCarrierStateStream initial step code (n + 1) =
      step
        (finiteCarrierStateStream initial step code n)
        (code (finiteCarrierStateStream initial step code n)) := rfl

theorem finiteCarrierStateStream_codeOfStateStream_eq
    {Q : Type x}
    {Move : Type y}
    (initial : Q)
    (step : Q -> Move -> Q)
    (stateStream : Nat -> Q)
    (moveStream : Nat -> Move)
    (hinit : stateStream 0 = initial)
    (hstep :
      ∀ n : Nat,
        stateStream (n + 1) = step (stateStream n) (moveStream n))
    (hconsistent :
      ∀ i j : Nat, stateStream i = stateStream j -> moveStream i = moveStream j)
    (n : Nat) :
    finiteCarrierStateStream initial step
        (finiteCarrierCodeOfStateStream stateStream moveStream) n =
      stateStream n := by
  induction n with
  | zero =>
      simpa using hinit.symm
  | succ n ih =>
      rw [finiteCarrierStateStream_succ, ih]
      rw [finiteCarrierCodeOfStateStream_apply_of_consistent
        stateStream moveStream hconsistent n]
      exact (hstep n).symm

/-- Word read from a labelled finite-carrier state stream. -/
def finiteCarrierWord
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (emit : Q -> Move -> Alphabet)
    (stateStream : Nat -> Q)
    (moveStream : Nat -> Move) :
    OmegaWord Alphabet :=
  fun n => emit (stateStream n) (moveStream n)

/-- The move stream generated by a finite carrier code. -/
def finiteCarrierMoveStream
    {Q : Type x}
    {Move : Type y}
    (initial : Q)
    (step : Q -> Move -> Q)
    (code : Q -> Move) :
    Nat -> Move :=
  fun n => code (finiteCarrierStateStream initial step code n)

/-- The omega word generated by a finite carrier and memoryless move code. -/
def finiteCarrierPlayWord
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (initial : Q)
    (step : Q -> Move -> Q)
    (emit : Q -> Move -> Alphabet)
    (code : Q -> Move) :
    OmegaWord Alphabet :=
  finiteCarrierWord emit
    (finiteCarrierStateStream initial step code)
    (finiteCarrierMoveStream initial step code)

theorem finiteCarrierPlayWord_codeOfStateStream_eq
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (initial : Q)
    (step : Q -> Move -> Q)
    (emit : Q -> Move -> Alphabet)
    (stateStream : Nat -> Q)
    (moveStream : Nat -> Move)
    (hinit : stateStream 0 = initial)
    (hstep :
      ∀ n : Nat,
        stateStream (n + 1) = step (stateStream n) (moveStream n))
    (hconsistent :
      ∀ i j : Nat, stateStream i = stateStream j -> moveStream i = moveStream j) :
    finiteCarrierPlayWord initial step emit
        (finiteCarrierCodeOfStateStream stateStream moveStream) =
      finiteCarrierWord emit stateStream moveStream := by
  funext n
  have hstate :
      finiteCarrierStateStream initial step
          (finiteCarrierCodeOfStateStream stateStream moveStream) n =
        stateStream n :=
    finiteCarrierStateStream_codeOfStateStream_eq
      initial step stateStream moveStream hinit hstep hconsistent n
  have hmove :
      finiteCarrierCodeOfStateStream stateStream moveStream (stateStream n) =
        moveStream n :=
    finiteCarrierCodeOfStateStream_apply_of_consistent
      stateStream moveStream hconsistent n
  simp [finiteCarrierPlayWord, finiteCarrierWord, finiteCarrierMoveStream,
    hstate, hmove]

/--
Encoding a finite-carrier state space through an equivalence preserves the
generated carrier state stream, up to that equivalence.
-/
theorem finiteCarrierStateStream_encode
    {Q : Type x}
    {Qenc : Type y}
    {Move : Type z}
    (enc : Q ≃ Qenc)
    (initial : Q)
    (step : Q -> Move -> Q)
    (codeEnc : Qenc -> Move) :
    ∀ n : Nat,
      finiteCarrierStateStream (enc initial)
          (fun q move => enc (step (enc.symm q) move)) codeEnc n =
        enc
          (finiteCarrierStateStream initial step
            (fun q => codeEnc (enc q)) n) := by
  intro n
  induction n with
  | zero =>
      simp
  | succ n ih =>
      rw [finiteCarrierStateStream_succ, ih,
        finiteCarrierStateStream_succ]
      simp

/--
Encoding a finite-carrier state space through an equivalence preserves the
omega word generated by every encoded memoryless move code.
-/
theorem finiteCarrierPlayWord_encode
    {Q : Type x}
    {Qenc : Type y}
    {Move : Type z}
    {Alphabet : Type b}
    (enc : Q ≃ Qenc)
    (initial : Q)
    (step : Q -> Move -> Q)
    (emit : Q -> Move -> Alphabet)
    (codeEnc : Qenc -> Move) :
    finiteCarrierPlayWord (enc initial)
        (fun q move => enc (step (enc.symm q) move))
        (fun q move => emit (enc.symm q) move) codeEnc =
      finiteCarrierPlayWord initial step emit
        (fun q => codeEnc (enc q)) := by
  funext n
  have hstate :=
    finiteCarrierStateStream_encode enc initial step codeEnc n
  simp [finiteCarrierPlayWord, finiteCarrierWord, finiteCarrierMoveStream,
    hstate]

theorem finiteCarrierWord_loop_shift
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (emit : Q -> Move -> Alphabet)
    (stateStream : Nat -> Q)
    (moveStream : Nat -> Move)
    (start period : Nat)
    (hstateShift :
      ∀ m : Nat,
        stateStream (start + period + m) = stateStream (start + m))
    (hmoveShift :
      ∀ m : Nat,
        moveStream (start + period + m) = moveStream (start + m)) :
    ∀ m : Nat,
      finiteCarrierWord emit stateStream moveStream (start + period + m) =
        finiteCarrierWord emit stateStream moveStream (start + m) := by
  intro m
  simp [finiteCarrierWord, hstateShift m, hmoveShift m]

theorem dpaOf_finiteCarrierStateStream_eq_run_finiteCarrierWord
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (stateStream : Nat -> Q)
    (moveStream : Nat -> Move)
    (dpaOf : Q -> A.State)
    (hdpaInit : dpaOf (stateStream 0) = A.initial)
    (hdpaStep :
      ∀ n : Nat,
        dpaOf (stateStream (n + 1)) =
          A.step (dpaOf (stateStream n))
            (finiteCarrierWord emit stateStream moveStream n)) :
    ∀ n : Nat,
      dpaOf (stateStream n) =
        A.run (finiteCarrierWord emit stateStream moveStream) n := by
  intro n
  induction n with
  | zero =>
      exact hdpaInit
  | succ n ih =>
      rw [hdpaStep n, A.run_succ, ih]

/--
A DPA priority seen infinitely often along a finite-carrier stream is carried
by some concrete carrier state seen infinitely often.
-/
theorem exists_finiteCarrierStateSeenInfinitelyOften_of_prioritySeenInfinitelyOften
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (stateStream : Nat -> Q)
    (moveStream : Nat -> Move)
    (dpaOf : Q -> A.State)
    [Fintype Q]
    {p : Nat}
    (hdpaRun :
      ∀ n : Nat,
        dpaOf (stateStream n) =
          A.run (finiteCarrierWord emit stateStream moveStream) n)
    (hp :
      A.PrioritySeenInfinitelyOften
        (finiteCarrierWord emit stateStream moveStream) p) :
    ∃ state : Q,
      A.priority (dpaOf state) = p ∧
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧ stateStream k = state := by
  classical
  let targets : Finset Q :=
    Finset.univ.filter (fun state => A.priority (dpaOf state) = p)
  have hfreq :
      ∀ n : Nat,
        ∃ k : Nat, n ≤ k ∧ stateStream k ∈ targets := by
    intro n
    rcases hp n with ⟨k, hk, hkprio⟩
    refine ⟨k, hk, ?_⟩
    have hprioState : A.priority (dpaOf (stateStream k)) = p := by
      rw [hdpaRun k]
      exact hkprio
    simp [targets, hprioState]
  rcases DetParityAutomaton.exists_seenInfinitelyOften_of_frequently_mem_finset
      (fun n : Nat => stateStream n) targets hfreq with
    ⟨state, hstateTarget, hstateSeen⟩
  refine ⟨state, ?_, hstateSeen⟩
  simpa [targets] using hstateTarget

/--
Rejected finite-carrier progress streams have a recurrent carrier state whose
decoded DPA state carries the odd least recurring priority.
-/
theorem exists_recurrent_finiteCarrierState_min_priority_not_even_of_not_accepts
    {Q : Type x}
    {Move : Type y}
    {Alphabet : Type z}
    (emit : Q -> Move -> Alphabet)
    (A : DetParityAutomaton.{z, b} Alphabet)
    (stateStream : Nat -> Q)
    (moveStream : Nat -> Move)
    (dpaOf : Q -> A.State)
    [Fintype Q]
    (hdpaRun :
      ∀ n : Nat,
        dpaOf (stateStream n) =
          A.run (finiteCarrierWord emit stateStream moveStream) n)
    (hreject :
      ¬ A.Accepts (finiteCarrierWord emit stateStream moveStream)) :
    ∃ p : Nat,
      ∃ state : Q,
        A.priority (dpaOf state) = p ∧
          (∀ n : Nat, ∃ k : Nat, n ≤ k ∧ stateStream k = state) ∧
            (∀ q : Nat,
              A.PrioritySeenInfinitelyOften
                (finiteCarrierWord emit stateStream moveStream) q ->
              p ≤ q) ∧
              ¬ DetParityAutomaton.NatEven p := by
  rcases
      A.exists_min_prioritySeenInfinitelyOften_not_even_of_not_accepts
        (finiteCarrierWord emit stateStream moveStream) hreject with
    ⟨p, hpSeen, hpMin, hpOdd⟩
  rcases
      exists_finiteCarrierStateSeenInfinitelyOften_of_prioritySeenInfinitelyOften
        emit A stateStream moveStream dpaOf hdpaRun hpSeen with
    ⟨state, hstatePriority, hstateSeen⟩
  exact ⟨p, state, hstatePriority, hstateSeen, hpMin, hpOdd⟩

