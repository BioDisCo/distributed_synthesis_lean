    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hcompatible :
      RoundAwareLambdaControllerCompatibleExecution
        T historyOne historyTwo fringeOne fringeTwo controller
        historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
        (strategyOfRoundAwareLambdaController
          T historyOne historyTwo fringeOne fringeTwo controller
          historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
          defaultOne defaultTwo)
        env word) :
    word =
      execution
        (strategyOfRoundAwareLambdaController
          T historyOne historyTwo fringeOne fringeTwo controller
          historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
          defaultOne defaultTwo)
        env := by
  funext n
  let σ :=
    strategyOfRoundAwareLambdaController
      T historyOne historyTwo fringeOne fringeTwo controller
      historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
      defaultOne defaultTwo
  rcases hcompatible n with
    ⟨stateOne, hhistoryOne, hfringeOne,
      stateTwo, hhistoryTwo, hfringeTwo, hword⟩
  rw [hword, execution_apply]
  have hone :
      (controller.1 stateOne (env n)).1 =
        σ.one (nextView Proc.one (executionPrefix σ env n) (env n)) :=
    (strategyOneOfRoundAwareLambdaController_apply_decoded
      T historyOne historyTwo fringeOne fringeTwo controller
      historyOfViewOne fringeOfViewOne defaultOne
      stateOne (env n)
      (nextView Proc.one (executionPrefix σ env n) (env n))
      hhistoryOne hfringeOne).symm
  have htwo :
      (controller.1 stateTwo (env n)).2 =
        σ.two (nextView Proc.two (executionPrefix σ env n) (env n)) :=
    (strategyTwoOfRoundAwareLambdaController_apply_decoded
      T historyOne historyTwo fringeOne fringeTwo controller
      historyOfViewTwo fringeOfViewTwo defaultTwo
      stateTwo (env n)
      (nextView Proc.two (executionPrefix σ env n) (env n))
      hhistoryTwo hfringeTwo).symm
  cases henv : env n with
  | mk inputOne inputTwo graph =>
      have honeEnv :
          (controller.1 stateOne
              { inputOne := inputOne, inputTwo := inputTwo, graph := graph }).1 =
            σ.one
              (nextView Proc.one (executionPrefix σ env n)
                { inputOne := inputOne, inputTwo := inputTwo, graph := graph }) := by
        simpa [henv] using hone
      have htwoEnv :
          (controller.1 stateTwo
              { inputOne := inputOne, inputTwo := inputTwo, graph := graph }).2 =
            σ.two
              (nextView Proc.two (executionPrefix σ env n)
                { inputOne := inputOne, inputTwo := inputTwo, graph := graph }) := by
        simpa [henv] using htwo
      simpa [nextRound, σ] using And.intro honeEnv htwoEnv

/--
The concrete no-direct stream follows the round-aware epoch transition for a
finite-lambda controller as soon as the stream's finite summaries/fringe
arguments match the real local views of the extracted strategy.
-/
theorem noDirectEpochStateStream_succ_eq_roundAwareGameTransition_of_lambdaController
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (historyOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        uniform.noDirectEpochTransformer
        historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (hactual :
      ∀ n : Nat,
        let σ :=
          strategyOfRoundAwareLambdaController
            uniform.noDirectEpochTransformer
            historyOne historyTwo fringeOne fringeTwo controller
            historyOfViewOne historyOfViewTwo
            fringeOfViewOne fringeOfViewTwo
            defaultOne defaultTwo
        let state := uniform.noDirectEpochStateStream initialBoundary σ env n
        historyOne state (env n) =
            historyOfViewOne
              (nextView Proc.one (executionPrefix σ env n) (env n)) ∧
          fringeOne state (env n) =
            fringeOfViewOne
              (nextView Proc.one (executionPrefix σ env n) (env n)) ∧
          historyTwo state (env n) =
            historyOfViewTwo
              (nextView Proc.two (executionPrefix σ env n) (env n)) ∧
          fringeTwo state (env n) =
            fringeOfViewTwo
              (nextView Proc.two (executionPrefix σ env n) (env n))) :
    ∀ n : Nat,
      let σ :=
        strategyOfRoundAwareLambdaController
          uniform.noDirectEpochTransformer
          historyOne historyTwo fringeOne fringeTwo controller
          historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
          defaultOne defaultTwo
      uniform.noDirectEpochStateStream initialBoundary σ env (n + 1) =
        roundAwareGameTransition uniform.noDirectEpochTransformer controller.1
          (uniform.noDirectEpochStateStream initialBoundary σ env n)
          (env n) := by
  let σ :=
    strategyOfRoundAwareLambdaController
      uniform.noDirectEpochTransformer
      historyOne historyTwo fringeOne fringeTwo controller
      historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
      defaultOne defaultTwo
  refine
    noDirectEpochStateStream_succ_eq_roundAwareGameTransition_of_controller_matches
      uniform initialBoundary controller.1 σ env ?_
  intro n
  let state := uniform.noDirectEpochStateStream initialBoundary σ env n
  rcases hactual n with
    ⟨hhistoryOne, hfringeOne, hhistoryTwo, hfringeTwo⟩
  have hone :
      σ.one (nextView Proc.one (executionPrefix σ env n) (env n)) =
        (controller.1 state (env n)).1 :=
    strategyOneOfRoundAwareLambdaController_apply_decoded
      uniform.noDirectEpochTransformer
      historyOne historyTwo fringeOne fringeTwo controller
      historyOfViewOne fringeOfViewOne defaultOne
      state (env n)
      (nextView Proc.one (executionPrefix σ env n) (env n))
      hhistoryOne hfringeOne
  have htwo :
      σ.two (nextView Proc.two (executionPrefix σ env n) (env n)) =
        (controller.1 state (env n)).2 :=
    strategyTwoOfRoundAwareLambdaController_apply_decoded
      uniform.noDirectEpochTransformer
      historyOne historyTwo fringeOne fringeTwo controller
      historyOfViewTwo fringeOfViewTwo defaultTwo
      state (env n)
      (nextView Proc.two (executionPrefix σ env n) (env n))
      hhistoryTwo hfringeTwo
  exact Prod.ext hone.symm htwo.symm

/--
The contingent/lambda controller is locally observable whenever its finite
history summary and current fringe selector are decoded from the corresponding
local view.
-/
theorem roundAwareControllerLocallyObservable_of_contingentStrategy
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (strategy :
      ContingentStrategyPair H₁ H₂ R₁ R₂ Out₁ Out₂)
    (decodeOne :
      ∀ stateA envA stateB envB,
        viewOne stateA envA = viewOne stateB envB ->
          historyOne stateA envA = historyOne stateB envB ∧
            fringeOne stateA envA = fringeOne stateB envB)
    (decodeTwo :
      ∀ stateA envA stateB envB,
        viewTwo stateA envA = viewTwo stateB envB ->
          historyTwo stateA envA = historyTwo stateB envB ∧
            fringeTwo stateA envA = fringeTwo stateB envB) :
    RoundAwareControllerLocallyObservable T viewOne viewTwo
      (roundAwareControllerOfContingentStrategy
        T historyOne historyTwo fringeOne fringeTwo strategy) := by
  constructor
  · intro stateA envA stateB envB hview
    rcases decodeOne stateA envA stateB envB hview with
      ⟨hhistory, hfringe⟩
    simp [roundAwareControllerOfContingentStrategy, hhistory, hfringe]
  · intro stateA envA stateB envB hview
    rcases decodeTwo stateA envA stateB envB hview with
      ⟨hhistory, hfringe⟩
    simp [roundAwareControllerOfContingentStrategy, hhistory, hfringe]

/--
Pack the contingent/lambda construction directly into the locally observable
round-aware finite-controller carrier.
-/
def roundAwareLocalControllerOfContingentStrategy
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {H₁ : Type b}
    {H₂ : Type x}
    {R₁ : Type y}
    {R₂ : Type z}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (strategy :
      ContingentStrategyPair H₁ H₂ R₁ R₂ Out₁ Out₂)
    (decodeOne :
      ∀ stateA envA stateB envB,
        viewOne stateA envA = viewOne stateB envB ->
          historyOne stateA envA = historyOne stateB envB ∧
            fringeOne stateA envA = fringeOne stateB envB)
    (decodeTwo :
      ∀ stateA envA stateB envB,
        viewTwo stateA envA = viewTwo stateB envB ->
          historyTwo stateA envA = historyTwo stateB envB ∧
            fringeTwo stateA envA = fringeTwo stateB envB) :
    RoundAwareLocalControllerCode T viewOne viewTwo :=
  ⟨roundAwareControllerOfContingentStrategy
      T historyOne historyTwo fringeOne fringeTwo strategy,
    roundAwareControllerLocallyObservable_of_contingentStrategy
      T viewOne viewTwo historyOne historyTwo fringeOne fringeTwo strategy
      decodeOne decodeTwo⟩

/-- Last non-fringe observation of a finite local observation history, with the empty view as default. -/
def latestNonFringeOrEmpty
    {In₁ : Type u}
    {In₂ : Type v}
    (p : Proc) :
    List (NonFringeView In₁ In₂ p) -> NonFringeView In₁ In₂ p
  | [] => .empty p
  | [view] => view
  | _ :: rest => latestNonFringeOrEmpty p rest

/--
Turn an ordinary local full-view strategy into a one-bit-fringe contingent
strategy over non-fringe views and current receipt tags.
-/
def contingentStrategyPairOfStrategyOnNonFringe
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) :
    ContingentStrategyPair
      (NonFringeView In₁ In₂ Proc.one)
      (NonFringeView In₁ In₂ Proc.two)
      ReceiptTag ReceiptTag Out₁ Out₂ where
  one := fun history currentReceipt =>
    σ.one ((latestNonFringeOrEmpty Proc.one history).withReceiptTag currentReceipt)
  two := fun history currentReceipt =>
    σ.two ((latestNonFringeOrEmpty Proc.two history).withReceiptTag currentReceipt)

@[simp]
theorem latestNonFringeOrEmpty_singleton
    {In₁ : Type u}
    {In₂ : Type v}
    {p : Proc}
    (view : NonFringeView In₁ In₂ p) :
    latestNonFringeOrEmpty p [view] = view := by
  rfl

/--
The one-bit contingent strategy agrees with the original process-1 strategy
when supplied the current non-fringe view and current receipt tag.
-/
theorem contingentStrategyPairOfStrategyOnNonFringe_one_singleton
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (view : View In₁ In₂ Proc.one) :
    (contingentStrategyPairOfStrategyOnNonFringe σ).one
        [view.nonFringe] view.receiptTag =
      σ.one view := by
  simp [contingentStrategyPairOfStrategyOnNonFringe]

/--
The one-bit contingent strategy agrees with the original process-2 strategy
when supplied the current non-fringe view and current receipt tag.
-/
theorem contingentStrategyPairOfStrategyOnNonFringe_two_singleton
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (view : View In₁ In₂ Proc.two) :
    (contingentStrategyPairOfStrategyOnNonFringe σ).two
        [view.nonFringe] view.receiptTag =
      σ.two view := by
  simp [contingentStrategyPairOfStrategyOnNonFringe]

/--
Process 1: the lambda chosen from the current non-fringe view recovers the
ordinary strategy output when evaluated at the actual current receipt tag.
-/
theorem contingentStrategyPairOfStrategyOnNonFringe_one_currentView
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (h : History In₁ In₂ Graph Out₁ Out₂) :
    (contingentStrategyPairOfStrategyOnNonFringe σ).one
        [currentNonFringe Proc.one h] (currentView Proc.one h).receiptTag =
      σ.one (currentView Proc.one h) := by
  simpa [currentNonFringe] using
    contingentStrategyPairOfStrategyOnNonFringe_one_singleton
      σ (currentView Proc.one h)

/--
Process 2: the lambda chosen from the current non-fringe view recovers the
ordinary strategy output when evaluated at the actual current receipt tag.
-/
theorem contingentStrategyPairOfStrategyOnNonFringe_two_currentView
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (h : History In₁ In₂ Graph Out₁ Out₂) :
    (contingentStrategyPairOfStrategyOnNonFringe σ).two
        [currentNonFringe Proc.two h] (currentView Proc.two h).receiptTag =
      σ.two (currentView Proc.two h) := by
  simpa [currentNonFringe] using
    contingentStrategyPairOfStrategyOnNonFringe_two_singleton
      σ (currentView Proc.two h)

/--
Process 1: indistinguishable non-fringe histories choose the same lambda
function.  The hidden current receipt/arrow bit is an argument of that lambda,
not information used to choose a different lambda.
-/
theorem contingentStrategyPairOfStrategyOnNonFringe_one_of_nonFringe_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    {h h' : History In₁ In₂ Graph Out₁ Out₂}
    (hind : currentNonFringe Proc.one h = currentNonFringe Proc.one h') :
    (fun receipt =>
        (contingentStrategyPairOfStrategyOnNonFringe σ).one
          [currentNonFringe Proc.one h] receipt) =
      (fun receipt =>
        (contingentStrategyPairOfStrategyOnNonFringe σ).one
          [currentNonFringe Proc.one h'] receipt) := by
  funext receipt
  simp [contingentStrategyPairOfStrategyOnNonFringe, hind]

/--
Process 2: indistinguishable non-fringe histories choose the same lambda
function.  The hidden current receipt/arrow bit is an argument of that lambda,
not information used to choose a different lambda.
-/
theorem contingentStrategyPairOfStrategyOnNonFringe_two_of_nonFringe_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    {h h' : History In₁ In₂ Graph Out₁ Out₂}
    (hind : currentNonFringe Proc.two h = currentNonFringe Proc.two h') :
    (fun receipt =>
        (contingentStrategyPairOfStrategyOnNonFringe σ).two
          [currentNonFringe Proc.two h] receipt) =
      (fun receipt =>
        (contingentStrategyPairOfStrategyOnNonFringe σ).two
          [currentNonFringe Proc.two h'] receipt) := by
  funext receipt
  simp [contingentStrategyPairOfStrategyOnNonFringe, hind]

/--
Concrete current-view instance of the lambda trick: use the decoded current
non-fringe view as the finite history summary and the decoded receipt tag as
the current one-bit fringe.
-/
def roundAwareLocalControllerOfStrategyViaCurrentFringe
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) :
    RoundAwareLocalControllerCode T viewOne viewTwo :=
  roundAwareLocalControllerOfContingentStrategy
    T viewOne viewTwo
    (fun state envRound => [(viewOne state envRound).nonFringe])
    (fun state envRound => [(viewTwo state envRound).nonFringe])
    (fun state envRound => (viewOne state envRound).receiptTag)
    (fun state envRound => (viewTwo state envRound).receiptTag)
    (contingentStrategyPairOfStrategyOnNonFringe σ)
    (by
      intro stateA envA stateB envB hview
      constructor <;> simp [hview])
    (by
      intro stateA envA stateB envB hview
      constructor <;> simp [hview])

@[simp]
theorem roundAwareLocalControllerOfStrategyViaCurrentFringe_apply
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (state : GameState T)
    (envRound : EnvironmentRound In₁ In₂) :
    (roundAwareLocalControllerOfStrategyViaCurrentFringe
        T viewOne viewTwo σ).1 state envRound =
      (σ.one (viewOne state envRound),
        σ.two (viewTwo state envRound)) := by
  simp [roundAwareLocalControllerOfStrategyViaCurrentFringe,
    roundAwareLocalControllerOfContingentStrategy,
    roundAwareControllerOfContingentStrategy,
    contingentStrategyPairOfStrategyOnNonFringe]

/--
Finite-lambda controller obtained from the current non-fringe view and the
current receipt tag.  This is the direct lambda-carrier version of
`roundAwareLocalControllerOfStrategyViaCurrentFringe`.
-/
def roundAwareLambdaControllerOfStrategyViaCurrentFringe
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) :
    RoundAwareLambdaControllerCode
      T
      (fun state envRound => [(viewOne state envRound).nonFringe])
      (fun state envRound => [(viewTwo state envRound).nonFringe])
      (fun state envRound => (viewOne state envRound).receiptTag)
      (fun state envRound => (viewTwo state envRound).receiptTag) :=
  roundAwareLambdaControllerOfContingentStrategy
    T
    (fun state envRound => [(viewOne state envRound).nonFringe])
    (fun state envRound => [(viewTwo state envRound).nonFringe])
    (fun state envRound => (viewOne state envRound).receiptTag)
    (fun state envRound => (viewTwo state envRound).receiptTag)
    (contingentStrategyPairOfStrategyOnNonFringe σ)

@[simp]
theorem roundAwareLambdaControllerOfStrategyViaCurrentFringe_apply
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (viewOne :
      GameState T -> EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
