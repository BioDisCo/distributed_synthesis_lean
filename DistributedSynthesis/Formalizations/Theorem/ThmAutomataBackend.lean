    (historyOne :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      GameState T -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      GameState T -> EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) : Prop :=
  (∀ state envRound view,
    historyOne state envRound = historyOfViewOne view ->
    fringeOne state envRound = fringeOfViewOne view ->
      (controller.1 state envRound).1 = σ.one view) ∧
  (∀ state envRound view,
    historyTwo state envRound = historyOfViewTwo view ->
    fringeTwo state envRound = fringeOfViewTwo view ->
      (controller.1 state envRound).2 = σ.two view)

