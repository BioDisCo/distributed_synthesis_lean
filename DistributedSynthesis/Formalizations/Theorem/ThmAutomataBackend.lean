/--
The finite-lambda round-aware certificate instantiates the generic finite
strategy abstraction interface.
-/
noncomputable def toDPAFiniteStrategyAbstraction
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert :
      RoundAwareLambdaEpochGameAbstractionCertificate.{u, v, w, a, b, x, y, z} A) :
    DPAFiniteStrategyAbstraction.{u, v, w, a, max u v w a} Out₂ A := by
  classical
  let controllerFinite :=
    Classical.choice
      (cert.transformer.roundAwareLambdaControllerCode_fintype
        cert.historyOne cert.historyTwo cert.fringeOne cert.fringeTwo)
  let environmentFinite := Classical.choice cert.transformer.environmentCode_fintype
  exact
    {
      ControllerCode :=
        cert.transformer.RoundAwareLambdaControllerCode
          cert.historyOne cert.historyTwo cert.fringeOne cert.fringeTwo
      EnvironmentCode := cert.transformer.EnvironmentCode
      controllerFinite := controllerFinite
      environmentFinite := environmentFinite
      wins := fun controller environment =>
        cert.transformer.roundAwareGameWins
          cert.initialBoundary controller.1 environment
      winsDecidable := cert.winsDecidable
      controllerStrategy := cert.controllerStrategy
      dynamicHierarchy := cert.dynamicHierarchy
      parityObjective := cert.parityObjective
      dynamicHierarchy_proof := cert.dynamicHierarchy_proof
      parityObjective_proof := cert.parityObjective_proof
      sound := cert.sound
      complete := cert.complete
    }

/-- The finite-lambda round-aware certificate yields a finite-game compilation. -/
noncomputable def toDPAToFiniteGameCompilation
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert :
      RoundAwareLambdaEpochGameAbstractionCertificate.{u, v, w, a, b, x, y, z} A) :
    DPAToFiniteGameCompilation.{u, v, w, a, max u v w a} Out₂ A := by
  let abstraction := cert.toDPAFiniteStrategyAbstraction
  exact
    {
      finiteGame :=
        {
          ControllerStrategy := abstraction.ControllerCode
          EnvironmentStrategy := abstraction.EnvironmentCode
          controllerFinite := abstraction.controllerFinite
          environmentFinite := abstraction.environmentFinite
          wins := abstraction.wins
          winsDecidable := abstraction.winsDecidable
          dynamicHierarchy := abstraction.dynamicHierarchy
          parityObjective := abstraction.parityObjective
          dynamicHierarchy_proof := abstraction.dynamicHierarchy_proof
          parityObjective_proof := abstraction.parityObjective_proof
        }
      realizabilityEquivalent := by
        constructor
        · intro h
          rcases h with ⟨controller, hwins⟩
          exact
            ⟨abstraction.controllerStrategy controller,
              abstraction.sound controller hwins⟩
        · intro h
          rcases h with ⟨σ, hσ⟩
          rcases abstraction.complete σ hσ with ⟨controller, hwins⟩
          exact ⟨controller, hwins⟩
    }

end RoundAwareLambdaEpochGameAbstractionCertificate

