/--
Reuse a finite-game compilation for a language-equivalent DPA.

Only equivalence on executions is needed, since finite-game compilations are
used through synthesis realizability rather than through the whole omega
language.
-/
def DPAToFiniteGameCompilation.transfer
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A B : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (compilation : DPAToFiniteGameCompilation.{u, v, w, a, b} Out₂ A)
    (sameExecutions :
      ∀ (σ : StrategyPair In₁ In₂ Out₁ Out₂)
        (env : EnvironmentSequence In₁ In₂),
        B.Accepts (execution σ env) ↔ A.Accepts (execution σ env)) :
    DPAToFiniteGameCompilation.{u, v, w, a, b} Out₂ B where
  finiteGame := compilation.finiteGame
  realizabilityEquivalent := by
    rw [compilation.realizabilityEquivalent]
    constructor
    · intro h
      rcases h with ⟨σ, hσ⟩
      exact ⟨σ, fun env => (sameExecutions σ env).mpr (hσ env)⟩
    · intro h
      rcases h with ⟨σ, hσ⟩
      exact ⟨σ, fun env => (sameExecutions σ env).mp (hσ env)⟩

/--
Reuse a finite-game compilation for a DPA with the same omega-language.
-/
def DPAToFiniteGameCompilation.transferLanguage
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A B : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (compilation : DPAToFiniteGameCompilation.{u, v, w, a, b} Out₂ A)
    (sameLanguage :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        B.Accepts word ↔ A.Accepts word) :
    DPAToFiniteGameCompilation.{u, v, w, a, b} Out₂ B :=
  compilation.transfer (fun σ env => sameLanguage (execution σ env))

/--
A finite-game compilation for `A` is also a finite-game compilation for the
language-equivalent DPA obtained by shifting every priority by two.
-/
def DPAToFiniteGameCompilation.shiftPriorityTwo
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (compilation : DPAToFiniteGameCompilation.{u, v, w, a, b} Out₂ A) :
    DPAToFiniteGameCompilation.{u, v, w, a, b} Out₂ (A.shiftPriority 2) :=
  compilation.transferLanguage
    (fun word => DetParityAutomaton.shiftPriority_two_accepts_iff A word)

/--
A tracking-style finite-game compilation for `A` also compiles the
priority-normalized DPA `A.shiftPriority 2`.
-/
def DPATrackingFiniteGameCompilation.shiftPriorityTwo
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (compilation :
      DPATrackingFiniteGameCompilation.{u, v, w, a, b} Out₂ A) :
    DPATrackingFiniteGameCompilation.{u, v, w, a, b} Out₂ (A.shiftPriority 2) where
  prefixLength := compilation.prefixLength
  finiteGame := compilation.finiteGame
  trackingRealizabilityEquivalent := by
    rw [compilation.trackingRealizabilityEquivalent]
    constructor
    · intro h
      rcases h with ⟨σ, hσ⟩
      refine ⟨σ, ?_⟩
      intro env
      change
        (A.shiftPriority 2).AcceptsFrom
          ((A.shiftPriority 2).run (execution σ env) compilation.prefixLength)
          (OmegaWord.drop (execution σ env) compilation.prefixLength)
      rw [DetParityAutomaton.shiftPriority_run]
      exact
        (DetParityAutomaton.shiftPriority_two_acceptsFrom_iff
          A
          (A.run (execution σ env) compilation.prefixLength)
          (OmegaWord.drop (execution σ env) compilation.prefixLength)).mpr
            (hσ env)
    · intro h
      rcases h with ⟨σ, hσ⟩
      refine ⟨σ, ?_⟩
      intro env
      have hshift := hσ env
      change
        (A.shiftPriority 2).AcceptsFrom
          ((A.shiftPriority 2).run (execution σ env) compilation.prefixLength)
          (OmegaWord.drop (execution σ env) compilation.prefixLength) at hshift
      rw [DetParityAutomaton.shiftPriority_run] at hshift
      exact
        (DetParityAutomaton.shiftPriority_two_acceptsFrom_iff
          A
          (A.run (execution σ env) compilation.prefixLength)
          (OmegaWord.drop (execution σ env) compilation.prefixLength)).mp
            hshift

/-- The execution specification induced by a deterministic parity automaton. -/
def dpaSpecification
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂)) :
    Specification In₁ In₂ Out₁ Out₂ :=
  fun word => A.Accepts word

/--
DPA-facing specialization of
`NoDirectReversalFragmentCertificate.toEffectiveParitySpecification`.

Once the no-direct finite-game certificate's abstract `Realizable` proposition
is identified with realizability of the DPA objective, it directly yields the
compiled parity specification consumed by the main theorem.
-/
noncomputable def NoDirectReversalFragmentCertificate.toDPAEffectiveParitySpecification
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (certificate :
      NoDirectReversalFragmentCertificate
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (realizableEquivalent :
      certificate.Realizable ↔
        ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
          ∀ env : EnvironmentSequence In₁ In₂,
            A.Accepts (execution σ env)) :
    EffectiveParitySpecification In₁ In₂ Out₁ Out₂ :=
  certificate.toEffectiveParitySpecification
    (dpaSpecification A)
    realizableEquivalent

/--
Decision form of `NoDirectReversalFragmentCertificate.toDPAEffectiveParitySpecification`.

This is the direct theorem-facing conclusion supplied by a no-direct
finite-game certificate for one DPA objective.
-/
noncomputable def NoDirectReversalFragmentCertificate.dpaSynthesisDecidable
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (certificate :
      NoDirectReversalFragmentCertificate
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (realizableEquivalent :
      certificate.Realizable ↔
        ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
          ∀ env : EnvironmentSequence In₁ In₂,
            A.Accepts (execution σ env)) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  effective_parity_synthesis_problem_decidable
    (certificate.toDPAEffectiveParitySpecification A realizableEquivalent)

/--
Direct DPA decision theorem from an already assembled finite `A`-index
certificate for the no-direct fragment.

This is the theorem-level landing point for Step 4's explicit finite-index
handoff: once the quotient has been packaged as
`FiniteAIndexDecisionCertificate`, the remaining no-direct-specific inputs are
only the finite-fringe and block-level side conditions.
-/
noncomputable def noDirectDPASynthesisDecidable_of_finiteAIndexCertificate
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    {Config : Type z}
    (A : DetParityAutomaton.{max u v w a, b}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (finiteFringeCompilation : Prop)
    (finiteFringeCompilation_proof : finiteFringeCompilation)
    (boundaryAndBlockTransitionsEffective : Prop)
    (boundaryAndBlockTransitionsEffective_proof :
      boundaryAndBlockTransitionsEffective)
    (continuationPreservedBlockByBlock : Prop)
    (continuationPreservedBlockByBlock_proof :
      continuationPreservedBlockByBlock)
    (finiteIndex :
      FiniteAIndexDecisionCertificate
        Config
        (∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
          ∀ env : EnvironmentSequence In₁ In₂,
            A.Accepts (execution σ env))) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  let certificate :=
    noDirectReversalFragmentCertificateOfFiniteAIndex
      (Alphabet := RoundRecord In₁ In₂ Graph Out₁ Out₂)
      (Config := Config)
      (Realizable :=
        ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
          ∀ env : EnvironmentSequence In₁ In₂,
            A.Accepts (execution σ env))
      uniform
      finiteFringeCompilation
