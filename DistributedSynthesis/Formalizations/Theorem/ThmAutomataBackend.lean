    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    [Fintype (GameState T)]
    (hinit : stateStream 0 = Sum.inl initialBoundary)
    (hstep :
      ∀ n : Nat,
        stateStream (n + 1) =
          roundAwareGameTransition T controller (stateStream n) (env n))
    (hconsistent :
      ∀ i j : Nat, stateStream i = stateStream j -> env i = env j)
    (hdpaInit : dpaOf (stateStream 0) = A.initial)
    (hdpaStep :
      ∀ n : Nat,
        dpaOf (stateStream (n + 1)) =
          A.step (dpaOf (stateStream n))
            (roundAwareWordOfStateStream T controller stateStream env n))
    (hreject :
      ¬ A.Accepts (roundAwareWordOfStateStream T controller stateStream env)) :
    ∃ environment : EnvironmentCode T,
      ¬ A.Accepts
        (roundAwareGameExecution T initialBoundary controller environment) := by
  classical
  rcases
      exists_recurrent_gameState_min_priority_not_even_and_eventually_ge_of_not_accepts_roundAwareWordOfStateStream_of_dpaProgress
        T controller A stateStream env dpaOf hdpaInit hdpaStep hreject with
    ⟨p, recurrentState, cutoff, hrecurrentPriority, hrecurrentSeen,
      hcycleLowerFromCutoff, hpOdd⟩
  rcases hrecurrentSeen cutoff with
    ⟨start, hcutoffStart, hstartState⟩
  rcases hrecurrentSeen (start + 1) with
    ⟨stop, hstartStop, hstopState⟩
  let period := stop - start
  have hstopEq : start + period = stop := by
    dsimp [period]
    omega
  have hperiodPositive : 0 < period := by
    dsimp [period]
    omega
  have hcycleClose : stateStream (start + period) = stateStream start := by
    rw [hstopEq, hstopState, hstartState]
  have hstepBounded :
      ∀ k : Nat,
        k < start + period ->
          stateStream (selectedLassoNextIndex start period k) =
            roundAwareGameTransition T controller
              (stateStream k) (env k) := by
    intro k hk
    by_cases hlast : k + 1 = start + period
    · have hkge : start ≤ k := by omega
      rw [selectedLassoNextIndex_eq_start_of_last start period k hkge hlast]
      calc
        stateStream start = stateStream (k + 1) := by
          rw [hlast]
          exact hcycleClose.symm
        _ = roundAwareGameTransition T controller
              (stateStream k) (env k) := hstep k
    · rw [selectedLassoNextIndex_eq_succ_of_not_last start period k hk hlast]
      exact hstep k
  have hdpaStepBounded :
      ∀ k : Nat,
        k < start + period ->
          dpaOf (stateStream (selectedLassoNextIndex start period k)) =
            A.step (dpaOf (stateStream k))
              {
                inputOne := (env k).inputOne
                inputTwo := (env k).inputTwo
                graph := (env k).graph
                outputOne := (controller (stateStream k) (env k)).1
                outputTwo := (controller (stateStream k) (env k)).2
              } := by
    intro k hk
    by_cases hlast : k + 1 = start + period
    · have hkge : start ≤ k := by omega
      rw [selectedLassoNextIndex_eq_start_of_last start period k hkge hlast]
      calc
        dpaOf (stateStream start) = dpaOf (stateStream (k + 1)) := by
          rw [hlast]
          exact congrArg dpaOf hcycleClose.symm
        _ = A.step (dpaOf (stateStream k))
              {
                inputOne := (env k).inputOne
                inputTwo := (env k).inputTwo
                graph := (env k).graph
                outputOne := (controller (stateStream k) (env k)).1
                outputTwo := (controller (stateStream k) (env k)).2
              } := by
                simpa [roundAwareWordOfStateStream] using hdpaStep k
    · rw [selectedLassoNextIndex_eq_succ_of_not_last start period k hk hlast]
      simpa [roundAwareWordOfStateStream] using hdpaStep k
  have hfunctional :
      ∀ i j : Nat,
        i < start + period ->
        j < start + period ->
        stateStream i = stateStream j ->
          env i = env j := by
    intro i j _ _ hstate
    exact hconsistent i j hstate
  have hentryPriority :
      A.priority (dpaOf (stateStream start)) = p := by
    rw [hstartState]
    exact hrecurrentPriority
  have hcycleLower :
      ∀ i : Nat,
        i < period ->
          p ≤ A.priority (dpaOf (stateStream (start + i))) := by
    intro i hi
    exact hcycleLowerFromCutoff (start + i) (by omega)
  exact
    exists_environmentCode_rejected_roundAwareGameExecution_of_selected_lasso_indices_of_bounded_edges_functional_dpaProgress_lowerBound
      T initialBoundary controller A stateStream env dpaOf
      start period hperiodPositive hinit hstepBounded
      hfunctional hdpaInit hdpaStepBounded
      hentryPriority hcycleLower hpOdd

