        start ≤ k ->
          ∃ i : Nat,
            i < period ∧
              A.priority
                  (A.run
                    (roundAwareWordOfStateStream T controller stateStream env) k) =
                A.priority
                  (A.run
                    (roundAwareWordOfStateStream T controller stateStream env)
                    (start + i)))
    (hperiodic :
      ∀ i n : Nat,
        i < period ->
          A.priority
              (A.run
                (roundAwareWordOfStateStream T controller stateStream env)
                (start + i + n * period)) =
            A.priority
              (A.run
                (roundAwareWordOfStateStream T controller stateStream env)
                (start + i)))
    (hodd :
      ¬ DetParityAutomaton.NatEven
        (((Finset.range period).image
          (fun i : Nat =>
            A.priority
              (A.run
                (roundAwareWordOfStateStream T controller stateStream env)
                (start + i)))).min'
          (Finset.image_nonempty.mpr
            (Finset.nonempty_range_iff.mpr (Nat.ne_of_gt hperiodPositive))))) :
    ∃ environment : EnvironmentCode T,
      ¬ A.Accepts
        (roundAwareGameExecution T initialBoundary controller environment) := by
  let environment := environmentCodeOfStateStream T stateStream env
  refine ⟨environment, ?_⟩
  have hword :
      roundAwareGameExecution T initialBoundary controller environment =
        roundAwareWordOfStateStream T controller stateStream env :=
    roundAwareGameExecution_environmentCodeOfStateStream_eq
      T initialBoundary controller stateStream env
      hinit hstep hconsistent
  intro hacc
  have haccStream :
      A.Accepts (roundAwareWordOfStateStream T controller stateStream env) := by
    simpa [environment, hword] using hacc
  have hcriterion :
      A.Accepts (roundAwareWordOfStateStream T controller stateStream env) ↔
        DetParityAutomaton.NatEven
          (((Finset.range period).image
            (fun i : Nat =>
              A.priority
                (A.run
                  (roundAwareWordOfStateStream T controller stateStream env)
                  (start + i)))).min'
            (Finset.image_nonempty.mpr
              (Finset.nonempty_range_iff.mpr (Nat.ne_of_gt hperiodPositive)))) := by
    exact
      A.acceptsFrom_iff_eventual_periodic_cycle_priority_min_even
        A.initial
        (roundAwareWordOfStateStream T controller stateStream env)
        start period hperiodPositive hcover hperiodic
  exact hodd (hcriterion.mp haccStream)

/--
A concrete lasso stream is enough for rejected finite-play reflection: once the
state/environment labels repeat, the DPA run state closes the loop, and the
cycle-window minimum priority is odd, the induced memoryless environment code is
rejected.
-/
theorem exists_environmentCode_rejected_roundAwareGameExecution_of_consistent_looping_stateStream
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (hinit : stateStream 0 = Sum.inl initialBoundary)
    (hstep :
      ∀ n : Nat,
        stateStream (n + 1) =
          roundAwareGameTransition T controller (stateStream n) (env n))
    (hconsistent :
      ∀ i j : Nat, stateStream i = stateStream j -> env i = env j)
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (hstateShift :
      ∀ m : Nat,
        stateStream (start + period + m) = stateStream (start + m))
    (henvShift :
      ∀ m : Nat, env (start + period + m) = env (start + m))
    (hrunLoop :
      A.run (roundAwareWordOfStateStream T controller stateStream env)
          (start + period) =
        A.run (roundAwareWordOfStateStream T controller stateStream env)
          start)
    (hodd :
      ¬ DetParityAutomaton.NatEven
        (((Finset.range period).image
          (fun i : Nat =>
            A.priority
              (A.run
                (roundAwareWordOfStateStream T controller stateStream env)
                (start + i)))).min'
          (Finset.image_nonempty.mpr
            (Finset.nonempty_range_iff.mpr (Nat.ne_of_gt hperiodPositive))))) :
    ∃ environment : EnvironmentCode T,
      ¬ A.Accepts
        (roundAwareGameExecution T initialBoundary controller environment) := by
  let word := roundAwareWordOfStateStream T controller stateStream env
  have hwordShift :
      ∀ m : Nat, word (start + period + m) = word (start + m) := by
    intro m
    simpa [word] using
      roundAwareWordOfStateStream_loop_shift
        T controller stateStream env start period
        hstateShift henvShift m
  have hperiodic :
      ∀ i n : Nat,
        i < period ->
          A.priority (A.run word (start + i + n * period)) =
            A.priority (A.run word (start + i)) :=
    A.priority_periodic_of_run_loop word start period
      (by simpa [word] using hrunLoop) hwordShift
  have hcover :
      ∀ k : Nat,
        start ≤ k ->
          ∃ i : Nat,
            i < period ∧
              A.priority (A.run word k) =
                A.priority (A.run word (start + i)) := by
    intro k hk
    let d := k - start
    let i := d % period
    let n := d / period
    refine ⟨i, Nat.mod_lt d hperiodPositive, ?_⟩
    have hdecomp : d = i + n * period := by
      simpa [i, n, Nat.mul_comm] using
        (Nat.mod_add_div d period).symm
    have hk_eq : k = start + i + n * period := by
      have hkstart : k = start + d := by omega
      omega
    rw [hk_eq]
    exact hperiodic i n (Nat.mod_lt d hperiodPositive)
  exact
    exists_environmentCode_rejected_roundAwareGameExecution_of_consistent_periodic_stateStream
      T initialBoundary controller A stateStream env
      hinit hstep hconsistent start period hperiodPositive
      (by simpa [word] using hcover)
      (by simpa [word] using hperiodic)
      hodd

/--
Looping enriched-progress streams produce rejected finite plays when the cycle
entry carries an odd priority that lower-bounds the whole cycle window.

This packages the min-priority step used by the Bérard lasso argument: once the
selected lasso has no priority below the odd recurrent entry priority, the
existing looping-stream consumer can be applied without exposing a raw `min'`
obligation to the caller.
-/
theorem exists_environmentCode_rejected_roundAwareGameExecution_of_consistent_looping_stateStream_of_dpaRun_lowerBound
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type w}
    {Out₂ : Type a}
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : T.boundary)
    (controller : RoundAwareControllerCode T)
    (A : DetParityAutomaton (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (stateStream : Nat -> GameState T)
    (env : EnvironmentSequence In₁ In₂)
    (dpaOf : GameState T -> A.State)
    (hdpaRun :
      ∀ n : Nat,
        dpaOf (stateStream n) =
          A.run (roundAwareWordOfStateStream T controller stateStream env) n)
    (hinit : stateStream 0 = Sum.inl initialBoundary)
    (hstep :
      ∀ n : Nat,
        stateStream (n + 1) =
          roundAwareGameTransition T controller (stateStream n) (env n))
    (hconsistent :
      ∀ i j : Nat, stateStream i = stateStream j -> env i = env j)
    (start period : Nat)
    (hperiodPositive : 0 < period)
    (hstateShift :
      ∀ m : Nat,
        stateStream (start + period + m) = stateStream (start + m))
    (henvShift :
      ∀ m : Nat, env (start + period + m) = env (start + m))
    {p : Nat}
    (hentryPriority : A.priority (dpaOf (stateStream start)) = p)
    (hcycleLower :
      ∀ i : Nat,
        i < period ->
          p ≤ A.priority (dpaOf (stateStream (start + i))))
    (hpOdd : ¬ DetParityAutomaton.NatEven p) :
    ∃ environment : EnvironmentCode T,
      ¬ A.Accepts
        (roundAwareGameExecution T initialBoundary controller environment) := by
  let word := roundAwareWordOfStateStream T controller stateStream env
  have hrunLoop :
      A.run word (start + period) = A.run word start := by
    calc
      A.run word (start + period)
          = dpaOf (stateStream (start + period)) := by
            exact (hdpaRun (start + period)).symm
      _ = dpaOf (stateStream start) := by
            exact congrArg dpaOf (by simpa using hstateShift 0)
      _ = A.run word start := by
            exact hdpaRun start
  have hodd :
      ¬ DetParityAutomaton.NatEven
        (((Finset.range period).image
          (fun i : Nat =>
            A.priority
              (A.run
                (roundAwareWordOfStateStream T controller stateStream env)
                (start + i)))).min'
          (Finset.image_nonempty.mpr
            (Finset.nonempty_range_iff.mpr (Nat.ne_of_gt hperiodPositive)))) := by
    exact
      DetParityAutomaton.not_natEven_cycle_priority_min_of_entry_priority_le_all
        period
        (fun i : Nat =>
          A.priority
            (A.run
              (roundAwareWordOfStateStream T controller stateStream env)
              (start + i)))
        hperiodPositive
        (by
          change
            A.priority
                (A.run
                  (roundAwareWordOfStateStream T controller stateStream env)
                  (start + 0)) = p
          rw [Nat.add_zero]
          rw [← hdpaRun start]
          exact hentryPriority)
        (by
          intro i hi
          change
            p ≤
              A.priority
                (A.run
                  (roundAwareWordOfStateStream T controller stateStream env)
                  (start + i))
          rw [← hdpaRun (start + i)]
          exact hcycleLower i hi)
        hpOdd
  exact
    exists_environmentCode_rejected_roundAwareGameExecution_of_consistent_looping_stateStream
      T initialBoundary controller A stateStream env
      hinit hstep hconsistent start period hperiodPositive
      hstateShift henvShift
      (by simpa [word] using hrunLoop)
      hodd

