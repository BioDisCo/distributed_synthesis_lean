          streettRankingFamily_of_noBadOddPrioritySuffixFamily_cutoff
            hnoBad priority)

theorem rankWatchNextPending_mem_of
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {letter : Alphabet}
    {current : RankMonitorState A}
    {supportChoice : A.MacroStepSupport current.frontier letter}
    {nextRank : RankSnapshot A}
    {watch : RankWatch A}
    {edge : APAStateEdge A}
    (hedge : edge ∈ supportChoice.stateEdges)
    (hsource :
      edge.1 ∈ rankWatchCurrentPending A current watch)
    (hsourceGrant : ¬ priorityGrant A watch.priority edge.1)
    (htargetGrant : ¬ priorityGrant A watch.priority edge.2)
    (hrank : rankMatchesWatch nextRank watch edge.2) :
    edge.2 ∈
      rankWatchNextPending current supportChoice nextRank watch := by
  classical
  unfold rankWatchNextPending
  refine Finset.mem_biUnion.mpr ⟨edge, hedge, ?_⟩
  simp [hsource, hsourceGrant, htargetGrant, hrank]

theorem rankMonitorRun_pending_propagates
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word)
    (n : Nat)
    {watch : RankWatch A}
    {source target : A.State}
    (hedge :
      (source, target) ∈
        (rankMonitorRunSupportChoice run n).stateEdges)
    (hsource :
      source ∈ rankWatchCurrentPending A (run.path n) watch)
    (hsourceGrant : ¬ priorityGrant A watch.priority source)
    (htargetGrant : ¬ priorityGrant A watch.priority target)
    (hrank :
      rankMatchesWatch (run.path (n + 1)).rank watch target) :
    target ∈ (run.path (n + 1)).pending watch := by
  rw [rankMonitorRun_pending_eq run n]
  exact
    rankWatchNextPending_mem_of
      (current := run.path n)
      (supportChoice := rankMonitorRunSupportChoice run n)
      (nextRank := (run.path (n + 1)).rank)
      (watch := watch)
      (edge := (source, target))
      hedge
      hsource
      hsourceGrant
      htargetGrant
      hrank

/--
Projection of a rank-monitor run to the underlying timed edge-witnessed APA
macro-run.
-/
noncomputable def rankMonitorRunEdgeWitnessedMacroRun
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word) :
    A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word where
  toMacroRun :=
    { states := fun n => (run.path n).frontier
      initial_states := by
        have hinitial := congrArg
          (fun state : RankMonitorState A => state.frontier)
          run.initial_state
        simpa [rankMonitorBuchi, rankMonitorInitialState] using hinitial
      step_transition := by
        intro n
        exact
          ⟨rankMonitorRunSupportChoice run n,
            rankMonitorRunSupportChoice_support run n⟩ }
  stateEdges := fun n => (rankMonitorRunSupportChoice run n).stateEdges
  step_stateEdges_transition := by
    intro n
    exact
      ⟨rankMonitorRunSupportChoice run n,
        rankMonitorRunSupportChoice_support run n,
        rfl⟩

@[simp]
theorem rankMonitorRunEdgeWitnessedMacroRun_states
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word)
    (n : Nat) :
    (rankMonitorRunEdgeWitnessedMacroRun A run).toMacroRun.states n =
      (run.path n).frontier :=
