    (hcutoff0 :
      ∀ priority : OddPriority A,
        (family.certificate priority.1 priority.2).cutoff = 0) :
    (rankMonitorBuchi A).Accepts word := by
  exact
    ⟨rankMonitorRunOfFamilyRun supportRun family hcutoff0,
      rankMonitorRunOfFamilyRun_accepts supportRun family hcutoff0⟩

theorem streettRankingFamily_of_noBadOddPrioritySuffixFamily_cutoff
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Nat -> Finset A.State}
    {word : OmegaWord Alphabet}
    {supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)}
    (hnoBad :
      NoBadOddPrioritySuffixFamily A frontier word supportChoice)
    (priority : OddPriority A) :
    ((streettRankingFamily_of_noBadOddPrioritySuffixFamily hnoBad).certificate
        priority.1 priority.2).cutoff = 0 :=
