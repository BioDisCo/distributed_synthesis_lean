import DistributedSynthesis.Formalizations.Theorem.ThmMiyanoHayashiAlternationRemoval

/-!
# Vardi-Wolper finite Streett ranking layer

This file packages the reusable finite-Streett layer that sits between
Lean's parity condition and the Miyano-Hayashi breakpoint/ranking monitor.

The already-checked parity lemmas in `ThmAPAAlternationRemoval.lean` reduce
branch acceptance to the finitely many odd priorities of the APA.  For each
such priority `p`, the Vardi-Wolper/Miyano-Hayashi construction uses a ranking
certificate on the timed support graph to rule out a bad thread that
eventually avoids priorities below `p` while seeing priority `p` infinitely
often.  The certificate is the odd-ranking certificate from
`ThmFiniteWidthStreettRanking`, not the false countdown that decreases at every
finite request.

This file proves the certificate-to-no-bad-thread direction for the whole
finite odd-priority family.  The remaining construction direction is to build
these certificates nondeterministically from the absence of bad threads by the
finite-width ranking/Konig argument.
-/

namespace DistributedSynthesis

universe u v

namespace AlternatingParityAutomaton
namespace VardiWolper

open MiyanoHayashi

/-- The timed support graph used by the Streett-ranking layer. -/
abbrev TimedSupportGraph
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (frontier : Nat -> Finset A.State)
    (word : OmegaWord Alphabet)
    (supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)) :=
  supportChoiceLeveledGraph A frontier word supportChoice

/-- A bad timed thread for the Streett pair generated by one priority. -/
def BadOddPriorityThread
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (frontier : Nat -> Finset A.State)
    (word : OmegaWord Alphabet)
    (supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n))
    (priority : Nat)
    (path : Nat -> A.State) :
    Prop :=
  (TimedSupportGraph A frontier word supportChoice).BadStreettThread
    (priorityRequest A priority)
    (priorityGrant A priority)
    path

/--
A finite family of odd-ranking certificates, one for every odd priority
occurring in the APA.
-/
structure StreettRankingFamily
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (frontier : Nat -> Finset A.State)
    (word : OmegaWord Alphabet)
    (supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)) where
  certificate :
    ∀ priority : Nat,
      priority ∈ A.oddPriorityFinset ->
        PriorityRankingCertificate A frontier word supportChoice priority

/--
The paper's completeness premise for the ranked monitor: for each odd priority
that occurs in the APA, every grant-free suffix of the timed support graph has
no path that sees that request priority infinitely often.
-/
def NoBadOddPrioritySuffixFamily
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (frontier : Nat -> Finset A.State)
    (word : OmegaWord Alphabet)
    (supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)) :
    Prop :=
  ∀ priority : Nat,
    priority ∈ A.oddPriorityFinset ->
      (TimedSupportGraph A frontier word supportChoice).NoBadStreettSuffix
        (priorityRequest A priority)
        (priorityGrant A priority)

/--
Construct the simultaneous finite ranking family from the finite-width
Streett peeling lemma.

This is the formal adapter for the English proof step saying that the
finite-width lemma supplies, for every cutoff and every odd priority, the
bounded odd-ranking certificates used by the Vardi-Wolper/Miyano-Hayashi
monitor.
-/
noncomputable def streettRankingFamily_of_noBadOddPrioritySuffixFamily
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Nat -> Finset A.State}
    {word : OmegaWord Alphabet}
    {supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)}
    (hnoBad :
      NoBadOddPrioritySuffixFamily A frontier word supportChoice) :
    StreettRankingFamily A frontier word supportChoice where
  certificate := by
    intro priority hpriority
    exact
      FiniteWidthStreett.LeveledGraph.rankingCertificate_of_no_badStreettSuffix
        (G := TimedSupportGraph A frontier word supportChoice)
        (request := priorityRequest A priority)
        (grant := priorityGrant A priority)
        (hnoBad priority hpriority)

/--
For a ranked odd priority, the timed support graph has no bad thread for the
corresponding Streett pair.
-/
theorem no_badOddPriorityThread
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Nat -> Finset A.State}
    {word : OmegaWord Alphabet}
    {supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)}
    (family : StreettRankingFamily A frontier word supportChoice)
    {priority : Nat}
    (hpriority : priority ∈ A.oddPriorityFinset) :
    ¬ ∃ path : Nat -> A.State,
      BadOddPriorityThread A frontier word supportChoice priority path := by
  exact
    no_badPriorityThread_of_rankingCertificate
      (A := A)
      (frontier := frontier)
      (word := word)
      (supportChoice := supportChoice)
      (priority := priority)
      (family.certificate priority hpriority)

/--
Pointwise form: a concrete path cannot be a bad thread for any ranked odd
priority.
-/
theorem not_badOddPriorityThread_on_path
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Nat -> Finset A.State}
    {word : OmegaWord Alphabet}
    {supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)}
    (family : StreettRankingFamily A frontier word supportChoice)
    {priority : Nat}
    (hpriority : priority ∈ A.oddPriorityFinset)
    (path : Nat -> A.State) :
    ¬ BadOddPriorityThread A frontier word supportChoice priority path := by
  intro hbad
  exact no_badOddPriorityThread
    (A := A)
    (frontier := frontier)
    (word := word)
    (supportChoice := supportChoice)
    family hpriority ⟨path, hbad⟩

/-- Some priority occurs infinitely often along every path over a finite APA state set. -/
theorem exists_pathPrioritySeenInfinitelyOften
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (path : Nat -> A.State) :
    ∃ priority : Nat,
      A.SupportEdgePathPrioritySeenInfinitelyOften path priority := by
  classical
  obtain ⟨loopState, hloop⟩ := Finite.exists_infinite_fiber path
  refine ⟨A.priority loopState, ?_⟩
  have hfreq : ∃ᶠ n in Filter.atTop, path n = loopState := by
    rw [Nat.frequently_atTop_iff_infinite]
    simpa [Set.preimage, Set.mem_singleton_iff] using
      (Set.infinite_coe_iff.1 hloop)
  rw [Filter.frequently_atTop] at hfreq
  intro n
  rcases hfreq n with ⟨k, hk, hkloop⟩
  exact ⟨k, hk, by simp [hkloop]⟩

/-- The infinitely often seen priorities along a finite-state path have a least member. -/
theorem exists_min_pathPrioritySeenInfinitelyOften
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (path : Nat -> A.State) :
    ∃ priority : Nat,
      A.SupportEdgePathPrioritySeenInfinitelyOften path priority ∧
        ∀ other : Nat,
          A.SupportEdgePathPrioritySeenInfinitelyOften path other ->
            priority ≤ other := by
  classical
  let seen : Set Nat :=
    {priority | A.SupportEdgePathPrioritySeenInfinitelyOften path priority}
  have hseenFinite : seen.Finite := by
    refine (Set.finite_range A.priority).subset ?_
    intro priority hpriority
    rcases hpriority 0 with ⟨k, _hk, hkprio⟩
    exact ⟨path k, hkprio⟩
  have hseenNonempty : seen.Nonempty := by
    rcases exists_pathPrioritySeenInfinitelyOften A path with
      ⟨priority, hpriority⟩
    exact ⟨priority, hpriority⟩
  rcases Set.exists_min_image seen id hseenFinite hseenNonempty with
    ⟨priority, hprioritySeen, hpriorityMin⟩
  exact ⟨priority, hprioritySeen,
    fun other hother => hpriorityMin other hother⟩

/--
If `priority` is a least priority seen infinitely often on a finite-state path,
then the path eventually avoids every strictly lower priority, i.e. it
eventually avoids the grant set for the Streett pair generated by `priority`.
-/
theorem eventually_avoids_priorityGrant_of_min_pathPriority
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (path : Nat -> A.State)
    {priority : Nat}
    (hpriorityMin :
      ∀ other : Nat,
        A.SupportEdgePathPrioritySeenInfinitelyOften path other ->
          priority ≤ other) :
    ∃ avoidStart : Nat,
      ∀ n : Nat, avoidStart ≤ n ->
        ¬ priorityGrant A priority (path n) := by
  classical
  let lowerPriorities : Finset Nat :=
    A.priorityFinset.filter (fun other => other < priority)
  have hbounds :
      ∀ other ∈ lowerPriorities,
        ∃ bound : Nat,
          ∀ k : Nat, bound ≤ k ->
            A.priority (path k) ≠ other := by
    intro other hother
    have hotherLt : other < priority := by
      exact (Finset.mem_filter.mp hother).2
    have hnotSeen :
        ¬ A.SupportEdgePathPrioritySeenInfinitelyOften path other := by
      intro hseenOther
      exact (Nat.not_lt_of_ge (hpriorityMin other hseenOther)) hotherLt
    rw [AlternatingParityAutomaton.SupportEdgePathPrioritySeenInfinitelyOften] at hnotSeen
    push Not at hnotSeen
    exact hnotSeen
  choose bound hbound using hbounds
  let boundOf : Nat -> Nat := fun other =>
    if hother : other ∈ lowerPriorities then bound other hother else 0
  let avoidStart := lowerPriorities.sup boundOf
  refine ⟨avoidStart, ?_⟩
  intro n hn hgrant
  have hlowerMem :
      A.priority (path n) ∈ lowerPriorities := by
    rw [Finset.mem_filter]
    exact
      ⟨(A.mem_priorityFinset (A.priority (path n))).mpr
          ⟨path n, rfl⟩,
        hgrant⟩
  have hle : boundOf (A.priority (path n)) ≤ avoidStart :=
    Finset.le_sup hlowerMem
  have hboundOf :
      boundOf (A.priority (path n)) =
        bound (A.priority (path n)) hlowerMem := by
    simp [boundOf, hlowerMem]
  exact hbound (A.priority (path n)) hlowerMem n
    (by
      rw [← hboundOf]
      exact le_trans hle hn)
    rfl

/--
If every odd-priority Streett pair is protected by the ranking family, then
every timed support path has an even least recurring priority.
-/
theorem supportPath_min_even_of_rankingFamily
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Nat -> Finset A.State}
    {word : OmegaWord Alphabet}
    {supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)}
    (family : StreettRankingFamily A frontier word supportChoice)
    {path : Nat -> A.State}
    (hthread :
      (TimedSupportGraph A frontier word supportChoice).Thread path) :
    ∃ priority : Nat,
      DetParityAutomaton.NatEven priority ∧
        A.SupportEdgePathPrioritySeenInfinitelyOften path priority ∧
          ∀ other : Nat,
            A.SupportEdgePathPrioritySeenInfinitelyOften path other ->
              priority ≤ other := by
  classical
  rcases exists_min_pathPrioritySeenInfinitelyOften A path with
    ⟨priority, hprioritySeen, hpriorityMin⟩
  by_cases hpriorityEven : DetParityAutomaton.NatEven priority
  · exact ⟨priority, hpriorityEven, hprioritySeen, hpriorityMin⟩
  · have hpriorityMem : priority ∈ A.oddPriorityFinset := by
      rcases hprioritySeen 0 with ⟨k, _hk, hkprio⟩
      exact (A.mem_oddPriorityFinset priority).mpr
        ⟨⟨path k, hkprio⟩,
          hpriorityEven⟩
    let lowerPriorities : Finset Nat :=
      A.priorityFinset.filter (fun other => other < priority)
    have hbounds :
        ∀ other ∈ lowerPriorities,
          ∃ bound : Nat,
            ∀ k : Nat, bound ≤ k ->
              A.priority (path k) ≠ other := by
      intro other hother
      have hotherLt : other < priority := by
        exact (Finset.mem_filter.mp hother).2
      have hnotSeen :
          ¬ A.SupportEdgePathPrioritySeenInfinitelyOften path other := by
        intro hseenOther
        exact (Nat.not_lt_of_ge (hpriorityMin other hseenOther)) hotherLt
      rw [AlternatingParityAutomaton.SupportEdgePathPrioritySeenInfinitelyOften] at hnotSeen
      push Not at hnotSeen
      exact hnotSeen
    choose bound hbound using hbounds
    let boundOf : Nat -> Nat := fun other =>
      if hother : other ∈ lowerPriorities then bound other hother else 0
    let avoidStart := lowerPriorities.sup boundOf
    have havoidsLower :
        ∀ n : Nat, avoidStart ≤ n ->
          ¬ priorityGrant A priority (path n) := by
      intro n hn hgrant
      have hlowerMem :
          A.priority (path n) ∈ lowerPriorities := by
        rw [Finset.mem_filter]
        exact
          ⟨(A.mem_priorityFinset (A.priority (path n))).mpr
              ⟨path n, rfl⟩,
            hgrant⟩
      have hle : boundOf (A.priority (path n)) ≤ avoidStart :=
        Finset.le_sup hlowerMem
      have hboundOf :
          boundOf (A.priority (path n)) =
            bound (A.priority (path n)) hlowerMem := by
        simp [boundOf, hlowerMem]
      exact hbound (A.priority (path n)) hlowerMem n
        (by
          rw [← hboundOf]
          exact le_trans hle hn)
        rfl
    have hbad :
        BadOddPriorityThread A frontier word supportChoice priority path := by
      refine ⟨hthread, ⟨avoidStart, havoidsLower⟩, ?_⟩
      simpa [priorityRequest] using hprioritySeen
    exact False.elim
      (not_badOddPriorityThread_on_path
        (A := A)
        (frontier := frontier)
        (word := word)
        (supportChoice := supportChoice)
        family hpriorityMem path hbad)

/--
An edge-witnessed support path is a thread of the timed graph induced by the
same support choices.
-/
theorem timedThread_of_edgeWitnessedSupportPath
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {initialStates : Finset A.State}
    {word : OmegaWord Alphabet}
    (run : A.EdgeWitnessedMacroRun initialStates word)
    {path : Nat -> A.State}
    (hpath : run.SupportPath path) :
    (TimedSupportGraph A
      (fun n => run.toMacroRun.states n)
      word
      (fun n => run.stepSupportChoice n)).Thread path := by
  intro n
  have hedge :
      (path n, path (n + 1)) ∈ (run.stepSupportChoice n).stateEdges := by
    rw [run.stepSupportChoice_stateEdges n]
    exact hpath.2 n
  rcases
      (MacroStepSupport.mem_stateEdges
        (supportChoice := run.stepSupportChoice n)
        (edge := (path n, path (n + 1)))).mp hedge with
    ⟨source, hsource, htarget⟩
  cases source with
  | mk source hsourceMem =>
      simp at hsource
      subst hsource
      exact ⟨hsourceMem, htarget⟩

/--
Ranking-family soundness in the support-run language used elsewhere in the
automata backend: a timed edge-witnessed macro-run whose support choices carry
the Vardi-Wolper ranking family is parity-accepting on every support path.
-/
theorem edgeWitnessedSupportAccepting_of_rankingFamily
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {initialStates : Finset A.State}
    {word : OmegaWord Alphabet}
    (run : A.EdgeWitnessedMacroRun initialStates word)
    (family :
      StreettRankingFamily A
        (fun n => run.toMacroRun.states n)
        word
        (fun n => run.stepSupportChoice n)) :
    run.SupportAccepting := by
  intro path hpath
  exact
    supportPath_min_even_of_rankingFamily
      (A := A)
      (frontier := fun n => run.toMacroRun.states n)
      (word := word)
      (supportChoice := fun n => run.stepSupportChoice n)
      family
      (timedThread_of_edgeWitnessedSupportPath run hpath)

/--
Paper-facing completeness endpoint for the ranked support layer: if every odd
priority has no bad grant-free suffix in the timed support graph generated by
an edge-witnessed macro-run, then that macro-run is support-accepting.
-/
theorem edgeWitnessedSupportAccepting_of_noBadOddPrioritySuffixFamily
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {initialStates : Finset A.State}
    {word : OmegaWord Alphabet}
    (run : A.EdgeWitnessedMacroRun initialStates word)
    (hnoBad :
      NoBadOddPrioritySuffixFamily A
        (fun n => run.toMacroRun.states n)
        word
        (fun n => run.stepSupportChoice n)) :
    run.SupportAccepting :=
  edgeWitnessedSupportAccepting_of_rankingFamily
    run
    (streettRankingFamily_of_noBadOddPrioritySuffixFamily hnoBad)

/--
Support acceptance rules out every bad odd-priority Streett suffix.

This is the formal version of the paper argument that a bad suffix in the
`G_o`-deleted timed graph can be prefixed by a finite support path from the
initial frontier; the finite prefix does not affect which priorities are seen
infinitely often.
-/
theorem noBadOddPrioritySuffixFamily_of_edgeWitnessedSupportAccepting
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun :
      A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (hsupport : supportRun.SupportAccepting) :
    NoBadOddPrioritySuffixFamily A
      (fun n => supportRun.toMacroRun.states n)
      word
      (fun n => supportRun.stepSupportChoice n) := by
  classical
  intro priority hpriority hbadExists
  rcases hbadExists with ⟨start, source, suffixPath, hbad⟩
  rcases hbad with ⟨hthread, hnoGrant, hrequestSeen⟩
  have hsourceFrontier :
      source ∈ supportRun.toMacroRun.states start := by
    have hedge0 := hthread.2 0
    rcases hedge0 with ⟨hsource, _htarget⟩
    simpa [hthread.1] using hsource
  rcases
    supportRun.exists_supportPathPrefix_of_state_mem hsourceFrontier with
    ⟨pref, hprefixInit, hprefixEnd, hprefixEdges⟩
  let fullPath : Nat -> A.State := fun n =>
    if n < start then pref n else suffixPath (n - start)
  have hfullPath_start_add (i : Nat) :
      fullPath (start + i) = suffixPath i := by
    have hnot : ¬ start + i < start := by omega
    simp [fullPath, hnot]
  have hfullSupport : supportRun.SupportPath fullPath := by
    constructor
    · by_cases hstartPos : 0 < start
      · have hzeroLt : 0 < start := hstartPos
        simpa [fullPath, hzeroLt] using hprefixInit
      · have hstartZero : start = 0 := by omega
        have hnot : ¬ 0 < start := hstartPos
        have hpath0Frontier :
            suffixPath 0 ∈ supportRun.toMacroRun.states 0 := by
          simpa [hstartZero, hthread.1] using hsourceFrontier
        simpa [fullPath, hnot, hstartZero,
          supportRun.toMacroRun.initial_states] using hpath0Frontier
    · intro n
      by_cases hn : n < start
      · by_cases hsucc : n + 1 < start
        · simpa [fullPath, hn, hsucc] using hprefixEdges n hn
        · have hsuccEq : n + 1 = start := by omega
          have hprefixSucc :
              pref (n + 1) = suffixPath 0 := by
            simpa [hsuccEq, hthread.1] using hprefixEnd
          simpa [fullPath, hn, hsucc, hprefixSucc]
            using hprefixEdges n hn
      · have hsuccNot : ¬ n + 1 < start := by omega
        have hedgeGraph :
            (TimedSupportGraph A
              (fun n => supportRun.toMacroRun.states n)
              word
              (fun n => supportRun.stepSupportChoice n)).edge
                n
                (suffixPath (n - start))
                (suffixPath (n + 1 - start)) := by
          have hlevel : start + (n - start) = n := by omega
          have htarget : n + 1 - start = n - start + 1 := by omega
          simpa [hlevel, htarget, Nat.add_comm, Nat.add_left_comm,
            Nat.add_assoc] using hthread.2 (n - start)
        rcases hedgeGraph with ⟨hsource, htarget⟩
        have hedgeState :
            (suffixPath (n - start), suffixPath (n + 1 - start)) ∈
              (supportRun.stepSupportChoice n).stateEdges := by
          exact
            (MacroStepSupport.mem_stateEdges
              (supportChoice := supportRun.stepSupportChoice n)
              (edge :=
                (suffixPath (n - start),
                  suffixPath (n + 1 - start)))).mpr
              ⟨⟨suffixPath (n - start), hsource⟩, rfl, htarget⟩
        simpa [fullPath, hn, hsuccNot,
          supportRun.stepSupportChoice_stateEdges n] using hedgeState
  rcases hsupport fullPath hfullSupport with
    ⟨leastPriority, hleastEven, hleastSeen, hleastMin⟩
  have hrequestFull :
      A.SupportEdgePathPrioritySeenInfinitelyOften fullPath priority := by
    intro n
    rcases hrequestSeen n with ⟨k, hnk, hkrequest⟩
    refine ⟨start + k, by omega, ?_⟩
    simpa [hfullPath_start_add, priorityRequest] using hkrequest
  have hleast_le_priority : leastPriority ≤ priority :=
    hleastMin priority hrequestFull
  have hleast_ne_priority : leastPriority ≠ priority := by
    intro hEq
    exact ((A.mem_oddPriorityFinset priority).mp hpriority).2
      (by simpa [hEq] using hleastEven)
  have hleast_lt_priority : leastPriority < priority :=
    lt_of_le_of_ne hleast_le_priority hleast_ne_priority
  rcases hleastSeen start with ⟨k, hkStart, hkPriority⟩
  have hkNot : ¬ k < start := by omega
  have hgrant :
      priorityGrant A priority (suffixPath (k - start)) := by
    dsimp [priorityGrant]
    have hfull :
        fullPath k = suffixPath (k - start) := by
      simp [fullPath, hkNot]
    rw [← hfull, hkPriority]
    exact hleast_lt_priority
  exact hnoGrant (k - start) hgrant

/-- The support-run normal-form witness used by the APA-to-Büchi backend. -/
def HasAcceptingSupportRun
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (word : OmegaWord Alphabet) :
    Prop :=
  ∃ supportRun :
      A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word,
    supportRun.SupportAccepting

/-- A support-normal-form witness is sound for ordinary APA run-tree semantics. -/
theorem accepts_of_hasAcceptingSupportRun
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (hwitness : HasAcceptingSupportRun A word) :
    A.Accepts word := by
  rcases hwitness with ⟨supportRun, hsupport⟩
  have hacceptsInitial :
      ∀ state, state ∈ ({A.initial} : Finset A.State) ->
        A.AcceptsFrom state word :=
    supportRun.acceptsFrom_all_initial_of_supportAccepting_realized
      hsupport
      supportRun.hasRunTreeRealization
  simpa [AlternatingParityAutomaton.acceptsFrom_initial] using
    hacceptsInitial A.initial (by simp)

/-- Odd priorities of an APA, packaged as a finite type. -/
abbrev OddPriority
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :=
  {priority : Nat // priority ∈ A.oddPriorityFinset}

noncomputable instance oddPriorityFintype
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :
    Fintype (OddPriority A) := by
  classical
  exact Fintype.ofFinset A.oddPriorityFinset (by intro priority; rfl)

/-- Bounded rank values used by the finite-width Streett monitor. -/
abbrev RankValue
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :=
  Fin (FiniteWidthStreett.LeveledGraph.rankBound A.State + 1)

/-- Even bounded rank values, used as breakpoint obligations. -/
abbrev EvenRankValue
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :=
  {rank : RankValue A // Even rank.1}

/-- One breakpoint watch: one odd priority and one even rank value. -/
abbrev RankWatch
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :=
  OddPriority A × EvenRankValue A

namespace RankWatch

/-- The odd priority watched by a breakpoint obligation. -/
def priority
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    (watch : RankWatch A) :
    Nat :=
  watch.1.1

/-- The even rank value watched by a breakpoint obligation. -/
def rank
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    (watch : RankWatch A) :
    RankValue A :=
  watch.2.1

theorem rank_even
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    (watch : RankWatch A) :
    Even (watch.rank.1) :=
  watch.2.2

end RankWatch

/-- A rank snapshot assigns a bounded rank to every state for every odd priority. -/
abbrev RankSnapshot
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :=
  OddPriority A -> A.State -> RankValue A

/-- Pending breakpoint sets for all watched odd-priority/even-rank pairs. -/
abbrev RankPending
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :=
  RankWatch A -> Finset A.State

/-- The all-zero rank snapshot used in the initial monitor state. -/
noncomputable def zeroRankSnapshot
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :
    RankSnapshot A :=
  fun _priority _state =>
    ⟨0, Nat.succ_pos (FiniteWidthStreett.LeveledGraph.rankBound A.State)⟩

/--
The top-rank snapshot used by the finite rank monitor initially.

Starting at the top rank matches the construction proof: the first transition
may decrease to the certificate ranks chosen for the accepting support run.
-/
noncomputable def topRankSnapshot
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :
    RankSnapshot A :=
  fun _priority _state =>
    ⟨FiniteWidthStreett.LeveledGraph.rankBound A.State,
      Nat.lt_succ_self (FiniteWidthStreett.LeveledGraph.rankBound A.State)⟩

/-- Empty pending sets for every watch. -/
noncomputable def emptyRankPending
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :
    RankPending A :=
  fun _watch => ∅

/-- All breakpoint obligations have cleared. -/
def rankPendingAllClear
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    (pending : RankPending A) :
    Prop :=
  ∀ watch : RankWatch A, pending watch = ∅

@[simp]
theorem emptyRankPending_allClear
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :
    rankPendingAllClear (emptyRankPending A) := by
  intro watch
  rfl

/-- The snapshot gives an even rank to every active request state. -/
def rankSnapshotValidOnFrontier
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (frontier : Finset A.State)
    (rank : RankSnapshot A) :
    Prop :=
  ∀ priority : OddPriority A,
    ∀ state : A.State,
      state ∈ frontier ->
        priorityRequest A priority.1 state ->
          Even ((rank priority state).1)

@[simp]
theorem zeroRankSnapshot_validOnFrontier
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (frontier : Finset A.State) :
    rankSnapshotValidOnFrontier A frontier (zeroRankSnapshot A) := by
  intro priority state hstate hrequest
  exact ⟨0, rfl⟩

@[simp]
theorem topRankSnapshot_validOnFrontier
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (frontier : Finset A.State) :
    rankSnapshotValidOnFrontier A frontier (topRankSnapshot A) := by
  intro priority state hstate hrequest
  refine ⟨Fintype.card A.State, ?_⟩
  simp [topRankSnapshot, FiniteWidthStreett.LeveledGraph.rankBound, Nat.two_mul]

/--
The rank assigned to a state agrees with a watch's even rank for that watch's
odd priority.
-/
def rankMatchesWatch
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    (rank : RankSnapshot A)
    (watch : RankWatch A)
    (state : A.State) :
    Prop :=
  rank watch.1 state = watch.rank

/-- The finite state space of the Vardi-Wolper rank monitor. -/
structure RankMonitorState
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) where
  frontier : Finset A.State
  rank : RankSnapshot A
  pending : RankPending A

attribute [ext] RankMonitorState

namespace RankMonitorState

noncomputable instance fintype
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :
    Fintype (RankMonitorState A) := by
  classical
  exact
    Fintype.ofInjective
      (fun state : RankMonitorState A =>
        (state.frontier, state.rank, state.pending))
      (by
        intro left right h
        cases left
        cases right
        cases h
        rfl)

end RankMonitorState

/-- Initial state of the rank monitor. -/
noncomputable def rankMonitorInitialState
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :
    RankMonitorState A where
  frontier := {A.initial}
  rank := topRankSnapshot A
  pending := emptyRankPending A

/--
Rank monotonicity across one timed support choice, restricted to grant-free
edges for the corresponding odd priority.
-/
def rankStepValid
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Finset A.State}
    {letter : Alphabet}
    (supportChoice : A.MacroStepSupport frontier letter)
    (currentRank nextRank : RankSnapshot A) :
    Prop :=
  ∀ priority : OddPriority A,
    ∀ edge : APAStateEdge A,
      edge ∈ supportChoice.stateEdges ->
        ¬ priorityGrant A priority.1 edge.1 ->
          ¬ priorityGrant A priority.1 edge.2 ->
            (nextRank priority edge.2).1 ≤ (currentRank priority edge.1).1

namespace RankingSnapshot

/--
The finite monitor rank value induced by one ranking certificate at one timed
level.  Before the certificate cutoff, or on grant vertices, the monitor may
use an arbitrary bounded rank because the certificate imposes no obligation
there.
-/
noncomputable def ofCertificateValue
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Nat -> Finset A.State}
    {word : OmegaWord Alphabet}
    {supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)}
    {priority : Nat}
    (certificate :
      PriorityRankingCertificate A frontier word supportChoice priority)
    (n : Nat)
    (state : A.State) :
    RankValue A := by
  classical
  by_cases hcutoff : certificate.cutoff ≤ n
  · by_cases hgrant : priorityGrant A priority state
    · exact
        ⟨0, Nat.succ_pos (FiniteWidthStreett.LeveledGraph.rankBound A.State)⟩
    · exact
        ⟨certificate.rank n state,
          Nat.lt_succ_of_le
            (by
              simpa [FiniteWidthStreett.LeveledGraph.rankBound] using
                certificate.rank_le_bound
                  (n := n)
                  (vertex := state)
                  hcutoff
                  hgrant)⟩
  · exact
      ⟨0, Nat.succ_pos (FiniteWidthStreett.LeveledGraph.rankBound A.State)⟩

/--
The rank snapshot at one timed level obtained from a simultaneous Streett
ranking family.
-/
noncomputable def ofFamily
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Nat -> Finset A.State}
    {word : OmegaWord Alphabet}
    {supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)}
    (family : StreettRankingFamily A frontier word supportChoice)
    (n : Nat) :
    RankSnapshot A :=
  fun priority state =>
    ofCertificateValue
      (family.certificate priority.1 priority.2)
      n
      state

theorem ofFamily_validOnFrontier
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Nat -> Finset A.State}
    {word : OmegaWord Alphabet}
    {supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)}
    (family : StreettRankingFamily A frontier word supportChoice)
    (n : Nat)
    (hcutoff :
      ∀ priority : OddPriority A,
        (family.certificate priority.1 priority.2).cutoff ≤ n) :
    rankSnapshotValidOnFrontier A (frontier n) (ofFamily family n) := by
  intro priority state hstate hrequest
  have hnotGrant : ¬ priorityGrant A priority.1 state := by
    dsimp [priorityGrant]
    dsimp [priorityRequest] at hrequest
    omega
  have heven :
      Even
        ((family.certificate priority.1 priority.2).rank n state) :=
    (family.certificate priority.1 priority.2).request_even
      (n := n)
      (vertex := state)
      (hcutoff priority)
      hnotGrant
      hrequest
  simpa [ofFamily, ofCertificateValue, hcutoff priority, hnotGrant] using heven

theorem ofFamily_stepValid
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Nat -> Finset A.State}
    {word : OmegaWord Alphabet}
    {supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)}
    (family : StreettRankingFamily A frontier word supportChoice)
    (n : Nat)
    (hcutoff :
      ∀ priority : OddPriority A,
        (family.certificate priority.1 priority.2).cutoff ≤ n) :
    rankStepValid (supportChoice n) (ofFamily family n)
      (ofFamily family (n + 1)) := by
  intro priority edge hedge hsourceNotGrant htargetNotGrant
  have hcutoffNext :
      (family.certificate priority.1 priority.2).cutoff ≤ n + 1 :=
    le_trans (hcutoff priority) (Nat.le_succ n)
  have hgraph :
      (TimedSupportGraph A frontier word supportChoice).edge
        n edge.1 edge.2 := by
    rcases
        (MacroStepSupport.mem_stateEdges
          (supportChoice := supportChoice n)
          (edge := edge)).mp hedge with
      ⟨source, hsource, htarget⟩
    cases source with
    | mk source hsourceMem =>
        simp at hsource
        subst hsource
        exact ⟨hsourceMem, htarget⟩
  have hle :
      (family.certificate priority.1 priority.2).rank (n + 1) edge.2 ≤
        (family.certificate priority.1 priority.2).rank n edge.1 :=
    (family.certificate priority.1 priority.2).edge_nonincreasing
      (n := n)
      (source := edge.1)
      (target := edge.2)
      (hcutoff priority)
      hgraph
      hsourceNotGrant
      htargetNotGrant
  simpa [ofFamily, ofCertificateValue, hcutoff priority, hcutoffNext,
    hsourceNotGrant, htargetNotGrant] using hle

end RankingSnapshot

theorem rankStepValid_topRankSnapshot_to_ofFamily
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Nat -> Finset A.State}
    {word : OmegaWord Alphabet}
    {supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)}
    (family : StreettRankingFamily A frontier word supportChoice)
    (hcutoffOne :
      ∀ priority : OddPriority A,
        (family.certificate priority.1 priority.2).cutoff ≤ 1) :
    rankStepValid (supportChoice 0) (topRankSnapshot A)
      (RankingSnapshot.ofFamily family 1) := by
  intro priority edge hedge hsourceNotGrant htargetNotGrant
  have hbound :
      (family.certificate priority.1 priority.2).rank 1 edge.2 ≤
        FiniteWidthStreett.LeveledGraph.rankBound A.State := by
    simpa [FiniteWidthStreett.LeveledGraph.rankBound] using
      (family.certificate priority.1 priority.2).rank_le_bound
        (n := 1)
        (vertex := edge.2)
        (hcutoffOne priority)
        htargetNotGrant
  simpa [topRankSnapshot, RankingSnapshot.ofFamily,
    RankingSnapshot.ofCertificateValue, hcutoffOne priority, htargetNotGrant]
    using hbound

/-- The seed set for one watch at a global breakpoint reset. -/
noncomputable def rankWatchSeed
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (frontier : Finset A.State)
    (rank : RankSnapshot A)
    (watch : RankWatch A) :
    Finset A.State := by
  classical
  exact frontier.filter (fun state =>
    ¬ priorityGrant A watch.priority state ∧ rankMatchesWatch rank watch state)

/-- The set propagated for one watch before taking the next support step. -/
noncomputable def rankWatchCurrentPending
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (state : RankMonitorState A)
    (watch : RankWatch A) :
    Finset A.State := by
  classical
  exact
    if rankPendingAllClear state.pending then
      rankWatchSeed A state.frontier state.rank watch
    else
      state.pending watch

/--
Next pending set for one watch.  It follows exactly those grant-free support
edges that keep the watched even rank.
-/
noncomputable def rankWatchNextPending
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {letter : Alphabet}
    (current : RankMonitorState A)
    (supportChoice : A.MacroStepSupport current.frontier letter)
    (nextRank : RankSnapshot A)
    (watch : RankWatch A) :
    Finset A.State := by
  classical
  exact supportChoice.stateEdges.biUnion (fun edge =>
    if edge.1 ∈ rankWatchCurrentPending A current watch ∧
        ¬ priorityGrant A watch.priority edge.1 ∧
        ¬ priorityGrant A watch.priority edge.2 ∧
        rankMatchesWatch nextRank watch edge.2 then
      {edge.2}
    else
      ∅)

/-- All next pending sets after one monitor transition. -/
noncomputable def rankNextPending
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {letter : Alphabet}
    (current : RankMonitorState A)
    (supportChoice : A.MacroStepSupport current.frontier letter)
    (nextRank : RankSnapshot A) :
    RankPending A :=
  fun watch => rankWatchNextPending current supportChoice nextRank watch

/--
One transition of the finite Vardi-Wolper rank monitor.

The transition guesses the APA macro-support and the next rank snapshot.  The
rank snapshot must be locally valid and nonincreasing on grant-free support
edges.  Pending breakpoint sets are then advanced through exactly those edges
that preserve the watched even rank.
-/
def rankMonitorStep
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (current : RankMonitorState A)
    (letter : Alphabet)
    (next : RankMonitorState A) :
    Prop :=
  ∃ supportChoice : A.MacroStepSupport current.frontier letter,
    supportChoice.support = next.frontier ∧
      rankSnapshotValidOnFrontier A next.frontier next.rank ∧
        rankStepValid supportChoice current.rank next.rank ∧
          next.pending = rankNextPending current supportChoice next.rank

/-- The Büchi accepting summaries are the global breakpoint clear states. -/
def rankMonitorAccepting
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    (state : RankMonitorState A) :
    Prop :=
  rankPendingAllClear state.pending

/--
Ranks used by the monitor run generated from a ranking family.  Level `0`
uses the top snapshot required by the initial monitor state; later levels use
the finite-width certificates.
-/
noncomputable def rankMonitorRankOfFamily
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Nat -> Finset A.State}
    {word : OmegaWord Alphabet}
    {supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)}
    (family : StreettRankingFamily A frontier word supportChoice) :
    Nat -> RankSnapshot A
  | 0 => topRankSnapshot A
  | n + 1 => RankingSnapshot.ofFamily family (n + 1)

/--
Pending sets of the monitor run generated from an edge-witnessed support run
and a ranking family.
-/
noncomputable def rankMonitorPendingOfFamilyRun
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n)) :
    Nat -> RankPending A
  | 0 => emptyRankPending A
  | n + 1 =>
      rankNextPending
        { frontier := supportRun.toMacroRun.states n
          rank := rankMonitorRankOfFamily family n
          pending := rankMonitorPendingOfFamilyRun supportRun family n }
        (supportRun.stepSupportChoice n)
        (rankMonitorRankOfFamily family (n + 1))

/-- The generated monitor state at one level of a ranked support run. -/
noncomputable def rankMonitorStateOfFamilyRun
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n))
    (n : Nat) :
    RankMonitorState A where
  frontier := supportRun.toMacroRun.states n
  rank := rankMonitorRankOfFamily family n
  pending := rankMonitorPendingOfFamilyRun supportRun family n

@[simp]
theorem rankMonitorStateOfFamilyRun_frontier
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n))
    (n : Nat) :
    (rankMonitorStateOfFamilyRun supportRun family n).frontier =
      supportRun.toMacroRun.states n :=
  rfl

@[simp]
theorem rankMonitorStateOfFamilyRun_rank
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n))
    (n : Nat) :
    (rankMonitorStateOfFamilyRun supportRun family n).rank =
      rankMonitorRankOfFamily family n :=
  rfl

@[simp]
theorem rankMonitorStateOfFamilyRun_pending
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n))
    (n : Nat) :
    (rankMonitorStateOfFamilyRun supportRun family n).pending =
      rankMonitorPendingOfFamilyRun supportRun family n :=
  rfl

@[simp]
theorem rankMonitorPendingOfFamilyRun_succ
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n))
    (n : Nat) :
    rankMonitorPendingOfFamilyRun supportRun family (n + 1) =
      rankNextPending
        { frontier := supportRun.toMacroRun.states n
          rank := rankMonitorRankOfFamily family n
          pending := rankMonitorPendingOfFamilyRun supportRun family n }
        (supportRun.stepSupportChoice n)
        (rankMonitorRankOfFamily family (n + 1)) :=
  rfl

/--
A finite history for one watch inside one breakpoint round of the generated
rank-monitor run.
-/
structure RankWatchFiniteHistory
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n))
    (watch : RankWatch A)
    (reset length : Nat) where
  vertex : Fin (length + 1) -> A.State
  start_seed :
    vertex 0 ∈
      rankWatchSeed A
        (supportRun.toMacroRun.states reset)
        (rankMonitorRankOfFamily family reset)
        watch
  edge :
    ∀ i : Nat, ∀ hi : i < length,
      (vertex ⟨i, Nat.lt_succ_of_lt hi⟩,
        vertex ⟨i + 1, Nat.succ_lt_succ hi⟩) ∈
        (supportRun.stepSupportChoice (reset + i)).stateEdges
  grant_free :
    ∀ i : Nat, ∀ hi : i ≤ length,
      ¬ priorityGrant A watch.priority
        (vertex ⟨i, Nat.lt_succ_of_le hi⟩)
  rank_match :
    ∀ i : Nat, ∀ hi : i ≤ length,
      rankMatchesWatch
        (rankMonitorRankOfFamily family (reset + i))
        watch
        (vertex ⟨i, Nat.lt_succ_of_le hi⟩)

attribute [ext] RankWatchFiniteHistory

namespace RankWatchFiniteHistory

theorem certificate_rank_eq_of_rank_match
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    {supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word}
    {family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n)}
    {watch : RankWatch A}
    {n : Nat}
    {state : A.State}
    (hcutoff0 :
      ∀ priority : OddPriority A,
        (family.certificate priority.1 priority.2).cutoff = 0)
    (hn : 1 ≤ n)
    (hnotGrant : ¬ priorityGrant A watch.priority state)
    (hrank :
      rankMatchesWatch (rankMonitorRankOfFamily family n) watch state) :
    (family.certificate watch.1.1 watch.1.2).rank n state =
      watch.rank.1 := by
  cases n with
  | zero =>
      omega
  | succ n =>
      have hcutoff :
          (family.certificate watch.1.1 watch.1.2).cutoff ≤ n + 1 := by
        rw [hcutoff0 watch.1]
        omega
      have hnotGrant' : ¬ priorityGrant A watch.1.1 state := by
        simpa [RankWatch.priority] using hnotGrant
      have hvalue := congrArg Fin.val hrank
      simpa [rankMonitorRankOfFamily, RankingSnapshot.ofFamily,
        RankingSnapshot.ofCertificateValue, hcutoff, hnotGrant',
        RankWatch.priority, RankWatch.rank] using hvalue

def take
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    {supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word}
    {family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n)}
    {watch : RankWatch A}
    {reset length : Nat}
    (history : RankWatchFiniteHistory supportRun family watch reset length)
    (short : Nat)
    (hshort : short ≤ length) :
    RankWatchFiniteHistory supportRun family watch reset short where
  vertex := fun index =>
    history.vertex
      ⟨index.1, Nat.lt_succ_of_le
        (Nat.le_trans (Nat.le_of_lt_succ index.2) hshort)⟩
  start_seed := by
    simpa using history.start_seed
  edge := by
    intro i hi
    simpa using history.edge i (Nat.lt_of_lt_of_le hi hshort)
  grant_free := by
    intro i hi
    exact history.grant_free i (Nat.le_trans hi hshort)
  rank_match := by
    intro i hi
    exact history.rank_match i (Nat.le_trans hi hshort)

def snoc
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    {supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word}
    {family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n)}
    {watch : RankWatch A}
    {reset length : Nat}
    (history : RankWatchFiniteHistory supportRun family watch reset length)
    (target : A.State)
    (hedge :
      (history.vertex ⟨length, Nat.lt_succ_self length⟩, target) ∈
        (supportRun.stepSupportChoice (reset + length)).stateEdges)
    (htargetGrant : ¬ priorityGrant A watch.priority target)
    (htargetRank :
      rankMatchesWatch
        (rankMonitorRankOfFamily family (reset + (length + 1)))
        watch
        target) :
    RankWatchFiniteHistory supportRun family watch reset (length + 1) where
  vertex := fun index =>
    if hindex : index.1 ≤ length then
      history.vertex ⟨index.1, Nat.lt_succ_of_le hindex⟩
    else
      target
  start_seed := by
    simp
    exact history.start_seed
  edge := by
    intro i hi
    by_cases hlast : i = length
    · subst i
      have hsourceLe : length ≤ length := le_rfl
      have htargetNotLe : ¬ length + 1 ≤ length := by omega
      simpa [hsourceLe, htargetNotLe, Nat.add_assoc] using hedge
    · have hi_old : i < length := by omega
      have hsourceLe : i ≤ length := by omega
      have htargetLe : i + 1 ≤ length := by omega
      have hedgeOld := history.edge i hi_old
      simpa [hsourceLe, htargetLe] using hedgeOld
  grant_free := by
    intro i hi
    by_cases hle : i ≤ length
    · simpa [hle] using history.grant_free i hle
    · have hi_last : i = length + 1 := by omega
      subst i
      have hnotLe : ¬ length + 1 ≤ length := by omega
      simpa [hnotLe] using htargetGrant
  rank_match := by
    intro i hi
    by_cases hle : i ≤ length
    · simpa [hle] using history.rank_match i hle
    · have hi_last : i = length + 1 := by omega
      subst i
      have hnotLe : ¬ length + 1 ≤ length := by omega
      simpa [hnotLe, Nat.add_assoc] using htargetRank

set_option maxHeartbeats 800000 in
theorem not_arbitrarily_long
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    {supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word}
    {family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n)}
    {watch : RankWatch A}
    {reset : Nat}
    (hcutoff0 :
      ∀ priority : OddPriority A,
        (family.certificate priority.1 priority.2).cutoff = 0) :
    ¬ ∀ length : Nat,
      Nonempty (RankWatchFiniteHistory supportRun family watch reset length) := by
  classical
  intro hnonempty
  let Prefix := fun length =>
    RankWatchFiniteHistory supportRun family watch reset length
  haveI : ∀ length : Nat, Nonempty (Prefix length) := hnonempty
  have finitePrefix : ∀ length : Nat, Finite (Prefix length) := by
    intro length
    exact
      Finite.of_injective
        (fun history : Prefix length => history.vertex)
        (by
          intro left right hvertex
          ext index
          exact congrFun hvertex index)
  haveI : Finite (Prefix 0) := finitePrefix 0
  let proj : {i j : Nat} -> i ≤ j -> Prefix j -> Prefix i :=
    fun {i j} hij history => history.take i hij
  have hproj_refl :
      ∀ ⦃i : Nat⦄ (history : Prefix i), proj (le_refl i) history = history := by
    intro i history
    ext index
    rfl
  have hproj_trans :
      ∀ ⦃i j k : Nat⦄ (hij : i ≤ j) (hjk : j ≤ k)
        (history : Prefix k),
        proj hij (proj hjk history) = proj (Nat.le_trans hij hjk) history := by
    intro i j k hij hjk history
    ext index
    rfl
  have hfin :
      ∀ (i : Nat) (history : Prefix i),
        {next : Prefix (i + 1) | proj (Nat.le_add_right i 1) next = history}.Finite := by
    intro i history
    letI : Finite (Prefix (i + 1)) := finitePrefix (i + 1)
    exact Set.toFinite _
  rcases exists_seq_forall_proj_of_forall_finite
      (α := Prefix) proj hproj_refl hproj_trans hfin with
    ⟨histories, hhistories⟩
  let suffixPath : Nat -> A.State := fun i =>
    (histories i).vertex ⟨i, Nat.lt_succ_self i⟩
  have hedgeSuffix :
      ∀ i : Nat,
        (suffixPath i, suffixPath (i + 1)) ∈
          (supportRun.stepSupportChoice (reset + i)).stateEdges := by
    intro i
    have hedge := (histories (i + 1)).edge i (Nat.lt_succ_self i)
    have hproj :
        proj (Nat.le_succ i) (histories (i + 1)) = histories i :=
      hhistories (Nat.le_succ i)
    have hsource :
        suffixPath i =
          (histories (i + 1)).vertex
            ⟨i, Nat.lt_succ_of_le (Nat.le_succ i)⟩ := by
      have hvertex := congrArg
        (fun history : Prefix i => history.vertex)
        hproj
      have hindex :
          (⟨i, Nat.lt_succ_self i⟩ : Fin (i + 1)) =
            ⟨i, Nat.lt_succ_self i⟩ := rfl
      have happ := congrFun hvertex ⟨i, Nat.lt_succ_self i⟩
      simpa [suffixPath, proj, take] using happ.symm
    have htarget :
        suffixPath (i + 1) =
          (histories (i + 1)).vertex
            ⟨i + 1, Nat.succ_lt_succ (Nat.lt_succ_self i)⟩ := by
      rfl
    simpa [hsource, htarget] using hedge
  let fullPath : Nat -> A.State := fun n =>
    if h : reset ≤ n then suffixPath (n - reset) else suffixPath 0
  let certStart := max reset 1
  have hreset_le_certStart : reset ≤ certStart := by
    dsimp [certStart]
    omega
  have hone_le_certStart : 1 ≤ certStart := by
    dsimp [certStart]
    omega
  have hthreadFrom :
      ∀ n : Nat, certStart ≤ n ->
        (TimedSupportGraph A
          (fun n => supportRun.toMacroRun.states n)
          word
          (fun n => supportRun.stepSupportChoice n)).edge
          n (fullPath n) (fullPath (n + 1)) := by
    intro n hn
    have hnreset : reset ≤ n := le_trans hreset_le_certStart hn
    let offset := n - reset
    have hn_eq_rev : n = reset + offset := by
      dsimp [offset]
      omega
    rw [hn_eq_rev]
    have hn1_offset : reset + offset + 1 - reset = offset + 1 := by
      dsimp [offset]
      omega
    have hfull_n : fullPath (reset + offset) = suffixPath offset := by
      have hle : reset ≤ reset + offset := by omega
      simp [fullPath, hle, offset]
    have hfull_next :
        fullPath (reset + offset + 1) = suffixPath (offset + 1) := by
      have hn1reset : reset ≤ reset + offset + 1 := by omega
      simp [fullPath, hn1reset, hn1_offset]
    have hedge :
        (suffixPath offset, suffixPath (offset + 1)) ∈
          (supportRun.stepSupportChoice (reset + offset)).stateEdges :=
      hedgeSuffix offset
    rcases
        (MacroStepSupport.mem_stateEdges
          (supportChoice := supportRun.stepSupportChoice (reset + offset))
          (edge := (suffixPath offset, suffixPath (offset + 1)))).mp
          hedge with
      ⟨source, hsource, htarget⟩
    cases source with
    | mk source hsourceMem =>
        simp at hsource
        subst hsource
        let sourceMemFull :
            fullPath (reset + offset) ∈
              supportRun.toMacroRun.states (reset + offset) := by
          simpa [hfull_n] using hsourceMem
        refine ⟨sourceMemFull, ?_⟩
        have hsourceSubtype :
            (⟨fullPath (reset + offset), sourceMemFull⟩ :
              {state // state ∈ supportRun.toMacroRun.states (reset + offset)}) =
              ⟨suffixPath offset, hsourceMem⟩ := by
          apply Subtype.ext
          exact hfull_n
        rw [hsourceSubtype]
        simpa [hfull_next] using htarget
  have hgrantFree :
      ∀ n : Nat, certStart ≤ n ->
        ¬ priorityGrant A watch.priority (fullPath n) := by
    intro n hn
    have hnreset : reset ≤ n := le_trans hreset_le_certStart hn
    let offset := n - reset
    have hn_eq : reset + offset = n := by
      dsimp [offset]
      omega
    have hfull_n : fullPath n = suffixPath offset := by
      simp [fullPath, hnreset, offset]
    have hgrant := (histories offset).grant_free offset le_rfl
    simpa [suffixPath, hfull_n] using hgrant
  have hrankConstant :
      ∀ n : Nat, certStart ≤ n ->
        (family.certificate watch.1.1 watch.1.2).rank n (fullPath n) =
          watch.rank.1 := by
    intro n hn
    have hnreset : reset ≤ n := le_trans hreset_le_certStart hn
    have hnOne : 1 ≤ n := le_trans hone_le_certStart hn
    let offset := n - reset
    have hn_eq : reset + offset = n := by
      dsimp [offset]
      omega
    have hfull_n : fullPath n = suffixPath offset := by
      simp [fullPath, hnreset, offset]
    have hgrant : ¬ priorityGrant A watch.priority (suffixPath offset) := by
      simpa [suffixPath] using (histories offset).grant_free offset le_rfl
    have hrank :
        rankMatchesWatch
          (rankMonitorRankOfFamily family n)
          watch
          (suffixPath offset) := by
      have h := (histories offset).rank_match offset le_rfl
      simpa [suffixPath, hn_eq] using h
    simpa [hfull_n] using
      certificate_rank_eq_of_rank_match
        (supportRun := supportRun)
        (family := family)
        (watch := watch)
        hcutoff0 hnOne hgrant hrank
  let certificate := family.certificate watch.1.1 watch.1.2
  have hcutoffStart : certificate.cutoff ≤ certStart := by
    dsimp [certificate]
    rw [hcutoff0 watch.1]
    omega
  rcases certificate.eventually_stabilizes_odd
      (path := fullPath)
      certStart
      hcutoffStart
      hthreadFrom
      (by
        intro n hn
        exact hgrantFree n hn) with
    ⟨stable, value, hstable_ge, hvalueOdd, hstable⟩
  have hcertStable :
      certificate.rank stable (fullPath stable) = value :=
    hstable stable le_rfl
  have hcertWatch :
      certificate.rank stable (fullPath stable) = watch.rank.1 := by
    dsimp [certificate]
    exact hrankConstant stable hstable_ge
  have hvalueEq : value = watch.rank.1 := by
    rw [hcertStable] at hcertWatch
    exact hcertWatch
  have hvalueEven : Even value := by
    simpa [hvalueEq] using RankWatch.rank_even watch
  exact (Nat.not_even_iff_odd.mpr hvalueOdd) hvalueEven

end RankWatchFiniteHistory

/-- The finite nondeterministic Büchi rank monitor for an APA. -/
noncomputable def rankMonitorBuchi
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :
    NondetBuchiAutomaton.{u, v} Alphabet where
  State := RankMonitorState A
  stateFinite := by
    classical
    infer_instance
  initial := rankMonitorInitialState A
  step := rankMonitorStep A
  accepting := rankMonitorAccepting

theorem rankMonitorStep_frontier_transition
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {current next : RankMonitorState A}
    {letter : Alphabet}
    (hstep : rankMonitorStep A current letter next) :
    A.MacroTransition current.frontier letter next.frontier := by
  rcases hstep with ⟨supportChoice, hfrontier, _hvalid, _hrank, _hpending⟩
  exact ⟨supportChoice, hfrontier⟩

theorem rankMonitorInitial_accepting
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :
    rankMonitorAccepting (rankMonitorInitialState A) := by
  exact emptyRankPending_allClear A

/--
The concrete monitor run generated from a ranked support run.  The cutoff
condition is zero for the certificates produced from the finite-width
no-bad-suffix lemma; it is kept explicit here so this constructor is reusable.
-/
noncomputable def rankMonitorRunOfFamilyRun
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n))
    (hcutoff0 :
      ∀ priority : OddPriority A,
        (family.certificate priority.1 priority.2).cutoff = 0) :
    (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word where
  path := rankMonitorStateOfFamilyRun supportRun family
  initial_state := by
    dsimp [rankMonitorBuchi, rankMonitorInitialState,
      rankMonitorStateOfFamilyRun, rankMonitorRankOfFamily,
      rankMonitorPendingOfFamilyRun]
    congr
    exact supportRun.toMacroRun.initial_states
  step_valid := by
    intro n
    dsimp [rankMonitorBuchi]
    refine ⟨supportRun.stepSupportChoice n, ?_, ?_, ?_, ?_⟩
    · exact supportRun.stepSupportChoice_support n
    · cases n with
      | zero =>
          exact
            RankingSnapshot.ofFamily_validOnFrontier
              family 1
              (by
                intro priority
                rw [hcutoff0 priority]
                omega)
      | succ n =>
          exact
            RankingSnapshot.ofFamily_validOnFrontier
              family (n + 2)
              (by
                intro priority
                rw [hcutoff0 priority]
                omega)
    · cases n with
      | zero =>
          exact
            rankStepValid_topRankSnapshot_to_ofFamily
              family
              (by
                intro priority
                rw [hcutoff0 priority]
                omega)
      | succ n =>
          exact
            RankingSnapshot.ofFamily_stepValid
              family (n + 1)
              (by
                intro priority
                rw [hcutoff0 priority]
                omega)
    · rfl

/-- The support choice carried by one concrete transition of a rank-monitor run. -/
noncomputable def rankMonitorRunStepData
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word)
    (n : Nat) :
    ∃ supportChoice : A.MacroStepSupport (run.path n).frontier (word n),
      supportChoice.support = (run.path (n + 1)).frontier ∧
        rankSnapshotValidOnFrontier A (run.path (n + 1)).frontier
          (run.path (n + 1)).rank ∧
          rankStepValid supportChoice (run.path n).rank
            (run.path (n + 1)).rank ∧
            (run.path (n + 1)).pending =
              rankNextPending (run.path n) supportChoice
                (run.path (n + 1)).rank := by
  have hstep :
      rankMonitorStep A (run.path n) (word n) (run.path (n + 1)) := by
    simpa [rankMonitorBuchi] using run.step_valid n
  exact hstep

/-- Chosen support for one transition of a rank-monitor run. -/
noncomputable def rankMonitorRunSupportChoice
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word)
    (n : Nat) :
    A.MacroStepSupport (run.path n).frontier (word n) :=
  Classical.choose (rankMonitorRunStepData run n)

theorem rankMonitorRunSupportChoice_support
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word)
    (n : Nat) :
    (rankMonitorRunSupportChoice run n).support =
      (run.path (n + 1)).frontier :=
  (Classical.choose_spec (rankMonitorRunStepData run n)).1

theorem rankMonitorRunSupportChoice_rankStepValid
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word)
    (n : Nat) :
    rankStepValid (rankMonitorRunSupportChoice run n)
      (run.path n).rank (run.path (n + 1)).rank :=
  (Classical.choose_spec (rankMonitorRunStepData run n)).2.2.1

theorem rankMonitorRun_pending_eq
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word)
    (n : Nat) :
    (run.path (n + 1)).pending =
      rankNextPending (run.path n) (rankMonitorRunSupportChoice run n)
        (run.path (n + 1)).rank :=
  (Classical.choose_spec (rankMonitorRunStepData run n)).2.2.2

theorem rankMonitorRun_rankSnapshotValidOnFrontier
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word)
    (n : Nat) :
    rankSnapshotValidOnFrontier A (run.path n).frontier (run.path n).rank := by
  cases n with
  | zero =>
      rw [run.initial_state]
      exact topRankSnapshot_validOnFrontier A {A.initial}
  | succ n =>
      exact (Classical.choose_spec (rankMonitorRunStepData run n)).2.1

@[simp]
theorem mem_rankWatchSeed
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Finset A.State}
    {rank : RankSnapshot A}
    {watch : RankWatch A}
    {state : A.State} :
    state ∈ rankWatchSeed A frontier rank watch ↔
      state ∈ frontier ∧
        ¬ priorityGrant A watch.priority state ∧
          rankMatchesWatch rank watch state := by
  classical
  simp [rankWatchSeed]

theorem rankWatchCurrentPending_eq_seed_of_allClear
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {state : RankMonitorState A}
    {watch : RankWatch A}
    (hclear : rankPendingAllClear state.pending) :
    rankWatchCurrentPending A state watch =
      rankWatchSeed A state.frontier state.rank watch := by
  classical
  simp [rankWatchCurrentPending, hclear]

theorem rankWatchCurrentPending_eq_pending_of_not_allClear
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {state : RankMonitorState A}
    {watch : RankWatch A}
    (hclear : ¬ rankPendingAllClear state.pending) :
    rankWatchCurrentPending A state watch = state.pending watch := by
  classical
  simp [rankWatchCurrentPending, hclear]

theorem mem_rankWatchNextPending
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {letter : Alphabet}
    {current : RankMonitorState A}
    {supportChoice : A.MacroStepSupport current.frontier letter}
    {nextRank : RankSnapshot A}
    {watch : RankWatch A}
    {target : A.State} :
    target ∈ rankWatchNextPending current supportChoice nextRank watch ↔
      ∃ source : A.State,
        (source, target) ∈ supportChoice.stateEdges ∧
          source ∈ rankWatchCurrentPending A current watch ∧
            ¬ priorityGrant A watch.priority source ∧
              ¬ priorityGrant A watch.priority target ∧
                rankMatchesWatch nextRank watch target := by
  classical
  constructor
  · intro htarget
    unfold rankWatchNextPending at htarget
    rcases Finset.mem_biUnion.mp htarget with ⟨edge, hedge, hedgeTarget⟩
    by_cases hprop :
        edge.1 ∈ rankWatchCurrentPending A current watch ∧
          ¬ priorityGrant A watch.priority edge.1 ∧
            ¬ priorityGrant A watch.priority edge.2 ∧
              rankMatchesWatch nextRank watch edge.2
    · have htarget_eq : target = edge.2 := by
        simpa [hprop] using hedgeTarget
      subst target
      exact ⟨edge.1, by simpa using hedge, hprop.1, hprop.2.1,
        hprop.2.2.1, hprop.2.2.2⟩
    · simp [hprop] at hedgeTarget
  · rintro ⟨source, hedge, hsource, hsourceGrant, htargetGrant, hrank⟩
    unfold rankWatchNextPending
    refine Finset.mem_biUnion.mpr ⟨(source, target), hedge, ?_⟩
    simp [hsource, hsourceGrant, htargetGrant, hrank]

set_option maxHeartbeats 800000 in
theorem exists_rankWatchFiniteHistory_of_pending_mem
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n))
    (watch : RankWatch A)
    (reset length : Nat)
    (hclear :
      rankPendingAllClear
        (rankMonitorPendingOfFamilyRun supportRun family reset))
    (hnoClear :
      ∀ level : Nat,
        reset < level ->
          level < reset + length ->
            ¬ rankPendingAllClear
              (rankMonitorPendingOfFamilyRun supportRun family level))
    (hpos : 1 ≤ length)
    {target : A.State}
    (hmem :
      target ∈
        rankMonitorPendingOfFamilyRun supportRun family (reset + length) watch) :
    ∃ history : RankWatchFiniteHistory supportRun family watch reset length,
      history.vertex ⟨length, Nat.lt_succ_self length⟩ = target := by
  classical
  induction length generalizing target with
  | zero =>
      omega
  | succ previous ih =>
      have hmemNext :
          target ∈
            rankWatchNextPending
              { frontier := supportRun.toMacroRun.states (reset + previous)
                rank := rankMonitorRankOfFamily family (reset + previous)
                pending :=
                  rankMonitorPendingOfFamilyRun supportRun family
                    (reset + previous) }
              (supportRun.stepSupportChoice (reset + previous))
              (rankMonitorRankOfFamily family (reset + (previous + 1)))
              watch := by
        have hlevel : reset + (previous + 1) = reset + previous + 1 := by
          omega
        have hmem' :
            target ∈
              rankMonitorPendingOfFamilyRun supportRun family
                (reset + previous + 1) watch := by
          simpa [hlevel] using hmem
        simpa [rankMonitorPendingOfFamilyRun_succ, Nat.add_assoc] using hmem'
      rcases (mem_rankWatchNextPending.mp hmemNext) with
        ⟨source, hedge, hsourceCurrent, hsourceGrant, htargetGrant,
          htargetRank⟩
      cases previous with
      | zero =>
          have hsourceSeed :
              source ∈
                rankWatchSeed A
                  (supportRun.toMacroRun.states reset)
                  (rankMonitorRankOfFamily family reset)
                  watch := by
            let current : RankMonitorState A :=
              { frontier := supportRun.toMacroRun.states reset
                rank := rankMonitorRankOfFamily family reset
                pending := rankMonitorPendingOfFamilyRun supportRun family reset }
            change source ∈ rankWatchCurrentPending A current watch at hsourceCurrent
            have hseedEq :
                rankWatchCurrentPending A current watch =
                  rankWatchSeed A
                    (supportRun.toMacroRun.states reset)
                    (rankMonitorRankOfFamily family reset)
                    watch :=
              rankWatchCurrentPending_eq_seed_of_allClear
                (state := current)
                (watch := watch)
                hclear
            simpa [current, hseedEq] using hsourceCurrent
          have hsourceRank :
              rankMatchesWatch
                (rankMonitorRankOfFamily family reset) watch source :=
            (mem_rankWatchSeed.mp hsourceSeed).2.2
          let base :
              RankWatchFiniteHistory supportRun family watch reset 0 :=
            { vertex := fun _ => source
              start_seed := by simpa using hsourceSeed
              edge := by
                intro i hi
                omega
              grant_free := by
                intro i hi
                have hi0 : i = 0 := by omega
                subst i
                simpa using hsourceGrant
              rank_match := by
                intro i hi
                have hi0 : i = 0 := by omega
                subst i
                simpa using hsourceRank }
          let extended :=
            RankWatchFiniteHistory.snoc
              (supportRun := supportRun)
              (family := family)
              (watch := watch)
              base
              target
              (by simpa [base] using hedge)
              htargetGrant
              (by simpa [Nat.add_assoc] using htargetRank)
          refine ⟨extended, ?_⟩
          simp [extended, RankWatchFiniteHistory.snoc]
      | succ previous =>
          have hprevPos : 1 ≤ previous + 1 := by omega
          have hprevNoClear :
              ¬ rankPendingAllClear
                (rankMonitorPendingOfFamilyRun supportRun family
                  (reset + (previous + 1))) := by
            apply hnoClear
            · omega
            · omega
          have hsourcePending :
              source ∈
                rankMonitorPendingOfFamilyRun supportRun family
                  (reset + (previous + 1)) watch := by
            let current : RankMonitorState A :=
              { frontier := supportRun.toMacroRun.states (reset + (previous + 1))
                rank := rankMonitorRankOfFamily family (reset + (previous + 1))
                pending :=
                  rankMonitorPendingOfFamilyRun supportRun family
                    (reset + (previous + 1)) }
            change source ∈ rankWatchCurrentPending A current watch at hsourceCurrent
            have hpendingEq :
                rankWatchCurrentPending A current watch =
                  rankMonitorPendingOfFamilyRun supportRun family
                    (reset + (previous + 1)) watch :=
              rankWatchCurrentPending_eq_pending_of_not_allClear
                (state := current)
                (watch := watch)
                hprevNoClear
            simpa [current, hpendingEq] using hsourceCurrent
          have hnoClearPrev :
              ∀ level : Nat,
                reset < level ->
                  level < reset + (previous + 1) ->
                    ¬ rankPendingAllClear
                      (rankMonitorPendingOfFamilyRun supportRun family level) := by
            intro level hgt hlt
            exact hnoClear level hgt (by omega)
          rcases ih hnoClearPrev hprevPos hsourcePending with
            ⟨history, hlast⟩
          have hedge' :
              (history.vertex
                  ⟨previous + 1, Nat.lt_succ_self (previous + 1)⟩,
                target) ∈
                (supportRun.stepSupportChoice
                  (reset + (previous + 1))).stateEdges := by
            simpa [hlast] using hedge
          let extended :=
            RankWatchFiniteHistory.snoc
              (supportRun := supportRun)
              (family := family)
              (watch := watch)
              history
              target
              hedge'
              htargetGrant
              (by simpa [Nat.add_assoc] using htargetRank)
          refine ⟨extended, ?_⟩
          simp [extended, RankWatchFiniteHistory.snoc]

theorem rankMonitorPendingOfFamilyRun_watch_empty_next_of_not_allClear
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n))
    (watch : RankWatch A)
    (level : Nat)
    (hnotClear :
      ¬ rankPendingAllClear
        (rankMonitorPendingOfFamilyRun supportRun family level))
    (hempty :
      rankMonitorPendingOfFamilyRun supportRun family level watch = ∅) :
    rankMonitorPendingOfFamilyRun supportRun family (level + 1) watch = ∅ := by
  classical
  ext target
  constructor
  · intro htarget
    have hnext :
        target ∈
          rankWatchNextPending
            { frontier := supportRun.toMacroRun.states level
              rank := rankMonitorRankOfFamily family level
              pending := rankMonitorPendingOfFamilyRun supportRun family level }
            (supportRun.stepSupportChoice level)
            (rankMonitorRankOfFamily family (level + 1))
            watch := by
      simpa [rankMonitorPendingOfFamilyRun_succ] using htarget
    rcases (mem_rankWatchNextPending.mp hnext) with
      ⟨source, _hedge, hsourceCurrent, _hsourceGrant, _htargetGrant,
        _hrank⟩
    let current : RankMonitorState A :=
      { frontier := supportRun.toMacroRun.states level
        rank := rankMonitorRankOfFamily family level
        pending := rankMonitorPendingOfFamilyRun supportRun family level }
    change source ∈ rankWatchCurrentPending A current watch at hsourceCurrent
    have hpendingEq :
        rankWatchCurrentPending A current watch =
          rankMonitorPendingOfFamilyRun supportRun family level watch :=
      rankWatchCurrentPending_eq_pending_of_not_allClear
        (state := current)
        (watch := watch)
        hnotClear
    have hsourcePending :
        source ∈ rankMonitorPendingOfFamilyRun supportRun family level watch := by
      simpa [current, hpendingEq] using hsourceCurrent
    rw [hempty] at hsourcePending
    exact False.elim (Finset.notMem_empty _ hsourcePending)
  · intro htargetEmpty
    exact False.elim (Finset.notMem_empty _ htargetEmpty)

theorem rankMonitorPendingOfFamilyRun_watch_empty_persists
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n))
    (watch : RankWatch A)
    (start : Nat)
    (hnoClearFrom :
      ∀ level : Nat, start ≤ level ->
        ¬ rankPendingAllClear
          (rankMonitorPendingOfFamilyRun supportRun family level))
    (hempty :
      rankMonitorPendingOfFamilyRun supportRun family start watch = ∅) :
    ∀ level : Nat, start ≤ level ->
      rankMonitorPendingOfFamilyRun supportRun family level watch = ∅ := by
  intro level hle
  exact
    Nat.le_induction
      hempty
      (by
        intro n hn ih
        exact
          rankMonitorPendingOfFamilyRun_watch_empty_next_of_not_allClear
            supportRun family watch n (hnoClearFrom n hn) ih)
      level
      hle

theorem exists_rankMonitorPendingOfFamilyRun_watch_empty_after_reset_of_no_global_clear
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n))
    (hcutoff0 :
      ∀ priority : OddPriority A,
        (family.certificate priority.1 priority.2).cutoff = 0)
    (reset : Nat)
    (hclear :
      rankPendingAllClear
        (rankMonitorPendingOfFamilyRun supportRun family reset))
    (hnoLaterClear :
      ∀ level : Nat, reset < level ->
        ¬ rankPendingAllClear
          (rankMonitorPendingOfFamilyRun supportRun family level))
    (watch : RankWatch A) :
    ∃ length : Nat,
      1 ≤ length ∧
        rankMonitorPendingOfFamilyRun supportRun family (reset + length) watch =
          ∅ := by
  classical
  by_contra hnone
  push Not at hnone
  have hhist :
      ∀ length : Nat,
        Nonempty (RankWatchFiniteHistory supportRun family watch reset length) := by
    intro length
    cases length with
    | zero =>
        rcases hnone 1 (by omega) with ⟨target, htarget⟩
        have hnoClearOne :
            ∀ level : Nat,
              reset < level ->
                level < reset + 1 ->
                  ¬ rankPendingAllClear
                    (rankMonitorPendingOfFamilyRun supportRun family level) := by
          intro level hgt hlt
          omega
        rcases
            exists_rankWatchFiniteHistory_of_pending_mem
              supportRun family watch reset 1 hclear hnoClearOne
              (by omega) htarget with
          ⟨history, _hlast⟩
        exact ⟨history.take 0 (by omega)⟩
    | succ length =>
        have hpos : 1 ≤ length + 1 := by omega
        rcases hnone (length + 1) hpos with ⟨target, htarget⟩
        have hnoClearBefore :
            ∀ level : Nat,
              reset < level ->
                level < reset + (length + 1) ->
                  ¬ rankPendingAllClear
                    (rankMonitorPendingOfFamilyRun supportRun family level) := by
          intro level hgt _hlt
          exact hnoLaterClear level hgt
        rcases
            exists_rankWatchFiniteHistory_of_pending_mem
              supportRun family watch reset (length + 1) hclear
              hnoClearBefore hpos htarget with
          ⟨history, _hlast⟩
        exact ⟨history⟩
  exact RankWatchFiniteHistory.not_arbitrarily_long
    (supportRun := supportRun)
    (family := family)
    (watch := watch)
    (reset := reset)
    hcutoff0
    hhist

theorem exists_rankMonitorPendingOfFamilyRun_next_allClear
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n))
    (hcutoff0 :
      ∀ priority : OddPriority A,
        (family.certificate priority.1 priority.2).cutoff = 0)
    (reset : Nat)
    (hclear :
      rankPendingAllClear
        (rankMonitorPendingOfFamilyRun supportRun family reset)) :
    ∃ next : Nat,
      reset < next ∧
        rankPendingAllClear
          (rankMonitorPendingOfFamilyRun supportRun family next) := by
  classical
  by_contra hnone
  push Not at hnone
  have hnoLaterClear :
      ∀ level : Nat, reset < level ->
        ¬ rankPendingAllClear
          (rankMonitorPendingOfFamilyRun supportRun family level) := by
    intro level hgt
    exact hnone level hgt
  have hnotClearOne :
      ¬ rankPendingAllClear
        (rankMonitorPendingOfFamilyRun supportRun family (reset + 1)) :=
    hnoLaterClear (reset + 1) (by omega)
  have hsomeWatch : ∃ watch : RankWatch A,
      rankMonitorPendingOfFamilyRun supportRun family (reset + 1) watch ≠ ∅ := by
    by_cases hall :
        ∀ watch : RankWatch A,
          rankMonitorPendingOfFamilyRun supportRun family (reset + 1) watch =
            ∅
    · exact False.elim (hnotClearOne hall)
    · push Not at hall
      rcases hall with ⟨watch, hwatch⟩
      exact ⟨watch, Finset.nonempty_iff_ne_empty.mp hwatch⟩
  rcases hsomeWatch with ⟨watch₀, _hwatch₀⟩
  have hemptyFor :
      ∀ watch : RankWatch A,
        ∃ length : Nat,
          1 ≤ length ∧
            rankMonitorPendingOfFamilyRun supportRun family
                (reset + length) watch = ∅ := by
    intro watch
    exact
      exists_rankMonitorPendingOfFamilyRun_watch_empty_after_reset_of_no_global_clear
        supportRun family hcutoff0 reset hclear hnoLaterClear watch
  choose length hlength_pos hlength_empty using hemptyFor
  let bound : Nat := Finset.univ.sup length
  have hlength_le_bound :
      ∀ watch : RankWatch A, length watch ≤ bound := by
    intro watch
    exact Finset.le_sup (Finset.mem_univ watch)
  have hbound_pos : 1 ≤ bound :=
    le_trans (hlength_pos watch₀) (hlength_le_bound watch₀)
  have hallClearBound :
      rankPendingAllClear
        (rankMonitorPendingOfFamilyRun supportRun family (reset + bound)) := by
    intro watch
    let start := reset + length watch
    have hstart_le : start ≤ reset + bound := by
      have hlen_le : length watch ≤ bound := hlength_le_bound watch
      dsimp [start]
      omega
    have hnoClearFrom :
        ∀ level : Nat, start ≤ level ->
          ¬ rankPendingAllClear
            (rankMonitorPendingOfFamilyRun supportRun family level) := by
      intro level hle
      apply hnoLaterClear
      have hpos := hlength_pos watch
      dsimp [start] at hle
      omega
    have hpersist :=
      rankMonitorPendingOfFamilyRun_watch_empty_persists
        supportRun family watch start hnoClearFrom (hlength_empty watch)
    exact hpersist (reset + bound) hstart_le
  exact hnoLaterClear (reset + bound) (by omega) hallClearBound

theorem rankMonitorRunOfFamilyRun_accepts
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n))
    (hcutoff0 :
      ∀ priority : OddPriority A,
        (family.certificate priority.1 priority.2).cutoff = 0) :
    (rankMonitorRunOfFamilyRun supportRun family hcutoff0).Accepts := by
  classical
  have hclear0 :
      rankPendingAllClear
        (rankMonitorPendingOfFamilyRun supportRun family 0) := by
    intro watch
    rfl
  have hclear_ge :
      ∀ n : Nat,
        ∃ k : Nat,
          n ≤ k ∧
            rankPendingAllClear
              (rankMonitorPendingOfFamilyRun supportRun family k) := by
    intro n
    induction n with
    | zero =>
        exact ⟨0, by omega, hclear0⟩
    | succ n ih =>
        rcases ih with ⟨k, hnk, hclearK⟩
        by_cases hsucc_le : n + 1 ≤ k
        · exact ⟨k, hsucc_le, hclearK⟩
        · rcases
            exists_rankMonitorPendingOfFamilyRun_next_allClear
              supportRun family hcutoff0 k hclearK with
            ⟨next, hnext_gt, hnext_clear⟩
          exact ⟨next, by omega, hnext_clear⟩
  intro n
  rcases hclear_ge n with ⟨k, hnk, hclearK⟩
  refine ⟨k, hnk, ?_⟩
  simpa [rankMonitorRunOfFamilyRun, rankMonitorBuchi, rankMonitorAccepting,
    rankMonitorStateOfFamilyRun] using hclearK

theorem rankMonitorBuchi_accepts_of_rankedSupportRun
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (family :
      StreettRankingFamily A
        (fun n => supportRun.toMacroRun.states n)
