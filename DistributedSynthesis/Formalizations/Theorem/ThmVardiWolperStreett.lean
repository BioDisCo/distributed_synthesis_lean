@[simp]
theorem rankMonitorRunEdgeWitnessedMacroRun_stateEdges
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word)
    (n : Nat) :
