theorem rankMonitorBuchi_accepts_of_noBadOddPrioritySuffixFamily
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun : A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (hnoBad :
      NoBadOddPrioritySuffixFamily A
        (fun n => supportRun.toMacroRun.states n)
        word
        (fun n => supportRun.stepSupportChoice n)) :
