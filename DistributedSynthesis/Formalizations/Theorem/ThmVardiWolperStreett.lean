theorem rankMonitorRun_path_rank_succ_le
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word)
    {path : Nat -> A.State}
    (hpath : (rankMonitorRunEdgeWitnessedMacroRun A run).SupportPath path)
    (priority : OddPriority A)
    (n : Nat)
    (hsourceGrant : ¬ priorityGrant A priority.1 (path n))
    (htargetGrant : ¬ priorityGrant A priority.1 (path (n + 1))) :
    ((run.path (n + 1)).rank priority (path (n + 1))).1 ≤
      ((run.path n).rank priority (path n)).1 := by
  have hedge :
      (path n, path (n + 1)) ∈
        (rankMonitorRunSupportChoice run n).stateEdges := by
    simpa [rankMonitorRunEdgeWitnessedMacroRun] using hpath.2 n
  exact
    rankMonitorRunSupportChoice_rankStepValid run n
      priority
      (path n, path (n + 1))
      hedge
      hsourceGrant
      htargetGrant

theorem rankMonitorRun_path_rank_eventually_constant_of_grant_free
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word)
    {path : Nat -> A.State}
    (hpath : (rankMonitorRunEdgeWitnessedMacroRun A run).SupportPath path)
    (priority : OddPriority A)
    (start : Nat)
    (hgrantFree :
      ∀ n : Nat, start ≤ n ->
        ¬ priorityGrant A priority.1 (path n)) :
    ∃ stableOffset value : Nat,
      ∀ offset : Nat, stableOffset ≤ offset ->
        ((run.path (start + offset)).rank priority
          (path (start + offset))).1 = value := by
  let measure : Nat -> Nat :=
    fun offset =>
      ((run.path (start + offset)).rank priority
        (path (start + offset))).1
  have hstep : ∀ offset : Nat, measure (offset + 1) ≤ measure offset := by
    intro offset
    have hsource :
        ¬ priorityGrant A priority.1 (path (start + offset)) :=
      hgrantFree (start + offset) (Nat.le_add_right start offset)
    have htarget :
        ¬ priorityGrant A priority.1 (path (start + (offset + 1))) :=
      hgrantFree (start + (offset + 1))
        (Nat.le_add_right start (offset + 1))
    have hle :=
      rankMonitorRun_path_rank_succ_le
        run
        hpath
        priority
        (start + offset)
        hsource
        (by
          have htarget' :
              ¬ priorityGrant A priority.1
                (path (start + offset + 1)) := by
            simpa [Nat.add_assoc] using htarget
          exact htarget')
    simpa [measure, Nat.add_assoc] using hle
  have hanti : Antitone measure := antitone_nat_of_succ_le hstep
  rcases
      FiniteWidthStreett.LeveledGraph.eventually_constant_of_antitone
        hanti with
    ⟨stableOffset, value, hstable⟩
  exact ⟨stableOffset, value, hstable⟩

theorem rankMonitorRun_stable_rank_even_of_request_seen
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word)
    {path : Nat -> A.State}
    (hpath : (rankMonitorRunEdgeWitnessedMacroRun A run).SupportPath path)
    (priority : OddPriority A)
    {start stableOffset value : Nat}
    (hstable :
      ∀ offset : Nat, stableOffset ≤ offset ->
        ((run.path (start + offset)).rank priority
          (path (start + offset))).1 = value)
    (hrequestSeen :
      A.SupportEdgePathPrioritySeenInfinitelyOften path priority.1) :
    Even value := by
  rcases hrequestSeen (start + stableOffset) with
    ⟨requestTime, hrequestTime, hrequest⟩
  have hoffsetLe : stableOffset ≤ requestTime - start := by
    omega
  have hlevel : start + (requestTime - start) = requestTime := by
    omega
  have hrank :
      ((run.path requestTime).rank priority (path requestTime)).1 = value := by
    simpa [hlevel] using hstable (requestTime - start) hoffsetLe
  have hfrontier :
      path requestTime ∈ (run.path requestTime).frontier := by
    simpa [rankMonitorRunEdgeWitnessedMacroRun] using
      hpath.state_mem requestTime
  have hvalid :=
    rankMonitorRun_rankSnapshotValidOnFrontier run requestTime
      priority
      (path requestTime)
      hfrontier
      (by simpa [priorityRequest] using hrequest)
  simpa [hrank] using hvalid

theorem rankMonitorRun_pending_contains_path_after_reset
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word)
    {path : Nat -> A.State}
    (hpath : (rankMonitorRunEdgeWitnessedMacroRun A run).SupportPath path)
    (watch : RankWatch A)
    (reset : Nat)
    (hclear : rankPendingAllClear (run.path reset).pending)
    (hgrantFree :
      ∀ n : Nat, reset ≤ n ->
        ¬ priorityGrant A watch.priority (path n))
    (hrank :
      ∀ n : Nat, reset ≤ n ->
        rankMatchesWatch (run.path n).rank watch (path n)) :
    ∀ offset : Nat, 1 ≤ offset ->
      path (reset + offset) ∈
        (run.path (reset + offset)).pending watch := by
  suffices hsucc :
      ∀ t : Nat,
        path (reset + (t + 1)) ∈
          (run.path (reset + (t + 1))).pending watch by
    intro offset hoffset
    have hoffsetEq : offset - 1 + 1 = offset :=
      Nat.sub_add_cancel hoffset
    have h := hsucc (offset - 1)
    rw [hoffsetEq] at h
    exact h
  intro t
  induction t with
  | zero =>
      have hsourceFrontier :
          path reset ∈ (run.path reset).frontier := by
        simpa [rankMonitorRunEdgeWitnessedMacroRun] using hpath.state_mem reset
      have hsourceSeed :
          path reset ∈
            rankWatchSeed A (run.path reset).frontier (run.path reset).rank
              watch := by
        exact (mem_rankWatchSeed).mpr
          ⟨hsourceFrontier, hgrantFree reset le_rfl, hrank reset le_rfl⟩
      have hsourceCurrent :
          path reset ∈
            rankWatchCurrentPending A (run.path reset) watch := by
        simpa [rankWatchCurrentPending_eq_seed_of_allClear hclear]
          using hsourceSeed
      have hedge :
          (path reset, path (reset + 1)) ∈
            (rankMonitorRunSupportChoice run reset).stateEdges := by
        simpa [rankMonitorRunEdgeWitnessedMacroRun] using hpath.2 reset
      have htarget :=
        rankMonitorRun_pending_propagates
          run
          reset
          (watch := watch)
          (source := path reset)
          (target := path (reset + 1))
          hedge
          hsourceCurrent
          (hgrantFree reset le_rfl)
          (hgrantFree (reset + 1) (Nat.le_succ reset))
          (hrank (reset + 1) (Nat.le_succ reset))
      simpa using htarget
  | succ t ih =>
      let level := reset + (t + 1)
      have hsourcePending :
          path level ∈ (run.path level).pending watch := by
        simpa [level, Nat.add_assoc] using ih
      have hnotClear :
          ¬ rankPendingAllClear (run.path level).pending := by
        intro hall
        have hempty : (run.path level).pending watch = ∅ := hall watch
        rw [hempty] at hsourcePending
        exact Finset.notMem_empty _ hsourcePending
      have hsourceCurrent :
          path level ∈
            rankWatchCurrentPending A (run.path level) watch := by
        simpa [rankWatchCurrentPending_eq_pending_of_not_allClear hnotClear]
          using hsourcePending
      have hedge :
          (path level, path (level + 1)) ∈
            (rankMonitorRunSupportChoice run level).stateEdges := by
        simpa [rankMonitorRunEdgeWitnessedMacroRun] using hpath.2 level
      have hlevel_ge : reset ≤ level := by
        dsimp [level]
        omega
      have htarget_ge : reset ≤ level + 1 := by
        dsimp [level]
        omega
      have htarget :=
        rankMonitorRun_pending_propagates
          run
          level
          (watch := watch)
          (source := path level)
          (target := path (level + 1))
          hedge
          hsourceCurrent
          (hgrantFree level hlevel_ge)
          (hgrantFree (level + 1) htarget_ge)
          (hrank (level + 1) htarget_ge)
      simpa [level, Nat.add_assoc] using htarget

theorem rankMonitorRunEdgeWitnessedMacroRun_supportAccepting
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (rankMonitorBuchi A).RunFrom (rankMonitorBuchi A).initial word)
    (haccepts : run.Accepts) :
    (rankMonitorRunEdgeWitnessedMacroRun A run).SupportAccepting := by
  classical
  intro path hpath
  rcases exists_min_pathPrioritySeenInfinitelyOften A path with
    ⟨priority, hprioritySeen, hpriorityMin⟩
  by_cases hpriorityEven : DetParityAutomaton.NatEven priority
  · exact ⟨priority, hpriorityEven, hprioritySeen, hpriorityMin⟩
  · have hpriorityMem : priority ∈ A.oddPriorityFinset := by
      rcases hprioritySeen 0 with ⟨k, _hk, hkprio⟩
      exact (A.mem_oddPriorityFinset priority).mpr
        ⟨⟨path k, hkprio⟩, hpriorityEven⟩
    let oddPriority : OddPriority A := ⟨priority, hpriorityMem⟩
    rcases
        eventually_avoids_priorityGrant_of_min_pathPriority
          A path hpriorityMin with
      ⟨avoidStart, hgrantFreeFromAvoid⟩
    rcases
        rankMonitorRun_path_rank_eventually_constant_of_grant_free
          run hpath oddPriority avoidStart hgrantFreeFromAvoid with
      ⟨stableOffset, stableValue, hstable⟩
    have hstableEven : Even stableValue :=
      rankMonitorRun_stable_rank_even_of_request_seen
        run hpath oddPriority hstable hprioritySeen
    let hstableAbs : Nat := avoidStart + stableOffset
    have hstableValue_lt :
        stableValue <
          FiniteWidthStreett.LeveledGraph.rankBound A.State + 1 := by
      have hfin :
          (((run.path hstableAbs).rank oddPriority
            (path hstableAbs))).1 <
            FiniteWidthStreett.LeveledGraph.rankBound A.State + 1 :=
        (((run.path hstableAbs).rank oddPriority (path hstableAbs))).2
      have hrank :
          (((run.path hstableAbs).rank oddPriority
            (path hstableAbs))).1 = stableValue := by
        simpa [hstableAbs] using hstable stableOffset le_rfl
      simpa [hrank] using hfin
    let watch : RankWatch A :=
      (oddPriority, ⟨⟨stableValue, hstableValue_lt⟩, hstableEven⟩)
    rcases haccepts hstableAbs with ⟨reset, hreset_ge, hresetAccepting⟩
    have hresetClear :
        rankPendingAllClear (run.path reset).pending := by
      simpa [rankMonitorBuchi, rankMonitorAccepting] using hresetAccepting
    have hreset_ge_avoid : avoidStart ≤ reset := by
      dsimp [hstableAbs] at hreset_ge
      omega
    have hreset_ge_stable : hstableAbs ≤ reset := hreset_ge
    have hgrantFreeFromReset :
        ∀ n : Nat, reset ≤ n ->
          ¬ priorityGrant A watch.priority (path n) := by
      intro n hn
      exact hgrantFreeFromAvoid n (le_trans hreset_ge_avoid hn)
    have hrankFromReset :
        ∀ n : Nat, reset ≤ n ->
          rankMatchesWatch (run.path n).rank watch (path n) := by
      intro n hn
      dsimp [rankMatchesWatch, watch, RankWatch.rank]
      apply Fin.ext
      have hoffsetLe : stableOffset ≤ n - avoidStart := by
        dsimp [hstableAbs] at hreset_ge_stable
        omega
      have hlevel : avoidStart + (n - avoidStart) = n := by
        omega
      simpa [hlevel] using hstable (n - avoidStart) hoffsetLe
    rcases haccepts (reset + 1) with ⟨later, hlater_ge, hlaterAccepting⟩
    have hpendingLater :
        path later ∈ (run.path later).pending watch := by
      have hoffset : 1 ≤ later - reset := by omega
      have hmem :=
        rankMonitorRun_pending_contains_path_after_reset
          run hpath watch reset hresetClear hgrantFreeFromReset
          hrankFromReset
          (later - reset)
          hoffset
      have hlevel : reset + (later - reset) = later := by omega
      simpa [hlevel] using hmem
    have hlaterClear :
        rankPendingAllClear (run.path later).pending := by
      simpa [rankMonitorBuchi, rankMonitorAccepting] using hlaterAccepting
    have hempty : (run.path later).pending watch = ∅ := hlaterClear watch
    rw [hempty] at hpendingLater
    exact False.elim (Finset.notMem_empty _ hpendingLater)

theorem accepts_of_rankMonitorBuchi_accepts
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (haccepts : (rankMonitorBuchi A).Accepts word) :
    A.Accepts word := by
  rcases haccepts with ⟨run, hrunAccepts⟩
  let supportRun := rankMonitorRunEdgeWitnessedMacroRun A run
  have hsupport : supportRun.SupportAccepting :=
    rankMonitorRunEdgeWitnessedMacroRun_supportAccepting run hrunAccepts
  have hacceptsInitial :
      ∀ state, state ∈ ({A.initial} : Finset A.State) ->
        A.AcceptsFrom state word :=
    supportRun.acceptsFrom_all_initial_of_supportAccepting_realized
      hsupport
      supportRun.hasRunTreeRealization
  simpa [AlternatingParityAutomaton.acceptsFrom_initial] using
    hacceptsInitial A.initial (by simp)

/--
An accepting support run supplies the no-bad-suffix obligations required by
the Vardi-Wolper rank monitor, hence the rank-monitor Büchi automaton accepts.
-/
theorem rankMonitorBuchi_accepts_of_edgeWitnessedSupportAccepting
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (supportRun :
      A.EdgeWitnessedMacroRun ({A.initial} : Finset A.State) word)
    (hsupport : supportRun.SupportAccepting) :
    (rankMonitorBuchi A).Accepts word :=
  rankMonitorBuchi_accepts_of_noBadOddPrioritySuffixFamily
    supportRun
    (noBadOddPrioritySuffixFamily_of_edgeWitnessedSupportAccepting
      supportRun hsupport)

/-- A support-normal-form witness is complete for the rank-monitor Büchi automaton. -/
theorem rankMonitorBuchi_accepts_of_hasAcceptingSupportRun
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (hwitness : HasAcceptingSupportRun A word) :
    (rankMonitorBuchi A).Accepts word := by
  rcases hwitness with ⟨supportRun, hsupport⟩
  exact rankMonitorBuchi_accepts_of_edgeWitnessedSupportAccepting
    supportRun hsupport

/--
If the standard support-run normal form is available for an APA, the
rank-monitor Büchi automaton is equivalent to APA run-tree acceptance.

The remaining nonconstructive literature step is exactly the premise: from an
accepting run tree obtain a state-based accepting support run.  The rest of the
Miyano-Hayashi/Vardi-Wolper proof is checked by the preceding lemmas.
-/
theorem rankMonitorBuchi_correct_of_supportNormalForm
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (hnormal :
      ∀ word : OmegaWord Alphabet,
        A.Accepts word -> HasAcceptingSupportRun A word)
    (word : OmegaWord Alphabet) :
    (rankMonitorBuchi A).Accepts word ↔ A.Accepts word := by
  constructor
  · exact accepts_of_rankMonitorBuchi_accepts
  · intro haccepts
    exact rankMonitorBuchi_accepts_of_hasAcceptingSupportRun
      (hnormal word haccepts)

end VardiWolper
end AlternatingParityAutomaton

