import DistributedSynthesis.Formalizations.Theorem.ThmPairedGuardedDelayedHandoff
import DistributedSynthesis.Formalizations.Theorem.ThmPairedInitialDelayedRegularization

/-!
# Initial-block regularization carrying guarded recurrent sources

The informed side augments its ordinary output by a finite guarded source.
This auxiliary component is not part of the model execution.  The monitor
stores it for one round, checks the source's profile against the next
overlapping output, and checks that every newly supplied source starts at the
paired target generated by the current boundary.

Consequently the ordinary sender-narrowing theorem can preserve the complete
guarded handoff.  No strict-leader observation and no unbounded view summary
is introduced.
-/

namespace DistributedSynthesis

universe u v x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]

abbrev GuardedInitialLeftReceiverOutput :=
  InitialLeftReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂) ×
    GuardedRightEntryData A

def guardedInitialLeftPhysicalLetter
    (letter : RealizedBlockRound In₁ In₂
      (GuardedInitialLeftReceiverOutput A) Out₂) :
    InitialLeftLetter
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂) :=
  (letter.1, letter.2.1.1, letter.2.2)

/-- The pending source is checked only against the overlap output owned by
process one.  Continuing with another `left` round and closing with `both`
have the same process-one local view, so this is exactly the required row. -/
def guardedInitialLeftOverlapOK
    (pending : Option (GuardedRightEntryData A))
    (letter : RealizedBlockRound In₁ In₂
      (GuardedInitialLeftReceiverOutput A) Out₂) : Prop :=
  match pending with
  | none => True
  | some source =>
      source.2 (letter.1.2, letter.1.1) = letter.2.1.1.informedOne

noncomputable def guardedInitialLeftBlockMonitor :
    BlockRecordMonitor In₁ In₂ (GuardedInitialLeftReceiverOutput A) Out₂ := by
  classical
  exact {
    State := (InitialBlockScan A × Option (GuardedRightEntryData A)) × Bool
    stateFinite := inferInstance
    initial := (((A.initial, A.initial), none), true)
    step := fun state letter =>
      let physical := guardedInitialLeftPhysicalLetter A letter
      let source := letter.2.1.2
      let targetOK := source.1 = initialLeftDelayedTarget A state.1.1 physical
      let feasible :=
        (rightProfileGuardedAutomaton A source.1 source.2).HasRationalRun
      let overlapOK := guardedInitialLeftOverlapOK A state.1.2 letter
      ((initialLeftScanStep A state.1.1 physical, some source),
        state.2 && decide targetOK && decide feasible && decide overlapOK)
    priority := fun state => if state.2 then A.priority state.1.1.1 + 2 else 1
  }

section WinningWitness

variable [Inhabited In₁] [Inhabited In₂]

variable
  (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
  (hwin : ∀ env : EnvironmentSequence In₁ In₂,
    A.Accepts (execution strategy env))
  (guardedBasis : ∀ target profile,
    (rightProfileGuardedAutomaton A target profile).RationalRunBasis)

noncomputable def guardedInitialLeftReceiverStrategy :
    ReceiverBlockStrategy In₁ In₂ (GuardedInitialLeftReceiverOutput A) :=
  fun past move =>
    let lambda := initialLeftLambdaOfStrategy strategy
    (⟨lambda.informedOne past move, lambda.reversingOne past move,
        lambda.reversingTwo past move⟩,
      (initialLeftGuardedSource A strategy hwin past move
        (guardedBasis _ _)).1)

noncomputable def guardedInitialLeftPending
    (env : Nat -> In₁ × In₂) : Nat -> Option (GuardedRightEntryData A)
  | 0 => none
  | n + 1 => some (initialLeftGuardedSource A strategy hwin
      (omegaPrefix env n) (env n) (guardedBasis _ _)).1

section
omit [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]

theorem guardedInitialLeft_pairPlay_physical
    (env : Nat -> In₁ × In₂) (n : Nat) :
    guardedInitialLeftPhysicalLetter A
      (pairPlay (guardedInitialLeftReceiverStrategy A strategy hwin guardedBasis)
        (initialLeftSenderStrategy (initialLeftLambdaOfStrategy strategy)) env n) =
      initialLeftLetterAt (initialLeftLambdaOfStrategy strategy)
        (omegaPrefix env n) (env n) := by
  simp [guardedInitialLeftPhysicalLetter, pairPlay, treePlay, treeOfPair,
    blockLabelApply, branchNode_eq_omegaPrefix,
    guardedInitialLeftReceiverStrategy, initialLeftSenderStrategy,
    initialLeftLetterAt]

theorem guardedInitialLeft_pairPlay_source
    (env : Nat -> In₁ × In₂) (n : Nat) :
    (pairPlay (guardedInitialLeftReceiverStrategy A strategy hwin guardedBasis)
      (initialLeftSenderStrategy (initialLeftLambdaOfStrategy strategy)) env n).2.1.2 =
      (initialLeftGuardedSource A strategy hwin
        (omegaPrefix env n) (env n) (guardedBasis _ _)).1 := by
  simp [pairPlay, treePlay, treeOfPair, blockLabelApply,
    branchNode_eq_omegaPrefix, guardedInitialLeftReceiverStrategy]

theorem guardedInitialLeft_overlapOK
    (env : Nat -> In₁ × In₂) (n : Nat) :
    guardedInitialLeftOverlapOK A
      (guardedInitialLeftPending A strategy hwin guardedBasis env n)
      (pairPlay (guardedInitialLeftReceiverStrategy A strategy hwin guardedBasis)
        (initialLeftSenderStrategy (initialLeftLambdaOfStrategy strategy)) env n) := by
  cases n with
  | zero => trivial
  | succ n =>
      simp only [guardedInitialLeftPending, guardedInitialLeftOverlapOK,
        initialLeftGuardedSource]
      have hphysical := guardedInitialLeft_pairPlay_physical
        A strategy hwin guardedBasis env (n + 1)
      have hmove := congrArg (fun letter => letter.1) hphysical
      have hout := congrArg (fun letter => letter.2.1.informedOne) hphysical
      have hmove' :
          (pairPlay
            (guardedInitialLeftReceiverStrategy A strategy hwin guardedBasis)
            (initialLeftSenderStrategy (initialLeftLambdaOfStrategy strategy))
            env (n + 1)).1 = env (n + 1) := by
        simpa [guardedInitialLeftPhysicalLetter, initialLeftLetterAt] using hmove
      have hout' :
          (pairPlay
            (guardedInitialLeftReceiverStrategy A strategy hwin guardedBasis)
            (initialLeftSenderStrategy (initialLeftLambdaOfStrategy strategy))
            env (n + 1)).2.1.1.informedOne =
            (initialLeftLambdaOfStrategy strategy).informedOne
              (omegaPrefix env (n + 1)) (env (n + 1)) := by
        simpa [guardedInitialLeftPhysicalLetter, initialLeftLetterAt] using hout
      rw [hmove', hout']
      change
        initialLeftNextBothProfile strategy (omegaPrefix env n) (env n)
            ((env (n + 1)).2, (env (n + 1)).1) =
          (initialLeftLambdaOfStrategy strategy).informedOne
            (omegaPrefix env (n + 1)) (env (n + 1))
      rw [omegaPrefix_succ]
      rfl

end

omit [Fintype Out₂] in
theorem guardedInitialLeftBlockMonitor_run_eq
    (env : Nat -> In₁ × In₂) : ∀ n,
    (guardedInitialLeftBlockMonitor A).run
        (pairPlay (guardedInitialLeftReceiverStrategy A strategy hwin guardedBasis)
          (initialLeftSenderStrategy (initialLeftLambdaOfStrategy strategy)) env) n =
      ((initialLeftScanAfter A (initialLeftLambdaOfStrategy strategy)
          (omegaPrefix env n),
        guardedInitialLeftPending A strategy hwin guardedBasis env n), true) := by
  classical
  intro n
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [BlockRecordMonitor.run, ih]
      simp only [guardedInitialLeftBlockMonitor]
      rw [guardedInitialLeft_pairPlay_physical
        A strategy hwin guardedBasis env n]
      rw [guardedInitialLeft_pairPlay_source
        A strategy hwin guardedBasis env n]
      change
        ((initialLeftScanStep A
            (initialLeftScanAfter A (initialLeftLambdaOfStrategy strategy)
              (omegaPrefix env n))
            (initialLeftLetterAt (initialLeftLambdaOfStrategy strategy)
              (omegaPrefix env n) (env n)),
          some (initialLeftGuardedSource A strategy hwin
            (omegaPrefix env n) (env n) (guardedBasis _ _)).1),
          true && decide
            ((initialLeftGuardedSource A strategy hwin
              (omegaPrefix env n) (env n) (guardedBasis _ _)).1.1 =
                initialLeftDelayedTarget A
                  (initialLeftScanAfter A (initialLeftLambdaOfStrategy strategy)
                    (omegaPrefix env n))
                  (initialLeftLetterAt (initialLeftLambdaOfStrategy strategy)
                    (omegaPrefix env n) (env n))) &&
            decide ((rightProfileGuardedAutomaton A
              (initialLeftGuardedSource A strategy hwin
                (omegaPrefix env n) (env n) (guardedBasis _ _)).1.1
              (initialLeftGuardedSource A strategy hwin
                (omegaPrefix env n) (env n) (guardedBasis _ _)).1.2).HasRationalRun) &&
            decide (guardedInitialLeftOverlapOK A
              (guardedInitialLeftPending A strategy hwin guardedBasis env n)
              (pairPlay
                (guardedInitialLeftReceiverStrategy A strategy hwin guardedBasis)
                (initialLeftSenderStrategy (initialLeftLambdaOfStrategy strategy))
                env n))) = _
      have htarget :
          (initialLeftGuardedSource A strategy hwin
            (omegaPrefix env n) (env n) (guardedBasis _ _)).1.1 =
              initialLeftDelayedTarget A
                (initialLeftScanAfter A (initialLeftLambdaOfStrategy strategy)
                  (omegaPrefix env n))
                (initialLeftLetterAt (initialLeftLambdaOfStrategy strategy)
                  (omegaPrefix env n) (env n)) := rfl
      have hfeasible :
          (rightProfileGuardedAutomaton A
            (initialLeftGuardedSource A strategy hwin
              (omegaPrefix env n) (env n) (guardedBasis _ _)).1.1
            (initialLeftGuardedSource A strategy hwin
              (omegaPrefix env n) (env n) (guardedBasis _ _)).1.2).HasRationalRun :=
        (initialLeftGuardedSource A strategy hwin
          (omegaPrefix env n) (env n) (guardedBasis _ _)).2
      have hoverlap := guardedInitialLeft_overlapOK
        A strategy hwin guardedBasis env n
      rw [decide_eq_true htarget, decide_eq_true hfeasible,
        decide_eq_true hoverlap]
      simp only [Bool.true_and]
      rw [omegaPrefix_succ, initialLeftScanAfter_append]
      rfl

omit [Fintype Out₂] in
theorem guardedInitialLeftBlockMonitor_wins
    (env : Nat -> In₁ × In₂) :
    (guardedInitialLeftBlockMonitor A).WinsPlay
      (pairPlay (guardedInitialLeftReceiverStrategy A strategy hwin guardedBasis)
        (initialLeftSenderStrategy (initialLeftLambdaOfStrategy strategy)) env) := by
  have hforever := initialLeftForeverAccepts_lambdaOfStrategy A strategy hwin env
  unfold BlockRecordMonitor.WinsPlay
  have heq :
      (fun n => (guardedInitialLeftBlockMonitor A).priority
        ((guardedInitialLeftBlockMonitor A).run
          (pairPlay
            (guardedInitialLeftReceiverStrategy A strategy hwin guardedBasis)
            (initialLeftSenderStrategy (initialLeftLambdaOfStrategy strategy))
            env) n)) =
        fun n => A.priority
          (A.run (initialLeftOmegaWord
            (initialLeftLambdaOfStrategy strategy) env) n) + 2 := by
    funext n
    rw [guardedInitialLeftBlockMonitor_run_eq
      A strategy hwin guardedBasis env n]
    simp only [guardedInitialLeftBlockMonitor, if_pos, Bool.true_eq]
    congr 2
    have hscan :
        (initialLeftScanAfter A (initialLeftLambdaOfStrategy strategy)
          (omegaPrefix env n)).1 =
          A.run (initialLeftOmegaWord
            (initialLeftLambdaOfStrategy strategy) env) n := by
      induction n with
      | zero => rfl
      | succ n ih =>
          rw [omegaPrefix_succ, initialLeftScanAfter_append]
          simp only [initialLeftScanStep, initialBlockScanStep]
          rw [ih]
          rfl
    exact hscan
  rw [heq]
  exact (natSeqMinEvenParity_add_const (d := 2) ⟨1, rfl⟩).mpr hforever

end WinningWitness

omit [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂] in
/-- The guarded initial-left controller is finite by the existing
unconditional sender-narrowing theorem. -/
theorem exists_finite_guardedInitialLeftController_of_winning
    [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
    [DecidableEq In₁] [DecidableEq In₂]
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (guardedBasis : ∀ target profile,
      (rightProfileGuardedAutomaton A target profile).RationalRunBasis) :
    ∃ controller : TransitionRationalTree.{v, max u v x y s, max s u v x} In₂
      (NarrowedBlockLabel In₁ In₂ (GuardedInitialLeftReceiverOutput A) Out₂
        (guardedInitialLeftBlockMonitor A).State),
      NarrowedAllThreadsWin (guardedInitialLeftBlockMonitor A)
        controller.labeledTree := by
  classical
  let rootData := (initialLeftGuardedSource A strategy hwin [] (default, default)
    (guardedBasis _ _)).1
  letI : Inhabited (GuardedRightEntryData A) := ⟨rootData⟩
  letI : Inhabited (GuardedInitialLeftReceiverOutput A) := inferInstance
  apply (block_realizable_iff_implementable_controller_unconditional
    (guardedInitialLeftBlockMonitor A)).mp
  exact ⟨guardedInitialLeftReceiverStrategy A strategy hwin guardedBasis,
    initialLeftSenderStrategy (initialLeftLambdaOfStrategy strategy),
    guardedInitialLeftBlockMonitor_wins A strategy hwin guardedBasis⟩

/-! ## Initial-right/process-two mirror -/

abbrev GuardedInitialRightReceiverOutput :=
  InitialRightReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂) ×
    GuardedLeftEntryData A

def guardedInitialRightPhysicalLetter
    (letter : RealizedBlockRound In₂ In₁
      (GuardedInitialRightReceiverOutput A) Out₁) :
    InitialRightLetter
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂) :=
  (letter.1, letter.2.1.1, letter.2.2)

def guardedInitialRightOverlapOK
    (pending : Option (GuardedLeftEntryData A))
    (letter : RealizedBlockRound In₂ In₁
      (GuardedInitialRightReceiverOutput A) Out₁) : Prop :=
  match pending with
  | none => True
  | some source =>
      source.2 (letter.1.2, letter.1.1) = letter.2.1.1.informedTwo

noncomputable def guardedInitialRightBlockMonitor :
    BlockRecordMonitor In₂ In₁ (GuardedInitialRightReceiverOutput A) Out₁ := by
  classical
  exact {
    State := (InitialBlockScan A × Option (GuardedLeftEntryData A)) × Bool
    stateFinite := inferInstance
    initial := (((A.initial, A.initial), none), true)
    step := fun state letter =>
      let physical := guardedInitialRightPhysicalLetter A letter
      let source := letter.2.1.2
      let targetOK := source.1 = initialRightDelayedTarget A state.1.1 physical
      let feasible :=
        (leftProfileGuardedAutomaton A source.1 source.2).HasRationalRun
      let overlapOK := guardedInitialRightOverlapOK A state.1.2 letter
      ((initialRightScanStep A state.1.1 physical, some source),
        state.2 && decide targetOK && decide feasible && decide overlapOK)
    priority := fun state => if state.2 then A.priority state.1.1.1 + 2 else 1
  }

