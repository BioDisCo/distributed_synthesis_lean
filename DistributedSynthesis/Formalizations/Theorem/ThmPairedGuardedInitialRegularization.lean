    [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [DecidableEq In₁] [DecidableEq In₂]
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (guardedBasis : ∀ target profile,
      (leftProfileGuardedAutomaton A target profile).RationalRunBasis) :
    ∃ controller : TransitionRationalTree.{u, max u v x y s, max s u v y} In₁
      (NarrowedBlockLabel In₂ In₁ (GuardedInitialRightReceiverOutput A) Out₁
        (guardedInitialRightBlockMonitor A).State),
      NarrowedAllThreadsWin (guardedInitialRightBlockMonitor A)
        controller.labeledTree := by
  classical
  let rootData := (initialRightGuardedSource A strategy hwin [] (default, default)
    (guardedBasis _ _)).1
  letI : Inhabited (GuardedLeftEntryData A) := ⟨rootData⟩
  letI : Inhabited (GuardedInitialRightReceiverOutput A) := inferInstance
  apply (block_realizable_iff_implementable_controller_unconditional
    (guardedInitialRightBlockMonitor A)).mp
  exact ⟨guardedInitialRightReceiverStrategy A strategy hwin guardedBasis,
    initialRightSenderStrategy (initialRightLambdaOfStrategy strategy),
    guardedInitialRightBlockMonitor_wins A strategy hwin guardedBasis⟩

