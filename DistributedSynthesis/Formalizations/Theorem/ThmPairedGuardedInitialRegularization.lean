omit [Fintype Out₁] in
theorem guardedInitialRightBlockMonitor_run_eq
    (env : Nat -> In₂ × In₁) : ∀ n,
    (guardedInitialRightBlockMonitor A).run
        (pairPlay (guardedInitialRightReceiverStrategy A strategy hwin guardedBasis)
          (initialRightSenderStrategy (initialRightLambdaOfStrategy strategy)) env) n =
      ((initialRightScanAfter A (initialRightLambdaOfStrategy strategy)
          (omegaPrefix env n),
        guardedInitialRightPending A strategy hwin guardedBasis env n), true) := by
  classical
  intro n
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [BlockRecordMonitor.run, ih]
      simp only [guardedInitialRightBlockMonitor]
      rw [guardedInitialRight_pairPlay_physical
        A strategy hwin guardedBasis env n]
      rw [guardedInitialRight_pairPlay_source
        A strategy hwin guardedBasis env n]
      change
        ((initialRightScanStep A
            (initialRightScanAfter A (initialRightLambdaOfStrategy strategy)
              (omegaPrefix env n))
            (initialRightLetterAt (initialRightLambdaOfStrategy strategy)
              (omegaPrefix env n) (env n)),
          some (initialRightGuardedSource A strategy hwin
            (omegaPrefix env n) (env n) (guardedBasis _ _)).1),
          true && decide
            ((initialRightGuardedSource A strategy hwin
              (omegaPrefix env n) (env n) (guardedBasis _ _)).1.1 =
                initialRightDelayedTarget A
                  (initialRightScanAfter A (initialRightLambdaOfStrategy strategy)
                    (omegaPrefix env n))
                  (initialRightLetterAt (initialRightLambdaOfStrategy strategy)
                    (omegaPrefix env n) (env n))) &&
            decide ((leftProfileGuardedAutomaton A
              (initialRightGuardedSource A strategy hwin
                (omegaPrefix env n) (env n) (guardedBasis _ _)).1.1
              (initialRightGuardedSource A strategy hwin
                (omegaPrefix env n) (env n) (guardedBasis _ _)).1.2).HasRationalRun) &&
            decide (guardedInitialRightOverlapOK A
              (guardedInitialRightPending A strategy hwin guardedBasis env n)
              (pairPlay
                (guardedInitialRightReceiverStrategy A strategy hwin guardedBasis)
                (initialRightSenderStrategy (initialRightLambdaOfStrategy strategy))
                env n))) = _
      have htarget :
          (initialRightGuardedSource A strategy hwin
            (omegaPrefix env n) (env n) (guardedBasis _ _)).1.1 =
              initialRightDelayedTarget A
                (initialRightScanAfter A (initialRightLambdaOfStrategy strategy)
                  (omegaPrefix env n))
                (initialRightLetterAt (initialRightLambdaOfStrategy strategy)
                  (omegaPrefix env n) (env n)) := rfl
      have hfeasible :
          (leftProfileGuardedAutomaton A
            (initialRightGuardedSource A strategy hwin
              (omegaPrefix env n) (env n) (guardedBasis _ _)).1.1
            (initialRightGuardedSource A strategy hwin
              (omegaPrefix env n) (env n) (guardedBasis _ _)).1.2).HasRationalRun :=
        (initialRightGuardedSource A strategy hwin
          (omegaPrefix env n) (env n) (guardedBasis _ _)).2
      have hoverlap := guardedInitialRight_overlapOK
        A strategy hwin guardedBasis env n
      rw [decide_eq_true htarget, decide_eq_true hfeasible,
        decide_eq_true hoverlap]
      simp only [Bool.true_and]
      rw [omegaPrefix_succ, initialRightScanAfter_append]
      rfl

