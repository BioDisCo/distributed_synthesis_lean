import DistributedSynthesis.Formalizations.Theorem.ThmStarConcurrentGame

/-!
# Readback of star game winners (F2)

A winning perfect-recall strategy of the star game induces a distributed
strategy of the real model whose executions are accepted on every
environment.  Because the star game's observations are constant, a star
strategy is a round-indexed stream of plan commitments; the induced
distributed strategy recomputes the arena dispatch from its local view:

* at a receiving round, the relay carries the partner's full pre-round
  view, so the process reconstructs the entire environment prefix
  (`reconstructPair`), replays the star run over it, and evaluates the
  committed `recv` table on the reached core -- without knowing the
  current round's `b_old` bit, which the table does not consume;
* at a blind round, the process folds its committed `enter`/`step`
  controls along its own view (`wAfterOne`), exactly the arena's private
  control.

The induced execution then coincides record-for-record with the star run
(`starReadback_executionPrefix`), the tracked automaton state is the run
of the objective automaton on the execution word, and the game's parity
value transfers to word acceptance.
-/

namespace DistributedSynthesis

universe u

variable {In₁ In₂ Out₁ Out₂ : Type u}

namespace DetParityAutomaton

variable {A : DetParityAutomaton.{u, u} (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
variable {W₁ W₂ : Type u}

/-! ### Round counts of views -/

namespace StarReadback

/-- The number of absorbed rounds of a view. -/
def viewRounds {p : Proc} : View In₁ In₂ p -> Nat
  | .empty _ => 0
  | .recv previous _ _ _ => viewRounds previous + 1
  | .noRecv previous _ => viewRounds previous + 1

/-- Structural size counting both branches of a received view.  Unlike
`viewRounds`, this strictly decreases along either pre-round view. -/
def viewTreeSize {p : Proc} : View In₁ In₂ p -> Nat
  | .empty _ => 1
  | .recv previous _ partner _ =>
      viewTreeSize previous + viewTreeSize partner + 1
  | .noRecv previous _ => viewTreeSize previous + 1

@[simp]
theorem viewTreeSize_recv {p : Proc} (previous : View In₁ In₂ p)
    (input : PSum In₁ In₂) (partner : View In₁ In₂ p.other)
    (partnerInput : PSum In₁ In₂) :
    viewTreeSize (.recv previous input partner partnerInput) =
      viewTreeSize previous + viewTreeSize partner + 1 :=
  rfl

@[simp]
theorem viewTreeSize_noRecv {p : Proc} (previous : View In₁ In₂ p)
    (input : PSum In₁ In₂) :
    viewTreeSize (.noRecv previous input) = viewTreeSize previous + 1 :=
  rfl

@[simp]
theorem viewRounds_currentView (p : Proc)
    (h : History In₁ In₂ Graph Out₁ Out₂) :
    viewRounds (currentView p h) = h.length := by
  induction h using List.reverseRecOn with
  | nil => cases p <;> rfl
  | append_singleton h r ih =>
      have happ : h ++ [r] = History.append h r := rfl
      cases p <;> rw [happ] <;>
        cases hg : r.graph <;>
          simp [currentView_one_append, currentView_two_append, hg,
            viewRounds, <- ih]

/-! ### Reconstructing the environment prefix from the two pre-views -/

/-- Reconstruct the environment prefix from the two processes' current
views.  The receipt-tag pair of each level determines the round graph;
the payloads carry the inputs.  On view pairs generated by a common
history this is exact (`reconstructPair_currentView`). -/
def reconstructPair :
    View In₁ In₂ Proc.one -> View In₁ In₂ Proc.two ->
      List (EnvironmentRound In₁ In₂)
  | .recv v₁ (PSum.inl i₁) _ (PSum.inr i₂), .noRecv v₂ _ =>
      reconstructPair v₁ v₂ ++ [⟨i₁, i₂, Graph.left⟩]
  | .noRecv v₁ (PSum.inl i₁), .recv v₂ (PSum.inr i₂) _ _ =>
      reconstructPair v₁ v₂ ++ [⟨i₁, i₂, Graph.right⟩]
  | .recv v₁ (PSum.inl i₁) _ (PSum.inr i₂), .recv v₂ _ _ _ =>
      reconstructPair v₁ v₂ ++ [⟨i₁, i₂, Graph.both⟩]
  | _, _ => []

/-- The environment projection of a history. -/
def environmentOf (h : History In₁ In₂ Graph Out₁ Out₂) :
    List (EnvironmentRound In₁ In₂) :=
  h.map fun r => ⟨r.inputOne, r.inputTwo, r.graph⟩

@[simp]
theorem environmentOf_append (h : History In₁ In₂ Graph Out₁ Out₂)
    (r : RoundRecord In₁ In₂ Graph Out₁ Out₂) :
    environmentOf (History.append h r) =
      environmentOf h ++ [⟨r.inputOne, r.inputTwo, r.graph⟩] := by
  simp [environmentOf, History.append]

/-- Reconstruction is exact on view pairs of a common history. -/
theorem reconstructPair_currentView (h : History In₁ In₂ Graph Out₁ Out₂) :
    reconstructPair (currentView Proc.one h) (currentView Proc.two h) =
      environmentOf h := by
  induction h using List.reverseRecOn with
  | nil =>
      have h1 :
          currentView Proc.one ([] : History In₁ In₂ Graph Out₁ Out₂) =
            View.empty Proc.one := rfl
      have h2 :
          currentView Proc.two ([] : History In₁ In₂ Graph Out₁ Out₂) =
            View.empty Proc.two := rfl
      rw [h1, h2]
      simp [reconstructPair, environmentOf]
  | append_singleton h r ih =>
      have happ : h ++ [r] = History.append h r := rfl
      rw [happ]
      cases hg : r.graph <;>
        simp [currentView_one_append, currentView_two_append, hg,
          reconstructPair, ih, environmentOf_append]

end StarReadback

/-! ### The star run over an environment stream -/

open StarReadback

variable (A) in
/-- The star state after `n` rounds under round-indexed plan streams. -/
def starRun (p₁ : Nat -> StarPlanOne (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (p₂ : Nat -> StarPlanTwo (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (env : EnvironmentSequence In₁ In₂) :
    Nat -> StarState (In₁ := In₁) (In₂ := In₂) A W₁ W₂
  | 0 => (starInitialCore (In₁ := In₁) (In₂ := In₂) A, none, none)
  | n + 1 => starNext (starRun p₁ p₂ env n) (p₁ n) (p₂ n) (env n)

variable (A) in
/-- The star state after a finite environment list, with an explicit
starting round index. -/
def starRunListFrom (p₁ : Nat -> StarPlanOne (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (p₂ : Nat -> StarPlanTwo (In₁ := In₁) (In₂ := In₂) A W₁ W₂) :
    Nat -> StarState (In₁ := In₁) (In₂ := In₂) A W₁ W₂ ->
      List (EnvironmentRound In₁ In₂) ->
      StarState (In₁ := In₁) (In₂ := In₂) A W₁ W₂
  | _, state, [] => state
  | k, state, round :: rest =>
      starRunListFrom p₁ p₂ (k + 1) (starNext state (p₁ k) (p₂ k) round) rest

variable (A) in
/-- The star state after a finite environment list. -/
def starRunList (p₁ : Nat -> StarPlanOne (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (p₂ : Nat -> StarPlanTwo (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (envs : List (EnvironmentRound In₁ In₂)) :
    StarState (In₁ := In₁) (In₂ := In₂) A W₁ W₂ :=
  starRunListFrom A p₁ p₂ 0
    (starInitialCore (In₁ := In₁) (In₂ := In₂) A, none, none) envs

theorem starRunListFrom_snoc
    (p₁ : Nat -> StarPlanOne (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (p₂ : Nat -> StarPlanTwo (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (envs : List (EnvironmentRound In₁ In₂))
    (round : EnvironmentRound In₁ In₂) :
    ∀ (k : Nat) (state : StarState (In₁ := In₁) (In₂ := In₂) A W₁ W₂),
      starRunListFrom A p₁ p₂ k state (envs ++ [round]) =
        starNext (starRunListFrom A p₁ p₂ k state envs)
          (p₁ (k + envs.length)) (p₂ (k + envs.length)) round := by
  induction envs with
  | nil => intro k state; simp [starRunListFrom]
  | cons head rest ih =>
      intro k state
      simp only [List.cons_append, starRunListFrom, ih, List.length_cons]
      congr 2 <;> omega

/-- The list run over the environment prefix agrees with the indexed run. -/
theorem starRunList_prefix
    (p₁ : Nat -> StarPlanOne (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (p₂ : Nat -> StarPlanTwo (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (env : EnvironmentSequence In₁ In₂) (n : Nat) :
    starRunList A p₁ p₂ ((List.range n).map env) = starRun A p₁ p₂ env n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [List.range_succ, List.map_append, List.map_singleton]
      rw [starRunList, starRunListFrom_snoc]
      simp only [List.length_map, List.length_range, Nat.zero_add]
      rw [<- starRunList, ih]
      rfl

/-! ### The readback strategy -/

variable (A) in
/-- The round record dispatched by the star arena at a state. -/
def starRecord (state : StarState (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (a₁ : StarPlanOne (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (a₂ : StarPlanTwo (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (round : EnvironmentRound In₁ In₂) :
    RoundRecord In₁ In₂ Graph Out₁ Out₂ where
  inputOne := round.inputOne
  inputTwo := round.inputTwo
  graph := round.graph
  outputOne := starOutputOne state.1 state.2.1 state.2.2 a₁ a₂ round
  outputTwo := starOutputTwo state.1 state.2.1 state.2.2 a₁ a₂ round

theorem starNext_state
    (state : StarState (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (a₁ : StarPlanOne (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (a₂ : StarPlanTwo (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (round : EnvironmentRound In₁ In₂) :
    (starNext state a₁ a₂ round).1.state =
      A.step state.1.state (starRecord A state a₁ a₂ round) :=
  rfl

/-- The private-control type indexed by the process whose view is folded. -/
def StarPrivateControl (W₁ W₂ : Type u) : Proc -> Type u
  | .one => W₁
  | .two => W₂

/-- Fold the appropriate private control over either process view.  At a
receive, the relayed partner view supplies the partner's pre-round control. -/
def starControlAfter (A : DetParityAutomaton.{u, u}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (p₁ : Nat -> StarPlanOne (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (p₂ : Nat -> StarPlanTwo (In₁ := In₁) (In₂ := In₂) A W₁ W₂) :
    {p : Proc} -> View In₁ In₂ p -> Option (StarPrivateControl W₁ W₂ p)
  | .one, .empty _ => none
  | .two, .empty _ => none
  | .one, .recv v₁ (PSum.inl i₁) v₂ (PSum.inr i₂) =>
      some ((p₁ (viewRounds v₁)).enter
        ((starControlAfter A p₁ p₂ v₁).getD (p₁ (viewRounds v₁)).init)
        ((starControlAfter A p₁ p₂ v₂).getD (p₂ (viewRounds v₁)).init)
        (starRunList A p₁ p₂ (reconstructPair v₁ v₂)).1 (i₁, i₂))
  | .one, .recv _ _ _ _ => none
  | .one, .noRecv v₁ (PSum.inl i₁) =>
      some ((p₁ (viewRounds v₁)).step
        ((starControlAfter A p₁ p₂ v₁).getD (p₁ (viewRounds v₁)).init) i₁)
  | .one, .noRecv _ _ => none
  | .two, .recv v₂ (PSum.inr i₂) v₁ (PSum.inl i₁) =>
      some ((p₂ (viewRounds v₂)).enter
        ((starControlAfter A p₁ p₂ v₂).getD (p₂ (viewRounds v₂)).init)
        ((starControlAfter A p₁ p₂ v₁).getD (p₁ (viewRounds v₂)).init)
        (starRunList A p₁ p₂ (reconstructPair v₁ v₂)).1 (i₂, i₁))
  | .two, .recv _ _ _ _ => none
  | .two, .noRecv v₂ (PSum.inr i₂) =>
      some ((p₂ (viewRounds v₂)).step
        ((starControlAfter A p₁ p₂ v₂).getD (p₂ (viewRounds v₂)).init) i₂)
  | .two, .noRecv _ _ => none
termination_by _ view => viewTreeSize view
decreasing_by all_goals simp [viewTreeSize]

/-- Process one's specialization of `starControlAfter`. -/
def wAfterOne (A : DetParityAutomaton.{u, u}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (p₁ : Nat -> StarPlanOne (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (p₂ : Nat -> StarPlanTwo (In₁ := In₁) (In₂ := In₂) A W₁ W₂) :
    View In₁ In₂ Proc.one -> Option W₁ :=
  starControlAfter A p₁ p₂

/-- Process two's specialization of `starControlAfter`. -/
def wAfterTwo (A : DetParityAutomaton.{u, u}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (p₁ : Nat -> StarPlanOne (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (p₂ : Nat -> StarPlanTwo (In₁ := In₁) (In₂ := In₂) A W₁ W₂) :
    View In₁ In₂ Proc.two -> Option W₂ :=
  starControlAfter A p₁ p₂

variable (A) in
/-- The distributed strategy induced by round-indexed plan streams: at a
receive, replay the star run over the reconstructed environment prefix
and read the committed `recv` table; while blind, fold the committed
private control along the own view and read the `blind` table. -/
def starReadback [Inhabited Out₁] [Inhabited Out₂]
    (p₁ : Nat -> StarPlanOne (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
    (p₂ : Nat -> StarPlanTwo (In₁ := In₁) (In₂ := In₂) A W₁ W₂) :
    StrategyPair In₁ In₂ Out₁ Out₂ where
  one := fun view =>
    match view with
    | .empty _ => default
    | .recv v₁ (PSum.inl i₁) v₂ (PSum.inr i₂) =>
        (p₁ (viewRounds v₁)).recv
          ((wAfterOne A p₁ p₂ v₁).getD (p₁ (viewRounds v₁)).init)
          ((wAfterTwo A p₁ p₂ v₂).getD (p₂ (viewRounds v₁)).init)
          (starRunList A p₁ p₂ (reconstructPair v₁ v₂)).1 (i₁, i₂)
    | .recv _ _ _ _ => default
    | .noRecv v₁ (PSum.inl i₁) =>
        (p₁ (viewRounds v₁)).blind
          ((wAfterOne A p₁ p₂ v₁).getD (p₁ (viewRounds v₁)).init) i₁
    | .noRecv _ _ => default
  two := fun view =>
    match view with
    | .empty _ => default
    | .recv v₂ (PSum.inr i₂) v₁ (PSum.inl i₁) =>
        (p₂ (viewRounds v₂)).recv
          ((wAfterTwo A p₁ p₂ v₂).getD (p₂ (viewRounds v₂)).init)
          ((wAfterOne A p₁ p₂ v₁).getD (p₁ (viewRounds v₂)).init)
          (starRunList A p₁ p₂ (reconstructPair v₁ v₂)).1 (i₂, i₁)
    | .recv _ _ _ _ => default
    | .noRecv v₂ (PSum.inr i₂) =>
        (p₂ (viewRounds v₂)).blind
          ((wAfterTwo A p₁ p₂ v₂).getD (p₂ (viewRounds v₂)).init) i₂
    | .noRecv _ _ => default

/-! ### The execution correspondence -/

section Correspondence

variable [Inhabited Out₁] [Inhabited Out₂]
variable (p₁ : Nat -> StarPlanOne (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
variable (p₂ : Nat -> StarPlanTwo (In₁ := In₁) (In₂ := In₂) A W₁ W₂)
variable (env : EnvironmentSequence In₁ In₂)

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- The environment projection of an execution prefix is the environment
prefix, for every strategy. -/
theorem environmentOf_executionPrefix
    (σ : StrategyPair In₁ In₂ Out₁ Out₂) (n : Nat) :
    environmentOf (executionPrefix σ env n) = (List.range n).map env := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [executionPrefix_succ, environmentOf_append, ih, List.range_succ,
        List.map_append, List.map_singleton]
      rfl

/-- The private-control invariant: the folds along the current views of
the readback execution equal the star run's private controls. -/
theorem wAfter_executionPrefix (n : Nat) :
    wAfterOne A p₁ p₂
        (currentView Proc.one
          (executionPrefix (starReadback A p₁ p₂) env n)) =
        (starRun A p₁ p₂ env n).2.1 ∧
      wAfterTwo A p₁ p₂
          (currentView Proc.two
            (executionPrefix (starReadback A p₁ p₂) env n)) =
        (starRun A p₁ p₂ env n).2.2 := by
  induction n with
  | zero =>
      constructor
      · have h1 :
            currentView Proc.one
                (executionPrefix (starReadback A p₁ p₂) env 0) =
              View.empty Proc.one := rfl
        rw [h1]
        simp [wAfterOne, starControlAfter, starRun]
        rfl
      · have h2 :
            currentView Proc.two
                (executionPrefix (starReadback A p₁ p₂) env 0) =
              View.empty Proc.two := rfl
        rw [h2]
        simp [wAfterTwo, starControlAfter, starRun]
        rfl
  | succ n ih =>
      have hround :
          viewRounds
              (currentView Proc.one
                (executionPrefix (starReadback A p₁ p₂) env n)) = n := by
        simp
      have hroundTwo :
          viewRounds
              (currentView Proc.two
                (executionPrefix (starReadback A p₁ p₂) env n)) = n := by
        simp
      have hrec :
          reconstructPair
              (currentView Proc.one
                (executionPrefix (starReadback A p₁ p₂) env n))
              (currentView Proc.two
                (executionPrefix (starReadback A p₁ p₂) env n)) =
            (List.range n).map env := by
        rw [reconstructPair_currentView, environmentOf_executionPrefix]
      have ihOne :
          starControlAfter A p₁ p₂
              (currentView Proc.one
                (executionPrefix (starReadback A p₁ p₂) env n)) =
            (starRun A p₁ p₂ env n).2.1 := by
        simpa only [wAfterOne] using ih.1
      have ihTwo :
          starControlAfter A p₁ p₂
              (currentView Proc.two
                (executionPrefix (starReadback A p₁ p₂) env n)) =
            (starRun A p₁ p₂ env n).2.2 := by
        simpa only [wAfterTwo] using ih.2
      have ihOneGetD (fallback : W₁) :
          (starControlAfter A p₁ p₂
              (currentView Proc.one
                (executionPrefix (starReadback A p₁ p₂) env n))).getD fallback =
            (starRun A p₁ p₂ env n).2.1.getD fallback :=
        congrArg (fun control => control.getD fallback) ihOne
      have ihTwoGetD (fallback : W₂) :
          (starControlAfter A p₁ p₂
              (currentView Proc.two
                (executionPrefix (starReadback A p₁ p₂) env n))).getD fallback =
            (starRun A p₁ p₂ env n).2.2.getD fallback :=
        congrArg (fun control => control.getD fallback) ihTwo
      have hcv1 :
          currentView Proc.one
              (executionPrefix (starReadback A p₁ p₂) env (n + 1)) =
            nextView Proc.one (executionPrefix (starReadback A p₁ p₂) env n)
              (env n) := by
        simp
      have hcv2 :
          currentView Proc.two
              (executionPrefix (starReadback A p₁ p₂) env (n + 1)) =
            nextView Proc.two (executionPrefix (starReadback A p₁ p₂) env n)
              (env n) := by
        simp
      rw [hcv1, hcv2]
      cases henv : (env n).graph
      · -- left round: one receives, two steps blind
        constructor
        · rw [show nextView Proc.one
                (executionPrefix (starReadback A p₁ p₂) env n) (env n) =
              View.recv
                (currentView Proc.one
                  (executionPrefix (starReadback A p₁ p₂) env n))
                (PSum.inl (env n).inputOne)
                (currentView Proc.two
                  (executionPrefix (starReadback A p₁ p₂) env n))
                (PSum.inr (env n).inputTwo) by
            simp [nextView, advanceViewsWithEnvironment, henv, currentView]]
          simp only [wAfterOne, wAfterTwo, starControlAfter, Proc.other, hround, hroundTwo,
            hrec, starRunList_prefix]
          rw [ihOneGetD, ihTwoGetD]
          show _ = (starNext (starRun A p₁ p₂ env n) (p₁ n) (p₂ n) (env n)).2.1
          simp [starNext, henv]
          rfl
        · rw [show nextView Proc.two
                (executionPrefix (starReadback A p₁ p₂) env n) (env n) =
              View.noRecv
                (currentView Proc.two
                  (executionPrefix (starReadback A p₁ p₂) env n))
                (PSum.inr (env n).inputTwo) by
            simp [nextView, advanceViewsWithEnvironment, henv, currentView]]
          simp only [wAfterTwo, starControlAfter, hroundTwo]
          rw [ihTwo]
          show _ = (starNext (starRun A p₁ p₂ env n) (p₁ n) (p₂ n) (env n)).2.2
          simp [starNext, henv]
          rfl
      · -- right round: one steps blind, two receives
        constructor
        · rw [show nextView Proc.one
                (executionPrefix (starReadback A p₁ p₂) env n) (env n) =
              View.noRecv
                (currentView Proc.one
                  (executionPrefix (starReadback A p₁ p₂) env n))
                (PSum.inl (env n).inputOne) by
            simp [nextView, advanceViewsWithEnvironment, henv, currentView]]
          simp only [wAfterOne, starControlAfter, hround]
          rw [ihOne]
          show _ = (starNext (starRun A p₁ p₂ env n) (p₁ n) (p₂ n) (env n)).2.1
          simp [starNext, henv]
          rfl
        · rw [show nextView Proc.two
                (executionPrefix (starReadback A p₁ p₂) env n) (env n) =
              View.recv
                (currentView Proc.two
                  (executionPrefix (starReadback A p₁ p₂) env n))
                (PSum.inr (env n).inputTwo)
                (currentView Proc.one
                  (executionPrefix (starReadback A p₁ p₂) env n))
                (PSum.inl (env n).inputOne) by
            simp [nextView, advanceViewsWithEnvironment, henv, currentView]]
          simp only [wAfterOne, wAfterTwo, starControlAfter, Proc.other, hround, hroundTwo,
            hrec, starRunList_prefix]
          rw [ihOneGetD, ihTwoGetD]
          show _ = (starNext (starRun A p₁ p₂ env n) (p₁ n) (p₂ n) (env n)).2.2
          simp [starNext, henv]
          rfl
      · -- both round: both receive
        constructor
        · rw [show nextView Proc.one
                (executionPrefix (starReadback A p₁ p₂) env n) (env n) =
              View.recv
                (currentView Proc.one
                  (executionPrefix (starReadback A p₁ p₂) env n))
                (PSum.inl (env n).inputOne)
                (currentView Proc.two
                  (executionPrefix (starReadback A p₁ p₂) env n))
                (PSum.inr (env n).inputTwo) by
            simp [nextView, advanceViewsWithEnvironment, henv, currentView]]
          simp only [wAfterOne, wAfterTwo, starControlAfter, Proc.other, hround, hroundTwo,
            hrec, starRunList_prefix]
          rw [ihOneGetD, ihTwoGetD]
          show _ = (starNext (starRun A p₁ p₂ env n) (p₁ n) (p₂ n) (env n)).2.1
          simp [starNext, henv]
          rfl
        · rw [show nextView Proc.two
                (executionPrefix (starReadback A p₁ p₂) env n) (env n) =
              View.recv
                (currentView Proc.two
                  (executionPrefix (starReadback A p₁ p₂) env n))
                (PSum.inr (env n).inputTwo)
                (currentView Proc.one
                  (executionPrefix (starReadback A p₁ p₂) env n))
                (PSum.inl (env n).inputOne) by
            simp [nextView, advanceViewsWithEnvironment, henv, currentView]]
          simp only [wAfterOne, wAfterTwo, starControlAfter, Proc.other, hround, hroundTwo,
            hrec, starRunList_prefix]
          rw [ihOneGetD, ihTwoGetD]
          show _ = (starNext (starRun A p₁ p₂ env n) (p₁ n) (p₂ n) (env n)).2.2
          simp [starNext, henv]
          rfl

/-- The readback's next round is the record dispatched by the star arena. -/
theorem nextRound_starReadback (n : Nat) :
    nextRound (starReadback A p₁ p₂)
        (executionPrefix (starReadback A p₁ p₂) env n) (env n) =
      starRecord A (starRun A p₁ p₂ env n) (p₁ n) (p₂ n) (env n) := by
  have hround :
      viewRounds
          (currentView Proc.one
            (executionPrefix (starReadback A p₁ p₂) env n)) = n := by
    simp
  have hroundTwo :
      viewRounds
          (currentView Proc.two
            (executionPrefix (starReadback A p₁ p₂) env n)) = n := by
    simp
  have hrec :
      reconstructPair
          (currentView Proc.one
            (executionPrefix (starReadback A p₁ p₂) env n))
          (currentView Proc.two
            (executionPrefix (starReadback A p₁ p₂) env n)) =
        (List.range n).map env := by
    rw [reconstructPair_currentView, environmentOf_executionPrefix]
  have hw := wAfter_executionPrefix p₁ p₂ env n
  have hout1 :
      (starReadback A p₁ p₂).one
          (nextView Proc.one (executionPrefix (starReadback A p₁ p₂) env n)
            (env n)) =
        starOutputOne (starRun A p₁ p₂ env n).1
          (starRun A p₁ p₂ env n).2.1 (starRun A p₁ p₂ env n).2.2
          (p₁ n) (p₂ n) (env n) := by
    cases henv : (env n).graph
    · rw [show nextView Proc.one
            (executionPrefix (starReadback A p₁ p₂) env n) (env n) =
          View.recv
            (currentView Proc.one
              (executionPrefix (starReadback A p₁ p₂) env n))
            (PSum.inl (env n).inputOne)
            (currentView Proc.two
              (executionPrefix (starReadback A p₁ p₂) env n))
            (PSum.inr (env n).inputTwo) by
        simp [nextView, advanceViewsWithEnvironment, henv, currentView]]
      show (p₁ (viewRounds (currentView Proc.one
              (executionPrefix (starReadback A p₁ p₂) env n)))).recv _ _ _ _ = _
      rw [hround, hrec, starRunList_prefix, hw.1, hw.2]
      simp [starOutputOne, henv]
    · rw [show nextView Proc.one
            (executionPrefix (starReadback A p₁ p₂) env n) (env n) =
          View.noRecv
            (currentView Proc.one
              (executionPrefix (starReadback A p₁ p₂) env n))
            (PSum.inl (env n).inputOne) by
        simp [nextView, advanceViewsWithEnvironment, henv, currentView]]
      show (p₁ (viewRounds (currentView Proc.one
              (executionPrefix (starReadback A p₁ p₂) env n)))).blind _ _ = _
      rw [hround, hw.1]
      simp [starOutputOne, henv]
    · rw [show nextView Proc.one
            (executionPrefix (starReadback A p₁ p₂) env n) (env n) =
          View.recv
            (currentView Proc.one
              (executionPrefix (starReadback A p₁ p₂) env n))
            (PSum.inl (env n).inputOne)
            (currentView Proc.two
              (executionPrefix (starReadback A p₁ p₂) env n))
            (PSum.inr (env n).inputTwo) by
        simp [nextView, advanceViewsWithEnvironment, henv, currentView]]
      show (p₁ (viewRounds (currentView Proc.one
              (executionPrefix (starReadback A p₁ p₂) env n)))).recv _ _ _ _ = _
      rw [hround, hrec, starRunList_prefix, hw.1, hw.2]
      simp [starOutputOne, henv]
  have hout2 :
      (starReadback A p₁ p₂).two
          (nextView Proc.two (executionPrefix (starReadback A p₁ p₂) env n)
            (env n)) =
        starOutputTwo (starRun A p₁ p₂ env n).1
          (starRun A p₁ p₂ env n).2.1 (starRun A p₁ p₂ env n).2.2
          (p₁ n) (p₂ n) (env n) := by
    cases henv : (env n).graph
    · rw [show nextView Proc.two
            (executionPrefix (starReadback A p₁ p₂) env n) (env n) =
          View.noRecv
            (currentView Proc.two
              (executionPrefix (starReadback A p₁ p₂) env n))
            (PSum.inr (env n).inputTwo) by
        simp [nextView, advanceViewsWithEnvironment, henv, currentView]]
      show (p₂ (viewRounds (currentView Proc.two
              (executionPrefix (starReadback A p₁ p₂) env n)))).blind _ _ = _
      rw [hroundTwo, hw.2]
      simp [starOutputTwo, henv]
    · rw [show nextView Proc.two
            (executionPrefix (starReadback A p₁ p₂) env n) (env n) =
          View.recv
            (currentView Proc.two
              (executionPrefix (starReadback A p₁ p₂) env n))
            (PSum.inr (env n).inputTwo)
            (currentView Proc.one
              (executionPrefix (starReadback A p₁ p₂) env n))
            (PSum.inl (env n).inputOne) by
        simp [nextView, advanceViewsWithEnvironment, henv, currentView]]
      show (p₂ (viewRounds (currentView Proc.two
              (executionPrefix (starReadback A p₁ p₂) env n)))).recv _ _ _ _ = _
      rw [hroundTwo, hrec, starRunList_prefix, hw.1, hw.2]
      simp [starOutputTwo, henv]
    · rw [show nextView Proc.two
            (executionPrefix (starReadback A p₁ p₂) env n) (env n) =
          View.recv
            (currentView Proc.two
              (executionPrefix (starReadback A p₁ p₂) env n))
            (PSum.inr (env n).inputTwo)
            (currentView Proc.one
              (executionPrefix (starReadback A p₁ p₂) env n))
            (PSum.inl (env n).inputOne) by
        simp [nextView, advanceViewsWithEnvironment, henv, currentView]]
      show (p₂ (viewRounds (currentView Proc.two
              (executionPrefix (starReadback A p₁ p₂) env n)))).recv _ _ _ _ = _
      rw [hroundTwo, hrec, starRunList_prefix, hw.1, hw.2]
      simp [starOutputTwo, henv]
  simp [nextRound, starRecord, hout1, hout2]

/-- The tracked automaton state of the star run is the objective
automaton's run on the readback execution. -/
theorem starRun_state_eq_run (n : Nat) :
    (starRun A p₁ p₂ env n).1.state =
      A.run (execution (starReadback A p₁ p₂) env) n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      show (starNext (starRun A p₁ p₂ env n) (p₁ n) (p₂ n) (env n)).1.state = _
      rw [starNext_state, ih, run_succ]
      congr 1
      rw [execution_apply, nextRound_starReadback]

end Correspondence

/-! ### From star game winners to realizing distributed strategies -/

section Main

variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
variable [DecidableEq In₁] [DecidableEq In₂]
variable [Fintype A.State] [DecidableEq A.State]
variable [Fintype W₁] [DecidableEq W₁] [Fintype W₂] [DecidableEq W₂]
variable [Inhabited Out₁] [Inhabited Out₂]

/-- The round-indexed plan stream of a star game strategy for process
one: with constant observations, the strategy is a function of the round
number alone. -/
def gamePlanOne
    (s : (A.starGame (In₁ := In₁) (In₂ := In₂) W₁ W₂).HistoryProductStrategy) :
    Nat -> StarPlanOne (In₁ := In₁) (In₂ := In₂) A W₁ W₂ :=
  fun n => s.1 (List.replicate (n + 1) PUnit.unit)

/-- The round-indexed plan stream of a star game strategy for process two. -/
def gamePlanTwo
    (s : (A.starGame (In₁ := In₁) (In₂ := In₂) W₁ W₂).HistoryProductStrategy) :
    Nat -> StarPlanTwo (In₁ := In₁) (In₂ := In₂) A W₁ W₂ :=
  fun n => s.2 (List.replicate (n + 1) PUnit.unit)

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- The game's strategy-generated state sequence is the star run of the
round-indexed plan streams, with constant observation lists. -/
theorem strategyState_starGame
    (s : (A.starGame (In₁ := In₁) (In₂ := In₂) W₁ W₂).HistoryProductStrategy)
    (nature : EnvironmentSequence In₁ In₂) (n : Nat) :
    FiniteConcurrentGame.strategyState
        (G := A.starGame (In₁ := In₁) (In₂ := In₂) W₁ W₂) s nature n =
      (starRun A (gamePlanOne s) (gamePlanTwo s) nature n,
        List.replicate (n + 1) PUnit.unit,
        List.replicate (n + 1) PUnit.unit) := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [FiniteConcurrentGame.strategyState, ih]
      refine congrArg₂ _ ?_ (congrArg₂ _ ?_ ?_)
      · rfl
      · show List.replicate (n + 1) PUnit.unit ++ [PUnit.unit] = _
        rw [<- List.replicate_succ' (n := n + 1)]
      · show List.replicate (n + 1) PUnit.unit ++ [PUnit.unit] = _
        rw [<- List.replicate_succ' (n := n + 1)]

/--
**F2: readback of star game winners.**  If the star game is realizable by
a perfect-recall strategy, the induced distributed strategy realizes the
objective on every environment: the readback execution coincides with the
star run record-for-record, and the game's parity value is acceptance of
the execution word.
-/
theorem exists_realizing_of_starGame_historyRealizable
    (h : (A.starGame (In₁ := In₁) (In₂ := In₂) W₁ W₂).HistoryRealizable) :
    ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      ∀ env : EnvironmentSequence In₁ In₂, A.Accepts (execution σ env) := by
  classical
  obtain ⟨s, hs⟩ := h
  refine ⟨starReadback A (gamePlanOne s) (gamePlanTwo s), ?_⟩
  intro env
  obtain ⟨p, hp2, hinf, hmin⟩ := hs env
  have hprio :
      ∀ n : Nat,
        (A.starGame (In₁ := In₁) (In₂ := In₂) W₁ W₂).priority
            (FiniteConcurrentGame.strategyState
              (G := A.starGame (In₁ := In₁) (In₂ := In₂) W₁ W₂) s env n).1 =
          A.priority
            (A.run
              (execution (starReadback A (gamePlanOne s) (gamePlanTwo s)) env)
              n) := by
    intro n
    rw [strategyState_starGame]
    show A.priority (starRun A (gamePlanOne s) (gamePlanTwo s) env n).1.state = _
    rw [starRun_state_eq_run]
  refine ⟨p, ⟨p / 2, by omega⟩, ?_, ?_⟩
  · intro n
    obtain ⟨k, hk, hkp⟩ := hinf n
    refine ⟨k, hk, ?_⟩
    show A.priority (A.runFrom A.initial _ k) = p
    rw [show A.runFrom A.initial
          (execution (starReadback A (gamePlanOne s) (gamePlanTwo s)) env) k =
        A.run (execution (starReadback A (gamePlanOne s) (gamePlanTwo s)) env)
          k from rfl, <- hprio k]
    exact hkp
  · intro q hq
    refine hmin q ?_
    intro n
    obtain ⟨k, hk, hkq⟩ := hq n
    refine ⟨k, hk, ?_⟩
    show (A.starGame (In₁ := In₁) (In₂ := In₂) W₁ W₂).priority
        (FiniteConcurrentGame.strategyState
          (G := A.starGame (In₁ := In₁) (In₂ := In₂) W₁ W₂) s env k).1 = q
    rw [hprio k]
    exact hkq

end Main

