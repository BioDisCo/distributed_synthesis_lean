import DistributedSynthesis.Formalizations.Theorem.ThmPairedProfiledEndToEndInitialRegularization
import DistributedSynthesis.Formalizations.Theorem.ThmPairedProfiledEndToEndOperationalPairClosure
import DistributedSynthesis.Formalizations.Theorem.ThmRootPinnedBlockNarrowing

/-!
# One finite controller package for the complete end-to-end readback

This record joins the common rational forest policy to the two finite initial
streaming controllers.  All post-initial controllers are already finite
functions of its `rational` field, so no further strategy or policy choice is
needed at runtime.
-/

namespace DistributedSynthesis

universe u v x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

noncomputable section

variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
variable [DecidableEq In₁] [DecidableEq In₂]

open PairedStrategyMemory
open PairedStrategyMemory.PairedInitialProfiledRationalPackage

/-- The complete first left-initial record retained by the common rational
package.  Pinning this finite record survives sender narrowing. -/
def endToEndInitialLeftExpected
    (package : PairedInitialProfiledRationalPackage A)
    (move : In₁ × In₂) : RealizedBlockRound In₁ In₂
      (EndToEndInitialLeftReceiverOutput A) Out₂ :=
  (move, package.endToEndInitialLeftReceiverStrategy A [] move,
    initialLeftSenderStrategy package.left [] move.2)

/-- Right-initial mirror. -/
def endToEndInitialRightExpected
    (package : PairedInitialProfiledRationalPackage A)
    (move : In₂ × In₁) : RealizedBlockRound In₂ In₁
      (EndToEndInitialRightReceiverOutput A) Out₁ :=
  (move, package.endToEndInitialRightReceiverStrategy A [] move,
    initialRightSenderStrategy package.right [] move.2)

noncomputable abbrev endToEndInitialLeftPinnedMonitor
    (package : PairedInitialProfiledRationalPackage A) :=
  (endToEndInitialLeftBlockMonitor A package).rootPinned
    (endToEndInitialLeftExpected A package)

noncomputable abbrev endToEndInitialRightPinnedMonitor
    (package : PairedInitialProfiledRationalPackage A) :=
  (endToEndInitialRightBlockMonitor A package).rootPinned
    (endToEndInitialRightExpected A package)

/-- The single finite package selected once from a winning strategy. -/
structure EndToEndOperationalControllerPackage where
  rational : PairedInitialProfiledRationalPackage A
  leftController :
    TransitionRationalTree.{v, max u v x y s, max u v x y s}
      In₂ (NarrowedBlockLabel In₁ In₂
        (EndToEndInitialLeftReceiverOutput A) Out₂
        (endToEndInitialLeftPinnedMonitor A rational).State)
  leftWins : NarrowedAllThreadsWin
    (endToEndInitialLeftPinnedMonitor A rational) leftController.labeledTree
  rightController :
    TransitionRationalTree.{u, max u v x y s, max u v x y s}
      In₁ (NarrowedBlockLabel In₂ In₁
        (EndToEndInitialRightReceiverOutput A) Out₁
        (endToEndInitialRightPinnedMonitor A rational).State)
  rightWins : NarrowedAllThreadsWin
    (endToEndInitialRightPinnedMonitor A rational) rightController.labeledTree

/-- Concrete left-initial word generated by the pinned controller. -/
def EndToEndOperationalControllerPackage.leftInitialPlay
    (bundle : EndToEndOperationalControllerPackage A)
    (env : Nat -> In₁ × In₂) :
    Nat -> RealizedBlockRound In₁ In₂
      (EndToEndInitialLeftReceiverOutput A) Out₂ :=
  treePlay
    (narrowedInducedTree
      (endToEndInitialLeftPinnedMonitor A bundle.rational)
      bundle.leftController.labeledTree) env

/-- Concrete right-initial word generated by the pinned controller. -/
def EndToEndOperationalControllerPackage.rightInitialPlay
    (bundle : EndToEndOperationalControllerPackage A)
    (env : Nat -> In₂ × In₁) :
    Nat -> RealizedBlockRound In₂ In₁
      (EndToEndInitialRightReceiverOutput A) Out₁ :=
  treePlay
    (narrowedInducedTree
      (endToEndInitialRightPinnedMonitor A bundle.rational)
      bundle.rightController.labeledTree) env

section
omit [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]

/-- The pinned left controller wins its pinned monitor on every input word. -/
theorem EndToEndOperationalControllerPackage.leftInitialPlay_pinned_wins
    (bundle : EndToEndOperationalControllerPackage A)
    (env : Nat -> In₁ × In₂) :
    (endToEndInitialLeftPinnedMonitor A bundle.rational).WinsPlay
      (bundle.leftInitialPlay A env) := by
  let monitor := endToEndInitialLeftPinnedMonitor A bundle.rational
  let tree := narrowedInducedTree monitor bundle.leftController.labeledTree
  have htree := narrowedInducedTree_winningTree_of_allThreadsWin monitor
    bundle.leftWins
  exact (monitor.lift_winningTree_iff tree).mp htree env

/-- Removing the root pin recovers the original left monitor invariant. -/
theorem EndToEndOperationalControllerPackage.leftInitialPlay_wins
    (bundle : EndToEndOperationalControllerPackage A)
    (env : Nat -> In₁ × In₂) :
    (endToEndInitialLeftBlockMonitor A bundle.rational).WinsPlay
      (bundle.leftInitialPlay A env) :=
  (endToEndInitialLeftBlockMonitor A bundle.rational).rootPinned_base_wins_of_wins
    (endToEndInitialLeftExpected A bundle.rational)
    (bundle.leftInitialPlay A env)
    (bundle.leftInitialPlay_pinned_wins A env)

/-- Right-initial mirror. -/
theorem EndToEndOperationalControllerPackage.rightInitialPlay_pinned_wins
    (bundle : EndToEndOperationalControllerPackage A)
    (env : Nat -> In₂ × In₁) :
    (endToEndInitialRightPinnedMonitor A bundle.rational).WinsPlay
      (bundle.rightInitialPlay A env) := by
  let monitor := endToEndInitialRightPinnedMonitor A bundle.rational
  let tree := narrowedInducedTree monitor bundle.rightController.labeledTree
  have htree := narrowedInducedTree_winningTree_of_allThreadsWin monitor
    bundle.rightWins
  exact (monitor.lift_winningTree_iff tree).mp htree env

theorem EndToEndOperationalControllerPackage.rightInitialPlay_wins
    (bundle : EndToEndOperationalControllerPackage A)
    (env : Nat -> In₂ × In₁) :
    (endToEndInitialRightBlockMonitor A bundle.rational).WinsPlay
      (bundle.rightInitialPlay A env) :=
  (endToEndInitialRightBlockMonitor A bundle.rational).rootPinned_base_wins_of_wins
    (endToEndInitialRightExpected A bundle.rational)
    (bundle.rightInitialPlay A env)
    (bundle.rightInitialPlay_pinned_wins A env)

/-- Every staged left boundary emitted by the pinned controller is a genuine
source in the one common rational policy. -/
theorem EndToEndOperationalControllerPackage.leftInitialPlay_sourceOK
    (bundle : EndToEndOperationalControllerPackage A)
    (env : Nat -> In₁ × In₂) (n : Nat) :
    endToEndInitialLeftSourceOK A bundle.rational
      ((endToEndInitialLeftBlockMonitor A bundle.rational).run
        (bundle.leftInitialPlay A env) n).1.1
      (endToEndInitialLeftPhysicalLetter A (bundle.leftInitialPlay A env n))
      (bundle.leftInitialPlay A env n).2.1.2 :=
  endToEndInitialLeft_sourceOK_of_wins A bundle.rational _
    (bundle.leftInitialPlay_wins A env) n

theorem EndToEndOperationalControllerPackage.leftInitialPlay_overlapOK
    (bundle : EndToEndOperationalControllerPackage A)
    (env : Nat -> In₁ × In₂) (n : Nat) :
    endToEndInitialLeftOverlapOK A
      ((endToEndInitialLeftBlockMonitor A bundle.rational).run
        (bundle.leftInitialPlay A env) n).1.2
      (bundle.leftInitialPlay A env n) :=
  endToEndInitialLeft_overlapOK_of_wins A bundle.rational _
    (bundle.leftInitialPlay_wins A env) n

/-- Right-initial mirror. -/
theorem EndToEndOperationalControllerPackage.rightInitialPlay_sourceOK
    (bundle : EndToEndOperationalControllerPackage A)
    (env : Nat -> In₂ × In₁) (n : Nat) :
    endToEndInitialRightSourceOK A bundle.rational
      ((endToEndInitialRightBlockMonitor A bundle.rational).run
        (bundle.rightInitialPlay A env) n).1.1
      (endToEndInitialRightPhysicalLetter A (bundle.rightInitialPlay A env n))
      (bundle.rightInitialPlay A env n).2.1.2 :=
  endToEndInitialRight_sourceOK_of_wins A bundle.rational _
    (bundle.rightInitialPlay_wins A env) n

theorem EndToEndOperationalControllerPackage.rightInitialPlay_overlapOK
    (bundle : EndToEndOperationalControllerPackage A)
    (env : Nat -> In₂ × In₁) (n : Nat) :
    endToEndInitialRightOverlapOK A
      ((endToEndInitialRightBlockMonitor A bundle.rational).run
        (bundle.rightInitialPlay A env) n).1.2
      (bundle.rightInitialPlay A env n) :=
  endToEndInitialRight_overlapOK_of_wins A bundle.rational _
    (bundle.rightInitialPlay_wins A env) n

/-- If no reversal ever occurs, the extracted initial controllers already
realize the objective in their respective orientations. -/
theorem EndToEndOperationalControllerPackage.leftInitialPlay_accepts
    (bundle : EndToEndOperationalControllerPackage A)
    (env : Nat -> In₁ × In₂) :
    A.Accepts (endToEndInitialLeftPlayWord A (bundle.leftInitialPlay A env)) :=
  endToEndInitialLeftPlay_accepts_of_wins A bundle.rational _
    (bundle.leftInitialPlay_wins A env)

theorem EndToEndOperationalControllerPackage.rightInitialPlay_accepts
    (bundle : EndToEndOperationalControllerPackage A)
    (env : Nat -> In₂ × In₁) :
    A.Accepts (endToEndInitialRightPlayWord A (bundle.rightInitialPlay A env)) :=
  endToEndInitialRightPlay_accepts_of_wins A bundle.rational _
    (bundle.rightInitialPlay_wins A env)

end

/-- The common package admits a finite left controller with its complete root
record pinned. -/
theorem exists_endToEndInitialLeftPinnedController
    (package : PairedInitialProfiledRationalPackage A) :
    ∃ controller : TransitionRationalTree.{v, max u v x y s, max u v x y s}
      In₂ (NarrowedBlockLabel In₁ In₂
        (EndToEndInitialLeftReceiverOutput A) Out₂
        (endToEndInitialLeftPinnedMonitor A package).State),
      NarrowedAllThreadsWin (endToEndInitialLeftPinnedMonitor A package)
        controller.labeledTree := by
  classical
  let rootState := package.initialLeftBankState A [] (default, default)
  letI : Inhabited (PairedInitialProfiledBankState A) := ⟨rootState⟩
  letI : Inhabited (EndToEndInitialLeftReceiverOutput A) := inferInstance
  apply (block_realizable_iff_implementable_controller_unconditional
    (endToEndInitialLeftPinnedMonitor A package)).mp
  refine ⟨package.endToEndInitialLeftReceiverStrategy A,
    initialLeftSenderStrategy package.left, ?_⟩
  apply (endToEndInitialLeftBlockMonitor A package).rootPinned_realizable
    (endToEndInitialLeftExpected A package)
  · exact package.endToEndInitialLeftBlockMonitor_wins A
  · intro move
    rfl

/-- Right-initial pinned controller. -/
theorem exists_endToEndInitialRightPinnedController
    (package : PairedInitialProfiledRationalPackage A) :
    ∃ controller : TransitionRationalTree.{u, max u v x y s, max u v x y s}
      In₁ (NarrowedBlockLabel In₂ In₁
        (EndToEndInitialRightReceiverOutput A) Out₁
        (endToEndInitialRightPinnedMonitor A package).State),
      NarrowedAllThreadsWin (endToEndInitialRightPinnedMonitor A package)
        controller.labeledTree := by
  classical
  let rootState := package.initialRightBankState A [] (default, default)
  letI : Inhabited (PairedInitialProfiledBankState A) := ⟨rootState⟩
  letI : Inhabited (EndToEndInitialRightReceiverOutput A) := inferInstance
  apply (block_realizable_iff_implementable_controller_unconditional
    (endToEndInitialRightPinnedMonitor A package)).mp
  refine ⟨package.endToEndInitialRightReceiverStrategy A,
    initialRightSenderStrategy package.right, ?_⟩
  apply (endToEndInitialRightBlockMonitor A package).rootPinned_realizable
    (endToEndInitialRightExpected A package)
  · exact package.endToEndInitialRightBlockMonitor_wins A
  · intro move
    rfl

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- The independently finite pinned controllers retain the process-one root
compatibility stored by the common outer rationalization. -/
theorem EndToEndOperationalControllerPackage.root_outputOne
    (bundle : EndToEndOperationalControllerPackage A)
    (move : In₁ × In₂) :
    ((bundle.leftController.labelOf bundle.leftController.initial).2
      (endToEndInitialLeftPinnedMonitor A bundle.rational).initial move).1.informedOne =
    ((bundle.rightController.labelOf bundle.rightController.initial).2
      (endToEndInitialRightPinnedMonitor A bundle.rational).initial
        (move.2, move.1)).1.reversingOne := by
  have hleft := (endToEndInitialLeftBlockMonitor A bundle.rational).rootPinned_root_record
    (endToEndInitialLeftExpected A bundle.rational)
    bundle.leftController.labeledTree bundle.leftWins move
  have hright := (endToEndInitialRightBlockMonitor A bundle.rational).rootPinned_root_record
    (endToEndInitialRightExpected A bundle.rational)
    bundle.rightController.labeledTree bundle.rightWins (move.2, move.1)
  have hleftOut := congrArg (fun letter => letter.2.1.1.informedOne) hleft
  have hrightOut := congrArg (fun letter => letter.2.1.1.reversingOne) hright
  have hleftOut' :
      ((bundle.leftController.labelOf bundle.leftController.initial).2
        (endToEndInitialLeftPinnedMonitor A bundle.rational).initial move).1.informedOne =
        bundle.rational.left.informedOne [] move := by
    simpa [narrowedRecord, TransitionRationalTree.labeledTree,
      TransitionRationalTree.controlAt, endToEndInitialLeftExpected] using hleftOut
  have hrightOut' :
      ((bundle.rightController.labelOf bundle.rightController.initial).2
        (endToEndInitialRightPinnedMonitor A bundle.rational).initial
          (move.2, move.1)).1.reversingOne =
        bundle.rational.right.reversingOne [] (move.2, move.1) := by
    simpa [narrowedRecord, TransitionRationalTree.labeledTree,
      TransitionRationalTree.controlAt, endToEndInitialRightExpected] using hrightOut
  rw [hleftOut', hrightOut']
  exact bundle.rational.rootOutputOne move

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- Process-two root compatibility. -/
theorem EndToEndOperationalControllerPackage.root_outputTwo
    (bundle : EndToEndOperationalControllerPackage A)
    (move : In₁ × In₂) :
    ((bundle.leftController.labelOf bundle.leftController.initial).2
      (endToEndInitialLeftPinnedMonitor A bundle.rational).initial move).1.reversingTwo =
    ((bundle.rightController.labelOf bundle.rightController.initial).2
      (endToEndInitialRightPinnedMonitor A bundle.rational).initial
        (move.2, move.1)).1.informedTwo := by
  have hleft := (endToEndInitialLeftBlockMonitor A bundle.rational).rootPinned_root_record
    (endToEndInitialLeftExpected A bundle.rational)
    bundle.leftController.labeledTree bundle.leftWins move
  have hright := (endToEndInitialRightBlockMonitor A bundle.rational).rootPinned_root_record
    (endToEndInitialRightExpected A bundle.rational)
    bundle.rightController.labeledTree bundle.rightWins (move.2, move.1)
  have hleftOut := congrArg (fun letter => letter.2.1.1.reversingTwo) hleft
  have hrightOut := congrArg (fun letter => letter.2.1.1.informedTwo) hright
  have hleftOut' :
      ((bundle.leftController.labelOf bundle.leftController.initial).2
        (endToEndInitialLeftPinnedMonitor A bundle.rational).initial move).1.reversingTwo =
        bundle.rational.left.reversingTwo [] move := by
    simpa [narrowedRecord, TransitionRationalTree.labeledTree,
      TransitionRationalTree.controlAt, endToEndInitialLeftExpected] using hleftOut
  have hrightOut' :
      ((bundle.rightController.labelOf bundle.rightController.initial).2
        (endToEndInitialRightPinnedMonitor A bundle.rational).initial
          (move.2, move.1)).1.informedTwo =
        bundle.rational.right.informedTwo [] (move.2, move.1) := by
    simpa [narrowedRecord, TransitionRationalTree.labeledTree,
      TransitionRationalTree.controlAt, endToEndInitialRightExpected] using hrightOut
  rw [hleftOut', hrightOut']
  exact bundle.rational.rootOutputTwo move

/-- A winning perfect-recall strategy and the one input-free rational-run
basis select the complete finite controller package in one shot. -/
theorem nonempty_endToEndOperationalControllerPackage_of_winning
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : (pairedInitialProfiledForestAutomaton A).RationalRunBasis) :
    Nonempty (EndToEndOperationalControllerPackage A) := by
  rcases exists_endToEndInitialControllers_of_winning A strategy hwin basis with
    ⟨rational, _, _⟩
  rcases exists_endToEndInitialLeftPinnedController A rational with
    ⟨leftController, leftWins⟩
  rcases exists_endToEndInitialRightPinnedController A rational with
    ⟨rightController, rightWins⟩
  exact ⟨⟨rational, leftController, leftWins, rightController, rightWins⟩⟩

end

end DetParityAutomaton

end DistributedSynthesis
