import DistributedSynthesis.Formalizations.Theorem.ThmAPAAlternationRemoval
import DistributedSynthesis.Library.Automata.AlternatingSupport
import DistributedSynthesis.Formalizations.Theorem.ThmFiniteWidthStreettRanking

/-!
# Miyano-Hayashi breakpoint construction, internalization layer

This file starts the axiom-free internalization of the standard
Miyano-Hayashi alternation-removal proof.

The checked material below is the Büchi breakpoint core.  It is the base
construction from Miyano-Hayashi: a nondeterministic run stores the current
frontier of alternating states and a finite breakpoint set of states that still
owe a visit to the Büchi accepting set.  When the breakpoint set is empty a new
checkpoint starts from the current frontier; otherwise it is propagated through
the same timed support choices as the frontier.  Büchi accepting states are
exactly the empty-breakpoint summaries.

For the parity theorem in `ThmAPAAlternationRemoval.lean`, this core is not by
itself enough.  The remaining literature layer is the ranking/Streett monitor
that turns the finite odd-priority Streett chain into finitely many such
breakpoint clearances without imposing a false response obligation on finite
one-shot odd priorities.
-/

namespace DistributedSynthesis

universe u v

namespace AlternatingParityAutomaton

namespace MiyanoHayashi

/--
The timed leveled graph induced by a sequence of APA macro-support choices.

This is the graph object used by the Miyano-Hayashi/Vardi-Wolper ranking
argument: an edge exists only at the level where the corresponding support
choice actually contains it.
-/
def supportChoiceLeveledGraph
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (frontier : Nat -> Finset A.State)
    (word : OmegaWord Alphabet)
    (supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)) :
    FiniteWidthStreett.LeveledGraph A.State where
  edge n source target :=
    ∃ hsource : source ∈ frontier n,
      target ∈ ((supportChoice n).choice ⟨source, hsource⟩).support

/-- Request predicate for the Streett pair generated by one odd priority. -/
def priorityRequest
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (priority : Nat)
    (state : A.State) :
    Prop :=
  A.priority state = priority

/-- Grant predicate for the Streett pair generated by one odd priority. -/
def priorityGrant
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (priority : Nat)
    (state : A.State) :
    Prop :=
  A.priority state < priority

/--
Odd-ranking certificates for one priority Streett pair on a timed APA support
graph.  This is an abbreviation of the reusable finite-width graph certificate.
-/
abbrev PriorityRankingCertificate
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (frontier : Nat -> Finset A.State)
    (word : OmegaWord Alphabet)
    (supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n))
    (priority : Nat) :=
  (supportChoiceLeveledGraph A frontier word supportChoice).RankingCertificate
    (priorityRequest A priority)
    (priorityGrant A priority)

/--
An odd-ranking certificate rules out a rejecting timed thread for that
priority.  This is the direct adapter from the reusable graph lemma to APA
support choices.
-/
theorem no_badPriorityThread_of_rankingCertificate
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Nat -> Finset A.State}
    {word : OmegaWord Alphabet}
    {supportChoice :
      ∀ n : Nat, A.MacroStepSupport (frontier n) (word n)}
    {priority : Nat}
    (certificate :
      PriorityRankingCertificate A frontier word supportChoice priority) :
    ¬ ∃ path : Nat -> A.State,
      (supportChoiceLeveledGraph A frontier word supportChoice).BadStreettThread
        (priorityRequest A priority)
        (priorityGrant A priority)
        path :=
  FiniteWidthStreett.LeveledGraph.no_badStreettThread_of_rankingCertificate
    certificate

/-- A state of the Büchi breakpoint construction. -/
structure BuchiState
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) where
  frontier : Finset A.State
  pending : Finset A.State

attribute [ext] BuchiState

namespace BuchiState

noncomputable instance
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :
    Fintype (BuchiState A) := by
  classical
  let e : (Finset A.State × Finset A.State) ≃ BuchiState A :=
  { toFun := fun pair => BuchiState.mk pair.1 pair.2
    invFun := fun state => (state.frontier, state.pending)
    left_inv := by
      intro pair
      cases pair
      rfl
    right_inv := by
      intro state
      cases state
      rfl }
  exact Fintype.ofEquiv (Finset A.State × Finset A.State) e

end BuchiState

/--
The Büchi view of an APA state: priority `0` is accepting.  This is the
Miyano-Hayashi base case.  General parity needs the finite Streett/ranking
layer built above this file.
-/
def buchiAcceptingState
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (state : A.State) :
    Prop :=
  A.priority state = 0

/-- The initial breakpoint summary. -/
noncomputable def buchiInitialState
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :
    BuchiState A where
  frontier := {A.initial}
  pending := ∅

/--
Successors of the currently pending states under the same timed support choice
that advances the whole frontier.
-/
noncomputable def pendingSuccessors
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Finset A.State}
    {letter : Alphabet}
    (supportChoice : A.MacroStepSupport frontier letter)
    (pending : Finset A.State) :
    Finset A.State := by
  classical
  exact pending.attach.biUnion (fun state =>
    if hstate : state.1 ∈ frontier then
      (supportChoice.choice ⟨state.1, hstate⟩).support
    else
      ∅)

/-- The next breakpoint set before filtering out Büchi-accepting states. -/
noncomputable def rawNextPending
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Finset A.State}
    {letter : Alphabet}
    (supportChoice : A.MacroStepSupport frontier letter)
    (pending : Finset A.State) :
    Finset A.State := by
  classical
  exact
    if pending = ∅ then
      supportChoice.support
    else
      pendingSuccessors supportChoice pending

/-- The next breakpoint set: accepting states clear their obligation. -/
noncomputable def nextPending
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier : Finset A.State}
    {letter : Alphabet}
    (supportChoice : A.MacroStepSupport frontier letter)
    (pending : Finset A.State) :
    Finset A.State := by
  classical
  exact
    (rawNextPending supportChoice pending).filter
      (fun state => ¬ buchiAcceptingState A state)

/--
One transition of the Miyano-Hayashi Büchi breakpoint construction.

The same support choice advances both the frontier and the pending set.  This
is the timed point that rules out the recurring-edge-graph mistake.
-/
def buchiStep
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (current : BuchiState A)
    (letter : Alphabet)
    (next : BuchiState A) :
    Prop :=
  ∃ supportChoice : A.MacroStepSupport current.frontier letter,
    next.frontier = supportChoice.support ∧
      next.pending = nextPending supportChoice current.pending

/-- A breakpoint summary is Büchi-accepting exactly when all obligations clear. -/
def buchiAccepting
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    (state : BuchiState A) :
    Prop :=
  state.pending = ∅

/-- The finite nondeterministic Büchi automaton generated by the breakpoint core. -/
noncomputable def buchiCore
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet) :
    NondetBuchiAutomaton.{u, v} Alphabet where
  State := BuchiState A
  stateFinite := by
    classical
    infer_instance
  initial := buchiInitialState A
  step := buchiStep A
  accepting := buchiAccepting

theorem buchiStep_frontier_transition
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {current next : BuchiState A}
    {letter : Alphabet}
    (hstep : buchiStep A current letter next) :
    A.MacroTransition current.frontier letter next.frontier := by
  rcases hstep with ⟨supportChoice, hfrontier, _hpending⟩
  exact ⟨supportChoice, hfrontier.symm⟩

theorem mem_pendingSuccessors
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier pending : Finset A.State}
    {letter : Alphabet}
    (supportChoice : A.MacroStepSupport frontier letter)
    (nextState : A.State) :
    nextState ∈ pendingSuccessors supportChoice pending ↔
      ∃ state : A.State,
        state ∈ pending ∧
          ∃ hfrontier : state ∈ frontier,
            nextState ∈ (supportChoice.choice ⟨state, hfrontier⟩).support := by
  classical
  constructor
  · intro hnext
    simp [pendingSuccessors] at hnext
    rcases hnext with ⟨state, hpending, hnext⟩
    by_cases hfrontier : state ∈ frontier
    · refine ⟨state, hpending, hfrontier, ?_⟩
      simpa [hfrontier] using hnext
    · simp [hfrontier] at hnext
  · intro hnext
    rcases hnext with ⟨state, hpending, hfrontier, hnext⟩
    unfold pendingSuccessors
    refine Finset.mem_biUnion.mpr ⟨⟨state, hpending⟩, ?_⟩
    simp [hfrontier, hnext]

theorem pendingSuccessors_subset_support
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier pending : Finset A.State}
    {letter : Alphabet}
    (supportChoice : A.MacroStepSupport frontier letter) :
    pendingSuccessors supportChoice pending ⊆ supportChoice.support := by
  intro nextState hnext
  rcases (mem_pendingSuccessors supportChoice nextState).mp hnext with
    ⟨state, _hpending, hfrontier, hnextSupport⟩
  exact
    (MacroStepSupport.mem_support
      (supportChoice := supportChoice)
      (nextState := nextState)).mpr
      ⟨⟨state, hfrontier⟩, hnextSupport⟩

theorem rawNextPending_subset_support
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier pending : Finset A.State}
    {letter : Alphabet}
    (supportChoice : A.MacroStepSupport frontier letter) :
    rawNextPending supportChoice pending ⊆ supportChoice.support := by
  classical
  by_cases hpending : pending = ∅
  · simp [rawNextPending, hpending]
  · simpa [rawNextPending, hpending] using
      pendingSuccessors_subset_support supportChoice

theorem nextPending_subset_support
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {frontier pending : Finset A.State}
    {letter : Alphabet}
    (supportChoice : A.MacroStepSupport frontier letter) :
    nextPending supportChoice pending ⊆ supportChoice.support := by
  intro nextState hnext
  classical
  have hraw :
      nextState ∈ rawNextPending supportChoice pending :=
    by
      change nextState ∈
        (rawNextPending supportChoice pending).filter
          (fun state => ¬ buchiAcceptingState A state) at hnext
      exact (Finset.mem_filter.mp hnext).1
  exact rawNextPending_subset_support supportChoice hraw

theorem buchiStep_pending_subset_frontier
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {current next : BuchiState A}
    {letter : Alphabet}
    (hstep : buchiStep A current letter next) :
    next.pending ⊆ next.frontier := by
  rcases hstep with ⟨supportChoice, hfrontier, hpending⟩
  intro state hstate
  rw [hpending] at hstate
  rw [hfrontier]
  exact nextPending_subset_support supportChoice hstate

theorem buchiCore_step
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (current : (buchiCore A).State)
    (letter : Alphabet)
    (next : (buchiCore A).State) :
    (buchiCore A).step current letter next ↔ buchiStep A current letter next :=
  Iff.rfl

theorem buchiCore_accepting
    {Alphabet : Type u}
    (A : AlternatingParityAutomaton.{u, v} Alphabet)
    (state : (buchiCore A).State) :
    (buchiCore A).accepting state ↔ state.pending = ∅ :=
  Iff.rfl

/--
The frontier component of a run of the breakpoint core is a genuine timed
macro-run of the underlying alternating automaton.
-/
noncomputable def frontierMacroRun
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (buchiCore A).RunFrom (buchiCore A).initial word) :
    A.MacroRun {A.initial} word where
  states n := (run.path n).frontier
  initial_states := by
    rw [run.initial_state]
    rfl
  step_transition := by
    intro n
    exact buchiStep_frontier_transition (A := A)
      (current := run.path n)
      (next := run.path (n + 1))
      (letter := word n)
      (by
        simpa [buchiCore] using run.step_valid n)

@[simp]
theorem frontierMacroRun_states
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (buchiCore A).RunFrom (buchiCore A).initial word)
    (n : Nat) :
    (frontierMacroRun run).states n = (run.path n).frontier :=
  rfl

/--
Along every run of the breakpoint core, pending obligations are always active
frontier states.
-/
theorem pending_subset_frontier_on_run
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : (buchiCore A).RunFrom (buchiCore A).initial word)
    (n : Nat) :
    (run.path n).pending ⊆ (run.path n).frontier := by
  induction n with
  | zero =>
      rw [run.initial_state]
      intro state hstate
      simp [buchiCore, buchiInitialState] at hstate
  | succ n =>
      exact buchiStep_pending_subset_frontier (A := A)
        (current := run.path n)
        (next := run.path (n + 1))
        (letter := word n)
        (by
          simpa [buchiCore] using run.step_valid n)

/--
Accepting runs of the breakpoint core clear their pending obligations
infinitely often.
-/
theorem pending_clears_infinitely_often
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    {run : (buchiCore A).RunFrom (buchiCore A).initial word}
    (haccepts : run.Accepts) :
    ∀ n : Nat, ∃ k : Nat, n ≤ k ∧ (run.path k).pending = ∅ := by
  intro n
  rcases haccepts n with ⟨k, hk, hkaccepting⟩
  exact ⟨k, hk, hkaccepting⟩

end MiyanoHayashi

end AlternatingParityAutomaton

end DistributedSynthesis
