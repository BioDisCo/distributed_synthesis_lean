  quotient_envs_nonempty := core.quotient_envs_nonempty
  coherentHistoryNonempty := by
    intro c hnil
    rcases core.coherentHistoryAppend c with ⟨pref, r, hc⟩
    rw [hc] at hnil
    simpa [History.append] using hnil

/--
Nonempty-history form of the truth-vector quotient core.

This is the sharpest statement shape for the main no-direct mathematical
obligation: append decompositions are list bookkeeping, while nonemptiness is
the actual semantic exclusion of the empty coherent continuation state.
-/
structure NoDirectDPAJournalBoundedLocalTruthVectorQuotientNonemptyCoreForActualTruthAutomatonParityCurrentOrderHeader
