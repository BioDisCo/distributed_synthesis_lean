/--
The single theorem-facing Bérard finite-index construction for the
no-direct-reversal fragment.

This is now checked from the package-level Bérard import above.
-/
noncomputable def actualTruthBlockwiseFiniteIndexCoreImport_of_berardUniform
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (generationBound_pos : 0 < header.generationBound)
    (cover :
      RepresentativeCompleteNoDirectBerardFiniteCoverForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalBlockwiseFiniteIndexCoreForActualTruthAutomatonParityCurrentOrderHeader.{u, v, x, y,
      max u v x y, aut}
      header := by
  classical
  exact
    (actualTruthBlockwisePackagesImport_of_berardUniform
      header generationBound_pos cover).toBlockwiseCore

/--
Raw-epoch half of the theorem-facing last-block construction.

This isolates the part of the Bérard argument that imports the
one-directional finite-memory construction into the no-direct raw epoch state.
-/
structure NoDirectDPAJournalBoundedLocalActualTruthRawEpochInvariantImportCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      (envsOfHistory h).length ≤ header.generationBound
  envs_actualTruth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ (envsOfHistory h))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  envs_nonempty :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      envsOfHistory h ≠ []
  rawEpochState_invariant :
    header.cert.determinesPathData ->
    header.cert.predecessorClosed ->
    (∀ boundaryState, header.cert.boundaryClosed boundaryState) ->
    header.cert.continuationClosed ->
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h') ->
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h'
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
Receipt/order half of the theorem-facing last-block construction.

This is the hidden-bit obligation: equality of actual stabilized truth atoms
must determine the current receipt tags and current containment order.
-/
def NoDirectDPAJournalBoundedLocalActualTruthReceiptOrderInvariant
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) : Prop :=
  ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
    regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h') ->
    currentReceiptOrderData h (historyCurrentContainmentOrder h) =
      currentReceiptOrderData h' (historyCurrentContainmentOrder h')

/--
Append-level receipt/order determinacy gives current receipt/order determinacy on
nonempty histories.

This is the checked block case for the hidden-bit argument.  The only histories
not covered by this lemma are the initial empty prefix cases; those require a
separate empty-history compatibility argument or an interface that never queries
the current receipt/order decoder at the empty prefix.
-/
theorem actualTruthReceiptOrderInvariant_of_appendTruthDeterminesReceiptOrder_nonempty
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (appendTruthDeterminesReceiptOrder :
      ∀ (pref pref' : History In₁ In₂ Graph Out₁ Out₂)
        (r r' : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound (History.append pref r)) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound (History.append pref' r')) ->
        currentReceiptOrderDataForAppend pref r =
          currentReceiptOrderDataForAppend pref' r')
    {h h' : History In₁ In₂ Graph Out₁ Out₂}
    (htruth :
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h'))
    (hne : h ≠ []) (hne' : h' ≠ []) :
    currentReceiptOrderData h (historyCurrentContainmentOrder h) =
      currentReceiptOrderData h' (historyCurrentContainmentOrder h') := by
  rcases history_eq_append_of_ne_nil hne with ⟨pref, r, hh⟩
  rcases history_eq_append_of_ne_nil hne' with ⟨pref', r', hh'⟩
  have htruthAppend :
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound (History.append pref r)) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound (History.append pref' r')) := by
    simpa [hh, hh'] using htruth
  have happend :
      currentReceiptOrderDataForAppend pref r =
        currentReceiptOrderDataForAppend pref' r' :=
    appendTruthDeterminesReceiptOrder pref pref' r r' htruthAppend
  calc
    currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData (History.append pref r)
          (historyCurrentContainmentOrder (History.append pref r)) := by
          rw [hh]
    _ =
        currentReceiptOrderData (History.append pref r)
          (graphContainmentOrder r.graph) := by
          rw [historyCurrentContainmentOrder_append pref r]
    _ = currentReceiptOrderDataForAppend pref r := rfl
    _ = currentReceiptOrderDataForAppend pref' r' := happend
    _ =
        currentReceiptOrderData (History.append pref' r')
          (graphContainmentOrder r'.graph) := rfl
    _ =
        currentReceiptOrderData (History.append pref' r')
          (historyCurrentContainmentOrder (History.append pref' r')) := by
          rw [historyCurrentContainmentOrder_append pref' r']
    _ = currentReceiptOrderData h' (historyCurrentContainmentOrder h') := by
          rw [hh']

/-- Empty histories have the neutral current receipt/order payload. -/
theorem currentReceiptOrderData_empty_historyCurrentContainmentOrder
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y} :
    currentReceiptOrderData
        ([] : History In₁ In₂ Graph Out₁ Out₂)
        (historyCurrentContainmentOrder
          ([] : History In₁ In₂ Graph Out₁ Out₂)) =
      defaultReceiptOrderData := by
  rfl

/--
Full current receipt/order invariance from append-level determinacy plus the
single remaining empty/nonempty compatibility condition.

The nonempty/nonempty and empty/empty cases are checked here.  The only extra
premise is exactly the mixed initial-prefix case: if the empty history and a
proper block have the same stabilized truth atom, then the proper block must
carry the neutral receipt/order payload.
-/
theorem actualTruthReceiptOrderInvariant_of_appendTruthDeterminesReceiptOrder_and_emptyCompatibility
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (appendTruthDeterminesReceiptOrder :
      ∀ (pref pref' : History In₁ In₂ Graph Out₁ Out₂)
        (r r' : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound (History.append pref r)) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound (History.append pref' r')) ->
        currentReceiptOrderDataForAppend pref r =
          currentReceiptOrderDataForAppend pref' r')
    (emptyCompatibility :
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        h ≠ [] ->
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              ([] : History In₁ In₂ Graph Out₁ Out₂)) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h) ->
        currentReceiptOrderData h (historyCurrentContainmentOrder h) =
          defaultReceiptOrderData) :
    NoDirectDPAJournalBoundedLocalActualTruthReceiptOrderInvariant header := by
  intro h h' htruth
  by_cases hne : h ≠ []
  · by_cases hne' : h' ≠ []
    · exact
        actualTruthReceiptOrderInvariant_of_appendTruthDeterminesReceiptOrder_nonempty
          header appendTruthDeterminesReceiptOrder htruth hne hne'
    · have hh' : h' = [] := by simpa using not_not.mp hne'
      calc
        currentReceiptOrderData h (historyCurrentContainmentOrder h) =
            defaultReceiptOrderData := by
              exact emptyCompatibility h hne (by simpa [hh'] using htruth.symm)
        _ =
            currentReceiptOrderData h' (historyCurrentContainmentOrder h') := by
              rw [hh']
              exact currentReceiptOrderData_empty_historyCurrentContainmentOrder.symm
  · have hh : h = [] := by simpa using not_not.mp hne
    by_cases hne' : h' ≠ []
    · calc
        currentReceiptOrderData h (historyCurrentContainmentOrder h) =
            defaultReceiptOrderData := by
              rw [hh]
              exact currentReceiptOrderData_empty_historyCurrentContainmentOrder
        _ =
            currentReceiptOrderData h' (historyCurrentContainmentOrder h') := by
              exact (emptyCompatibility h' hne' (by simpa [hh] using htruth)).symm
    · have hh' : h' = [] := by simpa using not_not.mp hne'
      rw [hh, hh']

/-- Raw-epoch/re representative import. -/
noncomputable def actualTruthRawEpochInvariantImport_of_berardUniform
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (generationBound_pos : 0 < header.generationBound)
    (cover :
      RepresentativeCompleteNoDirectBerardFiniteCoverForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalActualTruthRawEpochInvariantImportCore header := by
  classical
  let core :=
    actualTruthBlockwiseFiniteIndexCoreImport_of_berardUniform
      header generationBound_pos cover
  exact
    { envsOfHistory := fun h => core.envsOfState (core.stateOfHistory h)
      envs_bound := fun h => core.envs_bound (core.stateOfHistory h)
      envs_actualTruth := core.envs_actualTruth
      envs_nonempty := core.envs_nonempty
      rawEpochState_invariant := core.closureInvariants.rawEpochState_invariant
      coherentHistoryNonempty := core.coherentHistoryNonempty }

/-- Receipt/order invariance import. -/
noncomputable def actualTruthReceiptOrderInvariantImport_of_berardUniform
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (generationBound_pos : 0 < header.generationBound)
    (cover :
      RepresentativeCompleteNoDirectBerardFiniteCoverForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalActualTruthReceiptOrderInvariant header := by
  classical
  let core :=
    actualTruthBlockwiseFiniteIndexCoreImport_of_berardUniform
      header generationBound_pos cover
  intro h h' htruth
  calc
    currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        core.receiptOrderOfState (core.stateOfHistory h) :=
          core.receiptOrder_state h
    _ =
        core.receiptOrderOfState
          (core.stateOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h))) := by
          rw [core.state_truth_factor h]
    _ =
        core.receiptOrderOfState
          (core.stateOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h'))) := by
          rw [htruth]
    _ =
        core.receiptOrderOfState (core.stateOfHistory h') := by
          rw [core.state_truth_factor h']
    _ =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h') :=
          (core.receiptOrder_state h').symm

