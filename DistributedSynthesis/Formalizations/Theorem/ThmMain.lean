    StabilizedSaturationBasisNoDirectSplitQuotientFactorization
      header.importedUniform header.initialBoundary header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder header.orderOfHistory header.automatonOfHistory
  decodeReceiptOrderOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
      ReceiptOrderData
  decodesCurrent :
    ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
      ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        decodeReceiptOrderOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound
                (History.append pref r))) =
          currentReceiptOrderDataForAppend pref r
  orderOfAppend :
    ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
      ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        header.orderOfHistory (History.append pref r) =
          graphContainmentOrder r.graph
  coherentHistoryAppend :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder header.orderOfHistory header.automatonOfHistory,
      ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          c.1.history = History.append pref r
  parityOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
      header.ParityProgress
  parity_factor :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      header.parityOfHistory h =
        parityOfTruth
