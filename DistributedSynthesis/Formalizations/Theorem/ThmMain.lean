    ∀ c c' :
      CoherentContinuationConfiguration
        header.containmentOrder header.orderOfHistory header.automatonOfHistory,
      core.payload.parityOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound c.1.history)) =
      core.payload.parityOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound c'.1.history)) ->
        header.parityOfHistory c.1.history =
          header.parityOfHistory c'.1.history := by
  intro c c' hparity
  calc
    header.parityOfHistory c.1.history =
        core.payload.parityOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound c.1.history)) :=
      core.payload.parity_factor c.1.history
    _ =
        core.payload.parityOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound c'.1.history)) :=
      hparity
    _ = header.parityOfHistory c'.1.history :=
      (core.payload.parity_factor c'.1.history).symm

