/--
Convert the structural order core into the bounded-generated representative
core.  Receipt/order equality follows from current-view determinacy plus
truth-determinacy of the selected containment order.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalActualTruthNonemptyBoundedGeneratedOrderCoreForHeader.toBoundedGeneratedRepresentativeCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header : NoDirectDPAJournalBoundedLocalHeader In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthNonemptyBoundedGeneratedOrderCoreForHeader
        header) :
    NoDirectDPAJournalBoundedLocalBoundedGeneratedRepresentativeCoreForHeader
      header where
  envsOfHistory := core.envsOfHistory
  envs_bound := core.envs_bound
  envs_truth := by
    intro h
    calc
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ (core.envsOfHistory h))) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h) :=
            core.envs_actualTruth h
      _ = header.truthOfHistory h := by
            exact (core.truthOfHistory_actual h).symm
  envs_append :=
    fun h =>
      executionPrefixFromList_eq_append_of_ne_nil
        header.σ (core.envs_nonempty h)
  truthOfHistory_eq := by
    intro c
    exact core.truthOfHistory_actual c.1.history
  generatedHistoryBounded := core.generatedHistoryBounded
  boundedGeneratedLength_determined :=
    core.boundedGeneratedLength_determined
  boundedGeneratedPrefixTruth_determined :=
    core.boundedGeneratedPrefixTruth_determined
  currentViews_determined := core.currentViews_determined
  automatonOfHistory_invariant := by
    intro hcont h h' htruth
    calc
      header.automatonOfHistory h =
          core.automatonOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h)) := by
            exact (core.automaton_factor hcont h).symm
      _ =
          core.automatonOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h')) := by
            rw [htruth]
      _ = header.automatonOfHistory h' := core.automaton_factor hcont h'
  receiptOrder_eq_of_truth_eq := by
    intro h h' htruth
    have hviews := core.currentViews_determined h h' htruth
    have horder := core.orderOfHistory_eq_of_truth_eq h h' htruth
    have hone :
        (currentView Proc.one h).receiptTag =
          (currentView Proc.one h').receiptTag :=
      congrArg (fun views => views.1.receiptTag) hviews
    have htwo :
        (currentView Proc.two h).receiptTag =
          (currentView Proc.two h').receiptTag :=
      congrArg (fun views => views.2.receiptTag) hviews
    change
      ({ receiptOne := (currentView Proc.one h).receiptTag
         receiptTwo := (currentView Proc.two h).receiptTag
         containmentOrder := header.orderOfHistory h } : ReceiptOrderData) =
        { receiptOne := (currentView Proc.one h').receiptTag
          receiptTwo := (currentView Proc.two h').receiptTag
          containmentOrder := header.orderOfHistory h' }
    simp [hone, htwo, horder]
  orderOfAppend := core.orderOfAppend
  coherentHistoryAppend := core.coherentHistoryAppend
  parityOfHistory_eq_of_truth_eq := by
    intro h h' htruth
    calc
      header.parityOfHistory h =
          core.parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h)) :=
            core.parity_factor h
      _ =
          core.parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h')) := by
            rw [htruth]
      _ = header.parityOfHistory h' := by
            exact (core.parity_factor h').symm

