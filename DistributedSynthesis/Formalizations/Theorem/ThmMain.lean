      CoherentContinuationConfiguration
        header.containmentOrder header.orderOfHistory header.automatonOfHistory,
    header.truthOfHistory c.1.history =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound c.1.history)
  rawEpochOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
      EpochRotatingAccessState
        header.importedUniform.boundary
        (header.importedUniform.summary Proc.one)
        (header.importedUniform.summary Proc.two)
  rawEpoch_factor :
    header.cert.determinesPathData ->
    header.cert.predecessorClosed ->
    (∀ boundaryState, header.cert.boundaryClosed boundaryState) ->
    header.cert.continuationClosed ->
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        rawEpochOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h)) =
          header.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h
  automatonOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
      header.AState
  automaton_factor :
    header.cert.continuationClosed ->
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        automatonOfTruth
