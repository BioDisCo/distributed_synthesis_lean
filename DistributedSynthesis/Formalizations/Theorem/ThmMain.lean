    ∀ c :
      CoherentContinuationConfiguration
        header.toActualTruthHeader.containmentOrder
        historyCurrentContainmentOrder
        header.toActualTruthHeader.toCurrentOrderHeader.automatonOfHistory,
      ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
