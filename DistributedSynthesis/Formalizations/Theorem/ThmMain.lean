    StabilizedSaturationBasisNoDirectSplitQuotientFactorization.of_fields
      header.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      header.orderOfHistory
      header.automatonOfHistory
      core.rawEpochOfTruth
      core.rawEpoch_factor
