      initialBoundary
      cert
      edgeOfRound
      sameParityOutcomes
      containmentOrder
      orderOfHistory
      automatonOfHistory
      parityOfHistory
      sameParityOfProgress
      σ
      generationBound
      stateOfHistory
      state_truth_eq
      closureInvariants
      summaryUnit
      decodeReceiptOrder
      decodesCurrent
      orderOfAppend
      historyAppend
      parityOfTruth
      parity_factor
      updateClosed
      updateClosed_proof
      preservesDynamicHierarchy
      preservesDynamicHierarchy_proof
      finiteFringeCompilation
      finiteFringeCompilation_proof
      boundaryAndBlockTransitionsEffective
      boundaryAndBlockTransitionsEffective_proof
      continuationPreservedBlockByBlock
      continuationPreservedBlockByBlock_proof
      transitionRelationEffective
      transitionRelationEffective_proof
      finiteGame
      finiteGameRealizableIff
  cases dpaDecision with
  | isTrue h =>
      exact
        isTrue
          (by
            rcases h with ⟨σ, hσ⟩
            exact
              ⟨σ, fun env =>
                (compiler.correct formula (execution σ env)).mp (hσ env)⟩)
  | isFalse h =>
