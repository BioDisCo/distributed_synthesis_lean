/--
Convert the canonical-current-order core into the automaton-parity order core.

The selected order is canonical, so equality of stabilized truth atoms gives
equality of current views, hence equality of the canonical current order.
Append-order correctness is exactly `historyCurrentContainmentOrder_append`;
coherent append decomposition follows from nonemptiness.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalActualTruthNonemptyBoundedGeneratedAutomatonParityCurrentOrderCoreForHeader.toAutomatonParityOrderCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header : NoDirectDPAJournalBoundedLocalHeader In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthNonemptyBoundedGeneratedAutomatonParityCurrentOrderCoreForHeader
        header) :
    NoDirectDPAJournalBoundedLocalActualTruthNonemptyBoundedGeneratedAutomatonParityOrderCoreForHeader
      header where
  envsOfHistory := core.envsOfHistory
  envs_bound := core.envs_bound
  envs_actualTruth := core.envs_actualTruth
  envs_nonempty := core.envs_nonempty
  truthOfHistory_actual := core.truthOfHistory_actual
  generatedHistoryBounded := core.generatedHistoryBounded
  boundedGeneratedLength_determined :=
    core.boundedGeneratedLength_determined
  boundedGeneratedPrefixTruth_determined :=
    core.boundedGeneratedPrefixTruth_determined
  currentViews_determined := core.currentViews_determined
  automatonOfTruth := core.automatonOfTruth
  automaton_factor := core.automaton_factor
  orderOfHistory_eq_of_truth_eq := by
    intro h h' htruth
    have hviews := core.currentViews_determined h h' htruth
    calc
      header.orderOfHistory h =
          historyCurrentContainmentOrder h := core.orderOfHistory_current h
      _ = historyCurrentContainmentOrder h' :=
          historyCurrentContainmentOrder_eq_of_currentViews_eq hviews
      _ = header.orderOfHistory h' := (core.orderOfHistory_current h').symm
  orderOfAppend := by
    intro pref r
    calc
      header.orderOfHistory (History.append pref r) =
          historyCurrentContainmentOrder (History.append pref r) :=
          core.orderOfHistory_current (History.append pref r)
      _ = graphContainmentOrder r.graph :=
          historyCurrentContainmentOrder_append pref r
  coherentHistoryAppend := by
    intro c
    exact history_eq_append_of_ne_nil (core.coherentHistoryNonempty c)
  parityOfAutomaton := core.parityOfAutomaton
  parity_automaton_factor := core.parity_automaton_factor

/--
Assemble the package-level core from equality/determinacy statements.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalEqualityRepresentativeCoreForHeader.toPackageCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header : NoDirectDPAJournalBoundedLocalHeader In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalEqualityRepresentativeCoreForHeader
        header) :
    NoDirectDPAJournalBoundedLocalPackageCoreForHeader header where
  stateData :=
    StabilizedSaturationBasisBoundedGeneratedRepresentedTruthStateData.of_representatives
      header.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      header.orderOfHistory
      header.automatonOfHistory
      header.σ
      header.generationBound
      header.truthOfHistory
      core.envsOfHistory
      core.envs_bound
      core.envs_truth
      core.envs_append
      core.truthOfHistory_eq
  splitFactorization :=
    StabilizedSaturationBasisNoDirectSplitQuotientFactorization_of_rawAutomatonStateEqData
      header.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      header.orderOfHistory
      header.automatonOfHistory
      core.truthVectorDeterminesRawAutomatonState
  receiptOrderData :=
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderAppendData.of_appendTruthDeterminesReceiptOrder
      header.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      header.orderOfHistory
      header.automatonOfHistory
      (by
        intro pref pref' r r' htruth
        calc
          currentReceiptOrderDataForAppend pref r =
              currentReceiptOrderData (History.append pref r)
                (graphContainmentOrder r.graph) := rfl
          _ =
              currentReceiptOrderData (History.append pref r)
                (header.orderOfHistory (History.append pref r)) := by
                rw [core.orderOfAppend pref r]
          _ =
              currentReceiptOrderData (History.append pref' r')
                (header.orderOfHistory (History.append pref' r')) :=
                core.receiptOrder_eq_of_truth_eq
                  (History.append pref r) (History.append pref' r') htruth
          _ =
              currentReceiptOrderData (History.append pref' r')
                (graphContainmentOrder r'.graph) := by
                rw [core.orderOfAppend pref' r']
          _ = currentReceiptOrderDataForAppend pref' r' := rfl)
      core.orderOfAppend
      core.coherentHistoryAppend
  parityData :=
    StabilizedSaturationBasisBoundedGeneratedTruthParityBridgeData.of_truthDeterminesParity
      header.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      (fun c c' =>
        header.parityOfHistory c.history = header.parityOfHistory c'.history)
      header.containmentOrder
      header.orderOfHistory
      header.automatonOfHistory
      header.parityOfHistory
      core.parityOfHistory_eq_of_truth_eq
      (by
        intro c c' hparity
        exact hparity)

