      NoDirectDPAJournalBoundedLocalActualTruthInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalActualTruthRawEpochReceiptCoreForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfHistory := core.envsOfHistory
  envs_bound := core.envs_bound
  envs_actualTruth := core.envs_actualTruth
  envs_nonempty := core.envs_nonempty
  rawEpochOfTruth := fun atom =>
    header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
      header.initialBoundary
      (stabilizedTruthVectorRepresentativeHistory
        header.cert
        (pathOfHistoryByRound header.edgeOfRound)
        header.containmentOrder
        historyCurrentContainmentOrder
        header.toCurrentOrderHeader.automatonOfHistory
        atom)
  rawEpoch_factor := by
    intro hdet hpred hboundary hcont h
    exact
      core.rawEpochState_invariant hdet hpred hboundary hcont
        (stabilizedTruthVectorRepresentativeHistory
          header.cert
          (pathOfHistoryByRound header.edgeOfRound)
          header.containmentOrder
          historyCurrentContainmentOrder
          header.toCurrentOrderHeader.automatonOfHistory
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h)))
        h
        (stabilizedTruthVectorRepresentativeHistory_realizes
          header.cert
          (pathOfHistoryByRound header.edgeOfRound)
          header.containmentOrder
          historyCurrentContainmentOrder
          header.toCurrentOrderHeader.automatonOfHistory
          h)
  receiptOrderOfTruth := fun atom =>
    let h :=
      stabilizedTruthVectorRepresentativeHistory
        header.cert
        (pathOfHistoryByRound header.edgeOfRound)
        header.containmentOrder
        historyCurrentContainmentOrder
        header.toCurrentOrderHeader.automatonOfHistory
        atom
    currentReceiptOrderData h (historyCurrentContainmentOrder h)
  receiptOrder_factor := by
    intro h
    exact
      core.receiptOrder_invariant h
        (stabilizedTruthVectorRepresentativeHistory
          header.cert
          (pathOfHistoryByRound header.edgeOfRound)
          header.containmentOrder
          historyCurrentContainmentOrder
          header.toCurrentOrderHeader.automatonOfHistory
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h)))
        (stabilizedTruthVectorRepresentativeHistory_realizes
          header.cert
          (pathOfHistoryByRound header.edgeOfRound)
          header.containmentOrder
          historyCurrentContainmentOrder
          header.toCurrentOrderHeader.automatonOfHistory
          h).symm
  coherentHistoryNonempty := core.coherentHistoryNonempty

/--
Actual-truth generated representatives plus the existing no-direct closure
truth-vector invariant package.

This is a sharper statement than `ActualTruthInvariantCore`: the raw epoch
truth-vector invariance is supplied by the shared saturation closure package,
while this core only adds the current receipt/order truth-vector invariance
that is specific to the current-order frontend.
-/
structure NoDirectDPAJournalBoundedLocalActualTruthClosureInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      (envsOfHistory h).length ≤ header.generationBound
  envs_actualTruth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ (envsOfHistory h))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  envs_nonempty :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      envsOfHistory h ≠ []
  closureInvariants :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  receiptOrder_invariant :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h')
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
Use the shared no-direct closure invariant package to fill the actual-truth
invariant core.
-/
def
    NoDirectDPAJournalBoundedLocalActualTruthClosureInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader.toActualTruthInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
