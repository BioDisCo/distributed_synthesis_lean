/--
Invariance form of the corrected actual-truth/current-order core.

This is the most economical mathematical statement: bounded generated
representatives realize the actual stabilized truth atom, and equality of that
atom determines the raw no-direct epoch state and the current receipt/order
payload.  The explicit quotient maps are chosen automatically in the
conversion below.
-/
structure NoDirectDPAJournalBoundedLocalActualTruthInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      (envsOfHistory h).length ≤ header.generationBound
  envs_actualTruth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ (envsOfHistory h))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  envs_nonempty :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      envsOfHistory h ≠ []
  rawEpochState_invariant :
    header.cert.determinesPathData ->
    header.cert.predecessorClosed ->
    (∀ boundaryState, header.cert.boundaryClosed boundaryState) ->
    header.cert.continuationClosed ->
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h') ->
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h'
  receiptOrder_invariant :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h')
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
Choose the explicit raw-epoch and receipt/order quotient maps from the
invariance-form core.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalActualTruthInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader.toRawEpochReceiptCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
