      NoDirectDPAJournalBoundedLocalBerardLastBlockTableForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalLastBlockFiniteMemoryProofPackageForActualTruthAutomatonParityCurrentOrderHeader
      header where
  representatives :=
    { envsOfTruth := table.envsOfTruth
      envs_bound := table.envs_bound
      envs_actualTruth := table.envs_actualTruth
      envs_nonempty := table.envs_nonempty }
  closureInvariants := table.closureInvariants
  receiptOrder :=
    { receiptOrderOfTruth := table.receiptOrderOfTruth
      receiptOrder_factor := table.receiptOrder_factor }
