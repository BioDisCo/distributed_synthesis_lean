    (core :
      NoDirectDPAJournalBoundedLocalRepresentedTruthPayloadAppendCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalTruthVectorQuotientNonemptyCoreForActualTruthAutomatonParityCurrentOrderHeader
      header := by
  let appendCore := core.toTruthVectorQuotientAppendCore
  exact
    { truthQuotient := appendCore.truthQuotient
      representatives := appendCore.representatives
      quotient_envs_nonempty := appendCore.quotient_envs_nonempty
      coherentHistoryNonempty := by
        intro c hnil
        rcases appendCore.coherentHistoryAppend c with ⟨pref, r, hc⟩
        rw [hc] at hnil
        simpa [History.append] using hnil }

/--
Canonical-containment form of the represented-truth payload core.

Instead of exposing the abstract canonical-representatives predicate, this
record asks for the concrete equation saying that the chosen containment order
classifies the canonical current-tagged configuration by the current graph
order.
-/
structure NoDirectDPAJournalBoundedLocalCanonicalRepresentedTruthPayloadAppendCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
