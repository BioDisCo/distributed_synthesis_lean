  coherentHistoryNonempty := core.coherentHistoryNonempty

/--
Convert current-view determinacy to an explicit truth-indexed current-view
decoder by choosing one realizing history for each realized stabilized truth
atom.

This shows that the relational current-view formulation and the finite decoder
form are equivalent for the theorem interface; the only real construction
needed from the Bérard argument is still the representative/closure payload.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsCoreForActualTruthAutomatonParityCurrentOrderHeader.toCurrentViewsFactorCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsFactorCoreForActualTruthAutomatonParityCurrentOrderHeader
      header := by
  classical
  let actualTruth :=
    fun h : History In₁ In₂ Graph Out₁ Out₂ =>
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  let realized :=
    fun truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert) =>
      ∃ h : History In₁ In₂ Graph Out₁ Out₂, actualTruth h = truth
  let defaultHistory : History In₁ In₂ Graph Out₁ Out₂ := []
  let selectedHistory :
      RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
        History In₁ In₂ Graph Out₁ Out₂ :=
    fun truth =>
      if hreal : realized truth then
        Classical.choose hreal
      else
        defaultHistory
  refine
    { envsOfHistory := core.envsOfHistory
      envs_bound := core.envs_bound
      envs_actualTruth := core.envs_actualTruth
      envs_nonempty := core.envs_nonempty
      closureInvariants := core.closureInvariants
      currentViewsOfTruth :=
        fun truth =>
          (currentView Proc.one (selectedHistory truth),
            currentView Proc.two (selectedHistory truth))
      currentViews_factor := ?_
      coherentHistoryNonempty := core.coherentHistoryNonempty }
  intro h
  have hreal : realized (actualTruth h) := ⟨h, rfl⟩
  have hselectedTruth :
      actualTruth (selectedHistory (actualTruth h)) = actualTruth h := by
    dsimp [selectedHistory]
    rw [dif_pos hreal]
    exact Classical.choose_spec hreal
  exact core.currentViews_determined
    h (selectedHistory (actualTruth h)) hselectedTruth.symm

/--
Optional package route for the Bérard last-block construction.

The existing no-direct saturation development already proves the closure
truth-vector invariants from
`StabilizedSaturationBasisNoDirectByRoundTruthVectorFactors`.  This structure
records exactly the extra theorem-level data needed to use that route together
with bounded actual-truth representatives.  It is intentionally not the main
import below, because its `generatedHistory` premise is stronger than the
weakest theorem-facing interface.
-/
structure NoDirectDPAJournalBoundedLocalByRoundTruthVectorFactorPackageCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      (envsOfHistory h).length ≤ header.generationBound
  envs_actualTruth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ (envsOfHistory h))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  envs_nonempty :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      envsOfHistory h ≠ []
  generatedHistory :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      ∃ envs : List (EnvironmentRound In₁ In₂),
        h = executionPrefixFromList header.σ envs
  factors :
    StabilizedSaturationBasisNoDirectByRoundTruthVectorFactors
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.cert
      header.edgeOfRound
      header.toCurrentOrderHeader.automatonOfHistory
      header.σ
  coherentHistoryAppend :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      ∃ pref : History In₁ In₂ Graph Out₁ Out₂,
        ∃ r : RoundRecord In₁ In₂ Graph Out₁ Out₂,
          c.1.history = History.append pref r

/--
Use the existing by-round truth-vector factor package to build the current
finite-decoder core.
-/
