    rw [hc] at hnil
    simpa [History.append] using hnil

/--
Blockwise finite-index form of the no-direct-reversal construction.

This is the certificate shape for the remaining Bérard-style argument.  The
finite state is meant to be the product of the DPA state, the raw no-direct
epoch state, the active side, and the one-directional finite-memory summaries
inside the current block.  The representative history indexed by this state
must realize the same stabilized truth atom as the original history, and the
state itself must factor through that atom.  The finite current
receipt/order observation factors through the same state; the full local views
are not claimed finite.  The shared closure invariant package supplies the
block-by-block continuation preservation needed downstream.
-/
structure NoDirectDPAJournalBoundedLocalBlockwiseFiniteIndexCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  BlockState : Type c
  blockStateFinite : Fintype BlockState
  stateOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> BlockState
  envsOfState :
    BlockState -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ s : BlockState, (envsOfState s).length ≤ header.generationBound
  envs_actualTruth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ (envsOfState (stateOfHistory h)))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  envs_nonempty :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      envsOfState (stateOfHistory h) ≠ []
  closureInvariants :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  receiptOrderOfState :
    BlockState -> ReceiptOrderData
  receiptOrder_state :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        receiptOrderOfState (stateOfHistory h)
  stateOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) -> BlockState
  state_truth_factor :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      stateOfHistory h =
        stateOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h))
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
Operational blockwise finite-index core.

This is slightly closer to the intended Bérard construction than the closure
invariant core above: instead of assuming the whole no-direct closure invariant
package, it only asks the block state to decode the raw no-direct epoch state.
For the actual-truth header the automaton state already factors through the
truth atom definitionally, so these fields are enough to build the closure
invariant package.
-/
