    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      header.containmentOrder {
        history := h
        automatonState := header.toCurrentOrderHeader.automatonOfHistory h
        receiptOne := (currentView Proc.one h).receiptTag
        receiptTwo := (currentView Proc.two h).receiptTag
      } = historyCurrentContainmentOrder h
  backend :
    NoDirectDPAJournalBoundedLocalConcreteFringeCompilerSemanticBackendForHeader
      header.toCurrentOrderHeader.toHeader

