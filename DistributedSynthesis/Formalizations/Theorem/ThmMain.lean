/--
Regular-test repair inputs for the enriched-coherent no-direct route.

This is the concrete Step 3/Step 4 interface: the parity-progress certificate
is obtained from the finite repair quotient, and the remaining semantic
separation statement is that equality of repair atoms refines
`AContinuationEquivalent` on coherent configurations.
-/
structure NoDirectDPARegularTestRepairLeanInputs
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  AState : Type (max u v x y)
  aStateFinite : Fintype AState
  uniform :
    UniformOneDirectionalFiniteIndexLemma.{max u v x y, u, v, x, y, 0}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂
  initialBoundary : uniform.boundary
  sameParityOutcomes :
    ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
    ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
    Prop
  containmentOrder :
    ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
    NonFringeContainmentOrder
  orderOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder
  automatonOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> AState
  Boundary : Type (max u v x y)
  EdgeType : Type
  basis :
    FiniteRegularTestBasis.{max u v x y, 0, max u v x y}
      Boundary EdgeType
  repairClauses : RegularTestBasisRepairClauses basis
  pathOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> TypedPath EdgeType
  repairAtomRefinesAContinuation :
    ∀ c c' :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      repairClauses.quotient.encode (pathOfHistory c.1.history) =
        repairClauses.quotient.encode (pathOfHistory c'.1.history) ->
        AContinuationEquivalent sameParityOutcomes containmentOrder c.1 c'.1
  updateClosed : Prop
  updateClosed_proof : updateClosed
  preservesDynamicHierarchy : Prop
  preservesDynamicHierarchy_proof : preservesDynamicHierarchy
  transitionRelationEffective : Prop
  transitionRelationEffective_proof : transitionRelationEffective
  finiteGame :
    FiniteDynamicHierarchyParityGame.{max u v x y, max u v x y}
  finiteGameRealizableIff :
    finiteGame.realizable ↔
      ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution σ env)

