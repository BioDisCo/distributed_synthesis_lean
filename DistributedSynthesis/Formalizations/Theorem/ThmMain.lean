  blockStateFinite : Fintype BlockState
  stateOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> BlockState
  envsOfState :
    BlockState -> List (EnvironmentRound In₁ In₂)
  envs_bound :
