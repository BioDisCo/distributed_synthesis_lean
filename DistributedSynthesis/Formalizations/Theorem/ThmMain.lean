/--
Assemble the raw-factor representative decoder core from a truth-factorization
of the current receipt/order payload.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalReceiptFactorRawRepresentativeCoreForHeader.toRawFactorRepresentativeDecoderCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header : NoDirectDPAJournalBoundedLocalHeader In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalReceiptFactorRawRepresentativeCoreForHeader
        header) :
    NoDirectDPAJournalBoundedLocalRawFactorRepresentativeDecoderCoreForHeader
      header where
  envsOfHistory := core.envsOfHistory
  envs_bound := core.envs_bound
  envs_truth := core.envs_truth
  envs_append := core.envs_append
  truthOfHistory_eq := core.truthOfHistory_eq
  rawEpochOfTruth := core.rawEpochOfTruth
  rawEpoch_factor := core.rawEpoch_factor
  automatonOfTruth := core.automatonOfTruth
  automaton_factor := core.automaton_factor
  decodeReceiptOrderOfTruth := core.receiptOrderOfTruth
  decodesCurrent := by
    intro pref r
    calc
      core.receiptOrderOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (History.append pref r))) =
          currentReceiptOrderData (History.append pref r)
            (header.orderOfHistory (History.append pref r)) := by
            exact (core.receiptOrder_factor (History.append pref r)).symm
      _ =
          currentReceiptOrderData (History.append pref r)
            (graphContainmentOrder r.graph) := by
            rw [core.orderOfAppend pref r]
      _ = currentReceiptOrderDataForAppend pref r := rfl
  orderOfAppend := core.orderOfAppend
  coherentHistoryAppend := core.coherentHistoryAppend
  parityOfTruth := core.parityOfTruth
  parity_factor := core.parity_factor

/--
Factor maps imply the equality-determinacy core.

This bridge connects the older decoder/factor route to the sharper
theorem-facing interface below: once raw epoch state, automaton state,
receipt/order payload, and parity progress are all explicit functions of the
stabilized truth atom, equality of truth atoms gives exactly the componentwise
determinacy required by the equality core.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalReceiptFactorRawRepresentativeCoreForHeader.toEqualityRepresentativeCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header : NoDirectDPAJournalBoundedLocalHeader In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalReceiptFactorRawRepresentativeCoreForHeader
        header) :
    NoDirectDPAJournalBoundedLocalEqualityRepresentativeCoreForHeader
      header where
  envsOfHistory := core.envsOfHistory
  envs_bound := core.envs_bound
  envs_truth := core.envs_truth
  envs_append := core.envs_append
  truthOfHistory_eq := core.truthOfHistory_eq
  truthVectorDeterminesRawAutomatonState := by
    intro hcont h h' htruth
    apply Prod.ext
    · calc
        header.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h =
            core.rawEpochOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h)) := by
              exact
                (core.rawEpoch_factor
                  header.cert.determinesPathData_proof
                  header.cert.predecessorClosed_proof
                  header.cert.boundaryClosed_proof
                  hcont h).symm
        _ =
            core.rawEpochOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h')) := by
              rw [htruth]
        _ =
            header.importedUniform.noDirectEpochStateAfterHistory
              header.initialBoundary h' := by
              exact
                core.rawEpoch_factor
                  header.cert.determinesPathData_proof
                  header.cert.predecessorClosed_proof
                  header.cert.boundaryClosed_proof
                  hcont h'
    · calc
        header.automatonOfHistory h =
            core.automatonOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h)) := by
              exact (core.automaton_factor hcont h).symm
        _ =
            core.automatonOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h')) := by
              rw [htruth]
        _ = header.automatonOfHistory h' := by
              exact core.automaton_factor hcont h'
  receiptOrder_eq_of_truth_eq := by
    intro h h' htruth
    calc
      currentReceiptOrderData h (header.orderOfHistory h) =
          core.receiptOrderOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h)) :=
            core.receiptOrder_factor h
      _ =
          core.receiptOrderOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h')) := by
            rw [htruth]
      _ = currentReceiptOrderData h' (header.orderOfHistory h') := by
            exact (core.receiptOrder_factor h').symm
  orderOfAppend := core.orderOfAppend
  coherentHistoryAppend := core.coherentHistoryAppend
  parityOfHistory_eq_of_truth_eq := by
    intro h h' htruth
    calc
      header.parityOfHistory h =
          core.parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h)) :=
            core.parity_factor h
      _ =
          core.parityOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h')) := by
            rw [htruth]
      _ = header.parityOfHistory h' := by
            exact (core.parity_factor h').symm

/--
The standard no-direct closure invariant package supplies the raw epoch and
automaton parts of the equality representative core.
-/
