/--
Journal-imported bounded-local determinacy inputs for the no-direct restricted
certificate route.

Unlike the current-order global endpoint below, this record asks directly for
append decompositions of the bounded representatives and coherent histories in
the carrier.  That is the form compatible with the bounded-local carrier
obstruction recorded in `PropNodirectsaturationSkeleton`.
-/
structure NoDirectDPAJournalBoundedLocalDeterminacyCertificateLeanInputs
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  AState : Type (max u v x y)
  aStateFinite : Fintype AState
  baseUniform :
    UniformOneDirectionalFiniteIndexLemma.{max u v x y, u, v, x, y, 0}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂
  monitor :
    SynchronizedBlockRegularMonitor.{u, v, x, y, max u v x y}
      In₁ In₂ Out₁ Out₂
  initialBoundary :
    (Classical.choose
      (journal_gives_uniform
        baseUniform monitor baseUniform.continuationInvariant
        baseUniform.regularRepresentation)).boundary
  containmentOrder :
    ContinuationConfiguration In₁ In₂ Out₁ Out₂ AState ->
    NonFringeContainmentOrder
  orderOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> NonFringeContainmentOrder
  automatonOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> AState
  ParityProgress : Type (max u v x y)
  parityOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> ParityProgress
  SatAlphabet : Type (max u v x y)
  Boundary : Type (max u v x y)
  EdgeType : Type
  sat :
    RegularTestSaturation.{max u v x y, 0, max u v x y, u, v,
      max u v x y}
      SatAlphabet EdgeType Boundary In₁ In₂
  n : Nat
  cert : StabilizedSaturationBasisCertificate sat n
  edgeOfRound : RoundRecord In₁ In₂ Graph Out₁ Out₂ -> EdgeType
  σ : StrategyPair In₁ In₂ Out₁ Out₂
  generationBound : Nat
  truthOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ ->
      RegularTestTruthAtom (stabilizedSaturationBasis cert)
  envsOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      (envsOfHistory h).length ≤ generationBound
  envs_truth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistoryByRound edgeOfRound
          (executionPrefixFromList σ (envsOfHistory h))) =
        truthOfHistory h
  envs_append :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          executionPrefixFromList σ (envsOfHistory h) =
            History.append pref r
  truthOfHistory_eq :
    ∀ c :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
    truthOfHistory c.1.history =
      regularTestTruthVector (stabilizedSaturationBasis cert)
        (pathOfHistoryByRound edgeOfRound c.1.history)
  splitFactorization :
    StabilizedSaturationBasisNoDirectSplitQuotientFactorization
      (Classical.choose
        (journal_gives_uniform
          baseUniform monitor baseUniform.continuationInvariant
          baseUniform.regularRepresentation))
      initialBoundary cert (pathOfHistoryByRound edgeOfRound)
      containmentOrder orderOfHistory automatonOfHistory
  appendTruthDeterminesReceiptOrder :
    ∀ (pref pref' : History In₁ In₂ Graph Out₁ Out₂)
      (r r' : RoundRecord In₁ In₂ Graph Out₁ Out₂),
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound (History.append pref r)) =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound (History.append pref' r')) ->
      currentReceiptOrderDataForAppend pref r =
        currentReceiptOrderDataForAppend pref' r'
  orderOfAppend :
    ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
      ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        orderOfHistory (History.append pref r) = graphContainmentOrder r.graph
  coherentHistoryAppend :
    ∀ c :
      CoherentContinuationConfiguration
        containmentOrder orderOfHistory automatonOfHistory,
      ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          c.1.history = History.append pref r
  parityOfHistory_eq_of_truth_eq :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis cert)
          (pathOfHistoryByRound edgeOfRound h') ->
      parityOfHistory h = parityOfHistory h'
  updateClosed : Prop
  updateClosed_proof : updateClosed
  preservesDynamicHierarchy : Prop
  preservesDynamicHierarchy_proof : preservesDynamicHierarchy
  transitionRelationEffective : Prop
  transitionRelationEffective_proof : transitionRelationEffective
  finiteFringeCompilation : Prop
  finiteFringeCompilation_proof : finiteFringeCompilation
  boundaryAndBlockTransitionsEffective : Prop
  boundaryAndBlockTransitionsEffective_proof :
