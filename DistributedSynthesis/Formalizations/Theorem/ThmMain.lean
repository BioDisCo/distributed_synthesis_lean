/--
Raw-factor canonical form of the represented-truth payload core.

For the actual-truth header, the automaton and parity components already factor
definitionally through the stabilized truth atom, and append-order correctness
is exactly `historyCurrentContainmentOrder_append`.  This record therefore
leaves only the genuinely remaining no-direct-reversal finite-state content:
generated truth representatives, the raw epoch factor, receipt/order decoding,
coherent-history nonemptiness, and the canonical containment equation.
-/
structure NoDirectDPAJournalBoundedLocalRawFactorCanonicalCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  Summary₂ : Type (max u v x y)
  stateOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ ->
      { truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert) //
        ∃ envs : List (EnvironmentRound In₁ In₂),
          envs.length ≤ header.generationBound ∧
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (executionPrefixFromList header.σ envs)) = truth ∧
          ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
            ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
              executionPrefixFromList header.σ envs = History.append pref r }
  state_truth_eq :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        header.toCurrentOrderHeader.automatonOfHistory,
    (stateOfHistory c.1.history).1 =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound c.1.history)
  rawEpochOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
      EpochRotatingAccessState
        header.toCurrentOrderHeader.toHeader.importedUniform.boundary
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two)
  rawEpoch_factor :
    header.cert.determinesPathData ->
    header.cert.predecessorClosed ->
    (∀ boundaryState, header.cert.boundaryClosed boundaryState) ->
    header.cert.continuationClosed ->
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        rawEpochOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h)) =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h
  summaryUnit : Summary₂
  decodeReceiptOrder :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) × Summary₂ ->
      ReceiptOrderData
  decodesCurrent :
    ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
      ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        decodeReceiptOrder
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound (History.append pref r)),
              summaryUnit) =
          currentReceiptOrderDataForAppend pref r
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        header.toCurrentOrderHeader.automatonOfHistory,
      c.1.history ≠ []
  canonicalContainment :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      header.containmentOrder {
        history := h
        automatonState := header.toCurrentOrderHeader.automatonOfHistory h
        receiptOne := (currentView Proc.one h).receiptTag
        receiptTwo := (currentView Proc.two h).receiptTag
      } = historyCurrentContainmentOrder h

/--
The raw-factor canonical target supplies the canonical represented-truth
payload core.  The actual-truth header discharges the automaton and parity
factorization components by unfolding.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalRawFactorCanonicalCoreForActualTruthAutomatonParityCurrentOrderHeader.toCanonicalRepresentedTruthPayloadAppendCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalRawFactorCanonicalCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalCanonicalRepresentedTruthPayloadAppendCoreForActualTruthAutomatonParityCurrentOrderHeader
      header := by
  classical
  refine
    { payload :=
        StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureSummaryParityPayload.of_rawAutomatonStateEq
          header.toCurrentOrderHeader.toHeader.importedUniform
          header.initialBoundary
          header.cert
          header.edgeOfRound
          header.containmentOrder
          historyCurrentContainmentOrder
          header.toCurrentOrderHeader.automatonOfHistory
          header.toCurrentOrderHeader.toHeader.parityOfHistory
          header.σ
          header.generationBound
          core.stateOfHistory
          core.state_truth_eq
          ?truthVectorDeterminesRawAutomatonState
          core.summaryUnit
          core.decodeReceiptOrder
          core.decodesCurrent
          (fun pref r => historyCurrentContainmentOrder_append pref r)
          (fun c => history_eq_append_of_ne_nil (core.coherentHistoryNonempty c))
          (fun truth => header.parityOfAutomaton (header.automatonOfTruth truth))
          ?parity_factor
      canonicalContainment := core.canonicalContainment }
  · intro _ h h' htruth
    apply Prod.ext
    · calc
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h =
          core.rawEpochOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h)) := by
            exact
              (core.rawEpoch_factor
                header.cert.determinesPathData_proof
                header.cert.predecessorClosed_proof
                header.cert.boundaryClosed_proof
                header.cert.continuationClosed_proof h).symm
        _ =
          core.rawEpochOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h')) := by
            rw [htruth]
        _ =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h' := by
            exact
              core.rawEpoch_factor
                header.cert.determinesPathData_proof
                header.cert.predecessorClosed_proof
                header.cert.boundaryClosed_proof
                header.cert.continuationClosed_proof h'
    · change
        header.automatonOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h)) =
          header.automatonOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h'))
      rw [htruth]
  · intro h
    rfl

/--
Raw-factor target for the canonical actual-truth current-order header.

This is the sharpest current interface: canonical containment is no longer a
field because the header fixes the containment order to
`historyCurrentContainmentOrder` definitionally.
-/
structure NoDirectDPAJournalBoundedLocalRawFactorCoreForCanonicalActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalCanonicalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  Summary₂ : Type (max u v x y)
  stateOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ ->
      { truth :
          RegularTestTruthAtom
            (stabilizedSaturationBasis header.toActualTruthHeader.cert) //
        ∃ envs : List (EnvironmentRound In₁ In₂),
          envs.length ≤ header.toActualTruthHeader.generationBound ∧
          regularTestTruthVector
              (stabilizedSaturationBasis header.toActualTruthHeader.cert)
            (pathOfHistoryByRound header.toActualTruthHeader.edgeOfRound
              (executionPrefixFromList header.toActualTruthHeader.σ envs)) =
            truth ∧
          ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
            ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
              executionPrefixFromList header.toActualTruthHeader.σ envs =
                History.append pref r }
  state_truth_eq :
    ∀ c :
      CoherentContinuationConfiguration
        header.toActualTruthHeader.containmentOrder
        historyCurrentContainmentOrder
        header.toActualTruthHeader.toCurrentOrderHeader.automatonOfHistory,
    (stateOfHistory c.1.history).1 =
      regularTestTruthVector
        (stabilizedSaturationBasis header.toActualTruthHeader.cert)
        (pathOfHistoryByRound header.toActualTruthHeader.edgeOfRound
          c.1.history)
  rawEpochOfTruth :
    RegularTestTruthAtom
        (stabilizedSaturationBasis header.toActualTruthHeader.cert) ->
      EpochRotatingAccessState
        header.toActualTruthHeader.toCurrentOrderHeader.toHeader.importedUniform.boundary
        (header.toActualTruthHeader.toCurrentOrderHeader.toHeader.importedUniform.summary
          Proc.one)
        (header.toActualTruthHeader.toCurrentOrderHeader.toHeader.importedUniform.summary
          Proc.two)
  rawEpoch_factor :
    header.toActualTruthHeader.cert.determinesPathData ->
    header.toActualTruthHeader.cert.predecessorClosed ->
    (∀ boundaryState,
      header.toActualTruthHeader.cert.boundaryClosed boundaryState) ->
    header.toActualTruthHeader.cert.continuationClosed ->
      ∀ h : History In₁ In₂ Graph Out₁ Out₂,
        rawEpochOfTruth
            (regularTestTruthVector
              (stabilizedSaturationBasis header.toActualTruthHeader.cert)
              (pathOfHistoryByRound header.toActualTruthHeader.edgeOfRound h)) =
          header.toActualTruthHeader.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.toActualTruthHeader.initialBoundary h
  summaryUnit : Summary₂
  decodeReceiptOrder :
    RegularTestTruthAtom
        (stabilizedSaturationBasis header.toActualTruthHeader.cert) ×
      Summary₂ ->
      ReceiptOrderData
  decodesCurrent :
    ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
      ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        decodeReceiptOrder
            (regularTestTruthVector
              (stabilizedSaturationBasis header.toActualTruthHeader.cert)
              (pathOfHistoryByRound header.toActualTruthHeader.edgeOfRound
                (History.append pref r)),
              summaryUnit) =
          currentReceiptOrderDataForAppend pref r
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.toActualTruthHeader.containmentOrder
        historyCurrentContainmentOrder
        header.toActualTruthHeader.toCurrentOrderHeader.automatonOfHistory,
      c.1.history ≠ []

/--
The canonical-header raw-factor target supplies the previous raw-factor
canonical core; the canonical-containment equation is definitional.
-/
def
    NoDirectDPAJournalBoundedLocalRawFactorCoreForCanonicalActualTruthAutomatonParityCurrentOrderHeader.toRawFactorCanonicalCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalCanonicalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalRawFactorCoreForCanonicalActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalRawFactorCanonicalCoreForActualTruthAutomatonParityCurrentOrderHeader
      header.toActualTruthHeader where
  Summary₂ := core.Summary₂
  stateOfHistory := core.stateOfHistory
