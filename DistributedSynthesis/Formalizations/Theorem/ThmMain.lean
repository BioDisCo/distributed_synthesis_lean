            (regularTestTruthVector
              (stabilizedSaturationBasis header.toActualTruthHeader.cert)
              (pathOfHistoryByRound header.toActualTruthHeader.edgeOfRound h)) =
          header.toActualTruthHeader.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
