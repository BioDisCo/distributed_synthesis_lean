    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalBlockwiseFiniteIndexCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalActualTruthClosureInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfHistory := fun h => core.envsOfState (core.stateOfHistory h)
  envs_bound := fun h => core.envs_bound (core.stateOfHistory h)
  envs_actualTruth := core.envs_actualTruth
  envs_nonempty := core.envs_nonempty
  closureInvariants := core.closureInvariants
  receiptOrder_invariant := by
    intro h h' htruth
    calc
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
          core.receiptOrderOfState (core.stateOfHistory h) :=
            core.receiptOrder_state h
      _ =
          core.receiptOrderOfState
            (core.stateOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h))) := by
            rw [core.state_truth_factor h]
      _ =
          core.receiptOrderOfState
            (core.stateOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h'))) := by
            rw [htruth]
      _ =
          core.receiptOrderOfState (core.stateOfHistory h') := by
            rw [core.state_truth_factor h']
      _ =
          currentReceiptOrderData h' (historyCurrentContainmentOrder h') :=
            (core.receiptOrder_state h').symm
  coherentHistoryNonempty := core.coherentHistoryNonempty

/--
Realized-truth-atom representative form of the corrected current-order core.

This is the finite quotient statement closest to the intended mathematics:
for each stabilized truth atom that is realized by some history, choose one
bounded nonempty generated representative realizing that atom.  The
history-indexed representative function of the invariance core is derived by
applying this choice to the actual truth atom of the history.
-/
structure NoDirectDPAJournalBoundedLocalRealizedTruthRepresentativeInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
      List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth ->
      (envsOfTruth truth).length ≤ header.generationBound
  envs_realizes :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth ->
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ (envsOfTruth truth))) =
        truth
  envs_nonempty :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth ->
      envsOfTruth truth ≠ []
  rawEpochState_invariant :
    header.cert.determinesPathData ->
    header.cert.predecessorClosed ->
    (∀ boundaryState, header.cert.boundaryClosed boundaryState) ->
    header.cert.continuationClosed ->
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h') ->
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h'
  receiptOrder_invariant :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h')
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/-- Convert realized-truth representatives to the history-indexed invariance core. -/
noncomputable def
    NoDirectDPAJournalBoundedLocalRealizedTruthRepresentativeInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader.toInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalRealizedTruthRepresentativeInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalActualTruthInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfHistory :=
    fun h =>
      core.envsOfTruth
        (regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h))
  envs_bound := by
    intro h
    exact
      core.envs_bound
        (regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h))
        ⟨h, rfl⟩
  envs_actualTruth := by
    intro h
    exact
      core.envs_realizes
        (regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h))
        ⟨h, rfl⟩
  envs_nonempty := by
    intro h
    exact
      core.envs_nonempty
        (regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h))
        ⟨h, rfl⟩
  rawEpochState_invariant := core.rawEpochState_invariant
  receiptOrder_invariant := core.receiptOrder_invariant
  coherentHistoryNonempty := core.coherentHistoryNonempty

/--
Finite-quotient form of the realized-truth representative invariant core.

The quotient has finitely many states.  Each realized stabilized truth atom is
assigned to a quotient state carrying that atom, and every quotient state has a
bounded nonempty generated representative realizing its carried atom.
-/
structure NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  Q : Type (max u v x y)
  qFinite : Fintype Q
  truthOf :
    Q -> RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  stateOfRealizedTruth :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth ->
      Q
  state_truth_eq :
    ∀ (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
      (hreal :
        StabilizedSaturationBasisNoDirectRealizedTruthAtom
          header.cert (pathOfHistoryByRound header.edgeOfRound) truth),
      truthOf (stateOfRealizedTruth truth hreal) = truth
  envsOf : Q -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ q : Q, (envsOf q).length ≤ header.generationBound
  envs_realizes :
    ∀ q : Q,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ (envsOf q))) =
        truthOf q
  envs_nonempty :
    ∀ q : Q, envsOf q ≠ []
  rawEpochState_invariant :
    header.cert.determinesPathData ->
    header.cert.predecessorClosed ->
    (∀ boundaryState, header.cert.boundaryClosed boundaryState) ->
    header.cert.continuationClosed ->
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h') ->
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h'
  receiptOrder_invariant :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h')
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

attribute [instance]
  NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader.qFinite

/-- Convert the finite truth quotient into realized-truth representatives. -/
noncomputable def
    NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader.toRealizedTruthRepresentativeInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalRealizedTruthRepresentativeInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
      header := by
  classical
  let actualTruth :=
    fun h : History In₁ In₂ Graph Out₁ Out₂ =>
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  let realized :=
    fun truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert) =>
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth
  let defaultTruth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert) :=
    actualTruth ([] : History In₁ In₂ Graph Out₁ Out₂)
  have hdefaultRealized : realized defaultTruth := ⟨[], rfl⟩
  let defaultState : core.Q :=
    core.stateOfRealizedTruth defaultTruth hdefaultRealized
  let envsOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
        List (EnvironmentRound In₁ In₂) :=
    fun truth =>
      if hreal : realized truth then
        core.envsOf (core.stateOfRealizedTruth truth hreal)
      else
        core.envsOf defaultState
  refine
    { envsOfTruth := envsOfTruth
      envs_bound := ?_
      envs_realizes := ?_
      envs_nonempty := ?_
      rawEpochState_invariant := core.rawEpochState_invariant
      receiptOrder_invariant := core.receiptOrder_invariant
      coherentHistoryNonempty := core.coherentHistoryNonempty }
  · intro truth hreal
    dsimp [envsOfTruth, realized]
    rw [dif_pos hreal]
    exact core.envs_bound (core.stateOfRealizedTruth truth hreal)
  · intro truth hreal
    dsimp [envsOfTruth, realized]
    rw [dif_pos hreal]
    calc
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ
              (core.envsOf (core.stateOfRealizedTruth truth hreal)))) =
          core.truthOf (core.stateOfRealizedTruth truth hreal) :=
            core.envs_realizes (core.stateOfRealizedTruth truth hreal)
      _ = truth := core.state_truth_eq truth hreal
  · intro truth hreal
    dsimp [envsOfTruth, realized]
    rw [dif_pos hreal]
    exact core.envs_nonempty (core.stateOfRealizedTruth truth hreal)

/--
Bridge from the existing coherent truth-vector quotient certificate to the
finite-truth-quotient invariant core used by the restricted main theorem.

The older quotient certificate only labels coherent continuation
configurations.  The canonical representative hypothesis turns every history
into a coherent configuration with the same current receipt/order header, so it
extends the quotient map to every realized stabilized truth atom.  The
truth-vector quotient already carries equality of the enriched no-direct state,
so raw epoch-state and current receipt/order invariance are extracted from
that equality.
-/
structure NoDirectDPAJournalBoundedLocalTruthVectorQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  truthQuotient :
    StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
      header.toCurrentOrderHeader.toHeader.parityOfHistory
      header.σ
      header.generationBound
  representatives :
    StabilizedSaturationBasisCanonicalCoherentHistoryRepresentatives
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  quotient_envs_nonempty :
    ∀ q : truthQuotient.Q, truthQuotient.envsOf q ≠ []
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
Use canonical coherent representatives to extend a coherent truth-vector
quotient to all realized stabilized truth atoms.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalTruthVectorQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader.toFiniteTruthQuotientInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalTruthVectorQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
      header := by
  classical
  let tq := core.truthQuotient
  let actualTruth :=
    fun h : History In₁ In₂ Graph Out₁ Out₂ =>
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  refine
    { Q := tq.Q
      qFinite := tq.qFinite
      truthOf := tq.truthOf
      stateOfRealizedTruth := ?_
      state_truth_eq := ?_
      envsOf := tq.envsOf
      envs_bound := tq.envs_length_le
      envs_realizes := tq.representative_truth_eq
      envs_nonempty := core.quotient_envs_nonempty
      rawEpochState_invariant := ?_
      receiptOrder_invariant := ?_
      coherentHistoryNonempty := core.coherentHistoryNonempty }
  · intro truth hreal
    exact tq.stateOfHistory (Classical.choose hreal)
  · intro truth hreal
    let h : History In₁ In₂ Graph Out₁ Out₂ := Classical.choose hreal
    have htruth : actualTruth h = truth := Classical.choose_spec hreal
    let c :=
      stabilizedSaturationBasisCanonicalCoherentConfigOfHistory
        core.representatives h
    calc
      tq.truthOf (tq.stateOfHistory h) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound c.1.history) := by
            simpa [tq, c] using tq.state_truth_eq c
      _ = actualTruth h := by
            simp [actualTruth, c]
      _ = truth := htruth
  · intro _hdet _hpred _hboundary _hcont h h' htruth
    let c :=
      stabilizedSaturationBasisCanonicalCoherentConfigOfHistory
        core.representatives h
    let c' :=
      stabilizedSaturationBasisCanonicalCoherentConfigOfHistory
        core.representatives h'
    have hstate :
        tq.truthOf (tq.stateOfHistory h) = actualTruth h := by
      calc
        tq.truthOf (tq.stateOfHistory h) =
            regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound c.1.history) := by
              simpa [tq, c] using tq.state_truth_eq c
        _ = actualTruth h := by
              simp [actualTruth, c]
    have hstate' :
        tq.truthOf (tq.stateOfHistory h') = actualTruth h' := by
      calc
        tq.truthOf (tq.stateOfHistory h') =
            regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound c'.1.history) := by
              simpa [tq, c'] using tq.state_truth_eq c'
        _ = actualTruth h' := by
              simp [actualTruth, c']
    have hquotTruth :
        tq.truthOf (tq.stateOfHistory h) =
          tq.truthOf (tq.stateOfHistory h') := by
      calc
        tq.truthOf (tq.stateOfHistory h) = actualTruth h := hstate
        _ = actualTruth h' := htruth
        _ = tq.truthOf (tq.stateOfHistory h') := hstate'.symm
    have hfull :
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateWithAContinuationData
            header.initialBoundary historyCurrentContainmentOrder
            header.toCurrentOrderHeader.automatonOfHistory
            header.toCurrentOrderHeader.toHeader.parityOfHistory h =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateWithAContinuationData
            header.initialBoundary historyCurrentContainmentOrder
            header.toCurrentOrderHeader.automatonOfHistory
            header.toCurrentOrderHeader.toHeader.parityOfHistory h' := by
      calc
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateWithAContinuationData
            header.initialBoundary historyCurrentContainmentOrder
            header.toCurrentOrderHeader.automatonOfHistory
            header.toCurrentOrderHeader.toHeader.parityOfHistory h =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateWithAContinuationData
            header.initialBoundary historyCurrentContainmentOrder
            header.toCurrentOrderHeader.automatonOfHistory
            header.toCurrentOrderHeader.toHeader.parityOfHistory
            (executionPrefixFromList header.σ
              (tq.envsOf (tq.stateOfHistory h))) := by
              simpa [tq, c] using tq.quotientEnrichedState_eq c
        _ =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateWithAContinuationData
            header.initialBoundary historyCurrentContainmentOrder
            header.toCurrentOrderHeader.automatonOfHistory
            header.toCurrentOrderHeader.toHeader.parityOfHistory
            (executionPrefixFromList header.σ
              (tq.envsOf (tq.stateOfHistory h'))) :=
              tq.representativeEnriched_eq_of_truthOf_eq
                (tq.stateOfHistory h) (tq.stateOfHistory h') hquotTruth
        _ =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateWithAContinuationData
            header.initialBoundary historyCurrentContainmentOrder
            header.toCurrentOrderHeader.automatonOfHistory
            header.toCurrentOrderHeader.toHeader.parityOfHistory h' := by
              symm
              simpa [tq, c'] using tq.quotientEnrichedState_eq c'
    exact congrArg (fun state => state.1.1.1) hfull
  · intro h h' htruth
    let c :=
      stabilizedSaturationBasisCanonicalCoherentConfigOfHistory
        core.representatives h
    let c' :=
      stabilizedSaturationBasisCanonicalCoherentConfigOfHistory
        core.representatives h'
    have hstate :
        tq.truthOf (tq.stateOfHistory h) = actualTruth h := by
      calc
        tq.truthOf (tq.stateOfHistory h) =
            regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound c.1.history) := by
              simpa [tq, c] using tq.state_truth_eq c
        _ = actualTruth h := by
              simp [actualTruth, c]
    have hstate' :
        tq.truthOf (tq.stateOfHistory h') = actualTruth h' := by
      calc
        tq.truthOf (tq.stateOfHistory h') =
            regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound c'.1.history) := by
              simpa [tq, c'] using tq.state_truth_eq c'
        _ = actualTruth h' := by
              simp [actualTruth, c']
    have hquotTruth :
        tq.truthOf (tq.stateOfHistory h) =
          tq.truthOf (tq.stateOfHistory h') := by
      calc
        tq.truthOf (tq.stateOfHistory h) = actualTruth h := hstate
        _ = actualTruth h' := htruth
        _ = tq.truthOf (tq.stateOfHistory h') := hstate'.symm
    have hfull :
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateWithAContinuationData
            header.initialBoundary historyCurrentContainmentOrder
            header.toCurrentOrderHeader.automatonOfHistory
            header.toCurrentOrderHeader.toHeader.parityOfHistory h =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateWithAContinuationData
            header.initialBoundary historyCurrentContainmentOrder
            header.toCurrentOrderHeader.automatonOfHistory
            header.toCurrentOrderHeader.toHeader.parityOfHistory h' := by
      calc
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateWithAContinuationData
            header.initialBoundary historyCurrentContainmentOrder
            header.toCurrentOrderHeader.automatonOfHistory
            header.toCurrentOrderHeader.toHeader.parityOfHistory h =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateWithAContinuationData
            header.initialBoundary historyCurrentContainmentOrder
            header.toCurrentOrderHeader.automatonOfHistory
            header.toCurrentOrderHeader.toHeader.parityOfHistory
            (executionPrefixFromList header.σ
              (tq.envsOf (tq.stateOfHistory h))) := by
              simpa [tq, c] using tq.quotientEnrichedState_eq c
        _ =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateWithAContinuationData
            header.initialBoundary historyCurrentContainmentOrder
            header.toCurrentOrderHeader.automatonOfHistory
            header.toCurrentOrderHeader.toHeader.parityOfHistory
            (executionPrefixFromList header.σ
              (tq.envsOf (tq.stateOfHistory h'))) :=
              tq.representativeEnriched_eq_of_truthOf_eq
                (tq.stateOfHistory h) (tq.stateOfHistory h') hquotTruth
        _ =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateWithAContinuationData
            header.initialBoundary historyCurrentContainmentOrder
            header.toCurrentOrderHeader.automatonOfHistory
            header.toCurrentOrderHeader.toHeader.parityOfHistory h' := by
              symm
              simpa [tq, c'] using tq.quotientEnrichedState_eq c'
    exact congrArg (fun state => state.1.1.2) hfull

/--
Append-decomposition form of the truth-vector quotient core.

Most saturation payloads naturally prove that every coherent continuation
history is an appended prefix, rather than proving nonemptiness directly.  This
record exposes that natural premise and derives the nonempty-history field
needed by the lower-level endpoint.
-/
structure NoDirectDPAJournalBoundedLocalTruthVectorQuotientAppendCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  truthQuotient :
    StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
      header.toCurrentOrderHeader.toHeader.parityOfHistory
      header.σ
      header.generationBound
  representatives :
    StabilizedSaturationBasisCanonicalCoherentHistoryRepresentatives
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  quotient_envs_nonempty :
    ∀ q : truthQuotient.Q, truthQuotient.envsOf q ≠ []
  coherentHistoryAppend :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      ∃ pref : History In₁ In₂ Graph Out₁ Out₂,
        ∃ r : RoundRecord In₁ In₂ Graph Out₁ Out₂,
          c.1.history = History.append pref r

/--
If a generated execution prefix is an appended history, then at least one
environment round was used.
-/
theorem executionPrefixFromList_ne_nil_of_eq_append
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    {envs : List (EnvironmentRound In₁ In₂)}
    (happend :
      ∃ pref : History In₁ In₂ Graph Out₁ Out₂,
        ∃ r : RoundRecord In₁ In₂ Graph Out₁ Out₂,
          executionPrefixFromList σ envs = History.append pref r) :
    envs ≠ [] := by
  intro hnil
  rcases happend with ⟨pref, r, hprefix⟩
  have hprefixEmpty :
      ([] : History In₁ In₂ Graph Out₁ Out₂) = History.append pref r := by
    simpa [hnil] using hprefix
  simpa [History.append] using hprefixEmpty

/-- Convert append-decomposition form to the nonempty-history form. -/
def
    NoDirectDPAJournalBoundedLocalTruthVectorQuotientAppendCoreForActualTruthAutomatonParityCurrentOrderHeader.toTruthVectorQuotientInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
