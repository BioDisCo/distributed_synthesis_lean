  receiptOrder_eq_of_truth_eq := core.receiptOrder_eq_of_truth_eq
  orderOfAppend := core.orderOfAppend
  coherentHistoryAppend := core.coherentHistoryAppend
  parityOfHistory_eq_of_truth_eq := core.parityOfHistory_eq_of_truth_eq

/--
Bounded generated-prefix determinacy supplies the raw part of the standard
closure-invariant representative core.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalBoundedGeneratedRepresentativeCoreForHeader.toClosureInvariantRepresentativeCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
