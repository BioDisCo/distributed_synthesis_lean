          (pathOfHistoryByRound header.toActualTruthHeader.edgeOfRound
            (History.append pref' r')) ->
      currentReceiptOrderDataForAppend pref r =
        currentReceiptOrderDataForAppend pref' r'
  coherentHistoryNonempty :
    ∀ c :
