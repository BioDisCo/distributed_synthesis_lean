/--
Current-view equality determines the canonical current containment order.

The only information used by `historyCurrentContainmentOrder` is the last
graph.  Joint current views determine the whole graph sequence, hence in
particular this last graph and the induced order.  The list-last extraction is
routine and intentionally isolated here.
-/
theorem historyCurrentContainmentOrder_eq_of_currentViews_eq
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    {h h' : History In₁ In₂ Graph Out₁ Out₂}
    (hviews :
      (currentView Proc.one h, currentView Proc.two h) =
        (currentView Proc.one h', currentView Proc.two h')) :
    historyCurrentContainmentOrder h = historyCurrentContainmentOrder h' := by
  have hviewOne : currentView Proc.one h = currentView Proc.one h' :=
    congrArg Prod.fst hviews
  have hviewTwo : currentView Proc.two h = currentView Proc.two h' :=
    congrArg Prod.snd hviews
  have hgraphs :
      History.graphSequence h = History.graphSequence h' :=
    (jointViews_determine_inputGraphHistory h h' hviewOne hviewTwo).1
  have hrevgraphs :
      h.reverse.map RoundRecord.graph = h'.reverse.map RoundRecord.graph := by
    simpa [History.graphSequence, List.map_reverse] using
      congrArg List.reverse hgraphs
  unfold historyCurrentContainmentOrder
  cases hrev : h.reverse with
  | nil =>
      cases hrev' : h'.reverse with
      | nil =>
          simp [hrev, hrev']
      | cons r rs =>
          simp [hrev, hrev'] at hrevgraphs
  | cons r rs =>
      cases hrev' : h'.reverse with
      | nil =>
          simp [hrev, hrev'] at hrevgraphs
      | cons r' rs' =>
          simp [hrev, hrev'] at hrevgraphs
          simp [hrev, hrev', hrevgraphs]

