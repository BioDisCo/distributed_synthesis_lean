/-!
# Main theorem statement

This file formalizes the exact target proposition of `thm:main` from
`paper.tex`. The proof remains the downstream objective of the rest of the
development.
-/

namespace DistributedSynthesis

universe u v x y ap a b c d aut br lab tr h1 h2 r1 r2

/--
The verified main decidability target: every effectively compiled parity/LTL
specification has a decidable synthesis problem.  The compilation certificate is
part of `EffectiveParitySpecification`; arbitrary semantic predicates are not
claimed decidable here.
-/
abbrev MainResult (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y) :=
  ∀ φ : EffectiveParitySpecification.{u, v, x, y, a, b} In₁ In₂ Out₁ Out₂,
    Decidable (EffectiveParitySynthesisProblem φ)

/-- The formal statement of `thm:main` is definitionally equal to `MainResult`. -/
theorem main_result_eq
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y) :
    MainResult.{u, v, x, y, a, b} In₁ In₂ Out₁ Out₂ =
      ∀ φ : EffectiveParitySpecification.{u, v, x, y, a, b} In₁ In₂ Out₁ Out₂,
        Decidable (EffectiveParitySynthesisProblem φ) := by
  rfl

/-- The main result follows from the finite parity-game compilation carried by each specification. -/
@[reducible]
noncomputable def main_result
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y) :
    MainResult.{u, v, x, y, a, b} In₁ In₂ Out₁ Out₂ := by
  intro φ
  exact effective_parity_synthesis_problem_decidable φ

/--
Main-theorem corollary for arbitrary full LTL once the canonical state-wise
automata backend and finite-game compilation certificate have been supplied.

The formula is unrestricted; all remaining assumptions are contained in the
backend certificate, namely state-wise APA-to-DPA correctness and DPA-to-finite
dynamic-hierarchy game correctness.
-/
noncomputable def main_result_for_canonical_ltl_state_run_backend
    {AP : Type ap}
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    [DecidableEq AP]
    (cert :
      CanonicalLTLStateRunBackendCompilation.{u, v, x, y, ap, a, b}
        AP In₁ In₂ Out₁ Out₂) :
    Decidable
      (SynthesisProblem
        (fun word => LTL.Satisfies cert.interp word cert.formula)) :=
  cert.synthesis_decidable

/--
Main-theorem corollary for arbitrary full LTL through the more abstract
canonical backend certificate.
-/
noncomputable def main_result_for_canonical_ltl_backend
    {AP : Type ap}
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    [DecidableEq AP]
    (cert :
      CanonicalLTLBackendCompilation.{u, v, x, y, ap, a, b}
        AP In₁ In₂ Out₁ Out₂) :
    Decidable
      (SynthesisProblem
        (fun word => LTL.Satisfies cert.interp word cert.formula)) :=
  cert.synthesis_decidable

/--
Main-theorem corollary for arbitrary full LTL through the reusable automata
backend target and the paper-facing rational-run finite-game compiler.

The formula is unrestricted.  The two remaining mathematical inputs are exactly
the certified `until` constructor for the LTL-to-DPA backend and the uniform
rotating rational-run epoch compiler for DPA objectives.
-/
noncomputable def main_result_for_ltl_until_lar_rational_run_compiler
    {AP : Type ap}
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    [DecidableEq AP]
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (interp : AP -> RoundRecord In₁ In₂ Graph Out₁ Out₂ -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (untilC :
      LTLUntilDPAConstructor.{ap, max u v x y, aut} interp)
    (formula : LTL AP)
    (gameCompiler :
      DPARotatingRationalRunEpochCompiler.{u, v, x, y, ap, a, b, aut}
        In₁ In₂ Out₁ Out₂) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          LTL.Satisfies interp word formula)) :=
  ltl_until_lar_rational_run_compiler_synthesis_problem_decidable
    interp dec untilC formula gameCompiler

/--
Main-theorem corollary for arbitrary full LTL through any reusable certified
LTL-to-DPA compiler and any uniform finite-game compiler for DPA objectives.

This is the narrowest backend-independent endpoint: close automata compilation
to `LTLToDPACompiler`, close the paper-specific DPA-to-finite-game compiler,
and the main synthesis decidability statement follows directly.
-/
noncomputable def main_result_for_ltl_dpa_finite_game_compiler
    {AP : Type ap}
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    [DecidableEq AP]
    (compiler :
      LTLToDPACompiler.{ap, max u v x y, aut}
        AP
        (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (formula : LTL AP)
    (gameCompiler :
      DPAFiniteGameCompiler.{u, v, x, y, a} In₁ In₂ Out₁ Out₂) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          LTL.Satisfies compiler.interp word formula)) :=
  ltl_dpa_compiler_synthesis_problem_decidable
    compiler formula gameCompiler

/--
Main-theorem corollary for arbitrary full LTL through any certified LTL-to-DPA
compiler and a uniform family of no-direct-reversal finite-game certificates.

This is the no-direct certificate constructor for finite-game compilation: the remaining
paper-side theorem is exactly the construction of `certificate` for every DPA
objective, together with its realizability equivalence.
-/
noncomputable def main_result_for_ltl_dpa_noDirect_reversal_fragment_certificates
    {AP : Type ap}
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    [DecidableEq AP]
    (compiler :
      LTLToDPACompiler.{ap, max u v x y, aut}
        AP
        (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (formula : LTL AP)
    (certificate :
      ∀ A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        NoDirectReversalFragmentCertificate.{max u v x y, u, v, x, y, 0}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (realizableEquivalent :
      ∀ A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        (certificate A).Realizable ↔
          ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
            ∀ env : EnvironmentSequence In₁ In₂,
              A.Accepts (execution σ env)) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          LTL.Satisfies compiler.interp word formula)) :=
  main_result_for_ltl_dpa_finite_game_compiler
    In₁ In₂ Out₁ Out₂
    compiler
    formula
    (DPAFiniteGameCompiler.ofNoDirectReversalFragmentCertificates
      certificate
      realizableEquivalent)

/--
Main-theorem corollary, fragment form, END TO END: distributed synthesis of
full LTL over the no-direct-reversal fragment is decidable, through any
certified LTL-to-DPA compiler.

The reversal-forgiving companion of the compiled objective makes fragment
synthesis a full synthesis problem; its readback upgrade is discharged
unconditionally by the journal construction
(`reversalForgiving_readbackUpgrade`), so the only backend datum beyond the
LTL compiler is the input-free tree-automaton target family shared with the
unrestricted endpoints.
-/
noncomputable def main_result_for_ltl_dpa_noDirect_fragment_synthesis
    {AP : Type ap}
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    [DecidableEq AP]
    [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
    [DecidableEq In₁] [DecidableEq In₂]
    [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [Countable In₁] [Countable In₂] [Countable Out₁] [Countable Out₂]
    (compiler :
      LTLToDPACompiler.{ap, max u v x y, max u v x y} AP
        (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (formula : LTL AP)
    (Branch : Proc -> Type (max u v x y))
    (Label : Proc -> Type (max u v x y))
    (target :
      (d : Proc) ->
        InputFreeParityTreeAutomaton.{max u v x y, max u v x y,
          max u v x y} (Branch d) (Label d))
    (targetNonempty :
      ∀ d : Proc,
        ∃ tree : LabeledTree (Branch d) (Label d),
          (target d).acceptsTree tree) :
    Decidable
      (∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∀ env : EnvironmentSequence In₁ In₂,
          NoDirectReversalSequence env ->
            LTL.Satisfies compiler.interp (execution σ env) formula) :=
  letI : DecidableEq (compiler.compile formula).State := Classical.decEq _
  letI :
      Decidable
        (∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
          ∀ env : EnvironmentSequence In₁ In₂,
            NoDirectReversalSequence env ->
              (compiler.compile formula).Accepts (execution σ env)) :=
    DetParityAutomaton.dpa_noDirect_fragment_synthesis_decidable
      (compiler.compile formula) Branch Label target targetNonempty
  decidable_of_iff
    (∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      ∀ env : EnvironmentSequence In₁ In₂,
        NoDirectReversalSequence env ->
          (compiler.compile formula).Accepts (execution σ env))
    (exists_congr fun σ =>
      forall_congr' fun env =>
        imp_congr_right fun _ => compiler.correct formula (execution σ env))

/--
Main-theorem corollary, **full `{←,→,↔}` model**, END TO END: distributed
synthesis of full LTL over *every* environment (direct reversals included) is
decidable, through any certified LTL-to-DPA compiler, given the entry-indexed
measurability certificate `hcert` for the compiled objective.

No reversal-forgiving companion: the compiled objective is handled directly by
the full readback upgrade (`full_readbackUpgrade`), whose sole hypothesis is
`hcert` (paper `prop:starcomplete`).  Every other backend datum is the same as
in the fragment endpoint.
-/
noncomputable def main_result_for_ltl_dpa_full_synthesis
    {AP : Type ap}
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    [DecidableEq AP]
    [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
    [DecidableEq In₁] [DecidableEq In₂]
    [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [Countable In₁] [Countable In₂] [Countable Out₁] [Countable Out₂]
    (compiler :
      LTLToDPACompiler.{ap, max u v x y, max u v x y} AP
        (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (formula : LTL AP)
    (Branch : Proc -> Type (max u v x y))
    (Label : Proc -> Type (max u v x y))
    (target :
      (d : Proc) ->
        InputFreeParityTreeAutomaton.{max u v x y, max u v x y,
          max u v x y} (Branch d) (Label d))
    (targetNonempty :
      ∀ d : Proc,
        ∃ tree : LabeledTree (Branch d) (Label d),
          (target d).acceptsTree tree)
    [DecidableEq (compiler.compile formula).State]
    (hcert :
      DetParityAutomaton.EntryIndexedCertificate (In₁ := In₁)
        (compiler.compile formula)) :
    Decidable
      (∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∀ env : EnvironmentSequence In₁ In₂,
          LTL.Satisfies compiler.interp (execution σ env) formula) :=
  letI :
      Decidable
        (∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
          ∀ env : EnvironmentSequence In₁ In₂,
            (compiler.compile formula).Accepts (execution σ env)) :=
    DetParityAutomaton.dpa_full_synthesis_decidable
      (compiler.compile formula) Branch Label target targetNonempty hcert
  decidable_of_iff
    (∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      ∀ env : EnvironmentSequence In₁ In₂,
        (compiler.compile formula).Accepts (execution σ env))
    (exists_congr fun σ =>
      forall_congr' fun env =>
        compiler.correct formula (execution σ env))

/-- **Route B** LTL/DPA full-model synthesis: `main_result_for_ltl_dpa_full_synthesis`
with the summary-soundness certificate (true, `lem:fringe`) in place of the
entry-indexed certificate. -/
noncomputable def main_result_for_ltl_dpa_full_synthesis_route_b
    {AP : Type ap}
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    [DecidableEq AP]
    [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
    [DecidableEq In₁] [DecidableEq In₂]
    [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [Countable In₁] [Countable In₂] [Countable Out₁] [Countable Out₂]
    (compiler :
      LTLToDPACompiler.{ap, max u v x y, max u v x y} AP
        (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (formula : LTL AP)
    (Branch : Proc -> Type (max u v x y))
    (Label : Proc -> Type (max u v x y))
    (target :
      (d : Proc) ->
        InputFreeParityTreeAutomaton.{max u v x y, max u v x y,
          max u v x y} (Branch d) (Label d))
    (targetNonempty :
      ∀ d : Proc,
        ∃ tree : LabeledTree (Branch d) (Label d),
          (target d).acceptsTree tree)
    [DecidableEq (compiler.compile formula).State]
    (hcert :
      DetParityAutomaton.SummarySoundnessCertificate (In₁ := In₁)
        (A := compiler.compile formula)) :
    Decidable
      (∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∀ env : EnvironmentSequence In₁ In₂,
          LTL.Satisfies compiler.interp (execution σ env) formula) :=
  letI :
      Decidable
        (∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
          ∀ env : EnvironmentSequence In₁ In₂,
            (compiler.compile formula).Accepts (execution σ env)) :=
    DetParityAutomaton.dpa_full_synthesis_decidable_route_b
      (compiler.compile formula) Branch Label target targetNonempty hcert
  decidable_of_iff
    (∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      ∀ env : EnvironmentSequence In₁ In₂,
        (compiler.compile formula).Accepts (execution σ env))
    (exists_congr fun σ =>
      forall_congr' fun env =>
        compiler.correct formula (execution σ env))

/--
Backend obligations needed to build one no-direct-reversal certificate for a
deterministic parity objective.

This is the Lean certificate route for the restricted theorem.  The real
information-structure payload is explicit in the fields below; backend
obligations are carried as explicit fields of the record.
-/
structure NoDirectDPALeanCertificateBackendObligations
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  uniform :
    UniformOneDirectionalFiniteIndexLemma.{max u v x y, u, v, x, y, 0}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂
  State : Type (max u v x y)
  stateFinite : Fintype State
  finiteGame :
    FiniteDynamicHierarchyParityGame.{max u v x y, max u v x y}
  finiteGameRealizableIff :
    finiteGame.realizable ↔
      ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution σ env)
  finiteFringeCompilation : Prop
  boundaryAndBlockTransitionsEffective : Prop
  continuationPreservedBlockByBlock : Prop
  dynamicallyHierarchicalAfterFringeElim : Prop
  finiteFringeCompilation_proof : finiteFringeCompilation
  boundaryAndBlockTransitionsEffective_proof :
    boundaryAndBlockTransitionsEffective
  continuationPreservedBlockByBlock_proof :
    continuationPreservedBlockByBlock
  dynamicallyHierarchicalAfterFringeElim_proof :
    dynamicallyHierarchicalAfterFringeElim

/--
Assemble the no-direct-reversal certificate from the explicit backend
obligations.
-/
noncomputable def noDirectDPALeanCertificateOfBackendObligations
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (backend :
      NoDirectDPALeanCertificateBackendObligations
        In₁ In₂ Out₁ Out₂ A) :
    NoDirectReversalFragmentCertificate.{max u v x y, u, v, x, y, 0}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂ where
  uniform := backend.uniform
  State := backend.State
  stateFinite := backend.stateFinite
  Realizable :=
    ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      ∀ env : EnvironmentSequence In₁ In₂,
        A.Accepts (execution σ env)
  finiteGame := backend.finiteGame
  finiteGameRealizableIff := backend.finiteGameRealizableIff
  finiteFringeCompilation := backend.finiteFringeCompilation
  boundaryAndBlockTransitionsEffective :=
    backend.boundaryAndBlockTransitionsEffective
  continuationPreservedBlockByBlock :=
    backend.continuationPreservedBlockByBlock
  dynamicallyHierarchicalAfterFringeElim :=
    backend.dynamicallyHierarchicalAfterFringeElim
  finiteFringeCompilation_proof := backend.finiteFringeCompilation_proof
  boundaryAndBlockTransitionsEffective_proof :=
    backend.boundaryAndBlockTransitionsEffective_proof
  continuationPreservedBlockByBlock_proof :=
    backend.continuationPreservedBlockByBlock_proof
  dynamicallyHierarchicalAfterFringeElim_proof :=
    backend.dynamicallyHierarchicalAfterFringeElim_proof

/--
Inputs that discharge the three less-routine no-direct Lean obligations using
existing repository interfaces:

* `baseUniform` plus `monitor` is imported into exactly the no-direct uniform
  interface by `journal_gives_uniform`;
* `gameCompilation` supplies the finite game and its realizability equivalence;
* `sem.refinesAContinuation` supplies the block-by-block continuation
  preservation payload.
-/
structure NoDirectDPADischargedLeanInputs
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  baseUniform :
    UniformOneDirectionalFiniteIndexLemma.{max u v x y, u, v, x, y, 0}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂
  monitor :
    SynchronizedBlockRegularMonitor.{u, v, x, y, max u v x y}
      In₁ In₂ Out₁ Out₂
  Config : Type (max u v x y)
  AContinuation : Config -> Config -> Prop
  sem :
    RotatingAccessStateSemantics.{max u v x y, max u v x y}
      Config AContinuation
  gameCompilation :
    DPAToFiniteGameCompilation.{u, v, x, y, max u v x y}
      Out₂ A
  finiteFringeCompilation : Prop
  boundaryAndBlockTransitionsEffective : Prop
  dynamicallyHierarchicalAfterFringeElim : Prop
  finiteFringeCompilation_proof : finiteFringeCompilation
  boundaryAndBlockTransitionsEffective_proof :
    boundaryAndBlockTransitionsEffective
  dynamicallyHierarchicalAfterFringeElim_proof :
    dynamicallyHierarchicalAfterFringeElim

/-- The journal import produces the exact uniform one-directional interface. -/
noncomputable def NoDirectDPADischargedLeanInputs.importedUniform
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (inputs : NoDirectDPADischargedLeanInputs In₁ In₂ Out₁ Out₂ A) :
    UniformOneDirectionalFiniteIndexLemma.{max u v x y, u, v, x, y, 0}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂ :=
  Classical.choose
    (journal_gives_uniform
      inputs.baseUniform
      inputs.monitor
      inputs.baseUniform.continuationInvariant
      inputs.baseUniform.regularRepresentation)

/--
No-direct DPA certificate with the three requested obligations discharged from
concrete inputs.  The remaining fields are the genuinely local finite-fringe,
transition-effectiveness, and hierarchy facts.
-/
noncomputable def noDirectDPALeanCertificateOfDischargedInputs
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (inputs : NoDirectDPADischargedLeanInputs In₁ In₂ Out₁ Out₂ A) :
    NoDirectReversalFragmentCertificate.{max u v x y, u, v, x, y, 0}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂ :=
  noDirectDPALeanCertificateOfBackendObligations A
    {
      uniform := inputs.importedUniform
      State := inputs.sem.State
      stateFinite := inputs.sem.stateFinite
      finiteGame := inputs.gameCompilation.finiteGame
      finiteGameRealizableIff := inputs.gameCompilation.realizabilityEquivalent
      finiteFringeCompilation := inputs.finiteFringeCompilation
      boundaryAndBlockTransitionsEffective :=
        inputs.boundaryAndBlockTransitionsEffective
      continuationPreservedBlockByBlock :=
        ∀ c c',
          inputs.sem.accessState c = inputs.sem.accessState c' ->
            inputs.AContinuation c c'
      dynamicallyHierarchicalAfterFringeElim :=
        inputs.dynamicallyHierarchicalAfterFringeElim
      finiteFringeCompilation_proof := inputs.finiteFringeCompilation_proof
      boundaryAndBlockTransitionsEffective_proof :=
        inputs.boundaryAndBlockTransitionsEffective_proof
      continuationPreservedBlockByBlock_proof :=
        inputs.sem.refinesAContinuation
      dynamicallyHierarchicalAfterFringeElim_proof :=
        inputs.dynamicallyHierarchicalAfterFringeElim_proof
    }

/-- DPA-level no-direct decision route after discharging the three target obligations. -/
noncomputable def noDirectDPASynthesisDecidable_ofDischargedLeanInputs
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (inputs : NoDirectDPADischargedLeanInputs In₁ In₂ Out₁ Out₂ A) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  (noDirectDPALeanCertificateOfDischargedInputs A inputs).dpaSynthesisDecidable
    A
    (by rfl)

/--
Concrete finite-fringe compilation for the current receipt tags.

The current receipt tags are the finite fringe.  The generic
`fringeElim_winning_iff` theorem turns direct dependence on this current
fringe into contingent actions over the possible current receipt values,
assuming older fringe values are recovered from the non-fringe history.
-/
def CurrentReceiptTagFiniteFringeCompilation
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y) : Prop :=
  ∀ (H₁ H₂ : Type (max u v x y))
    (recoverOne : List H₁ -> List ReceiptTag)
    (recoverTwo : List H₂ -> List ReceiptTag)
    (spec : OutputTraceSpec Out₁ Out₂),
      (∃ σ :
        FringeStrategyPair H₁ H₂ ReceiptTag ReceiptTag Out₁ Out₂,
          OriginalWinsRecoverable recoverOne recoverTwo spec σ) ↔
      (∃ σ :
        ContingentStrategyPair H₁ H₂ ReceiptTag ReceiptTag Out₁ Out₂,
          ContingentWinsRecoverable recoverOne recoverTwo spec σ)

/-- The current receipt tags satisfy the concrete finite-fringe compilation theorem. -/
theorem currentReceiptTagFiniteFringeCompilation
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y) :
    CurrentReceiptTagFiniteFringeCompilation In₁ In₂ Out₁ Out₂ := by
  intro H₁ H₂ recoverOne recoverTwo spec
  exact fringeElim_winning_iff recoverOne recoverTwo spec

/--
Sharper no-direct DPA inputs through the finite-`A`-index interface.

Compared with `NoDirectDPADischargedLeanInputs`, the finite game,
realizability equivalence, block-by-block continuation preservation, and
post-fringe hierarchy payload are all read from `finiteIndex`.  The remaining
inputs are the genuinely external constructions: the base one-directional
summary, the synchronized regular monitor, and the finite-`A`-index
certificate.
-/
structure NoDirectDPAFiniteIndexLeanInputs
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  baseUniform :
    UniformOneDirectionalFiniteIndexLemma.{max u v x y, u, v, x, y, 0}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂
  monitor :
    SynchronizedBlockRegularMonitor.{u, v, x, y, max u v x y}
      In₁ In₂ Out₁ Out₂
  Config : Type (max u v x y)
  finiteIndex :
    FiniteAIndexDecisionCertificate.{max u v x y, max u v x y,
      max u v x y, max u v x y}
      Config
      (∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution σ env))

/-- The journal import produces the uniform object used by the finite-index route. -/
noncomputable def NoDirectDPAFiniteIndexLeanInputs.importedUniform
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (inputs : NoDirectDPAFiniteIndexLeanInputs In₁ In₂ Out₁ Out₂ A) :
    UniformOneDirectionalFiniteIndexLemma.{max u v x y, u, v, x, y, 0}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂ :=
  Classical.choose
    (journal_gives_uniform
      inputs.baseUniform
      inputs.monitor
      inputs.baseUniform.continuationInvariant
      inputs.baseUniform.regularRepresentation)

/--
No-direct DPA certificate from a finite-`A`-index certificate.  This route
does not assume finite-game realizability equivalence, continuation
preservation, or dynamic hierarchy separately; these are fields of
`inputs.finiteIndex`.
-/
noncomputable def noDirectDPALeanCertificateOfFiniteIndexLeanInputs
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (inputs : NoDirectDPAFiniteIndexLeanInputs In₁ In₂ Out₁ Out₂ A) :
    NoDirectReversalFragmentCertificate.{max u v x y, u, v, x, y, 0}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂ :=
  noDirectReversalFragmentCertificateOfFiniteAIndex
    (Alphabet := RoundRecord In₁ In₂ Graph Out₁ Out₂)
    (Config := inputs.Config)
    (Realizable :=
      ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution σ env))
    inputs.importedUniform
    (CurrentReceiptTagFiniteFringeCompilation In₁ In₂ Out₁ Out₂)
    (currentReceiptTagFiniteFringeCompilation In₁ In₂ Out₁ Out₂)
    inputs.finiteIndex.transitionRelationEffective
    inputs.finiteIndex.transitionRelationEffective_proof
    inputs.finiteIndex.quotientPreservesContinuationGames
    inputs.finiteIndex.quotientPreservesContinuationGames_proof
    inputs.finiteIndex

/--
DPA-level no-direct decision route through the finite-`A`-index certificate.
This is the tightest checked Lean endpoint for the restricted theorem.
-/
noncomputable def noDirectDPASynthesisDecidable_ofFiniteIndexLeanInputs
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (inputs : NoDirectDPAFiniteIndexLeanInputs In₁ In₂ Out₁ Out₂ A) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  (noDirectDPALeanCertificateOfFiniteIndexLeanInputs A inputs).dpaSynthesisDecidable
    A
    (by rfl)

