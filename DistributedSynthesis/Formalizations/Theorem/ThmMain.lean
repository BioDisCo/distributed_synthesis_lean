        header.toCurrentOrderHeader.toHeader.parityOfHistory c.history =
          header.toCurrentOrderHeader.toHeader.parityOfHistory c'.history)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
      header.toCurrentOrderHeader.toHeader.parityOfHistory
      header.σ
      header.generationBound
