    NoDirectDPAJournalBoundedLocalByRoundTruthVectorFactorPackageCoreForActualTruthAutomatonParityCurrentOrderHeader.toCurrentViewsFactorCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalByRoundTruthVectorFactorPackageCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsFactorCoreForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfHistory := core.envsOfHistory
  envs_bound := core.envs_bound
  envs_actualTruth := core.envs_actualTruth
  envs_nonempty := core.envs_nonempty
  closureInvariants :=
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants_of_pathGeneratedPrefixEquivalentByRoundFromList_truthVectorFactorPackage
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
      header.σ
      core.generatedHistory
      core.factors
  currentViewsOfTruth := core.factors.currentViewsOfTruth
  currentViews_factor := core.factors.currentViews_factor
