                    A.macroConfigurationRun ({state} : Finset A.State) word j ->
                    ∀ nextState, nextState ∈ targetStates ->
                      nextState.1.size < root.size + 1 ->
                        PositiveLTL.Satisfies interp
                          (OmegaWord.drop word j) nextState.1)
    (hlocal :
      ∀ formula : LTL AP,
        ∀ (state : (PositiveLTL.ofLTL formula).Subformula)
          (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          ∀ hsat : PositiveLTL.Satisfies interp word state.1,
            (PositiveLTL.subformulaClosure_guidedRunFrom
              (PositiveLTL.ofLTL formula)
              interp dec word state hsat).RecurringStateEdgesNodeLocalComplete)
    (formula : LTL AP)
    (gameCompiler :
      DPAFiniteGameCompiler.{u, v, x, y, a}
        In₁ In₂ Out₁ Out₂) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          LTL.Satisfies interp word formula)) :=
  main_result_for_ltl_dpa_finite_game_compiler
    In₁ In₂ Out₁ Out₂
    (CanonicalLTLAPAToDPAStateCompiler.supportWitnessGuidedRecurringEdgesNodeLocalLTLToDPACompiler
      interp dec
      (PositiveLTL.subformulaClosure_supportWitnessSound_of_rootBound_recurrent_source_invariant
        interp dec hrecurrent)
      hlocal)
    formula
    gameCompiler

/--
Node-local recurring-edge completeness for the concrete guided run implies the
guided tail-path child-coherence obligation used by the checked no-direct
endpoints below.
-/
theorem PositiveLTL.subformulaClosure_guidedTailPathChildCoherent_of_recurringEdgesNodeLocal
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (hlocal :
      ∀ formula : LTL AP,
        ∀ (state : (PositiveLTL.ofLTL formula).Subformula)
          (word : OmegaWord Letter),
          ∀ hsat : PositiveLTL.Satisfies interp word state.1,
            (PositiveLTL.subformulaClosure_guidedRunFrom
              (PositiveLTL.ofLTL formula)
              interp dec word state hsat).RecurringStateEdgesNodeLocalComplete) :
    ∀ formula : LTL AP,
      ∀ (state : (PositiveLTL.ofLTL formula).Subformula)
        (word : OmegaWord Letter),
        ∀ hsat : PositiveLTL.Satisfies interp word state.1,
          ∀ path :
            Nat ->
              (((PositiveLTL.subformulaClosure
                (AP := AP)
                (Letter := Letter)
                (PositiveLTL.ofLTL formula)).toAPA
                  interp dec).withInitial state).State,
            (∀ n : Nat,
              (path n, path (n + 1)) ∈
                (((PositiveLTL.subformulaClosure_guidedRunFrom
                  (PositiveLTL.ofLTL formula)
                  interp dec word state hsat)
                  ).realizedEdgeWitnessedMacroRun).infStateEdgeFinset) ->
            ((PositiveLTL.subformulaClosure_guidedRunFrom
              (PositiveLTL.ofLTL formula)
              interp dec word state hsat)
              ).StatePathTailCoherentChildren path := by
  intro formula state word hsat path hpath
  exact
    (PositiveLTL.subformulaClosure_guidedRunFrom
      (PositiveLTL.ofLTL formula)
      interp dec word state hsat).statePathTailCoherentChildren_of_recurringStateEdgesNodeLocalComplete
      (hlocal formula state word hsat)
      hpath

/--
Exact guided child-extension target for recurring support paths.

This is the precise fixed-point/tableau claim needed by the main route: every
path through the recurring explicit edge graph of the concrete guided run has a
tail subtree where the next path state is realized by an active child at each
matching node.  It avoids the stronger, generally unnecessary requirement that
the guided run spawn every syntactic transition atom.
-/
def AlternatingParityAutomaton.Run.RecurringEdgePathNodeLocalCoherent
    {Alphabet : Type u}
    {A : AlternatingParityAutomaton.{u, v} Alphabet}
    {word : OmegaWord Alphabet}
    (run : A.Run word)
    (path : Nat -> A.State) : Prop :=
  ∃ node : AlternatingParityAutomaton.Node,
    ∃ hpathNode : run.PathActive node,
      run.stateAt node = path 0 ∧
        ∀ (hnode' : run.active node)
          (suffix : AlternatingParityAutomaton.Node),
          (run.subRun node hnode').PathActive suffix ->
            run.stateAt (suffix ++ node) = path suffix.length ->
              run.StateEdgeRealizedFromNode
                (suffix ++ node)
                (path suffix.length, path (suffix.length + 1))

abbrev PositiveLTL.SubformulaClosureGuidedTailPathChildCoherent
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter)) : Prop :=
  ∀ formula : LTL AP,
    ∀ (state : (PositiveLTL.ofLTL formula).Subformula)
      (word : OmegaWord Letter),
      ∀ hsat : PositiveLTL.Satisfies interp word state.1,
        ∀ path :
          Nat ->
            (((PositiveLTL.subformulaClosure
              (AP := AP)
              (Letter := Letter)
              (PositiveLTL.ofLTL formula)).toAPA
                interp dec).withInitial state).State,
          (∀ n : Nat,
            (path n, path (n + 1)) ∈
              (((PositiveLTL.subformulaClosure_guidedRunFrom
                (PositiveLTL.ofLTL formula)
                interp dec word state hsat)
                ).realizedEdgeWitnessedMacroRun).infStateEdgeFinset) ->
            AlternatingParityAutomaton.Run.StatePathTailCoherentChildren
              (PositiveLTL.subformulaClosure_guidedRunFrom
                (PositiveLTL.ofLTL formula)
                interp dec word state hsat)
              path

/-
There is no unconditional canonical proof of the guided-tail target in this
file.  The checked bridge above,
`subformulaClosure_guidedTailPathChildCoherent_of_recurringEdgesNodeLocal`,
keeps the needed recurrence/local-completeness obligation explicit.
-/

/--
Exact recurring-graph form of the pruned guided-support construction.

This is the mathematical core still needed by the active route: for every
satisfied canonical subformula, choose the pruned edge-witnessed macro-run
whose own recurring edge graph is subtree-coherent in the guided tableau run.
The accepting parity and syntactic edge-shape facts are then derived below by
generic backend lemmas, so this target isolates the real pruning/fixed-point
argument.
-/
def PositiveLTL.SubformulaClosurePrunedGuidedRunExactTailCoherent
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter)) :
    Prop :=
  ∀ (state : root.Subformula) (word : OmegaWord Letter),
    ∀ hsat : PositiveLTL.Satisfies interp word state.1,
      ∃ run :
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial state).EdgeWitnessedMacroRun
          ({(((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp dec).withInitial state).initial} :
            Finset (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial state).State)
          word,
        ∀ path :
          Nat ->
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial state).State,
          (∀ n : Nat, (path n, path (n + 1)) ∈ run.infStateEdgeFinset) ->
          (PositiveLTL.subformulaClosure_guidedRunFrom
              root interp dec word state hsat).StatePathTailCoherentChildren
                path

/--
Threaded form of the pruned guided-support construction.

This is the real path-compatible selector target: choose a pruned
edge-witnessed macro-run such that every infinite path through its recurring
edge graph has an actual threaded tail in the canonical guided tableau run.
Unlike all-occurrences node-local completeness, this only follows one
compatible tail for the path and is therefore suitable for disjunctive
positive transitions.
-/
def PositiveLTL.SubformulaClosurePrunedGuidedRunThreadedTailRealizable
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter)) :
    Prop :=
  ∀ (state : root.Subformula) (word : OmegaWord Letter),
    ∀ hsat : PositiveLTL.Satisfies interp word state.1,
      ∃ run :
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial state).EdgeWitnessedMacroRun
          ({(((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp dec).withInitial state).initial} :
            Finset (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial state).State)
          word,
        ∀ path :
          Nat ->
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial state).State,
          (∀ n : Nat, (path n, path (n + 1)) ∈ run.infStateEdgeFinset) ->
          (PositiveLTL.subformulaClosure_guidedRunFrom
              root interp dec word state hsat).StatePathThreadedTailRealization
                path

theorem PositiveLTL.subformulaClosure_prunedGuidedRunExactTailCoherent_of_threadedTailRealizable
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    {root : PositiveLTL AP}
    {interp : AP -> Letter -> Prop}
    {dec : ∀ ap letter, Decidable (interp ap letter)}
    (hthreaded :
      PositiveLTL.SubformulaClosurePrunedGuidedRunThreadedTailRealizable
        root interp dec) :
    PositiveLTL.SubformulaClosurePrunedGuidedRunExactTailCoherent
      root interp dec := by
  intro state word hsat
  rcases hthreaded state word hsat with ⟨selectedRun, hpaths⟩
  refine ⟨selectedRun, ?_⟩
  intro path hpath
  exact
    (PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word state hsat).statePathTailCoherentChildren_of_threadedTailRealization
      (hpaths path hpath)

/--
Branch-stable support form of the pruned guided construction.

This is a stronger sufficient form, not the active main obligation.  It asks
that selected recurring edges be locally realized below every active occurrence
of their source state; this can be too strong for disjunctive positive
transitions, where different same-source occurrences may require different
one-step supports.  The preferred route below keeps the exact path-threaded
tail-coherence target as the real proof obligation.
-/
def PositiveLTL.SubformulaClosurePrunedGuidedBranchStableSupport
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter)) :
    Prop :=
  ∀ (state : root.Subformula) (word : OmegaWord Letter),
    ∀ hsat : PositiveLTL.Satisfies interp word state.1,
      ∃ run :
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial state).EdgeWitnessedMacroRun
          ({(((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp dec).withInitial state).initial} :
            Finset (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial state).State)
          word,
        (∀ edge : APAStateEdge
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial state),
          edge ∈ run.infStateEdgeFinset ->
            ∃ node,
              (PositiveLTL.subformulaClosure_guidedRunFrom
                root interp dec word state hsat).PathActive node ∧
              (PositiveLTL.subformulaClosure_guidedRunFrom
                root interp dec word state hsat).stateAt node = edge.1) ∧
        (∀ edge : APAStateEdge
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial state),
          edge ∈ run.infStateEdgeFinset ->
            ∀ node,
              (PositiveLTL.subformulaClosure_guidedRunFrom
                root interp dec word state hsat).PathActive node ->
              (PositiveLTL.subformulaClosure_guidedRunFrom
                root interp dec word state hsat).stateAt node = edge.1 ->
                ∃ child,
                  (PositiveLTL.subformulaClosure_guidedRunFrom
                    root interp dec word state hsat).active (child :: node) ∧
                  (PositiveLTL.subformulaClosure_guidedRunFrom
                    root interp dec word state hsat).stateAt (child :: node) =
                    edge.2)

theorem PositiveLTL.subformulaClosure_prunedGuidedRunExactTailCoherent_of_branchStableSupport
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    {root : PositiveLTL AP}
    {interp : AP -> Letter -> Prop}
    {dec : ∀ ap letter, Decidable (interp ap letter)}
    (hsupport :
      PositiveLTL.SubformulaClosurePrunedGuidedBranchStableSupport
        root interp dec) :
    PositiveLTL.SubformulaClosurePrunedGuidedRunExactTailCoherent
      root interp dec := by
  intro state word hsat
  rcases hsupport state word hsat with ⟨selectedRun, hsource, hlocal⟩
  refine ⟨selectedRun, ?_⟩
  intro path hpath
  let guidedRun :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word state hsat
  rcases hsource (path 0, path (0 + 1)) (hpath 0) with
    ⟨node, hpathNode, hnodeState⟩
  have hnodeActive : guidedRun.active node :=
    guidedRun.pathActive_self node hpathNode
  refine ⟨node, hpathNode, hnodeActive, ?_⟩
  constructor
  · simpa [guidedRun, AlternatingParityAutomaton.Run.subRun_stateAt] using
      hnodeState
  · intro suffix hsuffixActive hsuffixState
    have hsuffixPath :
        guidedRun.PathActive (suffix ++ node) :=
      guidedRun.pathActive_append_of_subRun_pathActive hpathNode hnodeActive
        hsuffixActive
    have hsuffixStateOriginal :
        guidedRun.stateAt (suffix ++ node) = path suffix.length := by
      simpa [guidedRun, AlternatingParityAutomaton.Run.subRun_stateAt] using
        hsuffixState
    rcases
      hlocal (path suffix.length, path (suffix.length + 1))
        (hpath suffix.length) (suffix ++ node) hsuffixPath
        hsuffixStateOriginal with
      ⟨child, hchildActive, hchildState⟩
    refine ⟨child, ?_, ?_⟩
    · simpa [guidedRun, AlternatingParityAutomaton.Run.subRun_active,
        List.cons_append] using hchildActive
    · simpa [guidedRun, AlternatingParityAutomaton.Run.subRun_stateAt,
        List.cons_append] using hchildState

theorem PositiveLTL.subformulaClosure_prunedGuidedBranchStableSupport_of_guidedRunRecurringEdgesNodeLocalComplete
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    {root : PositiveLTL AP}
    {interp : AP -> Letter -> Prop}
    {dec : ∀ ap letter, Decidable (interp ap letter)}
    (hlocal :
      ∀ (state : root.Subformula) (word : OmegaWord Letter),
        ∀ hsat : PositiveLTL.Satisfies interp word state.1,
          (PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word state hsat).RecurringStateEdgesNodeLocalComplete) :
    PositiveLTL.SubformulaClosurePrunedGuidedBranchStableSupport
      root interp dec := by
  intro state word hsat
  let guidedRun :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word state hsat
  refine ⟨guidedRun.realizedEdgeWitnessedMacroRun, ?_, ?_⟩
  · intro edge hedge
    have hseen :
        guidedRun.realizedEdgeWitnessedMacroRun.StateEdgeSeenInfinitelyOften
          edge := by
      exact
        (guidedRun.realizedEdgeWitnessedMacroRun.mem_infStateEdgeFinset
          edge).mp hedge
    rcases hseen 0 with ⟨level, _hlevel, hedgeLevel⟩
    rcases
      guidedRun.realizedEdgeWitnessedMacroRun_stateEdges_realized
        level hedgeLevel with
      ⟨node, _child, _hnodeLength, hpathNode, hnodeState,
        _hchildActive, _hchildState⟩
    exact ⟨node, hpathNode, hnodeState⟩
  · intro edge hedge node hpathNode hnodeState
    exact
      (hlocal state word hsat) edge hedge node hpathNode hnodeState

/--
Accepting/descent data derived from the exact-tail support kernel.

The only non-generic input is the exact-tail support selection.  For a
selected edge-witnessed run, the recurring edge set is support-accepting because
tail-coherent paths yield accepting branches in the canonical guided run; the
self-or-descending and temporal self-edge facts are extracted from the checked
subformula-closure transition lemmas.
-/
theorem PositiveLTL.subformulaClosure_prunedGuidedAcceptingDescentTailCoherentSupportKernel
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (hexact :
      ∀ formula : LTL AP,
        PositiveLTL.SubformulaClosurePrunedGuidedRunExactTailCoherent
          (PositiveLTL.ofLTL formula) interp dec) :
    ∀ formula : LTL AP,
      PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphAcceptingDescentTailCoherent
        (PositiveLTL.ofLTL formula) interp dec := by
  intro formula state word hsat
  let root := PositiveLTL.ofLTL formula
  let B :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp dec
  let A :=
    B.withInitial state
  let guidedRun :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word state hsat
  have hpruned :
      PositiveLTL.SubformulaClosurePrunedGuidedRunExactTailCoherent
        root interp dec :=
    hexact formula
  rcases hpruned state word hsat with ⟨selectedRun, htailExact⟩
  let acceptedEdges : Finset (APAStateEdge A) :=
    selectedRun.infStateEdgeFinset
  have hsubset :
      selectedRun.infStateEdgeFinset ⊆ acceptedEdges := by
    intro edge hedge
    exact hedge
  have hdescent :
      ∀ edge : APAStateEdge A,
        edge ∈ acceptedEdges ->
          edge.2.1 = edge.1.1 ∨ edge.2.1.size < edge.1.1.size := by
    intro edge hedge
    have hseen :
        selectedRun.StateEdgeSeenInfinitelyOften edge :=
      (selectedRun.mem_infStateEdgeFinset edge).mp hedge
    rcases hseen 0 with ⟨k, _hk, hedgeStep⟩
    have htransitionA :
        A.MacroTransitionWithStateEdges
          (selectedRun.toMacroRun.states k) (word k)
          (selectedRun.toMacroRun.states (k + 1))
          (selectedRun.stateEdges k) := by
      simpa [OmegaWord.drop] using selectedRun.step_stateEdges_transition k
    have htransitionB :
        B.MacroTransitionWithStateEdges
          (selectedRun.toMacroRun.states k) (word k)
          (selectedRun.toMacroRun.states (k + 1))
          (selectedRun.stateEdges k) := by
      exact
        (AlternatingParityAutomaton.macroTransitionWithStateEdges_withInitial_iff
          B state (selectedRun.toMacroRun.states k)
          (selectedRun.toMacroRun.states (k + 1)) (word k)
          (selectedRun.stateEdges k)).mp htransitionA
    rcases
      PositiveLTL.subformulaClosure_macroTransitionWithStateEdges_edge_self_or_size_lt
        root interp dec htransitionB hedgeStep with hself | hlt
    · left
      simpa [B, A] using congrArg Subtype.val hself
    · exact Or.inr hlt
  have hselfTemporal :
      ∀ edge : APAStateEdge A,
        edge ∈ acceptedEdges ->
          edge.2.1 = edge.1.1 ->
            (∃ φ ψ : PositiveLTL AP, edge.1.1 = PositiveLTL.until φ ψ) ∨
              ∃ φ ψ : PositiveLTL AP,
                edge.1.1 = PositiveLTL.release φ ψ := by
    intro edge hedge hselfFormula
    have hseen :
        selectedRun.StateEdgeSeenInfinitelyOften edge :=
      (selectedRun.mem_infStateEdgeFinset edge).mp hedge
    rcases hseen 0 with ⟨k, _hk, hedgeStep⟩
    have htransitionA :
        A.MacroTransitionWithStateEdges
          (selectedRun.toMacroRun.states k) (word k)
          (selectedRun.toMacroRun.states (k + 1))
          (selectedRun.stateEdges k) := by
      simpa [OmegaWord.drop] using selectedRun.step_stateEdges_transition k
    have htransitionB :
        B.MacroTransitionWithStateEdges
          (selectedRun.toMacroRun.states k) (word k)
          (selectedRun.toMacroRun.states (k + 1))
          (selectedRun.stateEdges k) := by
      exact
        (AlternatingParityAutomaton.macroTransitionWithStateEdges_withInitial_iff
          B state (selectedRun.toMacroRun.states k)
          (selectedRun.toMacroRun.states (k + 1)) (word k)
          (selectedRun.stateEdges k)).mp htransitionA
    rcases htransitionB with ⟨supportChoice, _hsupport, hstateEdges⟩
    have hedgeChoice : edge ∈ supportChoice.stateEdges := by
      simpa [hstateEdges] using hedgeStep
    rcases
      (AlternatingParityAutomaton.MacroStepSupport.mem_stateEdges
        (supportChoice := supportChoice)).mp hedgeChoice with
      ⟨source, hsource, htarget⟩
    have htargetAtom :
        edge.2 ∈ (B.step edge.1 (word k)).atoms := by
      have htargetAtomSource :
          edge.2 ∈ (B.step source.1 (word k)).atoms :=
        (supportChoice.choice source).support_atoms edge.2 htarget
      simpa [hsource] using htargetAtomSource
    have hselfState : edge.2 = edge.1 := by
      apply Subtype.ext
      exact hselfFormula
    have hsourceAtom :
        edge.1 ∈ (B.step edge.1 (word k)).atoms := by
      simpa [hselfState] using htargetAtom
    exact
      PositiveLTL.subformulaClosure_step_self_atom_is_until_or_release
        root interp dec edge.1 (word k) hsourceAtom
  have htailCoherent :
      ∀ path : Nat -> A.State,
        (∀ n : Nat, (path n, path (n + 1)) ∈ acceptedEdges) ->
          guidedRun.StatePathTailCoherentChildren path := by
    intro path hpath
    exact htailExact path hpath
  have haccepting :
      A.SupportWitnessStateEdgesAccepting acceptedEdges := by
    exact
      A.supportWitnessStateEdgesAccepting_of_tailBranchRealizable
        guidedRun
        (PositiveLTL.subformulaClosure_guidedRunFrom_accepting
          root interp dec word state hsat)
        (by
          intro path hpath
          exact
            guidedRun.exists_tailRealizingBranch_of_tailCoherentChildren
              path (htailCoherent path hpath))
  exact
    ⟨selectedRun, acceptedEdges, hsubset, haccepting, hdescent,
      hselfTemporal, htailCoherent⟩

theorem PositiveLTL.subformulaClosure_prunedGuidedRunThreadedTailRealizable_of_eventualOpenReleaseLocalEdges
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    {root : PositiveLTL AP}
    {interp : AP -> Letter -> Prop}
    {dec : ∀ ap letter, Decidable (interp ap letter)}
    (hlocal :
      PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphEventualOpenReleaseLocalEdges
        root interp dec) :
    PositiveLTL.SubformulaClosurePrunedGuidedRunThreadedTailRealizable
      root interp dec := by
  intro state word hsat
  dsimp [PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphEventualOpenReleaseLocalEdges]
    at hlocal
  rcases hlocal state word hsat with
    ⟨selectedRun, acceptedEdges, hsubset, hpaths⟩
  refine ⟨selectedRun, ?_⟩
  intro path hpath
  let guidedRun :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word state hsat
  have hpathAccepted :
      ∀ n : Nat, (path n, path (n + 1)) ∈ acceptedEdges := by
    intro n
    exact hsubset (hpath n)
  rcases hpaths path hpathAccepted with
    ⟨node, hpathNode, hnodeState, N, releaseState, φ, ψ,
      hstable, hrelease, hprefix, hnotLeft⟩
  have htail :
      guidedRun.StatePathTailCoherentChildren path :=
    PositiveLTL.subformulaClosure_guidedRunFrom_eventually_constant_release_tailCoherent_of_prefixEdges_and_not_left
      root interp dec word state hsat N releaseState φ ψ
      hstable hrelease node hpathNode hnodeState hprefix hnotLeft
  exact guidedRun.statePathThreadedTailRealization_of_tailCoherentChildren htail

/--
Proof-facing support selector for the remaining LTL construction.

This is definitionally the event-open-release local-edge target, but with a
name that records the mathematical content: choose the pruned support graph
and prove the finite prefix plus eventual open-release data for every path of
its recurring edge graph.  The separate bridge below keeps the public theorem
from hiding this selector behind the threaded-tail interface.
-/
def PositiveLTL.SubformulaClosurePrunedGuidedOpenReleaseSupportSelector
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter)) :
    Prop :=
  PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphEventualOpenReleaseLocalEdges
    root interp dec

theorem PositiveLTL.subformulaClosure_prunedGuidedRunSubgraphEventualOpenReleaseLocalEdges_of_openReleaseSupportSelector
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    {root : PositiveLTL AP}
    {interp : AP -> Letter -> Prop}
    {dec : ∀ ap letter, Decidable (interp ap letter)}
    (hselector :
      PositiveLTL.SubformulaClosurePrunedGuidedOpenReleaseSupportSelector
        root interp dec) :
    PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphEventualOpenReleaseLocalEdges
