/--
Output of the actual Bérard rational-summary construction before it is indexed
by stabilized truth atoms.

The observer is the finite product described in the guide: one-directional
summary state, stabilized truth atom, raw no-direct epoch state, and
receipt/order payload.  The fields below say that the observer factors through
truth and that each observer has a bounded generated representative.
-/
structure BoundedNoDirectBerardRationalSummaryCertificateForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  Observer : Type (max u v x y aut)
  observerFinite : Fintype Observer
  observerOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> Observer
  observerOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) -> Observer
  observer_truth_factor :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      observerOfHistory h =
        observerOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h))
  envsOfObserver :
    Observer -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ q : Observer, (envsOfObserver q).length ≤ header.generationBound
  envs_truth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (envsOfObserver (observerOfHistory h)))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  envs_nonempty :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      envsOfObserver (observerOfHistory h) ≠ []
  closureInvariants :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  receiptOrderOfObserver :
    Observer -> ReceiptOrderData
  receiptOrder_observer :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        receiptOrderOfObserver (observerOfHistory h)
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
Representative-complete finite cover extracted from the Bérard product-monitor
construction.

This is the Lean version of the `K_{d,m}` construction in the paper proof.
`CoverState` is the finite product-monitor state reached by the last block:
last-block mode, common boundary, rational-run control, stabilized truth,
raw no-direct epoch state, and current receipt/order data.  The important
extra field beyond ordinary finite index is `representative_cover`: every
cover state has a nonempty bounded environment word generated by the selected
rational strategy that reaches the same cover state.
-/
structure RepresentativeCompleteNoDirectBerardFiniteCoverForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  CoverState : Type (max u v x y aut)
  coverFinite : Fintype CoverState
  coverInhabited : Inhabited CoverState
  coverOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> CoverState
  coverOfGenerated :
    List (EnvironmentRound In₁ In₂) -> CoverState
  representativeOfCover :
    CoverState -> List (EnvironmentRound In₁ In₂)
  representative_nonempty :
    ∀ c : CoverState, representativeOfCover c ≠ []
  representative_bound :
    ∀ c : CoverState, (representativeOfCover c).length ≤ header.generationBound
  representative_cover :
    ∀ c : CoverState, coverOfGenerated (representativeOfCover c) = c
  coverTruth :
    CoverState ->
      RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  coverEpoch :
    CoverState ->
      EpochRotatingAccessState
        header.toCurrentOrderHeader.toHeader.importedUniform.boundary
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two)
  coverReceipt :
    CoverState -> ReceiptOrderData
  history_truth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      coverTruth (coverOfHistory h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h)
  history_epoch :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      coverEpoch (coverOfHistory h) =
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary h
  history_receipt :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      coverReceipt (coverOfHistory h) =
        currentReceiptOrderData h (historyCurrentContainmentOrder h)
  generated_truth :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      coverTruth (coverOfGenerated envs) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ envs))
  epoch_eq_of_truth_eq :
    ∀ c c' : CoverState,
      coverTruth c = coverTruth c' ->
      coverEpoch c = coverEpoch c'
  receipt_eq_of_truth_eq :
    ∀ c c' : CoverState,
      coverTruth c = coverTruth c' ->
      coverReceipt c = coverReceipt c'
  automaton_eq_of_truth_eq :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      header.toCurrentOrderHeader.automatonOfHistory h =
        header.toCurrentOrderHeader.automatonOfHistory h'
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
Any representative-complete cover already contains a nonempty generated
environment word, hence both input alphabets must be nonempty.  This is a
necessary condition for the external Bérard import; it is not present in the
bare current-order header.
-/
theorem RepresentativeCompleteNoDirectBerardFiniteCoverForActualTruthAutomatonParityCurrentOrderHeader.inputTypesNonempty
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (cover :
      RepresentativeCompleteNoDirectBerardFiniteCoverForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    Nonempty In₁ ∧ Nonempty In₂ := by
  letI : Inhabited cover.CoverState := cover.coverInhabited
  let c : cover.CoverState := default
  have hne : cover.representativeOfCover c ≠ [] :=
    cover.representative_nonempty c
  cases henvs : cover.representativeOfCover c with
  | nil =>
      exact False.elim (hne henvs)
  | cons env _ =>
      exact ⟨⟨env.inputOne⟩, ⟨env.inputTwo⟩⟩

/--
Reachable finite-controller certificate for the revised no-direct proof.

Unlike the older representative-complete cover, this record only speaks about
prefixes generated by the selected strategy `header.σ`.  A representative is
required to preserve the finite controller state of each generated prefix; the
initial state may be represented by the empty word, and nonemptiness is only
required away from the initial state.
-/
structure ReachableNoDirectBerardFiniteControllerCertificateForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  State : Type (max u v x y aut)
  stateFinite : Fintype State
  stateOfGenerated :
    List (EnvironmentRound In₁ In₂) -> State
  initialState : State
  initial_state : stateOfGenerated [] = initialState
  step : State -> EnvironmentRound In₁ In₂ -> State
  state_snoc :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      stateOfGenerated (envs ++ [env]) =
        step (stateOfGenerated envs) env
  truthOfState :
    State -> RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  epochOfState :
    State ->
      EpochRotatingAccessState
        header.toCurrentOrderHeader.toHeader.importedUniform.boundary
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two)
  automatonOfState :
    State -> header.AState
  receiptOfState :
    State -> ReceiptOrderData
  generated_truth :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      truthOfState (stateOfGenerated envs) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ envs))
  generated_epoch :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      epochOfState (stateOfGenerated envs) =
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (executionPrefixFromList header.σ envs)
  generated_automaton :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      automatonOfState (stateOfGenerated envs) =
        header.automatonOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (executionPrefixFromList header.σ envs)))
  generated_receipt :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      receiptOfState (stateOfGenerated envs) =
        currentReceiptOrderData
          (executionPrefixFromList header.σ envs)
          (historyCurrentContainmentOrder
            (executionPrefixFromList header.σ envs))
  representativeOfState :
    State -> List (EnvironmentRound In₁ In₂)
  representative_bound :
    ∀ s : State, (representativeOfState s).length ≤ header.generationBound
  representative_initial :
    representativeOfState initialState = []
  representative_state :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      stateOfGenerated (representativeOfState (stateOfGenerated envs)) =
        stateOfGenerated envs
  representative_nonempty_of_noninitial :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      stateOfGenerated envs ≠ initialState ->
      representativeOfState (stateOfGenerated envs) ≠ []
  outputRealizer : Prop
  outputRealizer_proof : outputRealizer

/-!
The next record is the precise Lean form of the paper proof's external
Bérard observer construction before representatives are totalized.

The field `bounded_reachable_state` is the formal generation-bound obligation:
after the finite reachable controller graph has been built, the chosen
generation bound must dominate one generated representative for every
reachable state.  This cannot be derived from `0 < header.generationBound`
alone.
-/
structure ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  State : Type (max u v x y aut)
  stateFinite : Fintype State
  stateOfGenerated :
    List (EnvironmentRound In₁ In₂) -> State
  initialState : State
  initial_state : stateOfGenerated [] = initialState
  step : State -> EnvironmentRound In₁ In₂ -> State
  state_snoc :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      stateOfGenerated (envs ++ [env]) =
        step (stateOfGenerated envs) env
  truthOfState :
    State -> RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  epochOfState :
    State ->
      EpochRotatingAccessState
        header.toCurrentOrderHeader.toHeader.importedUniform.boundary
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two)
  automatonOfState :
    State -> header.AState
  receiptOfState :
    State -> ReceiptOrderData
  generated_truth :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      truthOfState (stateOfGenerated envs) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ envs))
  generated_epoch :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      epochOfState (stateOfGenerated envs) =
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (executionPrefixFromList header.σ envs)
  generated_automaton :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      automatonOfState (stateOfGenerated envs) =
        header.automatonOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (executionPrefixFromList header.σ envs)))
  generated_receipt :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      receiptOfState (stateOfGenerated envs) =
        currentReceiptOrderData
          (executionPrefixFromList header.σ envs)
          (historyCurrentContainmentOrder
            (executionPrefixFromList header.σ envs))
  bounded_reachable_state :
    ∀ s : State,
      (∃ envs : List (EnvironmentRound In₁ In₂), stateOfGenerated envs = s) ->
      ∃ envs : List (EnvironmentRound In₁ In₂),
        stateOfGenerated envs = s ∧ envs.length ≤ header.generationBound
  outputRealizer : Prop
  outputRealizer_proof : outputRealizer

namespace ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader

/--
Finite reachable-state bound used in the paper proof.

For any finite generated observer, choosing one witness word for each reachable
state gives a single finite bound.  The external Bérard construction must then
choose the header generation bound to dominate such an `N`.
-/
theorem finite_reachable_state_bound
    {Env : Type u} {State : Type v}
    [Fintype State]
    (stateOfGenerated : List Env -> State) :
    ∃ N : Nat,
      ∀ s : State,
        (∃ envs : List Env, stateOfGenerated envs = s) ->
        ∃ envs : List Env,
          stateOfGenerated envs = s ∧ envs.length ≤ N := by
  classical
  let lenOf : State -> Nat :=
    fun s =>
      if hs : ∃ envs : List Env, stateOfGenerated envs = s then
        (Classical.choose hs).length
      else
        0
  let N : Nat := ((Finset.univ : Finset State).image lenOf).sum id
  refine ⟨N, ?_⟩
  intro s hs
  refine ⟨Classical.choose hs, Classical.choose_spec hs, ?_⟩
  have hmem : lenOf s ∈ ((Finset.univ : Finset State).image lenOf) := by
    exact Finset.mem_image.mpr ⟨s, by simp, rfl⟩
  have hle :
      lenOf s ≤ ((Finset.univ : Finset State).image lenOf).sum id := by
    exact Finset.single_le_sum (by intro n _hn; exact Nat.zero_le n) hmem
  simpa [lenOf, hs, N] using hle

noncomputable def representativeOfState
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (obs :
      ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (s : obs.State) :
    List (EnvironmentRound In₁ In₂) := by
  classical
  exact
    if hinit : s = obs.initialState then []
    else if hs : ∃ envs : List (EnvironmentRound In₁ In₂),
        obs.stateOfGenerated envs = s then
      Classical.choose (obs.bounded_reachable_state s hs)
    else []

theorem representative_bound
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (obs :
      ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (s : obs.State) :
    (representativeOfState obs s).length ≤ header.generationBound := by
  classical
  by_cases hinit : s = obs.initialState
  · simp [representativeOfState, hinit]
  · by_cases hs : ∃ envs : List (EnvironmentRound In₁ In₂),
        obs.stateOfGenerated envs = s
    · have hspec := Classical.choose_spec (obs.bounded_reachable_state s hs)
      simpa [representativeOfState, hinit, hs] using hspec.2
    · simp [representativeOfState, hinit, hs]

theorem representative_initial
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (obs :
      ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    representativeOfState obs obs.initialState = [] := by
  classical
  simp [representativeOfState]

theorem representative_state
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (obs :
      ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (envs : List (EnvironmentRound In₁ In₂)) :
    obs.stateOfGenerated
        (representativeOfState obs (obs.stateOfGenerated envs)) =
      obs.stateOfGenerated envs := by
  classical
  by_cases hinit : obs.stateOfGenerated envs = obs.initialState
  · calc
      obs.stateOfGenerated
          (representativeOfState obs (obs.stateOfGenerated envs)) =
          obs.stateOfGenerated [] := by
            simp [representativeOfState, hinit]
      _ = obs.initialState := obs.initial_state
      _ = obs.stateOfGenerated envs := hinit.symm
  · let hs : ∃ envs' : List (EnvironmentRound In₁ In₂),
        obs.stateOfGenerated envs' = obs.stateOfGenerated envs := ⟨envs, rfl⟩
    have hspec := Classical.choose_spec
      (obs.bounded_reachable_state (obs.stateOfGenerated envs) hs)
    simpa [representativeOfState, hinit, hs] using hspec.1

theorem representative_nonempty_of_noninitial
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (obs :
      ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (envs : List (EnvironmentRound In₁ In₂))
    (hnoninitial : obs.stateOfGenerated envs ≠ obs.initialState) :
    representativeOfState obs (obs.stateOfGenerated envs) ≠ [] := by
  intro hnil
  have hstate := representative_state obs envs
  rw [hnil] at hstate
  have hinitial : obs.stateOfGenerated envs = obs.initialState :=
    hstate.symm.trans obs.initial_state
  exact hnoninitial hinitial

/--
Checked conversion from the paper's reachable Bérard observer construction to
the Lean certificate used by the preservation lemmas.
-/
noncomputable def toCertificate
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (obs :
      ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    ReachableNoDirectBerardFiniteControllerCertificateForActualTruthAutomatonParityCurrentOrderHeader
      header where
  State := obs.State
  stateFinite := obs.stateFinite
  stateOfGenerated := obs.stateOfGenerated
  initialState := obs.initialState
  initial_state := obs.initial_state
  step := obs.step
  state_snoc := obs.state_snoc
  truthOfState := obs.truthOfState
  epochOfState := obs.epochOfState
  automatonOfState := obs.automatonOfState
  receiptOfState := obs.receiptOfState
  generated_truth := obs.generated_truth
  generated_epoch := obs.generated_epoch
  generated_automaton := obs.generated_automaton
  generated_receipt := obs.generated_receipt
  representativeOfState := representativeOfState obs
  representative_bound := representative_bound obs
  representative_initial := representative_initial obs
  representative_state := representative_state obs
  representative_nonempty_of_noninitial :=
    representative_nonempty_of_noninitial obs
  outputRealizer := obs.outputRealizer
  outputRealizer_proof := obs.outputRealizer_proof

end ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader

namespace ReachableNoDirectBerardFiniteControllerCertificateForActualTruthAutomatonParityCurrentOrderHeader

theorem representative_preserves_truth
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (cert :
      ReachableNoDirectBerardFiniteControllerCertificateForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (envs : List (EnvironmentRound In₁ In₂)) :
    regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (cert.representativeOfState (cert.stateOfGenerated envs)))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ envs)) := by
  calc
    regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (cert.representativeOfState (cert.stateOfGenerated envs)))) =
        cert.truthOfState
          (cert.stateOfGenerated
            (cert.representativeOfState (cert.stateOfGenerated envs))) := by
          exact (cert.generated_truth
            (cert.representativeOfState (cert.stateOfGenerated envs))).symm
    _ = cert.truthOfState (cert.stateOfGenerated envs) := by
          rw [cert.representative_state envs]
    _ =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ envs)) :=
          cert.generated_truth envs

theorem representative_preserves_epoch
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (cert :
      ReachableNoDirectBerardFiniteControllerCertificateForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (envs : List (EnvironmentRound In₁ In₂)) :
    header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
        header.initialBoundary
        (executionPrefixFromList header.σ
          (cert.representativeOfState (cert.stateOfGenerated envs))) =
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
        header.initialBoundary (executionPrefixFromList header.σ envs) := by
  calc
    header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
        header.initialBoundary
        (executionPrefixFromList header.σ
          (cert.representativeOfState (cert.stateOfGenerated envs))) =
        cert.epochOfState
          (cert.stateOfGenerated
            (cert.representativeOfState (cert.stateOfGenerated envs))) := by
          exact (cert.generated_epoch
            (cert.representativeOfState (cert.stateOfGenerated envs))).symm
    _ = cert.epochOfState (cert.stateOfGenerated envs) := by
          rw [cert.representative_state envs]
    _ =
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (executionPrefixFromList header.σ envs) :=
          cert.generated_epoch envs

theorem representative_preserves_automaton
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (cert :
      ReachableNoDirectBerardFiniteControllerCertificateForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (envs : List (EnvironmentRound In₁ In₂)) :
    header.toCurrentOrderHeader.automatonOfHistory
        (executionPrefixFromList header.σ
          (cert.representativeOfState (cert.stateOfGenerated envs))) =
      header.toCurrentOrderHeader.automatonOfHistory
        (executionPrefixFromList header.σ envs) := by
  exact
    (cert.generated_automaton
      (cert.representativeOfState (cert.stateOfGenerated envs))).symm.trans
      ((congrArg cert.automatonOfState (cert.representative_state envs)).trans
        (cert.generated_automaton envs))

theorem representative_preserves_receipt
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (cert :
      ReachableNoDirectBerardFiniteControllerCertificateForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (envs : List (EnvironmentRound In₁ In₂)) :
    currentReceiptOrderData
        (executionPrefixFromList header.σ
          (cert.representativeOfState (cert.stateOfGenerated envs)))
        (historyCurrentContainmentOrder
          (executionPrefixFromList header.σ
            (cert.representativeOfState (cert.stateOfGenerated envs)))) =
      currentReceiptOrderData
        (executionPrefixFromList header.σ envs)
        (historyCurrentContainmentOrder
          (executionPrefixFromList header.σ envs)) := by
  calc
    currentReceiptOrderData
        (executionPrefixFromList header.σ
          (cert.representativeOfState (cert.stateOfGenerated envs)))
        (historyCurrentContainmentOrder
          (executionPrefixFromList header.σ
            (cert.representativeOfState (cert.stateOfGenerated envs)))) =
        cert.receiptOfState
          (cert.stateOfGenerated
            (cert.representativeOfState (cert.stateOfGenerated envs))) := by
          exact (cert.generated_receipt
            (cert.representativeOfState (cert.stateOfGenerated envs))).symm
    _ = cert.receiptOfState (cert.stateOfGenerated envs) := by
          rw [cert.representative_state envs]
    _ =
        currentReceiptOrderData
          (executionPrefixFromList header.σ envs)
          (historyCurrentContainmentOrder
            (executionPrefixFromList header.σ envs)) :=
          cert.generated_receipt envs

/--
The reachable representative preserves every theorem-facing observation
because it preserves the finite controller state.
-/
theorem representative_preserves_observations
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (cert :
      ReachableNoDirectBerardFiniteControllerCertificateForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (envs : List (EnvironmentRound In₁ In₂)) :
    regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (cert.representativeOfState (cert.stateOfGenerated envs)))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ envs)) ∧
    header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
        header.initialBoundary
        (executionPrefixFromList header.σ
          (cert.representativeOfState (cert.stateOfGenerated envs))) =
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
        header.initialBoundary (executionPrefixFromList header.σ envs) ∧
    header.toCurrentOrderHeader.automatonOfHistory
        (executionPrefixFromList header.σ
          (cert.representativeOfState (cert.stateOfGenerated envs))) =
      header.toCurrentOrderHeader.automatonOfHistory
        (executionPrefixFromList header.σ envs) ∧
    currentReceiptOrderData
        (executionPrefixFromList header.σ
          (cert.representativeOfState (cert.stateOfGenerated envs)))
        (historyCurrentContainmentOrder
          (executionPrefixFromList header.σ
            (cert.representativeOfState (cert.stateOfGenerated envs)))) =
      currentReceiptOrderData
        (executionPrefixFromList header.σ envs)
        (historyCurrentContainmentOrder
          (executionPrefixFromList header.σ envs)) :=
  ⟨ cert.representative_preserves_truth envs
  , cert.representative_preserves_epoch envs
  , cert.representative_preserves_automaton envs
  , cert.representative_preserves_receipt envs ⟩

theorem representative_empty_iff_initial_forward
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (cert :
      ReachableNoDirectBerardFiniteControllerCertificateForActualTruthAutomatonParityCurrentOrderHeader
        header)
    {envs : List (EnvironmentRound In₁ In₂)}
    (hnil : cert.representativeOfState (cert.stateOfGenerated envs) = []) :
    cert.stateOfGenerated envs = cert.initialState := by
  by_contra hnoninitial
  exact cert.representative_nonempty_of_noninitial envs hnoninitial hnil

end ReachableNoDirectBerardFiniteControllerCertificateForActualTruthAutomatonParityCurrentOrderHeader

/--
Generated-prefix representative payload obtained from the reachable-controller
route.

This is the sound replacement for the older universal-cover representative
claim at the generated-prefix level.  It does not assert that every arbitrary
history has a nonempty generated representative.  Instead, for each prefix
generated by the selected strategy, it chooses a bounded representative
generated prefix that preserves the reachable controller state, and therefore
preserves all theorem-facing monitor projections.
-/
structure NoDirectDPAJournalBoundedLocalReachableGeneratedRepresentativePayloadForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  State : Type (max u v x y aut)
  stateFinite : Fintype State
  stateOfGenerated :
    List (EnvironmentRound In₁ In₂) -> State
  initialState : State
  initial_state : stateOfGenerated [] = initialState
  envsOfGenerated :
    List (EnvironmentRound In₁ In₂) -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      (envsOfGenerated envs).length ≤ header.generationBound
  envs_initial :
    envsOfGenerated [] = []
  state_preserved :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      stateOfGenerated (envsOfGenerated envs) = stateOfGenerated envs
  truth_preserved :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ (envsOfGenerated envs))) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ envs))
  epoch_preserved :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary
          (executionPrefixFromList header.σ (envsOfGenerated envs)) =
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (executionPrefixFromList header.σ envs)
  automaton_preserved :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      header.toCurrentOrderHeader.automatonOfHistory
          (executionPrefixFromList header.σ (envsOfGenerated envs)) =
        header.toCurrentOrderHeader.automatonOfHistory
          (executionPrefixFromList header.σ envs)
  receipt_preserved :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      currentReceiptOrderData
          (executionPrefixFromList header.σ (envsOfGenerated envs))
          (historyCurrentContainmentOrder
            (executionPrefixFromList header.σ (envsOfGenerated envs))) =
        currentReceiptOrderData
          (executionPrefixFromList header.σ envs)
          (historyCurrentContainmentOrder
            (executionPrefixFromList header.σ envs))
  envs_nonempty_of_noninitial :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      stateOfGenerated envs ≠ initialState ->
        envsOfGenerated envs ≠ []
  outputRealizer : Prop
  outputRealizer_proof : outputRealizer

/--
Checked conversion from the reachable-controller certificate to the
generated-prefix representative payload.
-/
noncomputable def
    ReachableNoDirectBerardFiniteControllerCertificateForActualTruthAutomatonParityCurrentOrderHeader.toGeneratedRepresentativePayload
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (cert :
      ReachableNoDirectBerardFiniteControllerCertificateForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalReachableGeneratedRepresentativePayloadForActualTruthAutomatonParityCurrentOrderHeader
      header where
  State := cert.State
  stateFinite := cert.stateFinite
  stateOfGenerated := cert.stateOfGenerated
  initialState := cert.initialState
  initial_state := cert.initial_state
  envsOfGenerated := fun envs =>
    cert.representativeOfState (cert.stateOfGenerated envs)
  envs_bound := by
    intro envs
    exact cert.representative_bound (cert.stateOfGenerated envs)
  envs_initial := by
    rw [cert.initial_state]
    exact cert.representative_initial
  state_preserved := cert.representative_state
  truth_preserved := cert.representative_preserves_truth
  epoch_preserved := cert.representative_preserves_epoch
  automaton_preserved := cert.representative_preserves_automaton
  receipt_preserved := cert.representative_preserves_receipt
  envs_nonempty_of_noninitial := cert.representative_nonempty_of_noninitial
  outputRealizer := cert.outputRealizer
  outputRealizer_proof := cert.outputRealizer_proof

/--
External Bérard reachable-controller construction for the no-direct-reversal
fragment.

This is the replacement finite-memory obligation as a Lean interface.

The weak header alone does not imply this construction: `header.σ` is an
arbitrary strategy pair, and `0 < header.generationBound` does not imply that
the bound dominates representatives for all reachable finite-controller
states.  The external Bérard construction must therefore supply the reachable
observer payload explicitly.  The checked Lean work starts from that payload
and converts it to the theorem-facing certificate below.
-/
noncomputable def reachableNoDirectBerardFiniteControllerObserverConstructionImport_of_berardUniform
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (observer :
      ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader
      header :=
  observer

/--
External Bérard reachable-controller certificate for the no-direct-reversal
fragment.

The representative table and its nonempty/bounded correctness are checked by
`toCertificate`; the only external input is the reachable-controller observer
payload above.
-/
noncomputable def reachableNoDirectBerardFiniteControllerCertificateImport_of_berardUniform
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (observer :
      ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    ReachableNoDirectBerardFiniteControllerCertificateForActualTruthAutomatonParityCurrentOrderHeader
      header :=
  (reachableNoDirectBerardFiniteControllerObserverConstructionImport_of_berardUniform
      header observer).toCertificate

/--
Generated-prefix representative payload imported from the external reachable
Bérard observer construction.

This is the endpoint the downstream no-direct refactor should consume before
any all-history representative interface is reintroduced.
-/
noncomputable def reachableNoDirectBerardGeneratedRepresentativePayloadImport_of_berardUniform
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (observer :
      ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalReachableGeneratedRepresentativePayloadForActualTruthAutomatonParityCurrentOrderHeader
      header :=
  (reachableNoDirectBerardFiniteControllerCertificateImport_of_berardUniform
      header observer).toGeneratedRepresentativePayload

/--
Reachable/generated no-direct certificate for one DPA objective.

This is the downstream endpoint for the revised finite-memory route.  It
consumes the reachable generated-prefix payload instead of the older
all-history bounded representative data.  The finite-game backend is still
explicit: the remaining theorem-facing obligation is exactly the finite game
and its realizability equivalence with the DPA objective.
-/
structure NoDirectDPAJournalReachableGeneratedCertificate
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  header :
    NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
      In₁ In₂ Out₁ Out₂ A
  payload :
    NoDirectDPAJournalBoundedLocalReachableGeneratedRepresentativePayloadForActualTruthAutomatonParityCurrentOrderHeader
      header
  finiteFringeCompilation : Prop
  finiteFringeCompilation_proof : finiteFringeCompilation
  boundaryAndBlockTransitionsEffective : Prop
  boundaryAndBlockTransitionsEffective_proof :
    boundaryAndBlockTransitionsEffective
  continuationPreservedBlockByBlock : Prop
  continuationPreservedBlockByBlock_proof :
    continuationPreservedBlockByBlock
  dynamicallyHierarchicalAfterFringeElim : Prop
  dynamicallyHierarchicalAfterFringeElim_proof :
    dynamicallyHierarchicalAfterFringeElim
  finiteGame :
    FiniteDynamicHierarchyParityGame.{max u v x y, max u v x y}
  finiteGameRealizableIff :
    finiteGame.realizable ↔
      ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution σ env)

/--
Assemble the standard no-direct fragment certificate from the
reachable/generated endpoint.
-/
noncomputable def
    NoDirectDPAJournalReachableGeneratedCertificate.toFragmentCertificate
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert :
      NoDirectDPAJournalReachableGeneratedCertificate
        In₁ In₂ Out₁ Out₂ A) :
    NoDirectReversalFragmentCertificate.{max u v x y, u, v, x, y, 0}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂ where
  uniform := cert.header.toCurrentOrderHeader.toHeader.importedUniform
  -- The actual reachable controller state is retained in `cert.payload`.
  -- After the finite-game equivalence is supplied explicitly, the standard
  -- fragment certificate only needs a finite witness state type.
  State := PUnit
  stateFinite := inferInstance
  Realizable :=
    ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
      ∀ env : EnvironmentSequence In₁ In₂,
        A.Accepts (execution σ env)
  finiteGame := cert.finiteGame
  finiteGameRealizableIff := cert.finiteGameRealizableIff
  finiteFringeCompilation := cert.finiteFringeCompilation
  boundaryAndBlockTransitionsEffective :=
    cert.boundaryAndBlockTransitionsEffective
  continuationPreservedBlockByBlock :=
    cert.continuationPreservedBlockByBlock
  dynamicallyHierarchicalAfterFringeElim :=
    cert.dynamicallyHierarchicalAfterFringeElim
  finiteFringeCompilation_proof := cert.finiteFringeCompilation_proof
  boundaryAndBlockTransitionsEffective_proof :=
    cert.boundaryAndBlockTransitionsEffective_proof
  continuationPreservedBlockByBlock_proof :=
    cert.continuationPreservedBlockByBlock_proof
  dynamicallyHierarchicalAfterFringeElim_proof :=
    cert.dynamicallyHierarchicalAfterFringeElim_proof

/--
DPA-level no-direct decision route through the reachable/generated
finite-memory certificate and explicit finite-game backend.
-/
noncomputable def
    noDirectDPASynthesisDecidable_ofJournalReachableGeneratedCertificate
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (cert :
      NoDirectDPAJournalReachableGeneratedCertificate
        In₁ In₂ Out₁ Out₂ A) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  cert.toFragmentCertificate.dpaSynthesisDecidable A Iff.rfl

/--
Formula-level no-direct route through the reachable/generated finite-memory
certificate.
-/
noncomputable def main_result_for_ltl_dpa_journalReachableGeneratedCertificate_noDirect
    {AP : Type ap}
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    [DecidableEq AP]
    (compiler :
      LTLToDPACompiler.{ap, max u v x y, aut}
        AP
        (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (formula : LTL AP)
    (cert :
      NoDirectDPAJournalReachableGeneratedCertificate
        In₁ In₂ Out₁ Out₂ (compiler.compile formula)) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          LTL.Satisfies compiler.interp word formula)) := by
  let A := compiler.compile formula
  let dpaDecision :
      Decidable (SynthesisProblem (dpaSpecification A)) :=
    noDirectDPASynthesisDecidable_ofJournalReachableGeneratedCertificate
      A cert
  cases dpaDecision with
  | isTrue h =>
      exact
        isTrue
          (by
            rcases h with ⟨σ, hσ⟩
            exact
              ⟨σ, fun env =>
                (compiler.correct formula (execution σ env)).mp (hσ env)⟩)
  | isFalse h =>
      exact
        isFalse
          (by
            intro hltl
            rcases hltl with ⟨σ, hσ⟩
            exact
              h
                ⟨σ, fun env =>
                  (compiler.correct formula (execution σ env)).mpr (hσ env)⟩)

/--
Concrete output expected from the external Bérard rational-run construction.

`RawObserver` is the finite product of last-block mode, boundary/rational
control, stabilized truth, raw no-direct epoch state, and current receipt/order
payload.  The conversion below indexes this output by stabilized truth atoms.
-/
structure ConcreteNoDirectBerardRationalRunOutputForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  RawObserver : Type (max u v x y aut)
  rawObserverFinite : Fintype RawObserver
  rawObserverInhabited : Inhabited RawObserver
  rawObserverOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> RawObserver
  rawObserverOfGenerated :
    List (EnvironmentRound In₁ In₂) -> RawObserver
  rawTruth :
    RawObserver ->
      RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  rawEpoch :
    RawObserver ->
      EpochRotatingAccessState
        header.toCurrentOrderHeader.toHeader.importedUniform.boundary
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two)
  rawReceipt :
    RawObserver -> ReceiptOrderData
  history_truth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      rawTruth (rawObserverOfHistory h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h)
  history_epoch :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      rawEpoch (rawObserverOfHistory h) =
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary h
  history_receipt :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      rawReceipt (rawObserverOfHistory h) =
        currentReceiptOrderData h (historyCurrentContainmentOrder h)
  generated_truth :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      rawTruth (rawObserverOfGenerated envs) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ envs))
  truth_complete :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      ∃ envs : List (EnvironmentRound In₁ In₂),
        envs ≠ [] ∧
        envs.length ≤ header.generationBound ∧
        rawTruth (rawObserverOfGenerated envs) =
          rawTruth (rawObserverOfHistory h)
  epoch_eq_of_truth_eq :
    ∀ o o' : RawObserver,
      rawTruth o = rawTruth o' ->
      rawEpoch o = rawEpoch o'
  receipt_eq_of_truth_eq :
    ∀ o o' : RawObserver,
      rawTruth o = rawTruth o' ->
      rawReceipt o = rawReceipt o'
  automaton_eq_of_truth_eq :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      header.toCurrentOrderHeader.automatonOfHistory h =
        header.toCurrentOrderHeader.automatonOfHistory h'
  defaultEnvWord :
    List (EnvironmentRound In₁ In₂)
  defaultEnvWord_nonempty :
    defaultEnvWord ≠ []
  defaultEnvWord_bound :
    defaultEnvWord.length ≤ header.generationBound
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
Turn the representative-complete finite cover into the concrete rational-run
output used by the checked truth-indexed table construction.

The proof of `truth_complete` is the formal version of the paper's
representative step: for a history `h`, take the cover state reached by its
last block and use the generated representative that reaches exactly that
cover state.  Equality of truth is then just `congrArg coverTruth` applied to
`representative_cover`.
-/
noncomputable def
    RepresentativeCompleteNoDirectBerardFiniteCoverForActualTruthAutomatonParityCurrentOrderHeader.toConcreteRationalRunOutput
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (cover :
      RepresentativeCompleteNoDirectBerardFiniteCoverForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    ConcreteNoDirectBerardRationalRunOutputForActualTruthAutomatonParityCurrentOrderHeader
      header where
  RawObserver := cover.CoverState
  rawObserverFinite := cover.coverFinite
  rawObserverInhabited := cover.coverInhabited
  rawObserverOfHistory := cover.coverOfHistory
  rawObserverOfGenerated := cover.coverOfGenerated
  rawTruth := cover.coverTruth
  rawEpoch := cover.coverEpoch
  rawReceipt := cover.coverReceipt
  history_truth := cover.history_truth
  history_epoch := cover.history_epoch
  history_receipt := cover.history_receipt
  generated_truth := cover.generated_truth
  truth_complete := by
    intro h
    refine
      ⟨ cover.representativeOfCover (cover.coverOfHistory h)
      , cover.representative_nonempty (cover.coverOfHistory h)
      , cover.representative_bound (cover.coverOfHistory h)
      , ?_ ⟩
    simpa using
      congrArg cover.coverTruth
        (cover.representative_cover (cover.coverOfHistory h))
  epoch_eq_of_truth_eq := cover.epoch_eq_of_truth_eq
  receipt_eq_of_truth_eq := cover.receipt_eq_of_truth_eq
  automaton_eq_of_truth_eq := cover.automaton_eq_of_truth_eq
  defaultEnvWord :=
    cover.representativeOfCover (@default cover.CoverState cover.coverInhabited)
  defaultEnvWord_nonempty :=
    cover.representative_nonempty (@default cover.CoverState cover.coverInhabited)
  defaultEnvWord_bound :=
    cover.representative_bound (@default cover.CoverState cover.coverInhabited)
  coherentHistoryNonempty := cover.coherentHistoryNonempty

/--
Convert the concrete rational-run output into the Bérard summary certificate.

The final observer is the stabilized truth atom.  For each realized truth atom,
choose a witness history and then the nonempty bounded generated word supplied
by `truth_complete`; unrealized truth atoms use the default bounded word.
-/
noncomputable def
    ConcreteNoDirectBerardRationalRunOutputForActualTruthAutomatonParityCurrentOrderHeader.toRationalSummaryCertificate
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (run :
      ConcreteNoDirectBerardRationalRunOutputForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    BoundedNoDirectBerardRationalSummaryCertificateForActualTruthAutomatonParityCurrentOrderHeader
      header := by
  classical
  let TruthAtom := RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  letI : Fintype TruthAtom :=
    regularTestTruthAtomFintype (stabilizedSaturationBasis header.cert)
  let truthOfHistory : History In₁ In₂ Graph Out₁ Out₂ -> TruthAtom :=
    fun h =>
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  let RealizedTruth : TruthAtom -> Prop :=
    fun truth => ∃ h : History In₁ In₂ Graph Out₁ Out₂, truthOfHistory h = truth
  let envsOfTruth : TruthAtom -> List (EnvironmentRound In₁ In₂) :=
    fun truth =>
      if hreal : RealizedTruth truth then
        Classical.choose (run.truth_complete (Classical.choose hreal))
      else
        run.defaultEnvWord
  let receiptOfTruth : TruthAtom -> ReceiptOrderData :=
    fun truth =>
      if hreal : RealizedTruth truth then
        run.rawReceipt (run.rawObserverOfHistory (Classical.choose hreal))
      else
        defaultReceiptOrderData
  refine
    { Observer := ULift.{max u v x y aut} TruthAtom
      observerFinite := inferInstance
      observerOfHistory := fun h => ULift.up (truthOfHistory h)
      observerOfTruth := fun truth => ULift.up truth
      observer_truth_factor := ?_
      envsOfObserver := fun truth => envsOfTruth truth.down
      envs_bound := ?_
      envs_truth := ?_
      envs_nonempty := ?_
      closureInvariants := ?_
      receiptOrderOfObserver := fun truth => receiptOfTruth truth.down
      receiptOrder_observer := ?_
      coherentHistoryNonempty := run.coherentHistoryNonempty }
  · intro h
    rfl
  · intro truth
    by_cases hreal : RealizedTruth truth.down
    · have hspec :=
        Classical.choose_spec
          (run.truth_complete (Classical.choose hreal))
      simpa [envsOfTruth, hreal] using hspec.2.1
    · simpa [envsOfTruth, hreal] using run.defaultEnvWord_bound
  · intro h
    let truth : TruthAtom := truthOfHistory h
    have hreal : RealizedTruth truth := ⟨h, rfl⟩
    let h₀ : History In₁ In₂ Graph Out₁ Out₂ := Classical.choose hreal
    let envs : List (EnvironmentRound In₁ In₂) :=
      Classical.choose (run.truth_complete h₀)
    have hspec : envs ≠ [] ∧ envs.length ≤ header.generationBound ∧
        run.rawTruth (run.rawObserverOfGenerated envs) =
          run.rawTruth (run.rawObserverOfHistory h₀) := by
      simpa [envs] using
        Classical.choose_spec (run.truth_complete h₀)
    have htruth₀ : truthOfHistory h₀ = truth := by
      simpa [h₀] using Classical.choose_spec hreal
    have henvs :
        envsOfTruth truth = envs := by
      simp [envsOfTruth, hreal, h₀, envs]
    calc
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ (envsOfTruth (truthOfHistory h)))) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (executionPrefixFromList header.σ envs)) := by
            rw [show truthOfHistory h = truth by rfl, henvs]
      _ = run.rawTruth (run.rawObserverOfGenerated envs) := by
            exact (run.generated_truth envs).symm
      _ = run.rawTruth (run.rawObserverOfHistory h₀) := hspec.2.2
      _ = truthOfHistory h₀ := run.history_truth h₀
      _ = truth := htruth₀
      _ = truthOfHistory h := rfl
  · intro h hnil
    let truth : TruthAtom := truthOfHistory h
    have hreal : RealizedTruth truth := ⟨h, rfl⟩
    let h₀ : History In₁ In₂ Graph Out₁ Out₂ := Classical.choose hreal
    let envs : List (EnvironmentRound In₁ In₂) :=
      Classical.choose (run.truth_complete h₀)
    have hspec : envs ≠ [] ∧ envs.length ≤ header.generationBound ∧
        run.rawTruth (run.rawObserverOfGenerated envs) =
          run.rawTruth (run.rawObserverOfHistory h₀) := by
      simpa [envs] using
        Classical.choose_spec (run.truth_complete h₀)
    have henvs :
        envsOfTruth truth = envs := by
      simp [envsOfTruth, hreal, h₀, envs]
    have hnil' : envs = [] := by
      rw [← henvs]
      exact hnil
    exact hspec.1 hnil'
  · refine
      { rawEpochState_invariant := ?_
        automatonOfHistory_invariant := ?_ }
    · intro _hdet _hpred _hboundary _hcont h h' htruth
      have hrawTruth :
          run.rawTruth (run.rawObserverOfHistory h) =
            run.rawTruth (run.rawObserverOfHistory h') := by
        calc
          run.rawTruth (run.rawObserverOfHistory h) =
              truthOfHistory h := run.history_truth h
          _ = truthOfHistory h' := htruth
          _ = run.rawTruth (run.rawObserverOfHistory h') :=
              (run.history_truth h').symm
      calc
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h =
            run.rawEpoch (run.rawObserverOfHistory h) :=
              (run.history_epoch h).symm
        _ =
            run.rawEpoch (run.rawObserverOfHistory h') :=
              run.epoch_eq_of_truth_eq
                (run.rawObserverOfHistory h) (run.rawObserverOfHistory h')
                hrawTruth
        _ =
            header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
              header.initialBoundary h' :=
              run.history_epoch h'
    · intro _hcont h h' htruth
      exact run.automaton_eq_of_truth_eq h h' htruth
  · intro h
    let truth : TruthAtom := truthOfHistory h
    have hreal : RealizedTruth truth := ⟨h, rfl⟩
    let h₀ : History In₁ In₂ Graph Out₁ Out₂ := Classical.choose hreal
    have htruth₀ : truthOfHistory h₀ = truth := by
      simpa [h₀] using Classical.choose_spec hreal
    have hrawTruth :
        run.rawTruth (run.rawObserverOfHistory h₀) =
          run.rawTruth (run.rawObserverOfHistory h) := by
      calc
        run.rawTruth (run.rawObserverOfHistory h₀) =
            truthOfHistory h₀ := run.history_truth h₀
        _ = truth := htruth₀
        _ = truthOfHistory h := rfl
        _ = run.rawTruth (run.rawObserverOfHistory h) :=
            (run.history_truth h).symm
    have hreceipt :
        receiptOfTruth truth =
          run.rawReceipt (run.rawObserverOfHistory h₀) := by
      simp [receiptOfTruth, hreal, h₀]
    calc
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
          run.rawReceipt (run.rawObserverOfHistory h) :=
            (run.history_receipt h).symm
      _ =
          run.rawReceipt (run.rawObserverOfHistory h₀) := by
            exact
              (run.receipt_eq_of_truth_eq
                (run.rawObserverOfHistory h₀) (run.rawObserverOfHistory h)
                hrawTruth).symm
      _ = receiptOfTruth truth := hreceipt.symm
      _ = receiptOfTruth (truthOfHistory h) := rfl

/--
Index the Bérard observer table by stabilized truth atoms.  This is the exact
Lean proof described in the guide: every field is a projection from the
observer certificate, with `observer_truth_factor` used for the two rewrites.
-/
noncomputable def
    BoundedNoDirectBerardRationalSummaryCertificateForActualTruthAutomatonParityCurrentOrderHeader.toBerardLastBlockTable
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (summaryCert :
      BoundedNoDirectBerardRationalSummaryCertificateForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalBerardLastBlockTableForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfTruth := fun truth =>
    summaryCert.envsOfObserver (summaryCert.observerOfTruth truth)
  envs_bound := fun truth =>
    summaryCert.envs_bound (summaryCert.observerOfTruth truth)
  envs_actualTruth := by
    intro h
    calc
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ
              (summaryCert.envsOfObserver
                (summaryCert.observerOfTruth
                  (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                    (pathOfHistoryByRound header.edgeOfRound h)))))) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (executionPrefixFromList header.σ
                (summaryCert.envsOfObserver (summaryCert.observerOfHistory h)))) := by
            rw [← summaryCert.observer_truth_factor h]
      _ =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h) :=
            summaryCert.envs_truth h
  envs_nonempty := by
    intro h hnil
    have hnil' :
        summaryCert.envsOfObserver (summaryCert.observerOfHistory h) = [] := by
      rw [summaryCert.observer_truth_factor h]
      exact hnil
    exact summaryCert.envs_nonempty h hnil'
  closureInvariants := summaryCert.closureInvariants
  receiptOrderOfTruth := fun truth =>
    summaryCert.receiptOrderOfObserver (summaryCert.observerOfTruth truth)
  receiptOrder_factor := by
    intro h
    calc
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
          summaryCert.receiptOrderOfObserver (summaryCert.observerOfHistory h) :=
            summaryCert.receiptOrder_observer h
      _ =
          summaryCert.receiptOrderOfObserver
            (summaryCert.observerOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h))) := by
            rw [summaryCert.observer_truth_factor h]
  coherentHistoryNonempty := summaryCert.coherentHistoryNonempty

/--
Assemble the paper proof package into the last-block finite-memory summary
core.  This is the literal Lean version of the proof's final construction:
take the stabilized truth atom as the finite state, read representatives from
the representative table, and read the hidden receipt/order bit from the
truth-factor decoder.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalLastBlockFiniteMemoryProofPackageForActualTruthAutomatonParityCurrentOrderHeader.toSummaryCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (pkg :
      NoDirectDPAJournalBoundedLocalLastBlockFiniteMemoryProofPackageForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalLastBlockFiniteMemorySummaryCoreForActualTruthAutomatonParityCurrentOrderHeader
      header where
  SummaryState := RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  summaryStateFinite := regularTestTruthAtomFintype (stabilizedSaturationBasis header.cert)
  summaryOfHistory := fun h =>
    regularTestTruthVector (stabilizedSaturationBasis header.cert)
      (pathOfHistoryByRound header.edgeOfRound h)
  summaryOfTruth := id
  summary_truth_factor := by
    intro h
    rfl
  envsOfSummary := pkg.representatives.envsOfTruth
  envs_bound := pkg.representatives.envs_bound
  envs_actualTruth := pkg.representatives.envs_actualTruth
  envs_nonempty := pkg.representatives.envs_nonempty
  closureInvariants := pkg.closureInvariants
  receiptOrderOfSummary := pkg.receiptOrder.receiptOrderOfTruth
  receiptOrder_summary := pkg.receiptOrder.receiptOrder_factor
  coherentHistoryNonempty := pkg.coherentHistoryNonempty

/--
The last-block summary construction is exactly the existing `finiteMemory`
certificate.  The hidden bit is discharged here: receipt/order equality follows
because both histories with equal actual truth have the same finite summary.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalLastBlockFiniteMemorySummaryCoreForActualTruthAutomatonParityCurrentOrderHeader.toClosureInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalLastBlockFiniteMemorySummaryCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalActualTruthClosureInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfHistory := fun h => core.envsOfSummary (core.summaryOfHistory h)
  envs_bound := fun h => core.envs_bound (core.summaryOfHistory h)
  envs_actualTruth := core.envs_actualTruth
  envs_nonempty := core.envs_nonempty
  closureInvariants := core.closureInvariants
  receiptOrder_invariant := by
    intro h h' htruth
    calc
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
          core.receiptOrderOfSummary (core.summaryOfHistory h) :=
            core.receiptOrder_summary h
      _ =
          core.receiptOrderOfSummary
            (core.summaryOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h))) := by
            rw [core.summary_truth_factor h]
      _ =
          core.receiptOrderOfSummary
            (core.summaryOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h'))) := by
            rw [htruth]
      _ =
          core.receiptOrderOfSummary (core.summaryOfHistory h') := by
            rw [core.summary_truth_factor h']
      _ =
          currentReceiptOrderData h' (historyCurrentContainmentOrder h') :=
            (core.receiptOrder_summary h').symm
  coherentHistoryNonempty := core.coherentHistoryNonempty

