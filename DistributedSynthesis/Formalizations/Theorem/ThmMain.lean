      List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      (envsOfTruth truth).length ≤ header.generationBound
  envs_actualTruth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (envsOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h))))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  envs_nonempty :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      envsOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h)) ≠ []

/--
Empty-safe representative data for stabilized truth atoms.

This is the representative part needed by the truth-indexed closure/truth-factor
handoff.  It deliberately omits the older nonempty field: the empty history may
be represented by the empty generated word.
-/
structure NoDirectDPAJournalBoundedLocalTruthIndexedRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
      List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      (envsOfTruth truth).length ≤ header.generationBound
  envs_actualTruth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (envsOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h))))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)

/--
Realized-truth representative data for the empty-safe handoff.

The Bérard construction only has to build representatives for truth atoms in
the image of the history-to-truth map.  The conversion below totalizes this data
by assigning an arbitrary empty representative to unrealized truth atoms, which
are never queried by `envs_actualTruth`.
-/
structure NoDirectDPAJournalBoundedLocalRealizedTruthRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfRealizedTruth :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth ->
        List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
      (hreal :
        StabilizedSaturationBasisNoDirectRealizedTruthAtom
          header.cert (pathOfHistoryByRound header.edgeOfRound) truth),
      (envsOfRealizedTruth truth hreal).length ≤ header.generationBound
  envs_realizes :
    ∀ (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
      (hreal :
        StabilizedSaturationBasisNoDirectRealizedTruthAtom
          header.cert (pathOfHistoryByRound header.edgeOfRound) truth),
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (envsOfRealizedTruth truth hreal))) =
        truth

/--
Totalize realized-truth representative data into the theorem-facing
truth-indexed representative table.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalRealizedTruthRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader.toTruthIndexedRepresentativeData
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (representatives :
      NoDirectDPAJournalBoundedLocalRealizedTruthRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalTruthIndexedRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader
      header := by
  classical
  let TruthAtom := RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  let actualTruth : History In₁ In₂ Graph Out₁ Out₂ -> TruthAtom :=
    fun h =>
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  let Realized : TruthAtom -> Prop :=
    fun truth =>
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth
  let envsOfTruth : TruthAtom -> List (EnvironmentRound In₁ In₂) :=
    fun truth =>
      if hreal : Realized truth then
        representatives.envsOfRealizedTruth truth hreal
      else
        []
  refine
    { envsOfTruth := envsOfTruth
      envs_bound := ?_
      envs_actualTruth := ?_ }
  · intro truth
    by_cases hreal : Realized truth
    · dsimp [envsOfTruth]
      rw [dif_pos hreal]
      exact representatives.envs_bound truth hreal
    · dsimp [envsOfTruth]
      rw [dif_neg hreal]
      exact Nat.zero_le header.generationBound
  · intro h
    have hreal : Realized (actualTruth h) := ⟨h, rfl⟩
    calc
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ
              (envsOfTruth (actualTruth h)))) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (executionPrefixFromList header.σ
                (representatives.envsOfRealizedTruth (actualTruth h) hreal))) := by
            dsimp [envsOfTruth]
            rw [dif_pos hreal]
      _ = actualTruth h :=
          representatives.envs_realizes (actualTruth h) hreal

/--
Forget the obsolete nonempty representative field from the older representative
data.
-/
def
    NoDirectDPAJournalBoundedLocalTruthRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader.toTruthIndexedRepresentativeData
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (representatives :
      NoDirectDPAJournalBoundedLocalTruthRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalTruthIndexedRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfTruth := representatives.envsOfTruth
  envs_bound := representatives.envs_bound
  envs_actualTruth := representatives.envs_actualTruth

/--
Empty-safe package form of the Bérard truth-factor handoff.

It combines bounded generated representatives of stabilized truth atoms with the
already checked raw/automaton and receipt/order truth-factor packages.  Unlike
the older blockwise package, it has no coherent-history nonemptiness field.
-/
structure NoDirectDPAJournalBoundedLocalTruthIndexedClosureTruthFactorPackagesForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  representatives :
    NoDirectDPAJournalBoundedLocalTruthIndexedRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader
      header
  rawFactor :
    StabilizedSaturationBasisBoundedGeneratedRawAutomatonFactorData
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.toCurrentOrderHeader.automatonOfHistory
  receiptOrder :
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory

/--
Realized-truth package form of the empty-safe Bérard handoff.

This is the smallest package boundary currently exposed in Lean: the
representative component ranges only over realized stabilized truth atoms, while
the raw/automaton and receipt/order components remain the checked truth-factor
packages.
-/
structure NoDirectDPAJournalBoundedLocalRealizedTruthClosureTruthFactorPackagesForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  representatives :
    NoDirectDPAJournalBoundedLocalRealizedTruthRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader
      header
  rawFactor :
    StabilizedSaturationBasisBoundedGeneratedRawAutomatonFactorData
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.toCurrentOrderHeader.automatonOfHistory
  receiptOrder :
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory

/--
Realized-truth invariant form of the empty-safe Bérard handoff.

This is one step closer to the mathematical proof than the package boundary:
the Bérard side supplies realized representatives, closure truth-vector
invariants for raw epoch/automaton state, and truth determinacy of the current
receipt/order payload.  Lean constructs the raw/automaton and receipt/order
truth-factor packages from these invariants.
-/
structure NoDirectDPAJournalBoundedLocalRealizedTruthClosureInvariantDataForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  representatives :
    NoDirectDPAJournalBoundedLocalRealizedTruthRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader
      header
  closureInvariants :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  receiptOrder_invariant :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h')

/--
Build the checked truth-factor packages from the realized-truth invariant data.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalRealizedTruthClosureInvariantDataForActualTruthAutomatonParityCurrentOrderHeader.toRealizedTruthClosureTruthFactorPackages
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (data :
      NoDirectDPAJournalBoundedLocalRealizedTruthClosureInvariantDataForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalRealizedTruthClosureTruthFactorPackagesForActualTruthAutomatonParityCurrentOrderHeader
      header where
  representatives := data.representatives
  rawFactor :=
    StabilizedSaturationBasisBoundedGeneratedRawAutomatonFactorData.of_splitQuotientFactorization
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
      (StabilizedSaturationBasisNoDirectSplitQuotientFactorization_of_invariants
        header.toCurrentOrderHeader.toHeader.importedUniform
        header.initialBoundary
        header.cert
        (pathOfHistoryByRound header.edgeOfRound)
        header.containmentOrder
        historyCurrentContainmentOrder
        header.toCurrentOrderHeader.automatonOfHistory
        data.closureInvariants.rawEpochState_invariant
        data.closureInvariants.automatonOfHistory_invariant)
  receiptOrder :=
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData.of_truthDeterminesReceiptOrder
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
      data.receiptOrder_invariant

/--
Totalize realized representatives and keep the checked truth-factor packages.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalRealizedTruthClosureTruthFactorPackagesForActualTruthAutomatonParityCurrentOrderHeader.toTruthIndexedClosureTruthFactorPackages
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (packages :
      NoDirectDPAJournalBoundedLocalRealizedTruthClosureTruthFactorPackagesForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalTruthIndexedClosureTruthFactorPackagesForActualTruthAutomatonParityCurrentOrderHeader
      header where
  representatives := packages.representatives.toTruthIndexedRepresentativeData
  rawFactor := packages.rawFactor
  receiptOrder := packages.receiptOrder

/--
Assemble the truth-indexed empty-safe core from the package interface.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalTruthIndexedClosureTruthFactorPackagesForActualTruthAutomatonParityCurrentOrderHeader.toTruthIndexedClosureTruthFactorCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (packages :
      NoDirectDPAJournalBoundedLocalTruthIndexedClosureTruthFactorPackagesForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalTruthIndexedClosureTruthFactorCoreForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfTruth := packages.representatives.envsOfTruth
  envs_bound := packages.representatives.envs_bound
  envs_actualTruth := packages.representatives.envs_actualTruth
  rawEpochOfTruth := packages.rawFactor.rawEpochOfTruth
  rawEpoch_factor := by
    intro h
    exact
      (packages.rawFactor.rawEpoch_factor
        header.cert.determinesPathData_proof
        header.cert.predecessorClosed_proof
        header.cert.boundaryClosed_proof
        header.cert.continuationClosed_proof h).symm
  receiptOrderOfTruth := packages.receiptOrder.receiptOrderOfTruth
  receiptOrder_factor := packages.receiptOrder.receiptOrder_factor

/--
Package interface for the remaining Bérard truth-factor import.

The raw-epoch and receipt/order components reuse existing no-direct saturation
packages.  The only new representative component is
`TruthRepresentativeData`.
-/
structure NoDirectDPAJournalBoundedLocalTruthFactorBlockwisePackagesForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  representatives :
    NoDirectDPAJournalBoundedLocalTruthRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader
      header
  rawFactor :
    StabilizedSaturationBasisBoundedGeneratedRawAutomatonFactorData
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.toCurrentOrderHeader.automatonOfHistory
  receiptOrder :
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
Forget the legacy nonempty/coherent fields from the older blockwise package and
keep the empty-safe truth-indexed package.
-/
def
    NoDirectDPAJournalBoundedLocalTruthFactorBlockwisePackagesForActualTruthAutomatonParityCurrentOrderHeader.toTruthIndexedClosureTruthFactorPackages
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (packages :
      NoDirectDPAJournalBoundedLocalTruthFactorBlockwisePackagesForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalTruthIndexedClosureTruthFactorPackagesForActualTruthAutomatonParityCurrentOrderHeader
      header where
  representatives := packages.representatives.toTruthIndexedRepresentativeData
  rawFactor := packages.rawFactor
  receiptOrder := packages.receiptOrder

/--
Separation-data interface for the remaining Bérard block argument.

This is smaller than the package interface: raw factorization is supplied in
the existing split-quotient form, and receipt/order factorization is derived
from finite receipt/order determinacy.  The full current local views are not
part of this interface.
-/
structure NoDirectDPAJournalBoundedLocalTruthFactorBlockwiseSeparationDataForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  representatives :
    NoDirectDPAJournalBoundedLocalTruthRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader
      header
  splitFactorization :
    StabilizedSaturationBasisNoDirectSplitQuotientFactorization
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  receiptOrder_eq_of_truth_eq :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h')
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
History-indexed form of the remaining blockwise separation argument.

This is the shape produced directly by the last-block Bérard proof: for each
history it gives a bounded nonempty generated representative with the same
stabilized truth atom, plus split raw/automaton factorization and
finite receipt/order determinacy.  The conversion below performs the finite
truth-atom choice needed by the public separation-data interface: realized
truth atoms use a chosen realizing history, while unrealized atoms use the
empty-history default and are never queried by the nonempty/realizes fields.
-/
structure NoDirectDPAJournalBoundedLocalHistoryRepresentativeSeparationCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      (envsOfHistory h).length ≤ header.generationBound
  envs_actualTruth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ (envsOfHistory h))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  envs_nonempty :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      envsOfHistory h ≠ []
  splitFactorization :
    StabilizedSaturationBasisNoDirectSplitQuotientFactorization
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  receiptOrder_eq_of_truth_eq :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h')
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
Choose one bounded generated representative for each realized stabilized truth
atom from a history-indexed representative core.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalHistoryRepresentativeSeparationCoreForActualTruthAutomatonParityCurrentOrderHeader.toSeparationData
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalHistoryRepresentativeSeparationCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalTruthFactorBlockwiseSeparationDataForActualTruthAutomatonParityCurrentOrderHeader
      header := by
  classical
  let actualTruth :=
    fun h : History In₁ In₂ Graph Out₁ Out₂ =>
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  let realized :=
    fun truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert) =>
      ∃ h : History In₁ In₂ Graph Out₁ Out₂, actualTruth h = truth
  let defaultHistory : History In₁ In₂ Graph Out₁ Out₂ := []
  let defaultTruth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert) :=
    actualTruth defaultHistory
  let selectedHistory :
      RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
        History In₁ In₂ Graph Out₁ Out₂ :=
    fun truth =>
      if hreal : realized truth then
        Classical.choose hreal
      else
        defaultHistory
  let envsOfTruth :
      RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
        List (EnvironmentRound In₁ In₂) :=
    fun truth => core.envsOfHistory (selectedHistory truth)
  refine
    { representatives :=
        { envsOfTruth := envsOfTruth
          envs_bound := ?_
          envs_actualTruth := ?_
          envs_nonempty := ?_ }
      splitFactorization := core.splitFactorization
      receiptOrder_eq_of_truth_eq := core.receiptOrder_eq_of_truth_eq
      coherentHistoryNonempty := core.coherentHistoryNonempty }
  · intro truth
    exact core.envs_bound (selectedHistory truth)
  · intro h
    have hreal :
        realized (actualTruth h) := ⟨h, rfl⟩
    have hselectedTruth :
        actualTruth (selectedHistory (actualTruth h)) = actualTruth h := by
      dsimp [selectedHistory]
      rw [dif_pos hreal]
      exact Classical.choose_spec hreal
    calc
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ
              (envsOfTruth (actualTruth h)))) =
          actualTruth (selectedHistory (actualTruth h)) := by
            dsimp [envsOfTruth, actualTruth]
            exact core.envs_actualTruth (selectedHistory (actualTruth h))
      _ = actualTruth h := hselectedTruth
  · intro h
    exact core.envs_nonempty (selectedHistory (actualTruth h))

/--
The closure/current-view core implies the separation-data interface used by the
blockwise truth-factor route.

This removes three pieces of bookkeeping from the remaining Bérard proof:
raw/automaton split quotient data is obtained from the closure invariants,
receipt/order determinacy follows from current-view determinacy, and the
truth-indexed representatives are chosen by the existing finite-choice
conversion for history-indexed representatives.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsCoreForActualTruthAutomatonParityCurrentOrderHeader.toTruthFactorBlockwiseSeparationData
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalTruthFactorBlockwiseSeparationDataForActualTruthAutomatonParityCurrentOrderHeader
      header := by
  classical
  refine
    (NoDirectDPAJournalBoundedLocalHistoryRepresentativeSeparationCoreForActualTruthAutomatonParityCurrentOrderHeader.toSeparationData
      ?_)
  exact
    { envsOfHistory := core.envsOfHistory
      envs_bound := core.envs_bound
      envs_actualTruth := core.envs_actualTruth
      envs_nonempty := core.envs_nonempty
      splitFactorization :=
        StabilizedSaturationBasisNoDirectSplitQuotientFactorization_of_invariants
          header.toCurrentOrderHeader.toHeader.importedUniform
          header.initialBoundary
          header.cert
          (pathOfHistoryByRound header.edgeOfRound)
          header.containmentOrder
          historyCurrentContainmentOrder
          header.toCurrentOrderHeader.automatonOfHistory
          core.closureInvariants.rawEpochState_invariant
          core.closureInvariants.automatonOfHistory_invariant
      receiptOrder_eq_of_truth_eq := by
        intro h h' htruth
        have hviews := core.currentViews_determined h h' htruth
        have hone :
            (currentView Proc.one h).receiptTag =
              (currentView Proc.one h').receiptTag :=
          congrArg (fun views => views.1.receiptTag) hviews
        have htwo :
            (currentView Proc.two h).receiptTag =
              (currentView Proc.two h').receiptTag :=
          congrArg (fun views => views.2.receiptTag) hviews
        have horder :
            historyCurrentContainmentOrder h =
              historyCurrentContainmentOrder h' :=
          historyCurrentContainmentOrder_eq_of_currentViews_eq hviews
        change
          ({ receiptOne := (currentView Proc.one h).receiptTag
             receiptTwo := (currentView Proc.two h).receiptTag
             containmentOrder := historyCurrentContainmentOrder h } :
              ReceiptOrderData) =
            { receiptOne := (currentView Proc.one h').receiptTag
              receiptTwo := (currentView Proc.two h').receiptTag
              containmentOrder := historyCurrentContainmentOrder h' }
        simp [hone, htwo, horder]
      coherentHistoryNonempty := core.coherentHistoryNonempty }

/--
Raw-epoch and receipt/order truth-factor maps imply the history-indexed
separation core.  This gives the Bérard proof an equivalent, often more
convenient, target: prove the two semantic quotient maps directly, and Lean
builds the split quotient package.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalActualTruthRawEpochReceiptCoreForActualTruthAutomatonParityCurrentOrderHeader.toHistoryRepresentativeSeparationCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthRawEpochReceiptCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalHistoryRepresentativeSeparationCoreForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfHistory := core.envsOfHistory
  envs_bound := core.envs_bound
  envs_actualTruth := core.envs_actualTruth
  envs_nonempty := core.envs_nonempty
  splitFactorization :=
    StabilizedSaturationBasisNoDirectSplitQuotientFactorization.of_fields
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
      core.rawEpochOfTruth
      core.rawEpoch_factor
      header.automatonOfTruth
      (by
        intro _ h
        rfl)
  receiptOrder_eq_of_truth_eq := by
    intro h h' htruth
    calc
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
          core.receiptOrderOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h)) :=
            core.receiptOrder_factor h
      _ =
          core.receiptOrderOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h')) := by
            rw [htruth]
      _ =
          currentReceiptOrderData h' (historyCurrentContainmentOrder h') := by
            exact (core.receiptOrder_factor h').symm
  coherentHistoryNonempty := core.coherentHistoryNonempty

/--
Convert separation data into the package interface consumed by the checked
truth-factor assembly.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalTruthFactorBlockwiseSeparationDataForActualTruthAutomatonParityCurrentOrderHeader.toPackages
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (data :
      NoDirectDPAJournalBoundedLocalTruthFactorBlockwiseSeparationDataForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalTruthFactorBlockwisePackagesForActualTruthAutomatonParityCurrentOrderHeader
      header where
  representatives := data.representatives
  rawFactor :=
    StabilizedSaturationBasisBoundedGeneratedRawAutomatonFactorData.of_splitQuotientFactorization
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
      data.splitFactorization
  receiptOrder :=
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData.of_truthDeterminesReceiptOrder
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
      data.receiptOrder_eq_of_truth_eq
  coherentHistoryNonempty := data.coherentHistoryNonempty

/--
Assemble the package-level blockwise truth-factor construction from the
finite-memory current-view core.

This is the checked package construction: once the finite-memory proof has
chosen nonempty bounded generated representatives and proved current-view
truth-determinacy, Lean derives the raw no-direct split quotient and the
receipt/order truth factor, then packages the truth-indexed representatives.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsCoreForActualTruthAutomatonParityCurrentOrderHeader.toTruthFactorBlockwisePackages
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalTruthFactorBlockwisePackagesForActualTruthAutomatonParityCurrentOrderHeader
      header :=
  core.toTruthFactorBlockwiseSeparationData.toPackages

/--
Assemble the package-level blockwise truth-factor construction from the
closure/receipt invariant core.

This is the preferred certificate payload: it asks only for the bounded
generated representatives, raw closure truth-vector invariants, receipt/order
truth-vector determinacy, and coherent-history nonemptiness.  Exact full
current-view determinacy is not needed for the theorem route.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalActualTruthClosureInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader.toTruthFactorBlockwisePackages
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthClosureInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalTruthFactorBlockwisePackagesForActualTruthAutomatonParityCurrentOrderHeader
      header :=
  core.toActualTruthInvariantCore.toRawEpochReceiptCore.toHistoryRepresentativeSeparationCore.toSeparationData.toPackages

/--
Assemble the compact truth-factor blockwise core from the existing saturation
packages plus bounded generated representatives.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalTruthFactorBlockwisePackagesForActualTruthAutomatonParityCurrentOrderHeader.toTruthFactorCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (packages :
      NoDirectDPAJournalBoundedLocalTruthFactorBlockwisePackagesForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalTruthFactorBlockwiseCoreForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfTruth := packages.representatives.envsOfTruth
  envs_bound := packages.representatives.envs_bound
  envs_actualTruth := packages.representatives.envs_actualTruth
  envs_nonempty := packages.representatives.envs_nonempty
  rawEpochOfTruth := packages.rawFactor.rawEpochOfTruth
  rawEpoch_factor := by
    intro h
    exact
      (packages.rawFactor.rawEpoch_factor
        header.cert.determinesPathData_proof
        header.cert.predecessorClosed_proof
        header.cert.boundaryClosed_proof
        header.cert.continuationClosed_proof h).symm
  receiptOrderOfTruth := packages.receiptOrder.receiptOrderOfTruth
  receiptOrder_factor := packages.receiptOrder.receiptOrder_factor
  coherentHistoryNonempty := packages.coherentHistoryNonempty

/--
The package interface also yields the blockwise finite-index core directly.

This checked bridge keeps the remaining Bérard import at the package level:
bounded representatives, raw truth-factor data, receipt/order truth-factor data,
and coherent-history nonemptiness.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalTruthFactorBlockwisePackagesForActualTruthAutomatonParityCurrentOrderHeader.toBlockwiseCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (packages :
      NoDirectDPAJournalBoundedLocalTruthFactorBlockwisePackagesForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalBlockwiseFiniteIndexCoreForActualTruthAutomatonParityCurrentOrderHeader.{u, v, x, y,
      max u v x y, aut}
      header :=
  packages.toTruthFactorCore.toOperationalCore.toBlockwiseCore

/--
The current package-level Bérard import cannot be a theorem from `header`
alone: if the chosen generation bound is zero, the representative package is
already inconsistent.  The representative for the truth atom of the empty
history must be nonempty, while its length must be at most zero.

This is the concrete formal obstruction in the last-block import interface.
The finite-memory proof must supply a positive/large-enough bound together
with the representatives, not merely an arbitrary header containing a natural
number called `generationBound`.
-/
theorem noTruthFactorBlockwisePackages_of_generationBound_zero
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (hzero : header.generationBound = 0)
    (packages :
      NoDirectDPAJournalBoundedLocalTruthFactorBlockwisePackagesForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    False := by
  let h : History In₁ In₂ Graph Out₁ Out₂ := []
  let truth :=
    regularTestTruthVector (stabilizedSaturationBasis header.cert)
      (pathOfHistoryByRound header.edgeOfRound h)
  have hlen :
      (packages.representatives.envsOfTruth truth).length ≤ 0 := by
    simpa [truth, hzero] using packages.representatives.envs_bound truth
  have hnil : packages.representatives.envsOfTruth truth = [] :=
    List.eq_nil_of_length_eq_zero (Nat.eq_zero_of_le_zero hlen)
  exact packages.representatives.envs_nonempty h hnil

/--
Last-block finite-memory construction in the exact form used by the paper
proof.

The finite summary state is intentionally abstract here, but the Bérard import
below instantiates it with the stabilized truth atom.  The fields correspond to
the proof paragraphs in Proposition `Last-block finite-memory certificate`:

* `summaryOfHistory` is the finite one-directional last-block summary.
* `summary_truth_factor` says that this summary factors through stabilized
  truth, hence gives the finite truth-vector quotient.
* `envsOfSummary` is the representative table.
* `envs_actualTruth` is truth preservation for the representative table.
* `closureInvariants` is block-by-block no-direct continuation preservation.
* `receiptOrder_summary` is the hidden-bit/receipt-order decoder from the same
  finite summary.
* `coherentHistoryNonempty` is the nonempty coherent-history handoff.
-/
structure NoDirectDPAJournalBoundedLocalLastBlockFiniteMemorySummaryCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  SummaryState : Type c
  summaryStateFinite : Fintype SummaryState
  summaryOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> SummaryState
  summaryOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
      SummaryState
  summary_truth_factor :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      summaryOfHistory h =
        summaryOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h))
  envsOfSummary :
    SummaryState -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ s : SummaryState, (envsOfSummary s).length ≤ header.generationBound
  envs_actualTruth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (envsOfSummary (summaryOfHistory h)))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  envs_nonempty :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      envsOfSummary (summaryOfHistory h) ≠ []
  closureInvariants :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  receiptOrderOfSummary :
    SummaryState -> ReceiptOrderData
  receiptOrder_summary :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        receiptOrderOfSummary (summaryOfHistory h)
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
Exact Lean package corresponding to the paper proof before assembly.

This is the point at which the real finite-memory mathematics enters.  Each
field is one of the proof's constructed objects:

* `representatives`: bounded nonempty generated representatives indexed by the
  stabilized truth atom;
* `closureInvariants`: block-by-block preservation for the no-direct raw state
  and the actual-truth automaton state;
* `receiptOrder`: finite truth-atom decoder for the current receipt/order
  observation, i.e. the hidden-bit step;
* `coherentHistoryNonempty`: the last-block handoff never queries the initial
  empty prefix as a current block.
-/
structure NoDirectDPAJournalBoundedLocalLastBlockFiniteMemoryProofPackageForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  representatives :
    NoDirectDPAJournalBoundedLocalTruthRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader
      header
  closureInvariants :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  receiptOrder :
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
Concrete finite table extracted from the Bérard last-block construction.

This record is intentionally closer to the final theorem-facing package than
to the rational-run proof itself: it stores the truth-indexed representative
table, the no-direct closure invariants, the receipt/order truth decoder, and
the coherent-history nonemptiness handoff.
-/
structure NoDirectDPAJournalBoundedLocalBerardLastBlockTableForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
      List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      (envsOfTruth truth).length ≤ header.generationBound
  envs_actualTruth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (envsOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h))))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  envs_nonempty :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      envsOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h)) ≠ []
  closureInvariants :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  receiptOrderOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
      ReceiptOrderData
  receiptOrder_factor :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        receiptOrderOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h))
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
The Bérard table is already exactly the proof package expected by the checked
last-block route.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalBerardLastBlockTableForActualTruthAutomatonParityCurrentOrderHeader.toProofPackage
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
