  envsOfHistory := core.envsOfHistory
  envs_bound := core.envs_bound
  envs_actualTruth := core.envs_actualTruth
  envs_nonempty := core.envs_nonempty
  rawEpochState_invariant := core.closureInvariants.rawEpochState_invariant
  receiptOrder_invariant := core.receiptOrder_invariant
  coherentHistoryNonempty := core.coherentHistoryNonempty

/--
Empty-history-safe actual-truth closure/truth-factor core.

This is the theorem-level form matching the corrected saturation handoff:
bounded generated representatives realize the actual stabilized truth atom, but
they are not required to be nonempty or append-shaped.  Receipt/order is
supplied as an all-history truth factor, so the empty history is handled by the
truth-factor proof rather than by a false coherent-history nonemptiness claim.
-/
structure NoDirectDPAJournalBoundedLocalActualTruthClosureTruthFactorCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      (envsOfHistory h).length ≤ header.generationBound
  envs_actualTruth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ (envsOfHistory h))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  closureInvariants :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  receiptOrder_invariant :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h')

/--
Forget the obsolete nonempty/coherent-append obligations from the older
closure-invariant core.
-/
def
    NoDirectDPAJournalBoundedLocalActualTruthClosureInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader.toClosureTruthFactorCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthClosureInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalActualTruthClosureTruthFactorCoreForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfHistory := core.envsOfHistory
  envs_bound := core.envs_bound
  envs_actualTruth := core.envs_actualTruth
  closureInvariants := core.closureInvariants
  receiptOrder_invariant := core.receiptOrder_invariant

/--
Convert the empty-safe actual-truth closure/truth-factor core into the
Prop-level represented-truth truth-factor/parity package.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalActualTruthClosureTruthFactorCoreForActualTruthAutomatonParityCurrentOrderHeader.toRepresentedTruthClosureTruthFactorParityData
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthClosureTruthFactorCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    StabilizedSaturationBasisBoundedGeneratedRepresentedTruthClosureTruthFactorParityData
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      (fun c c' =>
        header.toCurrentOrderHeader.parityOfHistory c.history =
          header.toCurrentOrderHeader.parityOfHistory c'.history)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
      header.toCurrentOrderHeader.parityOfHistory
      header.σ
      header.generationBound where
  stateData :=
    { stateOfHistory := fun h =>
        ⟨ regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h)
        , ⟨core.envsOfHistory h, core.envs_bound h, core.envs_actualTruth h⟩ ⟩
      state_truth_eq := by
        intro _c
        rfl }
  factorData :=
    StabilizedSaturationBasisBoundedGeneratedRawAutomatonFactorData.of_splitQuotientFactorization
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
      (StabilizedSaturationBasisNoDirectSplitQuotientFactorization_of_invariants
        header.toCurrentOrderHeader.toHeader.importedUniform
        header.initialBoundary
        header.cert
        (pathOfHistoryByRound header.edgeOfRound)
        header.containmentOrder
        historyCurrentContainmentOrder
        header.toCurrentOrderHeader.automatonOfHistory
        core.closureInvariants.rawEpochState_invariant
        core.closureInvariants.automatonOfHistory_invariant)
  receiptOrderData :=
    StabilizedSaturationBasisBoundedGeneratedReceiptOrderTruthFactorData.of_truthDeterminesReceiptOrder
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
      core.receiptOrder_invariant
  parityData :=
    StabilizedSaturationBasisBoundedGeneratedTruthParityBridgeData.of_fields
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      (fun c c' =>
        header.toCurrentOrderHeader.parityOfHistory c.history =
          header.toCurrentOrderHeader.parityOfHistory c'.history)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
      header.toCurrentOrderHeader.parityOfHistory
      (fun truth => header.parityOfAutomaton (header.automatonOfTruth truth))
      (by
        intro _h
        rfl)
      (by
        intro _c _c' hparity
        exact hparity)

/--
Truth-indexed empty-history-safe closure/truth-factor core.

This is the Bérard-shaped form of the accepted handoff: for each stabilized
truth atom choose a bounded generated representative, and let the raw no-direct
epoch state and current receipt/order payload factor through that truth atom.
Unlike the older blockwise core, this record has no nonempty representative
field and no coherent-history nonemptiness field.
-/
structure NoDirectDPAJournalBoundedLocalTruthIndexedClosureTruthFactorCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
      List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      (envsOfTruth truth).length ≤ header.generationBound
  envs_actualTruth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (envsOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h))))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  rawEpochOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
      EpochRotatingAccessState
        header.toCurrentOrderHeader.toHeader.importedUniform.boundary
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two)
  rawEpoch_factor :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary h =
        rawEpochOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h))
  receiptOrderOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
      ReceiptOrderData
  receiptOrder_factor :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        receiptOrderOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h))

/--
Convert the truth-indexed empty-safe core to the theorem-facing
history-indexed closure/truth-factor core.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalTruthIndexedClosureTruthFactorCoreForActualTruthAutomatonParityCurrentOrderHeader.toClosureTruthFactorCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalTruthIndexedClosureTruthFactorCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalActualTruthClosureTruthFactorCoreForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfHistory := fun h =>
    core.envsOfTruth
      (regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h))
  envs_bound := by
    intro h
    exact core.envs_bound
      (regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h))
  envs_actualTruth := core.envs_actualTruth
  closureInvariants :=
    { rawEpochState_invariant := by
        intro _ _ _ _ h h' htruth
        calc
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
              header.initialBoundary h =
              core.rawEpochOfTruth
                (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                  (pathOfHistoryByRound header.edgeOfRound h)) :=
                core.rawEpoch_factor h
          _ =
              core.rawEpochOfTruth
                (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                  (pathOfHistoryByRound header.edgeOfRound h')) := by
                rw [htruth]
          _ =
              header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
                header.initialBoundary h' :=
                (core.rawEpoch_factor h').symm
      automatonOfHistory_invariant := by
        intro _ h h' htruth
        dsimp [NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.toCurrentOrderHeader]
        rw [htruth] }
  receiptOrder_invariant := by
    intro h h' htruth
    calc
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
          core.receiptOrderOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h)) :=
            core.receiptOrder_factor h
      _ =
          core.receiptOrderOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h')) := by
            rw [htruth]
      _ =
          currentReceiptOrderData h' (historyCurrentContainmentOrder h') :=
            (core.receiptOrder_factor h').symm

/--
Actual-truth closure invariant core with current-view determinacy instead of
receipt/order determinacy.

The current receipt/order payload is read from the current views and their
canonical current containment order, so equality of both current local views is
enough to derive receipt/order truth-vector invariance.
-/
structure NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      (envsOfHistory h).length ≤ header.generationBound
  envs_actualTruth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ (envsOfHistory h))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  envs_nonempty :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      envsOfHistory h ≠ []
  closureInvariants :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  currentViews_determined :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      (currentView Proc.one h, currentView Proc.two h) =
        (currentView Proc.one h', currentView Proc.two h')
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
Derive current receipt/order truth-vector invariance from current-view
truth-vector determinacy.
-/
def
    NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsCoreForActualTruthAutomatonParityCurrentOrderHeader.toClosureInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalActualTruthClosureInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfHistory := core.envsOfHistory
  envs_bound := core.envs_bound
  envs_actualTruth := core.envs_actualTruth
  envs_nonempty := core.envs_nonempty
  closureInvariants := core.closureInvariants
  receiptOrder_invariant := by
    intro h h' htruth
    have hviews := core.currentViews_determined h h' htruth
    have hone :
        (currentView Proc.one h).receiptTag =
          (currentView Proc.one h').receiptTag :=
      congrArg (fun views => views.1.receiptTag) hviews
    have htwo :
        (currentView Proc.two h).receiptTag =
          (currentView Proc.two h').receiptTag :=
      congrArg (fun views => views.2.receiptTag) hviews
    have horder :
        historyCurrentContainmentOrder h =
          historyCurrentContainmentOrder h' :=
      historyCurrentContainmentOrder_eq_of_currentViews_eq hviews
    change
      ({ receiptOne := (currentView Proc.one h).receiptTag
         receiptTwo := (currentView Proc.two h).receiptTag
         containmentOrder := historyCurrentContainmentOrder h } :
          ReceiptOrderData) =
        { receiptOne := (currentView Proc.one h').receiptTag
          receiptTwo := (currentView Proc.two h').receiptTag
          containmentOrder := historyCurrentContainmentOrder h' }
    simp [hone, htwo, horder]
  coherentHistoryNonempty := core.coherentHistoryNonempty

/--
Actual-truth closure invariant core with current views factored through the
stabilized truth atom.

This is the quotient-map form of current-view determinacy: instead of proving a
binary equality theorem for histories directly, one supplies the finite
observation read from each stabilized truth atom.
-/
structure NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsFactorCoreForActualTruthAutomatonParityCurrentOrderHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      (envsOfHistory h).length ≤ header.generationBound
  envs_actualTruth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ (envsOfHistory h))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  envs_nonempty :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      envsOfHistory h ≠ []
  closureInvariants :
    StabilizedSaturationBasisNoDirectClosureTruthVectorInvariants
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      (pathOfHistoryByRound header.edgeOfRound)
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
  currentViewsOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ->
      View In₁ In₂ Proc.one × View In₁ In₂ Proc.two
  currentViews_factor :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      (currentView Proc.one h, currentView Proc.two h) =
        currentViewsOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h))
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/-- Convert current-view factorization to current-view determinacy. -/
def
    NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsFactorCoreForActualTruthAutomatonParityCurrentOrderHeader.toCurrentViewsCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsFactorCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsCoreForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfHistory := core.envsOfHistory
  envs_bound := core.envs_bound
  envs_actualTruth := core.envs_actualTruth
  envs_nonempty := core.envs_nonempty
  closureInvariants := core.closureInvariants
  currentViews_determined := by
    intro h h' htruth
    calc
      (currentView Proc.one h, currentView Proc.two h) =
          core.currentViewsOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h)) :=
            core.currentViews_factor h
      _ =
          core.currentViewsOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h')) := by
            rw [htruth]
      _ = (currentView Proc.one h', currentView Proc.two h') :=
