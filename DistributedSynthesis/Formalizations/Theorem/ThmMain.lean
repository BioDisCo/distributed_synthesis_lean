                rw [htruth]
          _ =
              core.rawEpochOfState (core.stateOfHistory h') := by
                rw [core.state_truth_factor h']
          _ =
              header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
                header.initialBoundary h' :=
                (core.rawEpoch_state h').symm
      automatonOfHistory_invariant := by
        intro _ h h' htruth
        dsimp [NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.toCurrentOrderHeader]
        rw [htruth] }
  receiptOrderOfState := core.receiptOrderOfState
  receiptOrder_state := core.receiptOrder_state
  stateOfTruth := core.stateOfTruth
  state_truth_factor := core.state_truth_factor
  coherentHistoryNonempty := core.coherentHistoryNonempty

