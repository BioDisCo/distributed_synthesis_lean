    A inputs).dpaSynthesisDecidable A Iff.rfl

/--
Formula-level no-direct route through bounded-local determinacy and explicit
finite-game backend obligations.
-/
noncomputable def main_result_for_ltl_dpa_journalBoundedLocalDeterminacyCertificate_noDirect
    {AP : Type ap}
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    [DecidableEq AP]
    (compiler :
      LTLToDPACompiler.{ap, max u v x y, aut}
        AP
        (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (formula : LTL AP)
    (inputs :
      NoDirectDPAJournalBoundedLocalDeterminacyCertificateLeanInputs
        In₁ In₂ Out₁ Out₂ (compiler.compile formula)) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          LTL.Satisfies compiler.interp word formula)) := by
  let A := compiler.compile formula
  let dpaDecision :
      Decidable (SynthesisProblem (dpaSpecification A)) :=
    noDirectDPASynthesisDecidable_ofJournalBoundedLocalDeterminacyCertificateLeanInputs
      A
      inputs
  cases dpaDecision with
  | isTrue h =>
      exact
        isTrue
          (by
            rcases h with ⟨σ, hσ⟩
            exact
              ⟨σ, fun env =>
                (compiler.correct formula (execution σ env)).mp (hσ env)⟩)
  | isFalse h =>
      exact
        isFalse
          (by
            intro hltl
            rcases hltl with ⟨σ, hσ⟩
            exact
              h
                ⟨σ, fun env =>
