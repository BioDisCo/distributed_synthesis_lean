/--
The finite-memory current-view core cannot be obtained from an arbitrary
header alone.  If there is no environment round, no nonempty generated
representative list exists, contradicting the representative nonemptiness field
already for the empty history.

Thus the Bérard import above must either assume inhabited/generative input
data and the actual finite-memory classifier, or be stated only for a
specialized header that contains those data.  Positivity of `generationBound`
is not enough.
-/
theorem noActualTruthFiniteMemoryCurrentViewsCore_of_isEmptyEnvironmentRound
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    [IsEmpty (EnvironmentRound In₁ In₂)]
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    False := by
  let h : History In₁ In₂ Graph Out₁ Out₂ := []
  have hnil : core.envsOfHistory h = [] := by
    cases core.envsOfHistory h with
    | nil => rfl
    | cons env envs => exact False.elim (IsEmpty.false env)
  exact core.envs_nonempty h hnil

/--
Package-level Bérard construction for the no-direct-reversal fragment.

No package field is postulated here anymore.  The representatives, raw
split-quotient data, receipt/order factor, and coherent-history nonemptiness
