    ∀ (pref pref' : History In₁ In₂ Graph Out₁ Out₂)
      (r r' : RoundRecord In₁ In₂ Graph Out₁ Out₂),
      regularTestTruthVector
          (stabilizedSaturationBasis header.toActualTruthHeader.cert)
          (pathOfHistoryByRound header.toActualTruthHeader.edgeOfRound
            (History.append pref r)) =
