theorem PositiveLTL.subformulaClosure_prunedGuidedOpenReleaseSupportSelector
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (haccepting :
