/-- Convert the represented-truth payload form to the append-form truth-vector core. -/
noncomputable def
    NoDirectDPAJournalBoundedLocalRepresentedTruthPayloadAppendCoreForActualTruthAutomatonParityCurrentOrderHeader.toTruthVectorQuotientAppendCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalRepresentedTruthPayloadAppendCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalTruthVectorQuotientAppendCoreForActualTruthAutomatonParityCurrentOrderHeader
      header := by
  classical
  let tq :=
    StabilizedSaturationBasisBoundedGeneratedTruthVectorQuotientCertificate.of_representedTruthClosureSummaryParityPayload
      header.toCurrentOrderHeader.toHeader.importedUniform
      header.initialBoundary
      header.cert
      header.edgeOfRound
      header.containmentOrder
      historyCurrentContainmentOrder
      header.toCurrentOrderHeader.automatonOfHistory
      header.toCurrentOrderHeader.toHeader.parityOfHistory
      header.σ
      header.generationBound
      core.payload
  refine
    { truthQuotient := tq
      representatives := core.representatives
      quotient_envs_nonempty := ?_
      coherentHistoryAppend := core.payload.coherentHistoryAppend }
  intro q
  dsimp [tq]
  exact
    executionPrefixFromList_ne_nil_of_eq_append
      header.σ
      (Classical.choose_spec q.2).2.2

/--
Convert the represented-truth payload form directly to the nonempty
truth-vector quotient core.

The payload constructs the quotient and supplies append decomposition for
coherent histories.  Nonemptiness is then only list bookkeeping.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalRepresentedTruthPayloadAppendCoreForActualTruthAutomatonParityCurrentOrderHeader.toTruthVectorQuotientNonemptyCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
