/--
Choose the unary receipt/order decoder from append-truth determinacy.
-/
noncomputable def
    NoDirectDPAJournalBoundedLocalActualTruthAppendReceiptDeterminacyRepresentativeRawFactorCoreForCanonicalActualTruthAutomatonParityCurrentOrderHeader.toActualTruthAppendUnaryReceiptCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalCanonicalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthAppendReceiptDeterminacyRepresentativeRawFactorCoreForCanonicalActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalActualTruthAppendUnaryReceiptRepresentativeRawFactorCoreForCanonicalActualTruthAutomatonParityCurrentOrderHeader
      header := by
  classical
  let realized :
      RegularTestTruthAtom
          (stabilizedSaturationBasis header.toActualTruthHeader.cert) ->
        Prop :=
    fun truth =>
      ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          regularTestTruthVector
              (stabilizedSaturationBasis header.toActualTruthHeader.cert)
              (pathOfHistoryByRound header.toActualTruthHeader.edgeOfRound
                (History.append pref r)) =
            truth
  let witness :
      ∀ truth :
          RegularTestTruthAtom
            (stabilizedSaturationBasis header.toActualTruthHeader.cert),
        realized truth ->
          { pair :
              History In₁ In₂ Graph Out₁ Out₂ ×
                RoundRecord In₁ In₂ Graph Out₁ Out₂ //
            regularTestTruthVector
                (stabilizedSaturationBasis header.toActualTruthHeader.cert)
                (pathOfHistoryByRound header.toActualTruthHeader.edgeOfRound
                  (History.append pair.1 pair.2)) =
              truth } :=
    fun truth hreal =>
      ⟨(Classical.choose hreal,
          Classical.choose (Classical.choose_spec hreal)),
        Classical.choose_spec (Classical.choose_spec hreal)⟩
  let decodeReceiptOrderOfTruth :
      RegularTestTruthAtom
          (stabilizedSaturationBasis header.toActualTruthHeader.cert) ->
        ReceiptOrderData :=
    fun truth =>
      if hreal : realized truth then
        let selected := witness truth hreal
        currentReceiptOrderDataForAppend selected.1.1 selected.1.2
      else
        defaultReceiptOrderData
  exact
    { envsOfHistory := core.envsOfHistory
      envs_bound := core.envs_bound
      envs_actualTruth := core.envs_actualTruth
      envs_nonempty := core.envs_nonempty
      rawEpochOfTruth := core.rawEpochOfTruth
      rawEpoch_factor := core.rawEpoch_factor
      decodeReceiptOrderOfTruth := decodeReceiptOrderOfTruth
      decodesCurrent := by
        intro pref r
        dsimp [decodeReceiptOrderOfTruth, realized]
        have hreal :
            ∃ (pref' : History In₁ In₂ Graph Out₁ Out₂),
              ∃ (r' : RoundRecord In₁ In₂ Graph Out₁ Out₂),
                regularTestTruthVector
                    (stabilizedSaturationBasis header.toActualTruthHeader.cert)
                    (pathOfHistoryByRound
                      header.toActualTruthHeader.edgeOfRound
                      (History.append pref' r')) =
                  regularTestTruthVector
                    (stabilizedSaturationBasis header.toActualTruthHeader.cert)
                    (pathOfHistoryByRound
                      header.toActualTruthHeader.edgeOfRound
                      (History.append pref r)) :=
          ⟨pref, r, rfl⟩
        rw [dif_pos hreal]
        dsimp [witness]
        exact
          core.appendTruthDeterminesReceiptOrder
            (Classical.choose hreal)
            pref
            (Classical.choose (Classical.choose_spec hreal))
            r
            (Classical.choose_spec (Classical.choose_spec hreal))
      coherentHistoryAppend := core.coherentHistoryAppend }

