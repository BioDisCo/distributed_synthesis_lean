          header.initialBoundary h =
        rawEpochOfState (stateOfHistory h)
  receiptOrderOfState :
    BlockState -> ReceiptOrderData
  receiptOrder_state :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        receiptOrderOfState (stateOfHistory h)
  stateOfTruth :
    RegularTestTruthAtom (stabilizedSaturationBasis header.cert) -> BlockState
  state_truth_factor :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      stateOfHistory h =
        stateOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h))
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
The operational blockwise core supplies the closure invariant package required
by the theorem-facing blockwise core.
-/
def
    NoDirectDPAJournalBoundedLocalOperationalBlockwiseFiniteIndexCoreForActualTruthAutomatonParityCurrentOrderHeader.toBlockwiseCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalOperationalBlockwiseFiniteIndexCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalBlockwiseFiniteIndexCoreForActualTruthAutomatonParityCurrentOrderHeader
      header where
  BlockState := core.BlockState
  blockStateFinite := core.blockStateFinite
  stateOfHistory := core.stateOfHistory
  envsOfState := core.envsOfState
  envs_bound := core.envs_bound
  envs_actualTruth := core.envs_actualTruth
  envs_nonempty := core.envs_nonempty
  closureInvariants :=
    { rawEpochState_invariant := by
        intro _ _ _ _ h h' htruth
        calc
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
              header.initialBoundary h =
              core.rawEpochOfState (core.stateOfHistory h) :=
                core.rawEpoch_state h
          _ =
              core.rawEpochOfState
                (core.stateOfTruth
                  (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                    (pathOfHistoryByRound header.edgeOfRound h))) := by
                rw [core.state_truth_factor h]
          _ =
