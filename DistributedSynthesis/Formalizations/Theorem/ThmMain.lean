/--
The genuinely no-direct-specific bounded-local mathematical payload.

This package deliberately excludes the standard finite-game backend fields.  It
is the object that still has to be constructed from the no-direct saturation
argument: bounded generated representatives, append closure of the local
carrier, split quotient, and truth determinacy of current receipt/order and
parity progress.
-/
structure NoDirectDPAJournalBoundedLocalDeterminacyCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (inputs :
      NoDirectDPAJournalBoundedLocalDeterminacyCertificateLeanInputs
        In₁ In₂ Out₁ Out₂ A) where
  envsOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> List (EnvironmentRound In₁ In₂)
  envs_bound :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      (envsOfHistory h).length ≤ inputs.generationBound
  envs_truth :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis inputs.cert)
        (pathOfHistoryByRound inputs.edgeOfRound
          (executionPrefixFromList inputs.σ (envsOfHistory h))) =
        inputs.truthOfHistory h
  envs_append :
    ∀ h : History In₁ In₂ Graph Out₁ Out₂,
      ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          executionPrefixFromList inputs.σ (envsOfHistory h) =
            History.append pref r
  truthOfHistory_eq :
    ∀ c :
      CoherentContinuationConfiguration
        inputs.containmentOrder inputs.orderOfHistory inputs.automatonOfHistory,
    inputs.truthOfHistory c.1.history =
      regularTestTruthVector (stabilizedSaturationBasis inputs.cert)
        (pathOfHistoryByRound inputs.edgeOfRound c.1.history)
  splitFactorization :
    StabilizedSaturationBasisNoDirectSplitQuotientFactorization
      inputs.importedUniform inputs.initialBoundary inputs.cert
      (pathOfHistoryByRound inputs.edgeOfRound)
      inputs.containmentOrder inputs.orderOfHistory inputs.automatonOfHistory
  appendTruthDeterminesReceiptOrder :
    ∀ (pref pref' : History In₁ In₂ Graph Out₁ Out₂)
      (r r' : RoundRecord In₁ In₂ Graph Out₁ Out₂),
      regularTestTruthVector (stabilizedSaturationBasis inputs.cert)
          (pathOfHistoryByRound inputs.edgeOfRound (History.append pref r)) =
        regularTestTruthVector (stabilizedSaturationBasis inputs.cert)
          (pathOfHistoryByRound inputs.edgeOfRound (History.append pref' r')) ->
      currentReceiptOrderDataForAppend pref r =
        currentReceiptOrderDataForAppend pref' r'
  orderOfAppend :
    ∀ (pref : History In₁ In₂ Graph Out₁ Out₂),
      ∀ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        inputs.orderOfHistory (History.append pref r) =
          graphContainmentOrder r.graph
  coherentHistoryAppend :
    ∀ c :
      CoherentContinuationConfiguration
        inputs.containmentOrder inputs.orderOfHistory inputs.automatonOfHistory,
      ∃ (pref : History In₁ In₂ Graph Out₁ Out₂),
        ∃ (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
          c.1.history = History.append pref r
  parityOfHistory_eq_of_truth_eq :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis inputs.cert)
          (pathOfHistoryByRound inputs.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis inputs.cert)
          (pathOfHistoryByRound inputs.edgeOfRound h') ->
      inputs.parityOfHistory h = inputs.parityOfHistory h'

/-- The standard backend payload separated from bounded-local determinacy. -/
