import DistributedSynthesis.Formalizations.Theorem.ThmAutomataBackend

/-!
# Emptiness of deterministic parity word automata

A finite deterministic parity automaton has a nonempty omega-language iff it
accepts a word generated by a memoryless letter choice on its own state space.
The lasso reflection and fixed-code decision procedures are supplied by the
finite-carrier backend.
-/

namespace DistributedSynthesis

universe u v

namespace DetParityAutomaton

open FiniteEpochTransformer

/--
Every accepted word of a finite DPA can be replaced by a word generated by a
memoryless choice of the next letter from the current DPA state.
-/
theorem exists_memorylessCode_accepted_of_exists_accepted
    {Alphabet : Type u}
    (A : DetParityAutomaton.{u, v} Alphabet) :
    (∃ word : OmegaWord Alphabet, A.Accepts word) ->
      ∃ code : A.State -> Alphabet,
        A.Accepts
          (finiteCarrierPlayWord A.initial A.step (fun _ letter => letter) code) := by
  classical
  rintro ⟨word, hword⟩
  let complement := A.shiftPriority 1
  let stateStream : Nat -> A.State := A.run word
  have hrejected :
      ¬ complement.Accepts
        (finiteCarrierWord (fun _ letter => letter) stateStream word) := by
    have hsame :
        finiteCarrierWord (fun _ letter => letter) stateStream word = word := by
      funext n
      rfl
    rw [hsame]
    exact A.shiftPriority_one_not_accepts_of_accepts word hword
  obtain ⟨code, hcode⟩ :=
    exists_finiteCarrierCode_rejected_playWord_of_rejected_dpaProgress_stateStream
      A.initial A.step (fun _ letter => letter) complement
      stateStream word (fun state => state)
      (by rfl)
      (by intro n; rfl)
      (by rfl)
      (by intro n; rfl)
      hrejected
  refine ⟨code, ?_⟩
  by_contra hnot
  exact hcode
    ((A.shiftPriority_one_accepts_iff_not_accepts
      (finiteCarrierPlayWord A.initial A.step (fun _ letter => letter) code)).2
      hnot)

/--
The omega-language of a finite DPA is nonempty exactly when one of the finitely
many memoryless letter codes on its state space generates an accepted word.
-/
theorem exists_accepted_iff_exists_memorylessCode_accepted
    {Alphabet : Type u}
    (A : DetParityAutomaton.{u, v} Alphabet) :
    (∃ word : OmegaWord Alphabet, A.Accepts word) ↔
      ∃ code : A.State -> Alphabet,
        A.Accepts
          (finiteCarrierPlayWord A.initial A.step (fun _ letter => letter) code) := by
  constructor
  · exact A.exists_memorylessCode_accepted_of_exists_accepted
  · rintro ⟨code, hcode⟩
    exact ⟨finiteCarrierPlayWord A.initial A.step (fun _ letter => letter) code,
      hcode⟩

/-- Nonemptiness of a deterministic parity word automaton over a finite alphabet is decidable. -/
noncomputable def languageNonemptyDecidable
    {Alphabet : Type u}
    [Fintype Alphabet]
    (A : DetParityAutomaton.{u, v} Alphabet) :
    Decidable (∃ word : OmegaWord Alphabet, A.Accepts word) := by
  classical
  letI (code : A.State -> Alphabet) :
      Decidable
        (A.Accepts
          (finiteCarrierPlayWord A.initial A.step (fun _ letter => letter) code)) :=
    finiteCarrierAcceptsDecidableByStateLoop
      A.initial A.step (fun _ letter => letter) A code
  exact
    decidable_of_iff
      (∃ code : A.State -> Alphabet,
        A.Accepts
          (finiteCarrierPlayWord A.initial A.step (fun _ letter => letter) code))
      A.exists_accepted_iff_exists_memorylessCode_accepted.symm

end DetParityAutomaton

end DistributedSynthesis
