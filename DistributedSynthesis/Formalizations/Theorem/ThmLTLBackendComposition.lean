theorem PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_prefixSatisfies_of_eventual_infState_run_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
