/-!
# Composition of the LTL automata backend

Given the front-end finite APA certificate, an APA-to-DPA determinization
certificate, and a DPA-to-finite-game compilation certificate, this file builds
the `EffectiveParitySpecification` consumed by the main theorem.
-/

namespace DistributedSynthesis

universe u v x y ap c a b aut

private theorem nat_eventually_constant_of_succ_le'
    (f : Nat -> Nat)
    (hf : ∀ n, f (n + 1) ≤ f n) :
    ∃ N : Nat, ∀ n : Nat, N ≤ n -> f n = f N := by
  classical
  have hfanti : Antitone f := antitone_nat_of_succ_le hf
  let values : Set Nat := Set.range f
  have hvaluesFinite : values.Finite := by
    refine (Set.finite_Iic (f 0)).subset ?_
    intro value hvalue
    rcases hvalue with ⟨n, rfl⟩
    exact hfanti (Nat.zero_le n)
  have hvaluesNonempty : values.Nonempty := ⟨f 0, ⟨0, rfl⟩⟩
  rcases Set.exists_min_image values id hvaluesFinite hvaluesNonempty with
    ⟨value, hvalue, hmin⟩
  rcases hvalue with ⟨N, hN⟩
  subst value
  refine ⟨N, fun n hn => ?_⟩
  exact le_antisymm (hfanti hn) (hmin (f n) ⟨n, rfl⟩)

private theorem exists_uniform_eventual_of_finset
    {α : Type u}
    [DecidableEq α]
    (states : Finset α)
    (P : α -> Nat -> Prop)
    (heventual :
      ∀ state, state ∈ states ->
        ∃ N : Nat, ∀ n : Nat, N ≤ n -> P state n) :
    ∃ N : Nat,
      ∀ n : Nat, N ≤ n -> ∀ state, state ∈ states -> P state n := by
  classical
  induction states using Finset.induction_on with
  | empty =>
      refine ⟨0, ?_⟩
      intro n _hn state hstate
      simpa using hstate
  | insert state states hstateNotMem ih =>
      rcases heventual state (by simp) with ⟨Nstate, hNstate⟩
      have heventualTail :
          ∀ tailState, tailState ∈ states ->
            ∃ N : Nat, ∀ n : Nat, N ≤ n -> P tailState n := by
        intro tailState htailState
        exact heventual tailState (by simp [htailState])
      rcases ih heventualTail with ⟨Ntail, hNtail⟩
      refine ⟨max Nstate Ntail, ?_⟩
      intro n hn tailState htailState
      rw [Finset.mem_insert] at htailState
      rcases htailState with hsame | htailState
      · subst tailState
        exact hNstate n (Nat.le_trans (Nat.le_max_left Nstate Ntail) hn)
      · exact
          hNtail n (Nat.le_trans (Nat.le_max_right Nstate Ntail) hn)
            tailState htailState

private theorem exists_uniform_eventual_of_fintype
    {α : Type u}
    [Fintype α]
    [DecidableEq α]
    (P : α -> Nat -> Prop)
    (heventual :
      ∀ state, ∃ N : Nat, ∀ n : Nat, N ≤ n -> P state n) :
    ∃ N : Nat,
      ∀ n : Nat, N ≤ n -> ∀ state, P state n := by
  classical
  rcases
    exists_uniform_eventual_of_finset
      (Finset.univ : Finset α) P
      (by
        intro state _hstate
        exact heventual state) with
    ⟨N, hN⟩
  refine ⟨N, ?_⟩
  intro n hn state
  exact hN n hn state (by simp)

/-- Complete backend certificate for a positive-LTL round-record formula. -/
structure PositiveLTLBackendCompilation
    (AP : Type ap)
    (In₁ : Type u)
    (In₂ : Type v)
    (Out₁ : Type x)
    (Out₂ : Type y)
    [DecidableEq AP] where
  interp : AP -> RoundRecord In₁ In₂ Graph Out₁ Out₂ -> Prop
  interpDecidable : ∀ ap letter, Decidable (interp ap letter)
  closure :
    FiniteLTLAlternatingClosure.{ap, max u v x y, c}
      AP
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)
  apaCert :
    (closure.toAPA interp interpDecidable).LanguageCertificate
  apaLanguageCorrect :
    ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      word ∈ apaCert.initialLanguage ↔
        PositiveLTL.Satisfies interp word closure.formula
  determinization :
    APAToDPACompilation.{max u v x y, c, a}
      (closure.toAPA interp interpDecidable)
      apaCert
  finiteGameCompilation :
    DPAToFiniteGameCompilation.{u, v, x, y, b}
      Out₂
      determinization.dpa

/--
The composed backend certificate yields the effective parity specification
needed by the main theorem.
-/
def PositiveLTLBackendCompilation.toEffectiveParitySpecification
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert : PositiveLTLBackendCompilation.{u, v, x, y, ap, c, a, b}
      AP In₁ In₂ Out₁ Out₂) :
    EffectiveParitySpecification.{u, v, x, y, b, max u v x y} In₁ In₂ Out₁ Out₂ where
  predicate := fun word =>
    PositiveLTL.Satisfies cert.interp word cert.closure.formula
  finiteGame := cert.finiteGameCompilation.finiteGame
  realizabilityEquivalent := by
    rw [cert.finiteGameCompilation.realizabilityEquivalent]
    constructor
    · intro h
      rcases h with ⟨σ, hσ⟩
      exact ⟨σ, fun env =>
        (cert.apaLanguageCorrect (execution σ env)).mp
          ((cert.determinization.correct (execution σ env)).mp (hσ env))⟩
    · intro h
      rcases h with ⟨σ, hσ⟩
      exact ⟨σ, fun env =>
        (cert.determinization.correct (execution σ env)).mpr
          ((cert.apaLanguageCorrect (execution σ env)).mpr (hσ env))⟩

/-- Positive-LTL synthesis is decidable once the backend certificates are supplied. -/
noncomputable def PositiveLTLBackendCompilation.synthesis_decidable
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert : PositiveLTLBackendCompilation.{u, v, x, y, ap, c, a, b}
      AP In₁ In₂ Out₁ Out₂) :
    Decidable
      (SynthesisProblem
        (fun word =>
          PositiveLTL.Satisfies cert.interp word cert.closure.formula)) :=
  effective_parity_synthesis_problem_decidable cert.toEffectiveParitySpecification

/--
Backend certificate for positive LTL after the front-end has been made
canonical: the finite APA carrier is the subformula closure and its language
certificate is the semantic closure language.  The remaining supplied pieces
are exactly determinization and finite-game compilation.
-/
structure CanonicalPositiveLTLBackendCompilation
    (AP : Type ap)
    (In₁ : Type u)
    (In₂ : Type v)
    (Out₁ : Type x)
    (Out₂ : Type y)
    [DecidableEq AP] where
  formula : PositiveLTL AP
  interp : AP -> RoundRecord In₁ In₂ Graph Out₁ Out₂ -> Prop
  interpDecidable : ∀ ap letter, Decidable (interp ap letter)
  determinization :
    APAToDPACompilation.{max u v x y, ap, a}
      ((PositiveLTL.subformulaClosure
        (AP := AP)
        (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
        formula).toAPA interp interpDecidable)
      ((PositiveLTL.subformulaClosure
        (AP := AP)
        (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
        formula).languageCertificate interp interpDecidable)
  finiteGameCompilation :
    DPAToFiniteGameCompilation.{u, v, x, y, b}
      Out₂
      determinization.dpa

/-- The canonical positive-LTL certificate is a special case of the general backend record. -/
noncomputable def CanonicalPositiveLTLBackendCompilation.toBackendCompilation
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert : CanonicalPositiveLTLBackendCompilation.{u, v, x, y, ap, a, b}
      AP In₁ In₂ Out₁ Out₂) :
    PositiveLTLBackendCompilation.{u, v, x, y, ap, ap, a, b}
      AP In₁ In₂ Out₁ Out₂ where
  interp := cert.interp
  interpDecidable := cert.interpDecidable
  closure :=
    PositiveLTL.subformulaClosure
      (AP := AP)
      (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
      cert.formula
  apaCert :=
    (PositiveLTL.subformulaClosure
      (AP := AP)
      (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
      cert.formula).languageCertificate cert.interp cert.interpDecidable
  apaLanguageCorrect := by
    intro word
    exact
      (PositiveLTL.subformulaClosure
        (AP := AP)
        (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
        cert.formula).initial_language_iff cert.interp word
  determinization := cert.determinization
  finiteGameCompilation := cert.finiteGameCompilation

/-- Canonical positive-LTL synthesis decidability from the two remaining backend certificates. -/
noncomputable def CanonicalPositiveLTLBackendCompilation.synthesis_decidable
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert : CanonicalPositiveLTLBackendCompilation.{u, v, x, y, ap, a, b}
      AP In₁ In₂ Out₁ Out₂) :
    Decidable
      (SynthesisProblem
        (fun word => PositiveLTL.Satisfies cert.interp word cert.formula)) :=
  cert.toBackendCompilation.synthesis_decidable

/--
Complete backend certificate for an arbitrary LTL round-record formula.

The backend works on the positive-normal-form translation of `formula`; the
theorem below transports the result back to the original LTL semantics.
-/
structure LTLBackendCompilation
    (AP : Type ap)
    (In₁ : Type u)
    (In₂ : Type v)
    (Out₁ : Type x)
    (Out₂ : Type y)
    [DecidableEq AP] where
  formula : LTL AP
  positiveBackend :
    PositiveLTLBackendCompilation.{u, v, x, y, ap, c, a, b}
      AP In₁ In₂ Out₁ Out₂
  formula_eq : positiveBackend.closure.formula = PositiveLTL.ofLTL formula

/--
The full-LTL backend certificate yields the effective parity specification used
by the main theorem, with the predicate stated in the original LTL semantics.
-/
def LTLBackendCompilation.toEffectiveParitySpecification
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert : LTLBackendCompilation.{u, v, x, y, ap, c, a, b}
      AP In₁ In₂ Out₁ Out₂) :
    EffectiveParitySpecification.{u, v, x, y, b, max u v x y} In₁ In₂ Out₁ Out₂ where
  predicate := fun word => LTL.Satisfies cert.positiveBackend.interp word cert.formula
  finiteGame := cert.positiveBackend.finiteGameCompilation.finiteGame
  realizabilityEquivalent := by
    rw [cert.positiveBackend.finiteGameCompilation.realizabilityEquivalent]
    constructor
    · intro h
      rcases h with ⟨σ, hσ⟩
      exact ⟨σ, fun env =>
        (PositiveLTL.satisfies_ofLTL cert.positiveBackend.interp
          (execution σ env) cert.formula).mp
          (by
            rw [← cert.formula_eq]
            exact
              (cert.positiveBackend.apaLanguageCorrect (execution σ env)).mp
                ((cert.positiveBackend.determinization.correct (execution σ env)).mp
                  (hσ env)))⟩
    · intro h
      rcases h with ⟨σ, hσ⟩
      exact ⟨σ, fun env =>
        (cert.positiveBackend.determinization.correct (execution σ env)).mpr
          ((cert.positiveBackend.apaLanguageCorrect (execution σ env)).mpr
            (by
              rw [cert.formula_eq]
              exact
                (PositiveLTL.satisfies_ofLTL cert.positiveBackend.interp
                  (execution σ env) cert.formula).mpr (hσ env)))⟩

/-- Full-LTL synthesis is decidable once the backend certificates are supplied. -/
noncomputable def LTLBackendCompilation.synthesis_decidable
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert : LTLBackendCompilation.{u, v, x, y, ap, c, a, b}
      AP In₁ In₂ Out₁ Out₂) :
    Decidable
      (SynthesisProblem
        (fun word => LTL.Satisfies cert.positiveBackend.interp word cert.formula)) :=
  effective_parity_synthesis_problem_decidable cert.toEffectiveParitySpecification

/--
Canonical full-LTL backend certificate.  The front-end part is now fixed by
definition: translate to positive normal form and use the subformula APA
closure.  The record exposes only the still-external automata/game back end.
-/
structure CanonicalLTLBackendCompilation
    (AP : Type ap)
    (In₁ : Type u)
    (In₂ : Type v)
    (Out₁ : Type x)
    (Out₂ : Type y)
    [DecidableEq AP] where
  formula : LTL AP
  interp : AP -> RoundRecord In₁ In₂ Graph Out₁ Out₂ -> Prop
  interpDecidable : ∀ ap letter, Decidable (interp ap letter)
  determinization :
    APAToDPACompilation.{max u v x y, ap, a}
      ((PositiveLTL.subformulaClosure
        (AP := AP)
        (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
        (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable)
      ((PositiveLTL.subformulaClosure
        (AP := AP)
        (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
        (PositiveLTL.ofLTL formula)).languageCertificate interp interpDecidable)
  finiteGameCompilation :
    DPAToFiniteGameCompilation.{u, v, x, y, b}
      Out₂
      determinization.dpa

/-- The canonical full-LTL record induces the canonical positive-LTL backend record. -/
def CanonicalLTLBackendCompilation.toPositiveBackend
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert : CanonicalLTLBackendCompilation.{u, v, x, y, ap, a, b}
      AP In₁ In₂ Out₁ Out₂) :
    CanonicalPositiveLTLBackendCompilation.{u, v, x, y, ap, a, b}
      AP In₁ In₂ Out₁ Out₂ where
  formula := PositiveLTL.ofLTL cert.formula
  interp := cert.interp
  interpDecidable := cert.interpDecidable
  determinization := cert.determinization
  finiteGameCompilation := cert.finiteGameCompilation

/-- The canonical full-LTL record is a special case of the general full-LTL backend record. -/
noncomputable def CanonicalLTLBackendCompilation.toBackendCompilation
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert : CanonicalLTLBackendCompilation.{u, v, x, y, ap, a, b}
      AP In₁ In₂ Out₁ Out₂) :
    LTLBackendCompilation.{u, v, x, y, ap, ap, a, b}
      AP In₁ In₂ Out₁ Out₂ where
  formula := cert.formula
  positiveBackend := cert.toPositiveBackend.toBackendCompilation
  formula_eq := rfl

/-- Canonical full-LTL synthesis decidability from determinization and finite-game compilation. -/
noncomputable def CanonicalLTLBackendCompilation.synthesis_decidable
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert : CanonicalLTLBackendCompilation.{u, v, x, y, ap, a, b}
      AP In₁ In₂ Out₁ Out₂) :
    Decidable
      (SynthesisProblem
        (fun word => LTL.Satisfies cert.interp word cert.formula)) :=
  cert.toBackendCompilation.synthesis_decidable

/--
Paper-facing definition for the currently verified arbitrary-full-LTL bridge.

The formula is arbitrary and the predicate is the original full-LTL semantics.
The declaration is deliberately conditional in the automata backend data carried by
`cert`: Lean has checked the PNF/subformula-APA front end and the composition to
the main theorem boundary, but this statement does not construct the
APA-to-DPA determinization or the dynamic-hierarchy finite game.
-/
noncomputable def arbitrary_full_ltl_compiled_synthesis_decidable
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert : CanonicalLTLBackendCompilation.{u, v, x, y, ap, a, b}
      AP In₁ In₂ Out₁ Out₂) :
    Decidable
      (SynthesisProblem
        (fun word => LTL.Satisfies cert.interp word cert.formula)) :=
  cert.synthesis_decidable

/-- Canonical state-wise APA run-language certificate for an arbitrary LTL formula. -/
noncomputable def LTL.canonicalRunLanguageCertificate
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (formula : LTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter)) :
    ((PositiveLTL.subformulaClosure (Letter := Letter)
      (PositiveLTL.ofLTL formula)).toAPA interp dec).RunLanguageCertificate :=
  PositiveLTL.subformulaClosure_runLanguageCertificate
    (PositiveLTL.ofLTL formula) interp dec

/--
The canonical run-language certificate has the original full-LTL formula as
its initial language.
-/
theorem LTL.canonicalRunLanguageCertificate_initialLanguage_iff
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (formula : LTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter) :
    word ∈
        ((LTL.canonicalRunLanguageCertificate formula interp dec).toLanguageCertificate.initialLanguage) ↔
      LTL.Satisfies interp word formula := by
  change
    PositiveLTL.Satisfies interp word (PositiveLTL.ofLTL formula) ↔
      LTL.Satisfies interp word formula
  exact PositiveLTL.satisfies_ofLTL interp word formula

/--
The canonical run-language certificate has the positive-normal-form formula as
its initial language.
-/
theorem LTL.canonicalRunLanguageCertificate_initialLanguage_iff_positive
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (formula : LTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter) :
    word ∈
        ((LTL.canonicalRunLanguageCertificate formula interp dec).toLanguageCertificate.initialLanguage) ↔
      PositiveLTL.Satisfies interp word (PositiveLTL.ofLTL formula) :=
  PositiveLTL.subformulaClosure_runLanguageCertificate_initialLanguage_iff
    (PositiveLTL.ofLTL formula) interp dec word

/--
Proof-facing reduction for the canonical positive-LTL APA completeness
obligation.

It is enough to prove subtree-local child coherence for the concrete
progress-guided accepting run generated from every semantic satisfaction proof.
The generic support-witness backend then handles extraction of the tail branch
and the Muller/DPA conversion.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessExistsTailPathChildCoherent_of_guidedRunFrom
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (hguided :
      ∀ (state : root.Subformula) (word : OmegaWord Letter),
        ∀ hsat : PositiveLTL.Satisfies interp word state.1,
          ∀ path : Nat ->
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp dec).State,
            (∀ n : Nat,
              (path n, path (n + 1)) ∈
                ((PositiveLTL.subformulaClosure_guidedRunFrom
                  root interp dec word state hsat).realizedEdgeWitnessedMacroRun).infStateEdgeFinset) ->
              (PositiveLTL.subformulaClosure_guidedRunFrom
                root interp dec word state hsat).StatePathTailCoherentChildren
                  path) :
    AlternatingParityAutomaton.SupportWitnessExistsTailPathChildCoherent
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp dec) := by
  intro state word haccepts
  rcases
    PositiveLTL.subformulaClosure_exists_accepting_guidedRunFrom_of_acceptsFrom
      root interp dec state word haccepts with
    ⟨hsat, haccepting⟩
  refine
    ⟨PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word state hsat, haccepting, ?_⟩
  intro path hpath
  exact hguided state word hsat path hpath

/--
Semantic-form witness obligation for the preferred pruned accepting-support
target of the canonical positive-LTL APA.

This names the exact remaining automata-completeness construction: from a
semantic satisfaction proof for any subformula state, build an edge-witnessed
macro-run over the rebased singleton APA whose recurring selected support-edge
graph is parity accepting.
-/
def PositiveLTL.SubformulaClosureSatisfiesAcceptingEdgeWitnessedMacroRun
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter)) :
    Prop :=
  ∀ (state : root.Subformula) (word : OmegaWord Letter),
    PositiveLTL.Satisfies interp word state.1 ->
      ∃ run :
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial state).EdgeWitnessedMacroRun
          ({(((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp dec).withInitial state).initial} :
            Finset (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial state).State)
          word,
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial state).SupportWitnessStateEdgesAccepting
          run.infStateEdgeFinset

/--
More flexible semantic target for the canonical LTL tableau.

The witness may provide an accepting finite support graph that contains the
recurring edges of the chosen edge-witnessed macro-run.  The generic automata
backend shrinks this graph to the exact recurring-edge finset by monotonicity.
-/
def PositiveLTL.SubformulaClosureSatisfiesEdgeWitnessedMacroRunSubgraphAccepting
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter)) :
    Prop :=
  ∀ (state : root.Subformula) (word : OmegaWord Letter),
    PositiveLTL.Satisfies interp word state.1 ->
      ∃ run :
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial state).EdgeWitnessedMacroRun
          ({(((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp dec).withInitial state).initial} :
            Finset (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial state).State)
          word,
        ∃ acceptedEdges :
          Finset (APAStateEdge
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial state)),
          run.infStateEdgeFinset ⊆ acceptedEdges ∧
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial state).SupportWitnessStateEdgesAccepting
              acceptedEdges

/--
Tail-realizability target for the canonical guided tableau run.

For each semantically satisfied subformula, choose a finite support graph
containing the recurring edges of the concrete guided run.  If every path
through that graph is a suffix of an active guided branch, then branch
acceptance of the guided run proves that the graph is parity accepting.
-/
def PositiveLTL.SubformulaClosureGuidedRunSubgraphTailBranchRealizable
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter)) :
    Prop :=
  ∀ (state : root.Subformula) (word : OmegaWord Letter),
    ∀ hsat : PositiveLTL.Satisfies interp word state.1,
      ∃ acceptedEdges :
        Finset (APAStateEdge
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp dec).withInitial state)),
        ((PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word state hsat).realizedEdgeWitnessedMacroRun
            ).infStateEdgeFinset ⊆ acceptedEdges ∧
          ∀ path :
            Nat ->
              (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp dec).withInitial state).State,
            (∀ n : Nat, (path n, path (n + 1)) ∈ acceptedEdges) ->
