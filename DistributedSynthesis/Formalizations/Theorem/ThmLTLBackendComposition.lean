/--
Build the canonical full-LTL backend through the concrete support-witness
APA-to-Muller/DPA carrier.

The only automata-theory premise left here is the singleton semantic
equivalence for the canonical subformula APA's support-witness Muller
automaton.  The state-wise carrier and the LAR Muller-to-DPA composition are
supplied by `supportWitnessDPAStateCompilationOfCorrect`.
-/
noncomputable def CanonicalLTLStateRunBackendCompilation.ofCanonicalFrontendSupportWitness
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (formula : LTL AP)
    (interp : AP -> RoundRecord In₁ In₂ Graph Out₁ Out₂ -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    (hcorrect :
      let A :=
        (PositiveLTL.subformulaClosure
          (AP := AP)
          (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
          (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
      ∀ (state : A.State) (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
        (A.supportWitnessMuller {state}).Accepts word ↔ A.AcceptsFrom state word)
    (finiteGameCompilation :
      let A :=
        (PositiveLTL.subformulaClosure
          (AP := AP)
          (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
          (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
      DPAToFiniteGameCompilation.{u, v, x, y, b}
        Out₂
        (A.supportWitnessDPAStateCompilationOfCorrect
          (LTL.canonicalRunLanguageCertificate
            formula interp interpDecidable)
          hcorrect).dpa) :
    CanonicalLTLStateRunBackendCompilation.{u, v, x, y, ap, ap, b}
      AP In₁ In₂ Out₁ Out₂ := by
  let A :=
    (PositiveLTL.subformulaClosure
      (AP := AP)
      (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
      (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
  exact
    ofCanonicalFrontend
      formula
      interp
      interpDecidable
      (A.supportWitnessDPAStateCompilationOfCorrect
        (LTL.canonicalRunLanguageCertificate
          formula interp interpDecidable)
        hcorrect)
      finiteGameCompilation

