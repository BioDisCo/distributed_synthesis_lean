        interp interpDecidable).EdgeWitnessedMacroRun
          ({initialState} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))
          word)
    (heventual :
      ∃ N : Nat,
        ∀ j : Nat,
          N ≤ j ->
            run.toMacroRun.states j ∈ run.toMacroRun.infStateFinset ->
              ∀ nextState, nextState ∈ run.toMacroRun.states j ->
                PositiveLTL.Satisfies interp
