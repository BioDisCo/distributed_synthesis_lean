/--
Stable release self-paths are tail-coherent once every matching active
occurrence is in the open-release case.

This is the local fixed-point branch step used by the pruned guided-support
route: the semantic release progress lemma supplies an active self-child
whenever the left side does not already close the release at the current
suffix, and this theorem packages those self-children in the generic
`StatePathTailCoherentChildren` form.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_constant_release_tailCoherent_of_not_left
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    (releaseState : root.Subformula)
    (φ ψ : PositiveLTL AP)
    (hrelease : releaseState.1 = PositiveLTL.release φ ψ)
    (node : AlternatingParityAutomaton.Node)
    (hpathNode :
      (PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).PathActive node)
    (hnodeState :
      (PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).stateAt node =
        releaseState)
    (hnotLeft :
      ∀ suffix : AlternatingParityAutomaton.Node,
        (PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word initial hsatInitial).PathActive
            (suffix ++ node) ->
        (PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word initial hsatInitial).stateAt
            (suffix ++ node) = releaseState ->
          ¬ PositiveLTL.Satisfies interp
            (OmegaWord.drop word (suffix ++ node).length) φ) :
    (PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial).StatePathTailCoherentChildren
        (fun _ : Nat => releaseState) := by
  let run :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial
  have hnodeActive : run.active node :=
    run.pathActive_self node hpathNode
  refine ⟨node, hpathNode, hnodeActive, ?_⟩
  constructor
  · simpa [run, AlternatingParityAutomaton.Run.subRun_stateAt] using
      hnodeState
  · intro suffix hsuffixActive hsuffixState
    have hsuffixPath :
        run.PathActive (suffix ++ node) :=
      run.pathActive_append_of_subRun_pathActive hpathNode hnodeActive
        hsuffixActive
    have hsuffixStateOriginal :
        run.stateAt (suffix ++ node) = releaseState := by
      simpa [run, AlternatingParityAutomaton.Run.subRun_stateAt] using
        hsuffixState
    have hactiveParent :
        PositiveLTL.subformulaClosure_guidedRunFromActive
          root interp dec word initial hsatInitial (suffix ++ node) := by
      simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
        run.pathActive_self (suffix ++ node) hsuffixPath
    have hparentState :
        PositiveLTL.subformulaClosure_guidedRunFromState
          root interp dec word initial hsatInitial (suffix ++ node) =
          releaseState := by
      simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
        hsuffixStateOriginal
    have hparentRelease :
        (PositiveLTL.subformulaClosure_guidedRunFromState
          root interp dec word initial hsatInitial (suffix ++ node)).1 =
          PositiveLTL.release φ ψ := by
      rw [hparentState, hrelease]
    have hnotLeftHere :
        ¬ PositiveLTL.Satisfies interp
            (OmegaWord.drop word (suffix ++ node).length) φ :=
      hnotLeft suffix hsuffixPath hsuffixStateOriginal
    rcases
      PositiveLTL.subformulaClosure_guidedRunFrom_child_release_self_of_not_left
        root interp dec word initial hsatInitial (suffix ++ node) φ ψ
        hactiveParent hparentRelease hnotLeftHere with
      ⟨child, hchildActive, hchildState⟩
    refine ⟨child, ?_, ?_⟩
    · simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom,
        AlternatingParityAutomaton.Run.subRun_active, List.cons_append] using
        hchildActive
    · have hchildStateOriginal :
          run.stateAt (child :: suffix ++ node) = releaseState := by
        have hchildState' :
            PositiveLTL.subformulaClosure_guidedRunFromState
              root interp dec word initial hsatInitial
                (child :: suffix ++ node) = releaseState :=
          hchildState.trans hparentState
        simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
          hchildState'
      simpa [run, AlternatingParityAutomaton.Run.subRun_stateAt,
        List.cons_append] using hchildStateOriginal

