  rcases witness.exists_progress_edge_prefixes hstates with
    ⟨edge, hedge, hsource, htargetState, hprefixes⟩
  refine ⟨edge, hedge, hsource, htargetState, ?_⟩
  intro n
  rcases hprefixes n with ⟨k, pref, hle, hprefSource, hprefTarget⟩
  refine ⟨k, pref, hle, hprefSource, hprefTarget, ?_⟩
  intro htarget
  exact
    PositiveLTL.subformulaClosure_macroRunPrefix_satisfies_back_of_size_lt
      root interp interpDecidable
      (initialStates := initialStates)
      (word := word)
      (offset := k + 1)
      (bound := bound)
      pref
      htarget

/--
Timed until progress with only smaller-target semantic assumptions.

For a recurrent operational state-edge whose source is `φ U ψ`, every
sufficiently late concrete occurrence gives the one-step until body: either
`ψ` holds at the occurrence, or `φ` holds and the same until source state
continues into the target frontier.  This is the support-witness counterpart
of `subformulaClosure_macroTransition_until_satisfies_progress_of_smaller`.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_until_stateEdge_prefix_progress_of_smaller
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {edge :
      APAStateEdge
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable)}
    (hedge : edge ∈ witness.stateEdges)
    {φ ψ : PositiveLTL AP}
    (hsource : edge.1.1 = PositiveLTL.until φ ψ) :
    ∀ n : Nat,
      ∃ k : Nat,
        ∃ pref :
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).MacroRunPrefix initialStates word (k + 1),
          n ≤ k ∧
            edge.1 ∈ pref.states k ∧
            edge.2 ∈ pref.states (k + 1) ∧
            ((∀ nextState, nextState ∈ pref.states (k + 1) ->
                nextState.1.size < (PositiveLTL.until φ ψ).size ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word (k + 1)) nextState.1) ->
              PositiveLTL.Satisfies interp
                  (OmegaWord.drop word k) ψ ∨
                (PositiveLTL.Satisfies interp
                    (OmegaWord.drop word k) φ ∧
                  edge.1 ∈ pref.states (k + 1))) := by
  intro n
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases witness.stateEdge_prefixes_with_extended_prefix hedge n with
    ⟨k, sourceStates, targetStates, stepStateEdges, pref,
      hle, hprefSource, hprefTarget, htransition, hedgeStep,
      hedgeSource, hedgeTarget⟩
  refine ⟨k, pref, hle, ?_, ?_, ?_⟩
  · simpa [hprefSource] using hedgeSource
  · simpa [hprefTarget] using hedgeTarget
  · intro htargetSmaller
    have hprogress :=
      PositiveLTL.subformulaClosure_macroTransition_until_satisfies_progress_of_smaller
        root interp interpDecidable
        (OmegaWord.drop word k)
        htransition
        hedgeSource
        hsource
        (by
          intro nextState hnextState hlt
          have hnextTarget : nextState ∈ pref.states (k + 1) := by
            simpa [hprefTarget] using hnextState
          simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
            Nat.add_assoc] using
              htargetSmaller nextState hnextTarget hlt)
    rcases hprogress with hψ | hcontinue
    · left
      simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
        Nat.add_assoc] using hψ
    · right
      rcases hcontinue with ⟨hφ, hnext⟩
      refine ⟨?_, ?_⟩
      · simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
          Nat.add_assoc] using hφ
      · simpa [hprefTarget] using hnext

/--
Same-time until progress from a recurrent target frontier.

This is the local non-circular handoff needed by the recurrent anchor.  If a
concrete occurrence of a selected `until` state-edge has a target
macro-configuration that is one of the recurrent frontiers, then the recurrent
invariant supplies all strictly smaller target formulas at the exact next
suffix, closing the smaller-target premise of the tableau progress lemma.
