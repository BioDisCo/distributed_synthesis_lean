      (j := j)
      (bound := bound)
      htransition
      htargetStates
      htargetConfig
      hrecurrent

/--
Unbounded exact one-step back-propagation at a deterministic
macro-configuration occurrence.

The bounded theorem above is the induction workhorse.  For the canonical
subformula APA, every state is a subformula of `root`, so an unbounded
recurrent invariant can be restricted to the global bound `root.size + 1`.
-/
theorem PositiveLTL.subformulaClosure_macroConfiguration_source_frontier_of_recurrent_invariant_unbounded
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
