          (A.supportWitnessDPAStateCompilationOfOperationalPrefixAndTailBranchRealizable
            (LTL.canonicalRunLanguageCertificate
              formula interp interpDecidable)
            hpref hrealizable).dpa.Accepts word)
    (dynamicHierarchy parityObjective : Prop)
    (dynamicHierarchy_proof : dynamicHierarchy)
    (parityObjective_proof : parityObjective)
    (synchronizedChoices :
      ∀ controller : transformer.ControllerCode,
        ∀ (env : EnvironmentSequence In₁ In₂)
          (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
            FiniteEpochTransformer.CompatibleDecodedExecution
              transformer initialBoundary controller env word ->
              ∃ stateStream : Nat -> FiniteEpochTransformer.GameState transformer,
                FiniteEpochTransformer.CompatibleDecodedExecutionSynchronizedStateChoices
                  transformer initialBoundary controller env word stateStream)
    (matchingControllers :
      FiniteEpochTransformer.GameExecutionStrategiesHaveMatchingControllers
        transformer initialBoundary) :
    CanonicalLTLStateRunBackendCompilation.{u, v, x, y, ap, ap, max u v x y}
      AP In₁ In₂ Out₁ Out₂ :=
  ofCanonicalFrontendSupportWitnessPrefixAndTailBranchRealizableAndSynchronizedStateChoicesAndControllerSimulation
    formula
    interp
    interpDecidable
    hpref
    hrealizable
    transformer
    initialBoundary
    hautomaton
    dynamicHierarchy
    parityObjective
    dynamicHierarchy_proof
    parityObjective_proof
    synchronizedChoices
    (FiniteEpochTransformer.gameExecutionControllerSimulation_of_matchingControllers
      transformer initialBoundary matchingControllers)

