        exact hsuffixState.trans (hstable suffix.length hN)
      have hnextRelease :
          path (suffix.length + 1) = releaseState :=
        hstable (suffix.length + 1) (Nat.le_trans hN (Nat.le_succ _))
      have hrealized :=
        hselfRealized suffix hsuffixPath hstateRelease hN
      simpa [hstable suffix.length hN, hnextRelease] using hrealized
  exact run.statePathTailCoherentChildren_of_threadedTailRealization hthreaded

/--
Eventual stable-release paths are tail-coherent from finite prefix edge
realizations and the semantic open-release condition on the stable tail.

This is the fixed-point version of
`..._of_prefixEdges_and_selfEdgeRealized`: the release self-edge on the stable
tail is produced by the canonical guided tableau from `¬ φ` at each matching
suffix occurrence.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_eventually_constant_release_tailCoherent_of_prefixEdges_and_not_left
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    {path :
      Nat ->
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial).State}
    (N : Nat)
    (releaseState : root.Subformula)
    (φ ψ : PositiveLTL AP)
    (hstable : ∀ n : Nat, N ≤ n -> path n = releaseState)
    (hrelease : releaseState.1 = PositiveLTL.release φ ψ)
    (node : AlternatingParityAutomaton.Node)
    (hpathNode :
      (PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).PathActive node)
    (hnodeState :
      (PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).stateAt node =
        path 0)
    (hprefixRealized :
      ∀ suffix : AlternatingParityAutomaton.Node,
        (PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word initial hsatInitial).PathActive
            (suffix ++ node) ->
        (PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word initial hsatInitial).stateAt
