The only nontrivial remaining input is the branch/local tail-coherence
condition for paths through the singleton graph.
-/
theorem PositiveLTL.subformulaClosure_singletonRelease_acceptingDescentTailCoherent_witness
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    (run :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp dec).withInitial initial).EdgeWitnessedMacroRun
        ({(((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial).initial} :
          Finset (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp dec).withInitial initial).State)
        word)
    (releaseState : root.Subformula)
    (φ ψ : PositiveLTL AP)
    (hrelease : releaseState.1 = PositiveLTL.release φ ψ)
    (hsubset :
      run.infStateEdgeFinset ⊆
        ({(releaseState, releaseState)} :
          Finset (APAStateEdge
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial initial))))
    (htail :
      ∀ path :
        Nat ->
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp dec).withInitial initial).State,
        (∀ n : Nat,
          (path n, path (n + 1)) ∈
            ({(releaseState, releaseState)} :
              Finset (APAStateEdge
                (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                  interp dec).withInitial initial)))) ->
          (PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).StatePathTailCoherentChildren
              path) :
      ∃ run' :
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial).EdgeWitnessedMacroRun
          ({(((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp dec).withInitial initial).initial} :
            Finset (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial initial).State)
          word,
        ∃ acceptedEdges :
          Finset (APAStateEdge
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial initial)),
          run'.infStateEdgeFinset ⊆ acceptedEdges ∧
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial initial).SupportWitnessStateEdgesAccepting
                acceptedEdges ∧
              (∀ edge :
                APAStateEdge
                  (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                    interp dec).withInitial initial),
                edge ∈ acceptedEdges ->
                  edge.2.1 = edge.1.1 ∨ edge.2.1.size < edge.1.1.size) ∧
                (∀ edge :
                  APAStateEdge
                    (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                      interp dec).withInitial initial),
                  edge ∈ acceptedEdges ->
                    edge.2.1 = edge.1.1 ->
                      (∃ φ' ψ' : PositiveLTL AP,
                        edge.1.1 = PositiveLTL.until φ' ψ') ∨
                        ∃ φ' ψ' : PositiveLTL AP,
                          edge.1.1 = PositiveLTL.release φ' ψ') ∧
                  ∀ path :
                    Nat ->
                      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                        interp dec).withInitial initial).State,
                    (∀ n : Nat, (path n, path (n + 1)) ∈ acceptedEdges) ->
                      (PositiveLTL.subformulaClosure_guidedRunFrom
                        root interp dec word initial hsatInitial).StatePathTailCoherentChildren
                          path := by
  let acceptedEdges :
      Finset (APAStateEdge
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial)) :=
    {(releaseState, releaseState)}
  refine ⟨run, acceptedEdges, hsubset, ?_, ?_, ?_, ?_⟩
  · have hnotUntil :
        ∀ φ' ψ' : PositiveLTL AP,
          releaseState.1 ≠ PositiveLTL.until φ' ψ' := by
      intro φ' ψ' hbad
      rw [hrelease] at hbad
      cases hbad
    simpa [acceptedEdges] using
      PositiveLTL.subformulaClosure_withInitial_supportWitnessStateEdgesAccepting_singleton_self_of_not_until
        root interp dec initial releaseState hnotUntil
  · intro edge hedge
    have hedgeEq : edge = (releaseState, releaseState) := by
      dsimp [acceptedEdges] at hedge
      exact Finset.mem_singleton.mp hedge
    subst edge
    left
    rfl
  · intro edge hedge _hself
    have hedgeEq : edge = (releaseState, releaseState) := by
      dsimp [acceptedEdges] at hedge
      exact Finset.mem_singleton.mp hedge
    subst edge
    right
    exact ⟨φ, ψ, hrelease⟩
  · intro path hpath
    exact htail path (by simpa [acceptedEdges] using hpath)

/--
If an accepting support graph path in the canonical LTL APA eventually
stabilizes in formula, then the stable formula is not an `until`.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessStateEdgesAccepting_stable_not_until
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (initial : root.Subformula)
    {acceptedEdges :
      Finset (APAStateEdge
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial))}
    (haccepting :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp dec).withInitial initial).SupportWitnessStateEdgesAccepting
          acceptedEdges)
    {path :
      Nat ->
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial).State}
    (hpath : ∀ n : Nat, (path n, path (n + 1)) ∈ acceptedEdges)
    {N : Nat}
    (hstable : ∀ n : Nat, N ≤ n -> (path n).1 = (path N).1) :
    ∀ φ ψ : PositiveLTL AP, (path N).1 ≠ PositiveLTL.until φ ψ := by
  have heven :
      DetParityAutomaton.NatEven
        (PositiveLTL.alternatingPriority root (path N).1) := by
    exact
      haccepting.eventually_constant_priority_even
        hpath
        (N := N)
        (p := PositiveLTL.alternatingPriority root (path N).1)
        (by
          intro n hn
          change
            PositiveLTL.alternatingPriority root (path n).1 =
              PositiveLTL.alternatingPriority root (path N).1
          rw [hstable n hn])
  exact
    (PositiveLTL.alternatingPriority_even_iff_not_until
      root (path N).1).mp heven

/--
An accepting support graph path whose stable formula is temporal must stabilize
at a `release` state, not an `until` state.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessStateEdgesAccepting_stable_temporal_is_release
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (initial : root.Subformula)
    {acceptedEdges :
      Finset (APAStateEdge
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial))}
    (haccepting :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp dec).withInitial initial).SupportWitnessStateEdgesAccepting
          acceptedEdges)
    {path :
      Nat ->
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial).State}
    (hpath : ∀ n : Nat, (path n, path (n + 1)) ∈ acceptedEdges)
    {N : Nat}
    (hstable : ∀ n : Nat, N ≤ n -> (path n).1 = (path N).1)
    (htemporal :
      (∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.until φ ψ) ∨
        ∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.release φ ψ) :
    ∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.release φ ψ := by
  rcases htemporal with huntil | hrelease
  · rcases huntil with ⟨φ, ψ, hstate⟩
    exact False.elim
      ((PositiveLTL.subformulaClosure_supportWitnessStateEdgesAccepting_stable_not_until
        root interp dec initial haccepting hpath hstable φ ψ) hstate)
  · exact hrelease

theorem PositiveLTL.subformulaClosure_satisfiesEdgeWitnessedMacroRunSubgraphAccepting_of_guidedSubgraphTailBranchRealizable
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (hrealizable :
      PositiveLTL.SubformulaClosureGuidedRunSubgraphTailBranchRealizable
        root interp dec) :
    PositiveLTL.SubformulaClosureSatisfiesEdgeWitnessedMacroRunSubgraphAccepting
      root interp dec := by
  intro state word hsat
  rcases hrealizable state word hsat with
    ⟨acceptedEdges, hsubset, htail⟩
  let runTree :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word state hsat
  refine
    ⟨runTree.realizedEdgeWitnessedMacroRun,
      acceptedEdges,
      hsubset,
      ?_⟩
  exact
    ((((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp dec).withInitial state).supportWitnessStateEdgesAccepting_of_tailBranchRealizable
        runTree
        (PositiveLTL.subformulaClosure_guidedRunFrom_accepting
          root interp dec word state hsat)
        htail)

theorem PositiveLTL.subformulaClosure_supportWitnessExistsRealizedSubgraphTailBranchRealizable_of_guided
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (hrealizable :
      PositiveLTL.SubformulaClosureGuidedRunSubgraphTailBranchRealizable
        root interp dec) :
    AlternatingParityAutomaton.SupportWitnessExistsRealizedSubgraphTailBranchRealizable
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp dec) := by
  intro state word haccepts
  have hsat :
      PositiveLTL.Satisfies interp word state.1 :=
    (PositiveLTL.subformulaClosure_acceptsFrom_iff_satisfies
      root interp dec state word).mp haccepts
  rcases hrealizable state word hsat with
    ⟨acceptedEdges, hsubset, htail⟩
  exact
    ⟨PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word state hsat,
      PositiveLTL.subformulaClosure_guidedRunFrom_accepting
        root interp dec word state hsat,
      acceptedEdges,
      hsubset,
      htail⟩

theorem PositiveLTL.subformulaClosure_satisfiesAcceptingEdgeWitnessedMacroRun_of_subgraphAccepting
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (hwitness :
      PositiveLTL.SubformulaClosureSatisfiesEdgeWitnessedMacroRunSubgraphAccepting
        root interp dec) :
    PositiveLTL.SubformulaClosureSatisfiesAcceptingEdgeWitnessedMacroRun
      root interp dec := by
  intro state word hsat
  rcases hwitness state word hsat with
    ⟨run, acceptedEdges, hsubset, haccepting⟩
  exact
    ⟨run,
      ((((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp dec).withInitial state).supportWitnessStateEdgesAccepting_of_subset
          haccepting hsubset)⟩

theorem PositiveLTL.subformulaClosure_supportWitnessExistsEdgeWitnessedMacroRunSubgraphAccepting_of_satisfies
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (hwitness :
      PositiveLTL.SubformulaClosureSatisfiesEdgeWitnessedMacroRunSubgraphAccepting
        root interp dec) :
    AlternatingParityAutomaton.SupportWitnessExistsEdgeWitnessedMacroRunSubgraphAccepting
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp dec) := by
  intro state word haccepts
  have hsat :
      PositiveLTL.Satisfies interp word state.1 :=
    (PositiveLTL.subformulaClosure_acceptsFrom_iff_satisfies
      root interp dec state word).mp haccepts
  exact hwitness state word hsat

/--
Proof-facing reduction for the preferred pruned accepting-support target.

For the canonical positive-LTL APA, it is enough to construct the accepting
edge-witnessed macro-run from semantic satisfaction of the current subformula.
The already-proved state-wise run-language theorem turns the backend's
`AcceptsFrom` premise into exactly that semantic premise.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessExistsAcceptingEdgeWitnessedMacroRun_of_satisfies
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (hwitness :
      PositiveLTL.SubformulaClosureSatisfiesAcceptingEdgeWitnessedMacroRun
        root interp dec) :
    AlternatingParityAutomaton.SupportWitnessExistsAcceptingEdgeWitnessedMacroRun
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp dec) := by
  intro state word haccepts
  have hsat :
      PositiveLTL.Satisfies interp word state.1 :=
    (PositiveLTL.subformulaClosure_acceptsFrom_iff_satisfies
      root interp dec state word).mp haccepts
  exact hwitness state word hsat

/--
Even sharper reduction: if the concrete progress-guided accepting run has the
node-local recurring-edge completeness property, then the canonical subformula
APA satisfies the existential node-local support-witness target.

This theorem packages the remaining semantic branch-stability proof as a
property of one canonical run tree per accepted state/word.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessExistsRecurringEdgesNodeLocalComplete_of_guidedRunFrom
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (hguided :
      ∀ (state : root.Subformula) (word : OmegaWord Letter),
        ∀ hsat : PositiveLTL.Satisfies interp word state.1,
          (PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word state hsat).RecurringStateEdgesNodeLocalComplete) :
    AlternatingParityAutomaton.SupportWitnessExistsRecurringEdgesNodeLocalComplete
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp dec) := by
  intro state word haccepts
  rcases
    PositiveLTL.subformulaClosure_exists_accepting_guidedRunFrom_of_acceptsFrom
      root interp dec state word haccepts with
    ⟨hsat, haccepting⟩
  exact
    ⟨PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word state hsat,
      haccepting,
      hguided state word hsat⟩

/--
Every active child of the canonical guided tableau run is available as a
node-local support edge from its parent.

This packages the elementary child fact in exactly the local form consumed by
the support-witness recurrence target.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_stateEdgeRealizedFromNode
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    (node : AlternatingParityAutomaton.Node)
    (child : Nat)
    (hpathNode :
      (PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).PathActive node)
    (hactiveChild :
      PositiveLTL.subformulaClosure_guidedRunFromActive
        root interp dec word initial hsatInitial (child :: node)) :
    (PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial).StateEdgeRealizedFromNode
        node
        ((PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).stateAt node,
          (PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).stateAt (child :: node)) := by
  refine ⟨hpathNode, rfl, child, ?_, rfl⟩
  simpa [PositiveLTL.subformulaClosure_guidedRunFrom] using hactiveChild

/--
Active-parent variant of
`subformulaClosure_guidedRunFrom_stateEdgeRealizedFromNode`.

For the guided tableau run, active nodes are automatically path-active, so
callers proving branch-local recurrence do not need to carry a separate
`PathActive` proof.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_stateEdgeRealizedFromActiveNode
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    (node : AlternatingParityAutomaton.Node)
    (child : Nat)
    (hactiveNode :
      PositiveLTL.subformulaClosure_guidedRunFromActive
        root interp dec word initial hsatInitial node)
    (hactiveChild :
      PositiveLTL.subformulaClosure_guidedRunFromActive
        root interp dec word initial hsatInitial (child :: node)) :
    (PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial).StateEdgeRealizedFromNode
        node
        ((PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).stateAt node,
          (PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).stateAt (child :: node)) := by
  exact
    PositiveLTL.subformulaClosure_guidedRunFrom_stateEdgeRealizedFromNode
      root interp dec word initial hsatInitial node child
      (PositiveLTL.subformulaClosure_guidedRunFrom_pathActive_of_active
        root interp dec word initial hsatInitial node hactiveNode)
      hactiveChild

/--
A node-local realization of a release self-edge in the canonical guided run
can only occur while the release is open: the left side is false at that
node's suffix.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_release_self_edgeRealizedFromNode_not_left
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    (node : AlternatingParityAutomaton.Node)
    (releaseState : root.Subformula)
    (φ ψ : PositiveLTL AP)
    (hrelease : releaseState.1 = PositiveLTL.release φ ψ)
    (hrealized :
      (PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).StateEdgeRealizedFromNode
          node (releaseState, releaseState)) :
    ¬ PositiveLTL.Satisfies interp
        (OmegaWord.drop word node.length) φ := by
  rcases hrealized with
    ⟨hpathNode, hsource, child, hchildActive, htarget⟩
  let run :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial
  have hactiveParent :
      PositiveLTL.subformulaClosure_guidedRunFromActive
        root interp dec word initial hsatInitial node := by
    simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
      run.pathActive_self node hpathNode
  have hactiveChild :
      PositiveLTL.subformulaClosure_guidedRunFromActive
        root interp dec word initial hsatInitial (child :: node) := by
    simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
      hchildActive
  have hparentRelease :
      (PositiveLTL.subformulaClosure_guidedRunFromState
        root interp dec word initial hsatInitial node).1 =
        PositiveLTL.release φ ψ := by
    have hsource' :
        PositiveLTL.subformulaClosure_guidedRunFromState
          root interp dec word initial hsatInitial node = releaseState := by
      simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using hsource
    rw [hsource', hrelease]
  have hself :
      PositiveLTL.subformulaClosure_guidedRunFromState
        root interp dec word initial hsatInitial (child :: node) =
      PositiveLTL.subformulaClosure_guidedRunFromState
        root interp dec word initial hsatInitial node := by
    have hsource' :
        PositiveLTL.subformulaClosure_guidedRunFromState
          root interp dec word initial hsatInitial node = releaseState := by
      simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using hsource
    have htarget' :
        PositiveLTL.subformulaClosure_guidedRunFromState
          root interp dec word initial hsatInitial (child :: node) =
          releaseState := by
      simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using htarget
    exact htarget'.trans hsource'.symm
  exact
    PositiveLTL.subformulaClosure_guidedRunFrom_child_release_self_not_left
      root interp dec word initial hsatInitial node child φ ψ
      hactiveParent hactiveChild hparentRelease hself

/--
Along any active branch of the canonical guided run, the branch eventually
stabilizes at a release formula, and the release remains open on every later
branch position.

This is the branch-local fixed-point invariant needed for the support-witness
soundness proof.  It deliberately uses one accepting guided branch, not the
whole recurring edge set of the run.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_branch_eventually_release_not_left
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    (branch : Nat -> Nat)
    (hbranch :
      (PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).ActiveBranch branch) :
    ∃ (N : Nat) (releaseState : root.Subformula) (φ ψ : PositiveLTL AP),
      releaseState.1 = PositiveLTL.release φ ψ ∧
        (∀ n : Nat, N ≤ n ->
          (PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).stateAt
              (AlternatingParityAutomaton.branchPrefix branch n) =
            releaseState) ∧
          ∀ n : Nat, N ≤ n ->
            ¬ PositiveLTL.Satisfies interp (OmegaWord.drop word n) φ := by
  classical
  let run :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial
  rcases
    PositiveLTL.subformulaClosure_guidedRunFrom_branch_eventually_formula_eq
      root interp dec word initial hsatInitial branch hbranch with
    ⟨N, hformula⟩
  let releaseState : root.Subformula :=
    run.stateAt (AlternatingParityAutomaton.branchPrefix branch N)
  let stablePriority : Nat := PositiveLTL.alternatingPriority root releaseState.1
  have hpriority_eventual :
      ∀ n : Nat, N ≤ n ->
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).priority
          (run.stateAt (AlternatingParityAutomaton.branchPrefix branch n)) =
          stablePriority := by
    intro n hn
    change
      PositiveLTL.alternatingPriority root
        (run.stateAt (AlternatingParityAutomaton.branchPrefix branch n)).1 =
        stablePriority
    rw [hformula n hn]
  rcases
    PositiveLTL.subformulaClosure_guidedRunFrom_branch_min_even
      root interp dec word initial hsatInitial branch hbranch with
    ⟨p, hpSeen, _hpMin, hpEven⟩
  have hp_eq : stablePriority = p := by
    rcases hpSeen N with ⟨k, hkN, hkp⟩
    exact (hpriority_eventual k hkN).symm.trans hkp
  have hstableEven : DetParityAutomaton.NatEven stablePriority := by
    rw [hp_eq]
    exact hpEven
  have hselfFormula :
      (run.stateAt (AlternatingParityAutomaton.branchPrefix branch (N + 1))).1 =
        (run.stateAt (AlternatingParityAutomaton.branchPrefix branch N)).1 :=
    hformula (N + 1) (Nat.le_succ N)
  have htemporal :
      (∃ φ ψ : PositiveLTL AP, releaseState.1 = PositiveLTL.until φ ψ) ∨
        ∃ φ ψ : PositiveLTL AP, releaseState.1 = PositiveLTL.release φ ψ := by
    simpa [run, releaseState] using
      PositiveLTL.subformulaClosure_guidedRunFrom_branch_self_step_is_until_or_release
        root interp dec word initial hsatInitial branch hbranch N
        (by simpa [run] using hselfFormula)
  rcases htemporal with huntil | hrelease
  · rcases huntil with ⟨φ, ψ, huntil⟩
    have hodd :
        ¬ DetParityAutomaton.NatEven stablePriority := by
      simpa [stablePriority, releaseState, huntil] using
        PositiveLTL.alternatingPriority_until_not_even root φ ψ
    exact False.elim (hodd hstableEven)
  · rcases hrelease with ⟨φ, ψ, hrelease⟩
    refine ⟨N, releaseState, φ, ψ, hrelease, ?_, ?_⟩
    · intro n hn
      apply Subtype.ext
      simpa [run, releaseState] using hformula n hn
    · intro n hn
      have hparentRelease :
          (PositiveLTL.subformulaClosure_guidedRunFromState
            root interp dec word initial hsatInitial
            (AlternatingParityAutomaton.branchPrefix branch n)).1 =
            PositiveLTL.release φ ψ := by
        have hfn := hformula n hn
        simpa [run, releaseState, hrelease] using hfn
      have hselfState :
          PositiveLTL.subformulaClosure_guidedRunFromState
            root interp dec word initial hsatInitial
            (AlternatingParityAutomaton.branchPrefix branch (n + 1)) =
          PositiveLTL.subformulaClosure_guidedRunFromState
            root interp dec word initial hsatInitial
            (AlternatingParityAutomaton.branchPrefix branch n) := by
        apply Subtype.ext
        have hfn := hformula n hn
        have hfsucc :=
          hformula (n + 1) (Nat.le_trans hn (Nat.le_succ n))
        simpa [run] using hfsucc.trans hfn.symm
      have hnotLeft :=
        PositiveLTL.subformulaClosure_guidedRunFrom_child_release_self_not_left
          root interp dec word initial hsatInitial
          (AlternatingParityAutomaton.branchPrefix branch n)
          (branch n) φ ψ
          (hbranch n)
          (by simpa using hbranch (n + 1))
          hparentRelease
          hselfState
      simpa using hnotLeft

/--
Every active child of the canonical guided tableau run is also a timed atom of
the parent's APA transition at that node's word position.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_child_timedAtom
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    (node : AlternatingParityAutomaton.Node)
    (child : Nat)
    (hpathNode :
      (PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).PathActive node)
    (hactiveChild :
      PositiveLTL.subformulaClosure_guidedRunFromActive
        root interp dec word initial hsatInitial (child :: node)) :
    (PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).stateAt (child :: node) ∈
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).step
        ((PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word initial hsatInitial).stateAt node)
        (word node.length)).atoms := by
  let run :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial
  have hactiveParent :
      PositiveLTL.subformulaClosure_guidedRunFromActive
        root interp dec word initial hsatInitial node := by
    simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
      run.pathActive_self node hpathNode
  simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
    PositiveLTL.subformulaClosure_guidedRunFrom_child_atom
      root interp dec word initial hsatInitial node child
      hactiveParent hactiveChild

/--
Active-parent variant of `subformulaClosure_guidedRunFrom_child_timedAtom`.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_child_timedAtom_of_activeNode
    {AP : Type ap}
