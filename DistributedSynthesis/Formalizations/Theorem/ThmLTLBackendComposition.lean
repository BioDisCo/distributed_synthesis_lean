/--
Canonical full-LTL state-wise backend with a tracking-style DPA finite game.

This is closer to the finite-game construction shape: the finite game may
track the DPA state over a finite prefix and state its correctness against the
DPA suffix objective.  The general DPA prefix law converts it to the ordinary
state-wise backend above.
-/
structure CanonicalLTLStateRunTrackingBackendCompilation
    (AP : Type ap)
    (In₁ : Type u)
    (In₂ : Type v)
    (Out₁ : Type x)
    (Out₂ : Type y)
    [DecidableEq AP] where
  formula : LTL AP
  interp : AP -> RoundRecord In₁ In₂ Graph Out₁ Out₂ -> Prop
  interpDecidable : ∀ ap letter, Decidable (interp ap letter)
  runCertificate :
    ((PositiveLTL.subformulaClosure
      (AP := AP)
      (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
      (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable).RunLanguageCertificate
  runLanguageCorrect :
    ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      word ∈ runCertificate.toLanguageCertificate.initialLanguage ↔
        PositiveLTL.Satisfies interp word (PositiveLTL.ofLTL formula)
  determinization :
    APAToDPAStateCompilation.{max u v x y, ap, a}
      ((PositiveLTL.subformulaClosure
        (AP := AP)
        (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
        (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable)
      runCertificate.toLanguageCertificate
  finiteGameCompilation :
    DPATrackingFiniteGameCompilation.{u, v, x, y, b}
      Out₂
      determinization.dpa

/-- Convert the tracking finite-game backend into the ordinary state-wise backend. -/
noncomputable def CanonicalLTLStateRunTrackingBackendCompilation.toStateRunBackendCompilation
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert :
      CanonicalLTLStateRunTrackingBackendCompilation.{u, v, x, y, ap, a, b}
        AP In₁ In₂ Out₁ Out₂) :
    CanonicalLTLStateRunBackendCompilation.{u, v, x, y, ap, a, b}
      AP In₁ In₂ Out₁ Out₂ where
  formula := cert.formula
  interp := cert.interp
  interpDecidable := cert.interpDecidable
  runCertificate := cert.runCertificate
  runLanguageCorrect := cert.runLanguageCorrect
  determinization := cert.determinization
  finiteGameCompilation := cert.finiteGameCompilation.toDPAToFiniteGameCompilation

/--
The tracking state-wise full-LTL backend yields the effective parity
specification with the original full-LTL predicate.
-/
noncomputable def CanonicalLTLStateRunTrackingBackendCompilation.toEffectiveParitySpecification
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert :
      CanonicalLTLStateRunTrackingBackendCompilation.{u, v, x, y, ap, a, b}
        AP In₁ In₂ Out₁ Out₂) :
    EffectiveParitySpecification.{u, v, x, y, b, max u v x y} In₁ In₂ Out₁ Out₂ :=
  cert.toStateRunBackendCompilation.toEffectiveParitySpecification

/--
Canonical full-LTL synthesis decidability through state-wise APA
determinization and tracking-style finite-game compilation.
-/
noncomputable def CanonicalLTLStateRunTrackingBackendCompilation.synthesis_decidable
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert :
      CanonicalLTLStateRunTrackingBackendCompilation.{u, v, x, y, ap, a, b}
        AP In₁ In₂ Out₁ Out₂) :
    Decidable
      (SynthesisProblem
        (fun word => LTL.Satisfies cert.interp word cert.formula)) :=
  cert.toStateRunBackendCompilation.synthesis_decidable

