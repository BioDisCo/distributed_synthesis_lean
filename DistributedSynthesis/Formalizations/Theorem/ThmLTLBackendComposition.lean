  rcases
    PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_infStateEdge_self_or_size_lt
      root interp interpDecidable run hedge with hself | hlt
  · rcases edge with ⟨source, target⟩
    have hselfEdge : (source, source) ∈ run.infStateEdgeFinset := by
      have htargetSource : target = source := hself
      rw [htargetSource] at hedge
      exact hedge
    exact False.elim
      (PositiveLTL.subformulaClosure_stateEdgesAccepting_until_self_not_mem
        root interp interpDecidable
        haccepting hsource hselfEdge)
  · simpa [hsource] using hlt

/--
One-step bounded semantic back-propagation along the actual states of an
edge-witnessed macro-run.

This is the concrete-run workhorse for the remaining recurrent-frontier
invariant: if the next actual macro-state is semantically true below a bound,
then the current actual macro-state is semantically true below the same bound.
Temporal self-loops still require the dedicated `until`/`release` arguments,
but all strictly smaller one-step obligations are discharged by this lemma.
-/
theorem PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_step_satisfies_of_next_run_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun initialStates word)
    {j bound : Nat}
    (hnext :
      ∀ nextState, nextState ∈ run.toMacroRun.states (j + 1) ->
        nextState.1.size < bound ->
          PositiveLTL.Satisfies interp
            (OmegaWord.drop word (j + 1)) nextState.1) :
    ∀ sourceState, sourceState ∈ run.toMacroRun.states j ->
      sourceState.1.size < bound ->
        PositiveLTL.Satisfies interp
          (OmegaWord.drop word j) sourceState.1 := by
  intro sourceState hsourceState hsourceSize
  have htransition :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).MacroTransitionWithStateEdges
          (run.toMacroRun.states j)
          ((OmegaWord.drop word j) 0)
          (run.toMacroRun.states (j + 1))
          (run.stateEdges j) := by
    simpa [OmegaWord.drop] using run.step_stateEdges_transition j
  exact
    PositiveLTL.subformulaClosure_satisfies_of_macroTransition_next_of_size_lt
      root interp interpDecidable
      (OmegaWord.drop word j)
      htransition
      hsourceState
      hsourceSize
      (by
        intro nextState hnextState hnextSize
        simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
          Nat.add_assoc] using
          hnext nextState hnextState hnextSize)

/--
Recurrent-frontier version of the concrete one-step back-propagation lemma.

Once the next actual macro-state is known to be in the concrete macro-run's
finite infinity set, a recurrent invariant for that next state proves the
current state below the same bound.
-/
theorem PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_step_satisfies_of_next_infState_run_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun initialStates word)
    {j bound : Nat}
    (hnextInf :
      run.toMacroRun.states (j + 1) ∈ run.toMacroRun.infStateFinset)
    (hrecurrent :
      ∀ k : Nat,
        run.toMacroRun.states k ∈ run.toMacroRun.infStateFinset ->
          ∀ nextState, nextState ∈ run.toMacroRun.states k ->
            nextState.1.size < bound ->
              PositiveLTL.Satisfies interp
                (OmegaWord.drop word k) nextState.1) :
    ∀ sourceState, sourceState ∈ run.toMacroRun.states j ->
      sourceState.1.size < bound ->
        PositiveLTL.Satisfies interp
          (OmegaWord.drop word j) sourceState.1 := by
  exact
    PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_step_satisfies_of_next_run_invariant
      root interp interpDecidable run
      (j := j)
      (bound := bound)
      (by
        intro nextState hnextState hnextSize
        exact hrecurrent (j + 1) hnextInf nextState hnextState hnextSize)

/--
No-self actual-run one-step wrapper.

For source formulas whose tableau step has no self atom, every selected
successor is strictly smaller.  Once the next actual macro-state is recurrent,
the recurrent smaller-formula invariant proves the source state at the current
suffix.  This is the generic actual-run case complementing the dedicated
`until` and `release` eventual wrappers.
-/
theorem PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_step_satisfies_of_next_infState_run_invariant_no_self_atom
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun initialStates word)
    {j : Nat}
    (hnextInf :
      run.toMacroRun.states (j + 1) ∈ run.toMacroRun.infStateFinset)
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    (hstateMem : state ∈ run.toMacroRun.states j)
    (hNoSelf :
      ∀ nextState,
        nextState ∈
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).step state ((OmegaWord.drop word j) 0)).atoms ->
          nextState ≠ state)
    (hrecurrent :
      ∀ k : Nat,
        run.toMacroRun.states k ∈ run.toMacroRun.infStateFinset ->
          ∀ nextState, nextState ∈ run.toMacroRun.states k ->
            nextState.1.size < state.1.size ->
              PositiveLTL.Satisfies interp
                (OmegaWord.drop word k) nextState.1) :
    PositiveLTL.Satisfies interp (OmegaWord.drop word j) state.1 := by
  have htransition :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).MacroTransitionWithStateEdges
          (run.toMacroRun.states j)
          ((OmegaWord.drop word j) 0)
          (run.toMacroRun.states (j + 1))
          (run.stateEdges j) := by
    simpa [OmegaWord.drop] using run.step_stateEdges_transition j
  exact
    PositiveLTL.subformulaClosure_satisfies_of_macroTransition_next_of_no_self_atom
      root interp interpDecidable
      (OmegaWord.drop word j)
      htransition
      hstateMem
      hNoSelf
      (by
        intro nextState hnextState hnextSize
        simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
          Nat.add_assoc] using
          hrecurrent (j + 1) hnextInf nextState hnextState hnextSize)

/--
Actual-run `until` step after non-recurring edges have disappeared.

The strengthened tableau lemma returns a selected self-edge in the continuation
case.  If the current concrete step only uses recurring state-edges, accepting
parity rules out such an `until` self-edge.  Hence the `until` state is
semantically true at the current suffix using only the smaller-formula
invariant on the next actual recurrent macro-state.
-/
theorem PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_until_step_satisfies_of_next_infState_run_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun initialStates word)
    (haccepting :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportWitnessStateEdgesAccepting
          run.infStateEdgeFinset)
    {j : Nat}
    (hstepEdgesInf :
      run.stateEdges j ⊆ run.infStateEdgeFinset)
    (hnextInf :
      run.toMacroRun.states (j + 1) ∈ run.toMacroRun.infStateFinset)
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    (hstateMem : state ∈ run.toMacroRun.states j)
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.until φ ψ)
    (hrecurrent :
      ∀ k : Nat,
        run.toMacroRun.states k ∈ run.toMacroRun.infStateFinset ->
          ∀ nextState, nextState ∈ run.toMacroRun.states k ->
            nextState.1.size < (PositiveLTL.until φ ψ).size ->
              PositiveLTL.Satisfies interp
                (OmegaWord.drop word k) nextState.1) :
    PositiveLTL.Satisfies interp (OmegaWord.drop word j) state.1 := by
  have htransition :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).MacroTransitionWithStateEdges
          (run.toMacroRun.states j)
          ((OmegaWord.drop word j) 0)
          (run.toMacroRun.states (j + 1))
          (run.stateEdges j) := by
    simpa [OmegaWord.drop] using run.step_stateEdges_transition j
  have hprogress :
      PositiveLTL.Satisfies interp (OmegaWord.drop word j) ψ ∨
        (PositiveLTL.Satisfies interp (OmegaWord.drop word j) φ ∧
          (state, state) ∈ run.stateEdges j) := by
    simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
      Nat.add_assoc] using
      (PositiveLTL.subformulaClosure_macroTransition_until_satisfies_progress_of_smaller_or_self_edge
        root interp interpDecidable
        (OmegaWord.drop word j)
        htransition
        hstateMem
        hstate
        (by
          intro nextState hnextState hnextSize
          simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
            Nat.add_assoc] using
            hrecurrent (j + 1) hnextInf nextState hnextState hnextSize))
  rw [hstate]
  rw [PositiveLTL.satisfies_until_unfold]
  rcases hprogress with hψ | hcontinue
  · exact Or.inl hψ
  · rcases hcontinue with ⟨_hφ, hselfStep⟩
    have hselfInf : (state, state) ∈ run.infStateEdgeFinset :=
      hstepEdgesInf hselfStep
    exact False.elim
      (PositiveLTL.subformulaClosure_stateEdgesAccepting_until_self_not_mem
        root interp interpDecidable
        haccepting hstate hselfInf)

/--
One-step `until` progress from an explicit semantic invariant on the next
actual macro-state.

This is the cutoff-aware version used by the size induction: the smaller
formulas only need to be true at the concrete next position, not globally at
all recurrent positions.
-/
theorem PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_until_step_satisfies_of_next_run_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun initialStates word)
    (haccepting :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportWitnessStateEdgesAccepting
          run.infStateEdgeFinset)
    {j : Nat}
    (hstepEdgesInf :
      run.stateEdges j ⊆ run.infStateEdgeFinset)
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    (hstateMem : state ∈ run.toMacroRun.states j)
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.until φ ψ)
    (hnext :
      ∀ nextState, nextState ∈ run.toMacroRun.states (j + 1) ->
        nextState.1.size < (PositiveLTL.until φ ψ).size ->
          PositiveLTL.Satisfies interp
            (OmegaWord.drop word (j + 1)) nextState.1) :
    PositiveLTL.Satisfies interp (OmegaWord.drop word j) state.1 := by
  have htransition :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).MacroTransitionWithStateEdges
          (run.toMacroRun.states j)
          ((OmegaWord.drop word j) 0)
          (run.toMacroRun.states (j + 1))
          (run.stateEdges j) := by
    simpa [OmegaWord.drop] using run.step_stateEdges_transition j
  have hprogress :
      PositiveLTL.Satisfies interp (OmegaWord.drop word j) ψ ∨
        (PositiveLTL.Satisfies interp (OmegaWord.drop word j) φ ∧
          (state, state) ∈ run.stateEdges j) := by
    simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
      Nat.add_assoc] using
      (PositiveLTL.subformulaClosure_macroTransition_until_satisfies_progress_of_smaller_or_self_edge
        root interp interpDecidable
        (OmegaWord.drop word j)
        htransition
        hstateMem
        hstate
        (by
          intro nextState hnextState hnextSize
          simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
            Nat.add_assoc] using
            hnext nextState hnextState hnextSize))
  rw [hstate]
  rw [PositiveLTL.satisfies_until_unfold]
  rcases hprogress with hψ | hcontinue
  · exact Or.inl hψ
  · rcases hcontinue with ⟨_hφ, hselfStep⟩
    have hselfInf : (state, state) ∈ run.infStateEdgeFinset :=
      hstepEdgesInf hselfStep
    exact False.elim
      (PositiveLTL.subformulaClosure_stateEdgesAccepting_until_self_not_mem
        root interp interpDecidable
        haccepting hstate hselfInf)

/--
Eventual actual-run `until` satisfaction from the recurring smaller-formula
invariant.

After a finite prefix, every visited macro-state is recurrent and every
selected state-edge is recurrent.  At that point the one-step `until` wrapper
above applies uniformly to every `until` state in the current actual
macro-state.
-/
theorem PositiveLTL.subformulaClosure_until_state_satisfies_eventually_of_edgeWitnessedMacroRun_infState_run_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun initialStates word)
    (haccepting :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportWitnessStateEdgesAccepting
          run.infStateEdgeFinset)
    {φ ψ : PositiveLTL AP}
    (hrecurrent :
      ∀ k : Nat,
        run.toMacroRun.states k ∈ run.toMacroRun.infStateFinset ->
          ∀ nextState, nextState ∈ run.toMacroRun.states k ->
            nextState.1.size < (PositiveLTL.until φ ψ).size ->
              PositiveLTL.Satisfies interp
                (OmegaWord.drop word k) nextState.1) :
    ∃ N : Nat,
      ∀ j : Nat,
        N ≤ j ->
          ∀ state, state ∈ run.toMacroRun.states j ->
            state.1 = PositiveLTL.until φ ψ ->
              PositiveLTL.Satisfies interp
                (OmegaWord.drop word j) state.1 := by
  rcases run.eventually_stateEdges_subset_infStateEdgeFinset with
    ⟨edgeBase, hedgeTail⟩
  rcases run.toMacroRun.eventually_mem_infStateFinset with
    ⟨stateBase, hstateTail⟩
  refine ⟨max edgeBase stateBase, ?_⟩
  intro j hj state hstateMem hstate
  exact
    PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_until_step_satisfies_of_next_infState_run_invariant
      root interp interpDecidable run haccepting
      (j := j)
      (hstepEdgesInf := hedgeTail j (by omega))
      (hnextInf := hstateTail (j + 1) (by omega))
      hstateMem
      hstate
      hrecurrent

/--
The target of a selected operational edge leaving an `until` state is both
covered by a recurrent macro-state and strictly smaller than the source
`until` formula.

This is the induction-hypothesis handoff for the recurrent-frontier anchor:
after parity rules out the selected `until` self-loop, every selected
continuation edge points to a smaller formula inside a recurrent frontier.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_until_stateEdge_target_covered_smaller
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {edge :
      APAStateEdge
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable)}
    (hedge : edge ∈ witness.stateEdges)
    {φ ψ : PositiveLTL AP}
    (hsource : edge.1.1 = PositiveLTL.until φ ψ) :
    ∃ targetStates :
        Finset
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).State),
      targetStates ∈ witness.macroStates ∧
        edge.2 ∈ targetStates ∧
          edge.2.1.size < (PositiveLTL.until φ ψ).size := by
  rcases witness.stateEdge_target_covered hedge with
    ⟨targetStates, htargetStates, htarget⟩
  refine ⟨targetStates, htargetStates, htarget, ?_⟩
  exact
    PositiveLTL.subformulaClosure_supportWitness_until_stateEdge_target_size_lt
      root interp interpDecidable witness hedge hsource

/--
Release coinduction specialized to a subformula state of the canonical LTL
closure.

The predicate `P` is intentionally only over suffix indices of one word.  This
matches the recurring-frontier anchor proof: once the support witness supplies
the one-step obligations at every index in `P`, this theorem closes the
semantic release case for the represented subformula state.
-/
theorem PositiveLTL.subformulaClosure_release_state_satisfies_of_suffix_coinduction
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (word : OmegaWord Letter)
    (state : root.Subformula)
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.release φ ψ)
    (P : Nat -> Prop)
    (hstep :
      ∀ n,
        P n ->
          PositiveLTL.Satisfies interp (OmegaWord.drop word n) ψ ∧
            (PositiveLTL.Satisfies interp (OmegaWord.drop word n) φ ∨
              P (n + 1))) :
    ∀ n,
      P n ->
        PositiveLTL.Satisfies interp (OmegaWord.drop word n) state.1 := by
  intro n hn
  rw [hstate]
  exact
    PositiveLTL.satisfies_release_coinduction_on_suffixes
      interp word φ ψ P hstep n hn

/--
Prefix-transition form of the release coinduction anchor.

This is the concrete form needed for the support-witness frontier proof.  A
predicate `P` marks suffix positions where the same release state is present.
If every marked position has a concrete one-step macro-prefix whose target
frontier is already semantically true, and continuation of the release state in
that target frontier keeps `P`, then the release formula is true at every
marked suffix.
-/
theorem PositiveLTL.subformulaClosure_release_state_satisfies_of_prefix_target_coinduction
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    (word : OmegaWord Letter)
    (state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State)
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.release φ ψ)
    (P : Nat -> Prop)
    (hstep :
      ∀ n,
        P n ->
          ∃ pref :
            ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).MacroRunPrefix initialStates word (n + 1),
            state ∈ pref.states n ∧
              (∀ nextState, nextState ∈ pref.states (n + 1) ->
                PositiveLTL.Satisfies interp
                  (OmegaWord.drop word (n + 1)) nextState.1) ∧
                (state ∈ pref.states (n + 1) -> P (n + 1))) :
    ∀ n,
      P n ->
        PositiveLTL.Satisfies interp (OmegaWord.drop word n) state.1 := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  refine
    PositiveLTL.subformulaClosure_release_state_satisfies_of_suffix_coinduction
      root interp word state hstate P ?_
  intro n hn
  rcases hstep n hn with
    ⟨pref, hstateMem, htarget, hcontinue⟩
  have hmacro :
      A.MacroTransition (pref.states n) (word n) (pref.states (n + 1)) :=
    pref.step_transition n (Nat.lt_succ_self n)
  rcases A.exists_stateEdges_of_macroTransition hmacro with
    ⟨stateEdges, htransition⟩
  have htargetDrop :
      ∀ nextState, nextState ∈ pref.states (n + 1) ->
        PositiveLTL.Satisfies interp
          (OmegaWord.drop (OmegaWord.drop word n) 1) nextState.1 := by
    intro nextState hnextState
    simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
      Nat.add_assoc] using htarget nextState hnextState
  have hprogress :
      PositiveLTL.Satisfies interp (OmegaWord.drop word n) ψ ∧
        (PositiveLTL.Satisfies interp (OmegaWord.drop word n) φ ∨
          state ∈ pref.states (n + 1)) := by
    simpa [A, OmegaWord.drop] using
      (PositiveLTL.subformulaClosure_macroTransition_release_satisfies_progress
        root interp interpDecidable
        (OmegaWord.drop word n)
        (states := pref.states n)
        (nextStates := pref.states (n + 1))
        (stateEdges := stateEdges)
        htransition
        hstateMem
        hstate
        htargetDrop)
  refine ⟨hprogress.1, ?_⟩
  rcases hprogress.2 with hφ | hnext
  · exact Or.inl hφ
  · exact Or.inr (hcontinue hnext)

/--
Non-circular prefix-transition form of release coinduction.

This is the version needed for a structural proof of the recurrent frontier
anchor: the one-step premise only assumes semantic truth for target formulas
strictly smaller than the release state.  If the transition continues with the
same release state, the supplied predicate `P` carries the coinductive
obligation to the next suffix.
-/
theorem PositiveLTL.subformulaClosure_release_state_satisfies_of_prefix_smaller_coinduction
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    (word : OmegaWord Letter)
    (state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State)
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.release φ ψ)
    (P : Nat -> Prop)
    (hstep :
      ∀ n,
        P n ->
          ∃ pref :
            ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).MacroRunPrefix initialStates word (n + 1),
            state ∈ pref.states n ∧
              (∀ nextState, nextState ∈ pref.states (n + 1) ->
                nextState.1.size < (PositiveLTL.release φ ψ).size ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word (n + 1)) nextState.1) ∧
                (state ∈ pref.states (n + 1) -> P (n + 1))) :
    ∀ n,
      P n ->
        PositiveLTL.Satisfies interp (OmegaWord.drop word n) state.1 := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  refine
    PositiveLTL.subformulaClosure_release_state_satisfies_of_suffix_coinduction
      root interp word state hstate P ?_
  intro n hn
  rcases hstep n hn with
    ⟨pref, hstateMem, htargetSmaller, hcontinue⟩
  have hmacro :
      A.MacroTransition (pref.states n) (word n) (pref.states (n + 1)) :=
    pref.step_transition n (Nat.lt_succ_self n)
  rcases A.exists_stateEdges_of_macroTransition hmacro with
    ⟨stateEdges, htransition⟩
  have htargetDrop :
      ∀ nextState, nextState ∈ pref.states (n + 1) ->
        nextState.1.size < (PositiveLTL.release φ ψ).size ->
          PositiveLTL.Satisfies interp
            (OmegaWord.drop (OmegaWord.drop word n) 1) nextState.1 := by
    intro nextState hnextState hlt
    simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
      Nat.add_assoc] using htargetSmaller nextState hnextState hlt
  have hprogress :
      PositiveLTL.Satisfies interp (OmegaWord.drop word n) ψ ∧
        (PositiveLTL.Satisfies interp (OmegaWord.drop word n) φ ∨
          state ∈ pref.states (n + 1)) := by
    simpa [A, OmegaWord.drop] using
      (PositiveLTL.subformulaClosure_macroTransition_release_satisfies_progress_of_smaller
        root interp interpDecidable
        (OmegaWord.drop word n)
        (states := pref.states n)
        (nextStates := pref.states (n + 1))
        (stateEdges := stateEdges)
        htransition
        hstateMem
        hstate
        htargetDrop)
  refine ⟨hprogress.1, ?_⟩
  rcases hprogress.2 with hφ | hnext
  · exact Or.inl hφ
  · exact Or.inr (hcontinue hnext)

/--
Selected-frontier release coinduction.

This is the exact recurrent-frontier shape of the release case.  The predicate
for coinduction says that the release state occurs in one of the selected
support-witness macro-frontiers at the current word position.  The proof is
non-circular: each one-step premise only asks for formulas strictly smaller
than the release state in the concrete successor frontier; if the release state
itself remains in that successor, the premise must re-establish the selected
frontier predicate at the next position.

The explicit `hstep` premise is important.  A generic operational witness only
gives arbitrarily late realizations of selected edges; release coinduction
needs a consecutive suffix predicate.
-/
theorem PositiveLTL.subformulaClosure_release_state_satisfies_of_selected_frontier_coinduction
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    (state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State)
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.release φ ψ)
    (hstep :
      ∀ n,
        ∀ states,
          states ∈ witness.macroStates ->
            states ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun initialStates word n ->
              state ∈ states ->
                ∃ pref :
                  ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                    interp interpDecidable).MacroRunPrefix initialStates word (n + 1),
                  pref.states n = states ∧
                    (∀ nextState, nextState ∈ pref.states (n + 1) ->
                      nextState.1.size < (PositiveLTL.release φ ψ).size ->
                        PositiveLTL.Satisfies interp
                          (OmegaWord.drop word (n + 1)) nextState.1) ∧
                      (state ∈ pref.states (n + 1) ->
                        ∃ nextStates,
                          nextStates ∈ witness.macroStates ∧
                            nextStates ∈
                              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                                interp interpDecidable).macroConfigurationRun
                                  initialStates word (n + 1) ∧
                              state ∈ nextStates)) :
    ∀ n,
      ∀ states,
        states ∈ witness.macroStates ->
          states ∈
            ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).macroConfigurationRun initialStates word n ->
            state ∈ states ->
              PositiveLTL.Satisfies interp (OmegaWord.drop word n) state.1 := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  let P : Nat -> Prop := fun n =>
    ∃ states,
      states ∈ witness.macroStates ∧
        states ∈ A.macroConfigurationRun initialStates word n ∧
          state ∈ states
  have hrelease :
      ∀ n,
        P n ->
          PositiveLTL.Satisfies interp (OmegaWord.drop word n) state.1 :=
    PositiveLTL.subformulaClosure_release_state_satisfies_of_prefix_smaller_coinduction
      root interp interpDecidable
      (initialStates := initialStates)
      word state hstate P ?_
  · intro n states hstates hconfig hmem
    exact hrelease n ⟨states, hstates, hconfig, hmem⟩
  · intro n hn
    rcases hn with ⟨states, hstates, hconfig, hmem⟩
    rcases hstep n states hstates (by simpa [A] using hconfig) hmem with
      ⟨pref, hprefStates, htarget, hcontinue⟩
    refine ⟨pref, ?_, htarget, ?_⟩
    · simpa [hprefStates] using hmem
    · intro hnext
      rcases hcontinue hnext with
        ⟨nextStates, hnextStates, hnextConfig, hstateNext⟩
      exact ⟨nextStates, hnextStates, by simpa [A] using hnextConfig, hstateNext⟩

/--
Macro-run form of the release coinduction anchor.

This packages `subformulaClosure_release_state_satisfies_of_prefix_smaller_coinduction`
for the case where the continuation predicate is carried by one coherent
infinite macro-run.  The recurrent-frontier proof can therefore separate the
construction of a coherent continuation from the semantic release argument.
-/
theorem PositiveLTL.subformulaClosure_release_state_satisfies_of_macroRun_smaller_coinduction
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    (word : OmegaWord Letter)
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).MacroRun initialStates word)
    (state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State)
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.release φ ψ)
    (P : Nat -> Prop)
    (hmem : ∀ n, P n -> state ∈ run.states n)
    (htargetSmaller :
      ∀ n,
        P n ->
          ∀ nextState, nextState ∈ run.states (n + 1) ->
            nextState.1.size < (PositiveLTL.release φ ψ).size ->
              PositiveLTL.Satisfies interp
                (OmegaWord.drop word (n + 1)) nextState.1)
    (hcontinue :
      ∀ n, P n -> state ∈ run.states (n + 1) -> P (n + 1)) :
    ∀ n,
      P n ->
        PositiveLTL.Satisfies interp (OmegaWord.drop word n) state.1 := by
  refine
    PositiveLTL.subformulaClosure_release_state_satisfies_of_prefix_smaller_coinduction
      root interp interpDecidable
      (initialStates := initialStates)
      word state hstate P ?_
  intro n hn
  refine ⟨run.prefix (n + 1), ?_, ?_, ?_⟩
  · simpa using hmem n hn
  · intro nextState hnextState hlt
    exact htargetSmaller n hn nextState (by simpa using hnextState) hlt
  · intro hnext
    exact hcontinue n hn (by simpa using hnext)

/--
Macro-run release coinduction from a recurrent frontier invariant.

This is the support-witness form of the release anchor.  Along a coherent
macro-run, the predicate `P` marks suffix positions where the release state is
present.  If each next macro-state along those marked positions is one of the
selected recurrent frontiers, then the recurrent invariant supplies all
strictly smaller target formulas, and the release coinduction theorem supplies
the guarded self-continuation.
-/
theorem PositiveLTL.subformulaClosure_release_state_satisfies_of_macroRun_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).MacroRun initialStates word)
    (state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State)
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.release φ ψ)
    (P : Nat -> Prop)
    (hmem : ∀ n, P n -> state ∈ run.states n)
    (hnextRecurrent :
      ∀ n, P n -> run.states (n + 1) ∈ witness.macroStates)
    (hrecurrent :
      ∀ targetStates,
        targetStates ∈ witness.macroStates ->
          ∀ j : Nat,
            targetStates ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun initialStates word j ->
              ∀ nextState, nextState ∈ targetStates ->
                nextState.1.size < (PositiveLTL.release φ ψ).size ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word j) nextState.1)
    (hcontinue :
      ∀ n, P n -> state ∈ run.states (n + 1) -> P (n + 1)) :
    ∀ n,
      P n ->
        PositiveLTL.Satisfies interp (OmegaWord.drop word n) state.1 := by
  exact
    PositiveLTL.subformulaClosure_release_state_satisfies_of_macroRun_smaller_coinduction
      root interp interpDecidable
      (initialStates := initialStates)
      word run state hstate P hmem
      (by
        intro n hn nextState hnextState hnextSize
        exact
          hrecurrent (run.states (n + 1)) (hnextRecurrent n hn) (n + 1)
            (run.next_states_mem_macroConfigurationRun n)
            nextState hnextState hnextSize)
      hcontinue

/--
Release anchor from a coherent recurrent macro-run tail.

This is the release case needed by the root-bound recurrent invariant once the
remaining construction supplies a coherent continuation through selected
recurrent macro-states.  Starting at an anchor index `j`, the predicate for
coinduction says that the same release state is present in the macro-run at a
later suffix.  The tail-recurrence hypothesis lets the recurrent invariant
prove all strictly smaller formulas in the next frontier, while release
coinduction handles the guarded self-continuation.
-/
theorem PositiveLTL.subformulaClosure_release_state_satisfies_of_coherent_recurrent_tail
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).MacroRun initialStates word)
    (state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State)
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.release φ ψ)
    {j : Nat}
    (hstateMem : state ∈ run.states j)
    (htailRecurrent :
      ∀ n, j < n -> run.states n ∈ witness.macroStates)
    (hrecurrent :
      ∀ targetStates,
        targetStates ∈ witness.macroStates ->
          ∀ j : Nat,
            targetStates ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun initialStates word j ->
              ∀ nextState, nextState ∈ targetStates ->
                nextState.1.size < (PositiveLTL.release φ ψ).size ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word j) nextState.1) :
    PositiveLTL.Satisfies interp (OmegaWord.drop word j) state.1 := by
  let P : Nat -> Prop := fun n => j ≤ n ∧ state ∈ run.states n
  have hsatisfies :
      ∀ n,
        P n ->
          PositiveLTL.Satisfies interp (OmegaWord.drop word n) state.1 :=
    PositiveLTL.subformulaClosure_release_state_satisfies_of_macroRun_recurrent_invariant
      root interp interpDecidable
      (initialStates := initialStates)
      (word := word)
      witness run state hstate P
      (by
        intro n hn
        exact hn.2)
      (by
        intro n hn
        exact htailRecurrent (n + 1) (Nat.lt_of_le_of_lt hn.1 (Nat.lt_succ_self n)))
      hrecurrent
      (by
        intro n hn hnext
        exact ⟨Nat.le_trans hn.1 (Nat.le_succ n), hnext⟩)
  exact hsatisfies j ⟨le_rfl, hstateMem⟩

/--
Release anchor from the finite infinity set of a concrete macro-run.

Every macro-run is eventually inside its own finite `infStateFinset`.  Hence,
for release states, it is enough to prove the recurrent smaller-formula
invariant on that infinity set: after the finite entry time, release
coinduction applies automatically along any suffix where the release state is
present.
-/
theorem PositiveLTL.subformulaClosure_release_state_satisfies_eventually_of_macroRun_infState_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).MacroRun initialStates word)
    (state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State)
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.release φ ψ)
    (hrecurrent :
      ∀ targetStates,
        targetStates ∈ run.infStateFinset ->
          ∀ j : Nat,
            targetStates ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun initialStates word j ->
              ∀ nextState, nextState ∈ targetStates ->
                nextState.1.size < (PositiveLTL.release φ ψ).size ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word j) nextState.1) :
    ∃ N : Nat,
      ∀ j : Nat,
        N ≤ j ->
          state ∈ run.states j ->
            PositiveLTL.Satisfies interp (OmegaWord.drop word j) state.1 := by
  rcases run.eventually_mem_infStateFinset with ⟨N, htail⟩
  refine ⟨N, ?_⟩
  intro j hj hstateMem
  let P : Nat -> Prop := fun n => j ≤ n ∧ state ∈ run.states n
  have hsatisfies :
      ∀ n,
        P n ->
          PositiveLTL.Satisfies interp (OmegaWord.drop word n) state.1 :=
    PositiveLTL.subformulaClosure_release_state_satisfies_of_macroRun_smaller_coinduction
      root interp interpDecidable
      (initialStates := initialStates)
      word run state hstate P
      (by
        intro n hn
        exact hn.2)
      (by
        intro n hn nextState hnextState hnextSize
        exact
          hrecurrent (run.states (n + 1))
            (htail (n + 1)
              (Nat.le_trans hj
                (Nat.le_trans hn.1 (Nat.le_succ n))))
            (n + 1)
            (run.next_states_mem_macroConfigurationRun n)
            nextState hnextState hnextSize)
      (by
        intro n hn hnext
        exact ⟨Nat.le_trans hn.1 (Nat.le_succ n), hnext⟩)
  exact hsatisfies j ⟨le_rfl, hstateMem⟩

/--
Edge-witnessed macro-run form of the finite-infinity-set release anchor.

The accepting-run infrastructure in the automata backend carries an
`EdgeWitnessedMacroRun`; the coherent macro-run needed by release coinduction
is its underlying `toMacroRun`.  This wrapper keeps the next soundness
invariant stated at the same carrier as the parity-recurring edge evidence.
-/
theorem PositiveLTL.subformulaClosure_release_state_satisfies_eventually_of_edgeWitnessedMacroRun_infState_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun initialStates word)
    (state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State)
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.release φ ψ)
    (hrecurrent :
      ∀ targetStates,
        targetStates ∈ run.toMacroRun.infStateFinset ->
          ∀ j : Nat,
            targetStates ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun initialStates word j ->
              ∀ nextState, nextState ∈ targetStates ->
                nextState.1.size < (PositiveLTL.release φ ψ).size ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word j) nextState.1) :
    ∃ N : Nat,
      ∀ j : Nat,
        N ≤ j ->
          state ∈ run.toMacroRun.states j ->
            PositiveLTL.Satisfies interp (OmegaWord.drop word j) state.1 := by
  exact
    PositiveLTL.subformulaClosure_release_state_satisfies_eventually_of_macroRun_infState_recurrent_invariant
      root interp interpDecidable run.toMacroRun state hstate hrecurrent

/--
Release anchor for an edge-witnessed macro-run using only the actual recurring
macro-states of that run.

This is the form needed by the concrete-run size induction: after the finite
entry time into `toMacroRun.infStateFinset`, each coinductive release step only
uses the next actual macro-state `run.toMacroRun.states (n + 1)`.
-/
theorem PositiveLTL.subformulaClosure_release_state_satisfies_eventually_of_edgeWitnessedMacroRun_infState_run_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun initialStates word)
    (state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State)
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.release φ ψ)
    (hrecurrent :
      ∀ j : Nat,
        run.toMacroRun.states j ∈ run.toMacroRun.infStateFinset ->
          ∀ nextState, nextState ∈ run.toMacroRun.states j ->
            nextState.1.size < (PositiveLTL.release φ ψ).size ->
              PositiveLTL.Satisfies interp
                (OmegaWord.drop word j) nextState.1) :
    ∃ N : Nat,
      ∀ j : Nat,
        N ≤ j ->
          state ∈ run.toMacroRun.states j ->
            PositiveLTL.Satisfies interp (OmegaWord.drop word j) state.1 := by
  rcases run.toMacroRun.eventually_mem_infStateFinset with ⟨N, htail⟩
  refine ⟨N, ?_⟩
  intro j hj hstateMem
  let P : Nat -> Prop := fun n => j ≤ n ∧ state ∈ run.toMacroRun.states n
  have hsatisfies :
      ∀ n,
        P n ->
          PositiveLTL.Satisfies interp (OmegaWord.drop word n) state.1 :=
    PositiveLTL.subformulaClosure_release_state_satisfies_of_macroRun_smaller_coinduction
      root interp interpDecidable
      (initialStates := initialStates)
      word run.toMacroRun state hstate P
      (by
        intro n hn
        exact hn.2)
      (by
        intro n hn nextState hnextState hnextSize
        exact
          hrecurrent (n + 1)
            (htail (n + 1)
              (Nat.le_trans hj
                (Nat.le_trans hn.1 (Nat.le_succ n))))
            nextState hnextState hnextSize)
      (by
        intro n hn hnext
        exact ⟨Nat.le_trans hn.1 (Nat.le_succ n), hnext⟩)
  exact hsatisfies j ⟨le_rfl, hstateMem⟩

/--
Fixed-state eventual semantic invariant for an accepting edge-witnessed
macro-run.

This is the per-state induction step for the final recurring-frontier
argument.  If all strictly smaller formulas in recurrent actual macro-states
are already true, then this state is eventually true at every recurrent
occurrence.  The proof splits into the three local cases:

* `until`: selected self-continuation is ruled out by accepting recurring-edge
  parity;
* `release`: handled by suffix coinduction over the coherent macro-run tail;
* all other formulas: the tableau step has no self atom, so one-step
  back-propagation only uses strictly smaller target formulas.
-/
theorem PositiveLTL.subformulaClosure_state_satisfies_eventually_of_edgeWitnessedMacroRun_infState_run_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun initialStates word)
    (haccepting :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportWitnessStateEdgesAccepting
          run.infStateEdgeFinset)
    (state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State)
    (hrecurrent :
      ∀ k : Nat,
        run.toMacroRun.states k ∈ run.toMacroRun.infStateFinset ->
          ∀ nextState, nextState ∈ run.toMacroRun.states k ->
            nextState.1.size < state.1.size ->
              PositiveLTL.Satisfies interp
                (OmegaWord.drop word k) nextState.1) :
    ∃ N : Nat,
      ∀ j : Nat,
        N ≤ j ->
          state ∈ run.toMacroRun.states j ->
            PositiveLTL.Satisfies interp (OmegaWord.drop word j) state.1 := by
  have hNoSelfCase :
      (∀ φ ψ : PositiveLTL AP, state.1 ≠ PositiveLTL.until φ ψ) ->
      (∀ φ ψ : PositiveLTL AP, state.1 ≠ PositiveLTL.release φ ψ) ->
        ∃ N : Nat,
          ∀ j : Nat,
            N ≤ j ->
              state ∈ run.toMacroRun.states j ->
                PositiveLTL.Satisfies interp
                  (OmegaWord.drop word j) state.1 := by
    intro hnotUntil hnotRelease
    rcases run.toMacroRun.eventually_mem_infStateFinset with ⟨N, htail⟩
    refine ⟨N, ?_⟩
    intro j hj hstateMem
    exact
      PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_step_satisfies_of_next_infState_run_invariant_no_self_atom
        root interp interpDecidable run
        (j := j)
        (hnextInf := htail (j + 1) (by omega))
        hstateMem
        (PositiveLTL.subformulaClosure_step_no_self_atom_of_not_until_or_release
          root interp interpDecidable state ((OmegaWord.drop word j) 0)
          hnotUntil hnotRelease)
        hrecurrent
  cases hstateFormula : state.1 with
  | verum =>
      rcases hNoSelfCase
        (by
          intro φ ψ hbad
          rw [hstateFormula] at hbad
          cases hbad)
        (by
          intro φ ψ hbad
          rw [hstateFormula] at hbad
          cases hbad) with
        ⟨N, htail⟩
      refine ⟨N, ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using htail j hj hstateMem
  | falsum =>
      rcases hNoSelfCase
        (by
          intro φ ψ hbad
          rw [hstateFormula] at hbad
          cases hbad)
        (by
          intro φ ψ hbad
          rw [hstateFormula] at hbad
          cases hbad) with
        ⟨N, htail⟩
      refine ⟨N, ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using htail j hj hstateMem
  | lit literal =>
      rcases hNoSelfCase
        (by
          intro φ ψ hbad
          rw [hstateFormula] at hbad
          cases hbad)
        (by
          intro φ ψ hbad
          rw [hstateFormula] at hbad
          cases hbad) with
        ⟨N, htail⟩
      refine ⟨N, ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using htail j hj hstateMem
  | conj φ ψ =>
      rcases hNoSelfCase
        (by
          intro θ χ hbad
          rw [hstateFormula] at hbad
          cases hbad)
        (by
          intro θ χ hbad
          rw [hstateFormula] at hbad
          cases hbad) with
        ⟨N, htail⟩
      refine ⟨N, ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using htail j hj hstateMem
  | disj φ ψ =>
      rcases hNoSelfCase
        (by
          intro θ χ hbad
          rw [hstateFormula] at hbad
          cases hbad)
        (by
          intro θ χ hbad
          rw [hstateFormula] at hbad
          cases hbad) with
        ⟨N, htail⟩
      refine ⟨N, ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using htail j hj hstateMem
  | next φ =>
      rcases hNoSelfCase
        (by
          intro θ χ hbad
          rw [hstateFormula] at hbad
          cases hbad)
        (by
          intro θ χ hbad
          rw [hstateFormula] at hbad
          cases hbad) with
        ⟨N, htail⟩
      refine ⟨N, ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using htail j hj hstateMem
  | «until» φ ψ =>
      rcases
        PositiveLTL.subformulaClosure_until_state_satisfies_eventually_of_edgeWitnessedMacroRun_infState_run_invariant
          root interp interpDecidable run haccepting
          (φ := φ)
          (ψ := ψ)
          (by
            intro k hInf nextState hnextState hnextSize
            exact
              hrecurrent k hInf nextState hnextState
                (by simpa [hstateFormula] using hnextSize)) with
        ⟨N, htail⟩
      refine ⟨N, ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using htail j hj state hstateMem hstateFormula
  | «release» φ ψ =>
      rcases
        PositiveLTL.subformulaClosure_release_state_satisfies_eventually_of_edgeWitnessedMacroRun_infState_run_invariant
          root interp interpDecidable run state hstateFormula
          (by
            intro k hInf nextState hnextState hnextSize
            exact
              hrecurrent k hInf nextState hnextState
                (by simpa [hstateFormula] using hnextSize)) with
        ⟨N, htail⟩
      refine ⟨N, ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using htail j hj hstateMem

/--
Cutoff-aware fixed-state eventual semantic invariant.

This is the form needed by the finite size induction: if the strictly smaller
formulas are known only after some cutoff, the fixed state is still true after
a larger cutoff.  The proof repeats the same local case split as
`subformulaClosure_state_satisfies_eventually_of_edgeWitnessedMacroRun_infState_run_invariant`,
but threads the cutoff through the one-step and release-coinduction calls.
-/
theorem PositiveLTL.subformulaClosure_state_satisfies_eventually_of_edgeWitnessedMacroRun_eventual_infState_run_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun initialStates word)
    (haccepting :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportWitnessStateEdgesAccepting
          run.infStateEdgeFinset)
    (state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State)
    (heventualSmaller :
      ∃ Nsmall : Nat,
        ∀ k : Nat,
          Nsmall ≤ k ->
            run.toMacroRun.states k ∈ run.toMacroRun.infStateFinset ->
              ∀ nextState, nextState ∈ run.toMacroRun.states k ->
                nextState.1.size < state.1.size ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word k) nextState.1) :
    ∃ N : Nat,
      ∀ j : Nat,
        N ≤ j ->
          state ∈ run.toMacroRun.states j ->
            PositiveLTL.Satisfies interp (OmegaWord.drop word j) state.1 := by
  rcases heventualSmaller with ⟨Nsmall, hsmall⟩
  have hNoSelfCase :
      (∀ φ ψ : PositiveLTL AP, state.1 ≠ PositiveLTL.until φ ψ) ->
      (∀ φ ψ : PositiveLTL AP, state.1 ≠ PositiveLTL.release φ ψ) ->
        ∃ N : Nat,
          ∀ j : Nat,
            N ≤ j ->
              state ∈ run.toMacroRun.states j ->
                PositiveLTL.Satisfies interp
                  (OmegaWord.drop word j) state.1 := by
    intro hnotUntil hnotRelease
    rcases run.toMacroRun.eventually_mem_infStateFinset with ⟨Ninf, htail⟩
    refine ⟨max Nsmall Ninf, ?_⟩
    intro j hj hstateMem
    have htransition :
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).MacroTransitionWithStateEdges
            (run.toMacroRun.states j)
            ((OmegaWord.drop word j) 0)
            (run.toMacroRun.states (j + 1))
            (run.stateEdges j) := by
      simpa [OmegaWord.drop] using run.step_stateEdges_transition j
    exact
      PositiveLTL.subformulaClosure_satisfies_of_macroTransition_next_of_no_self_atom
        root interp interpDecidable
        (OmegaWord.drop word j)
        htransition
        hstateMem
        (PositiveLTL.subformulaClosure_step_no_self_atom_of_not_until_or_release
          root interp interpDecidable state ((OmegaWord.drop word j) 0)
          hnotUntil hnotRelease)
        (by
          intro nextState hnextState hnextSize
          simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
            Nat.add_assoc] using
            hsmall (j + 1)
              (Nat.le_trans (Nat.le_max_left Nsmall Ninf) (by omega))
              (htail (j + 1)
                (Nat.le_trans (Nat.le_max_right Nsmall Ninf) (by omega)))
              nextState hnextState hnextSize)
  cases hstateFormula : state.1 with
  | verum =>
      rcases hNoSelfCase
        (by
          intro φ ψ hbad
          rw [hstateFormula] at hbad
          cases hbad)
        (by
          intro φ ψ hbad
          rw [hstateFormula] at hbad
          cases hbad) with
        ⟨N, htail⟩
      refine ⟨N, ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using htail j hj hstateMem
  | falsum =>
      rcases hNoSelfCase
        (by
          intro φ ψ hbad
          rw [hstateFormula] at hbad
          cases hbad)
        (by
          intro φ ψ hbad
          rw [hstateFormula] at hbad
          cases hbad) with
        ⟨N, htail⟩
      refine ⟨N, ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using htail j hj hstateMem
  | lit literal =>
      rcases hNoSelfCase
        (by
          intro φ ψ hbad
          rw [hstateFormula] at hbad
          cases hbad)
        (by
          intro φ ψ hbad
          rw [hstateFormula] at hbad
          cases hbad) with
        ⟨N, htail⟩
      refine ⟨N, ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using htail j hj hstateMem
  | conj φ ψ =>
      rcases hNoSelfCase
        (by
          intro θ χ hbad
          rw [hstateFormula] at hbad
          cases hbad)
        (by
          intro θ χ hbad
          rw [hstateFormula] at hbad
          cases hbad) with
        ⟨N, htail⟩
      refine ⟨N, ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using htail j hj hstateMem
  | disj φ ψ =>
      rcases hNoSelfCase
        (by
          intro θ χ hbad
          rw [hstateFormula] at hbad
          cases hbad)
        (by
          intro θ χ hbad
          rw [hstateFormula] at hbad
          cases hbad) with
        ⟨N, htail⟩
      refine ⟨N, ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using htail j hj hstateMem
  | next φ =>
      rcases hNoSelfCase
        (by
          intro θ χ hbad
          rw [hstateFormula] at hbad
          cases hbad)
        (by
          intro θ χ hbad
          rw [hstateFormula] at hbad
          cases hbad) with
        ⟨N, htail⟩
      refine ⟨N, ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using htail j hj hstateMem
  | «until» φ ψ =>
      rcases run.eventually_stateEdges_subset_infStateEdgeFinset with
        ⟨Nedges, hedgeTail⟩
      rcases run.toMacroRun.eventually_mem_infStateFinset with
        ⟨Ninf, hInfTail⟩
      refine ⟨max Nsmall (max Nedges Ninf), ?_⟩
      intro j hj hstateMem
      simpa [hstateFormula] using
        PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_until_step_satisfies_of_next_run_invariant
          root interp interpDecidable run haccepting
          (j := j)
          (hstepEdgesInf :=
            hedgeTail j
              (Nat.le_trans
                (Nat.le_trans
                  (Nat.le_max_left Nedges Ninf)
                  (Nat.le_max_right Nsmall (max Nedges Ninf)))
                hj))
          hstateMem
          hstateFormula
          (by
            intro nextState hnextState hnextSize
            exact
              hsmall (j + 1)
                (Nat.le_trans
                  (Nat.le_max_left Nsmall (max Nedges Ninf)) (by omega))
                (hInfTail (j + 1)
                  (Nat.le_trans
                    (Nat.le_trans
                      (Nat.le_max_right Nedges Ninf)
                      (Nat.le_max_right Nsmall (max Nedges Ninf)))
                    (by omega)))
                nextState hnextState
                (by simpa [hstateFormula] using hnextSize))
  | «release» φ ψ =>
      rcases run.toMacroRun.eventually_mem_infStateFinset with
        ⟨Ninf, hInfTail⟩
      refine ⟨max Nsmall Ninf, ?_⟩
      intro j hj hstateMem
      let P : Nat -> Prop := fun n => j ≤ n ∧ state ∈ run.toMacroRun.states n
      have hsatisfies :
          ∀ n,
            P n ->
              PositiveLTL.Satisfies interp (OmegaWord.drop word n) state.1 :=
        PositiveLTL.subformulaClosure_release_state_satisfies_of_macroRun_smaller_coinduction
          root interp interpDecidable
          (initialStates := initialStates)
          word run.toMacroRun state hstateFormula P
          (by
            intro n hn
            exact hn.2)
          (by
            intro n hn nextState hnextState hnextSize
            exact
              hsmall (n + 1)
                (Nat.le_trans (Nat.le_max_left Nsmall Ninf)
                  (Nat.le_trans hj
                    (Nat.le_trans hn.1 (Nat.le_succ n))))
                (hInfTail (n + 1)
                  (Nat.le_trans (Nat.le_max_right Nsmall Ninf)
                    (Nat.le_trans hj
                      (Nat.le_trans hn.1 (Nat.le_succ n)))))
                nextState hnextState
                (by simpa [hstateFormula] using hnextSize))
          (by
            intro n hn hnext
            exact ⟨Nat.le_trans hn.1 (Nat.le_succ n), hnext⟩)
      simpa [hstateFormula] using hsatisfies j ⟨le_rfl, hstateMem⟩

/--
Uniform eventual semantic invariant below a size bound.

The preceding theorem gives one cutoff for one fixed subformula state.  This
theorem performs the global size induction and takes the finite maximum over
the canonical subformula state space, producing the single cutoff needed by the
prefix-extraction wrappers.
-/
theorem PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_eventual_bound_infState_run_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun initialStates word)
    (haccepting :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportWitnessStateEdgesAccepting
          run.infStateEdgeFinset) :
    ∀ bound : Nat,
      ∃ N : Nat,
        ∀ j : Nat,
          N ≤ j ->
            run.toMacroRun.states j ∈ run.toMacroRun.infStateFinset ->
              ∀ nextState, nextState ∈ run.toMacroRun.states j ->
                nextState.1.size < bound ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word j) nextState.1 := by
  intro bound
  induction bound with
  | zero =>
      refine ⟨0, ?_⟩
      intro j _hj _hInf nextState _hnextState hsize
      omega
  | succ bound ih =>
      rcases ih with ⟨Nsmall, hsmall⟩
      let A :=
        (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable
      have hstateEventual :
          ∀ state : A.State,
            ∃ N : Nat,
              ∀ j : Nat,
                N ≤ j ->
                  state.1.size = bound ->
                    state ∈ run.toMacroRun.states j ->
                      PositiveLTL.Satisfies interp
                        (OmegaWord.drop word j) state.1 := by
        intro state
        by_cases hstateSize : state.1.size = bound
        · rcases
            PositiveLTL.subformulaClosure_state_satisfies_eventually_of_edgeWitnessedMacroRun_eventual_infState_run_invariant
              root interp interpDecidable run haccepting state
              ⟨Nsmall,
                (by
                  intro k hk hInf nextState hnextState hnextSize
                  exact
                    hsmall k hk hInf nextState hnextState
                      (by simpa [hstateSize] using hnextSize))⟩ with
            ⟨Nstate, hNstate⟩
          refine ⟨Nstate, ?_⟩
          intro j hj _hsize hstateMem
          exact hNstate j hj hstateMem
        · refine ⟨0, ?_⟩
          intro j _hj hsize _hstateMem
          exact False.elim (hstateSize hsize)
      haveI : DecidableEq A.State := Classical.decEq A.State
      rcases
        exists_uniform_eventual_of_fintype
          (fun state : A.State =>
            fun j =>
              state.1.size = bound ->
                state ∈ run.toMacroRun.states j ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word j) state.1)
          hstateEventual with
        ⟨Nlevel, hNlevel⟩
      refine ⟨max Nsmall Nlevel, ?_⟩
      intro j hj hInf nextState hnextState hnextSize
      have hsizeLe : nextState.1.size ≤ bound := Nat.le_of_lt_succ hnextSize
      by_cases hlt : nextState.1.size < bound
      · exact
          hsmall j
            (Nat.le_trans (Nat.le_max_left Nsmall Nlevel) hj)
            hInf nextState hnextState hlt
      · have hsizeEq : nextState.1.size = bound := by omega
        exact
          hNlevel j
            (Nat.le_trans (Nat.le_max_right Nsmall Nlevel) hj)
            nextState hsizeEq hnextState

/--
Root-bound form of the uniform eventual invariant for canonical subformula
states.
-/
theorem PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_eventual_rootBound_infState_run_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun initialStates word)
    (haccepting :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportWitnessStateEdgesAccepting
          run.infStateEdgeFinset) :
    ∃ N : Nat,
      ∀ j : Nat,
        N ≤ j ->
          run.toMacroRun.states j ∈ run.toMacroRun.infStateFinset ->
            ∀ nextState, nextState ∈ run.toMacroRun.states j ->
              nextState.1.size < root.size + 1 ->
                PositiveLTL.Satisfies interp
                  (OmegaWord.drop word j) nextState.1 :=
  PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_eventual_bound_infState_run_invariant
    root interp interpDecidable run haccepting (root.size + 1)

/--
Concrete recurring-frontier extraction from an edge-witnessed macro-run.

If all states in the recurring macro-states of the underlying macro-run are
semantically true whenever those macro-states occur, then one such recurring
frontier gives the prefix-satisfaction endpoint required by the canonical
support-witness soundness route.
-/
theorem PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_prefixSatisfies_of_infState_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialState :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun
          ({initialState} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))
          word)
    (hrecurrent :
      ∀ targetStates,
        targetStates ∈ run.toMacroRun.infStateFinset ->
          ∀ j : Nat,
            targetStates ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun
                  ({initialState} : Finset
                    (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                      interp interpDecidable).State))
                  word j ->
              ∀ nextState, nextState ∈ targetStates ->
                PositiveLTL.Satisfies interp
                  (OmegaWord.drop word j) nextState.1) :
    ∃ offset : Nat,
      ∃ pref :
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).MacroRunPrefix
            ({initialState} : Finset
              (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).State))
            word offset,
        ∀ nextState, nextState ∈ pref.states offset ->
          PositiveLTL.Satisfies interp
            (OmegaWord.drop word offset) nextState.1 := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases run.toMacroRun.infStateFinset_nonempty with
    ⟨targetStates, htargetInf⟩
  have hseen :
      run.toMacroRun.StateSeenInfinitelyOften targetStates :=
    (run.toMacroRun.mem_infStateFinset targetStates).mp htargetInf
  rcases hseen 0 with ⟨offset, _hoffset, hoffsetStates⟩
  refine ⟨offset, run.toMacroRun.prefix offset, ?_⟩
  intro nextState hnextState
  have htargetConfig :
      targetStates ∈
        A.macroConfigurationRun
          ({initialState} : Finset A.State) word offset := by
    simpa [A, hoffsetStates] using
      run.toMacroRun.states_mem_macroConfigurationRun offset
  have hnextTarget : nextState ∈ targetStates := by
    simpa [A, AlternatingParityAutomaton.MacroRun.prefix_states,
      hoffsetStates] using hnextState
  exact
    hrecurrent targetStates htargetInf offset htargetConfig
      nextState hnextTarget

