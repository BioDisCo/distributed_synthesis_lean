/--
Proof-facing eventual-release/local-edge target for pruned guided support
graphs.

For each selected support-graph path, this target provides an active base node,
a finite prefix of node-local edge realizations, and then an eventual stable
release self-loop that is node-locally realized at every matching suffix.  The
bridge below turns exactly this data into
`SubformulaClosurePrunedGuidedRunSubgraphTailCoherent`.
-/
def PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphEventualReleaseLocalEdges
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter)) :
    Prop :=
  ∀ (state : root.Subformula) (word : OmegaWord Letter),
    ∀ hsat : PositiveLTL.Satisfies interp word state.1,
      ∃ run :
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial state).EdgeWitnessedMacroRun
          ({(((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp dec).withInitial state).initial} :
            Finset (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial state).State)
          word,
        ∃ acceptedEdges :
          Finset (APAStateEdge
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp dec).withInitial state)),
          run.infStateEdgeFinset ⊆ acceptedEdges ∧
            ∀ path :
              Nat ->
                (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                  interp dec).withInitial state).State,
              (∀ n : Nat, (path n, path (n + 1)) ∈ acceptedEdges) ->
                ∃ node : AlternatingParityAutomaton.Node,
                  ∃ hpathNode :
                    (PositiveLTL.subformulaClosure_guidedRunFrom
                      root interp dec word state hsat).PathActive node,
                    (PositiveLTL.subformulaClosure_guidedRunFrom
                      root interp dec word state hsat).stateAt node =
                      path 0 ∧
                      ∃ N : Nat,
                        ∃ releaseState : root.Subformula,
                          ∃ φ ψ : PositiveLTL AP,
                            (∀ n : Nat, N ≤ n -> path n = releaseState) ∧
                              releaseState.1 = PositiveLTL.release φ ψ ∧
                                (∀ suffix : AlternatingParityAutomaton.Node,
                                  (PositiveLTL.subformulaClosure_guidedRunFrom
                                    root interp dec word state hsat).PathActive
                                      (suffix ++ node) ->
                                  (PositiveLTL.subformulaClosure_guidedRunFrom
                                    root interp dec word state hsat).stateAt
                                      (suffix ++ node) = path suffix.length ->
                                  suffix.length < N ->
                                    (PositiveLTL.subformulaClosure_guidedRunFrom
                                      root interp dec word state hsat).PathActive
                                        (suffix ++ node) ∧
                                      (PositiveLTL.subformulaClosure_guidedRunFrom
                                        root interp dec word state hsat).stateAt
                                          (suffix ++ node) =
                                        path suffix.length ∧
                                        ∃ child : Nat,
                                          (PositiveLTL.subformulaClosure_guidedRunFrom
                                            root interp dec word state hsat).active
                                              (child :: suffix ++ node) ∧
                                            (PositiveLTL.subformulaClosure_guidedRunFrom
                                              root interp dec word state hsat).stateAt
                                                (child :: suffix ++ node) =
                                              path (suffix.length + 1)) ∧
                                  ∀ suffix : AlternatingParityAutomaton.Node,
                                    (PositiveLTL.subformulaClosure_guidedRunFrom
                                      root interp dec word state hsat).PathActive
                                        (suffix ++ node) ->
                                    (PositiveLTL.subformulaClosure_guidedRunFrom
                                      root interp dec word state hsat).stateAt
                                        (suffix ++ node) = releaseState ->
                                    N ≤ suffix.length ->
                                      (PositiveLTL.subformulaClosure_guidedRunFrom
                                        root interp dec word state hsat).PathActive
                                          (suffix ++ node) ∧
                                        (PositiveLTL.subformulaClosure_guidedRunFrom
                                          root interp dec word state hsat).stateAt
                                            (suffix ++ node) = releaseState ∧
                                          ∃ child : Nat,
                                            (PositiveLTL.subformulaClosure_guidedRunFrom
                                              root interp dec word state hsat).active
                                                (child :: suffix ++ node) ∧
                                              (PositiveLTL.subformulaClosure_guidedRunFrom
                                                root interp dec word state hsat).stateAt
                                                (child :: suffix ++ node) =
                                                releaseState

