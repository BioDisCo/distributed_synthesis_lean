/--
Size-one recurrent macro-state progress soundness.  This is the macro-state
frontier analogue of
`subformulaClosure_supportWitnessMuller_size_one_accepts_satisfies`.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_macroState_size_one_progress_satisfies
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {states :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    (hstates : states ∈ witness.macroStates)
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    (hstateMem : state ∈ states)
    (hsize : state.1.size = 1) :
    ∀ n : Nat,
      ∃ k : Nat,
        ∃ pref :
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).MacroRunPrefix initialStates word (k + 1),
          n ≤ k ∧
            pref.states k = states ∧
            PositiveLTL.Satisfies interp
              (OmegaWord.drop word k) state.1 := by
  rcases state with ⟨formula, hformula⟩
  cases formula with
  | verum =>
      exact
        PositiveLTL.subformulaClosure_supportWitness_macroState_verum_progress_satisfies
          root interp interpDecidable witness hstates hstateMem rfl
  | falsum =>
      exact
        PositiveLTL.subformulaClosure_supportWitness_macroState_falsum_progress_satisfies
          root interp interpDecidable witness hstates hstateMem rfl
  | lit literal =>
      exact
        PositiveLTL.subformulaClosure_supportWitness_macroState_lit_progress_satisfies
          root interp interpDecidable witness hstates hstateMem
          (literal := literal) rfl
  | conj φ ψ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      have hψpos : 0 < ψ.size := PositiveLTL.size_pos ψ
      simp [PositiveLTL.size] at hsize
      omega
  | disj φ ψ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      have hψpos : 0 < ψ.size := PositiveLTL.size_pos ψ
      simp [PositiveLTL.size] at hsize
      omega
  | next φ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      simp [PositiveLTL.size] at hsize
      omega
  | «until» φ ψ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      have hψpos : 0 < ψ.size := PositiveLTL.size_pos ψ
      simp [PositiveLTL.size] at hsize
      omega
  | «release» φ ψ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      have hψpos : 0 < ψ.size := PositiveLTL.size_pos ψ
      simp [PositiveLTL.size] at hsize
      omega

/--
Common-prefix size-one recurrent frontier soundness.

The point of this form is that the whole source macro-state is discharged at
one concrete progress occurrence.  It supplies the base case for a
frontier-level induction without choosing a different late prefix for each
state.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_macroState_size_one_progress_frontier_satisfies
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {states :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    (hstates : states ∈ witness.macroStates)
    (hsize : ∀ state, state ∈ states -> state.1.size = 1) :
    ∀ n : Nat,
      ∃ k : Nat,
        ∃ pref :
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).MacroRunPrefix initialStates word (k + 1),
          n ≤ k ∧
            pref.states k = states ∧
            ∀ state, state ∈ states ->
              PositiveLTL.Satisfies interp
                (OmegaWord.drop word k) state.1 := by
  intro n
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases witness.exists_progress_edge_prefixes hstates with
    ⟨edge, _hedge, hsource, _htargetState, hprefixes⟩
  rcases hprefixes n with
    ⟨k, pref, hle, hprefSource, _hprefTarget⟩
  have hmacro :
      A.MacroTransition (pref.states k) (word k) (pref.states (k + 1)) :=
    pref.step_transition k (Nat.lt_succ_self k)
  rcases A.exists_stateEdges_of_macroTransition hmacro with
    ⟨stateEdges, htransition⟩
  refine ⟨k, pref, hle, by simpa [hsource] using hprefSource, ?_⟩
  intro state hstateMem
  have hstateAtPrefix : state ∈ pref.states k := by
    simpa [hprefSource, hsource] using hstateMem
  have hstateSize : state.1.size = 1 := hsize state hstateMem
  rcases state with ⟨formula, hformula⟩
  cases formula with
  | verum =>
      simpa [PositiveLTL.Satisfies]
  | falsum =>
      simpa [A, OmegaWord.drop] using
        PositiveLTL.subformulaClosure_macroTransition_falsum_satisfies
          root interp interpDecidable
          (OmegaWord.drop word k)
          (states := pref.states k)
          (nextStates := pref.states (k + 1))
          (stateEdges := stateEdges)
          htransition
          hstateAtPrefix
          rfl
  | lit literal =>
      simpa [A, OmegaWord.drop] using
        PositiveLTL.subformulaClosure_macroTransition_lit_satisfies
          root interp interpDecidable
          (OmegaWord.drop word k)
          (states := pref.states k)
          (nextStates := pref.states (k + 1))
          (stateEdges := stateEdges)
          htransition
          hstateAtPrefix
          (literal := literal)
          rfl
  | conj φ ψ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      have hψpos : 0 < ψ.size := PositiveLTL.size_pos ψ
      simp [PositiveLTL.size] at hstateSize
      omega
  | disj φ ψ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      have hψpos : 0 < ψ.size := PositiveLTL.size_pos ψ
      simp [PositiveLTL.size] at hstateSize
      omega
  | next φ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      simp [PositiveLTL.size] at hstateSize
      omega
  | «until» φ ψ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      have hψpos : 0 < ψ.size := PositiveLTL.size_pos ψ
      simp [PositiveLTL.size] at hstateSize
      omega
  | «release» φ ψ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      have hψpos : 0 < ψ.size := PositiveLTL.size_pos ψ
      simp [PositiveLTL.size] at hstateSize
      omega

/--
Recurring-frontier hook for the canonical `prefixSatisfies` obligation.

The hard anchor proof is expected to produce a selected recurring macro-state
whose concrete occurrences have satisfying formula frontiers.  This theorem is
the exact handoff from that anchor to the finite-prefix interface used by
`subformulaClosure_supportWitnessPrefixAccepts_of_prefixSatisfies`.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessMuller_prefixSatisfies_of_recurring_frontier
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    (haccepts :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).supportWitnessMuller
          ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))).Accepts word)
    (hfrontier :
      ∃ states,
        states ∈
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).supportOperationalWitness_of_supportWitnessMuller_accepts
              (initialStates := ({state} : Finset
                (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                  interp interpDecidable).State)))
              haccepts).macroStates ∧
          ∀ n : Nat,
            ∃ k : Nat,
              ∃ pref :
                ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                  interp interpDecidable).MacroRunPrefix ({state} : Finset
                    (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                      interp interpDecidable).State)) word k,
                n ≤ k ∧
                  pref.states k = states ∧
                    ∀ nextState, nextState ∈ states ->
                      PositiveLTL.Satisfies interp
                        (OmegaWord.drop word k) nextState.1) :
    ∃ offset : Nat,
      ∃ pref :
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).MacroRunPrefix ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State)) word offset,
        ∀ nextState, nextState ∈ pref.states offset ->
          PositiveLTL.Satisfies interp
            (OmegaWord.drop word offset) nextState.1 := by
  rcases hfrontier with ⟨states, _hstates, hoccurs⟩
  rcases hoccurs 0 with
    ⟨k, pref, _hle, hprefStates, hsat⟩
  refine ⟨k, pref, ?_⟩
  intro nextState hnextState
  exact hsat nextState (by simpa [hprefStates] using hnextState)

/--
One-step recurring-frontier hook.

If a selected recurring macro-state has arbitrarily late concrete progress
occurrences whose target frontiers satisfy their formulas, then the source
frontier at such an occurrence also satisfies.  Thus it already supplies the
finite `prefixSatisfies` endpoint required by the support-witness route.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessMuller_prefixSatisfies_of_progress_target_frontier
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    (haccepts :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).supportWitnessMuller
          ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))).Accepts word)
    (hfrontier :
      ∃ states,
        states ∈
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).supportOperationalWitness_of_supportWitnessMuller_accepts
              (initialStates := ({state} : Finset
                (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                  interp interpDecidable).State)))
              haccepts).macroStates ∧
          ∀ n : Nat,
            ∃ k : Nat,
              ∃ pref :
                ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                  interp interpDecidable).MacroRunPrefix ({state} : Finset
                    (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                      interp interpDecidable).State)) word (k + 1),
                n ≤ k ∧
                  pref.states k = states ∧
                    ∀ nextState, nextState ∈ pref.states (k + 1) ->
                      PositiveLTL.Satisfies interp
                        (OmegaWord.drop word (k + 1)) nextState.1) :
    ∃ offset : Nat,
      ∃ pref :
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).MacroRunPrefix ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State)) word offset,
        ∀ nextState, nextState ∈ pref.states offset ->
          PositiveLTL.Satisfies interp
            (OmegaWord.drop word offset) nextState.1 := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases hfrontier with ⟨states, _hstates, hoccurs⟩
