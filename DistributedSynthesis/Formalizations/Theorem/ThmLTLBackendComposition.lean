            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {states targetStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {j : Nat}
    (hstatesConfig :
      states ∈
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).macroConfigurationRun initialStates word j)
    (htransition :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).MacroTransition states (word j) targetStates)
    (htargetStates : targetStates ∈ witness.macroStates)
    (hrecurrent :
      ∀ targetStates,
        targetStates ∈ witness.macroStates ->
          ∀ j : Nat,
            targetStates ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun initialStates word j ->
              ∀ nextState, nextState ∈ targetStates ->
                PositiveLTL.Satisfies interp
                  (OmegaWord.drop word j) nextState.1) :
    ∀ sourceState, sourceState ∈ states ->
      PositiveLTL.Satisfies interp
        (OmegaWord.drop word j) sourceState.1 := by
  intro sourceState hsourceState
  have hbounded :
      ∀ sourceState, sourceState ∈ states ->
        sourceState.1.size < root.size + 1 ->
          PositiveLTL.Satisfies interp
            (OmegaWord.drop word j) sourceState.1 :=
    PositiveLTL.subformulaClosure_macroConfiguration_source_frontier_of_recurrent_invariant
      root interp interpDecidable witness
      (initialStates := initialStates)
      (word := word)
      (states := states)
      (targetStates := targetStates)
      (j := j)
      (bound := root.size + 1)
      hstatesConfig
      htransition
      htargetStates
      (by
        intro targetStates htargetStates j htargetConfig nextState hnextState _hsize
        exact hrecurrent targetStates htargetStates j htargetConfig nextState hnextState)
