/--
Convert the semantic open-release proof-facing target into the local
tail-coherence target consumed by the verified pruned guided-run route.

Compared with `...of_eventualReleaseLocalEdges`, the stable release self-child
is generated by the canonical guided tableau from the open-release condition.
-/
theorem PositiveLTL.subformulaClosure_prunedGuidedRunSubgraphTailCoherent_of_eventualOpenReleaseLocalEdges
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (hlocal :
      PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphEventualOpenReleaseLocalEdges
        root interp dec) :
      PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphTailCoherent
      root interp dec := by
