/--
Combined recurrent macro-state progress soundness for the non-temporal base
formulas of the canonical subformula APA.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_macroState_base_progress_satisfies
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
