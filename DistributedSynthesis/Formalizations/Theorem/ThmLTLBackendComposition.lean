/--
Every recurring support edge of the canonical guided run is formula-size
nonincreasing.  This transfers the concrete guided child invariant through the
edge-witnessed macro-run: an untimed recurring edge is seen at some concrete
active parent/child occurrence, and that occurrence is either a self-formula
step or a strict subformula step.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdge_self_or_size_lt
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    {edge :
      APAStateEdge
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial)}
    (hedge :
      edge ∈
        ((PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word initial hsatInitial).realizedEdgeWitnessedMacroRun
          ).infStateEdgeFinset) :
    edge.2.1 = edge.1.1 ∨ edge.2.1.size < edge.1.1.size := by
  let run :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial
  have hseen :
      run.realizedEdgeWitnessedMacroRun.StateEdgeSeenInfinitelyOften edge :=
    (run.realizedEdgeWitnessedMacroRun.mem_infStateEdgeFinset edge).mp hedge
  rcases hseen 0 with ⟨level, _hlevel, hedgeLevel⟩
  rcases
    run.realizedEdgeWitnessedMacroRun_stateEdges_realized
      level hedgeLevel with
    ⟨node, child, _hlen, hpathNode, hsource, hactiveChild, htarget⟩
  have hactiveParent :
      PositiveLTL.subformulaClosure_guidedRunFromActive
        root interp dec word initial hsatInitial node := by
    simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
      run.pathActive_self node hpathNode
  have hactiveChild' :
      PositiveLTL.subformulaClosure_guidedRunFromActive
        root interp dec word initial hsatInitial (child :: node) := by
    simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
      hactiveChild
  have hmove :=
    PositiveLTL.subformulaClosure_guidedRunFrom_child_self_or_size_lt
      root interp dec word initial hsatInitial node child
      hactiveParent hactiveChild'
  have hsource' :
      PositiveLTL.subformulaClosure_guidedRunFromState
        root interp dec word initial hsatInitial node = edge.1 := by
    simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using hsource
  have htarget' :
      PositiveLTL.subformulaClosure_guidedRunFromState
        root interp dec word initial hsatInitial (child :: node) = edge.2 := by
    simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using htarget
  rcases hmove with hsame | hlt
  · left
    simpa [hsource', htarget'] using hsame
  · right
    simpa [hsource', htarget'] using hlt

/--
If a recurring support edge of the guided run is a same-formula edge, then its
source formula is one of the temporal fixed-point forms.  This is the
recurring-edge version of the local guided self-loop classification.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdge_self_is_until_or_release
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    {edge :
      APAStateEdge
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial)}
    (hedge :
      edge ∈
        ((PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word initial hsatInitial).realizedEdgeWitnessedMacroRun
          ).infStateEdgeFinset)
    (hself : edge.2.1 = edge.1.1) :
    (∃ φ ψ : PositiveLTL AP, edge.1.1 = PositiveLTL.until φ ψ) ∨
      ∃ φ ψ : PositiveLTL AP, edge.1.1 = PositiveLTL.release φ ψ := by
  let run :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial
  have hseen :
      run.realizedEdgeWitnessedMacroRun.StateEdgeSeenInfinitelyOften edge :=
    (run.realizedEdgeWitnessedMacroRun.mem_infStateEdgeFinset edge).mp hedge
  rcases hseen 0 with ⟨level, _hlevel, hedgeLevel⟩
  rcases
    run.realizedEdgeWitnessedMacroRun_stateEdges_realized
      level hedgeLevel with
    ⟨node, child, _hlen, hpathNode, hsource, hactiveChild, htarget⟩
  have hactiveParent :
      PositiveLTL.subformulaClosure_guidedRunFromActive
        root interp dec word initial hsatInitial node := by
    simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
      run.pathActive_self node hpathNode
  have hactiveChild' :
      PositiveLTL.subformulaClosure_guidedRunFromActive
        root interp dec word initial hsatInitial (child :: node) := by
    simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
      hactiveChild
  have hsource' :
      PositiveLTL.subformulaClosure_guidedRunFromState
        root interp dec word initial hsatInitial node = edge.1 := by
    simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using hsource
  have htarget' :
      PositiveLTL.subformulaClosure_guidedRunFromState
        root interp dec word initial hsatInitial (child :: node) = edge.2 := by
    simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using htarget
  have hselfState :
      PositiveLTL.subformulaClosure_guidedRunFromState
        root interp dec word initial hsatInitial (child :: node) =
      PositiveLTL.subformulaClosure_guidedRunFromState
        root interp dec word initial hsatInitial node := by
    apply Subtype.ext
    simpa [hsource', htarget'] using hself
  have htemporal :=
    PositiveLTL.subformulaClosure_guidedRunFrom_child_self_is_until_or_release
      root interp dec word initial hsatInitial node child
      hactiveParent hactiveChild' hselfState
  simpa [hsource'] using htemporal

/--
Any abstract path through the recurring support-edge graph of the guided run
eventually stabilizes in its formula component.  This is the recurring-edge
analogue of the existing concrete-branch stabilization lemma and is shaped
for the remaining tail-coherence proof obligation.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdgePath_eventually_formula_eq
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    (path :
      Nat ->
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial).State)
    (hpath :
      ∀ n : Nat,
        (path n, path (n + 1)) ∈
          ((PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).realizedEdgeWitnessedMacroRun
            ).infStateEdgeFinset) :
    ∃ N : Nat, ∀ n : Nat, N ≤ n -> (path n).1 = (path N).1 := by
  let sizeSeq : Nat -> Nat := fun n => (path n).1.size
  have hsucc_le : ∀ n, sizeSeq (n + 1) ≤ sizeSeq n := by
    intro n
    have hmove :=
      PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdge_self_or_size_lt
        root interp dec word initial hsatInitial (hpath n)
    rcases hmove with hsame | hlt
    · change (path (n + 1)).1.size ≤ (path n).1.size
      rw [hsame]
    · exact Nat.le_of_lt hlt
  rcases nat_eventually_constant_of_succ_le' sizeSeq hsucc_le with
    ⟨N, hN⟩
  refine ⟨N, ?_⟩
  intro n hn
  refine Nat.le_induction ?base ?step n hn
  · rfl
  · intro m hm ih
    have hmove :=
      PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdge_self_or_size_lt
        root interp dec word initial hsatInitial (hpath m)
    rcases hmove with hsame | hlt
    · rw [hsame, ih]
    · have hmSize : sizeSeq m = sizeSeq N := hN m hm
      have hsuccSize : sizeSeq (m + 1) = sizeSeq N :=
        hN (m + 1) (Nat.le_trans hm (Nat.le_succ m))
      have hbad : sizeSeq (m + 1) < sizeSeq m := by
        simpa [sizeSeq] using hlt
      rw [hmSize, hsuccSize] at hbad
      exact False.elim (Nat.lt_irrefl _ hbad)

/--
Same-formula steps along an abstract recurring-edge path are temporal
fixed-point steps.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdgePath_self_step_is_until_or_release
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    (path :
      Nat ->
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial).State)
    (hpath :
      ∀ n : Nat,
        (path n, path (n + 1)) ∈
          ((PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).realizedEdgeWitnessedMacroRun
            ).infStateEdgeFinset)
    (n : Nat)
    (hselfFormula : (path (n + 1)).1 = (path n).1) :
    (∃ φ ψ : PositiveLTL AP, (path n).1 = PositiveLTL.until φ ψ) ∨
      ∃ φ ψ : PositiveLTL AP, (path n).1 = PositiveLTL.release φ ψ := by
  exact
    PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdge_self_is_until_or_release
      root interp dec word initial hsatInitial (hpath n) hselfFormula

/--
Every abstract recurring-edge path of the guided run eventually stabilizes at
a temporal fixed-point formula.  This packages the two ingredients needed by
the final tail-coherence argument: eventual same-formula behavior and the
`until`/`release` split for the stable formula.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdgePath_eventually_temporal_formula_eq
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    (path :
      Nat ->
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial).State)
    (hpath :
      ∀ n : Nat,
        (path n, path (n + 1)) ∈
          ((PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).realizedEdgeWitnessedMacroRun
            ).infStateEdgeFinset) :
    ∃ N : Nat,
      (∀ n : Nat, N ≤ n -> (path n).1 = (path N).1) ∧
        ((∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.until φ ψ) ∨
          ∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.release φ ψ) := by
  rcases
    PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdgePath_eventually_formula_eq
      root interp dec word initial hsatInitial path hpath with
    ⟨N, hstable⟩
  refine ⟨N, hstable, ?_⟩
  have hselfFormula : (path (N + 1)).1 = (path N).1 :=
    hstable (N + 1) (Nat.le_succ N)
  exact
    PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdgePath_self_step_is_until_or_release
      root interp dec word initial hsatInitial path hpath N hselfFormula

/--
After stabilization, an abstract recurring-edge path exposes an actual
recurring self-edge at its stable state.  This is the precise support-graph
edge that the final node-local self-loop argument has to realize uniformly.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdgePath_eventually_temporal_self_edge
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    (path :
      Nat ->
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial).State)
    (hpath :
      ∀ n : Nat,
        (path n, path (n + 1)) ∈
          ((PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).realizedEdgeWitnessedMacroRun
            ).infStateEdgeFinset) :
    ∃ N : Nat,
      (∀ n : Nat, N ≤ n -> (path n).1 = (path N).1) ∧
        (path N, path N) ∈
          ((PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).realizedEdgeWitnessedMacroRun
            ).infStateEdgeFinset ∧
          ((∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.until φ ψ) ∨
            ∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.release φ ψ) := by
  rcases
    PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdgePath_eventually_temporal_formula_eq
      root interp dec word initial hsatInitial path hpath with
    ⟨N, hstable, htemporal⟩
  have hstate_succ : path (N + 1) = path N := by
    apply Subtype.ext
    exact hstable (N + 1) (Nat.le_succ N)
  have hselfEdge :
      (path N, path N) ∈
        ((PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word initial hsatInitial).realizedEdgeWitnessedMacroRun
          ).infStateEdgeFinset := by
    simpa [hstate_succ] using hpath N
  exact ⟨N, hstable, hselfEdge, htemporal⟩

/--
If a recurring guided-run path is covered by an accepting support graph, then
its eventual temporal self-loop is necessarily a `release` self-loop.

This is the reusable fixed-point bridge needed by pruned support witnesses:
raw recurrence can expose temporal self-loops, while support acceptance rules
out the odd `until` case.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdgePath_eventually_release_self_edge_of_acceptingSubgraph
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    {acceptedEdges :
      Finset (APAStateEdge
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial))}
    (hsubset :
      ((PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).realizedEdgeWitnessedMacroRun
        ).infStateEdgeFinset ⊆ acceptedEdges)
    (haccepting :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp dec).withInitial initial).SupportWitnessStateEdgesAccepting
          acceptedEdges)
    (path :
      Nat ->
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial).State)
    (hpath :
      ∀ n : Nat,
        (path n, path (n + 1)) ∈
          ((PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).realizedEdgeWitnessedMacroRun
            ).infStateEdgeFinset) :
    ∃ N : Nat,
      (∀ n : Nat, N ≤ n -> (path n).1 = (path N).1) ∧
        (path N, path N) ∈
          ((PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).realizedEdgeWitnessedMacroRun
            ).infStateEdgeFinset ∧
          ∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.release φ ψ := by
  rcases
    PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdgePath_eventually_temporal_self_edge
      root interp dec word initial hsatInitial path hpath with
    ⟨N, hstable, hselfEdge, htemporal⟩
  have hpathAccepted :
      ∀ n : Nat, (path n, path (n + 1)) ∈ acceptedEdges := by
    intro n
    exact hsubset (hpath n)
  have hrelease :
      ∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.release φ ψ :=
    PositiveLTL.subformulaClosure_supportWitnessStateEdgesAccepting_stable_temporal_is_release
      root interp dec initial haccepting hpathAccepted hstable htemporal
  exact ⟨N, hstable, hselfEdge, hrelease⟩

/--
State-level version of
`subformulaClosure_guidedRunFrom_infStateEdgePath_eventually_release_self_edge_of_acceptingSubgraph`.

The fixed-point argument first stabilizes the underlying LTL formulas.  For
subformula-closure states this already gives equality of the actual subtype
states, which is the form needed by the tail-coherence bridge below.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdgePath_eventually_release_state_self_edge_of_acceptingSubgraph
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    {acceptedEdges :
      Finset (APAStateEdge
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial))}
    (hsubset :
      ((PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).realizedEdgeWitnessedMacroRun
        ).infStateEdgeFinset ⊆ acceptedEdges)
    (haccepting :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp dec).withInitial initial).SupportWitnessStateEdgesAccepting
          acceptedEdges)
    (path :
      Nat ->
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial).State)
    (hpath :
      ∀ n : Nat,
        (path n, path (n + 1)) ∈
          ((PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).realizedEdgeWitnessedMacroRun
            ).infStateEdgeFinset) :
    ∃ N : Nat,
      (∀ n : Nat, N ≤ n -> path n = path N) ∧
        (path N, path N) ∈
          ((PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).realizedEdgeWitnessedMacroRun
            ).infStateEdgeFinset ∧
          ∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.release φ ψ := by
  rcases
    PositiveLTL.subformulaClosure_guidedRunFrom_infStateEdgePath_eventually_release_self_edge_of_acceptingSubgraph
      root interp dec word initial hsatInitial hsubset haccepting path hpath with
    ⟨N, hformulaStable, hselfEdge, hrelease⟩
  refine ⟨N, ?_, hselfEdge, hrelease⟩
  intro n hn
  apply Subtype.ext
  exact hformulaStable n hn

/--
For the canonical guided tableau run, any threaded tail realization immediately
has the timed-atom support required by the fixed-point/tableau backend.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_statePathTimedAtomTailSupport_of_threadedTailRealization
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    {path :
      Nat ->
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial).State}
    (hthreaded :
      (PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).StatePathThreadedTailRealization
          path) :
    (PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial).StatePathTimedAtomTailSupport
        path := by
  let run :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial
  refine
    run.statePathTimedAtomTailSupport_of_threadedTailRealization
      hthreaded ?_
  intro node child hpathNode hchildActive
  have hactiveChild :
      PositiveLTL.subformulaClosure_guidedRunFromActive
        root interp dec word initial hsatInitial (child :: node) := by
    simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using hchildActive
  simpa [run] using
    PositiveLTL.subformulaClosure_guidedRunFrom_child_timedAtom
