              (((PositiveLTL.subformulaClosure
                (AP := AP)
                (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
                (PositiveLTL.ofLTL formula)).toAPA
                  interp interpDecidable).withInitial state).State,
