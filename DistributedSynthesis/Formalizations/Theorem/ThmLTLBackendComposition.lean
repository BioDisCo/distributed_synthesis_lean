        (PositiveLTL.size_le_of_mem_subformulas sourceState.2))

/--
Unbounded source-frontier satisfaction from a concrete deterministic
macro-edge occurrence.

This is the edge-stream form of
`subformulaClosure_macroConfiguration_source_frontier_of_recurrent_invariant_unbounded`.
It is the natural interface for operational support witnesses, whose selected
macro-edges recur as members of `macroConfigurationEdgeRun`.
-/
theorem PositiveLTL.subformulaClosure_macroConfigurationEdge_source_frontier_of_recurrent_invariant_unbounded
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
