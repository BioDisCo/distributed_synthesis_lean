/--
Canonical prefix-continuation bridge from pure LTL semantics to APA
acceptance.

For the subformula-closure APA, accepting a frontier state on the remaining
suffix is equivalent to satisfying the subformula denoted by that state.  This
lets the remaining support-witness soundness invariant be proved as a
formula-level fixed-point statement rather than as an APA continuation
statement.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessPrefixAccepts_of_prefixSatisfies
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    (hprefSatisfies :
      ∀ formula : LTL AP,
        let A :=
          (PositiveLTL.subformulaClosure
            (AP := AP)
            (Letter := Letter)
            (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
        ∀ (state : A.State) (word : OmegaWord Letter),
          ∀ haccepts :
            (A.supportWitnessMuller ({state} : Finset A.State)).Accepts word,
            ∃ offset : Nat,
              ∃ pref : A.MacroRunPrefix ({state} : Finset A.State) word offset,
                ∀ nextState, nextState ∈ pref.states offset ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word offset) nextState.1) :
      ∀ formula : LTL AP,
        let A :=
          (PositiveLTL.subformulaClosure
            (AP := AP)
            (Letter := Letter)
            (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
        ∀ (state : A.State) (word : OmegaWord Letter),
          ∀ haccepts :
            (A.supportWitnessMuller ({state} : Finset A.State)).Accepts word,
            ∃ offset : Nat,
              ∃ pref : A.MacroRunPrefix ({state} : Finset A.State) word offset,
                ∀ nextState, nextState ∈ pref.states offset ->
                  A.AcceptsFrom nextState (OmegaWord.drop word offset) := by
  intro formula
  dsimp only
  let root := PositiveLTL.ofLTL formula
  let A :=
    (PositiveLTL.subformulaClosure
      (AP := AP)
      (Letter := Letter)
      root).toAPA interp interpDecidable
  intro state word haccepts
  rcases hprefSatisfies formula state word haccepts with
    ⟨offset, pref, hfrontier⟩
  refine ⟨offset, pref, ?_⟩
  intro nextState hnextState
  exact
    (PositiveLTL.subformulaClosure_acceptsFrom_iff_satisfies
      root interp interpDecidable nextState (OmegaWord.drop word offset)).mpr
      (hfrontier nextState hnextState)

/--
Formula-frontier soundness gives canonical support-witness soundness.

This is the direct handoff from the remaining LTL fixed-point anchor
`subformulaClosure_supportWitnessMuller_prefixSatisfies` to the abstract
`SupportWitnessSound` field used by older support-witness compiler routes.
The proof first converts formula satisfaction at the prefix frontier into APA
continuation acceptance, then invokes the generic operational-prefix
support-witness soundness theorem.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessSound_of_prefixSatisfies
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    (hprefSatisfies :
      ∀ formula : LTL AP,
        let A :=
          (PositiveLTL.subformulaClosure
            (AP := AP)
            (Letter := Letter)
            (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
        ∀ (state : A.State) (word : OmegaWord Letter),
          ∀ haccepts :
            (A.supportWitnessMuller ({state} : Finset A.State)).Accepts word,
            ∃ offset : Nat,
              ∃ pref : A.MacroRunPrefix ({state} : Finset A.State) word offset,
                ∀ nextState, nextState ∈ pref.states offset ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word offset) nextState.1) :
    ∀ formula : LTL AP,
      let A :=
        (PositiveLTL.subformulaClosure
          (AP := AP)
          (Letter := Letter)
          (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
      A.SupportWitnessSound := by
  intro formula
  dsimp only
  let root := PositiveLTL.ofLTL formula
  let A :=
    (PositiveLTL.subformulaClosure
      (AP := AP)
      (Letter := Letter)
      root).toAPA interp interpDecidable
  exact
    A.supportWitnessSound_of_operationalWitness_prefix_accepts
      ((PositiveLTL.subformulaClosure_supportWitnessPrefixAccepts_of_prefixSatisfies
        interp interpDecidable hprefSatisfies) formula)

/--
Semantic special case of the canonical prefix-continuation bridge.

If a singleton subformula state already satisfies its formula on the current
word, then the required frontier prefix can be taken at offset `0`.
This is the easy direction of the support-witness prefix invariant and is
useful as a local normalization lemma when the soundness route has already
established semantic acceptance.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessPrefixAccepts_of_satisfies
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    : ∀ formula : LTL AP,
      let A :=
        (PositiveLTL.subformulaClosure
          (AP := AP)
          (Letter := Letter)
          (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
      ∀ (state : A.State) (word : OmegaWord Letter),
        PositiveLTL.Satisfies interp word state.1 ->
          ∃ offset : Nat,
            ∃ pref : A.MacroRunPrefix ({state} : Finset A.State) word offset,
              ∀ nextState, nextState ∈ pref.states offset ->
                A.AcceptsFrom nextState (OmegaWord.drop word offset) := by
  intro formula
  dsimp only
  let root := PositiveLTL.ofLTL formula
  let A :=
    (PositiveLTL.subformulaClosure
      (AP := AP)
      (Letter := Letter)
      root).toAPA interp interpDecidable
  intro state word hsat
  refine ⟨0, ?_, ?_⟩
  · refine
      { states := fun _ => ({state} : Finset A.State)
        initial_states := rfl
        step_transition := by
          intro n hn
          omega }
  · intro nextState hnextState
    have hstate : nextState = state := by
      simpa using hnextState
    subst nextState
    simpa [OmegaWord.drop] using
      (PositiveLTL.subformulaClosure_acceptsFrom_iff_satisfies
        root interp interpDecidable state word).mpr hsat

/--
Reverse direction of the prefix-continuation bridge for the canonical LTL APA.

Once a finite frontier is known to have accepting APA continuations, the
state-wise correctness theorem converts those continuations back to
satisfaction of the represented subformulas.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessPrefixSatisfies_of_prefixAccepts
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    (formula : LTL AP) :
    let A :=
      (PositiveLTL.subformulaClosure
        (AP := AP)
        (Letter := Letter)
        (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
    ∀ (state : A.State) (word : OmegaWord Letter),
      (∃ offset : Nat,
        ∃ pref : A.MacroRunPrefix ({state} : Finset A.State) word offset,
          ∀ nextState, nextState ∈ pref.states offset ->
            A.AcceptsFrom nextState (OmegaWord.drop word offset)) ->
      ∃ offset : Nat,
        ∃ pref : A.MacroRunPrefix ({state} : Finset A.State) word offset,
          ∀ nextState, nextState ∈ pref.states offset ->
            PositiveLTL.Satisfies interp
              (OmegaWord.drop word offset) nextState.1 := by
  dsimp only
  let root := PositiveLTL.ofLTL formula
  let A :=
    (PositiveLTL.subformulaClosure
      (AP := AP)
      (Letter := Letter)
      root).toAPA interp interpDecidable
  intro state word hprefAccepts
  rcases hprefAccepts with ⟨offset, pref, hfrontier⟩
  refine ⟨offset, pref, ?_⟩
  intro nextState hnextState
  exact
    (PositiveLTL.subformulaClosure_acceptsFrom_iff_satisfies
      root interp interpDecidable nextState (OmegaWord.drop word offset)).mp
      (hfrontier nextState hnextState)

/--
Canonical support-witness soundness gives the formula-frontier prefix
obligation.

This is the converse of
`subformulaClosure_supportWitnessSound_of_prefixSatisfies`.  Generic
support-witness soundness yields a finite APA-accepting frontier; the canonical
subformula APA correctness theorem then turns every frontier continuation back
into satisfaction of the represented LTL subformula.
-/
theorem PositiveLTL.subformulaClosure_prefixSatisfies_of_supportWitnessSound
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    (hsound :
      ∀ formula : LTL AP,
        let A :=
          (PositiveLTL.subformulaClosure
            (AP := AP)
            (Letter := Letter)
            (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
        A.SupportWitnessSound) :
    ∀ formula : LTL AP,
      let A :=
        (PositiveLTL.subformulaClosure
          (AP := AP)
          (Letter := Letter)
          (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
      ∀ (state : A.State) (word : OmegaWord Letter),
        ∀ haccepts :
          (A.supportWitnessMuller ({state} : Finset A.State)).Accepts word,
          ∃ offset : Nat,
            ∃ pref : A.MacroRunPrefix ({state} : Finset A.State) word offset,
              ∀ nextState, nextState ∈ pref.states offset ->
                PositiveLTL.Satisfies interp
                  (OmegaWord.drop word offset) nextState.1 := by
  intro formula
  dsimp only
  let root := PositiveLTL.ofLTL formula
  let A :=
    (PositiveLTL.subformulaClosure
      (AP := AP)
      (Letter := Letter)
      root).toAPA interp interpDecidable
  have hprefAccepts :
      ∀ (state : A.State) (word : OmegaWord Letter),
        ∀ haccepts :
          (A.supportWitnessMuller ({state} : Finset A.State)).Accepts word,
          ∃ offset : Nat,
            ∃ pref : A.MacroRunPrefix ({state} : Finset A.State) word offset,
              ∀ nextState, nextState ∈ pref.states offset ->
                A.AcceptsFrom nextState (OmegaWord.drop word offset) :=
    (A.supportWitnessSound_iff_operationalWitness_prefix_accepts).mp
      (hsound formula)
  intro state word haccepts
  exact
    PositiveLTL.subformulaClosure_supportWitnessPrefixSatisfies_of_prefixAccepts
      interp interpDecidable formula state word
      (hprefAccepts state word haccepts)

/--
The canonical formula-frontier prefix obligation is exactly the same as
support-witness soundness for the canonical subformula APAs.

The forward direction is the route used by the LTL fixed-point anchor proof.
The reverse direction is useful for checking that this anchor is neither
stronger nor weaker than the automata-side soundness field it is meant to
discharge.
-/
theorem PositiveLTL.subformulaClosure_prefixSatisfies_iff_supportWitnessSound
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter)) :
    (∀ formula : LTL AP,
      let A :=
        (PositiveLTL.subformulaClosure
          (AP := AP)
          (Letter := Letter)
          (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
      ∀ (state : A.State) (word : OmegaWord Letter),
        ∀ haccepts :
          (A.supportWitnessMuller ({state} : Finset A.State)).Accepts word,
          ∃ offset : Nat,
            ∃ pref : A.MacroRunPrefix ({state} : Finset A.State) word offset,
              ∀ nextState, nextState ∈ pref.states offset ->
                PositiveLTL.Satisfies interp
                  (OmegaWord.drop word offset) nextState.1) ↔
      (∀ formula : LTL AP,
        let A :=
          (PositiveLTL.subformulaClosure
            (AP := AP)
            (Letter := Letter)
            (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
        A.SupportWitnessSound) := by
  constructor
  · exact
      PositiveLTL.subformulaClosure_supportWitnessSound_of_prefixSatisfies
        interp interpDecidable
  · exact
      PositiveLTL.subformulaClosure_prefixSatisfies_of_supportWitnessSound
        interp interpDecidable

/--
Semantic macro-runs expose exactly the satisfying frontier needed by the LTL
support-witness soundness route.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessPrefixSatisfies_of_hasSemanticMacroRun
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    (formula : LTL AP) :
    let A :=
      (PositiveLTL.subformulaClosure
        (AP := AP)
        (Letter := Letter)
        (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
    ∀ (state : A.State) (word : OmegaWord Letter)
      (witness :
        A.SupportOperationalWitness
          ({state} : Finset A.State)
          word
          ((A.supportWitnessMuller ({state} : Finset A.State)).InfStates word)),
      witness.HasSemanticMacroRun ->
      ∃ offset : Nat,
        ∃ pref : A.MacroRunPrefix ({state} : Finset A.State) word offset,
          ∀ nextState, nextState ∈ pref.states offset ->
            PositiveLTL.Satisfies interp
              (OmegaWord.drop word offset) nextState.1 := by
  dsimp only
  let root := PositiveLTL.ofLTL formula
  let A :=
    (PositiveLTL.subformulaClosure
      (AP := AP)
      (Letter := Letter)
      root).toAPA interp interpDecidable
  intro state word witness hsemantic
  exact
    PositiveLTL.subformulaClosure_supportWitnessPrefixSatisfies_of_prefixAccepts
      interp interpDecidable formula state word
      (witness.exists_prefix_accepts_of_hasSemanticMacroRun hsemantic)

/--
A timed, formula-facing consequence of recurrent state-edge evidence.

For a selected recurrent support edge, the operational witness provides
arbitrarily late concrete prefix occurrences of the macro transition realizing
that edge. If the target frontier of such an occurrence is semantically true,
then one-step correctness of the canonical LTL APA makes the source state true
at the preceding time.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_stateEdge_prefix_source_satisfies_of_target
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {edge :
      APAStateEdge
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable)}
    (hedge : edge ∈ witness.stateEdges) :
    ∀ n : Nat,
      ∃ k : Nat,
        ∃ pref :
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).MacroRunPrefix initialStates word (k + 1),
          n ≤ k ∧
            edge.1 ∈ pref.states k ∧
            edge.2 ∈ pref.states (k + 1) ∧
            ((∀ nextState, nextState ∈ pref.states (k + 1) ->
                PositiveLTL.Satisfies interp
                  (OmegaWord.drop word (k + 1)) nextState.1) ->
              PositiveLTL.Satisfies interp
                (OmegaWord.drop word k) edge.1.1) := by
  intro n
  rcases witness.stateEdge_prefixes_with_extended_prefix hedge n with
    ⟨k, sourceStates, targetStates, _stepStateEdges, pref,
      hle, hprefSource, hprefTarget, _htransition, _hedgeStep,
      hedgeSource, hedgeTarget⟩
  refine ⟨k, pref, hle, ?_, ?_, ?_⟩
  · simpa [hprefSource] using hedgeSource
  · simpa [hprefTarget] using hedgeTarget
  · intro htarget
    have hstep :=
      PositiveLTL.subformulaClosure_macroRunPrefix_satisfies_step_back
        root interp interpDecidable
        (initialStates := initialStates)
        (word := word)
        (n := k)
        pref
        htarget
    exact hstep edge.1 (by simpa [hprefSource] using hedgeSource)

/--
The same timed state-edge occurrence, packaged with full backward propagation
along its concrete prefix.

Thus the remaining anchor proof only has to establish semantic truth at the
chosen target frontier; the already-proved finite-prefix theorem then recovers
truth at every earlier macro-state of that prefix.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_stateEdge_prefix_satisfies_back_of_target
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {edge :
      APAStateEdge
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable)}
    (hedge : edge ∈ witness.stateEdges) :
    ∀ n : Nat,
      ∃ k : Nat,
        ∃ pref :
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).MacroRunPrefix initialStates word (k + 1),
          n ≤ k ∧
            edge.1 ∈ pref.states k ∧
            edge.2 ∈ pref.states (k + 1) ∧
            ((∀ nextState, nextState ∈ pref.states (k + 1) ->
                PositiveLTL.Satisfies interp
                  (OmegaWord.drop word (k + 1)) nextState.1) ->
              ∀ m, m ≤ k + 1 ->
                ∀ state, state ∈ pref.states m ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word m) state.1) := by
  intro n
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases witness.stateEdge_prefixes_with_extended_prefix hedge n with
    ⟨k, sourceStates, targetStates, _stepStateEdges, pref,
      hle, hprefSource, hprefTarget, _htransition, _hedgeStep,
      hedgeSource, hedgeTarget⟩
  refine ⟨k, pref, hle, ?_, ?_, ?_⟩
  · simpa [hprefSource] using hedgeSource
  · simpa [hprefTarget] using hedgeTarget
  · intro htarget
    exact
      PositiveLTL.subformulaClosure_macroRunPrefix_satisfies_back
        root interp interpDecidable
        (initialStates := initialStates)
        (word := word)
        (offset := k + 1)
        pref
        htarget

/--
Bounded version of
`subformulaClosure_supportWitness_stateEdge_prefix_satisfies_back_of_target`.

This is the support-witness wrapper needed for formula-size induction: if the
target frontier is true only below a size bound, then the whole concrete prefix
is true below the same bound.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_stateEdge_prefix_satisfies_back_of_smaller
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {edge :
      APAStateEdge
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable)}
    (hedge : edge ∈ witness.stateEdges)
    {bound : Nat} :
    ∀ n : Nat,
      ∃ k : Nat,
        ∃ pref :
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).MacroRunPrefix initialStates word (k + 1),
          n ≤ k ∧
            edge.1 ∈ pref.states k ∧
            edge.2 ∈ pref.states (k + 1) ∧
            ((∀ nextState, nextState ∈ pref.states (k + 1) ->
                nextState.1.size < bound ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word (k + 1)) nextState.1) ->
              ∀ m, m ≤ k + 1 ->
                ∀ state, state ∈ pref.states m ->
                  state.1.size < bound ->
                    PositiveLTL.Satisfies interp
                      (OmegaWord.drop word m) state.1) := by
  intro n
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases witness.stateEdge_prefixes_with_extended_prefix hedge n with
    ⟨k, sourceStates, targetStates, _stepStateEdges, pref,
      hle, hprefSource, hprefTarget, _htransition, _hedgeStep,
      hedgeSource, hedgeTarget⟩
  refine ⟨k, pref, hle, ?_, ?_, ?_⟩
  · simpa [hprefSource] using hedgeSource
  · simpa [hprefTarget] using hedgeTarget
  · intro htarget
    exact
      PositiveLTL.subformulaClosure_macroRunPrefix_satisfies_back_of_size_lt
        root interp interpDecidable
        (initialStates := initialStates)
        (word := word)
        (offset := k + 1)
        (bound := bound)
        pref
        htarget

/--
Every concrete selected state-edge of the canonical subformula APA is either a
self-edge or strictly decreases the represented formula size.

This lifts the syntactic `subformulaTransition_atoms_self_or_size_lt` lemma
through `MacroTransitionWithStateEdges`, so later support-witness arguments can
reason directly about the finite selected state-edge graph.
-/
theorem PositiveLTL.subformulaClosure_macroTransitionWithStateEdges_edge_self_or_size_lt
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {states nextStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {letter : Letter}
    {stateEdges :
      Finset
        ((((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).State) ×
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).State))}
    {edge :
      APAStateEdge
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable)}
    (htransition :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).MacroTransitionWithStateEdges
          states letter nextStates stateEdges)
    (hedge : edge ∈ stateEdges) :
    edge.2 = edge.1 ∨ edge.2.1.size < edge.1.1.size := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases htransition with ⟨supportChoice, _hsupport, hstateEdges⟩
  have hedgeChoice : edge ∈ supportChoice.stateEdges := by
    simpa [hstateEdges] using hedge
  rcases
    (AlternatingParityAutomaton.MacroStepSupport.mem_stateEdges
      (supportChoice := supportChoice)).mp hedgeChoice with
    ⟨source, hsource, htarget⟩
  have htargetAtoms :
      edge.2 ∈ (A.step source.1 letter).atoms :=
    (supportChoice.choice source).support_atoms edge.2 htarget
  have hmove :
      edge.2.1 = source.1.1 ∨ edge.2.1.size < source.1.1.size := by
    exact
      @PositiveLTL.subformulaTransition_atoms_self_or_size_lt
        AP Letter root interp interpDecidable
        source.1 edge.2 letter
        (by
          simpa [A, FiniteLTLAlternatingClosure.toAPA,
            PositiveLTL.subformulaClosure] using htargetAtoms)
  rcases hmove with hself | hlt
  · left
    apply Subtype.ext
    simpa [hsource] using hself
  · right
    simpa [hsource] using hlt

/--
Target states of a canonical subformula macro-transition stay below any size
bound that contains all source states.

This is the frontier-size monotonicity fact needed by the recurrent-frontier
size induction.  A target state is generated by some selected state-edge, and
such edges are either self-edges or strict formula-size descents.
-/
theorem PositiveLTL.subformulaClosure_macroTransitionWithStateEdges_target_size_lt_of_source_bound
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {states nextStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {letter : Letter}
    {stateEdges :
      Finset
        ((((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).State) ×
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).State))}
    (htransition :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).MacroTransitionWithStateEdges
          states letter nextStates stateEdges)
    {bound : Nat}
    (hsourceBound :
      ∀ sourceState, sourceState ∈ states -> sourceState.1.size < bound) :
    ∀ nextState, nextState ∈ nextStates -> nextState.1.size < bound := by
  intro nextState hnextState
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases htransition.exists_edge_of_target_mem hnextState with
    ⟨sourceState, hsourceState, hedge⟩
  have hmove :
      nextState = sourceState ∨ nextState.1.size < sourceState.1.size := by
    simpa using
      (PositiveLTL.subformulaClosure_macroTransitionWithStateEdges_edge_self_or_size_lt
        root interp interpDecidable
        (edge := (sourceState, nextState))
        htransition
        hedge)
  rcases hmove with hself | hlt
  · subst nextState
    exact hsourceBound sourceState hsourceState
  · exact Nat.lt_trans hlt (hsourceBound sourceState hsourceState)

/--
Selected operational witness state-edges for the canonical subformula APA are
also self-edges or strict formula-size descents.

This is the support-witness graph form used by the recurrent frontier
induction.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_stateEdge_self_or_size_lt
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {edge :
      APAStateEdge
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable)}
    (hedge : edge ∈ witness.stateEdges) :
    edge.2 = edge.1 ∨ edge.2.1.size < edge.1.1.size := by
  rcases witness.stateEdge_prefixes edge hedge 0 with
    ⟨_k, _sourceStates, _targetStates, stepStateEdges, _pref,
      _hle, _hpref, htransition, hedgeStep⟩
  exact
    PositiveLTL.subformulaClosure_macroTransitionWithStateEdges_edge_self_or_size_lt
      root interp interpDecidable htransition hedgeStep

/--
Selected progress out of a bounded recurrent macro-state has a bounded target
macro-state.

This is the operational-witness form of
`subformulaClosure_macroTransitionWithStateEdges_target_size_lt_of_source_bound`:
choose a selected progress edge out of `states`; any concrete realization of
that edge is a canonical macro-transition, so the target frontier cannot
introduce formulas outside the current strict size bound.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_macroState_progress_target_size_lt_of_source_bound
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {states :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    (hstates : states ∈ witness.macroStates)
