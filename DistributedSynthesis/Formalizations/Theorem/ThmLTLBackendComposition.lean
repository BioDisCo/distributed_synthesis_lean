                                            (PositiveLTL.subformulaClosure_guidedRunFrom
                                              root interp dec word state hsat).stateAt
                                                (child :: suffix ++ node) =
                                              path (suffix.length + 1)) ∧
                                  ∀ suffix : AlternatingParityAutomaton.Node,
                                    (PositiveLTL.subformulaClosure_guidedRunFrom
                                      root interp dec word state hsat).PathActive
                                        (suffix ++ node) ->
                                    (PositiveLTL.subformulaClosure_guidedRunFrom
                                      root interp dec word state hsat).stateAt
                                        (suffix ++ node) = releaseState ->
