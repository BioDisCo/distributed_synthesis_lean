/--
Parity exclusion for stable `until` paths in canonical LTL support witnesses.

If every edge of an infinite support path belongs to an accepting state-edge
graph and the path eventually stabilizes at one canonical subformula state,
that stable state cannot be an `until` formula.  This packages the generic
support-witness parity lemma with the canonical LTL priority assignment.
-/
theorem PositiveLTL.subformulaClosure_stateEdgesAccepting_until_not_stable
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {stateEdges :
      Finset
        ((((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).State) ×
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).State))}
    (haccepting :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportWitnessStateEdgesAccepting stateEdges)
    {path :
      Nat ->
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State}
    (hpath : ∀ n : Nat, (path n, path (n + 1)) ∈ stateEdges)
    {N : Nat}
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    (hstable : ∀ n : Nat, N ≤ n -> path n = state)
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.until φ ψ) :
    False := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  have heven :
      DetParityAutomaton.NatEven
        (PositiveLTL.alternatingPriority root (PositiveLTL.until φ ψ)) := by
    refine
      AlternatingParityAutomaton.SupportWitnessStateEdgesAccepting.eventually_constant_priority_even
          (A := A)
          (stateEdges := stateEdges)
          haccepting
          hpath
          (N := N)
          (p := PositiveLTL.alternatingPriority root
            (PositiveLTL.until φ ψ))
          ?_
    intro n hn
    have hpn : path n = state := hstable n hn
    simpa [A, FiniteLTLAlternatingClosure.toAPA,
      PositiveLTL.subformulaClosure, hpn, hstate]
  exact PositiveLTL.alternatingPriority_until_not_even root φ ψ heven

/--
In an accepting support state-edge graph for the canonical LTL APA, an
`until` state cannot carry a selected self-loop.

This is the finite-graph form used by the recurrent-frontier anchor: a
self-loop would make the constant path a stable `until` path, contradicting
the parity condition.
-/
theorem PositiveLTL.subformulaClosure_stateEdgesAccepting_until_self_not_mem
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {stateEdges :
      Finset
        ((((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).State) ×
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).State))}
    (haccepting :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportWitnessStateEdgesAccepting stateEdges)
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.until φ ψ)
    (hself : (state, state) ∈ stateEdges) :
    False := by
  exact
    PositiveLTL.subformulaClosure_stateEdgesAccepting_until_not_stable
      root interp interpDecidable
      haccepting
      (path := fun _ => state)
      (by
        intro n
        simpa using hself)
      (N := 0)
      (state := state)
      (by
        intro n hn
        rfl)
      hstate

/--
Operational-witness specialization of the `until` self-loop exclusion.

The selected state-edge carrier of a support operational witness already
satisfies the parity condition, so no selected self-loop may be rooted at an
`until` formula.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_until_self_edge_not_mem
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {φ ψ : PositiveLTL AP}
    (hstate : state.1 = PositiveLTL.until φ ψ)
    (hself : (state, state) ∈ witness.stateEdges) :
    False :=
  PositiveLTL.subformulaClosure_stateEdgesAccepting_until_self_not_mem
    root interp interpDecidable
    witness.stateEdges_accepting hstate hself

/--
Every selected operational edge leaving an `until` state strictly descends in
formula size.

The syntactic transition lemma gives "self or smaller"; the parity condition
for the accepting support graph rules out the `until` self-loop.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_until_stateEdge_target_size_lt
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {edge :
      APAStateEdge
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable)}
    (hedge : edge ∈ witness.stateEdges)
    {φ ψ : PositiveLTL AP}
    (hsource : edge.1.1 = PositiveLTL.until φ ψ) :
    edge.2.1.size < (PositiveLTL.until φ ψ).size := by
  rcases
    PositiveLTL.subformulaClosure_supportWitness_stateEdge_self_or_size_lt
      root interp interpDecidable witness hedge with hself | hlt
  · rcases edge with ⟨source, target⟩
    have hselfEdge : (source, source) ∈ witness.stateEdges := by
      have htargetSource : target = source := hself
      rw [htargetSource] at hedge
      exact hedge
    exact False.elim
      (PositiveLTL.subformulaClosure_supportWitness_until_self_edge_not_mem
        root interp interpDecidable witness hsource hselfEdge)
  · simpa [hsource] using hlt

/--
State-edges explicitly recorded by an edge-witnessed macro-run for the
canonical subformula APA are self-edges or strict formula-size descents.

This is the concrete-run analogue of
`subformulaClosure_supportWitness_stateEdge_self_or_size_lt`; it avoids going
through the untimed operational witness when the proof is working directly
with an accepting `EdgeWitnessedMacroRun`.
-/
theorem PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_stateEdge_self_or_size_lt
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun initialStates word)
    {n : Nat}
    {edge :
      APAStateEdge
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable)}
    (hedge : edge ∈ run.stateEdges n) :
    edge.2 = edge.1 ∨ edge.2.1.size < edge.1.1.size := by
  exact
    PositiveLTL.subformulaClosure_macroTransitionWithStateEdges_edge_self_or_size_lt
      root interp interpDecidable
      (run.step_stateEdges_transition n) hedge

/--
Recurring state-edges of an edge-witnessed canonical subformula macro-run are
self-edges or strict formula-size descents.
-/
theorem PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_infStateEdge_self_or_size_lt
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    (run :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).EdgeWitnessedMacroRun initialStates word)
    {edge :
      APAStateEdge
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable)}
    (hedge : edge ∈ run.infStateEdgeFinset) :
    edge.2 = edge.1 ∨ edge.2.1.size < edge.1.1.size := by
  have hseen : run.StateEdgeSeenInfinitelyOften edge :=
    (run.mem_infStateEdgeFinset edge).mp hedge
  rcases hseen 0 with ⟨k, _hk, hedgeStep⟩
  exact
    PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_stateEdge_self_or_size_lt
      root interp interpDecidable run hedgeStep

/--
In an accepting recurring edge graph of an edge-witnessed canonical subformula
macro-run, every recurring edge leaving an `until` state strictly descends in
formula size.

The syntactic transition lemma gives "self or smaller"; the accepting parity
condition on `run.infStateEdgeFinset` rules out the `until` self-loop.
-/
theorem PositiveLTL.subformulaClosure_edgeWitnessedMacroRun_until_infStateEdge_target_size_lt
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
