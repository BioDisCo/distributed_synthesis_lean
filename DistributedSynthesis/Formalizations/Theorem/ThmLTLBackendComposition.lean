            word offset,
        ∀ nextState, nextState ∈ pref.states offset ->
          PositiveLTL.Satisfies interp
            (OmegaWord.drop word offset) nextState.1 := by
  rcases heventual with ⟨N, htail⟩
  rcases run.toMacroRun.infStateFinset_nonempty with
    ⟨targetStates, htargetInf⟩
  have hseen :
      run.toMacroRun.StateSeenInfinitelyOften targetStates :=
