  let hcoherent :
      A.SupportWitnessExistsTailPathChildCoherent :=
    PositiveLTL.subformulaClosure_supportWitnessExistsTailPathChildCoherent_of_guidedRunFrom
      (PositiveLTL.ofLTL formula)
      interp
      interpDecidable
      hguided
  exact
    ofCanonicalFrontendSupportWitnessSoundAndExistsTailPathChildCoherent
      formula
      interp
      interpDecidable
      hsound
      hcoherent
      finiteGameCompilation

