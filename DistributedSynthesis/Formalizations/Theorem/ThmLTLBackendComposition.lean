/--
Single-path constructor for the eventual-release/local-edge data.

Given subtree-local child coherence for one selected support-graph path, plus
the usual finite-descent and self-loop classification invariants for the
selected graph, support acceptance forces the stabilized temporal self-loop to
be a release.  The coherent children then provide the required node-local
prefix and release-self realizations.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_eventualReleaseLocalEdges_of_tailCoherent_and_accepting_descent
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    {acceptedEdges :
      Finset (APAStateEdge
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial))}
    (haccepting :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp dec).withInitial initial).SupportWitnessStateEdgesAccepting
          acceptedEdges)
    (hdescent :
      ∀ edge :
        APAStateEdge
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp dec).withInitial initial),
        edge ∈ acceptedEdges ->
          edge.2.1 = edge.1.1 ∨ edge.2.1.size < edge.1.1.size)
    (hselfTemporal :
      ∀ edge :
        APAStateEdge
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp dec).withInitial initial),
        edge ∈ acceptedEdges ->
          edge.2.1 = edge.1.1 ->
            (∃ φ ψ : PositiveLTL AP, edge.1.1 = PositiveLTL.until φ ψ) ∨
              ∃ φ ψ : PositiveLTL AP, edge.1.1 = PositiveLTL.release φ ψ)
    {path :
      Nat ->
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial).State}
    (hpath : ∀ n : Nat, (path n, path (n + 1)) ∈ acceptedEdges)
    (hcoherent :
      (PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).StatePathTailCoherentChildren
          path) :
    ∃ node : AlternatingParityAutomaton.Node,
      ∃ hpathNode :
        (PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word initial hsatInitial).PathActive node,
        (PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word initial hsatInitial).stateAt node =
          path 0 ∧
          ∃ N : Nat,
            ∃ releaseState : root.Subformula,
              ∃ φ ψ : PositiveLTL AP,
                (∀ n : Nat, N ≤ n -> path n = releaseState) ∧
                  releaseState.1 = PositiveLTL.release φ ψ ∧
                    (∀ suffix : AlternatingParityAutomaton.Node,
                      (PositiveLTL.subformulaClosure_guidedRunFrom
                        root interp dec word initial hsatInitial).PathActive
                          (suffix ++ node) ->
                      (PositiveLTL.subformulaClosure_guidedRunFrom
                        root interp dec word initial hsatInitial).stateAt
                          (suffix ++ node) = path suffix.length ->
                      suffix.length < N ->
                        (PositiveLTL.subformulaClosure_guidedRunFrom
                          root interp dec word initial hsatInitial).PathActive
                            (suffix ++ node) ∧
                          (PositiveLTL.subformulaClosure_guidedRunFrom
                            root interp dec word initial hsatInitial).stateAt
                              (suffix ++ node) = path suffix.length ∧
                            ∃ child : Nat,
                              (PositiveLTL.subformulaClosure_guidedRunFrom
                                root interp dec word initial hsatInitial).active
                                  (child :: suffix ++ node) ∧
                                (PositiveLTL.subformulaClosure_guidedRunFrom
                                  root interp dec word initial hsatInitial).stateAt
                                    (child :: suffix ++ node) =
                                  path (suffix.length + 1)) ∧
                      ∀ suffix : AlternatingParityAutomaton.Node,
                        (PositiveLTL.subformulaClosure_guidedRunFrom
                          root interp dec word initial hsatInitial).PathActive
                            (suffix ++ node) ->
                        (PositiveLTL.subformulaClosure_guidedRunFrom
                          root interp dec word initial hsatInitial).stateAt
                            (suffix ++ node) = releaseState ->
                        N ≤ suffix.length ->
                          (PositiveLTL.subformulaClosure_guidedRunFrom
                            root interp dec word initial hsatInitial).PathActive
                              (suffix ++ node) ∧
                            (PositiveLTL.subformulaClosure_guidedRunFrom
                              root interp dec word initial hsatInitial).stateAt
                                (suffix ++ node) = releaseState ∧
                              ∃ child : Nat,
                                (PositiveLTL.subformulaClosure_guidedRunFrom
                                  root interp dec word initial hsatInitial).active
                                    (child :: suffix ++ node) ∧
                                  (PositiveLTL.subformulaClosure_guidedRunFrom
                                    root interp dec word initial hsatInitial).stateAt
                                      (child :: suffix ++ node) =
                                    releaseState := by
  let run :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial
  let sizeSeq : Nat -> Nat := fun n => (path n).1.size
  have hsucc_le : ∀ n, sizeSeq (n + 1) ≤ sizeSeq n := by
    intro n
    have hmove := hdescent (path n, path (n + 1)) (hpath n)
    rcases hmove with hsame | hlt
    · change (path (n + 1)).1.size ≤ (path n).1.size
      rw [hsame]
    · exact Nat.le_of_lt hlt
  rcases nat_eventually_constant_of_succ_le' sizeSeq hsucc_le with
    ⟨N, hN⟩
  have hformulaStable : ∀ n : Nat, N ≤ n -> (path n).1 = (path N).1 := by
    intro n hn
    refine Nat.le_induction ?base ?step n hn
    · rfl
    · intro m hm ih
      have hmove := hdescent (path m, path (m + 1)) (hpath m)
      rcases hmove with hsame | hlt
      · rw [hsame, ih]
      · have hmSize : sizeSeq m = sizeSeq N := hN m hm
        have hsuccSize : sizeSeq (m + 1) = sizeSeq N :=
          hN (m + 1) (Nat.le_trans hm (Nat.le_succ m))
        have hbad : sizeSeq (m + 1) < sizeSeq m := by
          simpa [sizeSeq] using hlt
        rw [hmSize, hsuccSize] at hbad
        exact False.elim (Nat.lt_irrefl _ hbad)
  have hstable : ∀ n : Nat, N ≤ n -> path n = path N := by
    intro n hn
    apply Subtype.ext
    exact hformulaStable n hn
  have hstate_succ : path (N + 1) = path N :=
    hstable (N + 1) (Nat.le_succ N)
  have hselfFormula : (path (N + 1)).1 = (path N).1 := by
    simpa [hstate_succ]
  have htemporal :
      (∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.until φ ψ) ∨
        ∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.release φ ψ := by
    simpa using
      hselfTemporal (path N, path (N + 1)) (hpath N) hselfFormula
  have hrelease :
      ∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.release φ ψ :=
    PositiveLTL.subformulaClosure_supportWitnessStateEdgesAccepting_stable_temporal_is_release
      root interp dec initial haccepting hpath hformulaStable htemporal
  rcases hrelease with ⟨φ, ψ, hrelease⟩
  have hthreaded :
      run.StatePathThreadedTailRealization path :=
    run.statePathThreadedTailRealization_of_tailCoherentChildren hcoherent
  rcases hthreaded with
    ⟨node, hpathNode, hnodeActive, hnodeState, hstep⟩
  refine ⟨node, hpathNode, hnodeState, N, path N, φ, ψ, hstable, hrelease, ?_, ?_⟩
  · intro suffix hsuffixPath hsuffixState _hlt
    have hsuffixActive :
        (run.subRun node hnodeActive).PathActive suffix :=
      run.subRun_pathActive_of_pathActive_append hnodeActive hsuffixPath
    rcases hstep suffix hsuffixActive hsuffixState with
      ⟨child, hchildActive, hchildState⟩
    exact ⟨hsuffixPath, hsuffixState, child, hchildActive, hchildState⟩
  · intro suffix hsuffixPath hsuffixState hNle
    have hsuffixActive :
        (run.subRun node hnodeActive).PathActive suffix :=
      run.subRun_pathActive_of_pathActive_append hnodeActive hsuffixPath
    have hsuffixStatePath :
        run.stateAt (suffix ++ node) = path suffix.length := by
      exact hsuffixState.trans (hstable suffix.length hNle).symm
    rcases hstep suffix hsuffixActive hsuffixStatePath with
      ⟨child, hchildActive, hchildState⟩
    have hchildRelease :
        run.stateAt (child :: suffix ++ node) = path N := by
      exact hchildState.trans
        (hstable (suffix.length + 1)
          (Nat.le_trans hNle (Nat.le_succ _)))
    exact ⟨hsuffixPath, hsuffixState, child, hchildActive, hchildRelease⟩

/--
Single-path constructor for the semantic open-release/local-edge data.

This is the fixed-point-facing variant of
`..._eventualReleaseLocalEdges_of_tailCoherent_and_accepting_descent`: once
descent and acceptance identify the stable temporal state as a release, child
tail coherence gives a stable self-child, and the guided release rule implies
that the release's left side is false at every stable suffix.
-/
theorem PositiveLTL.subformulaClosure_guidedRunFrom_eventualOpenReleaseLocalEdges_of_tailCoherent_and_accepting_descent
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (word : OmegaWord Letter)
    (initial : root.Subformula)
    (hsatInitial : PositiveLTL.Satisfies interp word initial.1)
    {acceptedEdges :
      Finset (APAStateEdge
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial))}
    (haccepting :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp dec).withInitial initial).SupportWitnessStateEdgesAccepting
          acceptedEdges)
    (hdescent :
      ∀ edge :
        APAStateEdge
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp dec).withInitial initial),
        edge ∈ acceptedEdges ->
          edge.2.1 = edge.1.1 ∨ edge.2.1.size < edge.1.1.size)
    (hselfTemporal :
      ∀ edge :
        APAStateEdge
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp dec).withInitial initial),
        edge ∈ acceptedEdges ->
          edge.2.1 = edge.1.1 ->
            (∃ φ ψ : PositiveLTL AP, edge.1.1 = PositiveLTL.until φ ψ) ∨
              ∃ φ ψ : PositiveLTL AP, edge.1.1 = PositiveLTL.release φ ψ)
    {path :
      Nat ->
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp dec).withInitial initial).State}
    (hpath : ∀ n : Nat, (path n, path (n + 1)) ∈ acceptedEdges)
    (hcoherent :
      (PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).StatePathTailCoherentChildren
          path) :
    ∃ node : AlternatingParityAutomaton.Node,
      ∃ hpathNode :
        (PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word initial hsatInitial).PathActive node,
        (PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word initial hsatInitial).stateAt node =
          path 0 ∧
          ∃ N : Nat,
            ∃ releaseState : root.Subformula,
              ∃ φ ψ : PositiveLTL AP,
                (∀ n : Nat, N ≤ n -> path n = releaseState) ∧
                  releaseState.1 = PositiveLTL.release φ ψ ∧
                    (∀ suffix : AlternatingParityAutomaton.Node,
                      (PositiveLTL.subformulaClosure_guidedRunFrom
                        root interp dec word initial hsatInitial).PathActive
                          (suffix ++ node) ->
                      (PositiveLTL.subformulaClosure_guidedRunFrom
                        root interp dec word initial hsatInitial).stateAt
                          (suffix ++ node) = path suffix.length ->
                      suffix.length < N ->
                        (PositiveLTL.subformulaClosure_guidedRunFrom
                          root interp dec word initial hsatInitial).PathActive
                            (suffix ++ node) ∧
                          (PositiveLTL.subformulaClosure_guidedRunFrom
                            root interp dec word initial hsatInitial).stateAt
                              (suffix ++ node) = path suffix.length ∧
                            ∃ child : Nat,
                              (PositiveLTL.subformulaClosure_guidedRunFrom
                                root interp dec word initial hsatInitial).active
                                  (child :: suffix ++ node) ∧
                                (PositiveLTL.subformulaClosure_guidedRunFrom
                                  root interp dec word initial hsatInitial).stateAt
                                    (child :: suffix ++ node) =
                                  path (suffix.length + 1)) ∧
                      ∀ suffix : AlternatingParityAutomaton.Node,
                        (PositiveLTL.subformulaClosure_guidedRunFrom
                          root interp dec word initial hsatInitial).PathActive
                            (suffix ++ node) ->
                        (PositiveLTL.subformulaClosure_guidedRunFrom
                          root interp dec word initial hsatInitial).stateAt
                            (suffix ++ node) = releaseState ->
                        N ≤ suffix.length ->
                          ¬ PositiveLTL.Satisfies interp
                            (OmegaWord.drop word (suffix ++ node).length) φ := by
  let run :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial
  let sizeSeq : Nat -> Nat := fun n => (path n).1.size
  have hsucc_le : ∀ n, sizeSeq (n + 1) ≤ sizeSeq n := by
    intro n
    have hmove := hdescent (path n, path (n + 1)) (hpath n)
    rcases hmove with hsame | hlt
    · change (path (n + 1)).1.size ≤ (path n).1.size
      rw [hsame]
    · exact Nat.le_of_lt hlt
  rcases nat_eventually_constant_of_succ_le' sizeSeq hsucc_le with
    ⟨N, hN⟩
  have hformulaStable : ∀ n : Nat, N ≤ n -> (path n).1 = (path N).1 := by
    intro n hn
    refine Nat.le_induction ?base ?step n hn
    · rfl
    · intro m hm ih
      have hmove := hdescent (path m, path (m + 1)) (hpath m)
      rcases hmove with hsame | hlt
      · rw [hsame, ih]
      · have hmSize : sizeSeq m = sizeSeq N := hN m hm
        have hsuccSize : sizeSeq (m + 1) = sizeSeq N :=
          hN (m + 1) (Nat.le_trans hm (Nat.le_succ m))
        have hbad : sizeSeq (m + 1) < sizeSeq m := by
          simpa [sizeSeq] using hlt
        rw [hmSize, hsuccSize] at hbad
        exact False.elim (Nat.lt_irrefl _ hbad)
  have hstable : ∀ n : Nat, N ≤ n -> path n = path N := by
    intro n hn
    apply Subtype.ext
    exact hformulaStable n hn
  have hstate_succ : path (N + 1) = path N :=
    hstable (N + 1) (Nat.le_succ N)
  have hselfFormula : (path (N + 1)).1 = (path N).1 := by
    simpa [hstate_succ]
  have htemporal :
      (∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.until φ ψ) ∨
        ∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.release φ ψ := by
    simpa using
      hselfTemporal (path N, path (N + 1)) (hpath N) hselfFormula
  have hrelease :
      ∃ φ ψ : PositiveLTL AP, (path N).1 = PositiveLTL.release φ ψ :=
    PositiveLTL.subformulaClosure_supportWitnessStateEdgesAccepting_stable_temporal_is_release
      root interp dec initial haccepting hpath hformulaStable htemporal
  rcases hrelease with ⟨φ, ψ, hrelease⟩
  have hthreaded :
      run.StatePathThreadedTailRealization path :=
    run.statePathThreadedTailRealization_of_tailCoherentChildren hcoherent
  rcases hthreaded with
    ⟨node, hpathNode, hnodeActive, hnodeState, hstep⟩
  refine ⟨node, hpathNode, hnodeState, N, path N, φ, ψ, hstable, hrelease, ?_, ?_⟩
  · intro suffix hsuffixPath hsuffixState _hlt
    have hsuffixActive :
        (run.subRun node hnodeActive).PathActive suffix :=
      run.subRun_pathActive_of_pathActive_append hnodeActive hsuffixPath
    rcases hstep suffix hsuffixActive hsuffixState with
      ⟨child, hchildActive, hchildState⟩
    exact ⟨hsuffixPath, hsuffixState, child, hchildActive, hchildState⟩
  · intro suffix hsuffixPath hsuffixState hNle
    have hsuffixActive :
        (run.subRun node hnodeActive).PathActive suffix :=
      run.subRun_pathActive_of_pathActive_append hnodeActive hsuffixPath
    have hsuffixStatePath :
        run.stateAt (suffix ++ node) = path suffix.length := by
      exact hsuffixState.trans (hstable suffix.length hNle).symm
    rcases hstep suffix hsuffixActive hsuffixStatePath with
      ⟨child, hchildActive, hchildState⟩
    have hchildStable :
        run.stateAt (child :: suffix ++ node) = path N := by
      exact hchildState.trans
        (hstable (suffix.length + 1)
          (Nat.le_trans hNle (Nat.le_succ _)))
    have hself :
        PositiveLTL.subformulaClosure_guidedRunFromState
            root interp dec word initial hsatInitial
            (child :: suffix ++ node) =
          PositiveLTL.subformulaClosure_guidedRunFromState
            root interp dec word initial hsatInitial
            (suffix ++ node) := by
      simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
        hchildStable.trans hsuffixState.symm
    have hparentRelease :
        (PositiveLTL.subformulaClosure_guidedRunFromState
          root interp dec word initial hsatInitial (suffix ++ node)).1 =
          PositiveLTL.release φ ψ := by
      have hparentState :
          PositiveLTL.subformulaClosure_guidedRunFromState
            root interp dec word initial hsatInitial (suffix ++ node) =
            path N := by
        simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
          hsuffixState
      exact (congrArg Subtype.val hparentState).trans hrelease
    have hactiveParent :
        PositiveLTL.subformulaClosure_guidedRunFromActive
          root interp dec word initial hsatInitial (suffix ++ node) := by
      simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
        (run.pathActive_self (suffix ++ node) hsuffixPath)
    have hactiveChild :
        PositiveLTL.subformulaClosure_guidedRunFromActive
          root interp dec word initial hsatInitial
          (child :: suffix ++ node) := by
      simpa [run, PositiveLTL.subformulaClosure_guidedRunFrom] using
        hchildActive
    exact
      PositiveLTL.subformulaClosure_guidedRunFrom_child_release_self_not_left
        root interp dec word initial hsatInitial (suffix ++ node) child φ ψ
        hactiveParent hactiveChild hparentRelease hself

/--
An accepting descent-shaped tail-coherent pruned support graph supplies the
eventual-release/local-edge target.
-/
theorem PositiveLTL.subformulaClosure_prunedGuidedRunSubgraphEventualReleaseLocalEdges_of_acceptingDescentTailCoherent
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (hgraph :
      PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphAcceptingDescentTailCoherent
        root interp dec) :
    PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphEventualReleaseLocalEdges
      root interp dec := by
  intro state word hsat
  dsimp [PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphAcceptingDescentTailCoherent] at hgraph
  rcases hgraph state word hsat with
    ⟨run, acceptedEdges, hsubset, haccepting, hdescent, hselfTemporal,
      htailCoherent⟩
  refine ⟨run, acceptedEdges, hsubset, ?_⟩
  intro path hpath
  exact
    PositiveLTL.subformulaClosure_guidedRunFrom_eventualReleaseLocalEdges_of_tailCoherent_and_accepting_descent
      root interp dec word state hsat haccepting hdescent hselfTemporal
      hpath (htailCoherent path hpath)

