noncomputable def toDPAStateCompiler
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (compiler :
      CanonicalLTLAPAToMullerStateCompiler.{u, ap, a} AP Letter) :
    CanonicalLTLAPAToDPAStateCompiler.{u, ap, a} AP Letter where
