    simpa [hprefTarget] using htargetStates
  refine ⟨k, pref, hle, hprefSource, hprefTarget, ?_⟩
  intro targetState htargetState
  exact
    hrecurrent (pref.states (k + 1)) htargetMacro (k + 1)
