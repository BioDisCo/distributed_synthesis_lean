/--
Preferred compiler wrapper for the current fixed-point anchor.

The remaining automata soundness obligation is only the selected
source-frontier truth theorem: for every accepted support-witness Muller run,
find one recurring bounded source frontier that is semantically true
arbitrarily far out.  Together with the pruned guided-run completeness
construction, this assembles the full canonical LTL-to-DPA state compiler.
-/
noncomputable def ofSelectedSourceFrontierAndPrunedGuidedRunSubgraphTailBranchRealizable
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    (hfrontier :
      ∀ formula : LTL AP,
        let root := PositiveLTL.ofLTL formula
        let A :=
          (PositiveLTL.subformulaClosure
            (AP := AP)
            (Letter := Letter)
            root).toAPA interp interpDecidable
        ∀ (state : A.State) (word : OmegaWord Letter),
          ∀ haccepts :
            (A.supportWitnessMuller ({state} : Finset A.State)).Accepts word,
            ∃ states,
              states ∈
                (A.supportOperationalWitness_of_supportWitnessMuller_accepts
                  (initialStates := ({state} : Finset A.State))
                  haccepts).macroStates ∧
                (∀ sourceState, sourceState ∈ states ->
                  sourceState.1.size ≤ root.size) ∧
                  ∀ n : Nat,
                    ∃ k : Nat,
                      ∃ pref :
                        A.MacroRunPrefix
                          ({state} : Finset A.State) word (k + 1),
                        n ≤ k ∧
                          pref.states k = states ∧
                            ∀ sourceState, sourceState ∈ states ->
                              sourceState.1.size ≤ root.size ->
                                PositiveLTL.Satisfies interp
                                  (OmegaWord.drop word k) sourceState.1)
    (hpruned :
      ∀ formula : LTL AP,
        PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphTailBranchRealizable
          (PositiveLTL.ofLTL formula) interp interpDecidable) :
    CanonicalLTLAPAToDPAStateCompiler.{u, ap, ap} AP Letter :=
  ofSupportWitnessSoundAndPrunedGuidedRunSubgraphTailBranchRealizable
    interp
    interpDecidable
    (PositiveLTL.subformulaClosure_supportWitnessSound_of_selected_source_frontier
      interp interpDecidable hfrontier)
    hpruned

/--
Compiler wrapper for the root-bound recurrent-invariant target.

This handoff proves support-witness soundness from the root-bound recurrent
source invariant for every canonical subformula APA, then combines it with the
pruned guided-run completeness construction to obtain the reusable canonical
LTL-to-DPA state compiler.
-/
noncomputable def ofRootBoundRecurrentSourceInvariantAndPrunedGuidedRunSubgraphTailBranchRealizable
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    (hrecurrent :
      ∀ formula : LTL AP,
        let root := PositiveLTL.ofLTL formula
        let A :=
          (PositiveLTL.subformulaClosure
            (AP := AP)
            (Letter := Letter)
            root).toAPA interp interpDecidable
        ∀ (state : A.State) (word : OmegaWord Letter),
          ∀ haccepts :
            (A.supportWitnessMuller ({state} : Finset A.State)).Accepts word,
            let witness :=
              A.supportOperationalWitness_of_supportWitnessMuller_accepts
                (initialStates := ({state} : Finset A.State))
                haccepts
            ∀ targetStates,
              targetStates ∈ witness.macroStates ->
                ∀ j : Nat,
                  targetStates ∈
                    A.macroConfigurationRun ({state} : Finset A.State) word j ->
                    ∀ nextState, nextState ∈ targetStates ->
                      nextState.1.size < root.size + 1 ->
                        PositiveLTL.Satisfies interp
                          (OmegaWord.drop word j) nextState.1)
    (hpruned :
      ∀ formula : LTL AP,
        PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphTailBranchRealizable
          (PositiveLTL.ofLTL formula) interp interpDecidable) :
    CanonicalLTLAPAToDPAStateCompiler.{u, ap, ap} AP Letter :=
  ofSupportWitnessSoundAndPrunedGuidedRunSubgraphTailBranchRealizable
    interp
    interpDecidable
    (PositiveLTL.subformulaClosure_supportWitnessSound_of_rootBound_recurrent_source_invariant
      interp interpDecidable hrecurrent)
    hpruned

