      (SynthesisProblem
        (fun word => LTL.Satisfies interp word formula)) :=
  (ofCanonicalFrontendSupportWitnessPrefixAndRationalRunCompiler
    formula
    interp
    interpDecidable
    hpref
    hrealizable
    compiler).synthesis_decidable

