  · intro sourceState hsourceState
    exact Nat.lt_succ_of_le (hsourceBound sourceState hsourceState)
  · intro n
    rcases hoccurs n with
      ⟨k, pref, hle, hprefStates, hsource⟩
    refine ⟨k, pref, hle, hprefStates, ?_⟩
    intro sourceState hsourceState hsourceBoundLt
    exact
      hsource sourceState hsourceState
        (Nat.le_of_lt_succ hsourceBoundLt)

/--
Root-bound recurrent source invariants give canonical support-witness
soundness.

This packages the remaining size-induction target directly at the
`SupportWitnessSound` level.  The invariant only has to prove satisfaction for
