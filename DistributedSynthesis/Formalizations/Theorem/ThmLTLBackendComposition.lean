/--
Compatibility bridge from the older exact recurring-edge guided-run target to
the newer subgraph tail-realizability target.

It chooses the exact recurring-edge finset as the accepted support graph and
uses the generic branch-extraction theorem to turn subtree-local child
coherence into an active branch suffix realizing the abstract path.
-/
theorem PositiveLTL.subformulaClosure_guidedRunSubgraphTailBranchRealizable_of_guidedRunFrom_tailCoherent
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (hguided :
      ∀ (state : root.Subformula) (word : OmegaWord Letter),
        ∀ hsat : PositiveLTL.Satisfies interp word state.1,
          ∀ path : Nat ->
              (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp dec).withInitial state).State,
            (∀ n : Nat,
              (path n, path (n + 1)) ∈
                ((PositiveLTL.subformulaClosure_guidedRunFrom
                  root interp dec word state hsat).realizedEdgeWitnessedMacroRun
                  ).infStateEdgeFinset) ->
              (PositiveLTL.subformulaClosure_guidedRunFrom
                root interp dec word state hsat).StatePathTailCoherentChildren
                  path) :
    PositiveLTL.SubformulaClosureGuidedRunSubgraphTailBranchRealizable
      root interp dec := by
  intro state word hsat
  let runTree :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word state hsat
  refine
    ⟨runTree.realizedEdgeWitnessedMacroRun.infStateEdgeFinset,
      ?_,
      ?_⟩
  · intro edge hedge
    exact hedge
  · intro path hpath
    exact
      runTree.exists_tailRealizingBranch_of_tailCoherentChildren path
        (hguided state word hsat path hpath)

theorem PositiveLTL.subformulaClosure_prunedGuidedRunSubgraphTailBranchRealizable_of_guidedRunSubgraphTailBranchRealizable
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (dec : ∀ ap letter, Decidable (interp ap letter))
    (hguided :
      PositiveLTL.SubformulaClosureGuidedRunSubgraphTailBranchRealizable
        root interp dec) :
    PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphTailBranchRealizable
      root interp dec := by
  intro state word hsat
  rcases hguided state word hsat with
    ⟨acceptedEdges, hsubset, htail⟩
  refine
    ⟨(PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word state hsat).realizedEdgeWitnessedMacroRun,
      acceptedEdges,
      hsubset,
      htail⟩

