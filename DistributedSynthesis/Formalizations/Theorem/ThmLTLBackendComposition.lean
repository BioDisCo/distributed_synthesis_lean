occurrences; the selected-frontier and prefix back-propagation infrastructure
then discharges the support-witness compiler field.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessSound_of_rootBound_recurrent_source_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    (hrecurrent :
      ∀ formula : LTL AP,
        let root := PositiveLTL.ofLTL formula
        let A :=
          (PositiveLTL.subformulaClosure
            (AP := AP)
            (Letter := Letter)
            root).toAPA interp interpDecidable
        ∀ (state : A.State) (word : OmegaWord Letter),
          ∀ haccepts :
            (A.supportWitnessMuller ({state} : Finset A.State)).Accepts word,
            let witness :=
              A.supportOperationalWitness_of_supportWitnessMuller_accepts
                (initialStates := ({state} : Finset A.State))
                haccepts
            ∀ targetStates,
              targetStates ∈ witness.macroStates ->
                ∀ j : Nat,
                  targetStates ∈
                    A.macroConfigurationRun ({state} : Finset A.State) word j ->
                    ∀ nextState, nextState ∈ targetStates ->
                      nextState.1.size < root.size + 1 ->
                        PositiveLTL.Satisfies interp
                          (OmegaWord.drop word j) nextState.1) :
    ∀ formula : LTL AP,
      let A :=
        (PositiveLTL.subformulaClosure
          (AP := AP)
          (Letter := Letter)
          (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
      A.SupportWitnessSound := by
  refine
    PositiveLTL.subformulaClosure_supportWitnessSound_of_selected_source_frontier
      interp interpDecidable ?_
  intro formula
  dsimp only
  let root := PositiveLTL.ofLTL formula
  let A :=
    (PositiveLTL.subformulaClosure
      (AP := AP)
      (Letter := Letter)
      root).toAPA interp interpDecidable
  intro state word haccepts
  exact
    PositiveLTL.subformulaClosure_supportWitnessMuller_selected_source_frontier_of_rootBound_recurrent_source_invariant
      root interp interpDecidable haccepts
      (hrecurrent formula state word haccepts)

/--
Exact one-step back-propagation from a recurrent target frontier.

This is the local anchor step used by the support-witness soundness route: a
concrete macro-transition at time `j` lets a recurrent invariant for the
target macro-configuration at `j + 1` prove all below-bound source formulas at
the exact source time `j`.
-/
theorem PositiveLTL.subformulaClosure_macroTransition_source_frontier_of_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {states targetStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {j bound : Nat}
    (htransition :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).MacroTransition states (word j) targetStates)
    (htargetStates : targetStates ∈ witness.macroStates)
    (htargetConfig :
      targetStates ∈
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).macroConfigurationRun initialStates word (j + 1))
    (hrecurrent :
      ∀ targetStates,
        targetStates ∈ witness.macroStates ->
          ∀ j : Nat,
            targetStates ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun initialStates word j ->
              ∀ nextState, nextState ∈ targetStates ->
                nextState.1.size < bound ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word j) nextState.1) :
    ∀ sourceState, sourceState ∈ states ->
      sourceState.1.size < bound ->
        PositiveLTL.Satisfies interp
          (OmegaWord.drop word j) sourceState.1 := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases A.exists_stateEdges_of_macroTransition htransition with
    ⟨stateEdges, hwithEdges⟩
  have hwithEdgesDrop :
      A.MacroTransitionWithStateEdges
        states ((OmegaWord.drop word j) 0) targetStates stateEdges := by
    simpa [A, OmegaWord.drop] using hwithEdges
  intro sourceState hsourceState hsize
  exact
    PositiveLTL.subformulaClosure_satisfies_of_macroTransition_next_of_size_lt
      root interp interpDecidable
      (OmegaWord.drop word j)
      (states := states)
      (nextStates := targetStates)
      (stateEdges := stateEdges)
      hwithEdgesDrop
      hsourceState
      (bound := bound)
      hsize
      (by
        intro nextState hnextState hnextSize
        simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
          Nat.add_assoc] using
          hrecurrent targetStates htargetStates (j + 1)
            htargetConfig nextState hnextState hnextSize)

/--
Exact one-step back-propagation at a deterministic macro-configuration
occurrence.

Compared with
`subformulaClosure_macroTransition_source_frontier_of_recurrent_invariant`,
this version derives the target occurrence in the macro-configuration run from
the source occurrence and the concrete transition.
-/
theorem PositiveLTL.subformulaClosure_macroConfiguration_source_frontier_of_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
