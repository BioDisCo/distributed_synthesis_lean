  rcases hprefixes n with
    ⟨k, pref, hle, hprefSource, _hprefTarget⟩
  refine ⟨k, pref, hle, by simpa [hsource] using hprefSource, ?_⟩
  intro htarget state hstateMem hsize
  have hstateAtPrefix : state ∈ pref.states k := by
    simpa [hprefSource, hsource] using hstateMem
  have hback :=
    PositiveLTL.subformulaClosure_macroRunPrefix_satisfies_step_back_of_size_lt
      root interp interpDecidable
      (initialStates := initialStates)
      (word := word)
      (n := k)
      (bound := bound)
      pref
      htarget
  exact hback state hstateAtPrefix hsize

/--
Literal states in a selected recurrent macro-state are forced locally by any
concrete progress transition out of that macro-state.

This is the non-circular base case for the recurrent-frontier anchor: unlike
compound temporal states, literals need no semantic assumption about the target
frontier.  The concrete macro transition itself proves that the literal holds
at the source time.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_macroState_lit_progress_satisfies
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
