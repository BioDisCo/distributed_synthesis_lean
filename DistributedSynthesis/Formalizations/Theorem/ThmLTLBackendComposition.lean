/--
Reusable canonical full-LTL-to-DPA compiler backend through the proved
LTL-to-APA frontend and a supplied state-wise APA-to-DPA construction.

Unlike the synthesis-specific records below, this produces the standalone
`LTLToDPACompiler` interface used by other developments.
-/
structure CanonicalLTLAPAToMullerStateCompiler
    (AP : Type ap)
    (Letter : Type u)
    [DecidableEq AP] where
  interp : AP -> Letter -> Prop
  interpDecidable : ∀ ap letter, Decidable (interp ap letter)
  determinize :
    ∀ formula : LTL AP,
      let A :=
        (PositiveLTL.subformulaClosure
          (AP := AP)
          (Letter := Letter)
          (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
      APAToMullerStateCompilation.{u, ap, a}
        A
        ((LTL.canonicalRunLanguageCertificate
          formula interp interpDecidable).toLanguageCertificate)

structure CanonicalLTLAPAToDPAStateCompiler
    (AP : Type ap)
    (Letter : Type u)
    [DecidableEq AP] where
  interp : AP -> Letter -> Prop
  interpDecidable : ∀ ap letter, Decidable (interp ap letter)
  determinize :
    ∀ formula : LTL AP,
      let A :=
        (PositiveLTL.subformulaClosure
          (AP := AP)
          (Letter := Letter)
          (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
      APAToDPAStateCompilation.{u, ap, a}
        A
        ((LTL.canonicalRunLanguageCertificate
          formula interp interpDecidable).toLanguageCertificate)

namespace CanonicalLTLAPAToDPAStateCompiler

/--
Forget the canonical APA internals and expose a reusable certified
LTL-to-DPA compiler.
-/
noncomputable def toLTLToDPACompiler
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (compiler :
      CanonicalLTLAPAToDPAStateCompiler.{u, ap, a} AP Letter) :
    LTLToDPACompiler.{ap, u, a} AP Letter where
  interp := compiler.interp
  compile := fun formula => (compiler.determinize formula).dpa
  correct := by
    intro formula word
    let det := compiler.determinize formula
    trans word ∈
        ((LTL.canonicalRunLanguageCertificate
          formula compiler.interp compiler.interpDecidable).toLanguageCertificate.initialLanguage)
    · exact det.toInitialCompilation.correct word
    · exact
        LTL.canonicalRunLanguageCertificate_initialLanguage_iff
          formula compiler.interp compiler.interpDecidable word

/--
Expose the canonical state-wise APA backend at the narrower `until`
constructor interface.

This is just a projection through `toLTLToDPACompiler`; it is useful when a
main-theorem route is stated in terms of `LTLUntilDPAConstructor`.
-/
noncomputable def toUntilConstructor
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (compiler :
      CanonicalLTLAPAToDPAStateCompiler.{u, ap, a} AP Letter) :
    LTLUntilDPAConstructor.{ap, u, a} compiler.interp :=
  compiler.toLTLToDPACompiler.toUntilConstructor

end CanonicalLTLAPAToDPAStateCompiler

