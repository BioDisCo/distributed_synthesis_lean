    (compiler.determinize formula).toDPAStateCompilation

end CanonicalLTLAPAToMullerStateCompiler

/--
Reusable canonical full-LTL-to-DPA compiler backend through the proved
LTL-to-APA frontend and a supplied APA initial-language determinization.

This is weaker than `CanonicalLTLAPAToDPAStateCompiler`: it asks only for a
DPA recognizing the initial language of each canonical LTL APA, which is
exactly what a direct APA-to-DPA determinization theorem provides.
-/
structure CanonicalLTLAPAToDPACompiler
    (AP : Type ap)
    (Letter : Type u)
    [DecidableEq AP] where
  interp : AP -> Letter -> Prop
  interpDecidable : ∀ ap letter, Decidable (interp ap letter)
  determinize :
    ∀ formula : LTL AP,
      let A :=
        (PositiveLTL.subformulaClosure
          (AP := AP)
          (Letter := Letter)
          (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
      APAToDPACompilation.{u, ap, a}
        A
        ((LTL.canonicalRunLanguageCertificate
          formula interp interpDecidable).toLanguageCertificate)

namespace CanonicalLTLAPAToDPACompiler

/--
Forget the canonical APA internals and expose a reusable certified
LTL-to-DPA compiler.
-/
noncomputable def toLTLToDPACompiler
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (compiler :
      CanonicalLTLAPAToDPACompiler.{u, ap, a} AP Letter) :
    LTLToDPACompiler.{ap, u, a} AP Letter where
  interp := compiler.interp
  compile := fun formula => (compiler.determinize formula).dpa
  correct := by
    intro formula word
    let det := compiler.determinize formula
    trans word ∈
        ((LTL.canonicalRunLanguageCertificate
          formula compiler.interp compiler.interpDecidable).toLanguageCertificate.initialLanguage)
    · exact det.correct word
    · exact
        LTL.canonicalRunLanguageCertificate_initialLanguage_iff
          formula compiler.interp compiler.interpDecidable word

