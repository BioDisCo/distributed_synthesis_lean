progress edge whose target frontier is also below `bound`; then the recurrent
invariant proves the whole target frontier at every concrete realization.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_macroState_progress_bounded_target_frontier_of_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
