  have hchildStateRun :
      (PositiveLTL.subformulaClosure_guidedRunFrom
        root interp dec word initial hsatInitial).stateAt
          (child :: suffix ++ node) = releaseState := by
    have hchildState' :
        PositiveLTL.subformulaClosure_guidedRunFromState
          root interp dec word initial hsatInitial
            (child :: suffix ++ node) = releaseState :=
      hchildState.trans hparentState
    simpa [PositiveLTL.subformulaClosure_guidedRunFrom] using hchildState'
  refine ⟨hsuffixPath, hsuffixState, child, ?_, hchildStateRun⟩
  simpa [PositiveLTL.subformulaClosure_guidedRunFrom] using hchildActive

