      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {states :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    (hstates : states ∈ witness.macroStates)
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    (hstateMem : state ∈ states)
    {literal : LTLLiteral AP}
    (hstate : state.1 = PositiveLTL.lit literal) :
    ∀ n : Nat,
      ∃ k : Nat,
        ∃ pref :
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).MacroRunPrefix initialStates word (k + 1),
          n ≤ k ∧
            pref.states k = states ∧
            PositiveLTL.Satisfies interp
              (OmegaWord.drop word k) state.1 := by
  intro n
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases witness.exists_progress_edge_prefixes hstates with
    ⟨edge, _hedge, hsource, _htargetState, hprefixes⟩
  rcases hprefixes n with
    ⟨k, pref, hle, hprefSource, _hprefTarget⟩
  have hstateAtPrefix : state ∈ pref.states k := by
    simpa [hprefSource, hsource] using hstateMem
  have hmacro :
      A.MacroTransition (pref.states k) (word k) (pref.states (k + 1)) :=
    pref.step_transition k (Nat.lt_succ_self k)
  rcases A.exists_stateEdges_of_macroTransition hmacro with
    ⟨stateEdges, htransition⟩
  have hsat :
      PositiveLTL.Satisfies interp (OmegaWord.drop word k) state.1 := by
    simpa [A, OmegaWord.drop] using
      PositiveLTL.subformulaClosure_macroTransition_lit_satisfies
        root interp interpDecidable
        (OmegaWord.drop word k)
        (states := pref.states k)
        (nextStates := pref.states (k + 1))
        (stateEdges := stateEdges)
        htransition
        hstateAtPrefix
        hstate
  exact ⟨k, pref, hle, by simpa [hsource] using hprefSource, hsat⟩

