/--
Release progress at a concrete recurrent macro-edge occurrence.

This is the coinductive release step at the deterministic macro-edge level:
if the actual target macro-configuration of a concrete occurrence is one of
the recurrent frontiers, the recurrent invariant for strictly smaller target
formulas proves `ψ` now and leaves only the guarded release continuation
`state ∈ edge.2`.
-/
theorem PositiveLTL.subformulaClosure_macroConfigurationEdge_release_progress_of_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {edge :
      APAMacroEdge
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable)}
    {j : Nat}
    (hedgeRun :
      edge ∈
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).macroConfigurationEdgeRun initialStates word j)
    (htargetStates : edge.2 ∈ witness.macroStates)
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    (hstateMem : state ∈ edge.1)
    {φ ψ : PositiveLTL AP}
    (hsource : state.1 = PositiveLTL.release φ ψ)
    (hrecurrent :
      ∀ targetStates,
        targetStates ∈ witness.macroStates ->
          ∀ j : Nat,
            targetStates ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun initialStates word j ->
              ∀ nextState, nextState ∈ targetStates ->
                nextState.1.size < (PositiveLTL.release φ ψ).size ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word j) nextState.1) :
    PositiveLTL.Satisfies interp (OmegaWord.drop word j) ψ ∧
      (PositiveLTL.Satisfies interp (OmegaWord.drop word j) φ ∨
        state ∈ edge.2) := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  have htransition : A.MacroTransition edge.1 (word j) edge.2 :=
    ((A.mem_macroConfigurationEdgeRun initialStates word j edge).mp
      hedgeRun).2
  have htargetConfig :
      edge.2 ∈ A.macroConfigurationRun initialStates word (j + 1) :=
    A.macroConfigurationEdgeRun_target_mem_next hedgeRun
  rcases A.exists_stateEdges_of_macroTransition htransition with
    ⟨stateEdges, hwithEdges⟩
  have hprogress :=
    PositiveLTL.subformulaClosure_macroTransition_release_satisfies_progress_of_smaller
      root interp interpDecidable
      (OmegaWord.drop word j)
      (states := edge.1)
      (nextStates := edge.2)
      (stateEdges := stateEdges)
      hwithEdges
      hstateMem
      hsource
      (by
        intro nextState hnextState hlt
        simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
          Nat.add_assoc] using
          hrecurrent edge.2 htargetStates (j + 1)
            htargetConfig nextState hnextState hlt)
  rcases hprogress with ⟨hψ, hφOrNext⟩
  refine ⟨?_, ?_⟩
  · simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
      Nat.add_assoc] using hψ
  · rcases hφOrNext with hφ | hnext
    · exact Or.inl (by
        simpa [OmegaWord.drop_drop, Nat.add_comm, Nat.add_left_comm,
          Nat.add_assoc] using hφ)
    · exact Or.inr hnext

/--
Selected support macro-edge recurrence gives arbitrarily late release
coinduction steps.

This is the witness-facing wrapper around
`subformulaClosure_macroConfigurationEdge_release_progress_of_recurrent_invariant`.
It turns the operational recurrence evidence for a selected macro-edge into
the timed `ψ ∧ (φ ∨ continuation)` premise needed by release coinduction.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_macroEdge_prefix_release_progress_of_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {edge :
      APAMacroEdge
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable)}
    (hedge : edge ∈ witness.macroEdges)
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    (hstateMem : state ∈ edge.1)
    {φ ψ : PositiveLTL AP}
    (hsource : state.1 = PositiveLTL.release φ ψ)
    (hrecurrent :
      ∀ targetStates,
        targetStates ∈ witness.macroStates ->
          ∀ j : Nat,
            targetStates ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun initialStates word j ->
              ∀ nextState, nextState ∈ targetStates ->
                nextState.1.size < (PositiveLTL.release φ ψ).size ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word j) nextState.1) :
    ∀ n : Nat,
      ∃ k : Nat,
        n ≤ k ∧
          edge ∈
            ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).macroConfigurationEdgeRun initialStates word k ∧
            PositiveLTL.Satisfies interp (OmegaWord.drop word k) ψ ∧
              (PositiveLTL.Satisfies interp (OmegaWord.drop word k) φ ∨
                state ∈ edge.2) := by
  intro n
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases witness.macroEdge_prefixes_mem_macroConfigurationEdgeRun hedge n with
    ⟨k, hle, hedgeRun⟩
  have htargetStates : edge.2 ∈ witness.macroStates :=
    (witness.macroEdges_closed edge hedge).2
  have hprogress :=
    PositiveLTL.subformulaClosure_macroConfigurationEdge_release_progress_of_recurrent_invariant
      root interp interpDecidable witness
      (initialStates := initialStates)
      (word := word)
      (edge := edge)
      (j := k)
      hedgeRun
      htargetStates
      hstateMem
      hsource
      hrecurrent
  exact ⟨k, hle, hedgeRun, hprogress⟩

/--
Selected support macro-state progress gives arbitrarily late release
coinduction steps for a release state in that macro-state.

This packages the operational witness progress edge out of a recurrent
macro-state with the macro-edge release wrapper.  The final recurrent-frontier
anchor can use this at a state `φ R ψ ∈ states` without first choosing the
outgoing macro-edge manually.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_macroState_release_progress_of_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {states :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    (hstates : states ∈ witness.macroStates)
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    (hstateMem : state ∈ states)
    {φ ψ : PositiveLTL AP}
    (hsource : state.1 = PositiveLTL.release φ ψ)
    (hrecurrent :
      ∀ targetStates,
        targetStates ∈ witness.macroStates ->
          ∀ j : Nat,
            targetStates ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun initialStates word j ->
              ∀ nextState, nextState ∈ targetStates ->
                nextState.1.size < (PositiveLTL.release φ ψ).size ->
                  PositiveLTL.Satisfies interp
                    (OmegaWord.drop word j) nextState.1) :
    ∃ edge :
        APAMacroEdge
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable),
      edge ∈ witness.macroEdges ∧
        edge.1 = states ∧
          edge.2 ∈ witness.macroStates ∧
            ∀ n : Nat,
              ∃ k : Nat,
                n ≤ k ∧
                  edge ∈
                    ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                      interp interpDecidable).macroConfigurationEdgeRun
                        initialStates word k ∧
                    PositiveLTL.Satisfies interp
                      (OmegaWord.drop word k) ψ ∧
                      (PositiveLTL.Satisfies interp
                        (OmegaWord.drop word k) φ ∨
                          state ∈ edge.2) := by
  rcases witness.exists_progress_edge_prefixes hstates with
    ⟨edge, hedge, hsourceEdge, htargetEdge, _hprefixes⟩
  have hstateEdge : state ∈ edge.1 := by
    simpa [hsourceEdge] using hstateMem
  refine ⟨edge, hedge, hsourceEdge, htargetEdge, ?_⟩
  exact
    PositiveLTL.subformulaClosure_supportWitness_macroEdge_prefix_release_progress_of_recurrent_invariant
      root interp interpDecidable witness
      (initialStates := initialStates)
      (word := word)
      hedge
      hstateEdge
      hsource
      hrecurrent

/--
Selected support macro-edge recurrence gives arbitrarily late satisfying
source-frontier occurrences, assuming the recurrent invariant for target
frontiers.

This is the witness-facing form needed by the recurrent-anchor construction:
for any selected macro-edge of the operational witness, every sufficiently
late concrete occurrence has a source frontier whose formulas are true.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_macroEdge_prefix_source_frontier_of_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {edge :
      APAMacroEdge
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable)}
    (hedge : edge ∈ witness.macroEdges)
    (hrecurrent :
      ∀ targetStates,
        targetStates ∈ witness.macroStates ->
          ∀ j : Nat,
            targetStates ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun initialStates word j ->
              ∀ nextState, nextState ∈ targetStates ->
                PositiveLTL.Satisfies interp
                  (OmegaWord.drop word j) nextState.1) :
    ∀ n : Nat,
      ∃ k : Nat,
        n ≤ k ∧
          edge ∈
            ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).macroConfigurationEdgeRun initialStates word k ∧
            ∀ sourceState, sourceState ∈ edge.1 ->
              PositiveLTL.Satisfies interp
                (OmegaWord.drop word k) sourceState.1 := by
  intro n
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases witness.macroEdge_prefixes_mem_macroConfigurationEdgeRun hedge n with
    ⟨k, hle, hedgeRun⟩
  have htargetStates : edge.2 ∈ witness.macroStates :=
    (witness.macroEdges_closed edge hedge).2
  refine ⟨k, hle, hedgeRun, ?_⟩
  exact
    PositiveLTL.subformulaClosure_macroConfigurationEdge_source_frontier_of_recurrent_invariant_unbounded
      root interp interpDecidable witness
      (initialStates := initialStates)
      (word := word)
      (edge := edge)
      (j := k)
      hedgeRun
      htargetStates
      hrecurrent

/--
Sampled operational paths carry satisfying source frontiers under the
recurrent invariant.

The support-witness backend now has two ingredients: an operational witness can
choose an infinite sampled path through selected recurring macro-states with
strictly increasing concrete prefix times, and the recurrent invariant proves
truth for selected recurring target frontiers.  This theorem composes them:
at every sampled concrete edge occurrence, the source frontier already
satisfies all represented formulas.

This is intentionally weaker than a consecutive infinite macro-run.  It is the
strongest fact justified directly by the operational witness prefix fields and
is the semantic handoff needed before the final consecutive-tail extraction.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_sampledMacroPath_source_frontier_of_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    (hrecurrent :
      ∀ targetStates,
        targetStates ∈ witness.macroStates ->
          ∀ j : Nat,
            targetStates ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun initialStates word j ->
              ∀ nextState, nextState ∈ targetStates ->
                PositiveLTL.Satisfies interp
                  (OmegaWord.drop word j) nextState.1) :
    ∃ path :
        Nat ->
          Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State),
      ∃ time : Nat -> Nat,
        (∀ n : Nat, path n ∈ witness.macroStates) ∧
          (∀ n : Nat, time n < time (n + 1)) ∧
            ∀ n : Nat,
              ∃ pref :
                ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                  interp interpDecidable).MacroRunPrefix
                    initialStates word (time n + 1),
                pref.states (time n) = path n ∧
                  pref.states (time n + 1) = path (n + 1) ∧
                    ∀ sourceState, sourceState ∈ path n ->
                      PositiveLTL.Satisfies interp
                        (OmegaWord.drop word (time n)) sourceState.1 := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases witness.exists_macroPath_with_increasing_prefixes with
    ⟨path, time, hpath, htime, hprefixes⟩
  refine ⟨path, time, hpath, htime, ?_⟩
  intro n
  rcases hprefixes n with
    ⟨edge, pref, _hedge, hsource, htarget, hprefSource, hprefTarget⟩
  have htargetSat :
      ∀ nextState, nextState ∈ pref.states (time n + 1) ->
        PositiveLTL.Satisfies interp
          (OmegaWord.drop word (time n + 1)) nextState.1 := by
    intro nextState hnextState
    have htargetConfig :
        path (n + 1) ∈
          A.macroConfigurationRun initialStates word (time n + 1) := by
      simpa [A, hprefTarget, htarget] using
        pref.states_mem_macroConfigurationRun (n := time n + 1) le_rfl
    exact
      hrecurrent (path (n + 1)) (hpath (n + 1)) (time n + 1)
        htargetConfig nextState
        (by simpa [hprefTarget, htarget] using hnextState)
  have hsourceSat :
      ∀ sourceState, sourceState ∈ pref.states (time n) ->
        PositiveLTL.Satisfies interp
          (OmegaWord.drop word (time n)) sourceState.1 :=
    PositiveLTL.subformulaClosure_macroRunPrefix_satisfies_step_back
      root interp interpDecidable
      (initialStates := initialStates)
      (word := word)
      (n := time n)
      pref
      htargetSat
  refine ⟨pref, by simpa [hsource] using hprefSource,
    by simpa [htarget] using hprefTarget, ?_⟩
  intro sourceState hsourceState
  exact hsourceSat sourceState
    (by simpa [hprefSource, hsource] using hsourceState)

/--
Sampled source frontiers yield the selected recurrent source-frontier anchor.

The sampled path ranges over finitely many APA macro-states, so some selected
macro-state appears infinitely often along it.  Since the sampled concrete
times are strictly increasing, those occurrences happen arbitrarily far out in
the word.  The previous sampled-path theorem then supplies a satisfying source
frontier at each such occurrence, in the exact form expected by the
selected-frontier compiler hook.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_selected_source_frontier_of_sampledMacroPath_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    (hrecurrent :
      ∀ targetStates,
        targetStates ∈ witness.macroStates ->
          ∀ j : Nat,
            targetStates ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun initialStates word j ->
              ∀ nextState, nextState ∈ targetStates ->
                PositiveLTL.Satisfies interp
                  (OmegaWord.drop word j) nextState.1) :
    ∃ states,
      states ∈ witness.macroStates ∧
        (∀ sourceState, sourceState ∈ states ->
          sourceState.1.size ≤ root.size) ∧
          ∀ n : Nat,
            ∃ k : Nat,
              ∃ pref :
                ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                  interp interpDecidable).MacroRunPrefix
                    initialStates word (k + 1),
                n ≤ k ∧
                  pref.states k = states ∧
                    ∀ sourceState, sourceState ∈ states ->
                      sourceState.1.size ≤ root.size ->
                        PositiveLTL.Satisfies interp
                          (OmegaWord.drop word k) sourceState.1 := by
  classical
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases
    PositiveLTL.subformulaClosure_supportWitness_sampledMacroPath_source_frontier_of_recurrent_invariant
      root interp interpDecidable witness hrecurrent with
    ⟨path, time, hpath, htime, hsamples⟩
  have htime_ge : ∀ n : Nat, n ≤ time n := by
    intro n
    induction n with
    | zero =>
        exact Nat.zero_le (time 0)
    | succ n ih =>
        exact Nat.succ_le_of_lt (Nat.lt_of_le_of_lt ih (htime n))
  obtain ⟨states, hstatesInf⟩ := Finite.exists_infinite_fiber path
  have hfreq : ∃ᶠ n in Filter.atTop, path n = states := by
    rw [Nat.frequently_atTop_iff_infinite]
    simpa [Set.preimage, Set.mem_singleton_iff] using
      (Set.infinite_coe_iff.1 hstatesInf)
  rw [Filter.frequently_atTop] at hfreq
  have hstates : states ∈ witness.macroStates := by
    rcases hfreq 0 with ⟨i, _hi, hpathEq⟩
    simpa [hpathEq] using hpath i
  refine ⟨states, hstates, ?_, ?_⟩
  · intro sourceState _hsourceState
    exact PositiveLTL.size_le_of_mem_subformulas sourceState.2
  · intro n
    rcases hfreq n with ⟨i, hni, hpathEq⟩
    rcases hsamples i with ⟨pref, hprefSource, _hprefTarget, hsourceSat⟩
    refine ⟨time i, pref, ?_, ?_, ?_⟩
    · exact Nat.le_trans hni (htime_ge i)
    · simpa [hpathEq] using hprefSource
    · intro sourceState hsourceState _hsourceBound
      exact hsourceSat sourceState (by simpa [hpathEq] using hsourceState)

/--
Sampled recurrent invariants produce a semantic operational macro-run.

This is the semantic form of the preceding selected-frontier bridge.  A
sampled recurrent source frontier that is semantically true can be converted
to APA acceptance state-by-state by the canonical subformula APA correctness
theorem; splicing that accepting frontier after the finite prefix gives the
`HasSemanticMacroRun` witness used by the operational support-witness route.
-/
theorem PositiveLTL.subformulaClosure_supportOperationalWitness_hasSemanticMacroRun_of_sampled_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    (hrecurrent :
      ∀ targetStates,
        targetStates ∈ witness.macroStates ->
          ∀ j : Nat,
            targetStates ∈
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).macroConfigurationRun initialStates word j ->
              ∀ nextState, nextState ∈ targetStates ->
                PositiveLTL.Satisfies interp
                  (OmegaWord.drop word j) nextState.1) :
    witness.HasSemanticMacroRun := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  rcases
    PositiveLTL.subformulaClosure_supportWitness_selected_source_frontier_of_sampledMacroPath_recurrent_invariant
      root interp interpDecidable witness hrecurrent with
    ⟨states, _hstates, hsourceBound, hoccurs⟩
  rcases hoccurs 0 with
    ⟨k, prefLong, _hle, hprefStates, hsourceSat⟩
  let pref : A.MacroRunPrefix initialStates word k :=
    { states := prefLong.states
      initial_states := prefLong.initial_states
      step_transition := by
        intro n hn
        exact prefLong.step_transition n (by omega) }
  refine witness.hasSemanticMacroRun_of_prefix_accepts pref ?_
  intro state hstate
  have hstateLong : state ∈ prefLong.states k := by
    simpa [pref] using hstate
  have hstateSelected : state ∈ states := by
    simpa [hprefStates] using hstateLong
  exact
    (PositiveLTL.subformulaClosure_acceptsFrom_iff_satisfies
      root interp interpDecidable state (OmegaWord.drop word k)).mpr
      (hsourceSat state hstateSelected
        (hsourceBound state hstateSelected))

/--
Formula-level semantic operational-witness hook from sampled recurrent
invariants.

This is the exact shape needed by the existing operational-semantic compiler
wrappers: prove the recurrent semantic invariant for the accepted support
witness of each canonical subformula APA, and the sampled-frontier bridge
constructs the `HasSemanticMacroRun` certificate.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessOperationalSemantic_of_sampled_recurrent_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    (hrecurrent :
      ∀ formula : LTL AP,
        let root := PositiveLTL.ofLTL formula
        let A :=
          (PositiveLTL.subformulaClosure
            (AP := AP)
            (Letter := Letter)
            root).toAPA interp interpDecidable
        ∀ (state : A.State) (word : OmegaWord Letter),
          ∀ haccepts :
            (A.supportWitnessMuller ({state} : Finset A.State)).Accepts word,
            let witness :=
              A.supportOperationalWitness_of_supportWitnessMuller_accepts
                (initialStates := ({state} : Finset A.State))
                haccepts
            ∀ targetStates,
              targetStates ∈ witness.macroStates ->
                ∀ j : Nat,
                  targetStates ∈
                    A.macroConfigurationRun ({state} : Finset A.State) word j ->
                    ∀ nextState, nextState ∈ targetStates ->
                      PositiveLTL.Satisfies interp
                        (OmegaWord.drop word j) nextState.1) :
    ∀ formula : LTL AP,
      let A :=
        (PositiveLTL.subformulaClosure
          (AP := AP)
          (Letter := Letter)
          (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
      ∀ (state : A.State) (word : OmegaWord Letter),
        ∀ haccepts :
          (A.supportWitnessMuller ({state} : Finset A.State)).Accepts word,
          (A.supportOperationalWitness_of_supportWitnessMuller_accepts
            (initialStates := ({state} : Finset A.State))
            haccepts).HasSemanticMacroRun := by
  intro formula
  dsimp only
  let root := PositiveLTL.ofLTL formula
  let A :=
    (PositiveLTL.subformulaClosure
      (AP := AP)
      (Letter := Letter)
      root).toAPA interp interpDecidable
  intro state word haccepts
  let witness :=
    A.supportOperationalWitness_of_supportWitnessMuller_accepts
      (initialStates := ({state} : Finset A.State))
      haccepts
  exact
    PositiveLTL.subformulaClosure_supportOperationalWitness_hasSemanticMacroRun_of_sampled_recurrent_invariant
      root interp interpDecidable witness
      (hrecurrent formula state word haccepts)

/--
Successor-bound variant of
`subformulaClosure_supportWitnessMuller_prefixSatisfies_of_bounded_progress_target_frontier`.

Many size-induction hypotheses are naturally stated with `≤ bound`.  This
wrapper turns those obligations into the strict `< bound + 1` form expected by
the bounded back-propagation lemma.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessMuller_prefixSatisfies_of_leBound_progress_target_frontier
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    (haccepts :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).supportWitnessMuller
          ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))).Accepts word)
    {bound : Nat}
    (hfrontier :
      ∃ states,
        states ∈
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).supportOperationalWitness_of_supportWitnessMuller_accepts
              (initialStates := ({state} : Finset
                (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                  interp interpDecidable).State)))
              haccepts).macroStates ∧
          (∀ sourceState, sourceState ∈ states -> sourceState.1.size ≤ bound) ∧
            ∀ n : Nat,
              ∃ k : Nat,
                ∃ pref :
                  ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                    interp interpDecidable).MacroRunPrefix ({state} : Finset
                      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                        interp interpDecidable).State)) word (k + 1),
                  n ≤ k ∧
                    pref.states k = states ∧
                      ∀ nextState, nextState ∈ pref.states (k + 1) ->
                        nextState.1.size ≤ bound ->
                          PositiveLTL.Satisfies interp
                            (OmegaWord.drop word (k + 1)) nextState.1) :
    ∃ offset : Nat,
      ∃ pref :
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).MacroRunPrefix ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State)) word offset,
        ∀ nextState, nextState ∈ pref.states offset ->
          PositiveLTL.Satisfies interp
            (OmegaWord.drop word offset) nextState.1 := by
  refine
    PositiveLTL.subformulaClosure_supportWitnessMuller_prefixSatisfies_of_bounded_progress_target_frontier
      root interp interpDecidable haccepts
      (bound := bound + 1)
      ?_
  rcases hfrontier with ⟨states, hstates, hsourceBound, hoccurs⟩
  refine ⟨states, hstates, ?_, ?_⟩
  · intro sourceState hsourceState
    exact Nat.lt_succ_of_le (hsourceBound sourceState hsourceState)
  · intro n
    rcases hoccurs n with
      ⟨k, pref, hle, hprefStates, htarget⟩
    refine ⟨k, pref, hle, hprefStates, ?_⟩
    intro nextState hnextState hnextBound
    exact htarget nextState hnextState (Nat.le_of_lt_succ hnextBound)

/--
Successor-bound variant of
`subformulaClosure_supportWitnessMuller_prefixSatisfies_of_bounded_progress_source_frontier`.

This is the source-frontier counterpart of
`subformulaClosure_supportWitnessMuller_prefixSatisfies_of_leBound_progress_target_frontier`.
It matches induction hypotheses stated with `≤ bound` after the bounded
source progress step has already propagated target truth back to the selected
source frontier.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessMuller_prefixSatisfies_of_leBound_progress_source_frontier
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    (haccepts :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).supportWitnessMuller
          ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))).Accepts word)
    {bound : Nat}
    (hfrontier :
      ∃ states,
        states ∈
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).supportOperationalWitness_of_supportWitnessMuller_accepts
              (initialStates := ({state} : Finset
                (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                  interp interpDecidable).State)))
              haccepts).macroStates ∧
          (∀ sourceState, sourceState ∈ states -> sourceState.1.size ≤ bound) ∧
            ∀ n : Nat,
              ∃ k : Nat,
                ∃ pref :
                  ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                    interp interpDecidable).MacroRunPrefix ({state} : Finset
                      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                        interp interpDecidable).State)) word (k + 1),
                  n ≤ k ∧
                    pref.states k = states ∧
                      ∀ sourceState, sourceState ∈ states ->
                        sourceState.1.size ≤ bound ->
                          PositiveLTL.Satisfies interp
                            (OmegaWord.drop word k) sourceState.1) :
    ∃ offset : Nat,
      ∃ pref :
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).MacroRunPrefix ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State)) word offset,
        ∀ nextState, nextState ∈ pref.states offset ->
          PositiveLTL.Satisfies interp
            (OmegaWord.drop word offset) nextState.1 := by
  refine
    PositiveLTL.subformulaClosure_supportWitnessMuller_prefixSatisfies_of_bounded_progress_source_frontier
      root interp interpDecidable haccepts
      (bound := bound + 1)
      ?_
  rcases hfrontier with ⟨states, hstates, hsourceBound, hoccurs⟩
  refine ⟨states, hstates, ?_, ?_⟩
  · intro sourceState hsourceState
    exact Nat.lt_succ_of_le (hsourceBound sourceState hsourceState)
  · intro n
    rcases hoccurs n with
      ⟨k, pref, hle, hprefStates, hsource⟩
    refine ⟨k, pref, hle, hprefStates, ?_⟩
    intro sourceState hsourceState hsourceBoundLt
    exact hsource sourceState hsourceState (Nat.le_of_lt_succ hsourceBoundLt)

/--
Successor-bound recurrent-invariant hook using the source-frontier route.

This is the `≤ bound` interface for the final size induction.  It packages a
selected recurrent frontier bounded by `bound` together with a recurrent
invariant for all selected frontiers up to the same bound, then delegates to
the strict bounded source-invariant theorem at `bound + 1`.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessMuller_prefixSatisfies_of_leBound_recurrent_source_invariant
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    (haccepts :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).supportWitnessMuller
          ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))).Accepts word)
    {bound : Nat}
    (hfrontier :
      ∃ states,
        states ∈
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).supportOperationalWitness_of_supportWitnessMuller_accepts
              (initialStates := ({state} : Finset
                (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                  interp interpDecidable).State)))
              haccepts).macroStates ∧
          (∀ sourceState, sourceState ∈ states -> sourceState.1.size ≤ bound) ∧
            ∀ targetStates,
              targetStates ∈
                (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                  interp interpDecidable).supportOperationalWitness_of_supportWitnessMuller_accepts
                    (initialStates := ({state} : Finset
                      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                        interp interpDecidable).State)))
                    haccepts).macroStates ->
                ∀ j : Nat,
                  targetStates ∈
                    ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                      interp interpDecidable).macroConfigurationRun
                        ({state} : Finset
                          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                            interp interpDecidable).State)) word j ->
                    ∀ nextState, nextState ∈ targetStates ->
                      nextState.1.size ≤ bound ->
                        PositiveLTL.Satisfies interp
                          (OmegaWord.drop word j) nextState.1) :
    ∃ offset : Nat,
      ∃ pref :
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).MacroRunPrefix ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State)) word offset,
        ∀ nextState, nextState ∈ pref.states offset ->
          PositiveLTL.Satisfies interp
            (OmegaWord.drop word offset) nextState.1 := by
  refine
    PositiveLTL.subformulaClosure_supportWitnessMuller_prefixSatisfies_of_bounded_recurrent_source_invariant
      root interp interpDecidable haccepts
      (bound := bound + 1)
      ?_
  rcases hfrontier with ⟨states, hstates, hsourceBound, hrecurrent⟩
  refine ⟨states, hstates, ?_, ?_⟩
  · intro sourceState hsourceState
    exact Nat.lt_succ_of_le (hsourceBound sourceState hsourceState)
  · intro targetStates htargetStates j htargetConfig nextState hnextState hnextBound
    exact
      hrecurrent targetStates htargetStates j htargetConfig
        nextState hnextState (Nat.le_of_lt_succ hnextBound)

/--
Accepted support-witness runs with a size-one recurring frontier already
provide the formula-frontier prefix required by the operational-prefix route.

This packages the base case of the recurrent-frontier argument at the same
interface as the final `prefixSatisfies` theorem.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessMuller_prefixSatisfies_of_size_one_recurrent_frontier
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    (haccepts :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).supportWitnessMuller
          ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))).Accepts word)
    (hfrontier :
      ∃ states,
        states ∈
          (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).supportOperationalWitness_of_supportWitnessMuller_accepts
              (initialStates := ({state} : Finset
                (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                  interp interpDecidable).State)))
              haccepts).macroStates ∧
          ∀ nextState, nextState ∈ states -> nextState.1.size = 1) :
    ∃ offset : Nat,
      ∃ pref :
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).MacroRunPrefix ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State)) word offset,
        ∀ nextState, nextState ∈ pref.states offset ->
          PositiveLTL.Satisfies interp
            (OmegaWord.drop word offset) nextState.1 := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  let witness :=
    A.supportOperationalWitness_of_supportWitnessMuller_accepts
      (initialStates := ({state} : Finset A.State))
      haccepts
  rcases hfrontier with ⟨states, hstates, hsize⟩
  rcases
    PositiveLTL.subformulaClosure_supportWitness_macroState_size_one_progress_frontier_satisfies
      root interp interpDecidable witness hstates hsize 0 with
    ⟨k, prefLong, _hle, hprefStates, hsat⟩
  let pref : A.MacroRunPrefix ({state} : Finset A.State) word k :=
    { states := prefLong.states
      initial_states := prefLong.initial_states
      step_transition := by
        intro n hn
        exact prefLong.step_transition n (by omega) }
  refine ⟨k, pref, ?_⟩
  intro nextState hnextState
  exact hsat nextState (by simpa [pref, hprefStates] using hnextState)

/--
Root-size-one accepted support-witness runs expose a satisfying frontier.

This removes the explicit size-one frontier premise from
`subformulaClosure_supportWitnessMuller_prefixSatisfies_of_size_one_recurrent_frontier`.
If the root has size one, every canonical subformula state has size one, so
any nonempty recurring support frontier is already a size-one frontier.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessMuller_prefixSatisfies_of_root_size_one
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    (hroot : root.size = 1)
    (haccepts :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).supportWitnessMuller
          ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))).Accepts word) :
    ∃ offset : Nat,
      ∃ pref :
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).MacroRunPrefix ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State)) word offset,
        ∀ nextState, nextState ∈ pref.states offset ->
          PositiveLTL.Satisfies interp
            (OmegaWord.drop word offset) nextState.1 := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  let witness :=
    A.supportOperationalWitness_of_supportWitnessMuller_accepts
      (initialStates := ({state} : Finset A.State))
      haccepts
  rcases witness.macroStates_nonempty with ⟨states, hstates⟩
  refine
    PositiveLTL.subformulaClosure_supportWitnessMuller_prefixSatisfies_of_size_one_recurrent_frontier
      root interp interpDecidable haccepts ?_
  refine ⟨states, hstates, ?_⟩
  intro nextState _hnextState
  have hle : nextState.1.size ≤ root.size :=
    PositiveLTL.size_le_of_mem_subformulas nextState.2
  have hpos : 0 < nextState.1.size :=
    PositiveLTL.size_pos nextState.1
  omega

/--
Root-size-one accepted support-witness runs expose an accepting frontier.

This is the APA-continuation form of
`subformulaClosure_supportWitnessMuller_prefixSatisfies_of_root_size_one`.
The formula frontier is converted to APA acceptance by the proved correctness
of the canonical subformula APA.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessMuller_prefixAccepts_of_root_size_one
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    (hroot : root.size = 1)
    (haccepts :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).supportWitnessMuller
          ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))).Accepts word) :
    ∃ offset : Nat,
      ∃ pref :
        ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).MacroRunPrefix ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State)) word offset,
        ∀ nextState, nextState ∈ pref.states offset ->
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable).AcceptsFrom nextState
              (OmegaWord.drop word offset) := by
  rcases
    PositiveLTL.subformulaClosure_supportWitnessMuller_prefixSatisfies_of_root_size_one
      root interp interpDecidable hroot haccepts with
    ⟨offset, pref, hfrontier⟩
  refine ⟨offset, pref, ?_⟩
  intro nextState hnextState
  exact
    (PositiveLTL.subformulaClosure_acceptsFrom_iff_satisfies
      root interp interpDecidable nextState
        (OmegaWord.drop word offset)).mpr
      (hfrontier nextState hnextState)

/--
Support-witness soundness is fully proved for canonical subformula APAs whose
root has size one.

This closes the base case of the recurrent-frontier soundness induction:
accepted support-witness Muller runs provide an accepting finite frontier, and
the generic operational-prefix theorem reconstructs APA acceptance from that
frontier.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessSound_of_root_size_one
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    (hroot : root.size = 1) :
    ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable).SupportWitnessSound := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  exact
    A.supportWitnessSound_of_operationalWitness_prefix_accepts
      (by
        intro state word haccepts
        exact
          PositiveLTL.subformulaClosure_supportWitnessMuller_prefixAccepts_of_root_size_one
            root interp interpDecidable hroot haccepts)

/--
Root-size-one accepted support-witness runs satisfy the selected source-frontier
anchor.

This is the base case in exactly the interface expected by
`subformulaClosure_supportWitnessSound_of_selected_source_frontier`: choose
any recurring support macro-state.  Because the root has size one, every state
in the canonical closure has size one, and the existing size-one progress
lemma gives arbitrarily late concrete source frontiers that are already true.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessMuller_selected_source_frontier_of_root_size_one
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    (hroot : root.size = 1)
    (haccepts :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).supportWitnessMuller
          ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))).Accepts word) :
    let A :=
      (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable
    ∃ states,
      states ∈
        (A.supportOperationalWitness_of_supportWitnessMuller_accepts
          (initialStates := ({state} : Finset A.State))
          haccepts).macroStates ∧
        (∀ sourceState, sourceState ∈ states ->
          sourceState.1.size ≤ root.size) ∧
          ∀ n : Nat,
            ∃ k : Nat,
              ∃ pref : A.MacroRunPrefix ({state} : Finset A.State) word (k + 1),
                n ≤ k ∧
                  pref.states k = states ∧
                    ∀ sourceState, sourceState ∈ states ->
                      sourceState.1.size ≤ root.size ->
                        PositiveLTL.Satisfies interp
                          (OmegaWord.drop word k) sourceState.1 := by
  dsimp only
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  let witness :=
    A.supportOperationalWitness_of_supportWitnessMuller_accepts
      (initialStates := ({state} : Finset A.State))
      haccepts
  rcases witness.macroStates_nonempty with ⟨states, hstates⟩
  have hsizeEq :
      ∀ sourceState, sourceState ∈ states -> sourceState.1.size = 1 := by
    intro sourceState _hsourceState
    have hle : sourceState.1.size ≤ root.size :=
      PositiveLTL.size_le_of_mem_subformulas sourceState.2
    have hpos : 0 < sourceState.1.size :=
      PositiveLTL.size_pos sourceState.1
    omega
  refine ⟨states, hstates, ?_, ?_⟩
  · intro sourceState hsourceState
    have hle : sourceState.1.size ≤ root.size :=
      PositiveLTL.size_le_of_mem_subformulas sourceState.2
    exact hle
  · intro n
    rcases
      PositiveLTL.subformulaClosure_supportWitness_macroState_size_one_progress_frontier_satisfies
        root interp interpDecidable witness hstates hsizeEq n with
      ⟨k, pref, hle, hprefStates, hsat⟩
    refine ⟨k, pref, hle, hprefStates, ?_⟩
    intro sourceState hsourceState _hsourceBound
    exact hsat sourceState hsourceState

/--
Support-witness Muller soundness is immediate for singleton literal states of
the canonical subformula APA.

An accepting support-witness run must expose some recurring macro-state
arbitrarily late.  Taking such an occurrence after time `0` gives a concrete
first macro transition out of the singleton literal state, and the canonical
literal transition can succeed only when the literal is true on the current
letter.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessMuller_lit_accepts_satisfies
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    {literal : LTLLiteral AP}
    (hstate : state.1 = PositiveLTL.lit literal)
    (haccepts :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).supportWitnessMuller
          ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))).Accepts word) :
    PositiveLTL.Satisfies interp word state.1 := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  let witness :=
    A.supportOperationalWitness_of_supportWitnessMuller_accepts
      (initialStates := ({state} : Finset A.State))
      haccepts
  rcases witness.macroStates_nonempty with ⟨states, hstates⟩
  rcases witness.macroState_prefixes states hstates 1 with
    ⟨k, pref, hk, _hprefEnd⟩
  have hkpos : 0 < k := by omega
  have hstateMem : state ∈ pref.states 0 := by
    simpa [pref.initial_states]
  have hmacro :
      A.MacroTransition (pref.states 0) (word 0) (pref.states (0 + 1)) :=
    pref.step_transition 0 hkpos
  rcases A.exists_stateEdges_of_macroTransition hmacro with
    ⟨stateEdges, htransition⟩
  simpa [A, OmegaWord.drop] using
    PositiveLTL.subformulaClosure_macroTransition_lit_satisfies
      root interp interpDecidable
      word
      (states := pref.states 0)
      (nextStates := pref.states (0 + 1))
      (stateEdges := stateEdges)
      htransition
      hstateMem
      hstate

/--
`⊤` singleton support-witness soundness is immediate.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessMuller_verum_accepts_satisfies
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    (hstate : state.1 = PositiveLTL.verum)
    (_haccepts :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).supportWitnessMuller
          ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))).Accepts word) :
    PositiveLTL.Satisfies interp word state.1 := by
  simpa [hstate, PositiveLTL.Satisfies]

/--
`⊥` singleton support-witness soundness is impossible and therefore closes by
the first concrete transition exposed by acceptance.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessMuller_falsum_accepts_satisfies
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    (hstate : state.1 = PositiveLTL.falsum)
    (haccepts :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).supportWitnessMuller
          ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))).Accepts word) :
    PositiveLTL.Satisfies interp word state.1 := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
      interp interpDecidable
  let witness :=
    A.supportOperationalWitness_of_supportWitnessMuller_accepts
      (initialStates := ({state} : Finset A.State))
      haccepts
  rcases witness.macroStates_nonempty with ⟨states, hstates⟩
  rcases witness.macroState_prefixes states hstates 1 with
    ⟨k, pref, hk, _hprefEnd⟩
  have hkpos : 0 < k := by omega
  have hstateMem : state ∈ pref.states 0 := by
    simpa [pref.initial_states]
  have hmacro :
      A.MacroTransition (pref.states 0) (word 0) (pref.states (0 + 1)) :=
    pref.step_transition 0 hkpos
  rcases A.exists_stateEdges_of_macroTransition hmacro with
    ⟨stateEdges, htransition⟩
  simpa [A, OmegaWord.drop] using
    PositiveLTL.subformulaClosure_macroTransition_falsum_satisfies
      root interp interpDecidable
      word
      (states := pref.states 0)
      (nextStates := pref.states (0 + 1))
      (stateEdges := stateEdges)
      htransition
      hstateMem
      hstate

/--
Combined singleton support-witness soundness for the non-temporal base
formulas of the canonical subformula APA.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessMuller_base_accepts_satisfies
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    (hbase :
      state.1 = PositiveLTL.verum ∨
        state.1 = PositiveLTL.falsum ∨
          ∃ literal : LTLLiteral AP, state.1 = PositiveLTL.lit literal)
    (haccepts :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).supportWitnessMuller
          ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))).Accepts word) :
    PositiveLTL.Satisfies interp word state.1 := by
  rcases hbase with hstate | hbase
  · exact
      PositiveLTL.subformulaClosure_supportWitnessMuller_verum_accepts_satisfies
        root interp interpDecidable hstate haccepts
  rcases hbase with hstate | hlit
  · exact
      PositiveLTL.subformulaClosure_supportWitnessMuller_falsum_accepts_satisfies
        root interp interpDecidable hstate haccepts
  rcases hlit with ⟨literal, hstate⟩
  exact
    PositiveLTL.subformulaClosure_supportWitnessMuller_lit_accepts_satisfies
      root interp interpDecidable (literal := literal) hstate haccepts

/--
Size-one singleton support-witness soundness for the canonical subformula APA.

This is the base case for the planned strong induction over positive LTL
formula size.
-/
theorem PositiveLTL.subformulaClosure_supportWitnessMuller_size_one_accepts_satisfies
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {state :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).State}
    {word : OmegaWord Letter}
    (hsize : state.1.size = 1)
    (haccepts :
      (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).supportWitnessMuller
          ({state} : Finset
            (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
              interp interpDecidable).State))).Accepts word) :
    PositiveLTL.Satisfies interp word state.1 := by
  rcases state with ⟨formula, hformula⟩
  cases formula with
  | verum =>
      exact
        PositiveLTL.subformulaClosure_supportWitnessMuller_verum_accepts_satisfies
          root interp interpDecidable rfl haccepts
  | falsum =>
      exact
        PositiveLTL.subformulaClosure_supportWitnessMuller_falsum_accepts_satisfies
          root interp interpDecidable rfl haccepts
  | lit literal =>
      exact
        PositiveLTL.subformulaClosure_supportWitnessMuller_lit_accepts_satisfies
          root interp interpDecidable (literal := literal) rfl haccepts
  | conj φ ψ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      have hψpos : 0 < ψ.size := PositiveLTL.size_pos ψ
      simp [PositiveLTL.size] at hsize
      omega
  | disj φ ψ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      have hψpos : 0 < ψ.size := PositiveLTL.size_pos ψ
      simp [PositiveLTL.size] at hsize
      omega
  | next φ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      simp [PositiveLTL.size] at hsize
      omega
  | «until» φ ψ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      have hψpos : 0 < ψ.size := PositiveLTL.size_pos ψ
      simp [PositiveLTL.size] at hsize
      omega
  | «release» φ ψ =>
      have hφpos : 0 < φ.size := PositiveLTL.size_pos φ
      have hψpos : 0 < ψ.size := PositiveLTL.size_pos ψ
      simp [PositiveLTL.size] at hsize
      omega

/--
Bounded back-propagation from macro-state progress prefixes.

This is the macro-state analogue of
`subformulaClosure_supportWitness_stateEdge_prefix_satisfies_back_of_smaller`:
choose a recurrent outgoing progress edge and propagate only formulas below
the current induction bound through each concrete occurrence.
-/
theorem PositiveLTL.subformulaClosure_supportWitness_macroState_progress_prefix_satisfies_back_of_smaller
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (root : PositiveLTL AP)
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    {initialStates :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    {word : OmegaWord Letter}
    {infStates :
      Set
        (APASupportConfigurationState
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable))}
    (witness :
      ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
        interp interpDecidable).SupportOperationalWitness
          initialStates word infStates)
    {states :
      Finset
        (((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
          interp interpDecidable).State)}
    (hstates : states ∈ witness.macroStates)
    {bound : Nat} :
    ∃ edge :
        APAMacroEdge
          ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
            interp interpDecidable),
      edge ∈ witness.macroEdges ∧
        edge.1 = states ∧
        edge.2 ∈ witness.macroStates ∧
        ∀ n : Nat,
          ∃ k : Nat,
            ∃ pref :
              ((PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
                interp interpDecidable).MacroRunPrefix initialStates word (k + 1),
              n ≤ k ∧
                pref.states k = edge.1 ∧
                pref.states (k + 1) = edge.2 ∧
                ((∀ nextState, nextState ∈ pref.states (k + 1) ->
                    nextState.1.size < bound ->
                      PositiveLTL.Satisfies interp
                        (OmegaWord.drop word (k + 1)) nextState.1) ->
                  ∀ m, m ≤ k + 1 ->
                    ∀ state, state ∈ pref.states m ->
                      state.1.size < bound ->
                        PositiveLTL.Satisfies interp
                          (OmegaWord.drop word m) state.1) := by
  let A :=
    (PositiveLTL.subformulaClosure (Letter := Letter) root).toAPA
