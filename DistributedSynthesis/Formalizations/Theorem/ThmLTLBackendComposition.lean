              haccepts).HasSemanticMacroRun)
    (hpruned :
      ∀ formula : LTL AP,
        PositiveLTL.SubformulaClosurePrunedGuidedRunSubgraphTailBranchRealizable
          (PositiveLTL.ofLTL formula) interp interpDecidable) :
    CanonicalLTLAPAToMullerStateCompiler.{u, ap, ap} AP Letter :=
  ofSupportWitnessOperationalSemanticAndExistsEdgeWitnessedMacroRunSubgraphAccepting
    interp
    interpDecidable
    hsemantic
    (fun formula =>
      PositiveLTL.subformulaClosure_supportWitnessExistsEdgeWitnessedMacroRunSubgraphAccepting_of_prunedGuided
        (PositiveLTL.ofLTL formula) interp interpDecidable (hpruned formula))

/--
Prefix-continuation soundness Muller-state compiler wrapper for the flexible
edge-witnessed macro-run endpoint.
-/
noncomputable def ofSupportWitnessOperationalPrefixAndExistsEdgeWitnessedMacroRunSubgraphAccepting
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    (hpref :
      ∀ formula : LTL AP,
        let A :=
          (PositiveLTL.subformulaClosure
            (AP := AP)
            (Letter := Letter)
            (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
        ∀ (state : A.State) (word : OmegaWord Letter),
          ∀ haccepts :
            (A.supportWitnessMuller ({state} : Finset A.State)).Accepts word,
            ∃ offset : Nat,
              ∃ pref : A.MacroRunPrefix ({state} : Finset A.State) word offset,
                ∀ nextState, nextState ∈ pref.states offset ->
                  A.AcceptsFrom nextState (OmegaWord.drop word offset))
    (hwitness :
      ∀ formula : LTL AP,
        let A :=
          (PositiveLTL.subformulaClosure
            (AP := AP)
            (Letter := Letter)
            (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
        A.SupportWitnessExistsEdgeWitnessedMacroRunSubgraphAccepting) :
    CanonicalLTLAPAToMullerStateCompiler.{u, ap, ap} AP Letter where
  interp := interp
  interpDecidable := interpDecidable
  determinize := by
    intro formula
    exact
      let A :=
        (PositiveLTL.subformulaClosure
          (AP := AP)
          (Letter := Letter)
          (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
      A.supportWitnessMullerRunStateCompilationOfOperationalPrefixAndExistsEdgeWitnessedMacroRunSubgraphAccepting
        (LTL.canonicalRunLanguageCertificate formula interp interpDecidable)
        (hpref formula)
        (hwitness formula)

