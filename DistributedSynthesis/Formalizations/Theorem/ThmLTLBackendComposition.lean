            (suffix ++ node) = path suffix.length ->
        suffix.length < N ->
          (PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).StateEdgeRealizedFromNode
              (suffix ++ node)
              (path suffix.length, path (suffix.length + 1)))
    (hselfRealized :
      ∀ suffix : AlternatingParityAutomaton.Node,
        (PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word initial hsatInitial).PathActive
            (suffix ++ node) ->
        (PositiveLTL.subformulaClosure_guidedRunFrom
          root interp dec word initial hsatInitial).stateAt
            (suffix ++ node) = releaseState ->
        N ≤ suffix.length ->
          (PositiveLTL.subformulaClosure_guidedRunFrom
            root interp dec word initial hsatInitial).StateEdgeRealizedFromNode
              (suffix ++ node) (releaseState, releaseState)) :
    (PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial).StatePathTailCoherentChildren
        path := by
  let run :=
    PositiveLTL.subformulaClosure_guidedRunFrom
      root interp dec word initial hsatInitial
  have hnodeActive : run.active node :=
    run.pathActive_self node hpathNode
  have hthreaded :
      run.StatePathThreadedTailRealization path := by
    refine
      run.statePathThreadedTailRealization_of_nodeLocalEdges
        hpathNode hnodeState ?_
    intro suffix _hnodeActive hsuffixActive hsuffixState
    have hsuffixPath :
