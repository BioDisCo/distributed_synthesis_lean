  rcases hpaths path hpath with
    ⟨node, hpathNode, hnodeState, N, releaseState, φ, ψ,
      hstable, hrelease, hprefix, hnotLeft⟩
  exact
    PositiveLTL.subformulaClosure_guidedRunFrom_eventually_constant_release_tailCoherent_of_prefixEdges_and_not_left
      root interp dec word state hsat N releaseState φ ψ
      hstable hrelease node hpathNode hnodeState hprefix hnotLeft

