/--
Canonical full-LTL backend routed through actual APA run-tree semantics.

Compared with `CanonicalLTLBackendCompilation`, this record does not
determinize only the semantic language certificate.  It requires a
run-language certificate connecting the canonical subformula APA's run-tree
acceptance to a state-indexed language, a proof that the initial run language
is the positive-normal-form LTL semantics, and a run-semantics determinization
certificate for the APA itself.
-/
structure CanonicalLTLRunBackendCompilation
    (AP : Type ap)
    (In₁ : Type u)
    (In₂ : Type v)
    (Out₁ : Type x)
    (Out₂ : Type y)
    [DecidableEq AP] where
  formula : LTL AP
  interp : AP -> RoundRecord In₁ In₂ Graph Out₁ Out₂ -> Prop
  interpDecidable : ∀ ap letter, Decidable (interp ap letter)
  runCertificate :
    ((PositiveLTL.subformulaClosure
      (AP := AP)
      (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
      (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable).RunLanguageCertificate
  runLanguageCorrect :
    ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      word ∈ runCertificate.toLanguageCertificate.initialLanguage ↔
        PositiveLTL.Satisfies interp word (PositiveLTL.ofLTL formula)
  determinization :
    APARunToDPACompilation.{max u v x y, ap, a}
      ((PositiveLTL.subformulaClosure
        (AP := AP)
        (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
        (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable)
  finiteGameCompilation :
    DPAToFiniteGameCompilation.{u, v, x, y, b}
      Out₂
      determinization.dpa

/--
Build the run-semantics full-LTL backend using the canonical LTL-to-APA
run-language certificate.  The remaining supplied data are exactly APA
run-determinization and finite-game compilation for the resulting DPA.
-/
noncomputable def CanonicalLTLRunBackendCompilation.ofCanonicalFrontend
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (formula : LTL AP)
    (interp : AP -> RoundRecord In₁ In₂ Graph Out₁ Out₂ -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    (determinization :
      APARunToDPACompilation.{max u v x y, ap, a}
        ((PositiveLTL.subformulaClosure
          (AP := AP)
          (Letter := RoundRecord In₁ In₂ Graph Out₁ Out₂)
          (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable))
    (finiteGameCompilation :
      DPAToFiniteGameCompilation.{u, v, x, y, b}
        Out₂
        determinization.dpa) :
    CanonicalLTLRunBackendCompilation.{u, v, x, y, ap, a, b}
      AP In₁ In₂ Out₁ Out₂ where
  formula := formula
  interp := interp
  interpDecidable := interpDecidable
  runCertificate :=
    LTL.canonicalRunLanguageCertificate formula interp interpDecidable
  runLanguageCorrect :=
    LTL.canonicalRunLanguageCertificate_initialLanguage_iff_positive
      formula interp interpDecidable
  determinization := determinization
  finiteGameCompilation := finiteGameCompilation

/--
The canonical run-semantics full-LTL backend yields the effective parity
specification with the original full-LTL predicate.
-/
def CanonicalLTLRunBackendCompilation.toEffectiveParitySpecification
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert : CanonicalLTLRunBackendCompilation.{u, v, x, y, ap, a, b}
      AP In₁ In₂ Out₁ Out₂) :
    EffectiveParitySpecification.{u, v, x, y, b, max u v x y} In₁ In₂ Out₁ Out₂ where
  predicate := fun word => LTL.Satisfies cert.interp word cert.formula
  finiteGame := cert.finiteGameCompilation.finiteGame
  realizabilityEquivalent := by
    rw [cert.finiteGameCompilation.realizabilityEquivalent]
    constructor
    · intro h
      rcases h with ⟨σ, hσ⟩
      exact ⟨σ, fun env =>
        (PositiveLTL.satisfies_ofLTL cert.interp
          (execution σ env) cert.formula).mp
          ((cert.runLanguageCorrect (execution σ env)).mp
            ((cert.runCertificate.initial_accepts_iff (execution σ env)).mp
              ((cert.determinization.correct (execution σ env)).mp (hσ env))))⟩
    · intro h
      rcases h with ⟨σ, hσ⟩
      exact ⟨σ, fun env =>
        (cert.determinization.correct (execution σ env)).mpr
          ((cert.runCertificate.initial_accepts_iff (execution σ env)).mpr
            ((cert.runLanguageCorrect (execution σ env)).mpr
              ((PositiveLTL.satisfies_ofLTL cert.interp
                (execution σ env) cert.formula).mpr (hσ env))))⟩

/--
Canonical full-LTL synthesis decidability through actual APA run-tree
acceptance, once run-language, determinization, and finite-game certificates
are supplied.
-/
noncomputable def CanonicalLTLRunBackendCompilation.synthesis_decidable
    {AP : Type ap}
    {In₁ : Type u}
    {In₂ : Type v}
    {Out₁ : Type x}
    {Out₂ : Type y}
    [DecidableEq AP]
    (cert : CanonicalLTLRunBackendCompilation.{u, v, x, y, ap, a, b}
      AP In₁ In₂ Out₁ Out₂) :
    Decidable
      (SynthesisProblem
        (fun word => LTL.Satisfies cert.interp word cert.formula)) :=
  effective_parity_synthesis_problem_decidable cert.toEffectiveParitySpecification

