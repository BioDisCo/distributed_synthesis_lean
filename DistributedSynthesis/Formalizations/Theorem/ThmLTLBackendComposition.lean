namespace CanonicalLTLAPAToDPAStateCompiler

/--
Build the reusable compiler from the current support-witness APA route:
state-wise support-witness soundness plus tail-realization completeness for
every formula.
-/
noncomputable def ofSupportWitnessSoundAndTailBranchRealizable
    {AP : Type ap}
    {Letter : Type u}
    [DecidableEq AP]
    (interp : AP -> Letter -> Prop)
    (interpDecidable : ∀ ap letter, Decidable (interp ap letter))
    (hsound :
      ∀ formula : LTL AP,
        let A :=
          (PositiveLTL.subformulaClosure
            (AP := AP)
            (Letter := Letter)
            (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
        A.SupportWitnessSound)
    (hrealizable :
      ∀ formula : LTL AP,
        let A :=
          (PositiveLTL.subformulaClosure
            (AP := AP)
            (Letter := Letter)
            (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
        A.SupportWitnessTailBranchRealizable) :
    CanonicalLTLAPAToDPAStateCompiler.{u, ap, ap} AP Letter where
  interp := interp
  interpDecidable := interpDecidable
  determinize := by
    intro formula
    exact
      let A :=
        (PositiveLTL.subformulaClosure
          (AP := AP)
          (Letter := Letter)
          (PositiveLTL.ofLTL formula)).toAPA interp interpDecidable
      A.supportWitnessDPAStateCompilationOfSoundAndTailBranchRealizable
        (LTL.canonicalRunLanguageCertificate formula interp interpDecidable)
        (hsound formula)
        (hrealizable formula)

