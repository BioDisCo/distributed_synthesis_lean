import DistributedSynthesis.Formalizations.Theorem.ThmAPAEmptiness
import DistributedSynthesis.Formalizations.Theorem.ThmDynamicHierarchyFiniteState

/-!
# Constant-observation games as alternating parity word automata

For a synchronized joint-action word, the automaton branches universally over
Nature's move at every round.  Its run-tree parity condition is exactly the
condition that the joint-action word wins against every Nature sequence.
-/

namespace DistributedSynthesis

universe u

namespace PosBool

/-- Conjunction of a finite list of atoms. -/
def conjoinAtoms {Atom : Type u} : List Atom -> PosBool Atom
  | [] => .verum
  | a :: rest => .conj (.atom a) (conjoinAtoms rest)

@[simp]
theorem eval_conjoinAtoms {Atom : Type u}
    (valuation : Atom -> Prop)
    (atoms : List Atom) :
    Eval valuation (conjoinAtoms atoms) ↔
      ∀ atom, atom ∈ atoms -> valuation atom := by
  induction atoms with
  | nil => simp [conjoinAtoms, Eval]
  | cons atom atoms ih => simp [conjoinAtoms, Eval, ih]

end PosBool

namespace FiniteConcurrentGame

variable (G : FiniteConcurrentGame.{u})

/-- State sequence induced by one joint-action word and one Nature sequence. -/
def blindWordState
    (word : OmegaWord (G.Action1 × G.Action2))
    (nature : Nat -> G.Nature) : Nat -> G.State
  | 0 => G.initial
  | n + 1 =>
      G.next (blindWordState word nature n) (word n).1 (word n).2 (nature n)

/-- A joint-action word wins blindly when every Nature branch satisfies parity. -/
def BlindWordWins
    (word : OmegaWord (G.Action1 × G.Action2)) : Prop :=
  ∀ nature : Nat -> G.Nature,
    ParityAccepts (fun n => G.priority (G.blindWordState word nature n))

/-- Positive-Boolean transition universally containing every Nature successor. -/
noncomputable def blindNatureAPA :
    AlternatingParityAutomaton.{u, u} (G.Action1 × G.Action2) := by
  classical
  exact
    { State := G.State
      stateFinite := G.stateFinite
      initial := G.initial
      step := fun state action =>
        PosBool.conjoinAtoms
          (Fintype.elems.toList.map
            (fun nature => G.next state action.1 action.2 nature))
      priority := G.priority }

theorem blindNatureAPA_step_eval
    (valuation : G.State -> Prop)
    (state : G.State)
    (action : G.Action1 × G.Action2) :
    PosBool.Eval valuation (G.blindNatureAPA.step state action) ↔
      ∀ nature : G.Nature,
        valuation (G.next state action.1 action.2 nature) := by
  classical
  simp only [blindNatureAPA, PosBool.eval_conjoinAtoms, List.mem_map]
  constructor
  · intro h nature
    exact h _ ⟨nature, by simpa using Fintype.complete nature, rfl⟩
  · intro h nextState hnext
    rcases hnext with ⟨nature, _hnature, rfl⟩
    exact h nature

section NonemptyNature

variable [Inhabited G.Nature]

/-- Decode a natural-number run-tree child into a Nature move. -/
noncomputable def natureOfChild (child : Nat) : G.Nature := by
  classical
  have hcard : 0 < Fintype.card G.Nature :=
    Fintype.card_pos_iff.mpr ⟨default⟩
  exact
    (Fintype.equivFin G.Nature).symm
      ⟨child % Fintype.card G.Nature,
        Nat.mod_lt child hcard⟩

/-- Encode a Nature move as a run-tree child. -/
noncomputable def childOfNature (nature : G.Nature) : Nat :=
  (Fintype.equivFin G.Nature nature).1

@[simp]
theorem natureOfChild_childOfNature (nature : G.Nature) :
    G.natureOfChild (G.childOfNature nature) = nature := by
  classical
  simp [natureOfChild, childOfNature,
    Nat.mod_eq_of_lt (Fintype.equivFin G.Nature nature).2]

/-- State stored at a run-tree node; nodes list child choices in reverse order. -/
noncomputable def blindNodeState
    (word : OmegaWord (G.Action1 × G.Action2)) :
    AlternatingParityAutomaton.Node -> G.State
  | [] => G.initial
  | child :: node =>
      G.next (blindNodeState word node)
        (word node.length).1 (word node.length).2 (G.natureOfChild child)

theorem blindNodeState_branchPrefix
    (word : OmegaWord (G.Action1 × G.Action2))
    (branch : Nat -> Nat)
    (n : Nat) :
    G.blindNodeState word
        (AlternatingParityAutomaton.branchPrefix branch n) =
      G.blindWordState word (fun k => G.natureOfChild (branch k)) n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      simp only [AlternatingParityAutomaton.branchPrefix_succ,
        blindNodeState, blindWordState,
        AlternatingParityAutomaton.branchPrefix_length]
      rw [ih]

/-- Canonical fully branching run tree generated by a joint-action word. -/
noncomputable def blindRun
    (word : OmegaWord (G.Action1 × G.Action2)) :
    G.blindNatureAPA.Run word where
  active := fun _ => True
  stateAt := G.blindNodeState word
  root_active := trivial
  root_state := rfl
  step_satisfied := by
    intro node _hactive
    change
      PosBool.Eval
        (fun nextState : G.State =>
          ∃ child : Nat, True ∧ G.blindNodeState word (child :: node) = nextState)
        (G.blindNatureAPA.step (G.blindNodeState word node) (word node.length))
    rw [G.blindNatureAPA_step_eval]
    intro nature
    refine ⟨G.childOfNature nature, trivial, ?_⟩
    simp [blindNodeState]

theorem natEven_iff_mod_two_eq_zero (p : Nat) :
    DetParityAutomaton.NatEven p ↔ p % 2 = 0 := by
  constructor
  · rintro ⟨m, rfl⟩
    omega
  · intro hmod
    refine ⟨p / 2, ?_⟩
    omega

/--
The universal-Nature APA accepts exactly the blindly winning joint-action
words.
-/
theorem blindNatureAPA_accepts_iff_blindWordWins
    (word : OmegaWord (G.Action1 × G.Action2)) :
    G.blindNatureAPA.Accepts word ↔ G.BlindWordWins word := by
  constructor
  · rintro ⟨run, hrun⟩ nature
    let target : Nat -> G.State := G.blindWordState word nature
    let P : AlternatingParityAutomaton.Node -> Prop :=
      fun node => run.stateAt node = target node.length
    have hroot : P [] := by
      change run.stateAt [] = G.initial
      simpa [blindNatureAPA] using run.root_state
    have hstep :
        ∀ node : AlternatingParityAutomaton.Node,
          run.PathActive node ->
          P node ->
            ∃ child : Nat, run.active (child :: node) ∧ P (child :: node) := by
      intro node hpath hP
      have heval := run.step_satisfied node (run.pathActive_self node hpath)
      have hall :=
        (G.blindNatureAPA_step_eval
          (fun nextState =>
            ∃ child : Nat,
              run.active (child :: node) ∧ run.stateAt (child :: node) = nextState)
          (run.stateAt node) (word node.length)).mp heval
      rcases hall (nature node.length) with ⟨child, hactive, hstate⟩
      refine ⟨child, hactive, ?_⟩
      change run.stateAt (child :: node) = target (child :: node).length
      rw [hstate]
      simp only [List.length_cons]
      change
        G.next (run.stateAt node) (word node.length).1 (word node.length).2
            (nature node.length) =
          G.next (target node.length) (word node.length).1 (word node.length).2
            (nature node.length)
      rw [hP]
    let branch : Nat -> Nat := run.choicePathBranch P hroot hstep
    have hactive : run.ActiveBranch branch :=
      run.choicePathBranch_active P hroot hstep
    rcases hrun branch hactive with ⟨p, hpEven, hpInf, hpMin⟩
    refine ⟨p, (natEven_iff_mod_two_eq_zero p).mp hpEven, ?_, ?_⟩
    · intro n
      rcases hpInf n with ⟨k, hk, hkprio⟩
      refine ⟨k, hk, ?_⟩
      have hPbranch :
          P (AlternatingParityAutomaton.branchPrefix branch k) := by
        simpa [branch] using run.choicePathBranch_property P hroot hstep k
      change run.stateAt
          (AlternatingParityAutomaton.branchPrefix branch k) =
            target (AlternatingParityAutomaton.branchPrefix branch k).length at hPbranch
      rw [AlternatingParityAutomaton.branchPrefix_length] at hPbranch
      simpa [AlternatingParityAutomaton.Run.PrioritySeenInfinitelyOften,
        target, blindNatureAPA, hPbranch] using hkprio
    · intro q hq
      apply hpMin q
      intro n
      rcases hq n with ⟨k, hk, hkprio⟩
      refine ⟨k, hk, ?_⟩
      have hPbranch :
          P (AlternatingParityAutomaton.branchPrefix branch k) := by
        simpa [branch] using run.choicePathBranch_property P hroot hstep k
      change run.stateAt
          (AlternatingParityAutomaton.branchPrefix branch k) =
            target (AlternatingParityAutomaton.branchPrefix branch k).length at hPbranch
      rw [AlternatingParityAutomaton.branchPrefix_length] at hPbranch
      simpa [target, blindNatureAPA, hPbranch] using hkprio
  · intro hwin
    refine ⟨G.blindRun word, ?_⟩
    intro branch _hactive
    rcases hwin (fun n => G.natureOfChild (branch n)) with
      ⟨p, hpEven, hpInf, hpMin⟩
    refine ⟨p, (natEven_iff_mod_two_eq_zero p).mpr hpEven, ?_, ?_⟩
    · intro n
      rcases hpInf n with ⟨k, hk, hkprio⟩
      refine ⟨k, hk, ?_⟩
      simpa [AlternatingParityAutomaton.Run.PrioritySeenInfinitelyOften,
        blindRun, blindNatureAPA, G.blindNodeState_branchPrefix] using hkprio
    · intro q hq
      apply hpMin q
      intro n
      rcases hq n with ⟨k, hk, hkprio⟩
      refine ⟨k, hk, ?_⟩
      simpa [blindRun, blindNatureAPA,
        G.blindNodeState_branchPrefix] using hkprio

/-- Blind joint-word winning is decidable by APA nonemptiness. -/
noncomputable def existsBlindWordWinsDecidable :
    Decidable
      (∃ word : OmegaWord (G.Action1 × G.Action2), G.BlindWordWins word) := by
  classical
  letI : Decidable
      (∃ word : OmegaWord (G.Action1 × G.Action2),
        G.blindNatureAPA.Accepts word) :=
    G.blindNatureAPA.languageNonemptyDecidable
  exact
    decidable_of_iff
      (∃ word : OmegaWord (G.Action1 × G.Action2),
        G.blindNatureAPA.Accepts word)
      (by
        constructor <;> rintro ⟨word, hword⟩
        · exact ⟨word, (G.blindNatureAPA_accepts_iff_blindWordWins word).mp hword⟩
        · exact ⟨word, (G.blindNatureAPA_accepts_iff_blindWordWins word).mpr hword⟩)

end NonemptyNature

section ConstantObservations

variable [Subsingleton G.Observation1] [Subsingleton G.Observation2]

/-- Every list over a subsingleton alphabet is the canonical constant list of the same length. -/
theorem list_eq_replicate_length_of_subsingleton
    {Observation : Type u}
    [Subsingleton Observation]
    (observations : List Observation)
    (observation : Observation) :
    observations = List.replicate observations.length observation := by
  induction observations with
  | nil => rfl
  | cons head tail ih =>
      rw [show head = observation from Subsingleton.elim _ _, ih]
      simpa using (List.replicate_succ (a := observation) (n := tail.length)).symm

omit [Subsingleton G.Observation1] [Subsingleton G.Observation2] in
/-- Observation histories reached after `n` rounds have length `n + 1`. -/
theorem strategyState_observation_lengths
    (strategy : G.HistoryProductStrategy)
    (nature : Nat -> G.Nature)
    (n : Nat) :
    (G.strategyState strategy nature n).2.1.length = n + 1 ∧
      (G.strategyState strategy nature n).2.2.length = n + 1 := by
  induction n with
  | zero => constructor <;> rfl
  | succ n ih =>
      change
        ((G.strategyState strategy nature n).2.1 ++ [_]).length = n + 1 + 1 ∧
          ((G.strategyState strategy nature n).2.2 ++ [_]).length = n + 1 + 1
      simp [ih.1, ih.2]

/-- The synchronized joint-action word selected by a constant-observation history strategy. -/
def historyStrategyWord
    (strategy : G.HistoryProductStrategy) :
    OmegaWord (G.Action1 × G.Action2) :=
  fun n =>
    (strategy.1
        (List.replicate (n + 1) (G.observe1 G.initial)),
      strategy.2
        (List.replicate (n + 1) (G.observe2 G.initial)))

omit [Subsingleton G.Observation2] in
theorem historyStrategyWord_action_one
    (strategy : G.HistoryProductStrategy)
    (nature : Nat -> G.Nature)
    (n : Nat) :
    strategy.1 (G.strategyState strategy nature n).2.1 =
      (G.historyStrategyWord strategy n).1 := by
  change
    strategy.1 (G.strategyState strategy nature n).2.1 =
      strategy.1 (List.replicate (n + 1) (G.observe1 G.initial))
  rw [list_eq_replicate_length_of_subsingleton
    (G.strategyState strategy nature n).2.1 (G.observe1 G.initial)]
  rw [(G.strategyState_observation_lengths strategy nature n).1]

omit [Subsingleton G.Observation1] in
theorem historyStrategyWord_action_two
    (strategy : G.HistoryProductStrategy)
    (nature : Nat -> G.Nature)
    (n : Nat) :
    strategy.2 (G.strategyState strategy nature n).2.2 =
      (G.historyStrategyWord strategy n).2 := by
  change
    strategy.2 (G.strategyState strategy nature n).2.2 =
      strategy.2 (List.replicate (n + 1) (G.observe2 G.initial))
  rw [list_eq_replicate_length_of_subsingleton
    (G.strategyState strategy nature n).2.2 (G.observe2 G.initial)]
  rw [(G.strategyState_observation_lengths strategy nature n).2]

/-- The game state generated by a constant-observation strategy follows its joint-action word. -/
theorem strategyState_fst_eq_blindWordState
    (strategy : G.HistoryProductStrategy)
    (nature : Nat -> G.Nature)
    (n : Nat) :
    (G.strategyState strategy nature n).1 =
      G.blindWordState (G.historyStrategyWord strategy) nature n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      change
        G.next (G.strategyState strategy nature n).1
            (strategy.1 (G.strategyState strategy nature n).2.1)
            (strategy.2 (G.strategyState strategy nature n).2.2)
            (nature n) =
          G.next (G.blindWordState (G.historyStrategyWord strategy) nature n)
            (G.historyStrategyWord strategy n).1
            (G.historyStrategyWord strategy n).2
            (nature n)
      rw [ih, G.historyStrategyWord_action_one,
        G.historyStrategyWord_action_two]

/-- Winning of a constant-observation strategy is winning of its synchronized action word. -/
theorem historyStrategyWins_iff_blindWordWins
    (strategy : G.HistoryProductStrategy) :
    G.HistoryStrategyWins strategy ↔
      G.BlindWordWins (G.historyStrategyWord strategy) := by
  unfold HistoryStrategyWins BlindWordWins
  constructor <;> intro h nature
  · simpa [G.strategyState_fst_eq_blindWordState] using h nature
  · simpa [G.strategyState_fst_eq_blindWordState] using h nature

/-- Turn a synchronized joint-action word into a perfect-recall strategy. -/
def historyStrategyOfWord
    (word : OmegaWord (G.Action1 × G.Action2)) :
    G.HistoryProductStrategy :=
  (fun observations => (word (observations.length - 1)).1,
    fun observations => (word (observations.length - 1)).2)

omit [Subsingleton G.Observation1] [Subsingleton G.Observation2] in
@[simp]
theorem historyStrategyWord_historyStrategyOfWord
    (word : OmegaWord (G.Action1 × G.Action2)) :
    G.historyStrategyWord (G.historyStrategyOfWord word) = word := by
  funext n
  simp [historyStrategyWord, historyStrategyOfWord]

/-- Constant-observation game realizability is exactly existence of a blindly winning word. -/
theorem historyRealizable_iff_exists_blindWordWins :
    G.HistoryRealizable ↔
      ∃ word : OmegaWord (G.Action1 × G.Action2), G.BlindWordWins word := by
  constructor
  · rintro ⟨strategy, hstrategy⟩
    exact
      ⟨G.historyStrategyWord strategy,
        (G.historyStrategyWins_iff_blindWordWins strategy).mp hstrategy⟩
  · rintro ⟨word, hword⟩
    refine ⟨G.historyStrategyOfWord word, ?_⟩
    apply (G.historyStrategyWins_iff_blindWordWins _).mpr
    simpa using hword

/-- Constant-observation finite concurrent games have decidable history realizability. -/
noncomputable def historyRealizableDecidable_of_subsingletonObservations_of_inhabitedNature
    [Inhabited G.Nature] :
    Decidable G.HistoryRealizable := by
  classical
  letI : Decidable
      (∃ word : OmegaWord (G.Action1 × G.Action2), G.BlindWordWins word) :=
    G.existsBlindWordWinsDecidable
  exact
    decidable_of_iff
      (∃ word : OmegaWord (G.Action1 × G.Action2), G.BlindWordWins word)
      G.historyRealizable_iff_exists_blindWordWins.symm

/--
Constant-observation games with available actions are decidable even when the
Nature alphabet is empty; in that case every strategy wins vacuously.
-/
noncomputable def historyRealizableDecidable_of_subsingletonObservations
    [Inhabited G.Action1] [Inhabited G.Action2] :
    Decidable G.HistoryRealizable := by
  classical
  by_cases hNonempty : Nonempty G.Nature
  · letI : Inhabited G.Nature := ⟨Classical.choice hNonempty⟩
    exact G.historyRealizableDecidable_of_subsingletonObservations_of_inhabitedNature
  · letI : IsEmpty G.Nature := ⟨fun nature => hNonempty ⟨nature⟩⟩
    exact isTrue
      ⟨(fun _ => default, fun _ => default), by
        intro nature
        exact isEmptyElim (nature 0)⟩

end ConstantObservations

end FiniteConcurrentGame

end DistributedSynthesis
