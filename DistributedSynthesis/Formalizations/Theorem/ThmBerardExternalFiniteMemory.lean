/--
The primitive semantic product observer also supplies the corrected
direct-product observer endpoint.
-/
noncomputable def toDirectProductObserverConstruction
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
