/--
Label-level endpoint when the generated observation transition is supplied
directly.

This is the version to use when the external construction already has the real
monitor transition and its generated-prefix snoc law.  It avoids the
right-congruence-core detour: the finite controller is certified by the
label-output equation, and the raw observer uses the supplied monitor
transition.
-/
noncomputable def toRawComputedBoundExternalPayloadOfLabelMonitor
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly :
      BerardUniformControllerMonitorAssemblyForHeader
        (problem := problem) header)
    (boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary)
    (outputOfLabel :
      Alphabet -> EnvironmentRound In₁ In₂ -> Out₁ × Out₂)
    (output_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        outputOfLabel
            (assembly.table.labelAt
              (assembly.controlOfGenerated envs)
              (boundaryOfObservation
                (berardNoDirectGeneratedObservation header envs)))
            env =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo))
    (representatives :
      BerardRawRealizedTruthRepresentativeInvariantCoreForHeader header) :
    BerardRawComputedBoundExternalPayloadForHeader header :=
  let controller : FiniteControllerGeneratesHeaderStrategy header :=
    assembly.toFiniteControllerGeneratesHeaderStrategyOfLabel
      boundaryOfObservation outputOfLabel output_correct
  let rawAssembly : BerardNoDirectRawControllerAssemblyForHeader header :=
    { controller := controller
      observationStep := assembly.observationStep
      observation_snoc := assembly.observation_snoc
      outputRealizer := True
      outputRealizer_proof := True.intro }
  { observer := rawAssembly.toRawDirectProductObserverConstruction
    representatives := representatives }

