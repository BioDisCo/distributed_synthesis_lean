/-- Convert the full product assembly into the raw observer used by the safe route. -/
noncomputable def toRawDirectProductObserverConstruction
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly :
      BerardFullProductControllerMonitorAssemblyForHeader
        (problem := problem) header) :
    BerardDirectProductObserverRawConstructionForHeader header where
  ProductState :=
    assembly.table.Control × BerardNoDirectGeneratedObservationState header
  productFinite := by
    classical
    letI : Fintype assembly.table.Control := assembly.table.controlFinite
    letI :
        Fintype
          (RegularTestTruthAtom (stabilizedSaturationBasis header.cert)) :=
      regularTestTruthAtomFintype (stabilizedSaturationBasis header.cert)
    letI :
        Fintype
          (EpochRotatingAccessState
            header.toCurrentOrderHeader.toHeader.importedUniform.boundary
            (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
            (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two)) :=
      Classical.choice
        (noDirectEpochTransformer_rotating_state_finite
          header.toCurrentOrderHeader.toHeader.importedUniform)
    letI : Fintype header.AState := header.aStateFinite
    infer_instance
  stateOfGenerated := fun envs =>
    (assembly.controlOfGenerated envs,
      berardNoDirectGeneratedObservation header envs)
  initialState :=
    (assembly.table.initial, berardNoDirectGeneratedObservation header [])
  initial_state := by
    exact Prod.ext assembly.control_nil rfl
  step := fun s env =>
    ( assembly.table.step s.1 (assembly.branchOfProduct s.1 s.2 env)
    , assembly.observationStep s.1 s.2 env )
  state_snoc := by
    intro envs env
    exact Prod.ext (assembly.control_snoc envs env)
      (assembly.observation_snoc envs env)
  truthOfState := fun s => s.2.1
  epochOfState := fun s => s.2.2.1
  automatonOfState := fun s => s.2.2.2.1
  receiptOfState := fun s => s.2.2.2.2
  generated_truth := by
    intro envs
    rfl
  generated_epoch := by
    intro envs
    rfl
  generated_automaton := by
    intro envs
    rfl
  generated_receipt := by
    intro envs
    rfl
  outputRealizer := assembly.outputRealizer
  outputRealizer_proof := assembly.outputRealizer_proof

/--
Local interpretation of labels for a full product assembly.

The selected label may depend on both the active table control and the current
boundary decoded from the monitor observation.
-/
structure LocalLambdaLabelData
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly :
      BerardFullProductControllerMonitorAssemblyForHeader
        (problem := problem) header)
    (boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary) where
  HistOne : Type (max u v x y aut)
  HistTwo : Type (max u v x y aut)
  FringeOne : Type (max u v x y aut)
  FringeTwo : Type (max u v x y aut)
  histOneFinite : Fintype HistOne
  histTwoFinite : Fintype HistTwo
  fringeOneFinite : Fintype FringeOne
  fringeTwoFinite : Fintype FringeTwo
  histOneOfLabel :
    Alphabet -> EnvironmentRound In₁ In₂ -> HistOne
  histTwoOfLabel :
    Alphabet -> EnvironmentRound In₁ In₂ -> HistTwo
  fringeOneOfLabel :
    Alphabet -> EnvironmentRound In₁ In₂ -> FringeOne
  fringeTwoOfLabel :
    Alphabet -> EnvironmentRound In₁ In₂ -> FringeTwo
  histOfViewOne : View In₁ In₂ Proc.one -> HistOne
  histOfViewTwo : View In₁ In₂ Proc.two -> HistTwo
  fringeOfViewOne : View In₁ In₂ Proc.one -> FringeOne
  fringeOfViewTwo : View In₁ In₂ Proc.two -> FringeTwo
  outputOneOfLabel :
    Alphabet -> EnvironmentRound In₁ In₂ -> Out₁
  outputTwoOfLabel :
    Alphabet -> EnvironmentRound In₁ In₂ -> Out₂
  histOne_sound :
    ∀ (envs : List (EnvironmentRound In₁ In₂))
      (env : EnvironmentRound In₁ In₂),
      histOneOfLabel
          (assembly.table.labelAt
            (assembly.controlOfGenerated envs)
            (boundaryOfObservation
              (berardNoDirectGeneratedObservation header envs)))
          env =
        histOfViewOne
          (nextView Proc.one (executionPrefixFromList header.σ envs) env)
  histTwo_sound :
    ∀ (envs : List (EnvironmentRound In₁ In₂))
      (env : EnvironmentRound In₁ In₂),
      histTwoOfLabel
          (assembly.table.labelAt
            (assembly.controlOfGenerated envs)
            (boundaryOfObservation
              (berardNoDirectGeneratedObservation header envs)))
          env =
        histOfViewTwo
          (nextView Proc.two (executionPrefixFromList header.σ envs) env)
  fringeOne_sound :
    ∀ (envs : List (EnvironmentRound In₁ In₂))
      (env : EnvironmentRound In₁ In₂),
      fringeOneOfLabel
          (assembly.table.labelAt
            (assembly.controlOfGenerated envs)
            (boundaryOfObservation
              (berardNoDirectGeneratedObservation header envs)))
          env =
        fringeOfViewOne
          (nextView Proc.one (executionPrefixFromList header.σ envs) env)
  fringeTwo_sound :
    ∀ (envs : List (EnvironmentRound In₁ In₂))
      (env : EnvironmentRound In₁ In₂),
      fringeTwoOfLabel
          (assembly.table.labelAt
            (assembly.controlOfGenerated envs)
            (boundaryOfObservation
              (berardNoDirectGeneratedObservation header envs)))
          env =
        fringeOfViewTwo
          (nextView Proc.two (executionPrefixFromList header.σ envs) env)
  output_correct :
    ∀ (envs : List (EnvironmentRound In₁ In₂))
      (env : EnvironmentRound In₁ In₂),
      ( outputOneOfLabel
          (assembly.table.labelAt
            (assembly.controlOfGenerated envs)
            (boundaryOfObservation
              (berardNoDirectGeneratedObservation header envs)))
          env
      , outputTwoOfLabel
          (assembly.table.labelAt
            (assembly.controlOfGenerated envs)
            (boundaryOfObservation
              (berardNoDirectGeneratedObservation header envs)))
          env ) =
        ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
          (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo)
  outputOne_local :
    ∀ (labelA : Alphabet) (envA : EnvironmentRound In₁ In₂)
      (labelB : Alphabet) (envB : EnvironmentRound In₁ In₂),
      histOneOfLabel labelA envA = histOneOfLabel labelB envB ->
      fringeOneOfLabel labelA envA = fringeOneOfLabel labelB envB ->
        outputOneOfLabel labelA envA = outputOneOfLabel labelB envB
  outputTwo_local :
    ∀ (labelA : Alphabet) (envA : EnvironmentRound In₁ In₂)
      (labelB : Alphabet) (envB : EnvironmentRound In₁ In₂),
      histTwoOfLabel labelA envA = histTwoOfLabel labelB envB ->
      fringeTwoOfLabel labelA envA = fringeTwoOfLabel labelB envB ->
        outputTwoOfLabel labelA envA = outputTwoOfLabel labelB envB
  reachable_dynamic_hierarchy : Prop
  reachable_dynamic_hierarchy_proof : reachable_dynamic_hierarchy

attribute [instance] LocalLambdaLabelData.histOneFinite
attribute [instance] LocalLambdaLabelData.histTwoFinite
attribute [instance] LocalLambdaLabelData.fringeOneFinite
attribute [instance] LocalLambdaLabelData.fringeTwoFinite

/--
Build the full-product local-label package from explicit local output
factorization.

This is the full-product analogue of the uniform-assembly constructor.  It
removes the two local-output congruence fields from the external interface:
once the Bérard labels expose finite local summaries/fringes and the process
outputs are obtained by applying `chooseOne`/`chooseTwo`, locality follows
definitionally in Lean.
-/
noncomputable def LocalLambdaLabelData.ofOutputFactorization
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    {assembly :
      BerardFullProductControllerMonitorAssemblyForHeader
        (problem := problem) header}
    {boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary}
    (HistOne HistTwo FringeOne FringeTwo : Type (max u v x y aut))
    [histOneFinite : Fintype HistOne]
    [histTwoFinite : Fintype HistTwo]
    [fringeOneFinite : Fintype FringeOne]
    [fringeTwoFinite : Fintype FringeTwo]
    (histOneOfLabel :
      Alphabet -> EnvironmentRound In₁ In₂ -> HistOne)
    (histTwoOfLabel :
      Alphabet -> EnvironmentRound In₁ In₂ -> HistTwo)
    (fringeOneOfLabel :
      Alphabet -> EnvironmentRound In₁ In₂ -> FringeOne)
    (fringeTwoOfLabel :
      Alphabet -> EnvironmentRound In₁ In₂ -> FringeTwo)
    (histOfViewOne : View In₁ In₂ Proc.one -> HistOne)
    (histOfViewTwo : View In₁ In₂ Proc.two -> HistTwo)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> FringeOne)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> FringeTwo)
    (chooseOne : HistOne -> FringeOne -> Out₁)
    (chooseTwo : HistTwo -> FringeTwo -> Out₂)
    (histOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        histOneOfLabel
            (assembly.table.labelAt
              (assembly.controlOfGenerated envs)
              (boundaryOfObservation
                (berardNoDirectGeneratedObservation header envs)))
            env =
          histOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (histTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        histTwoOfLabel
            (assembly.table.labelAt
              (assembly.controlOfGenerated envs)
              (boundaryOfObservation
                (berardNoDirectGeneratedObservation header envs)))
            env =
          histOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (fringeOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        fringeOneOfLabel
            (assembly.table.labelAt
              (assembly.controlOfGenerated envs)
              (boundaryOfObservation
                (berardNoDirectGeneratedObservation header envs)))
            env =
          fringeOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (fringeTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        fringeTwoOfLabel
            (assembly.table.labelAt
              (assembly.controlOfGenerated envs)
              (boundaryOfObservation
                (berardNoDirectGeneratedObservation header envs)))
            env =
          fringeOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (output_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        ( chooseOne
            (histOneOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs)))
              env)
            (fringeOneOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs)))
              env)
        , chooseTwo
            (histTwoOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs)))
              env)
            (fringeTwoOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs)))
              env) ) =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo))
    (reachable_dynamic_hierarchy : Prop)
    (reachable_dynamic_hierarchy_proof : reachable_dynamic_hierarchy) :
    LocalLambdaLabelData assembly boundaryOfObservation where
  HistOne := HistOne
  HistTwo := HistTwo
  FringeOne := FringeOne
  FringeTwo := FringeTwo
  histOneFinite := histOneFinite
  histTwoFinite := histTwoFinite
  fringeOneFinite := fringeOneFinite
  fringeTwoFinite := fringeTwoFinite
  histOneOfLabel := histOneOfLabel
  histTwoOfLabel := histTwoOfLabel
  fringeOneOfLabel := fringeOneOfLabel
  fringeTwoOfLabel := fringeTwoOfLabel
  histOfViewOne := histOfViewOne
  histOfViewTwo := histOfViewTwo
  fringeOfViewOne := fringeOfViewOne
  fringeOfViewTwo := fringeOfViewTwo
  outputOneOfLabel := fun label env =>
    chooseOne (histOneOfLabel label env) (fringeOneOfLabel label env)
  outputTwoOfLabel := fun label env =>
    chooseTwo (histTwoOfLabel label env) (fringeTwoOfLabel label env)
  histOne_sound := histOne_sound
  histTwo_sound := histTwo_sound
  fringeOne_sound := fringeOne_sound
  fringeTwo_sound := fringeTwo_sound
  output_correct := output_correct
  outputOne_local := by
    intro labelA envA labelB envB hhist hfringe
    simpa [hhist, hfringe]
  outputTwo_local := by
    intro labelA envA labelB envB hhist hfringe
    simpa [hhist, hfringe]
  reachable_dynamic_hierarchy := reachable_dynamic_hierarchy
  reachable_dynamic_hierarchy_proof := reachable_dynamic_hierarchy_proof

/--
Build the full-product local-label package from a bounded finite-lambda
controller.

This is the checked bridge from list-valued local histories to finite
full-product label observations.  The label histories are encoded by
`BoundedListCode`; equality of codes is converted back to equality of lists by
`BoundedListCode.encode_injective_of_length_le`, and the existing
round-aware-lambda locality theorem supplies the process-local output
congruence fields.
-/
noncomputable def LocalLambdaLabelData.ofBoundedRoundAwareLambdaController
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    {assembly :
      BerardFullProductControllerMonitorAssemblyForHeader
        (problem := problem) header}
    {boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary}
    {H₁ H₂ R₁ R₂ : Type (max u v x y aut)}
    [histAtomOneFinite : Fintype H₁]
    [histAtomTwoFinite : Fintype H₂]
    [fringeOneFinite : Fintype R₁]
    [fringeTwoFinite : Fintype R₂]
    (T :
      FiniteEpochTransformer
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      FiniteEpochTransformer.RoundAwareLambdaControllerCode
        T historyOne historyTwo fringeOne fringeTwo)
    (stateOfLabel :
      Alphabet -> FiniteEpochTransformer.GameState T)
    (histBoundOne histBoundTwo : Nat)
    (historyOne_label_length :
      ∀ (label : Alphabet) (env : EnvironmentRound In₁ In₂),
        (historyOne (stateOfLabel label) env).length ≤ histBoundOne)
    (historyTwo_label_length :
      ∀ (label : Alphabet) (env : EnvironmentRound In₁ In₂),
        (historyTwo (stateOfLabel label) env).length ≤ histBoundTwo)
    (historyOfViewOne :
      View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo :
      View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (histOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        historyOne
            (stateOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          historyOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (histTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        historyTwo
            (stateOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          historyOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (fringeOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        fringeOne
            (stateOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          fringeOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (fringeTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        fringeTwo
            (stateOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          fringeOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (output_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        controller.1
            (stateOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo))
    (reachable_dynamic_hierarchy : Prop)
    (reachable_dynamic_hierarchy_proof : reachable_dynamic_hierarchy) :
    LocalLambdaLabelData assembly boundaryOfObservation where
  HistOne := BoundedListCode H₁ histBoundOne
  HistTwo := BoundedListCode H₂ histBoundTwo
  FringeOne := R₁
  FringeTwo := R₂
  histOneFinite := inferInstance
  histTwoFinite := inferInstance
  fringeOneFinite := fringeOneFinite
  fringeTwoFinite := fringeTwoFinite
  histOneOfLabel := fun label env =>
    BoundedListCode.encode histBoundOne (historyOne (stateOfLabel label) env)
  histTwoOfLabel := fun label env =>
    BoundedListCode.encode histBoundTwo (historyTwo (stateOfLabel label) env)
  fringeOneOfLabel := fun label env =>
    fringeOne (stateOfLabel label) env
  fringeTwoOfLabel := fun label env =>
    fringeTwo (stateOfLabel label) env
  histOfViewOne := fun view =>
    BoundedListCode.encode histBoundOne (historyOfViewOne view)
  histOfViewTwo := fun view =>
    BoundedListCode.encode histBoundTwo (historyOfViewTwo view)
  fringeOfViewOne := fringeOfViewOne
  fringeOfViewTwo := fringeOfViewTwo
  outputOneOfLabel := fun label env =>
    (controller.1 (stateOfLabel label) env).1
  outputTwoOfLabel := fun label env =>
    (controller.1 (stateOfLabel label) env).2
  histOne_sound := by
    intro envs env
    exact congrArg (BoundedListCode.encode histBoundOne)
      (histOne_sound envs env)
  histTwo_sound := by
    intro envs env
    exact congrArg (BoundedListCode.encode histBoundTwo)
      (histTwo_sound envs env)
  fringeOne_sound := fringeOne_sound
  fringeTwo_sound := fringeTwo_sound
  output_correct := by
    intro envs env
    exact congrArg (fun output : Out₁ × Out₂ => (output.1, output.2))
      (output_correct envs env)
  outputOne_local := by
    intro labelA envA labelB envB hhist hfringe
    exact
      FiniteEpochTransformer.roundAwareLambdaController_one_eq_of_local_eq
        T historyOne historyTwo fringeOne fringeTwo controller
        (BoundedListCode.encode_injective_of_length_le
          (historyOne_label_length labelA envA)
          (historyOne_label_length labelB envB)
          hhist)
        hfringe
  outputTwo_local := by
    intro labelA envA labelB envB hhist hfringe
    exact
      FiniteEpochTransformer.roundAwareLambdaController_two_eq_of_local_eq
        T historyOne historyTwo fringeOne fringeTwo controller
        (BoundedListCode.encode_injective_of_length_le
          (historyTwo_label_length labelA envA)
          (historyTwo_label_length labelB envB)
          hhist)
        hfringe
  reachable_dynamic_hierarchy := reachable_dynamic_hierarchy
  reachable_dynamic_hierarchy_proof := reachable_dynamic_hierarchy_proof

/--
Build the full-product local-label package from a bounded finite-lambda
