/--
Raw view-decoder package in the low-level truth-congruence form.  This is the
bounded view-decoder package with the cardinal-bound obligation removed.
-/
structure BerardNoDirectRawViewDecoderRightCongruenceCorePackageForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
