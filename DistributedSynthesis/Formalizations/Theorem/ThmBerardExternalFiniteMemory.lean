                (assembly.table.labelAt
                  (assembly.controlOfGenerated envs)
                  (boundaryOfObservation
                    (berardNoDirectGeneratedObservation header envs))))
              env) ) =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo))
    (gameCompilation :
      DPAToFiniteGameCompilation.{u, v, x, y, max u v x y aut} Out₂ A) :
    NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCertificate
      In₁ In₂ Out₁ Out₂ A := by
  classical
  let histOneLen :
      Alphabet × EnvironmentRound In₁ In₂ -> Nat :=
    fun q => (historyOne (stateOfLabel q.1) q.2).length
  let histTwoLen :
      Alphabet × EnvironmentRound In₁ In₂ -> Nat :=
    fun q => (historyTwo (stateOfLabel q.1) q.2).length
  let histBoundOne : Nat :=
    Classical.choose (finiteFamilyNatBound histOneLen)
  let histBoundTwo : Nat :=
    Classical.choose (finiteFamilyNatBound histTwoLen)
  have historyOne_label_length :
      ∀ (label : Alphabet) (env : EnvironmentRound In₁ In₂),
        (historyOne (stateOfLabel label) env).length ≤ histBoundOne := by
    intro label env
    exact
      (Classical.choose_spec (finiteFamilyNatBound histOneLen))
        (label, env)
  have historyTwo_label_length :
      ∀ (label : Alphabet) (env : EnvironmentRound In₁ In₂),
        (historyTwo (stateOfLabel label) env).length ≤ histBoundTwo := by
    intro label env
    exact
      (Classical.choose_spec (finiteFamilyNatBound histTwoLen))
        (label, env)
  exact
    assembly.fixedGameCertificateOfContingentStrategyWithGeneratedReceiptHierarchyWithDPAToFiniteGameCompilation
      boundaryOfObservation T historyOne historyTwo fringeOne fringeTwo strategy
      stateOfLabel histBoundOne histBoundTwo
      historyOne_label_length historyTwo_label_length
      historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
      histOne_sound histTwo_sound fringeOne_sound fringeTwo_sound
      output_correct gameCompilation

