  outputRealizer_proof := observer.outputRealizer_proof

/--
The direct product observer constructs the theorem-facing reachable
finite-controller certificate.
-/
noncomputable def toReachableControllerCertificate
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
