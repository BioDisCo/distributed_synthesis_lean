        (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (formula : LTL AP)
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ (compiler.compile formula)}
    (assembly :
      BerardUniformControllerMonitorAssemblyForHeader
        (problem := problem) header)
    (boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary)
    (labelData : LocalLambdaLabelData assembly boundaryOfObservation)
    (gameCompilation :
      DPAToFiniteGameCompilation.{u, v, x, y, max u v x y aut}
        Out₂ (compiler.compile formula)) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          LTL.Satisfies compiler.interp word formula)) :=
  (assembly.fixedGameCertificateOfLabelDataWithDPAToFiniteGameCompilation
      boundaryOfObservation labelData gameCompilation)
    |>.ltlSynthesisDecidable compiler formula

/--
Extract an actual finite controller generating `header.σ` from the
controller-table/monitor product assembly.

The finite control state is exactly the checked product state: the Bérard
table control together with the generated no-direct observation.  The only
external output obligation is the expected one: the output map read from this
finite product state agrees with the next round of `header.σ` on generated
prefixes.
-/
noncomputable def toFiniteControllerGeneratesHeaderStrategy
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly :
      BerardUniformControllerMonitorAssemblyForHeader
        (problem := problem) header)
    (outputOfProduct :
      assembly.table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ -> Out₁ × Out₂)
    (output_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        outputOfProduct
            (assembly.controlOfGenerated envs)
            (berardNoDirectGeneratedObservation header envs)
            env =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo)) :
    FiniteControllerGeneratesHeaderStrategy header where
  Control := assembly.table.Control × BerardNoDirectGeneratedObservationState header
  controlFinite := by
    classical
    letI : Fintype assembly.table.Control := assembly.table.controlFinite
    letI :
        Fintype
          (RegularTestTruthAtom (stabilizedSaturationBasis header.cert)) :=
      regularTestTruthAtomFintype (stabilizedSaturationBasis header.cert)
    letI :
        Fintype
          (EpochRotatingAccessState
            header.toCurrentOrderHeader.toHeader.importedUniform.boundary
            (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
            (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two)) :=
      Classical.choice
        (noDirectEpochTransformer_rotating_state_finite
          header.toCurrentOrderHeader.toHeader.importedUniform)
    letI : Fintype header.AState := header.aStateFinite
    infer_instance
  initial := (assembly.table.initial, berardNoDirectGeneratedObservation header [])
  step := fun state env =>
    ( assembly.table.step state.1 (assembly.branchOfObservation state.2 env)
    , assembly.observationStep state.2 env )
  output := fun state env => outputOfProduct state.1 state.2 env
  controlOfGenerated := fun envs =>
    (assembly.controlOfGenerated envs, berardNoDirectGeneratedObservation header envs)
  control_nil := by
    exact Prod.ext assembly.control_nil rfl
  control_snoc := by
    intro envs env
    exact Prod.ext (assembly.control_snoc envs env)
      (assembly.observation_snoc envs env)
  output_correct := output_correct

/--
Label-based version of `toFiniteControllerGeneratesHeaderStrategy`.

This is closer to the transition-rational Bérard output: the finite output is
obtained by reading the label selected by the uniform controller table at the
current decoded boundary, then translating that label and current environment
round into process outputs.
-/
noncomputable def toFiniteControllerGeneratesHeaderStrategyOfLabel
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly :
      BerardUniformControllerMonitorAssemblyForHeader
        (problem := problem) header)
    (boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary)
    (outputOfLabel :
      Alphabet -> EnvironmentRound In₁ In₂ -> Out₁ × Out₂)
    (output_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        outputOfLabel
            (assembly.table.labelAt
              (assembly.controlOfGenerated envs)
              (boundaryOfObservation
                (berardNoDirectGeneratedObservation header envs)))
            env =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo)) :
    FiniteControllerGeneratesHeaderStrategy header :=
  assembly.toFiniteControllerGeneratesHeaderStrategy
    (fun control observation env =>
      outputOfLabel
        (assembly.table.labelAt control (boundaryOfObservation observation))
        env)
    (by
      intro envs env
      exact output_correct envs env)

end BerardUniformControllerMonitorAssemblyForHeader

