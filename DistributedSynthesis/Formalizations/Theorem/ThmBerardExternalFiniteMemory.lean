  productFinite := observer.productFinite
  productOfHistory := observer.productOfHistory
  product_eq_of_pathEquivalent := observer.product_eq_of_pathEquivalent
  pathEquivalent_of_product_eq := observer.pathEquivalent_of_product_eq
  product_append_congruent := observer.product_append_congruent
  currentViews_of_product_eq := observer.currentViews_of_product_eq
  receipt_eq_of_product_eq := observer.receipt_eq_of_product_eq
  viewOne := observer.viewOne
  viewTwo := observer.viewTwo
  generated_views := observer.generated_views
  outputRealizer := observer.outputRealizer
  outputRealizer_proof := observer.outputRealizer_proof

/--
The primitive semantic product observer constructs the path-level package
consumed by the checked finite-memory assembly.
-/
noncomputable def toViewDecoderPathRightCongruenceCorePackage
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer :
      BerardSemanticProductObserverConstructionForHeader header) :
    BerardNoDirectViewDecoderPathRightCongruenceCorePackageForHeader header where
  viewOne := observer.viewOne
  viewTwo := observer.viewTwo
  generated_views := observer.generated_views
  pathRightCongruenceCore := observer.toPathRightCongruenceCore
  generationBound_card := observer.generationBound_card
  outputRealizer := observer.outputRealizer
  outputRealizer_proof := observer.outputRealizer_proof

/--
The primitive semantic product observer constructs the theorem-facing
reachable finite-controller certificate.
-/
noncomputable def toReachableControllerCertificate
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
