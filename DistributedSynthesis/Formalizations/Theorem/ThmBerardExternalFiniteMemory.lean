            (FiniteControllerGeneratesHeaderStrategy.roundAwareControlOfGenerated
              header
              (FiniteControllerGeneratesHeaderStrategy.roundAwareControllerOfHeaderStrategyViews
                header viewOne viewTwo)
              envs)
            env =
          nextView Proc.one (executionPrefixFromList header.σ envs) env ∧
        viewTwo
            (FiniteControllerGeneratesHeaderStrategy.roundAwareControlOfGenerated
              header
              (FiniteControllerGeneratesHeaderStrategy.roundAwareControllerOfHeaderStrategyViews
                header viewOne viewTwo)
              envs)
            env =
          nextView Proc.two (executionPrefixFromList header.σ envs) env)
    (generationBound_card :
      Fintype.card (BerardNoDirectGeneratedObservationState header) ≤
        header.generationBound)
    (outputRealizer : Prop)
    (outputRealizer_proof : outputRealizer) :
    BerardSemanticProductObserverConstructionForHeader header :=
  core.toPathCore.toSemanticProductObserverConstruction
    viewOne viewTwo generated_views generationBound_card
    outputRealizer outputRealizer_proof

end BerardGeneratedObservationRightCongruenceCore

namespace ArbitraryCertificateAppendCongruenceCounterexample

private def badLanguage : TypedPathLanguage Bool :=
  fun path => path = [false]

private def badSaturation :
    RegularTestSaturation Unit Bool Unit Unit Unit where
  automaton :=
    { State := Unit
      stateFinite := inferInstance
      initial := ()
      step := fun _ _ => ()
      priority := fun _ => 0 }
  side := Proc.one
  edgeTypeFinite := inferInstance
  boundaryFinite := inferInstance
  boundaryAccess := Set.univ
  seed := Unit
  seedFinite := inferInstance
  seedLanguage := fun _ => badLanguage
  seedReadsPathSummary := True
  seedReadsEndpointOwners := True
  seedReadsParityProgress := True
  seedContainsClosingTestsToBoundary := True
  stageTest := fun _ => Unit
  stageFinite := fun _ => inferInstance
  stageLanguage := fun _ _ => badLanguage
  stageBooleanAlgebra := fun _ => True
  seedAtZero := fun _ => ()
  seedAtZero_semantics := by
    intro seedTest
    rfl
  carry := fun _ _ => ()
  carry_semantics := by
    intro n test
    rfl
  privateInputPredecessor := fun _ _ => ()
  privateInputPredecessor_exact := fun _ _ => True
  successorGeneratedByCarryAndPredecessors := fun _ => True
  regularLanguageEquivalenceDecidable := fun _ => inferInstance

private def badCertificate :
    StabilizedSaturationBasisCertificate badSaturation 0 where
  stable := by
    constructor
    · intro testNext
      exact ⟨(), rfl⟩
    · intro test
      exact ⟨(), rfl⟩
  determinesPathData := True
  predecessorClosed := True
  boundaryClosed := fun _ => True
  continuationClosed := True
  determinesPathData_proof := trivial
  predecessorClosed_proof := trivial
  boundaryClosed_proof := fun _ => trivial
  continuationClosed_proof := trivial

/--
Counterexample: the current certificate interface alone does not imply
path-level append-congruence.

The single stabilized test accepts exactly `[false]`.  Therefore `[]` and
`[true]` satisfy the same tests, but after appending the same edge `false`,
the paths `[false]` and `[true, false]` are separated.
-/
theorem badCertificate_not_pathAppendCongruent :
    ¬ StabilizedSaturationBasisPathAppendCongruent badCertificate := by
  intro hcongruent
  have hpre :
      StabilizedSaturationBasisPathEquivalent badCertificate
        ([] : TypedPath Bool) ([true] : TypedPath Bool) := by
    intro test
    cases test
    change (([] : TypedPath Bool) = [false]) ↔
      (([true] : TypedPath Bool) = [false])
    simp
  have hpost :=
    hcongruent ([] : TypedPath Bool) ([true] : TypedPath Bool) false hpre
  have hiff := hpost ()
  have hleft :
      ((([] : TypedPath Bool) ++ [false]) ∈
        (stabilizedSaturationBasis badCertificate).language ()) := by
    change ((([] : TypedPath Bool) ++ [false]) = [false])
    simp
  have hright :
      ¬ ((([true] : TypedPath Bool) ++ [false]) ∈
        (stabilizedSaturationBasis badCertificate).language ()) := by
    change ¬ ((([true] : TypedPath Bool) ++ [false]) = [false])
    simp
  exact hright (hiff.mp hleft)

/--
Consequently there is no Lean theorem deriving path-level append-congruence
from an arbitrary `StabilizedSaturationBasisCertificate` as currently defined.
-/
theorem exists_certificate_not_pathAppendCongruent :
    ∃ (sat : RegularTestSaturation Unit Bool Unit Unit Unit),
      ∃ cert : StabilizedSaturationBasisCertificate sat 0,
        ¬ StabilizedSaturationBasisPathAppendCongruent cert :=
  ⟨badSaturation, badCertificate, badCertificate_not_pathAppendCongruent⟩

/--
There cannot be a uniform theorem deriving path-level append-congruence from
the current stabilized-certificate interface alone.
-/
theorem not_every_certificate_pathAppendCongruent :
    ¬ (∀ (sat : RegularTestSaturation Unit Bool Unit Unit Unit)
        (cert : StabilizedSaturationBasisCertificate sat 0),
        StabilizedSaturationBasisPathAppendCongruent cert) := by
  intro hall
  exact badCertificate_not_pathAppendCongruent (hall badSaturation badCertificate)

end ArbitraryCertificateAppendCongruenceCounterexample

/--
Direct finite product-observer output of the corrected Bérard construction.

This is the Lean interface matching the corrected paper proof.  The transition
state is the full reachable product state: active Bérard controller memory
together with the theorem-facing monitor projections.  Therefore append
stability is the deterministic `state_snoc` law for this product observer,
not append-congruence of the stabilized truth atom.

The generation-bound field is still explicit: after the finite reachable graph
is built, the construction must choose the header bound to dominate one
generated representative for every reachable product state.
-/
structure BerardDirectProductObserverConstructionForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  ProductState : Type (max u v x y aut)
  productFinite : Fintype ProductState
  stateOfGenerated :
    List (EnvironmentRound In₁ In₂) -> ProductState
  initialState : ProductState
  initial_state : stateOfGenerated [] = initialState
  step : ProductState -> EnvironmentRound In₁ In₂ -> ProductState
  state_snoc :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      stateOfGenerated (envs ++ [env]) = step (stateOfGenerated envs) env
  truthOfState :
    ProductState -> RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  epochOfState :
    ProductState ->
      EpochRotatingAccessState
        header.toCurrentOrderHeader.toHeader.importedUniform.boundary
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two)
  automatonOfState :
    ProductState -> header.AState
  receiptOfState :
    ProductState -> ReceiptOrderData
  generated_truth :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      truthOfState (stateOfGenerated envs) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ envs))
  generated_epoch :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      epochOfState (stateOfGenerated envs) =
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (executionPrefixFromList header.σ envs)
  generated_automaton :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      automatonOfState (stateOfGenerated envs) =
        header.automatonOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (executionPrefixFromList header.σ envs)))
  generated_receipt :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      receiptOfState (stateOfGenerated envs) =
        currentReceiptOrderData
          (executionPrefixFromList header.σ envs)
          (historyCurrentContainmentOrder
            (executionPrefixFromList header.σ envs))
  bounded_reachable_state :
    ∀ s : ProductState,
      (∃ envs : List (EnvironmentRound In₁ In₂), stateOfGenerated envs = s) ->
      ∃ envs : List (EnvironmentRound In₁ In₂),
        stateOfGenerated envs = s ∧ envs.length ≤ header.generationBound
  outputRealizer : Prop
  outputRealizer_proof : outputRealizer

attribute [instance] BerardDirectProductObserverConstructionForHeader.productFinite

namespace BerardDirectProductObserverConstructionForHeader

/--
If the header generation bound is zero, every reachable product state must be
the initial state.  Thus a nontrivial direct product observer cannot be a
theorem of the bare header interface: the bound has to be chosen large enough
for the reachable representative table.
-/
theorem all_reachable_initial_of_generationBound_zero
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer :
      BerardDirectProductObserverConstructionForHeader header)
    (hzero : header.generationBound = 0)
    (envs : List (EnvironmentRound In₁ In₂)) :
    observer.stateOfGenerated envs = observer.initialState := by
  rcases observer.bounded_reachable_state
      (observer.stateOfGenerated envs) ⟨envs, rfl⟩ with
    ⟨rep, hrep, hbound⟩
  have hrep_len_zero : rep.length = 0 := by
    exact Nat.eq_zero_of_le_zero (by simpa [hzero] using hbound)
  have hrep_nil : rep = [] :=
    List.eq_nil_of_length_eq_zero hrep_len_zero
  calc
    observer.stateOfGenerated envs = observer.stateOfGenerated rep := hrep.symm
    _ = observer.stateOfGenerated [] := by rw [hrep_nil]
    _ = observer.initialState := observer.initial_state

/--
With generation bound zero, the generated stabilized truth atom is constant on
all environment prefixes for any direct product observer.
-/
theorem generated_truth_constant_of_generationBound_zero
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer :
      BerardDirectProductObserverConstructionForHeader header)
    (hzero : header.generationBound = 0)
    (envs : List (EnvironmentRound In₁ In₂)) :
    regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ envs)) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ [])) := by
  calc
    regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ envs)) =
        observer.truthOfState (observer.stateOfGenerated envs) := by
          exact (observer.generated_truth envs).symm
    _ = observer.truthOfState observer.initialState := by
          rw [observer.all_reachable_initial_of_generationBound_zero hzero envs]
    _ = observer.truthOfState (observer.stateOfGenerated []) := by
          rw [observer.initial_state]
    _ =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ [])) := by
          exact observer.generated_truth []

/--
Concrete obstruction to an unconditional direct observer theorem from the weak
header: with bound zero, any generated prefix whose truth differs from the empty
prefix rules out the observer.
-/
theorem no_directProductObserver_of_generationBound_zero_and_truth_changes
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (hzero : header.generationBound = 0)
    (envs : List (EnvironmentRound In₁ In₂))
    (hchanges :
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ envs)) ≠
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ []))) :
    ¬ Nonempty (BerardDirectProductObserverConstructionForHeader header) := by
  rintro ⟨observer⟩
  exact hchanges
    (observer.generated_truth_constant_of_generationBound_zero hzero envs)

/--
The direct product observer is already the reachable observer construction
consumed by the checked representative-table wrapper.
-/
noncomputable def toReachableObserverConstruction
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
