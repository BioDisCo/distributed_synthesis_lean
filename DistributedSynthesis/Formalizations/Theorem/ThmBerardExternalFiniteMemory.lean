      ∀ s : observer.ProductState, HandoffState s -> s ≠ observer.initialState)
    {H₁ H₂ R₁ R₂ : Type (max u v x y aut)}
    [histAtomOneFinite : Fintype H₁]
    [histAtomTwoFinite : Fintype H₂]
    [fringeOneFinite : Fintype R₁]
    [fringeTwoFinite : Fintype R₂]
    (historyOne :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> R₂)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
