  observer : BerardDirectProductObserverRawConstructionForHeader header
  HandoffState : observer.ProductState -> Prop
  handoff_ne_initial :
    ∀ s : observer.ProductState, HandoffState s -> s ≠ observer.initialState
  H₁ : Type (max u v x y aut)
  H₂ : Type (max u v x y aut)
  R₁ : Type (max u v x y aut)
  R₂ : Type (max u v x y aut)
  histAtomOneFinite : Fintype H₁
  histAtomTwoFinite : Fintype H₂
  fringeOneFinite : Fintype R₁
  fringeTwoFinite : Fintype R₂
  historyOne :
    observer.ProductState -> EnvironmentRound In₁ In₂ -> List H₁
  historyTwo :
    observer.ProductState -> EnvironmentRound In₁ In₂ -> List H₂
  fringeOne :
    observer.ProductState -> EnvironmentRound In₁ In₂ -> R₁
  fringeTwo :
    observer.ProductState -> EnvironmentRound In₁ In₂ -> R₂
  historyOfViewOne : View In₁ In₂ Proc.one -> List H₁
  historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂
  fringeOfViewOne : View In₁ In₂ Proc.one -> R₁
  fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂
  chooseOne : List H₁ -> R₁ -> Out₁
  chooseTwo : List H₂ -> R₂ -> Out₂
  histBoundOne : Nat
  histBoundTwo : Nat
  historyOne_length :
    ∀ (state : observer.ProductState) (env : EnvironmentRound In₁ In₂),
      (historyOne state env).length ≤ histBoundOne
  historyTwo_length :
    ∀ (state : observer.ProductState) (env : EnvironmentRound In₁ In₂),
      (historyTwo state env).length ≤ histBoundTwo
  historyOne_sound :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      historyOne (observer.stateOfGenerated envs) env =
        historyOfViewOne
          (nextView Proc.one (executionPrefixFromList header.σ envs) env)
  historyTwo_sound :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      historyTwo (observer.stateOfGenerated envs) env =
        historyOfViewTwo
          (nextView Proc.two (executionPrefixFromList header.σ envs) env)
  fringeOne_sound :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      fringeOne (observer.stateOfGenerated envs) env =
        fringeOfViewOne
          (nextView Proc.one (executionPrefixFromList header.σ envs) env)
  fringeTwo_sound :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      fringeTwo (observer.stateOfGenerated envs) env =
        fringeOfViewTwo
          (nextView Proc.two (executionPrefixFromList header.σ envs) env)
  output_correct :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      ( chooseOne
          (historyOne (observer.stateOfGenerated envs) env)
          (fringeOne (observer.stateOfGenerated envs) env)
      , chooseTwo
          (historyTwo (observer.stateOfGenerated envs) env)
          (fringeTwo (observer.stateOfGenerated envs) env) ) =
        ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
          (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo)
  reachable_dynamic_hierarchy : Prop
  reachable_dynamic_hierarchy_proof : reachable_dynamic_hierarchy

attribute [instance] BerardSafeRawFiniteMemoryPayloadForHeader.histAtomOneFinite
attribute [instance] BerardSafeRawFiniteMemoryPayloadForHeader.histAtomTwoFinite
attribute [instance] BerardSafeRawFiniteMemoryPayloadForHeader.fringeOneFinite
attribute [instance] BerardSafeRawFiniteMemoryPayloadForHeader.fringeTwoFinite

namespace BerardSafeRawFiniteMemoryPayloadForHeader

/--
Build the bundled safe payload from the already checked local-lambda reachable
payload.

This removes a bookkeeping mismatch between the two interfaces.  The
local-lambda bridge has finite observations `Hist* × Fringe*` and proves that
outputs are constant on equal observations.  The safe payload wants bounded
list-valued histories and explicit tables `chooseOne/chooseTwo`.  We encode
each finite history observation as a singleton list and define the output tables
by quotienting `outputOne`/`outputTwo` through the local-congruence proofs.
-/
noncomputable def ofLocalLambdaReachablePayload
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header) :
    BerardSafeRawFiniteMemoryPayloadForHeader header where
  observer := payload.observer
  HandoffState := payload.HandoffState
  handoff_ne_initial := payload.handoff_ne_initial
  H₁ := payload.localLambda.HistOne
  H₂ := payload.localLambda.HistTwo
  R₁ := payload.localLambda.FringeOne
  R₂ := payload.localLambda.FringeTwo
  histAtomOneFinite := payload.localLambda.histOneFinite
  histAtomTwoFinite := payload.localLambda.histTwoFinite
  fringeOneFinite := payload.localLambda.fringeOneFinite
  fringeTwoFinite := payload.localLambda.fringeTwoFinite
  historyOne := fun state env => [payload.localLambda.histOne state env]
  historyTwo := fun state env => [payload.localLambda.histTwo state env]
  fringeOne := payload.localLambda.fringeOne
  fringeTwo := payload.localLambda.fringeTwo
  historyOfViewOne := fun view => [payload.localLambda.histOfViewOne view]
  historyOfViewTwo := fun view => [payload.localLambda.histOfViewTwo view]
  fringeOfViewOne := payload.localLambda.fringeOfViewOne
  fringeOfViewTwo := payload.localLambda.fringeOfViewTwo
  chooseOne := fun history fringe =>
    match history with
    | [] => header.σ.one (View.empty Proc.one)
    | hist :: _ =>
        payload.localLambda.outputOneOfLocalObservation hist fringe
  chooseTwo := fun history fringe =>
    match history with
    | [] => header.σ.two (View.empty Proc.two)
    | hist :: _ =>
        payload.localLambda.outputTwoOfLocalObservation hist fringe
  histBoundOne := 1
  histBoundTwo := 1
  historyOne_length := by
    intro state env
    simp
  historyTwo_length := by
    intro state env
    simp
  historyOne_sound := by
    intro envs env
    exact congrArg (fun hist => [hist])
      (payload.localLambda.histOne_sound envs env)
  historyTwo_sound := by
    intro envs env
    exact congrArg (fun hist => [hist])
      (payload.localLambda.histTwo_sound envs env)
  fringeOne_sound := payload.localLambda.fringeOne_sound
  fringeTwo_sound := payload.localLambda.fringeTwo_sound
  output_correct := by
    intro envs env
    change
      ( payload.localLambda.outputOneOfLocalObservation
          (payload.localLambda.histOne
            (payload.observer.stateOfGenerated envs) env)
          (payload.localLambda.fringeOne
            (payload.observer.stateOfGenerated envs) env)
      , payload.localLambda.outputTwoOfLocalObservation
          (payload.localLambda.histTwo
            (payload.observer.stateOfGenerated envs) env)
          (payload.localLambda.fringeTwo
            (payload.observer.stateOfGenerated envs) env) ) =
        ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
          (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo)
    rw [payload.localLambda.outputOneOfLocalObservation_spec,
      payload.localLambda.outputTwoOfLocalObservation_spec]
    exact payload.localLambda.output_generated_correct envs env
  reachable_dynamic_hierarchy := payload.localLambda.reachable_dynamic_hierarchy
  reachable_dynamic_hierarchy_proof :=
    payload.localLambda.reachable_dynamic_hierarchy_proof

/-- Build the raw local-lambda bridge from the bundled safe payload. -/
noncomputable def toLocalLambdaBridge
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardSafeRawFiniteMemoryPayloadForHeader header) :
    BerardLocalLambdaBridgeForRawObserver payload.observer :=
  BerardLocalLambdaBridgeForRawObserver.ofBoundedHistoryOutputFactorization
    payload.observer
    payload.historyOne payload.historyTwo payload.fringeOne payload.fringeTwo
    payload.historyOfViewOne payload.historyOfViewTwo
    payload.fringeOfViewOne payload.fringeOfViewTwo
    payload.chooseOne payload.chooseTwo
    payload.histBoundOne payload.histBoundTwo
    payload.historyOne_length payload.historyTwo_length
    payload.historyOne_sound payload.historyTwo_sound
    payload.fringeOne_sound payload.fringeTwo_sound
    payload.output_correct
    payload.reachable_dynamic_hierarchy
    payload.reachable_dynamic_hierarchy_proof

/-- Build the strategy-reachable finite-memory retraction from the payload. -/
noncomputable def toStrategyReachableFiniteRetraction
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardSafeRawFiniteMemoryPayloadForHeader header) :
    StrategyReachableNoDirectFiniteRetractionForHeader header :=
  StrategyReachableNoDirectFiniteRetractionForHeader.ofRawObserverAndLocalLambdaBridge
    payload.observer payload.HandoffState payload.handoff_ne_initial
    payload.toLocalLambdaBridge

/-- Build the compiler-backed no-direct certificate from the payload. -/
noncomputable def toCompilerCertificate
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardSafeRawFiniteMemoryPayloadForHeader header)
    (gameCompiler :
      DPAFiniteGameCompiler.{u, v, x, y, max u v x y aut, aut}
        In₁ In₂ Out₁ Out₂) :
    NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCompilerCertificate
      In₁ In₂ Out₁ Out₂ A :=
  NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCompilerCertificate.ofRawObserverAndLocalLambdaBridge
    payload.observer payload.HandoffState payload.handoff_ne_initial
    payload.toLocalLambdaBridge gameCompiler

/--
Build the fixed-objective no-direct certificate from the safe payload and one
certified finite-game compilation for the objective at hand.
-/
noncomputable def toFixedGameCertificateWithDPAToFiniteGameCompilation
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardSafeRawFiniteMemoryPayloadForHeader header)
    (gameCompilation :
      DPAToFiniteGameCompilation.{u, v, x, y, max u v x y aut} Out₂ A) :
    NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCertificate
      In₁ In₂ Out₁ Out₂ A :=
  NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCertificate.ofRawObserverAndLocalLambdaBridgeAndDPAToFiniteGameCompilation
    payload.observer payload.HandoffState payload.handoff_ne_initial
    payload.toLocalLambdaBridge gameCompilation

/-- DPA-level decidability from the bundled safe payload. -/
noncomputable def dpaSynthesisDecidable
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardSafeRawFiniteMemoryPayloadForHeader header)
    (gameCompiler :
      DPAFiniteGameCompiler.{u, v, x, y, max u v x y aut, aut}
        In₁ In₂ Out₁ Out₂) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  (payload.toCompilerCertificate gameCompiler).dpaSynthesisDecidable

/--
DPA-level decidability from the bundled safe payload and a fixed-objective
finite-game compilation.
-/
noncomputable def dpaSynthesisDecidableWithDPAToFiniteGameCompilation
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardSafeRawFiniteMemoryPayloadForHeader header)
    (gameCompilation :
      DPAToFiniteGameCompilation.{u, v, x, y, max u v x y aut} Out₂ A) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  (payload.toFixedGameCertificateWithDPAToFiniteGameCompilation
    gameCompilation).dpaSynthesisDecidable

/-- LTL-level decidability from the bundled safe payload for the compiled DPA. -/
noncomputable def ltlSynthesisDecidable
    {AP : Type ap}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    [DecidableEq AP]
    (compiler :
      LTLToDPACompiler.{ap, max u v x y, aut}
        AP
        (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (formula : LTL AP)
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ (compiler.compile formula)}
    (payload : BerardSafeRawFiniteMemoryPayloadForHeader header)
    (gameCompiler :
      DPAFiniteGameCompiler.{u, v, x, y, max u v x y aut, aut}
        In₁ In₂ Out₁ Out₂) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          LTL.Satisfies compiler.interp word formula)) :=
  (payload.toCompilerCertificate gameCompiler).ltlSynthesisDecidable
    compiler formula

/--
LTL-level decidability from the bundled safe payload and a fixed finite-game
compilation for the DPA produced by the LTL compiler on `formula`.
-/
noncomputable def ltlSynthesisDecidableWithDPAToFiniteGameCompilation
    {AP : Type ap}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    [DecidableEq AP]
    (compiler :
      LTLToDPACompiler.{ap, max u v x y, aut}
        AP
        (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (formula : LTL AP)
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ (compiler.compile formula)}
    (payload : BerardSafeRawFiniteMemoryPayloadForHeader header)
    (gameCompilation :
      DPAToFiniteGameCompilation.{u, v, x, y, max u v x y aut}
        Out₂ (compiler.compile formula)) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          LTL.Satisfies compiler.interp word formula)) :=
  (payload.toFixedGameCertificateWithDPAToFiniteGameCompilation
    gameCompilation).ltlSynthesisDecidable compiler formula

end BerardSafeRawFiniteMemoryPayloadForHeader

/--
Full product controller/monitor assembly.

This is the corrected product-state interface.  Unlike
`BerardUniformControllerMonitorAssemblyForHeader`, the monitor update is allowed
to depend on the active Bérard table control.  Therefore this structure does not
assert right-congruence of `BerardNoDirectGeneratedObservationState` alone; its
append law is for the full product state `(control, observation)`.
-/
structure BerardFullProductControllerMonitorAssemblyForHeader
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  table : BerardUniformOneDirectionalControllerTable problem
  branchOfProduct :
    table.Control ->
      BerardNoDirectGeneratedObservationState header ->
        EnvironmentRound In₁ In₂ -> Branch
  controlOfGenerated :
    List (EnvironmentRound In₁ In₂) -> table.Control
  control_nil :
    controlOfGenerated [] = table.initial
  control_snoc :
    ∀ (envs : List (EnvironmentRound In₁ In₂))
      (env : EnvironmentRound In₁ In₂),
      controlOfGenerated (envs ++ [env]) =
        table.step (controlOfGenerated envs)
          (branchOfProduct
            (controlOfGenerated envs)
            (berardNoDirectGeneratedObservation header envs) env)
  observationStep :
    table.Control ->
      BerardNoDirectGeneratedObservationState header ->
        EnvironmentRound In₁ In₂ ->
          BerardNoDirectGeneratedObservationState header
  observation_snoc :
    ∀ (envs : List (EnvironmentRound In₁ In₂))
      (env : EnvironmentRound In₁ In₂),
      berardNoDirectGeneratedObservation header (envs ++ [env]) =
        observationStep
          (controlOfGenerated envs)
          (berardNoDirectGeneratedObservation header envs) env
  outputRealizer : Prop
  outputRealizer_proof : outputRealizer

namespace BerardFullProductControllerMonitorAssemblyForHeader

/-- Build the full product assembly from an explicit uniform table. -/
noncomputable def ofTable
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (table : BerardUniformOneDirectionalControllerTable problem)
    (branchOfProduct :
      table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ -> Branch)
    (controlOfGenerated :
      List (EnvironmentRound In₁ In₂) -> table.Control)
    (control_nil : controlOfGenerated [] = table.initial)
    (control_snoc :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        controlOfGenerated (envs ++ [env]) =
          table.step (controlOfGenerated envs)
            (branchOfProduct
              (controlOfGenerated envs)
              (berardNoDirectGeneratedObservation header envs) env))
    (observationStep :
      table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ ->
            BerardNoDirectGeneratedObservationState header)
    (observation_snoc :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        berardNoDirectGeneratedObservation header (envs ++ [env]) =
          observationStep
            (controlOfGenerated envs)
            (berardNoDirectGeneratedObservation header envs) env)
    (outputRealizer : Prop)
    (outputRealizer_proof : outputRealizer) :
    BerardFullProductControllerMonitorAssemblyForHeader
      (problem := problem) header where
  table := table
  branchOfProduct := branchOfProduct
  controlOfGenerated := controlOfGenerated
  control_nil := control_nil
  control_snoc := control_snoc
  observationStep := observationStep
  observation_snoc := observation_snoc
  outputRealizer := outputRealizer
  outputRealizer_proof := outputRealizer_proof

/--
Fold the active Bérard control and the generated monitor observation together.

This removes the generated control trace as an external proof obligation.  The
external construction only has to prove that the observation component of this
fold is the actual generated monitor observation.
-/
noncomputable def productFold
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (table : BerardUniformOneDirectionalControllerTable problem)
    (branchOfProduct :
      table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ -> Branch)
    (observationStep :
      table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ ->
            BerardNoDirectGeneratedObservationState header)
    (envs : List (EnvironmentRound In₁ In₂)) :
    table.Control × BerardNoDirectGeneratedObservationState header :=
  envs.foldl
    (fun state env =>
      ( table.step state.1 (branchOfProduct state.1 state.2 env)
      , observationStep state.1 state.2 env ))
    (table.initial, berardNoDirectGeneratedObservation header [])

@[simp] theorem productFold_nil
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (table : BerardUniformOneDirectionalControllerTable problem)
    (branchOfProduct :
      table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ -> Branch)
    (observationStep :
      table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ ->
            BerardNoDirectGeneratedObservationState header) :
    productFold table branchOfProduct observationStep [] =
      (table.initial, berardNoDirectGeneratedObservation header []) := rfl

theorem productFold_snoc
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (table : BerardUniformOneDirectionalControllerTable problem)
    (branchOfProduct :
      table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ -> Branch)
    (observationStep :
      table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ ->
            BerardNoDirectGeneratedObservationState header)
    (envs : List (EnvironmentRound In₁ In₂))
    (env : EnvironmentRound In₁ In₂) :
    productFold table branchOfProduct observationStep (envs ++ [env]) =
      ( table.step (productFold table branchOfProduct observationStep envs).1
          (branchOfProduct
            (productFold table branchOfProduct observationStep envs).1
            (productFold table branchOfProduct observationStep envs).2 env)
      , observationStep
          (productFold table branchOfProduct observationStep envs).1
          (productFold table branchOfProduct observationStep envs).2 env ) := by
  simp [productFold, List.foldl_append]

/--
The global product-fold observation invariant follows from the one-step
monitor-correctness law.

This is the checked induction used by the paper proof.  The external Bérard
construction no longer has to provide the closed invariant directly; it can
prove the local step equation after unfolding the no-direct cases.
-/
theorem productFold_observation_correct_of_step_correct
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (table : BerardUniformOneDirectionalControllerTable problem)
    (branchOfProduct :
      table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ -> Branch)
    (observationStep :
      table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ ->
            BerardNoDirectGeneratedObservationState header)
    (observation_step_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        observationStep
            (productFold table branchOfProduct observationStep envs).1
            (berardNoDirectGeneratedObservation header envs) env =
          berardNoDirectGeneratedObservation header (envs ++ [env])) :
    ∀ envs,
      (productFold table branchOfProduct observationStep envs).2 =
        berardNoDirectGeneratedObservation header envs := by
  intro envs
  induction envs using List.reverseRecOn with
  | nil =>
      simp [productFold]
  | append_singleton envs env ih =>
      rw [productFold_snoc]
      simpa [ih] using observation_step_correct envs env

/--
Build the full product assembly by folding the table and monitor together.

The generated control trace and its `snoc` law are derived from the fold.  The
only semantic append law supplied externally is that the folded observation
component is the actual generated observation.
-/
noncomputable def ofTableAndProductFold
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (table : BerardUniformOneDirectionalControllerTable problem)
    (branchOfProduct :
      table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ -> Branch)
    (observationStep :
      table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ ->
            BerardNoDirectGeneratedObservationState header)
    (observation_fold_correct :
      ∀ envs,
        (productFold table branchOfProduct observationStep envs).2 =
          berardNoDirectGeneratedObservation header envs)
    (outputRealizer : Prop)
    (outputRealizer_proof : outputRealizer) :
    BerardFullProductControllerMonitorAssemblyForHeader
      (problem := problem) header where
  table := table
  branchOfProduct := branchOfProduct
  controlOfGenerated := fun envs =>
    (productFold table branchOfProduct observationStep envs).1
  control_nil := by
    simp [productFold]
  control_snoc := by
    intro envs env
    rw [productFold_snoc]
    simp [observation_fold_correct envs]
  observationStep := observationStep
  observation_snoc := by
    intro envs env
    have hnext := observation_fold_correct (envs ++ [env])
    rw [productFold_snoc] at hnext
    simpa [observation_fold_correct envs] using hnext.symm
  outputRealizer := outputRealizer
  outputRealizer_proof := outputRealizer_proof

/--
Build the full product assembly from the one-step monitor-correctness law.

This is the preferred proof-facing constructor: Lean performs the induction
that turns the one-step law into the closed product-fold invariant.
-/
noncomputable def ofTableAndProductStep
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (table : BerardUniformOneDirectionalControllerTable problem)
    (branchOfProduct :
      table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ -> Branch)
    (observationStep :
      table.Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ ->
            BerardNoDirectGeneratedObservationState header)
    (observation_step_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        observationStep
            (productFold table branchOfProduct observationStep envs).1
            (berardNoDirectGeneratedObservation header envs) env =
          berardNoDirectGeneratedObservation header (envs ++ [env]))
    (outputRealizer : Prop)
    (outputRealizer_proof : outputRealizer) :
    BerardFullProductControllerMonitorAssemblyForHeader
      (problem := problem) header :=
  ofTableAndProductFold table branchOfProduct observationStep
    (productFold_observation_correct_of_step_correct
      table branchOfProduct observationStep observation_step_correct)
    outputRealizer outputRealizer_proof

/--
Build the full product assembly from finite-summary boundary witnesses.

Bérard supplies the uniform table; the remaining product-specific inputs are the
branch decoder, the generated control fold, and the full product monitor update.
-/
noncomputable def ofFiniteSummaryBoundaries
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    (problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet)
    (hfinite : ∀ boundary, problem.finiteSummaryRealizable boundary)
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (branchOfProduct :
      (BerardUniformOneDirectionalControllerTable.ofFiniteSummaryRealizable
        problem hfinite).Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ -> Branch)
    (controlOfGenerated :
      List (EnvironmentRound In₁ In₂) ->
        (BerardUniformOneDirectionalControllerTable.ofFiniteSummaryRealizable
          problem hfinite).Control)
    (control_nil :
      controlOfGenerated [] =
        (BerardUniformOneDirectionalControllerTable.ofFiniteSummaryRealizable
          problem hfinite).initial)
    (control_snoc :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        controlOfGenerated (envs ++ [env]) =
          (BerardUniformOneDirectionalControllerTable.ofFiniteSummaryRealizable
            problem hfinite).step (controlOfGenerated envs)
            (branchOfProduct
              (controlOfGenerated envs)
              (berardNoDirectGeneratedObservation header envs) env))
    (observationStep :
      (BerardUniformOneDirectionalControllerTable.ofFiniteSummaryRealizable
        problem hfinite).Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ ->
            BerardNoDirectGeneratedObservationState header)
    (observation_snoc :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        berardNoDirectGeneratedObservation header (envs ++ [env]) =
          observationStep
            (controlOfGenerated envs)
            (berardNoDirectGeneratedObservation header envs) env)
    (outputRealizer : Prop)
    (outputRealizer_proof : outputRealizer) :
    BerardFullProductControllerMonitorAssemblyForHeader
      (problem := problem) header :=
  ofTable
    (BerardUniformOneDirectionalControllerTable.ofFiniteSummaryRealizable
      problem hfinite)
    branchOfProduct controlOfGenerated control_nil control_snoc
    observationStep observation_snoc outputRealizer outputRealizer_proof

/-- Full product assembly with the obsolete opaque output realizer set to `True`. -/
