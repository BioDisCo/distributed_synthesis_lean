end BerardSemanticProductObserverConstructionForHeader

/--
Direct product observer before choosing the header generation bound.

This is the natural output of the finite Bérard product construction: finite
state, deterministic generated transition, monitor correctness, and output
realization.  It deliberately has no `bounded_reachable_state` field.  Lean
computes a sufficient bound from finiteness of the reachable state space.
-/
structure BerardDirectProductObserverRawConstructionForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  ProductState : Type (max u v x y aut)
  productFinite : Fintype ProductState
  stateOfGenerated :
    List (EnvironmentRound In₁ In₂) -> ProductState
  initialState : ProductState
  initial_state : stateOfGenerated [] = initialState
  step : ProductState -> EnvironmentRound In₁ In₂ -> ProductState
  state_snoc :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      stateOfGenerated (envs ++ [env]) = step (stateOfGenerated envs) env
  truthOfState :
    ProductState -> RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  epochOfState :
    ProductState ->
      EpochRotatingAccessState
        header.toCurrentOrderHeader.toHeader.importedUniform.boundary
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two)
  automatonOfState :
    ProductState -> header.AState
  receiptOfState :
    ProductState -> ReceiptOrderData
  generated_truth :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      truthOfState (stateOfGenerated envs) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ envs))
  generated_epoch :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      epochOfState (stateOfGenerated envs) =
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (executionPrefixFromList header.σ envs)
  generated_automaton :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      automatonOfState (stateOfGenerated envs) =
        header.automatonOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (executionPrefixFromList header.σ envs)))
  generated_receipt :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      receiptOfState (stateOfGenerated envs) =
        currentReceiptOrderData
          (executionPrefixFromList header.σ envs)
          (historyCurrentContainmentOrder
            (executionPrefixFromList header.σ envs))
  outputRealizer : Prop
  outputRealizer_proof : outputRealizer

attribute [instance] BerardDirectProductObserverRawConstructionForHeader.productFinite

namespace BerardDirectProductObserverRawConstructionForHeader

/-- The finite reachable graph supplies a generation bound automatically. -/
noncomputable def reachableGenerationBound
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header) :
    Nat :=
  Classical.choose
    (ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader.finite_reachable_state_bound
      observer.stateOfGenerated)

theorem reachableGenerationBound_spec
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header) :
    ∀ s : observer.ProductState,
      (∃ envs : List (EnvironmentRound In₁ In₂),
        observer.stateOfGenerated envs = s) ->
      ∃ envs : List (EnvironmentRound In₁ In₂),
        observer.stateOfGenerated envs = s ∧
          envs.length ≤ observer.reachableGenerationBound :=
  Classical.choose_spec
    (ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader.finite_reachable_state_bound
      observer.stateOfGenerated)

/--
Choose a generated representative for a reachable raw product-observer state.

This is the strategy-reachable replacement for the old all-history truth-atom
representative choice: the domain is only the image of `stateOfGenerated`.
-/
noncomputable def representativeOfReachable
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header)
    (s : observer.ProductState)
    (hs :
      ∃ envs : List (EnvironmentRound In₁ In₂),
        observer.stateOfGenerated envs = s) :
    List (EnvironmentRound In₁ In₂) :=
  Classical.choose (observer.reachableGenerationBound_spec s hs)

theorem representativeOfReachable_state
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header)
    (s : observer.ProductState)
    (hs :
      ∃ envs : List (EnvironmentRound In₁ In₂),
        observer.stateOfGenerated envs = s) :
    observer.stateOfGenerated (observer.representativeOfReachable s hs) = s :=
  (Classical.choose_spec (observer.reachableGenerationBound_spec s hs)).1

theorem representativeOfReachable_bound
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header)
    (s : observer.ProductState)
    (hs :
      ∃ envs : List (EnvironmentRound In₁ In₂),
        observer.stateOfGenerated envs = s) :
    (observer.representativeOfReachable s hs).length ≤
      observer.reachableGenerationBound :=
  (Classical.choose_spec (observer.reachableGenerationBound_spec s hs)).2

theorem representativeOfReachable_nonempty_of_ne_initial
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header)
    (s : observer.ProductState)
    (hs :
      ∃ envs : List (EnvironmentRound In₁ In₂),
        observer.stateOfGenerated envs = s)
    (hne : s ≠ observer.initialState) :
    observer.representativeOfReachable s hs ≠ [] := by
  intro hempty
  have hstate :
      observer.stateOfGenerated (observer.representativeOfReachable s hs) = s :=
    observer.representativeOfReachable_state s hs
  have hs_initial : s = observer.initialState := by
    calc
      s = observer.stateOfGenerated (observer.representativeOfReachable s hs) :=
        hstate.symm
      _ = observer.stateOfGenerated ([] : List (EnvironmentRound In₁ In₂)) := by
        rw [hempty]
      _ = observer.initialState := observer.initial_state
  exact hne hs_initial

/--
Convert a raw direct observer into a bounded direct observer for any header
bound that dominates the automatically computed reachable-state bound.
-/
noncomputable def toBoundedDirectProductObserverConstructionWithBound
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header)
    (generationBound : Nat)
    (hbound : observer.reachableGenerationBound ≤ generationBound) :
    BerardDirectProductObserverConstructionForHeader
      (header.withGenerationBound generationBound) where
  ProductState := observer.ProductState
  productFinite := observer.productFinite
  stateOfGenerated := observer.stateOfGenerated
  initialState := observer.initialState
  initial_state := observer.initial_state
  step := observer.step
  state_snoc := observer.state_snoc
  truthOfState := observer.truthOfState
  epochOfState := observer.epochOfState
  automatonOfState := observer.automatonOfState
  receiptOfState := observer.receiptOfState
  generated_truth := by
    intro envs
    simpa [NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.withGenerationBound]
      using observer.generated_truth envs
  generated_epoch := by
    intro envs
    simpa [NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.withGenerationBound]
      using observer.generated_epoch envs
  generated_automaton := by
    intro envs
    simpa [NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.withGenerationBound]
      using observer.generated_automaton envs
  generated_receipt := by
    intro envs
    simpa [NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.withGenerationBound]
      using observer.generated_receipt envs
  bounded_reachable_state := by
    intro s hs
    rcases observer.reachableGenerationBound_spec s hs with
      ⟨envs, hstate, hlen⟩
    refine ⟨envs, hstate, ?_⟩
    exact le_trans hlen hbound
  outputRealizer := observer.outputRealizer
  outputRealizer_proof := observer.outputRealizer_proof

/--
Convert a raw direct observer into the bounded direct observer by replacing the
header generation bound with the finite reachable-state bound computed above.
-/
noncomputable def toBoundedDirectProductObserverConstruction
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header) :
    BerardDirectProductObserverConstructionForHeader
      (header.withGenerationBound observer.reachableGenerationBound) :=
  observer.toBoundedDirectProductObserverConstructionWithBound
    observer.reachableGenerationBound (le_refl _)

/--
Concrete generated-prefix dynamic hierarchy carried by the receipt/order
monitor of a raw observer.

Only nonempty generated prefixes are included.  The empty prefix is the initial
state and is handled separately by the no-direct handoff interface.
-/
def GeneratedReceiptOrderDynamicHierarchy
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header) :
    Prop :=
  ∀ envs : List (EnvironmentRound In₁ In₂), envs ≠ [] ->
    CurrentNonFringeOrder
      (executionPrefixFromList header.σ envs)
      (observer.receiptOfState (observer.stateOfGenerated envs)).containmentOrder

/--
The receipt/order monitor proves the concrete dynamic-hierarchy fact on every
nonempty generated prefix.
-/
theorem generatedReceiptOrderDynamicHierarchy
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header) :
    observer.GeneratedReceiptOrderDynamicHierarchy := by
  intro envs hnonempty
  rcases executionPrefixFromList_eq_append_of_ne_nil header.σ hnonempty with
    ⟨pref, r, hprefix⟩
  have hreceipt := observer.generated_receipt envs
  rw [hreceipt]
  simp only [currentReceiptOrderData_containmentOrder]
  rw [hprefix, historyCurrentContainmentOrder_append]
  exact currentNonFringeOrder_append pref r

end BerardDirectProductObserverRawConstructionForHeader

/--
Concrete local-lambda bridge for a raw generated product observer.

This is the Lean shape of the paper's corrected Bérard import.  The observer
already provides the generated finite state and the monitor projections.  This
bridge adds the genuinely local finite data: for each process a finite history
summary code `Hist*`, a finite current-fringe selector `Fringe*`, decoders from
the real local view, locally factored output tables, and the reachable
dynamic-hierarchy proof.

The local observation used downstream is the finite pair `(Hist*, Fringe*)`.
It is deliberately not a list of summaries: the finite-game endpoint needs a
finite observation type.
-/
structure BerardLocalLambdaBridgeForRawObserver
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header) where
  HistOne : Type (max u v x y aut)
  HistTwo : Type (max u v x y aut)
  FringeOne : Type (max u v x y aut)
  FringeTwo : Type (max u v x y aut)
  histOneFinite : Fintype HistOne
  histTwoFinite : Fintype HistTwo
  fringeOneFinite : Fintype FringeOne
  fringeTwoFinite : Fintype FringeTwo
  histOne : observer.ProductState -> EnvironmentRound In₁ In₂ -> HistOne
  histTwo : observer.ProductState -> EnvironmentRound In₁ In₂ -> HistTwo
  fringeOne : observer.ProductState -> EnvironmentRound In₁ In₂ -> FringeOne
  fringeTwo : observer.ProductState -> EnvironmentRound In₁ In₂ -> FringeTwo
  histOfViewOne : View In₁ In₂ Proc.one -> HistOne
  histOfViewTwo : View In₁ In₂ Proc.two -> HistTwo
  fringeOfViewOne : View In₁ In₂ Proc.one -> FringeOne
  fringeOfViewTwo : View In₁ In₂ Proc.two -> FringeTwo
  outputOne : observer.ProductState -> EnvironmentRound In₁ In₂ -> Out₁
  outputTwo : observer.ProductState -> EnvironmentRound In₁ In₂ -> Out₂
  histOne_sound :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      histOne (observer.stateOfGenerated envs) env =
        histOfViewOne
          (nextView Proc.one (executionPrefixFromList header.σ envs) env)
  histTwo_sound :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      histTwo (observer.stateOfGenerated envs) env =
        histOfViewTwo
          (nextView Proc.two (executionPrefixFromList header.σ envs) env)
  fringeOne_sound :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      fringeOne (observer.stateOfGenerated envs) env =
        fringeOfViewOne
          (nextView Proc.one (executionPrefixFromList header.σ envs) env)
  fringeTwo_sound :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      fringeTwo (observer.stateOfGenerated envs) env =
        fringeOfViewTwo
          (nextView Proc.two (executionPrefixFromList header.σ envs) env)
  output_generated_correct :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      (outputOne (observer.stateOfGenerated envs) env,
          outputTwo (observer.stateOfGenerated envs) env) =
        ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
          (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo)
  outputOne_local :
    ∀ (stateA : observer.ProductState) (envA : EnvironmentRound In₁ In₂)
      (stateB : observer.ProductState) (envB : EnvironmentRound In₁ In₂),
      histOne stateA envA = histOne stateB envB ->
      fringeOne stateA envA = fringeOne stateB envB ->
        outputOne stateA envA = outputOne stateB envB
  outputTwo_local :
    ∀ (stateA : observer.ProductState) (envA : EnvironmentRound In₁ In₂)
      (stateB : observer.ProductState) (envB : EnvironmentRound In₁ In₂),
      histTwo stateA envA = histTwo stateB envB ->
      fringeTwo stateA envA = fringeTwo stateB envB ->
        outputTwo stateA envA = outputTwo stateB envB
  reachable_dynamic_hierarchy : Prop
  reachable_dynamic_hierarchy_proof : reachable_dynamic_hierarchy

attribute [instance] BerardLocalLambdaBridgeForRawObserver.histOneFinite
attribute [instance] BerardLocalLambdaBridgeForRawObserver.histTwoFinite
attribute [instance] BerardLocalLambdaBridgeForRawObserver.fringeOneFinite
attribute [instance] BerardLocalLambdaBridgeForRawObserver.fringeTwoFinite

namespace BerardLocalLambdaBridgeForRawObserver

def localObsOne
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    {observer : BerardDirectProductObserverRawConstructionForHeader header}
    (bridge : BerardLocalLambdaBridgeForRawObserver observer) :
    observer.ProductState -> EnvironmentRound In₁ In₂ ->
      bridge.HistOne × bridge.FringeOne :=
  fun state env => (bridge.histOne state env, bridge.fringeOne state env)

def localObsTwo
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    {observer : BerardDirectProductObserverRawConstructionForHeader header}
    (bridge : BerardLocalLambdaBridgeForRawObserver observer) :
    observer.ProductState -> EnvironmentRound In₁ In₂ ->
      bridge.HistTwo × bridge.FringeTwo :=
  fun state env => (bridge.histTwo state env, bridge.fringeTwo state env)

theorem localObsOne_sound
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    {observer : BerardDirectProductObserverRawConstructionForHeader header}
    (bridge : BerardLocalLambdaBridgeForRawObserver observer) :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      bridge.localObsOne (observer.stateOfGenerated envs) env =
        (bridge.histOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env),
          bridge.fringeOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env)) := by
  intro envs env
  exact Prod.ext (bridge.histOne_sound envs env)
    (bridge.fringeOne_sound envs env)

theorem localObsTwo_sound
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    {observer : BerardDirectProductObserverRawConstructionForHeader header}
    (bridge : BerardLocalLambdaBridgeForRawObserver observer) :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      bridge.localObsTwo (observer.stateOfGenerated envs) env =
        (bridge.histOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env),
          bridge.fringeOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env)) := by
  intro envs env
  exact Prod.ext (bridge.histTwo_sound envs env)
    (bridge.fringeTwo_sound envs env)

theorem output_depends_on_localObs
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    {observer : BerardDirectProductObserverRawConstructionForHeader header}
    (bridge : BerardLocalLambdaBridgeForRawObserver observer) :
    (∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      (bridge.outputOne (observer.stateOfGenerated envs) env,
          bridge.outputTwo (observer.stateOfGenerated envs) env) =
        ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
          (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo)) ∧
      (∀ (stateA : observer.ProductState) (envA : EnvironmentRound In₁ In₂)
        (stateB : observer.ProductState) (envB : EnvironmentRound In₁ In₂),
        bridge.localObsOne stateA envA = bridge.localObsOne stateB envB ->
          bridge.outputOne stateA envA = bridge.outputOne stateB envB) ∧
      (∀ (stateA : observer.ProductState) (envA : EnvironmentRound In₁ In₂)
        (stateB : observer.ProductState) (envB : EnvironmentRound In₁ In₂),
        bridge.localObsTwo stateA envA = bridge.localObsTwo stateB envB ->
          bridge.outputTwo stateA envA = bridge.outputTwo stateB envB) := by
  refine ⟨bridge.output_generated_correct, ?_, ?_⟩
  · intro stateA envA stateB envB hobs
    exact bridge.outputOne_local stateA envA stateB envB
      (congrArg Prod.fst hobs) (congrArg Prod.snd hobs)
  · intro stateA envA stateB envB hobs
    exact bridge.outputTwo_local stateA envA stateB envB
      (congrArg Prod.fst hobs) (congrArg Prod.snd hobs)

/--
Choice of process-1 output from a finite local observation.

The local-lambda bridge stores `outputOne` as a function of the raw observer
state and current environment round, together with the proof that it is
constant on equal process-1 local observations.  This definition quotients it
to an actual table on `(HistOne, FringeOne)`.  For observations that are not
realized by any state/round pair, the value is irrelevant and is chosen from the
header strategy at the empty view.
-/
noncomputable def outputOneOfLocalObservation
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    {observer : BerardDirectProductObserverRawConstructionForHeader header}
    (bridge : BerardLocalLambdaBridgeForRawObserver observer)
    (hist : bridge.HistOne) (fringe : bridge.FringeOne) : Out₁ := by
  classical
  by_cases h :
      ∃ pair : observer.ProductState × EnvironmentRound In₁ In₂,
        bridge.histOne pair.1 pair.2 = hist ∧
          bridge.fringeOne pair.1 pair.2 = fringe
  · exact bridge.outputOne (Classical.choose h).1 (Classical.choose h).2
  · exact header.σ.one (View.empty Proc.one)

/-- The quotient table agrees with `outputOne` on every realized local observation. -/
theorem outputOneOfLocalObservation_spec
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    {observer : BerardDirectProductObserverRawConstructionForHeader header}
    (bridge : BerardLocalLambdaBridgeForRawObserver observer)
    (state : observer.ProductState) (env : EnvironmentRound In₁ In₂) :
    bridge.outputOneOfLocalObservation
        (bridge.histOne state env) (bridge.fringeOne state env) =
      bridge.outputOne state env := by
  classical
  unfold outputOneOfLocalObservation
  let witness :
      ∃ pair : observer.ProductState × EnvironmentRound In₁ In₂,
        bridge.histOne pair.1 pair.2 = bridge.histOne state env ∧
          bridge.fringeOne pair.1 pair.2 = bridge.fringeOne state env :=
    ⟨(state, env), rfl, rfl⟩
  rw [dif_pos witness]
  exact bridge.outputOne_local
    (Classical.choose witness).1 (Classical.choose witness).2
    state env
    (Classical.choose_spec witness).1
    (Classical.choose_spec witness).2

/--
Choice of process-2 output from a finite local observation.  This is the
process-2 analogue of `outputOneOfLocalObservation`.
-/
noncomputable def outputTwoOfLocalObservation
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    {observer : BerardDirectProductObserverRawConstructionForHeader header}
    (bridge : BerardLocalLambdaBridgeForRawObserver observer)
    (hist : bridge.HistTwo) (fringe : bridge.FringeTwo) : Out₂ := by
  classical
  by_cases h :
      ∃ pair : observer.ProductState × EnvironmentRound In₁ In₂,
        bridge.histTwo pair.1 pair.2 = hist ∧
          bridge.fringeTwo pair.1 pair.2 = fringe
  · exact bridge.outputTwo (Classical.choose h).1 (Classical.choose h).2
  · exact header.σ.two (View.empty Proc.two)

/-- The quotient table agrees with `outputTwo` on every realized local observation. -/
theorem outputTwoOfLocalObservation_spec
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    {observer : BerardDirectProductObserverRawConstructionForHeader header}
    (bridge : BerardLocalLambdaBridgeForRawObserver observer)
    (state : observer.ProductState) (env : EnvironmentRound In₁ In₂) :
    bridge.outputTwoOfLocalObservation
        (bridge.histTwo state env) (bridge.fringeTwo state env) =
      bridge.outputTwo state env := by
  classical
  unfold outputTwoOfLocalObservation
  let witness :
      ∃ pair : observer.ProductState × EnvironmentRound In₁ In₂,
        bridge.histTwo pair.1 pair.2 = bridge.histTwo state env ∧
          bridge.fringeTwo pair.1 pair.2 = bridge.fringeTwo state env :=
    ⟨(state, env), rfl, rfl⟩
  rw [dif_pos witness]
  exact bridge.outputTwo_local
    (Classical.choose witness).1 (Classical.choose witness).2
    state env
    (Classical.choose_spec witness).1
    (Classical.choose_spec witness).2

/--
Build the raw local-lambda bridge when the output tables visibly factor through
the finite local summaries and finite fringe selectors.

This is the direct version of the local-label output-factorization constructor:
it is independent of the uniform-assembly/right-congruence route and matches the
safe product-observer proof.  The external construction supplies the finite
local observations, decoders from real local views, and process-local lambda
tables `chooseOne` and `chooseTwo`.
-/
noncomputable def ofOutputFactorization
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header)
    (HistOne HistTwo FringeOne FringeTwo : Type (max u v x y aut))
    [histOneFinite : Fintype HistOne]
    [histTwoFinite : Fintype HistTwo]
    [fringeOneFinite : Fintype FringeOne]
    [fringeTwoFinite : Fintype FringeTwo]
    (histOne : observer.ProductState -> EnvironmentRound In₁ In₂ -> HistOne)
    (histTwo : observer.ProductState -> EnvironmentRound In₁ In₂ -> HistTwo)
    (fringeOne : observer.ProductState -> EnvironmentRound In₁ In₂ -> FringeOne)
    (fringeTwo : observer.ProductState -> EnvironmentRound In₁ In₂ -> FringeTwo)
    (histOfViewOne : View In₁ In₂ Proc.one -> HistOne)
    (histOfViewTwo : View In₁ In₂ Proc.two -> HistTwo)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> FringeOne)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> FringeTwo)
    (chooseOne : HistOne -> FringeOne -> Out₁)
    (chooseTwo : HistTwo -> FringeTwo -> Out₂)
    (histOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        histOne (observer.stateOfGenerated envs) env =
          histOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (histTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        histTwo (observer.stateOfGenerated envs) env =
          histOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (fringeOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        fringeOne (observer.stateOfGenerated envs) env =
          fringeOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (fringeTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        fringeTwo (observer.stateOfGenerated envs) env =
          fringeOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (output_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        ( chooseOne
            (histOne (observer.stateOfGenerated envs) env)
            (fringeOne (observer.stateOfGenerated envs) env)
        , chooseTwo
            (histTwo (observer.stateOfGenerated envs) env)
            (fringeTwo (observer.stateOfGenerated envs) env) ) =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo))
    (reachable_dynamic_hierarchy : Prop)
    (reachable_dynamic_hierarchy_proof : reachable_dynamic_hierarchy) :
    BerardLocalLambdaBridgeForRawObserver observer where
  HistOne := HistOne
  HistTwo := HistTwo
  FringeOne := FringeOne
  FringeTwo := FringeTwo
  histOneFinite := histOneFinite
  histTwoFinite := histTwoFinite
  fringeOneFinite := fringeOneFinite
  fringeTwoFinite := fringeTwoFinite
  histOne := histOne
  histTwo := histTwo
  fringeOne := fringeOne
  fringeTwo := fringeTwo
  histOfViewOne := histOfViewOne
  histOfViewTwo := histOfViewTwo
  fringeOfViewOne := fringeOfViewOne
  fringeOfViewTwo := fringeOfViewTwo
  outputOne := fun state env => chooseOne (histOne state env) (fringeOne state env)
  outputTwo := fun state env => chooseTwo (histTwo state env) (fringeTwo state env)
  histOne_sound := histOne_sound
  histTwo_sound := histTwo_sound
  fringeOne_sound := fringeOne_sound
  fringeTwo_sound := fringeTwo_sound
  output_generated_correct := output_correct
  outputOne_local := by
    intro stateA envA stateB envB hhist hfringe
    simp [hhist, hfringe]
  outputTwo_local := by
    intro stateA envA stateB envB hhist hfringe
    simp [hhist, hfringe]
  reachable_dynamic_hierarchy := reachable_dynamic_hierarchy
  reachable_dynamic_hierarchy_proof := reachable_dynamic_hierarchy_proof

/--
Build the raw local-lambda bridge from finite local output factorization,
discharging the generated-prefix hierarchy by the receipt/order monitor of the
raw observer.
-/
noncomputable def ofOutputFactorizationWithGeneratedReceiptHierarchy
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header)
    (HistOne HistTwo FringeOne FringeTwo : Type (max u v x y aut))
    [histOneFinite : Fintype HistOne]
    [histTwoFinite : Fintype HistTwo]
    [fringeOneFinite : Fintype FringeOne]
    [fringeTwoFinite : Fintype FringeTwo]
    (histOne : observer.ProductState -> EnvironmentRound In₁ In₂ -> HistOne)
    (histTwo : observer.ProductState -> EnvironmentRound In₁ In₂ -> HistTwo)
    (fringeOne : observer.ProductState -> EnvironmentRound In₁ In₂ -> FringeOne)
    (fringeTwo : observer.ProductState -> EnvironmentRound In₁ In₂ -> FringeTwo)
    (histOfViewOne : View In₁ In₂ Proc.one -> HistOne)
    (histOfViewTwo : View In₁ In₂ Proc.two -> HistTwo)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> FringeOne)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> FringeTwo)
    (chooseOne : HistOne -> FringeOne -> Out₁)
    (chooseTwo : HistTwo -> FringeTwo -> Out₂)
    (histOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        histOne (observer.stateOfGenerated envs) env =
          histOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (histTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        histTwo (observer.stateOfGenerated envs) env =
          histOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (fringeOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        fringeOne (observer.stateOfGenerated envs) env =
          fringeOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (fringeTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        fringeTwo (observer.stateOfGenerated envs) env =
          fringeOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (output_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        ( chooseOne
            (histOne (observer.stateOfGenerated envs) env)
            (fringeOne (observer.stateOfGenerated envs) env)
        , chooseTwo
            (histTwo (observer.stateOfGenerated envs) env)
            (fringeTwo (observer.stateOfGenerated envs) env) ) =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo)) :
    BerardLocalLambdaBridgeForRawObserver observer :=
  ofOutputFactorization observer HistOne HistTwo FringeOne FringeTwo
    histOne histTwo fringeOne fringeTwo
    histOfViewOne histOfViewTwo fringeOfViewOne fringeOfViewTwo
    chooseOne chooseTwo
    histOne_sound histTwo_sound fringeOne_sound fringeTwo_sound
    output_correct
    observer.GeneratedReceiptOrderDynamicHierarchy
    observer.generatedReceiptOrderDynamicHierarchy

/--
Build the raw local-lambda bridge from bounded list-valued local histories.

The safe product-observer proof often obtains the local Bérard summaries as
lists of finite atoms.  This constructor turns those lists into finite
observations by encoding them as `BoundedListCode`s.  The global length bounds
on the product observer states make the output locality proof routine:
equality of finite codes implies equality of the original lists.
-/
noncomputable def ofBoundedHistoryOutputFactorization
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header)
    {H₁ H₂ R₁ R₂ : Type (max u v x y aut)}
    [histAtomOneFinite : Fintype H₁]
    [histAtomTwoFinite : Fintype H₂]
    [fringeOneFinite : Fintype R₁]
    [fringeTwoFinite : Fintype R₂]
    (historyOne :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> R₂)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (chooseOne : List H₁ -> R₁ -> Out₁)
    (chooseTwo : List H₂ -> R₂ -> Out₂)
    (histBoundOne histBoundTwo : Nat)
    (historyOne_length :
      ∀ (state : observer.ProductState) (env : EnvironmentRound In₁ In₂),
        (historyOne state env).length ≤ histBoundOne)
    (historyTwo_length :
      ∀ (state : observer.ProductState) (env : EnvironmentRound In₁ In₂),
        (historyTwo state env).length ≤ histBoundTwo)
    (historyOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        historyOne (observer.stateOfGenerated envs) env =
          historyOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (historyTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        historyTwo (observer.stateOfGenerated envs) env =
          historyOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (fringeOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        fringeOne (observer.stateOfGenerated envs) env =
          fringeOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (fringeTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        fringeTwo (observer.stateOfGenerated envs) env =
          fringeOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (output_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        ( chooseOne
            (historyOne (observer.stateOfGenerated envs) env)
            (fringeOne (observer.stateOfGenerated envs) env)
        , chooseTwo
            (historyTwo (observer.stateOfGenerated envs) env)
            (fringeTwo (observer.stateOfGenerated envs) env) ) =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo))
    (reachable_dynamic_hierarchy : Prop)
    (reachable_dynamic_hierarchy_proof : reachable_dynamic_hierarchy) :
    BerardLocalLambdaBridgeForRawObserver observer :=
  { HistOne := BoundedListCode H₁ histBoundOne
    HistTwo := BoundedListCode H₂ histBoundTwo
    FringeOne := R₁
    FringeTwo := R₂
    histOneFinite := by
      classical
      infer_instance
    histTwoFinite := by
      classical
      infer_instance
    fringeOneFinite := fringeOneFinite
    fringeTwoFinite := fringeTwoFinite
    histOne := fun state env =>
      BoundedListCode.encode histBoundOne (historyOne state env)
    histTwo := fun state env =>
      BoundedListCode.encode histBoundTwo (historyTwo state env)
    fringeOne := fringeOne
    fringeTwo := fringeTwo
    histOfViewOne := fun view =>
      BoundedListCode.encode histBoundOne (historyOfViewOne view)
    histOfViewTwo := fun view =>
      BoundedListCode.encode histBoundTwo (historyOfViewTwo view)
    fringeOfViewOne := fringeOfViewOne
    fringeOfViewTwo := fringeOfViewTwo
    outputOne := fun state env =>
      chooseOne (historyOne state env) (fringeOne state env)
    outputTwo := fun state env =>
      chooseTwo (historyTwo state env) (fringeTwo state env)
    histOne_sound := by
      intro envs env
      exact congrArg (BoundedListCode.encode histBoundOne)
        (historyOne_sound envs env)
    histTwo_sound := by
      intro envs env
      exact congrArg (BoundedListCode.encode histBoundTwo)
        (historyTwo_sound envs env)
    fringeOne_sound := fringeOne_sound
    fringeTwo_sound := fringeTwo_sound
    output_generated_correct := output_correct
    outputOne_local := by
      intro stateA envA stateB envB hhist hfringe
      have hhistory :
          historyOne stateA envA = historyOne stateB envB :=
        BoundedListCode.encode_injective_of_length_le
          (historyOne_length stateA envA)
          (historyOne_length stateB envB)
          hhist
      simpa [hhistory, hfringe]
    outputTwo_local := by
      intro stateA envA stateB envB hhist hfringe
      have hhistory :
          historyTwo stateA envA = historyTwo stateB envB :=
        BoundedListCode.encode_injective_of_length_le
          (historyTwo_length stateA envA)
          (historyTwo_length stateB envB)
          hhist
      simpa [hhistory, hfringe]
    reachable_dynamic_hierarchy := reachable_dynamic_hierarchy
    reachable_dynamic_hierarchy_proof := reachable_dynamic_hierarchy_proof }

/--
Build the bounded-history raw local-lambda bridge, discharging the
generated-prefix hierarchy by the receipt/order monitor of the raw observer.
-/
noncomputable def ofBoundedHistoryOutputFactorizationWithGeneratedReceiptHierarchy
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header)
    {H₁ H₂ R₁ R₂ : Type (max u v x y aut)}
    [histAtomOneFinite : Fintype H₁]
    [histAtomTwoFinite : Fintype H₂]
    [fringeOneFinite : Fintype R₁]
    [fringeTwoFinite : Fintype R₂]
    (historyOne :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> R₂)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (chooseOne : List H₁ -> R₁ -> Out₁)
    (chooseTwo : List H₂ -> R₂ -> Out₂)
    (histBoundOne histBoundTwo : Nat)
    (historyOne_length :
      ∀ (state : observer.ProductState) (env : EnvironmentRound In₁ In₂),
        (historyOne state env).length ≤ histBoundOne)
    (historyTwo_length :
      ∀ (state : observer.ProductState) (env : EnvironmentRound In₁ In₂),
        (historyTwo state env).length ≤ histBoundTwo)
    (historyOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        historyOne (observer.stateOfGenerated envs) env =
          historyOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (historyTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        historyTwo (observer.stateOfGenerated envs) env =
          historyOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (fringeOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        fringeOne (observer.stateOfGenerated envs) env =
          fringeOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (fringeTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        fringeTwo (observer.stateOfGenerated envs) env =
          fringeOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (output_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
        ( chooseOne
            (historyOne (observer.stateOfGenerated envs) env)
            (fringeOne (observer.stateOfGenerated envs) env)
        , chooseTwo
            (historyTwo (observer.stateOfGenerated envs) env)
            (fringeTwo (observer.stateOfGenerated envs) env) ) =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo)) :
    BerardLocalLambdaBridgeForRawObserver observer :=
  ofBoundedHistoryOutputFactorization observer
    historyOne historyTwo fringeOne fringeTwo
    historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
    chooseOne chooseTwo histBoundOne histBoundTwo
    historyOne_length historyTwo_length
    historyOne_sound historyTwo_sound fringeOne_sound fringeTwo_sound
    output_correct
    observer.GeneratedReceiptOrderDynamicHierarchy
    observer.generatedReceiptOrderDynamicHierarchy

end BerardLocalLambdaBridgeForRawObserver

/--
All-history-free finite-memory endpoint for the no-direct Bérard import.

The state space is the strategy-reachable product observer state.  The only
representatives are generated words for reachable states; there is no field
asking for representatives of arbitrary histories or arbitrary stabilized truth
atoms.  The remaining non-routine proof obligations are the finite
local-observation bridge and the generated-prefix dynamic-hierarchy fact.
-/
structure StrategyReachableNoDirectFiniteRetractionForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  State : Type (max u v x y aut)
  stateFinite : Fintype State
  stateOfGenerated :
    List (EnvironmentRound In₁ In₂) -> State
  initialState : State
  initial_state : stateOfGenerated [] = initialState
  step : State -> EnvironmentRound In₁ In₂ -> State
  state_snoc :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      stateOfGenerated (envs ++ [env]) = step (stateOfGenerated envs) env
  truthOfState :
    State -> RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  epochOfState :
    State ->
      EpochRotatingAccessState
        header.toCurrentOrderHeader.toHeader.importedUniform.boundary
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two)
  automatonOfState :
    State -> header.AState
  receiptOfState :
    State -> ReceiptOrderData
  generated_truth :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      truthOfState (stateOfGenerated envs) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ envs))
  generated_epoch :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      epochOfState (stateOfGenerated envs) =
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (executionPrefixFromList header.σ envs)
  generated_automaton :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      automatonOfState (stateOfGenerated envs) =
        header.automatonOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (executionPrefixFromList header.σ envs)))
  generated_receipt :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      receiptOfState (stateOfGenerated envs) =
        currentReceiptOrderData
          (executionPrefixFromList header.σ envs)
          (historyCurrentContainmentOrder
            (executionPrefixFromList header.σ envs))
  generationBound : Nat
  representativeOfReachable :
    ∀ s : State,
      (∃ envs : List (EnvironmentRound In₁ In₂), stateOfGenerated envs = s) ->
        List (EnvironmentRound In₁ In₂)
  representative_state :
    ∀ (s : State)
      (hs : ∃ envs : List (EnvironmentRound In₁ In₂), stateOfGenerated envs = s),
      stateOfGenerated (representativeOfReachable s hs) = s
  representative_bound :
    ∀ (s : State)
      (hs : ∃ envs : List (EnvironmentRound In₁ In₂), stateOfGenerated envs = s),
      (representativeOfReachable s hs).length ≤ generationBound
  HandoffState : State -> Prop
  handoff_ne_initial :
    ∀ s : State, HandoffState s -> s ≠ initialState
  representative_nonempty_of_handoff :
    ∀ (s : State)
      (hs : ∃ envs : List (EnvironmentRound In₁ In₂), stateOfGenerated envs = s),
      HandoffState s -> representativeOfReachable s hs ≠ []
  LocalObsOne : Type (max u v x y aut)
  LocalObsTwo : Type (max u v x y aut)
  localObsOneFinite : Fintype LocalObsOne
  localObsTwoFinite : Fintype LocalObsTwo
  localObsOne : State -> EnvironmentRound In₁ In₂ -> LocalObsOne
  localObsTwo : State -> EnvironmentRound In₁ In₂ -> LocalObsTwo
  localObsOne_sound : Prop
  localObsOne_sound_proof : localObsOne_sound
  localObsTwo_sound : Prop
  localObsTwo_sound_proof : localObsTwo_sound
  output_depends_on_localObs : Prop
  output_depends_on_localObs_proof : output_depends_on_localObs
  reachable_dynamic_hierarchy : Prop
  reachable_dynamic_hierarchy_proof : reachable_dynamic_hierarchy

attribute [instance] StrategyReachableNoDirectFiniteRetractionForHeader.stateFinite
attribute [instance] StrategyReachableNoDirectFiniteRetractionForHeader.localObsOneFinite
attribute [instance] StrategyReachableNoDirectFiniteRetractionForHeader.localObsTwoFinite

namespace StrategyReachableNoDirectFiniteRetractionForHeader

/--
Build the strategy-reachable endpoint from a raw product observer plus the
finite local-observation bridge.  The generated representatives, their bound,
and nonemptiness on non-initial handoff states are proved here from finiteness of
the reachable observer graph.
-/
noncomputable def ofRawObserverAndLocalBridge
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header)
    (HandoffState : observer.ProductState -> Prop)
    (handoff_ne_initial :
      ∀ s : observer.ProductState, HandoffState s -> s ≠ observer.initialState)
    (LocalObsOne LocalObsTwo : Type (max u v x y aut))
    [localObsOneFinite : Fintype LocalObsOne]
    [localObsTwoFinite : Fintype LocalObsTwo]
    (localObsOne :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> LocalObsOne)
    (localObsTwo :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> LocalObsTwo)
    (localObsOne_sound : Prop)
    (localObsOne_sound_proof : localObsOne_sound)
    (localObsTwo_sound : Prop)
    (localObsTwo_sound_proof : localObsTwo_sound)
    (output_depends_on_localObs : Prop)
    (output_depends_on_localObs_proof : output_depends_on_localObs)
    (reachable_dynamic_hierarchy : Prop)
    (reachable_dynamic_hierarchy_proof : reachable_dynamic_hierarchy) :
    StrategyReachableNoDirectFiniteRetractionForHeader header where
  State := observer.ProductState
  stateFinite := observer.productFinite
  stateOfGenerated := observer.stateOfGenerated
  initialState := observer.initialState
  initial_state := observer.initial_state
  step := observer.step
  state_snoc := observer.state_snoc
  truthOfState := observer.truthOfState
  epochOfState := observer.epochOfState
  automatonOfState := observer.automatonOfState
  receiptOfState := observer.receiptOfState
  generated_truth := observer.generated_truth
  generated_epoch := observer.generated_epoch
  generated_automaton := observer.generated_automaton
  generated_receipt := observer.generated_receipt
  generationBound := observer.reachableGenerationBound
  representativeOfReachable := observer.representativeOfReachable
  representative_state := observer.representativeOfReachable_state
  representative_bound := observer.representativeOfReachable_bound
  HandoffState := HandoffState
  handoff_ne_initial := handoff_ne_initial
  representative_nonempty_of_handoff := by
    intro s hs hs_handoff
    exact observer.representativeOfReachable_nonempty_of_ne_initial s hs
      (handoff_ne_initial s hs_handoff)
  LocalObsOne := LocalObsOne
  LocalObsTwo := LocalObsTwo
  localObsOneFinite := localObsOneFinite
  localObsTwoFinite := localObsTwoFinite
  localObsOne := localObsOne
  localObsTwo := localObsTwo
  localObsOne_sound := localObsOne_sound
  localObsOne_sound_proof := localObsOne_sound_proof
  localObsTwo_sound := localObsTwo_sound
  localObsTwo_sound_proof := localObsTwo_sound_proof
  output_depends_on_localObs := output_depends_on_localObs
  output_depends_on_localObs_proof := output_depends_on_localObs_proof
  reachable_dynamic_hierarchy := reachable_dynamic_hierarchy
  reachable_dynamic_hierarchy_proof := reachable_dynamic_hierarchy_proof

/--
Build the strategy-reachable endpoint from a raw product observer and finite
local observations, using the concrete receipt/order hierarchy proved from the
generated monitor instead of taking an opaque hierarchy field.
-/
noncomputable def ofRawObserverAndLocalBridgeWithGeneratedReceiptHierarchy
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header)
    (HandoffState : observer.ProductState -> Prop)
    (handoff_ne_initial :
      ∀ s : observer.ProductState, HandoffState s -> s ≠ observer.initialState)
    (LocalObsOne LocalObsTwo : Type (max u v x y aut))
    [localObsOneFinite : Fintype LocalObsOne]
    [localObsTwoFinite : Fintype LocalObsTwo]
    (localObsOne :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> LocalObsOne)
    (localObsTwo :
      observer.ProductState -> EnvironmentRound In₁ In₂ -> LocalObsTwo)
    (localObsOne_sound : Prop)
    (localObsOne_sound_proof : localObsOne_sound)
    (localObsTwo_sound : Prop)
    (localObsTwo_sound_proof : localObsTwo_sound)
    (output_depends_on_localObs : Prop)
    (output_depends_on_localObs_proof : output_depends_on_localObs) :
    StrategyReachableNoDirectFiniteRetractionForHeader header :=
  ofRawObserverAndLocalBridge observer HandoffState handoff_ne_initial
    LocalObsOne LocalObsTwo localObsOne localObsTwo
    localObsOne_sound localObsOne_sound_proof
    localObsTwo_sound localObsTwo_sound_proof
    output_depends_on_localObs output_depends_on_localObs_proof
    observer.GeneratedReceiptOrderDynamicHierarchy
    observer.generatedReceiptOrderDynamicHierarchy

/--
Build the strategy-reachable endpoint from the concrete finite-lambda bridge.
This packages the hard local part in the exact form used by the paper proof:
finite local summaries/fringe selectors, local decoders, and local output
factorization.
-/
noncomputable def ofRawObserverAndLocalLambdaBridge
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header)
    (HandoffState : observer.ProductState -> Prop)
    (handoff_ne_initial :
      ∀ s : observer.ProductState, HandoffState s -> s ≠ observer.initialState)
    (bridge : BerardLocalLambdaBridgeForRawObserver observer) :
    StrategyReachableNoDirectFiniteRetractionForHeader header :=
  ofRawObserverAndLocalBridge observer HandoffState handoff_ne_initial
    (bridge.HistOne × bridge.FringeOne)
    (bridge.HistTwo × bridge.FringeTwo)
    bridge.localObsOne bridge.localObsTwo
    (∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      bridge.localObsOne (observer.stateOfGenerated envs) env =
        (bridge.histOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env),
          bridge.fringeOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env)))
    bridge.localObsOne_sound
    (∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      bridge.localObsTwo (observer.stateOfGenerated envs) env =
        (bridge.histOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env),
          bridge.fringeOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env)))
    bridge.localObsTwo_sound
    ((∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      (bridge.outputOne (observer.stateOfGenerated envs) env,
          bridge.outputTwo (observer.stateOfGenerated envs) env) =
        ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
          (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo)) ∧
      (∀ (stateA : observer.ProductState) (envA : EnvironmentRound In₁ In₂)
        (stateB : observer.ProductState) (envB : EnvironmentRound In₁ In₂),
        bridge.localObsOne stateA envA = bridge.localObsOne stateB envB ->
          bridge.outputOne stateA envA = bridge.outputOne stateB envB) ∧
      (∀ (stateA : observer.ProductState) (envA : EnvironmentRound In₁ In₂)
        (stateB : observer.ProductState) (envB : EnvironmentRound In₁ In₂),
        bridge.localObsTwo stateA envA = bridge.localObsTwo stateB envB ->
          bridge.outputTwo stateA envA = bridge.outputTwo stateB envB))
    bridge.output_depends_on_localObs
    bridge.reachable_dynamic_hierarchy
    bridge.reachable_dynamic_hierarchy_proof

/--
Forget the local-observation bridge and view the strategy-reachable endpoint as
a raw direct product observer.  This keeps only generated-prefix structure; it
does not add all-history representatives.
-/
def toRawDirectProductObserver
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (cert : StrategyReachableNoDirectFiniteRetractionForHeader header) :
    BerardDirectProductObserverRawConstructionForHeader header where
  ProductState := cert.State
  productFinite := cert.stateFinite
  stateOfGenerated := cert.stateOfGenerated
  initialState := cert.initialState
  initial_state := cert.initial_state
  step := cert.step
  state_snoc := cert.state_snoc
  truthOfState := cert.truthOfState
  epochOfState := cert.epochOfState
  automatonOfState := cert.automatonOfState
  receiptOfState := cert.receiptOfState
  generated_truth := cert.generated_truth
  generated_epoch := cert.generated_epoch
  generated_automaton := cert.generated_automaton
  generated_receipt := cert.generated_receipt
  outputRealizer := True
  outputRealizer_proof := trivial

theorem representative_preserves_truth_of_generated
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (cert : StrategyReachableNoDirectFiniteRetractionForHeader header)
    (envs : List (EnvironmentRound In₁ In₂)) :
    regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (cert.representativeOfReachable (cert.stateOfGenerated envs)
              ⟨envs, rfl⟩))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ envs)) := by
  let rep :=
    cert.representativeOfReachable (cert.stateOfGenerated envs) ⟨envs, rfl⟩
  have hrep_state :
      cert.stateOfGenerated rep = cert.stateOfGenerated envs := by
    simpa [rep] using
      cert.representative_state (cert.stateOfGenerated envs) ⟨envs, rfl⟩
  calc
    regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (cert.representativeOfReachable (cert.stateOfGenerated envs)
              ⟨envs, rfl⟩))) =
        cert.truthOfState (cert.stateOfGenerated rep) := by
          simpa [rep] using (cert.generated_truth rep).symm
    _ = cert.truthOfState (cert.stateOfGenerated envs) := by
          rw [hrep_state]
    _ =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ envs)) := cert.generated_truth envs

