    intro truth hreal
    let h : History In₁ In₂ Graph Out₁ Out₂ := Classical.choose hreal
    have htruth :
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h) = truth := by
      simpa [h] using Classical.choose_spec hreal
    calc
