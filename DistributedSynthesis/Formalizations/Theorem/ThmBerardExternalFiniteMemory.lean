/--
The exact controller-level output supplied by the current Bérard interface.

For each realizable one-directional boundary problem, Bérard plus the
transition-rational regular-tree theorem gives an accepted tree with finite
control, an initial control state, and a successor map on branch choices.

This is not yet a no-direct payload: it is local to the one-directional block
problem and does not mention `header.σ`, no-direct monitor states, generated
representatives, or current receipt/order decoding.
-/
structure BerardOneDirectionalControllerFamily
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    (problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet) where
  controllerOf :
    ∀ boundary,
      problem.realizable boundary ->
        TransitionRationalAcceptedBy (problem.treeAutomaton boundary)

/--
Uniform finite table obtained by taking the product of one-directional Bérard
controllers over all boundary states.

The table has one finite global control state, a branch transition, and a label
projection for each boundary.  Projecting the generated labels at any fixed
boundary gives an accepted tree for that boundary's one-directional automaton.
-/
structure BerardUniformOneDirectionalControllerTable
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    (problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet) where
  Control : Type (max u aut)
  controlFinite : Fintype Control
  initial : Control
  step : Control -> Branch -> Control
  labelAt : Control -> Boundary -> Alphabet
  controlOfNode : TreeNode Branch -> Control
  control_nil : controlOfNode [] = initial
  control_snoc :
    ∀ (node : TreeNode Branch) (branch : Branch),
      controlOfNode (node ++ [branch]) = step (controlOfNode node) branch
  boundary_accepts :
    ∀ boundary : Boundary,
      (problem.treeAutomaton boundary).acceptsTree
        (fun node => labelAt (controlOfNode node) boundary)

attribute [instance] BerardUniformOneDirectionalControllerTable.controlFinite

namespace BerardOneDirectionalControllerFamily

def ofRealizable
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    (problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet) :
    BerardOneDirectionalControllerFamily problem where
  controllerOf := fun boundary hrealizable =>
    berard_transition_rational_controller_of_realizable
      problem boundary hrealizable

def controllerOfFiniteSummary
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    (problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet)
    (boundary : Boundary)
    (hfinite : problem.finiteSummaryRealizable boundary) :
    TransitionRationalAcceptedBy (problem.treeAutomaton boundary) :=
  berard_transition_rational_controller_of_finiteSummary
    problem boundary hfinite

/--
Choose the explicit transition-rational controller supplied by the Bérard
family at a realizable boundary.
-/
noncomputable def controllerTreeOf
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (boundary : Boundary)
    (hrealizable : problem.realizable boundary) :
    TransitionRationalTree.{v, x, aut} Branch Alphabet :=
  Classical.choose (family.controllerOf boundary hrealizable)

/-- The chosen Bérard controller is accepted by the corresponding tree automaton. -/
theorem controllerTreeOf_accepts
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (boundary : Boundary)
    (hrealizable : problem.realizable boundary) :
    (problem.treeAutomaton boundary).acceptsTree
      (family.controllerTreeOf boundary hrealizable).labeledTree :=
  Classical.choose_spec (family.controllerOf boundary hrealizable)

/-- Finite control carrier of the chosen Bérard controller. -/
abbrev ControlOf
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (boundary : Boundary)
    (hrealizable : problem.realizable boundary) :=
  (family.controllerTreeOf boundary hrealizable).Control

noncomputable instance controlOfFinite
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (boundary : Boundary)
    (hrealizable : problem.realizable boundary) :
    Fintype (family.ControlOf boundary hrealizable) :=
  (family.controllerTreeOf boundary hrealizable).controlFinite

/-- Initial control of the chosen Bérard controller. -/
noncomputable def initialControl
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (boundary : Boundary)
    (hrealizable : problem.realizable boundary) :
    family.ControlOf boundary hrealizable :=
  (family.controllerTreeOf boundary hrealizable).initial

/-- Branch transition of the chosen Bérard controller. -/
noncomputable def stepControl
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (boundary : Boundary)
    (hrealizable : problem.realizable boundary) :
    family.ControlOf boundary hrealizable -> Branch ->
      family.ControlOf boundary hrealizable :=
  (family.controllerTreeOf boundary hrealizable).step

/-- Label/output map of the chosen Bérard controller. -/
noncomputable def labelOfControl
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (boundary : Boundary)
    (hrealizable : problem.realizable boundary) :
    family.ControlOf boundary hrealizable -> Alphabet :=
  (family.controllerTreeOf boundary hrealizable).labelOf

/-- Control reached by the chosen Bérard controller after a branch word. -/
noncomputable def controlAt
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (boundary : Boundary)
    (hrealizable : problem.realizable boundary)
    (node : TreeNode Branch) :
    family.ControlOf boundary hrealizable :=
  (family.controllerTreeOf boundary hrealizable).controlAt node

@[simp]
theorem controlAt_nil
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (boundary : Boundary)
    (hrealizable : problem.realizable boundary) :
    family.controlAt boundary hrealizable [] =
      family.initialControl boundary hrealizable := by
  rfl

@[simp]
theorem controlAt_snoc
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (boundary : Boundary)
    (hrealizable : problem.realizable boundary)
    (node : TreeNode Branch) (branch : Branch) :
    family.controlAt boundary hrealizable (node ++ [branch]) =
      family.stepControl boundary hrealizable
        (family.controlAt boundary hrealizable node) branch := by
  simp [controlAt, stepControl]

@[simp]
theorem labelOfControl_controlAt
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (boundary : Boundary)
    (hrealizable : problem.realizable boundary)
    (node : TreeNode Branch) :
    family.labelOfControl boundary hrealizable
        (family.controlAt boundary hrealizable node) =
      (family.controllerTreeOf boundary hrealizable).labeledTree node := by
  rfl

/--
Uniform finite product of the chosen one-directional controllers over all
boundary states.

This is the formal finite-index import used by the no-direct assembly: once
every boundary problem is realizable, the Bérard controllers can be stored as a
single finite table indexed by boundary.
-/
abbrev ProductControl
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (hrealizable : ∀ boundary, problem.realizable boundary) :=
  ∀ boundary : Boundary, family.ControlOf boundary (hrealizable boundary)

noncomputable instance productControlFinite
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (hrealizable : ∀ boundary, problem.realizable boundary) :
    Fintype (family.ProductControl hrealizable) := by
  classical
  letI : Fintype Boundary := problem.boundaryFinite
  infer_instance

/-- Initial state of the uniform product controller table. -/
noncomputable def initialProductControl
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (hrealizable : ∀ boundary, problem.realizable boundary) :
    family.ProductControl hrealizable :=
  fun boundary => family.initialControl boundary (hrealizable boundary)

/-- Synchronous branch transition of the uniform product controller table. -/
noncomputable def stepProductControl
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (hrealizable : ∀ boundary, problem.realizable boundary) :
    family.ProductControl hrealizable -> Branch ->
      family.ProductControl hrealizable :=
  fun state branch boundary =>
    family.stepControl boundary (hrealizable boundary) (state boundary) branch

/-- Label selected from the product table at a boundary. -/
noncomputable def labelOfProductControl
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (hrealizable : ∀ boundary, problem.realizable boundary)
    (state : family.ProductControl hrealizable)
    (boundary : Boundary) :
    Alphabet :=
  family.labelOfControl boundary (hrealizable boundary) (state boundary)

/-- Product control reached after a branch word. -/
noncomputable def productControlAt
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (hrealizable : ∀ boundary, problem.realizable boundary)
    (node : TreeNode Branch) :
    family.ProductControl hrealizable :=
  fun boundary => family.controlAt boundary (hrealizable boundary) node

@[simp]
theorem productControlAt_nil
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (hrealizable : ∀ boundary, problem.realizable boundary) :
    family.productControlAt hrealizable [] =
      family.initialProductControl hrealizable := by
  rfl

@[simp]
theorem productControlAt_snoc
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (hrealizable : ∀ boundary, problem.realizable boundary)
    (node : TreeNode Branch) (branch : Branch) :
    family.productControlAt hrealizable (node ++ [branch]) =
      family.stepProductControl hrealizable
        (family.productControlAt hrealizable node) branch := by
  funext boundary
  simp [productControlAt, stepProductControl]

@[simp]
theorem labelOfProductControl_productControlAt
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (hrealizable : ∀ boundary, problem.realizable boundary)
    (boundary : Boundary)
    (node : TreeNode Branch) :
    family.labelOfProductControl hrealizable
        (family.productControlAt hrealizable node) boundary =
      (family.controllerTreeOf boundary (hrealizable boundary)).labeledTree node := by
  rfl

/--
Projecting the uniform product table at any boundary gives the accepted
transition-rational tree supplied by Bérard for that boundary.
-/
theorem productController_boundary_accepts
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (hrealizable : ∀ boundary, problem.realizable boundary)
    (boundary : Boundary) :
    (problem.treeAutomaton boundary).acceptsTree
      (fun node =>
        family.labelOfProductControl hrealizable
          (family.productControlAt hrealizable node) boundary) := by
  have htree :
      (fun node =>
        family.labelOfProductControl hrealizable
          (family.productControlAt hrealizable node) boundary) =
      (family.controllerTreeOf boundary (hrealizable boundary)).labeledTree := by
    funext node
    rfl
  simpa [htree] using
    family.controllerTreeOf_accepts boundary (hrealizable boundary)

/--
Assemble the chosen boundary-indexed Bérard controllers into a single finite
uniform controller table.
-/
noncomputable def toUniformControllerTable
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet}
    (family : BerardOneDirectionalControllerFamily problem)
    (hrealizable : ∀ boundary, problem.realizable boundary) :
    BerardUniformOneDirectionalControllerTable problem where
  Control := family.ProductControl hrealizable
  controlFinite := family.productControlFinite hrealizable
  initial := family.initialProductControl hrealizable
  step := family.stepProductControl hrealizable
  labelAt := family.labelOfProductControl hrealizable
  controlOfNode := family.productControlAt hrealizable
  control_nil := family.productControlAt_nil hrealizable
  control_snoc := family.productControlAt_snoc hrealizable
  boundary_accepts := family.productController_boundary_accepts hrealizable

/--
Uniform product controller table supplied directly by the one-directional
Bérard construction from realizability of every boundary problem.
-/
noncomputable def uniformControllerTableOfRealizable
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    (problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet)
    (hrealizable : ∀ boundary, problem.realizable boundary) :
    BerardUniformOneDirectionalControllerTable problem :=
  (BerardOneDirectionalControllerFamily.ofRealizable problem)
    |>.toUniformControllerTable hrealizable

end BerardOneDirectionalControllerFamily

namespace BerardUniformOneDirectionalControllerTable

/--
Uniform product controller table supplied directly by one-directional Bérard
from finite-summary realizability of every boundary problem.

This is the version used when the block construction has already proved the
finite-summary side condition, rather than ordinary realizability.
-/
noncomputable def ofFiniteSummaryRealizable
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    (problem : OneDirectionalFiniteMemoryProblem.{u, v, x, aut}
      Boundary Branch Alphabet)
    (hfinite : ∀ boundary, problem.finiteSummaryRealizable boundary) :
    BerardUniformOneDirectionalControllerTable problem :=
  BerardOneDirectionalControllerFamily.uniformControllerTableOfRealizable
    problem
    (fun boundary => (berard_finite_memory problem boundary).2
      (hfinite boundary))

end BerardUniformOneDirectionalControllerTable

/--
A finite controller whose output behavior realizes the selected strategy
`header.σ` on all generated prefixes.

This is the missing link between the local transition-rational Bérard
controllers and the fixed strategy stored in the no-direct header.  Bérard's
one-directional theorem does not provide this field by itself; the no-direct
assembly proof must construct it from the side/boundary controllers and prove
`output_correct`.
-/
structure FiniteControllerGeneratesHeaderStrategy
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  Control : Type (max u v x y aut)
  controlFinite : Fintype Control
  initial : Control
  step : Control -> EnvironmentRound In₁ In₂ -> Control
  output : Control -> EnvironmentRound In₁ In₂ -> Out₁ × Out₂
  controlOfGenerated : List (EnvironmentRound In₁ In₂) -> Control
  control_nil : controlOfGenerated [] = initial
  control_snoc :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      controlOfGenerated (envs ++ [env]) =
        step (controlOfGenerated envs) env
  output_correct :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      output (controlOfGenerated envs) env =
        ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
          (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo)

attribute [instance] FiniteControllerGeneratesHeaderStrategy.controlFinite

namespace FiniteControllerGeneratesHeaderStrategy

/--
Round-aware controller obtained by evaluating the header strategy on decoded
local views.
-/
noncomputable def roundAwareControllerOfHeaderStrategyViews
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (viewOne :
      FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two) :
    FiniteEpochTransformer.RoundAwareControllerCode
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer :=
  fun state env =>
    (header.σ.one (viewOne state env), header.σ.two (viewTwo state env))

/--
The controller obtained from decoded header-strategy views is locally
observable with respect to those views.
-/
noncomputable def roundAwareLocalControllerOfHeaderStrategyViews
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (viewOne :
      FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two) :
    FiniteEpochTransformer.RoundAwareLocalControllerCode
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer
      viewOne viewTwo :=
  ⟨roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo,
    by
      constructor
      · intro stateA envA stateB envB hview
        simp [roundAwareControllerOfHeaderStrategyViews, hview]
      · intro stateA envA stateB envB hview
        simp [roundAwareControllerOfHeaderStrategyViews, hview]⟩

/--
Finite control state reached by replaying a generated environment-prefix through
a round-aware controller for the no-direct epoch transformer.
-/
noncomputable def roundAwareControlOfGenerated
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (controller :
      FiniteEpochTransformer.RoundAwareControllerCode
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer)
    (envs : List (EnvironmentRound In₁ In₂)) :
    FiniteEpochTransformer.GameState
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer :=
  envs.foldl
    (fun state env =>
      FiniteEpochTransformer.roundAwareGameTransition
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer
        controller state env)
    (Sum.inl header.initialBoundary)

@[simp]
theorem roundAwareControlOfGenerated_nil
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (controller :
      FiniteEpochTransformer.RoundAwareControllerCode
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer) :
    roundAwareControlOfGenerated header controller [] = Sum.inl header.initialBoundary :=
  rfl

@[simp]
theorem roundAwareControlOfGenerated_snoc
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (controller :
      FiniteEpochTransformer.RoundAwareControllerCode
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer)
    (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂) :
    roundAwareControlOfGenerated header controller (envs ++ [env]) =
      FiniteEpochTransformer.roundAwareGameTransition
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer
        controller (roundAwareControlOfGenerated header controller envs) env := by
  simp [roundAwareControlOfGenerated, List.foldl_append]

/--
Pointwise generated-prefix matching between a round-aware no-direct controller
and the strategy stored in the header.

This is the finite-controller realizability obligation that the external
Bérard assembly must prove after stitching together the one-directional block
controllers.
-/
def RoundAwareControllerMatchesHeaderStrategyOnGeneratedPrefixes
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (controller :
      FiniteEpochTransformer.RoundAwareControllerCode
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer) :
    Prop :=
  ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
    controller (roundAwareControlOfGenerated header controller envs) env =
      ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
        (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo)

/--
Generated-prefix view decoding proves the concrete controller induced from
those views matches `header.σ`.
-/
theorem roundAwareControllerOfHeaderStrategyViews_matches
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (viewOne :
      FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (hviews :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        viewOne
            (roundAwareControlOfGenerated header
              (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
              envs)
            env =
          nextView Proc.one (executionPrefixFromList header.σ envs) env ∧
        viewTwo
            (roundAwareControlOfGenerated header
              (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
              envs)
            env =
          nextView Proc.two (executionPrefixFromList header.σ envs) env) :
    RoundAwareControllerMatchesHeaderStrategyOnGeneratedPrefixes
      header (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo) := by
  intro envs env
  rcases hviews envs env with ⟨hviewOne, hviewTwo⟩
  simp [roundAwareControllerOfHeaderStrategyViews, nextRound, hviewOne, hviewTwo]

/--
If a round-aware controller matches the header strategy on generated prefixes,
then replaying an environment list through the controller reaches exactly the
concrete no-direct state after the generated execution prefix.
-/
theorem roundAwareControlOfGenerated_eq_noDirectEpochStateAfterHistory_of_matches
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (controller :
      FiniteEpochTransformer.RoundAwareControllerCode
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer)
    (hmatch :
      RoundAwareControllerMatchesHeaderStrategyOnGeneratedPrefixes
        header controller) :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      roundAwareControlOfGenerated header controller envs =
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (executionPrefixFromList header.σ envs) := by
  intro envs
  induction envs using List.reverseRecOn with
  | nil =>
      rfl
  | append_singleton envs env ih =>
      rw [
        roundAwareControlOfGenerated_snoc,
        executionPrefixFromList_snoc,
        UniformOneDirectionalFiniteIndexLemma.noDirectEpochStateAfterHistory_append_round
      ]
      rw [ih]
      rw [
        ← FiniteEpochTransformer.noDirectEpochStateTransition_eq_roundAwareGameTransition
          header.toCurrentOrderHeader.toHeader.importedUniform controller
          (header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary (executionPrefixFromList header.σ envs))
          env
      ]
      have hcontroller :
          controller
              (header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
                header.initialBoundary (executionPrefixFromList header.σ envs))
              env =
            ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
              (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo) := by
        simpa [ih] using hmatch envs env
      have houtOne :=
        congrArg Prod.fst hcontroller
      have houtTwo :=
        congrArg Prod.snd hcontroller
      cases env with
      | mk inputOne inputTwo graph =>
          simp [nextRound, houtOne, houtTwo]

/--
Generated-prefix view decoding, stated on the controller replay state, also
decodes the concrete no-direct prefix state for the generated header execution.
-/
theorem generatedPrefixViews_noDirectEpochStateAfterHistory
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (viewOne :
      FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (hviews :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        viewOne
            (roundAwareControlOfGenerated header
              (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
              envs)
            env =
          nextView Proc.one (executionPrefixFromList header.σ envs) env ∧
        viewTwo
            (roundAwareControlOfGenerated header
              (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
              envs)
            env =
          nextView Proc.two (executionPrefixFromList header.σ envs) env) :
    ∀ (envs : List (EnvironmentRound In₁ In₂))
      (env : EnvironmentRound In₁ In₂),
      viewOne
          (header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary (executionPrefixFromList header.σ envs))
          env =
        nextView Proc.one (executionPrefixFromList header.σ envs) env ∧
      viewTwo
          (header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary (executionPrefixFromList header.σ envs))
          env =
        nextView Proc.two (executionPrefixFromList header.σ envs) env := by
  intro envs env
  have hmatch :
      RoundAwareControllerMatchesHeaderStrategyOnGeneratedPrefixes
        header (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo) :=
    roundAwareControllerOfHeaderStrategyViews_matches header viewOne viewTwo hviews
  have hstate :=
    roundAwareControlOfGenerated_eq_noDirectEpochStateAfterHistory_of_matches
      header
      (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
      hmatch envs
  simpa [hstate] using hviews envs env

/-- Finite list of the first `n` environment rounds of a sequence. -/
def environmentPrefixList
    {In₁ : Type u} {In₂ : Type v}
    (env : EnvironmentSequence In₁ In₂) : Nat -> List (EnvironmentRound In₁ In₂)
  | 0 => []
  | n + 1 => environmentPrefixList env n ++ [env n]

@[simp]
theorem environmentPrefixList_zero
    {In₁ : Type u} {In₂ : Type v}
    (env : EnvironmentSequence In₁ In₂) :
    environmentPrefixList env 0 = [] := rfl

@[simp]
theorem environmentPrefixList_succ
    {In₁ : Type u} {In₂ : Type v}
    (env : EnvironmentSequence In₁ In₂) (n : Nat) :
    environmentPrefixList env (n + 1) =
      environmentPrefixList env n ++ [env n] := rfl

@[simp]
theorem executionPrefixFromList_environmentPrefixList
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    (σ : StrategyPair In₁ In₂ Out₁ Out₂)
    (env : EnvironmentSequence In₁ In₂) :
    ∀ n : Nat,
      executionPrefixFromList σ (environmentPrefixList env n) =
        executionPrefix σ env n := by
  intro n
  induction n with
  | zero =>
      rfl
  | succ n ih =>
      simp [ih]

/--
For the local controller extracted from generated header views, the decoded
ordinary strategy follows the header strategy on every generated prefix.
-/
theorem executionPrefix_strategyOf_roundAwareLocalControllerOfHeaderStrategyViews
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (viewOne :
      FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (hviews :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        viewOne
            (roundAwareControlOfGenerated header
              (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
              envs)
            env =
          nextView Proc.one (executionPrefixFromList header.σ envs) env ∧
        viewTwo
            (roundAwareControlOfGenerated header
              (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
              envs)
            env =
          nextView Proc.two (executionPrefixFromList header.σ envs) env)
    (defaultOne : Out₁)
    (defaultTwo : Out₂) :
    ∀ (env : EnvironmentSequence In₁ In₂) (n : Nat),
      executionPrefix
          (FiniteEpochTransformer.strategyOfRoundAwareLocalController
            header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer
            viewOne viewTwo
            (roundAwareLocalControllerOfHeaderStrategyViews header viewOne viewTwo)
            defaultOne defaultTwo)
          env n =
        executionPrefixFromList header.σ (environmentPrefixList env n) := by
  intro env n
  induction n with
  | zero =>
      rfl
  | succ n ih =>
      let T :=
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer
      let controller :=
        roundAwareLocalControllerOfHeaderStrategyViews header viewOne viewTwo
      let σ :=
        FiniteEpochTransformer.strategyOfRoundAwareLocalController
          T viewOne viewTwo controller defaultOne defaultTwo
      let envs := environmentPrefixList env n
      let state :=
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (executionPrefixFromList header.σ envs)
      have hprefix : executionPrefix σ env n = executionPrefixFromList header.σ envs := by
        simpa [σ, envs] using ih
      have hgenerated :=
        generatedPrefixViews_noDirectEpochStateAfterHistory
          header viewOne viewTwo hviews envs (env n)
      have hviewOne :
          viewOne state (env n) =
            nextView Proc.one (executionPrefix σ env n) (env n) := by
        simpa [state, hprefix] using hgenerated.1
      have hviewTwo :
          viewTwo state (env n) =
            nextView Proc.two (executionPrefix σ env n) (env n) := by
        simpa [state, hprefix] using hgenerated.2
      have hmatch :
          RoundAwareControllerMatchesHeaderStrategyOnGeneratedPrefixes
            header (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo) :=
        roundAwareControllerOfHeaderStrategyViews_matches header viewOne viewTwo hviews
      have hstate :
          roundAwareControlOfGenerated header
              (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
              envs =
            state := by
        simpa [state] using
          roundAwareControlOfGenerated_eq_noDirectEpochStateAfterHistory_of_matches
            header
            (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
            hmatch envs
      have hcontroller :
          (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
              state (env n) =
            ((nextRound header.σ (executionPrefixFromList header.σ envs) (env n)).outputOne,
              (nextRound header.σ (executionPrefixFromList header.σ envs) (env n)).outputTwo) := by
        simpa [hstate] using hmatch envs (env n)
      have houtOne :
          σ.one (nextView Proc.one (executionPrefix σ env n) (env n)) =
            (nextRound header.σ (executionPrefixFromList header.σ envs) (env n)).outputOne := by
        calc
          σ.one (nextView Proc.one (executionPrefix σ env n) (env n)) =
              σ.one (viewOne state (env n)) := by rw [← hviewOne]
          _ = (controller.1 state (env n)).1 := by
              simpa [σ, controller, T] using
                FiniteEpochTransformer.strategyOneOfRoundAwareLocalController_apply_decoded
                  T viewOne viewTwo controller defaultOne state (env n)
          _ = (nextRound header.σ (executionPrefixFromList header.σ envs) (env n)).outputOne := by
              simpa [controller] using congrArg Prod.fst hcontroller
      have houtTwo :
          σ.two (nextView Proc.two (executionPrefix σ env n) (env n)) =
            (nextRound header.σ (executionPrefixFromList header.σ envs) (env n)).outputTwo := by
        calc
          σ.two (nextView Proc.two (executionPrefix σ env n) (env n)) =
              σ.two (viewTwo state (env n)) := by rw [← hviewTwo]
          _ = (controller.1 state (env n)).2 := by
              simpa [σ, controller, T] using
                FiniteEpochTransformer.strategyTwoOfRoundAwareLocalController_apply_decoded
                  T viewOne viewTwo controller defaultTwo state (env n)
          _ = (nextRound header.σ (executionPrefixFromList header.σ envs) (env n)).outputTwo := by
              simpa [controller] using congrArg Prod.snd hcontroller
      have houtOneList :
          σ.one (nextView Proc.one (executionPrefixFromList header.σ envs) (env n)) =
            header.σ.one
              (nextView Proc.one (executionPrefixFromList header.σ envs) (env n)) := by
        simpa [nextRound, hprefix] using houtOne
      have houtTwoList :
          σ.two (nextView Proc.two (executionPrefixFromList header.σ envs) (env n)) =
            header.σ.two
              (nextView Proc.two (executionPrefixFromList header.σ envs) (env n)) := by
        simpa [nextRound, hprefix] using houtTwo
      rw [executionPrefix_succ, environmentPrefixList_succ, executionPrefixFromList_snoc]
      rw [hprefix]
      change
        History.append (executionPrefixFromList header.σ envs)
            (nextRound σ (executionPrefixFromList header.σ envs) (env n)) =
          History.append (executionPrefixFromList header.σ envs)
            (nextRound header.σ (executionPrefixFromList header.σ envs) (env n))
      cases henv : env n with
      | mk inputOne inputTwo graph =>
          have houtOneRecord :
              σ.one
                  (nextView Proc.one (executionPrefixFromList header.σ envs)
                    { inputOne := inputOne, inputTwo := inputTwo, graph := graph }) =
                header.σ.one
                  (nextView Proc.one (executionPrefixFromList header.σ envs)
                    { inputOne := inputOne, inputTwo := inputTwo, graph := graph }) := by
            simpa [henv] using houtOneList
          have houtTwoRecord :
              σ.two
                  (nextView Proc.two (executionPrefixFromList header.σ envs)
                    { inputOne := inputOne, inputTwo := inputTwo, graph := graph }) =
                header.σ.two
                  (nextView Proc.two (executionPrefixFromList header.σ envs)
                    { inputOne := inputOne, inputTwo := inputTwo, graph := graph }) := by
            simpa [henv] using houtTwoList
          simp [nextRound, houtOneRecord, houtTwoRecord]

/--
For the local controller extracted from generated header views, the decoded
ordinary strategy generates exactly the header execution word.
-/
theorem execution_strategyOf_roundAwareLocalControllerOfHeaderStrategyViews
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (viewOne :
      FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (hviews :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        viewOne
            (roundAwareControlOfGenerated header
              (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
              envs)
            env =
          nextView Proc.one (executionPrefixFromList header.σ envs) env ∧
        viewTwo
            (roundAwareControlOfGenerated header
              (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
              envs)
            env =
          nextView Proc.two (executionPrefixFromList header.σ envs) env)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (env : EnvironmentSequence In₁ In₂) :
    execution
        (FiniteEpochTransformer.strategyOfRoundAwareLocalController
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer
          viewOne viewTwo
          (roundAwareLocalControllerOfHeaderStrategyViews header viewOne viewTwo)
          defaultOne defaultTwo)
        env =
      execution header.σ env := by
  funext n
  let T :=
    header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer
  let controller :=
    roundAwareLocalControllerOfHeaderStrategyViews header viewOne viewTwo
  let σ :=
    FiniteEpochTransformer.strategyOfRoundAwareLocalController
      T viewOne viewTwo controller defaultOne defaultTwo
  let envs := environmentPrefixList env n
  let state :=
    header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
      header.initialBoundary (executionPrefixFromList header.σ envs)
  have hprefix :
      executionPrefix σ env n = executionPrefixFromList header.σ envs := by
    simpa [σ, envs] using
      executionPrefix_strategyOf_roundAwareLocalControllerOfHeaderStrategyViews
        header viewOne viewTwo hviews defaultOne defaultTwo env n
  have hheaderPrefix :
      executionPrefix header.σ env n =
        executionPrefixFromList header.σ envs := by
    simpa [envs] using
      (executionPrefixFromList_environmentPrefixList header.σ env n).symm
  have hgenerated :=
    generatedPrefixViews_noDirectEpochStateAfterHistory
      header viewOne viewTwo hviews envs (env n)
  have hviewOne :
      viewOne state (env n) =
        nextView Proc.one (executionPrefix σ env n) (env n) := by
    simpa [state, hprefix] using hgenerated.1
  have hviewTwo :
      viewTwo state (env n) =
        nextView Proc.two (executionPrefix σ env n) (env n) := by
    simpa [state, hprefix] using hgenerated.2
  have hmatch :
      RoundAwareControllerMatchesHeaderStrategyOnGeneratedPrefixes
        header (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo) :=
    roundAwareControllerOfHeaderStrategyViews_matches header viewOne viewTwo hviews
  have hstate :
      roundAwareControlOfGenerated header
          (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
          envs =
        state := by
    simpa [state] using
      roundAwareControlOfGenerated_eq_noDirectEpochStateAfterHistory_of_matches
        header
        (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
        hmatch envs
  have hcontroller :
      (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
          state (env n) =
        ((nextRound header.σ (executionPrefixFromList header.σ envs) (env n)).outputOne,
          (nextRound header.σ (executionPrefixFromList header.σ envs) (env n)).outputTwo) := by
    simpa [hstate] using hmatch envs (env n)
  have houtOne :
      σ.one (nextView Proc.one (executionPrefix σ env n) (env n)) =
        header.σ.one
          (nextView Proc.one (executionPrefixFromList header.σ envs) (env n)) := by
    calc
      σ.one (nextView Proc.one (executionPrefix σ env n) (env n)) =
          σ.one (viewOne state (env n)) := by rw [← hviewOne]
      _ = (controller.1 state (env n)).1 := by
          simpa [σ, controller, T] using
            FiniteEpochTransformer.strategyOneOfRoundAwareLocalController_apply_decoded
              T viewOne viewTwo controller defaultOne state (env n)
      _ = header.σ.one
            (nextView Proc.one (executionPrefixFromList header.σ envs) (env n)) := by
          simpa [controller, nextRound] using congrArg Prod.fst hcontroller
  have houtTwo :
      σ.two (nextView Proc.two (executionPrefix σ env n) (env n)) =
        header.σ.two
          (nextView Proc.two (executionPrefixFromList header.σ envs) (env n)) := by
    calc
      σ.two (nextView Proc.two (executionPrefix σ env n) (env n)) =
          σ.two (viewTwo state (env n)) := by rw [← hviewTwo]
      _ = (controller.1 state (env n)).2 := by
          simpa [σ, controller, T] using
            FiniteEpochTransformer.strategyTwoOfRoundAwareLocalController_apply_decoded
              T viewOne viewTwo controller defaultTwo state (env n)
      _ = header.σ.two
            (nextView Proc.two (executionPrefixFromList header.σ envs) (env n)) := by
          simpa [controller, nextRound] using congrArg Prod.snd hcontroller
  rw [execution_apply, execution_apply]
  cases henv : env n with
  | mk inputOne inputTwo graph =>
      have houtOneRecord :
          σ.one
              (nextView Proc.one (executionPrefix σ env n)
                { inputOne := inputOne, inputTwo := inputTwo, graph := graph }) =
            header.σ.one
              (nextView Proc.one (executionPrefixFromList header.σ envs)
                { inputOne := inputOne, inputTwo := inputTwo, graph := graph }) := by
        simpa [henv] using houtOne
      have houtTwoRecord :
          σ.two
              (nextView Proc.two (executionPrefix σ env n)
                { inputOne := inputOne, inputTwo := inputTwo, graph := graph }) =
            header.σ.two
              (nextView Proc.two (executionPrefixFromList header.σ envs)
                { inputOne := inputOne, inputTwo := inputTwo, graph := graph }) := by
        simpa [henv] using houtTwo
      simp [nextRound, henv, hheaderPrefix]
      constructor
      · simpa [σ] using houtOneRecord
      · simpa [σ] using houtTwoRecord

/--
For the generated-view local controller, list-form generated view decoding
supplies the actual prefix-view decoder for the decoded ordinary strategy.
