      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ
              (core.envsOfHistory (Classical.choose hreal)))) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (Classical.choose hreal)) :=
            core.envs_actualTruth (Classical.choose hreal)
      _ = truth := hselected
  envs_nonempty := by
    intro _ hreal
    exact core.envs_nonempty (Classical.choose hreal)
  rawEpochState_invariant := core.rawEpochState_invariant
  receiptOrder_invariant := core.receiptOrder_invariant
  coherentHistoryNonempty := core.coherentHistoryNonempty

end BerardRawRealizedTruthRepresentativeInvariantCoreForHeader

/--
Empty-safe raw realized-truth closure invariant core.

This is the sharper Bérard-side handoff for the invariant-data route.  It asks
for representatives only for realized stabilized truth atoms, with no
nonemptiness condition, and for the two truth-determinacy invariants that are
not definitional from the actual-truth header.  Lean computes the finite
generation bound and supplies the automaton-state invariant definitionally.
-/
structure BerardRawRealizedTruthClosureInvariantCoreForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfRealizedTruth :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth ->
        List (EnvironmentRound In₁ In₂)
  envs_realizes :
    ∀ (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
      (hreal :
        StabilizedSaturationBasisNoDirectRealizedTruthAtom
          header.cert (pathOfHistoryByRound header.edgeOfRound) truth),
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (envsOfRealizedTruth truth hreal))) =
        truth
  rawEpochState_invariant :
    header.cert.determinesPathData ->
    header.cert.predecessorClosed ->
    (∀ boundaryState, header.cert.boundaryClosed boundaryState) ->
    header.cert.continuationClosed ->
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h') ->
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h'
  receiptOrder_invariant :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h')

namespace BerardRawRealizedTruthClosureInvariantCoreForHeader

/--
Compatibility projection from the older representative invariant core.  The old
core may still carry nonempty/coherent evidence, but the empty-safe core below
forgets it completely.
-/
noncomputable def ofRawRepresentativeInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      BerardRawRealizedTruthRepresentativeInvariantCoreForHeader header) :
    BerardRawRealizedTruthClosureInvariantCoreForHeader header where
  envsOfRealizedTruth := core.envsOfRealizedTruth
  envs_realizes := core.envs_realizes
  rawEpochState_invariant := core.rawEpochState_invariant
  receiptOrder_invariant := core.receiptOrder_invariant

/-- Assemble the empty-safe core from empty-safe coverage and determinacy. -/
noncomputable def ofCoverageAndDeterminacy
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (coverage : BerardRealizedTruthCoverageForHeader header)
    (det : BerardActualTruthClosureDeterminacyForHeader header) :
    BerardRawRealizedTruthClosureInvariantCoreForHeader header where
  envsOfRealizedTruth := coverage.envsOfRealizedTruth
  envs_realizes := coverage.envs_realizes
  rawEpochState_invariant := det.rawEpochState_invariant
  receiptOrder_invariant := det.receiptOrder_invariant

/--
Compatibility constructor from the older strong seed-surjectivity and
determinacy records.

The inputs still carry nonempty/coherent fields; they are immediately forgotten.
For the sharp route, use `ofCoverageAndDeterminacy`.
-/
noncomputable def ofSeedSurjectivityAndDeterminacy
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (seed : BerardRealizedTruthSeedSurjectivityForHeader header)
    (det : BerardActualTruthDeterminacyForHeader header) :
    BerardRawRealizedTruthClosureInvariantCoreForHeader header :=
  ofCoverageAndDeterminacy
    (BerardRealizedTruthCoverageForHeader.ofSeedSurjectivity seed)
    (BerardActualTruthClosureDeterminacyForHeader.ofActualTruthDeterminacy det)

/-- Empty-safe projection from the truth-factor blockwise core. -/
noncomputable def ofTruthFactorBlockwiseCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalTruthFactorBlockwiseCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    BerardRawRealizedTruthClosureInvariantCoreForHeader header :=
  ofRawRepresentativeInvariantCore
    (BerardRawRealizedTruthRepresentativeInvariantCoreForHeader.ofTruthFactorBlockwiseCore
      core)

/-- Empty-safe projection from the finite truth quotient invariant core. -/
noncomputable def ofFiniteTruthQuotientInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
