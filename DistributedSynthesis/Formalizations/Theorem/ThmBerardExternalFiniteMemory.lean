/--
Raw direct observer plus raw realized-truth representatives gives the full raw
completion consumed by the corrected no-direct route.
-/
noncomputable def completionOfRawRealizedTruthRepresentativeInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer :
      BerardDirectProductObserverRawConstructionForHeader header)
    (core :
      BerardRawRealizedTruthRepresentativeInvariantCoreForHeader header) :
    BerardDirectProductObserverRawRealizedTruthCompletionForHeader header where
  observer := observer
  envsOfRealizedTruth := fun truth hreal =>
    core.envsOfRealizedTruth truth hreal
  stateOfRealizedTruth := fun truth hreal =>
    observer.stateOfGenerated (core.envsOfRealizedTruth truth hreal)
  envs_state := by
    intro truth hreal
    rfl
  state_truth := by
    intro truth hreal
    calc
      observer.truthOfState
          (observer.stateOfGenerated
            (core.envsOfRealizedTruth truth hreal)) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (executionPrefixFromList header.σ
                (core.envsOfRealizedTruth truth hreal))) :=
            observer.generated_truth (core.envsOfRealizedTruth truth hreal)
      _ = truth := core.envs_realizes truth hreal
  envs_nonempty := by
    intro truth hreal
    exact core.envs_nonempty truth hreal
  rawEpochState_invariant := core.rawEpochState_invariant
  receiptOrder_invariant := core.receiptOrder_invariant
  coherentHistoryNonempty := core.coherentHistoryNonempty

