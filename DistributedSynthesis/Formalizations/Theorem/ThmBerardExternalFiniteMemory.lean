/--
Primitive semantic product-observer output expected from the external Bérard
construction.

This record is deliberately below
`BerardNoDirectViewDecoderPathRightCongruenceCorePackageForHeader`: it does not
assume the final path-congruence package.  Instead it exposes the actual
product-observer proof obligations one has to get from the one-directional
Bérard construction:

* a finite semantic product state for histories;
* equality of the stabilized path quotient and equality of the product state
  coincide on the theorem-facing observations;
* the product state is stable under appending the same generated round;
* equal product states determine the current local views and receipt/order
  payload;
* generated-prefix view decoding, the cardinal generation bound, and the
  output realizer.

The checked theorems below turn this primitive observer into the path-level
right-congruence package and then into the reachable finite-controller
certificate.  Thus the remaining external theorem is now exactly the
construction of this semantic product observer from Bérard's one-directional
finite-memory theorem, not the downstream Lean assembly.
-/
structure BerardSemanticProductObserverConstructionForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  ProductState : Type (max u v x y aut)
  productFinite : Fintype ProductState
  productOfHistory :
    History In₁ In₂ Graph Out₁ Out₂ -> ProductState
  product_eq_of_pathEquivalent :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      StabilizedSaturationBasisPathEquivalent header.cert
        (pathOfHistoryByRound header.edgeOfRound h)
        (pathOfHistoryByRound header.edgeOfRound h') ->
      productOfHistory h = productOfHistory h'
  pathEquivalent_of_product_eq :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      productOfHistory h = productOfHistory h' ->
      StabilizedSaturationBasisPathEquivalent header.cert
        (pathOfHistoryByRound header.edgeOfRound h)
        (pathOfHistoryByRound header.edgeOfRound h')
  product_append_congruent :
    ∀ (h h' : History In₁ In₂ Graph Out₁ Out₂)
      (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
      productOfHistory h = productOfHistory h' ->
      productOfHistory (History.append h r) =
        productOfHistory (History.append h' r)
  currentViews_of_product_eq :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      productOfHistory h = productOfHistory h' ->
      (currentView Proc.one h, currentView Proc.two h) =
        (currentView Proc.one h', currentView Proc.two h')
  receipt_eq_of_product_eq :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      productOfHistory h = productOfHistory h' ->
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h')
  viewOne :
    FiniteEpochTransformer.GameState
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one
  viewTwo :
    FiniteEpochTransformer.GameState
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two
  generated_views :
    ∀ (envs : List (EnvironmentRound In₁ In₂))
      (env : EnvironmentRound In₁ In₂),
      viewOne
          (FiniteControllerGeneratesHeaderStrategy.roundAwareControlOfGenerated
            header
            (FiniteControllerGeneratesHeaderStrategy.roundAwareControllerOfHeaderStrategyViews
              header viewOne viewTwo)
            envs)
          env =
        nextView Proc.one (executionPrefixFromList header.σ envs) env ∧
      viewTwo
          (FiniteControllerGeneratesHeaderStrategy.roundAwareControlOfGenerated
            header
            (FiniteControllerGeneratesHeaderStrategy.roundAwareControllerOfHeaderStrategyViews
              header viewOne viewTwo)
            envs)
          env =
        nextView Proc.two (executionPrefixFromList header.σ envs) env
  generationBound_card :
    Fintype.card (BerardNoDirectGeneratedObservationState header) ≤
      header.generationBound
  outputRealizer : Prop
  outputRealizer_proof : outputRealizer

