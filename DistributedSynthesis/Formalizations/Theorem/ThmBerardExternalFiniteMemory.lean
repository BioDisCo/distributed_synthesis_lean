namespace BerardDirectProductObserverConstructionForHeader

/--
Forget the explicit reachable-representative bound from a bounded direct
observer.  This is useful when an older Bérard package has already supplied a
bounded observer, but the corrected route wants Lean to choose the final header
bound internally.
-/
noncomputable def toRawConstruction
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverConstructionForHeader header) :
    BerardDirectProductObserverRawConstructionForHeader header where
  ProductState := observer.ProductState
  productFinite := observer.productFinite
  stateOfGenerated := observer.stateOfGenerated
  initialState := observer.initialState
  initial_state := observer.initial_state
  step := observer.step
  state_snoc := observer.state_snoc
  truthOfState := observer.truthOfState
  epochOfState := observer.epochOfState
  automatonOfState := observer.automatonOfState
  receiptOfState := observer.receiptOfState
  generated_truth := observer.generated_truth
  generated_epoch := observer.generated_epoch
  generated_automaton := observer.generated_automaton
  generated_receipt := observer.generated_receipt
  outputRealizer := observer.outputRealizer
  outputRealizer_proof := observer.outputRealizer_proof

end BerardDirectProductObserverConstructionForHeader

/--
Raw finite-controller assembly for the no-direct Bérard construction.

This is the same monitor/controller assembly as the older bounded interface,
but without a bounded-reachable-representative field.  The corrected route
first builds this finite transition system and lets Lean compute a sufficient
generation bound afterwards.
-/
structure BerardNoDirectRawControllerAssemblyForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  controller : FiniteControllerGeneratesHeaderStrategy header
  observationStep :
    BerardNoDirectGeneratedObservationState header ->
      EnvironmentRound In₁ In₂ ->
      BerardNoDirectGeneratedObservationState header
  observation_snoc :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      berardNoDirectGeneratedObservation header (envs ++ [env]) =
        observationStep (berardNoDirectGeneratedObservation header envs) env
  outputRealizer : Prop
  outputRealizer_proof : outputRealizer

namespace BerardNoDirectRawControllerAssemblyForHeader

/--
Build the raw controller assembly from a finite controller and
right-congruence of the generated observation.

The monitor transition is the canonical representative-choice transition
already checked for right-congruent generated observations; it does not need to
be supplied as a separate external field.
-/
noncomputable def ofControllerAndRightCongruence
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (controller : FiniteControllerGeneratesHeaderStrategy header)
    (hright : BerardGeneratedObservationRightCongruent header)
    (outputRealizer : Prop)
    (outputRealizer_proof : outputRealizer) :
    BerardNoDirectRawControllerAssemblyForHeader header where
  controller := controller
  observationStep := berardGeneratedObservationStepFromRepresentative header
  observation_snoc :=
    berardGeneratedObservationStepFromRepresentative_snoc header hright
  outputRealizer := outputRealizer
  outputRealizer_proof := outputRealizer_proof

/--
Checked raw assembly theorem: controller matching and the finite observation
transition give the direct product observer before any generation bound is
chosen.
-/
noncomputable def toRawDirectProductObserverConstruction
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly : BerardNoDirectRawControllerAssemblyForHeader header) :
    BerardDirectProductObserverRawConstructionForHeader header where
  ProductState :=
    assembly.controller.Control × BerardNoDirectGeneratedObservationState header
  productFinite := by
    classical
    letI : Fintype assembly.controller.Control :=
      assembly.controller.controlFinite
    letI :
        Fintype
          (RegularTestTruthAtom (stabilizedSaturationBasis header.cert)) :=
      regularTestTruthAtomFintype (stabilizedSaturationBasis header.cert)
    letI :
        Fintype
          (EpochRotatingAccessState
            header.toCurrentOrderHeader.toHeader.importedUniform.boundary
            (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
            (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two)) :=
      Classical.choice
        (noDirectEpochTransformer_rotating_state_finite
          header.toCurrentOrderHeader.toHeader.importedUniform)
    letI : Fintype header.AState := header.aStateFinite
    infer_instance
  stateOfGenerated := fun envs =>
    ( assembly.controller.controlOfGenerated envs
    , berardNoDirectGeneratedObservation header envs )
  initialState :=
    (assembly.controller.initial, berardNoDirectGeneratedObservation header [])
  initial_state := by
    exact Prod.ext assembly.controller.control_nil rfl
  step := fun s env =>
    ( assembly.controller.step s.1 env
    , assembly.observationStep s.2 env )
  state_snoc := by
    intro envs env
    exact Prod.ext (assembly.controller.control_snoc envs env)
      (assembly.observation_snoc envs env)
  truthOfState := fun s => s.2.1
  epochOfState := fun s => s.2.2.1
  automatonOfState := fun s => s.2.2.2.1
  receiptOfState := fun s => s.2.2.2.2
  generated_truth := by
    intro envs
    rfl
  generated_epoch := by
    intro envs
    rfl
  generated_automaton := by
    intro envs
    rfl
  generated_receipt := by
    intro envs
    rfl
  outputRealizer := assembly.outputRealizer
  outputRealizer_proof := assembly.outputRealizer_proof

end BerardNoDirectRawControllerAssemblyForHeader

/--
Assembly interface that keeps the Bérard controller table as part of the
generated product state.

The earlier raw assembly can build an observer from the theorem-facing monitor
alone.  This interface is closer to the actual Bérard product construction:
the product state contains both the finite controller-table memory and the
monitor tuple.  The external construction must connect generated prefixes to
controller controls and branch choices; Lean then builds the raw direct product
observer and proves its monitor projections.
-/
structure BerardUniformControllerMonitorAssemblyForHeader
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  table : BerardUniformOneDirectionalControllerTable problem
  branchOfObservation :
    BerardNoDirectGeneratedObservationState header ->
      EnvironmentRound In₁ In₂ -> Branch
  controlOfGenerated :
    List (EnvironmentRound In₁ In₂) -> table.Control
  control_nil :
    controlOfGenerated [] = table.initial
  control_snoc :
    ∀ (envs : List (EnvironmentRound In₁ In₂))
      (env : EnvironmentRound In₁ In₂),
      controlOfGenerated (envs ++ [env]) =
        table.step (controlOfGenerated envs)
          (branchOfObservation (berardNoDirectGeneratedObservation header envs) env)
  observationStep :
    BerardNoDirectGeneratedObservationState header ->
      EnvironmentRound In₁ In₂ ->
      BerardNoDirectGeneratedObservationState header
  observation_snoc :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      berardNoDirectGeneratedObservation header (envs ++ [env]) =
        observationStep (berardNoDirectGeneratedObservation header envs) env
  outputRealizer : Prop
  outputRealizer_proof : outputRealizer

namespace BerardUniformControllerMonitorAssemblyForHeader

/--
Fold the one-directional product controller and the no-direct monitor together
along a generated environment prefix.

The second component is the monitor state; the first component is the Bérard
controller-table state reached by the branch observations produced along the
same prefix.
-/
noncomputable def monitorFold
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (table : BerardUniformOneDirectionalControllerTable problem)
    (branchOfObservation :
      BerardNoDirectGeneratedObservationState header ->
        EnvironmentRound In₁ In₂ -> Branch)
    (observationStep :
      BerardNoDirectGeneratedObservationState header ->
        EnvironmentRound In₁ In₂ ->
          BerardNoDirectGeneratedObservationState header)
    (envs : List (EnvironmentRound In₁ In₂)) :
    table.Control × BerardNoDirectGeneratedObservationState header :=
  envs.foldl
    (fun state env =>
      ( table.step state.1 (branchOfObservation state.2 env)
      , observationStep state.2 env ))
    (table.initial, berardNoDirectGeneratedObservation header [])

@[simp]
theorem monitorFold_nil
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (table : BerardUniformOneDirectionalControllerTable problem)
    (branchOfObservation :
      BerardNoDirectGeneratedObservationState header ->
        EnvironmentRound In₁ In₂ -> Branch)
    (observationStep :
      BerardNoDirectGeneratedObservationState header ->
        EnvironmentRound In₁ In₂ ->
          BerardNoDirectGeneratedObservationState header) :
    monitorFold table branchOfObservation observationStep [] =
      (table.initial, berardNoDirectGeneratedObservation header []) := by
  rfl

theorem monitorFold_snoc
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (table : BerardUniformOneDirectionalControllerTable problem)
    (branchOfObservation :
      BerardNoDirectGeneratedObservationState header ->
        EnvironmentRound In₁ In₂ -> Branch)
    (observationStep :
      BerardNoDirectGeneratedObservationState header ->
        EnvironmentRound In₁ In₂ ->
          BerardNoDirectGeneratedObservationState header)
    (envs : List (EnvironmentRound In₁ In₂))
    (env : EnvironmentRound In₁ In₂) :
    monitorFold table branchOfObservation observationStep (envs ++ [env]) =
      ( table.step (monitorFold table branchOfObservation observationStep envs).1
          (branchOfObservation
            (monitorFold table branchOfObservation observationStep envs).2 env)
      , observationStep
          (monitorFold table branchOfObservation observationStep envs).2 env ) := by
  simp [monitorFold, List.foldl_append]

/--
The folded monitor component is the genuine generated no-direct observation
whenever the supplied monitor transition has the generated-prefix snoc law.
-/
theorem monitorFold_observation_eq
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (table : BerardUniformOneDirectionalControllerTable problem)
    (branchOfObservation :
      BerardNoDirectGeneratedObservationState header ->
        EnvironmentRound In₁ In₂ -> Branch)
    (observationStep :
      BerardNoDirectGeneratedObservationState header ->
        EnvironmentRound In₁ In₂ ->
          BerardNoDirectGeneratedObservationState header)
    (observation_snoc :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        berardNoDirectGeneratedObservation header (envs ++ [env]) =
          observationStep (berardNoDirectGeneratedObservation header envs) env) :
    ∀ envs : List (EnvironmentRound In₁ In₂),
      (monitorFold table branchOfObservation observationStep envs).2 =
        berardNoDirectGeneratedObservation header envs := by
  intro envs
  induction envs using List.reverseRecOn with
  | nil =>
      simp
  | append_singleton envs env ih =>
      rw [monitorFold_snoc]
      simp only [Prod.snd]
      rw [ih]
      exact (observation_snoc envs env).symm

/--
The folded controller component satisfies the generated-prefix snoc law needed
by the no-direct monitor assembly.  No separate external controller trace is
needed once the branch map and monitor transition are fixed.
-/
theorem monitorFold_control_snoc
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (table : BerardUniformOneDirectionalControllerTable problem)
    (branchOfObservation :
      BerardNoDirectGeneratedObservationState header ->
        EnvironmentRound In₁ In₂ -> Branch)
    (observationStep :
      BerardNoDirectGeneratedObservationState header ->
        EnvironmentRound In₁ In₂ ->
          BerardNoDirectGeneratedObservationState header)
    (observation_snoc :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        berardNoDirectGeneratedObservation header (envs ++ [env]) =
          observationStep (berardNoDirectGeneratedObservation header envs) env)
    (envs : List (EnvironmentRound In₁ In₂))
    (env : EnvironmentRound In₁ In₂) :
    (monitorFold table branchOfObservation observationStep (envs ++ [env])).1 =
      table.step (monitorFold table branchOfObservation observationStep envs).1
        (branchOfObservation (berardNoDirectGeneratedObservation header envs) env) := by
  rw [monitorFold_snoc]
  simp only [Prod.fst]
  rw [monitorFold_observation_eq
    table branchOfObservation observationStep observation_snoc envs]

/--
Construct the no-direct controller/monitor assembly from only a uniform
Bérard table, a branch decoder, and the generated no-direct monitor transition.
-/
noncomputable def ofTableAndMonitor
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (table : BerardUniformOneDirectionalControllerTable problem)
    (branchOfObservation :
      BerardNoDirectGeneratedObservationState header ->
        EnvironmentRound In₁ In₂ -> Branch)
    (observationStep :
      BerardNoDirectGeneratedObservationState header ->
        EnvironmentRound In₁ In₂ ->
          BerardNoDirectGeneratedObservationState header)
    (observation_snoc :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        berardNoDirectGeneratedObservation header (envs ++ [env]) =
          observationStep (berardNoDirectGeneratedObservation header envs) env)
    (outputRealizer : Prop)
    (outputRealizer_proof : outputRealizer) :
    BerardUniformControllerMonitorAssemblyForHeader
      (problem := problem) header where
  table := table
  branchOfObservation := branchOfObservation
  controlOfGenerated := fun envs =>
    (monitorFold table branchOfObservation observationStep envs).1
  control_nil := by
    simp
  control_snoc := by
    intro envs env
    exact monitorFold_control_snoc
      table branchOfObservation observationStep observation_snoc envs env
  observationStep := observationStep
  observation_snoc := observation_snoc
  outputRealizer := outputRealizer
  outputRealizer_proof := outputRealizer_proof

