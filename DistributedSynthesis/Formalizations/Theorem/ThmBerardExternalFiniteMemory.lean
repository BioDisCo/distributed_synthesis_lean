/--
External representative-complete Bérard finite-cover payload.

This is the stronger universal-cover output.  It contains a finite cover,
nonempty generated representatives for every cover state, the generation-bound
proof for those representatives, and the monitor/factor correctness fields used
by the checked rational-summary route.  Positivity of the generation bound is a
checked consequence of these representative fields, not an extra external
obligation.
-/
structure BerardRepresentativeCompleteCoverExternalPayload
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  cover :
    RepresentativeCompleteNoDirectBerardFiniteCoverForActualTruthAutomatonParityCurrentOrderHeader
      header

