/-- The supplied reachable observer contains the generation-bound domination proof. -/
theorem generationBound_dominates
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardReachableObserverExternalPayload header) :
    ∀ s : payload.observer.State,
      (∃ envs : List (EnvironmentRound In₁ In₂),
        payload.observer.stateOfGenerated envs = s) ->
      ∃ envs : List (EnvironmentRound In₁ In₂),
        payload.observer.stateOfGenerated envs = s ∧
          envs.length ≤ header.generationBound :=
  payload.observer.bounded_reachable_state

theorem generated_truth_correct
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardReachableObserverExternalPayload header)
    (envs : List (EnvironmentRound In₁ In₂)) :
    payload.observer.truthOfState (payload.observer.stateOfGenerated envs) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ envs)) :=
  payload.observer.generated_truth envs

theorem generated_epoch_correct
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardReachableObserverExternalPayload header)
    (envs : List (EnvironmentRound In₁ In₂)) :
    payload.observer.epochOfState (payload.observer.stateOfGenerated envs) =
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
        header.initialBoundary (executionPrefixFromList header.σ envs) :=
  payload.observer.generated_epoch envs

theorem generated_automaton_correct
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardReachableObserverExternalPayload header)
    (envs : List (EnvironmentRound In₁ In₂)) :
    payload.observer.automatonOfState (payload.observer.stateOfGenerated envs) =
      header.automatonOfTruth
        (regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ envs))) :=
  payload.observer.generated_automaton envs

theorem generated_receipt_correct
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardReachableObserverExternalPayload header)
    (envs : List (EnvironmentRound In₁ In₂)) :
    payload.observer.receiptOfState (payload.observer.stateOfGenerated envs) =
      currentReceiptOrderData
        (executionPrefixFromList header.σ envs)
        (historyCurrentContainmentOrder
          (executionPrefixFromList header.σ envs)) :=
  payload.observer.generated_receipt envs

