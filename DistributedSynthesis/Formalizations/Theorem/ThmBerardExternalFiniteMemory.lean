    header pkg.toReachableObserverConstruction

/--
Representative preservation theorem obtained from the corrected path-level
Bérard package.
-/
theorem representative_preserves_observations
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (pkg :
      BerardNoDirectViewDecoderPathRightCongruenceCorePackageForHeader header)
    (envs : List (EnvironmentRound In₁ In₂)) :
    regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            ((pkg.toReachableControllerCertificate).representativeOfState
              ((pkg.toReachableControllerCertificate).stateOfGenerated envs)))) =
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ envs)) ∧
    header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
        header.initialBoundary
        (executionPrefixFromList header.σ
          ((pkg.toReachableControllerCertificate).representativeOfState
            ((pkg.toReachableControllerCertificate).stateOfGenerated envs))) =
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
        header.initialBoundary (executionPrefixFromList header.σ envs) ∧
    header.toCurrentOrderHeader.automatonOfHistory
        (executionPrefixFromList header.σ
          ((pkg.toReachableControllerCertificate).representativeOfState
            ((pkg.toReachableControllerCertificate).stateOfGenerated envs))) =
      header.toCurrentOrderHeader.automatonOfHistory
        (executionPrefixFromList header.σ envs) ∧
    currentReceiptOrderData
        (executionPrefixFromList header.σ
          ((pkg.toReachableControllerCertificate).representativeOfState
            ((pkg.toReachableControllerCertificate).stateOfGenerated envs)))
        (historyCurrentContainmentOrder
          (executionPrefixFromList header.σ
            ((pkg.toReachableControllerCertificate).representativeOfState
              ((pkg.toReachableControllerCertificate).stateOfGenerated envs)))) =
      currentReceiptOrderData
        (executionPrefixFromList header.σ envs)
        (historyCurrentContainmentOrder
          (executionPrefixFromList header.σ envs)) :=
  (pkg.toReachableControllerCertificate).representative_preserves_observations envs

