                  decodeOneNonFringe (summaryOne state) ∧
                (viewOne state (env n)).receiptTag =
                  decodeOneReceipt (summaryOne state) ∧
                (viewTwo state (env n)).nonFringe =
                  decodeTwoNonFringe (summaryTwo state) ∧
                (viewTwo state (env n)).receiptTag =
                  decodeTwoReceipt (summaryTwo state)) :
    DPAToFiniteGameCompilation.{u, v, x, y, max (max (max (max u v) x) y) aut, aut}
      Out₂ A :=
  ofRoundAwareLocalNoDirectStateStreamActualViewsAndRejectedDecodedSummaryFactorsRepresentableForBerardTrivialTargets
    A uniform initialBoundary automaton_equiv
    viewOne viewTwo defaultOne defaultTwo
    dynamicHierarchy parityObjective
    dynamicHierarchy_proof parityObjective_proof
    actualViews summaryOne summaryTwo
    (fun summary => (decodeOneNonFringe summary, decodeOneReceipt summary))
    (fun summary => (decodeTwoNonFringe summary, decodeTwoReceipt summary))
    (fun controller env word hcompatible hreject n => by
      rcases rejectedSplitDecodedSummaryFactors
          controller env word hcompatible hreject n with
        ⟨honeNonFringe, honeReceipt, htwoNonFringe, htwoReceipt⟩
      exact
        ⟨by simpa [honeNonFringe, honeReceipt],
          by simpa [htwoNonFringe, htwoReceipt]⟩)

/--
Target-free state-stream fixed-DPA state-factor backend wrapper.

This is the state-stream sibling of
`ofRoundAwareLocalNoDirectActualPrefixViewsAndRejectedProjectedViewFactorsRepresentableForBerardTrivialTargets`:
the accepted rotating targets are fixed to the canonical accepted `PUnit`
target, and the remaining inputs are exactly the no-direct backend facts.
-/
noncomputable def ofRoundAwareLocalNoDirectStateStreamActualViewsAndRejectedProjectedViewFactorsRepresentableForBerardTrivialTargets
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (uniform :
      UniformOneDirectionalFiniteIndexLemma.{max u v x y, u, v, x, y, max u v x y}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (automaton_equiv :
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        uniform.noDirectEpochTransformer.automaton.Accepts word ↔
          A.Accepts word)
    (viewOne :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (dynamicHierarchy parityObjective : Prop)
    (dynamicHierarchy_proof : dynamicHierarchy)
    (parityObjective_proof : parityObjective)
    (actualViews :
      ∀ controller :
          uniform.noDirectEpochTransformer.RoundAwareLocalControllerCode
            viewOne viewTwo,
        ∀ env : EnvironmentSequence In₁ In₂,
          ∀ n : Nat,
            let σ :=
              FiniteEpochTransformer.strategyOfRoundAwareLocalController
                uniform.noDirectEpochTransformer viewOne viewTwo controller
                defaultOne defaultTwo
            viewOne
                (uniform.noDirectEpochStateStream initialBoundary σ env n)
                (env n) =
              nextView Proc.one (executionPrefix σ env n) (env n) ∧
            viewTwo
                (uniform.noDirectEpochStateStream initialBoundary σ env n)
                (env n) =
              nextView Proc.two (executionPrefix σ env n) (env n))
    (projectedOneNonFringe :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        NonFringeView In₁ In₂ Proc.one)
    (projectedOneReceipt :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        ReceiptTag)
    (projectedTwoNonFringe :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        NonFringeView In₁ In₂ Proc.two)
    (projectedTwoReceipt :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        ReceiptTag)
    (rejectedProjectedViewFactors :
      ∀ controller :
          uniform.noDirectEpochTransformer.RoundAwareLocalControllerCode
            viewOne viewTwo,
        ∀ (env : EnvironmentSequence In₁ In₂)
          (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          FiniteEpochTransformer.RoundAwareLocalControllerCompatibleDecodedExecution
            uniform.noDirectEpochTransformer viewOne viewTwo controller
            (FiniteEpochTransformer.strategyOfRoundAwareLocalController
              uniform.noDirectEpochTransformer viewOne viewTwo controller
              defaultOne defaultTwo)
            env word ->
          ¬ A.Accepts word ->
            ∀ n : Nat,
              let state :=
                uniform.noDirectEpochStateAfterHistory initialBoundary
                  (FiniteEpochTransformer.wordPrefix word n)
              (viewOne state (env n)).nonFringe =
                  projectedOneNonFringe state ∧
                (viewOne state (env n)).receiptTag =
                  projectedOneReceipt state ∧
                (viewTwo state (env n)).nonFringe =
                  projectedTwoNonFringe state ∧
                (viewTwo state (env n)).receiptTag =
                  projectedTwoReceipt state) :
    DPAToFiniteGameCompilation.{u, v, x, y, max (max (max (max u v) x) y) aut, aut}
      Out₂ A :=
  (RoundAwareLocalRotatingRationalRunEpochBackendCertificate.ofNoDirectStateStreamActualViewsAndRejectedProjectedViewFactorsRepresentableTrivialTargets
    A uniform initialBoundary automaton_equiv
    viewOne viewTwo defaultOne defaultTwo
    dynamicHierarchy parityObjective
    dynamicHierarchy_proof parityObjective_proof
    actualViews
    projectedOneNonFringe projectedOneReceipt
    projectedTwoNonFringe projectedTwoReceipt
    rejectedProjectedViewFactors)
  |>.toDPAToFiniteGameCompilationForBerard

end DPAToFiniteGameCompilation

namespace DPARoundAwareLocalRotatingRationalRunEpochCompiler

/--
Construct the Bérard finite-game compiler from the local-observable
round-aware rotating rational-run backend.

This is the full-view analogue of the lambda-local adapter: the local backend
already produces a DPA finite-game compiler, and this wrapper only lifts the
finite-game carrier to the universe expected by the strategy-reachable Bérard
certificate.
-/
noncomputable def toDPAFiniteGameCompilerForBerard
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (compiler :
      DPARoundAwareLocalRotatingRationalRunEpochCompiler.{u, v, x, y, br, lab, tr, aut}
        In₁ In₂ Out₁ Out₂) :
    DPAFiniteGameCompiler.{u, v, x, y, max (max (max (max u v) x) y) aut, aut}
      In₁ In₂ Out₁ Out₂ :=
  let base := compiler.toDPAFiniteGameCompiler
  { compile := fun A =>
      let comp := base.compile A
      { finiteGame :=
          FiniteDynamicHierarchyParityGame.lift.{max u v x y, max u v x y, aut, 0}
            comp.finiteGame
        realizabilityEquivalent :=
          (FiniteDynamicHierarchyParityGame.lift_realizable_iff.{max u v x y, max u v x y, aut, 0}
            (game := comp.finiteGame)).trans comp.realizabilityEquivalent } }

end DPARoundAwareLocalRotatingRationalRunEpochCompiler

