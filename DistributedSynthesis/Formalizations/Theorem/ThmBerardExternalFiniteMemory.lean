-/
noncomputable def ofRoundAwareLambdaNoDirectActualAndRejectedPrefixConsistentTrackingForBerard
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (Branch :
      ∀ _A : DetParityAutomaton.{max u v x y, aut}
