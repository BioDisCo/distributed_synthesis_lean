/--
The representative-complete cover already proves the generation bound is
positive: choose any cover state, use its nonempty generated representative,
and compare that positive length with `header.generationBound`.
-/
theorem generationBound_pos
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardRepresentativeCompleteCoverExternalPayload header) :
    0 < header.generationBound := by
  letI : Inhabited payload.cover.CoverState := payload.cover.coverInhabited
  let c : payload.cover.CoverState := default
  have hne : payload.cover.representativeOfCover c ≠ [] :=
    payload.cover.representative_nonempty c
  have hlen_pos : 0 < (payload.cover.representativeOfCover c).length :=
    List.length_pos_of_ne_nil hne
  exact lt_of_lt_of_le hlen_pos (payload.cover.representative_bound c)

