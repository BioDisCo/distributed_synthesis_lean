    (hright : BerardGeneratedObservationRightCongruent header)
    (outputRealizer : Prop)
    (outputRealizer_proof : outputRealizer) :
    BerardDirectProductObserverRawConstructionForHeader header :=
  (BerardNoDirectRawControllerAssemblyForHeader.ofControllerAndRightCongruence
    controller hright outputRealizer outputRealizer_proof)
      |>.toRawDirectProductObserverConstruction

