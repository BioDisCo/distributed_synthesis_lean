/--
Build bounded round-aware local-label data from explicit contingent local
tables.

This is the Lean counterpart of the enriched local-transducer Bérard
extraction.  The external construction supplies finite local histories,
current fringes, and a contingent strategy table.  Lean packages that table as
a `RoundAwareLambdaControllerCode`, so the process-local output congruence is
proved by `roundAwareLambdaControllerOfContingentStrategy` rather than assumed
as an extra field.
-/
noncomputable def BoundedRoundAwareLambdaData.ofContingentStrategy
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    {assembly :
      BerardFullProductControllerMonitorAssemblyForHeader
        (problem := problem) header}
    {boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary}
    {H₁ H₂ R₁ R₂ : Type (max u v x y aut)}
    [histAtomOneFinite : Fintype H₁]
    [histAtomTwoFinite : Fintype H₂]
    [fringeOneFinite : Fintype R₁]
    [fringeTwoFinite : Fintype R₂]
    (T :
      FiniteEpochTransformer.{max u v x y, u, v, x, y, max u v x y aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> R₂)
    (strategy :
      ContingentStrategyPair H₁ H₂ R₁ R₂ Out₁ Out₂)
    (stateOfLabel :
      Alphabet -> FiniteEpochTransformer.GameState T)
    (histBoundOne histBoundTwo : Nat)
    (historyOne_label_length :
      ∀ (label : Alphabet) (env : EnvironmentRound In₁ In₂),
        (historyOne (stateOfLabel label) env).length ≤ histBoundOne)
    (historyTwo_label_length :
      ∀ (label : Alphabet) (env : EnvironmentRound In₁ In₂),
        (historyTwo (stateOfLabel label) env).length ≤ histBoundTwo)
    (historyOfViewOne :
      View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo :
      View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (histOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        historyOne
            (stateOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          historyOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (histTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        historyTwo
            (stateOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          historyOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (fringeOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        fringeOne
            (stateOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          fringeOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (fringeTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        fringeTwo
            (stateOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          fringeOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (output_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        ( strategy.one
            (historyOne
              (stateOfLabel
                (assembly.table.labelAt
                  (assembly.controlOfGenerated envs)
                  (boundaryOfObservation
                    (berardNoDirectGeneratedObservation header envs))))
              env)
            (fringeOne
              (stateOfLabel
                (assembly.table.labelAt
                  (assembly.controlOfGenerated envs)
                  (boundaryOfObservation
                    (berardNoDirectGeneratedObservation header envs))))
              env)
        , strategy.two
            (historyTwo
              (stateOfLabel
                (assembly.table.labelAt
                  (assembly.controlOfGenerated envs)
                  (boundaryOfObservation
                    (berardNoDirectGeneratedObservation header envs))))
              env)
            (fringeTwo
              (stateOfLabel
                (assembly.table.labelAt
                  (assembly.controlOfGenerated envs)
                  (boundaryOfObservation
                    (berardNoDirectGeneratedObservation header envs))))
              env) ) =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo))
    (reachable_dynamic_hierarchy : Prop)
    (reachable_dynamic_hierarchy_proof : reachable_dynamic_hierarchy) :
    BoundedRoundAwareLambdaData assembly boundaryOfObservation where
  H₁ := H₁
  H₂ := H₂
  R₁ := R₁
  R₂ := R₂
  histAtomOneFinite := histAtomOneFinite
  histAtomTwoFinite := histAtomTwoFinite
  fringeOneFinite := fringeOneFinite
  fringeTwoFinite := fringeTwoFinite
  T := T
  historyOne := historyOne
  historyTwo := historyTwo
  fringeOne := fringeOne
  fringeTwo := fringeTwo
  controller :=
    FiniteEpochTransformer.roundAwareLambdaControllerOfContingentStrategy
      T historyOne historyTwo fringeOne fringeTwo strategy
  stateOfLabel := stateOfLabel
  histBoundOne := histBoundOne
  histBoundTwo := histBoundTwo
  historyOne_label_length := historyOne_label_length
  historyTwo_label_length := historyTwo_label_length
  historyOfViewOne := historyOfViewOne
  historyOfViewTwo := historyOfViewTwo
  fringeOfViewOne := fringeOfViewOne
  fringeOfViewTwo := fringeOfViewTwo
  histOne_sound := histOne_sound
  histTwo_sound := histTwo_sound
  fringeOne_sound := fringeOne_sound
  fringeTwo_sound := fringeTwo_sound
  output_correct := by
    intro envs env
    simpa [FiniteEpochTransformer.roundAwareControllerOfContingentStrategy]
      using output_correct envs env
  reachable_dynamic_hierarchy := reachable_dynamic_hierarchy
  reachable_dynamic_hierarchy_proof := reachable_dynamic_hierarchy_proof

/--
Build bounded round-aware local-label data from explicit contingent local tables,
with the generated-prefix hierarchy discharged by the receipt/order monitor of
the full product observer.
-/
noncomputable def BoundedRoundAwareLambdaData.ofContingentStrategyWithGeneratedReceiptHierarchy
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    {assembly :
      BerardFullProductControllerMonitorAssemblyForHeader
        (problem := problem) header}
    {boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary}
    {H₁ H₂ R₁ R₂ : Type (max u v x y aut)}
    [histAtomOneFinite : Fintype H₁]
    [histAtomTwoFinite : Fintype H₂]
    [fringeOneFinite : Fintype R₁]
    [fringeTwoFinite : Fintype R₂]
    (T :
      FiniteEpochTransformer.{max u v x y, u, v, x, y, max u v x y aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> R₂)
    (strategy :
      ContingentStrategyPair H₁ H₂ R₁ R₂ Out₁ Out₂)
    (stateOfLabel :
      Alphabet -> FiniteEpochTransformer.GameState T)
    (histBoundOne histBoundTwo : Nat)
    (historyOne_label_length :
      ∀ (label : Alphabet) (env : EnvironmentRound In₁ In₂),
        (historyOne (stateOfLabel label) env).length ≤ histBoundOne)
    (historyTwo_label_length :
      ∀ (label : Alphabet) (env : EnvironmentRound In₁ In₂),
        (historyTwo (stateOfLabel label) env).length ≤ histBoundTwo)
    (historyOfViewOne :
      View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo :
      View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (histOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        historyOne
            (stateOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          historyOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (histTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        historyTwo
            (stateOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          historyOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (fringeOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        fringeOne
            (stateOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          fringeOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (fringeTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        fringeTwo
            (stateOfLabel
              (assembly.table.labelAt
                (assembly.controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          fringeOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (output_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        ( strategy.one
            (historyOne
              (stateOfLabel
                (assembly.table.labelAt
                  (assembly.controlOfGenerated envs)
                  (boundaryOfObservation
                    (berardNoDirectGeneratedObservation header envs))))
              env)
            (fringeOne
              (stateOfLabel
                (assembly.table.labelAt
                  (assembly.controlOfGenerated envs)
                  (boundaryOfObservation
                    (berardNoDirectGeneratedObservation header envs))))
              env)
        , strategy.two
            (historyTwo
              (stateOfLabel
                (assembly.table.labelAt
                  (assembly.controlOfGenerated envs)
                  (boundaryOfObservation
                    (berardNoDirectGeneratedObservation header envs))))
              env)
            (fringeTwo
              (stateOfLabel
                (assembly.table.labelAt
                  (assembly.controlOfGenerated envs)
                  (boundaryOfObservation
                    (berardNoDirectGeneratedObservation header envs))))
              env) ) =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo)) :
    BoundedRoundAwareLambdaData assembly boundaryOfObservation :=
  BoundedRoundAwareLambdaData.ofContingentStrategy
    (assembly := assembly) (boundaryOfObservation := boundaryOfObservation)
    T historyOne historyTwo fringeOne fringeTwo strategy stateOfLabel
    histBoundOne histBoundTwo
    historyOne_label_length historyTwo_label_length
    historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
    histOne_sound histTwo_sound fringeOne_sound fringeTwo_sound
    output_correct
    (assembly.toRawDirectProductObserverConstruction).GeneratedReceiptOrderDynamicHierarchy
    (assembly.toRawDirectProductObserverConstruction).generatedReceiptOrderDynamicHierarchy

/-- Encode bounded round-aware local-label data as finite local-label data. -/
noncomputable def BoundedRoundAwareLambdaData.toLocalLambdaLabelData
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    {assembly :
      BerardFullProductControllerMonitorAssemblyForHeader
        (problem := problem) header}
    {boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary}
    (data : BoundedRoundAwareLambdaData assembly boundaryOfObservation) :
    LocalLambdaLabelData assembly boundaryOfObservation :=
  LocalLambdaLabelData.ofBoundedRoundAwareLambdaController
    (assembly := assembly) (boundaryOfObservation := boundaryOfObservation)
    data.T data.historyOne data.historyTwo data.fringeOne data.fringeTwo
    data.controller data.stateOfLabel
    data.histBoundOne data.histBoundTwo
    data.historyOne_label_length data.historyTwo_label_length
    data.historyOfViewOne data.historyOfViewTwo
    data.fringeOfViewOne data.fringeOfViewTwo
    data.histOne_sound data.histTwo_sound data.fringeOne_sound
    data.fringeTwo_sound data.output_correct
    data.reachable_dynamic_hierarchy data.reachable_dynamic_hierarchy_proof

/-- Build the local-lambda reachable payload from the full product assembly. -/
noncomputable def toLocalLambdaReachablePayloadOfLabelData
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly :
      BerardFullProductControllerMonitorAssemblyForHeader
        (problem := problem) header)
    (boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary)
    (labelData : LocalLambdaLabelData assembly boundaryOfObservation) :
    BerardLocalLambdaReachablePayloadForHeader header :=
  let observer := assembly.toRawDirectProductObserverConstruction
  { observer := observer
    HandoffState := fun s => s ≠ observer.initialState
    handoff_ne_initial := by
      intro s hs
      exact hs
    localLambda :=
      { HistOne := labelData.HistOne
        HistTwo := labelData.HistTwo
        FringeOne := labelData.FringeOne
        FringeTwo := labelData.FringeTwo
        histOneFinite := labelData.histOneFinite
        histTwoFinite := labelData.histTwoFinite
        fringeOneFinite := labelData.fringeOneFinite
        fringeTwoFinite := labelData.fringeTwoFinite
        histOne := fun state env =>
          labelData.histOneOfLabel
            (assembly.table.labelAt state.1
              (boundaryOfObservation state.2)) env
        histTwo := fun state env =>
          labelData.histTwoOfLabel
            (assembly.table.labelAt state.1
              (boundaryOfObservation state.2)) env
        fringeOne := fun state env =>
          labelData.fringeOneOfLabel
            (assembly.table.labelAt state.1
              (boundaryOfObservation state.2)) env
        fringeTwo := fun state env =>
          labelData.fringeTwoOfLabel
            (assembly.table.labelAt state.1
              (boundaryOfObservation state.2)) env
        histOfViewOne := labelData.histOfViewOne
        histOfViewTwo := labelData.histOfViewTwo
        fringeOfViewOne := labelData.fringeOfViewOne
        fringeOfViewTwo := labelData.fringeOfViewTwo
        outputOne := fun state env =>
          labelData.outputOneOfLabel
            (assembly.table.labelAt state.1
              (boundaryOfObservation state.2)) env
        outputTwo := fun state env =>
          labelData.outputTwoOfLabel
            (assembly.table.labelAt state.1
              (boundaryOfObservation state.2)) env
        histOne_sound := by
          intro envs env
          exact labelData.histOne_sound envs env
        histTwo_sound := by
          intro envs env
          exact labelData.histTwo_sound envs env
        fringeOne_sound := by
          intro envs env
          exact labelData.fringeOne_sound envs env
        fringeTwo_sound := by
          intro envs env
          exact labelData.fringeTwo_sound envs env
        output_generated_correct := by
          intro envs env
          exact labelData.output_correct envs env
        outputOne_local := by
          intro stateA envA stateB envB hhist hfringe
          exact labelData.outputOne_local
            (assembly.table.labelAt stateA.1
              (boundaryOfObservation stateA.2)) envA
            (assembly.table.labelAt stateB.1
              (boundaryOfObservation stateB.2)) envB
            hhist hfringe
        outputTwo_local := by
          intro stateA envA stateB envB hhist hfringe
          exact labelData.outputTwo_local
            (assembly.table.labelAt stateA.1
              (boundaryOfObservation stateA.2)) envA
            (assembly.table.labelAt stateB.1
              (boundaryOfObservation stateB.2)) envB
            hhist hfringe
        reachable_dynamic_hierarchy := labelData.reachable_dynamic_hierarchy
        reachable_dynamic_hierarchy_proof :=
          labelData.reachable_dynamic_hierarchy_proof } }

/-- Safe payload from the full product assembly plus local-label data. -/
noncomputable def toSafeRawFiniteMemoryPayloadOfLabelData
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly :
      BerardFullProductControllerMonitorAssemblyForHeader
        (problem := problem) header)
    (boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary)
    (labelData : LocalLambdaLabelData assembly boundaryOfObservation) :
    BerardSafeRawFiniteMemoryPayloadForHeader header :=
  BerardSafeRawFiniteMemoryPayloadForHeader.ofLocalLambdaReachablePayload
    (assembly.toLocalLambdaReachablePayloadOfLabelData
      boundaryOfObservation labelData)

/-- Compiler-backed no-direct certificate from the full product assembly. -/
noncomputable def compilerCertificateOfLabelData
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
