/--
Theorem-shaped payload version of the long
`prop:blockwiseactualtruthquotient` route from explicit contingent local
controllers, with the generated-prefix hierarchy discharged from the generated
receipt/order monitor.

Compared with `blockwiseactualtruthquotient_ltlSynthesisDecidable_payload`,
this endpoint no longer accepts a packaged `BoundedRoundAwareLambdaData` record.
Lean builds that record from the contingent local strategy and uses the
generated-receipt hierarchy constructor, so the reachable hierarchy field and
the process-local controller congruence are not external inputs of the folded
route.
-/
theorem blockwiseactualtruthquotient_ltlSynthesisDecidable_payload_ofContingentStrategyWithGeneratedReceiptHierarchy
    {AP : Type ap}
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    [DecidableEq AP]
    (compiler :
      LTLToDPACompiler.{ap, max u v x y, aut}
        AP
        (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (formula : LTL AP)
    (problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet)
    (hrealizable : ∀ boundary, problem.realizable boundary)
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ (compiler.compile formula)}
    (branchOfProduct :
      (BerardOneDirectionalControllerFamily.uniformControllerTableOfRealizable
        problem hrealizable).Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ -> Branch)
    (observationStep :
      (BerardOneDirectionalControllerFamily.uniformControllerTableOfRealizable
        problem hrealizable).Control ->
        BerardNoDirectGeneratedObservationState header ->
          EnvironmentRound In₁ In₂ ->
            BerardNoDirectGeneratedObservationState header)
    (observation_step_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        observationStep
            (productFold
              (BerardOneDirectionalControllerFamily.uniformControllerTableOfRealizable
                problem hrealizable)
              branchOfProduct observationStep envs).1
            (berardNoDirectGeneratedObservation header envs) env =
          berardNoDirectGeneratedObservation header (envs ++ [env]))
    (boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary)
    {H₁ H₂ R₁ R₂ : Type (max u v x y aut)}
    [histAtomOneFinite : Fintype H₁]
    [histAtomTwoFinite : Fintype H₂]
    [fringeOneFinite : Fintype R₁]
    [fringeTwoFinite : Fintype R₂]
    (T :
      FiniteEpochTransformer.{max u v x y, u, v, x, y, max u v x y aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (historyOne :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      FiniteEpochTransformer.GameState T ->
        EnvironmentRound In₁ In₂ -> R₂)
    (strategy :
      ContingentStrategyPair H₁ H₂ R₁ R₂ Out₁ Out₂)
    (stateOfLabel :
      Alphabet -> FiniteEpochTransformer.GameState T)
    (histBoundOne histBoundTwo : Nat)
    (historyOne_label_length :
      ∀ (label : Alphabet) (env : EnvironmentRound In₁ In₂),
        (historyOne (stateOfLabel label) env).length ≤ histBoundOne)
    (historyTwo_label_length :
      ∀ (label : Alphabet) (env : EnvironmentRound In₁ In₂),
        (historyTwo (stateOfLabel label) env).length ≤ histBoundTwo)
    (historyOfViewOne :
      View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo :
      View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (histOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        historyOne
            (stateOfLabel
              ((ofRealizableBoundariesProductStepForLabelOutput
                  problem hrealizable branchOfProduct observationStep
                  observation_step_correct).table.labelAt
                ((ofRealizableBoundariesProductStepForLabelOutput
                    problem hrealizable branchOfProduct observationStep
                    observation_step_correct).controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          historyOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (histTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        historyTwo
            (stateOfLabel
              ((ofRealizableBoundariesProductStepForLabelOutput
                  problem hrealizable branchOfProduct observationStep
                  observation_step_correct).table.labelAt
                ((ofRealizableBoundariesProductStepForLabelOutput
                    problem hrealizable branchOfProduct observationStep
                    observation_step_correct).controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          historyOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (fringeOne_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        fringeOne
            (stateOfLabel
              ((ofRealizableBoundariesProductStepForLabelOutput
                  problem hrealizable branchOfProduct observationStep
                  observation_step_correct).table.labelAt
                ((ofRealizableBoundariesProductStepForLabelOutput
                    problem hrealizable branchOfProduct observationStep
                    observation_step_correct).controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          fringeOfViewOne
            (nextView Proc.one (executionPrefixFromList header.σ envs) env))
    (fringeTwo_sound :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        fringeTwo
            (stateOfLabel
              ((ofRealizableBoundariesProductStepForLabelOutput
                  problem hrealizable branchOfProduct observationStep
                  observation_step_correct).table.labelAt
                ((ofRealizableBoundariesProductStepForLabelOutput
                    problem hrealizable branchOfProduct observationStep
                    observation_step_correct).controlOfGenerated envs)
                (boundaryOfObservation
                  (berardNoDirectGeneratedObservation header envs))))
            env =
          fringeOfViewTwo
            (nextView Proc.two (executionPrefixFromList header.σ envs) env))
    (output_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        ( strategy.one
            (historyOne
              (stateOfLabel
                ((ofRealizableBoundariesProductStepForLabelOutput
                    problem hrealizable branchOfProduct observationStep
                    observation_step_correct).table.labelAt
                  ((ofRealizableBoundariesProductStepForLabelOutput
                      problem hrealizable branchOfProduct observationStep
                      observation_step_correct).controlOfGenerated envs)
                  (boundaryOfObservation
                    (berardNoDirectGeneratedObservation header envs))))
              env)
            (fringeOne
              (stateOfLabel
                ((ofRealizableBoundariesProductStepForLabelOutput
                    problem hrealizable branchOfProduct observationStep
                    observation_step_correct).table.labelAt
                  ((ofRealizableBoundariesProductStepForLabelOutput
                      problem hrealizable branchOfProduct observationStep
                      observation_step_correct).controlOfGenerated envs)
                  (boundaryOfObservation
                    (berardNoDirectGeneratedObservation header envs))))
              env)
        , strategy.two
            (historyTwo
              (stateOfLabel
                ((ofRealizableBoundariesProductStepForLabelOutput
                    problem hrealizable branchOfProduct observationStep
                    observation_step_correct).table.labelAt
                  ((ofRealizableBoundariesProductStepForLabelOutput
                      problem hrealizable branchOfProduct observationStep
                      observation_step_correct).controlOfGenerated envs)
                  (boundaryOfObservation
                    (berardNoDirectGeneratedObservation header envs))))
              env)
            (fringeTwo
              (stateOfLabel
                ((ofRealizableBoundariesProductStepForLabelOutput
                    problem hrealizable branchOfProduct observationStep
                    observation_step_correct).table.labelAt
                  ((ofRealizableBoundariesProductStepForLabelOutput
                      problem hrealizable branchOfProduct observationStep
                      observation_step_correct).controlOfGenerated envs)
                  (boundaryOfObservation
                    (berardNoDirectGeneratedObservation header envs))))
              env) ) =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo))
    (gameCompiler :
      DPAFiniteGameCompiler.{u, v, x, y, max u v x y aut, aut}
        In₁ In₂ Out₁ Out₂) :
    Nonempty
      (Decidable
        (SynthesisProblem
          (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
            LTL.Satisfies compiler.interp word formula))) :=
  ⟨ltlSynthesisDecidableOfRealizableBoundariesProductStepBoundedRoundAwareLambdaData
      compiler formula problem hrealizable branchOfProduct observationStep
      observation_step_correct boundaryOfObservation
      (BoundedRoundAwareLambdaData.ofContingentStrategyWithGeneratedReceiptHierarchy
        (assembly :=
          ofRealizableBoundariesProductStepForLabelOutput
            problem hrealizable branchOfProduct observationStep
            observation_step_correct)
        (boundaryOfObservation := boundaryOfObservation)
        T historyOne historyTwo fringeOne fringeTwo strategy stateOfLabel
        histBoundOne histBoundTwo
        historyOne_label_length historyTwo_label_length
        historyOfViewOne historyOfViewTwo fringeOfViewOne fringeOfViewTwo
        histOne_sound histTwo_sound fringeOne_sound fringeTwo_sound
        output_correct)
      gameCompiler⟩

