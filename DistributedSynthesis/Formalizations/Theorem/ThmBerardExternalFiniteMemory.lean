        In₁ In₂ Out₁ Out₂ A}
    (observer :
      BerardDirectProductObserverRawConstructionForHeader header)
    (core :
      NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    BerardDirectProductObserverRawRealizedTruthCompletionForHeader header :=
  observer.completionOfRawRealizedTruthRepresentativeInvariantCore
    (BerardRawRealizedTruthRepresentativeInvariantCoreForHeader.ofFiniteTruthQuotientInvariantCore
      core)

