  have hprefix :=
    executionPrefix_strategyOf_roundAwareLocalControllerOfHeaderStrategyViews
      header viewOne viewTwo hviews defaultOne defaultTwo env n
  have hgenerated :=
    generatedPrefixViews_noDirectEpochStateAfterHistory
      header viewOne viewTwo hviews (environmentPrefixList env n) (env n)
  simpa [
    σ,
    FiniteEpochTransformer.wordPrefix_execution,
    hprefix,
    executionPrefixFromList_environmentPrefixList
  ] using hgenerated

