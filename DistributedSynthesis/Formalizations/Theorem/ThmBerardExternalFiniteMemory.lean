namespace NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader

/--
A finite truth-quotient invariant core already supplies a
representative-complete cover if cover states are taken to be the realized
stabilized truth atoms themselves.

The representative of a realized atom is the bounded nonempty generated word
stored by the quotient state selected for that atom.  Epoch and receipt data are
read from that generated representative; the all-history invariant fields of the
quotient core prove that these readings agree with every history realizing the
same atom.
-/
noncomputable def toRepresentativeCompleteCover
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    RepresentativeCompleteNoDirectBerardFiniteCoverForActualTruthAutomatonParityCurrentOrderHeader
      header := by
  classical
  let TruthAtom := RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  let actualTruth :=
    fun h : History In₁ In₂ Graph Out₁ Out₂ =>
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  let actualEpoch :=
    fun h : History In₁ In₂ Graph Out₁ Out₂ =>
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
        header.initialBoundary h
  let actualReceipt :=
    fun h : History In₁ In₂ Graph Out₁ Out₂ =>
      currentReceiptOrderData h (historyCurrentContainmentOrder h)
  let Realized : TruthAtom -> Prop :=
    fun truth =>
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth
  let CoverPayload := { truth : TruthAtom // Realized truth }
  let CoverState := ULift.{max u v x y aut, max u v x y} CoverPayload
  let coverOfHistory : History In₁ In₂ Graph Out₁ Out₂ -> CoverState :=
    fun h => ULift.up ⟨actualTruth h, ⟨h, rfl⟩⟩
  let coverOfGenerated : List (EnvironmentRound In₁ In₂) -> CoverState :=
    fun envs => coverOfHistory (executionPrefixFromList header.σ envs)
  let representativeOfCover : CoverState -> List (EnvironmentRound In₁ In₂) :=
    fun c => core.envsOf (core.stateOfRealizedTruth c.down.1 c.down.2)
  let representativeHistory : CoverState -> History In₁ In₂ Graph Out₁ Out₂ :=
    fun c => executionPrefixFromList header.σ (representativeOfCover c)
  let coverEpoch : CoverState ->
      EpochRotatingAccessState
        header.toCurrentOrderHeader.toHeader.importedUniform.boundary
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
        (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two) :=
    fun c => actualEpoch (representativeHistory c)
  let coverReceipt : CoverState -> ReceiptOrderData :=
    fun c => actualReceipt (representativeHistory c)
  have representative_truth :
      ∀ c : CoverState, actualTruth (representativeHistory c) = c.down.1 := by
    intro c
    calc
      actualTruth (representativeHistory c) =
          core.truthOf (core.stateOfRealizedTruth c.down.1 c.down.2) := by
            simpa [representativeHistory, representativeOfCover, actualTruth]
              using core.envs_realizes (core.stateOfRealizedTruth c.down.1 c.down.2)
      _ = c.down.1 := core.state_truth_eq c.down.1 c.down.2
  refine
    { CoverState := CoverState
      coverFinite := ?_
      coverInhabited := ?_
      coverOfHistory := coverOfHistory
      coverOfGenerated := coverOfGenerated
      representativeOfCover := representativeOfCover
      representative_nonempty := ?_
      representative_bound := ?_
      representative_cover := ?_
      coverTruth := fun c => c.down.1
      coverEpoch := coverEpoch
      coverReceipt := coverReceipt
      history_truth := ?_
      history_epoch := ?_
      history_receipt := ?_
      generated_truth := ?_
      epoch_eq_of_truth_eq := ?_
      receipt_eq_of_truth_eq := ?_
      automaton_eq_of_truth_eq := ?_
      coherentHistoryNonempty := core.coherentHistoryNonempty }
  · letI : Fintype TruthAtom :=
      regularTestTruthAtomFintype (stabilizedSaturationBasis header.cert)
    infer_instance
  · exact ⟨ULift.up ⟨actualTruth ([] : History In₁ In₂ Graph Out₁ Out₂), ⟨[], rfl⟩⟩⟩
  · intro c
    exact core.envs_nonempty (core.stateOfRealizedTruth c.down.1 c.down.2)
  · intro c
    exact core.envs_bound (core.stateOfRealizedTruth c.down.1 c.down.2)
  · intro c
    cases c with
    | up q =>
        exact congrArg ULift.up (Subtype.ext (representative_truth (ULift.up q)))
  · intro h
    rfl
  · intro h
    let c : CoverState := coverOfHistory h
    change coverEpoch c = actualEpoch h
    have htruth : actualTruth (representativeHistory c) = actualTruth h := by
      calc
        actualTruth (representativeHistory c) = c.down.1 := representative_truth c
        _ = actualTruth h := rfl
    exact
      core.rawEpochState_invariant
        header.cert.determinesPathData_proof
        header.cert.predecessorClosed_proof
        header.cert.boundaryClosed_proof
        header.cert.continuationClosed_proof
        (representativeHistory c) h htruth
  · intro h
    let c : CoverState := coverOfHistory h
    change coverReceipt c = actualReceipt h
    have htruth : actualTruth (representativeHistory c) = actualTruth h := by
      calc
        actualTruth (representativeHistory c) = c.down.1 := representative_truth c
        _ = actualTruth h := rfl
    exact core.receiptOrder_invariant (representativeHistory c) h htruth
  · intro envs
    rfl
  · intro c c' htruth
    change actualEpoch (representativeHistory c) =
      actualEpoch (representativeHistory c')
    have hrepTruth :
        actualTruth (representativeHistory c) =
          actualTruth (representativeHistory c') := by
      calc
        actualTruth (representativeHistory c) = c.down.1 := representative_truth c
        _ = c'.down.1 := htruth
        _ = actualTruth (representativeHistory c') := (representative_truth c').symm
    exact
      core.rawEpochState_invariant
        header.cert.determinesPathData_proof
        header.cert.predecessorClosed_proof
        header.cert.boundaryClosed_proof
        header.cert.continuationClosed_proof
        (representativeHistory c) (representativeHistory c') hrepTruth
  · intro c c' htruth
    change actualReceipt (representativeHistory c) =
      actualReceipt (representativeHistory c')
    have hrepTruth :
        actualTruth (representativeHistory c) =
          actualTruth (representativeHistory c') := by
      calc
        actualTruth (representativeHistory c) = c.down.1 := representative_truth c
        _ = c'.down.1 := htruth
        _ = actualTruth (representativeHistory c') := (representative_truth c').symm
    exact
      core.receiptOrder_invariant
        (representativeHistory c) (representativeHistory c') hrepTruth
  · intro h h' htruth
    change header.automatonOfTruth (actualTruth h) =
      header.automatonOfTruth (actualTruth h')
    simpa [actualTruth] using congrArg header.automatonOfTruth htruth

/-- Package the finite truth-quotient core as the cover-style external payload. -/
noncomputable def toRepresentativeCompleteCoverExternalPayload
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    BerardRepresentativeCompleteCoverExternalPayload header where
  cover := core.toRepresentativeCompleteCover

/--
Direct final-certificate endpoint from the finite truth-quotient invariant
core.  This makes explicit that the representative-complete cover and observer
wrappers are not needed once the corrected `mainMath` core has been supplied.
-/
noncomputable def toNoDirectReversalRestrictedCertificate
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (backend :
      NoDirectDPAJournalBoundedLocalConcreteFringeCompilerBackendForHeader
        header.toCurrentOrderHeader.toHeader) :
    NoDirectDPAJournalNoDirectReversalRestrictedCertificate In₁ In₂ Out₁ Out₂ A
    where
  header := header
  mainMath := core
  backend := backend

/-- DPA decidability consequence from the finite truth-quotient invariant core. -/
noncomputable def toNoDirectDPASynthesisDecidable
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (backend :
      NoDirectDPAJournalBoundedLocalConcreteFringeCompilerBackendForHeader
        header.toCurrentOrderHeader.toHeader) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  noDirectDPASynthesisDecidable_ofNoDirectReversalRestrictedCertificate
    A (core.toNoDirectReversalRestrictedCertificate backend)

end NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader

end DistributedSynthesis
