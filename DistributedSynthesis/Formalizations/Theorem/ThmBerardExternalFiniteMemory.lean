observation right-congruence core, the truth-factor blockwise core, and the
original compiler backend.
-/
noncomputable def toNoDirectReversalRestrictedCertificateOfLabelRightCongruenceCoreAndTruthFactorBlockwiseCoreWithOriginalBackend
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly :
      BerardUniformControllerMonitorAssemblyForHeader
        (problem := problem) header)
    (boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary)
    (outputOfLabel :
      Alphabet -> EnvironmentRound In₁ In₂ -> Out₁ × Out₂)
    (output_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        outputOfLabel
            (assembly.table.labelAt
              (assembly.controlOfGenerated envs)
              (boundaryOfObservation
                (berardNoDirectGeneratedObservation header envs)))
            env =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo))
    (rightCore : BerardGeneratedObservationRightCongruenceCore header)
    (truthCore :
      NoDirectDPAJournalBoundedLocalTruthFactorBlockwiseCoreForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (backend :
      NoDirectDPAJournalBoundedLocalConcreteFringeCompilerBackendForHeader
        header.toCurrentOrderHeader.toHeader) :
    NoDirectDPAJournalNoDirectReversalRestrictedCertificate In₁ In₂ Out₁ Out₂ A :=
  (assembly.toRawComputedBoundExternalPayloadOfLabelRightCongruenceCoreAndTruthFactorBlockwiseCore
      boundaryOfObservation outputOfLabel output_correct rightCore truthCore)
    |>.toNoDirectReversalRestrictedCertificateWithOriginalBackend backend

