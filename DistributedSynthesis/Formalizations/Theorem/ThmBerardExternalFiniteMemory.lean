      NoDirectDPAJournalBoundedLocalActualTruthInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    BerardRealizedTruthSeedSurjectivityForHeader header where
  envsOfRealizedTruth := fun _ hreal =>
    core.envsOfHistory (Classical.choose hreal)
  envs_realizes := by
    intro truth hreal
    have hselected :
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (Classical.choose hreal)) = truth := by
      simpa using Classical.choose_spec hreal
    calc
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ
              (core.envsOfHistory (Classical.choose hreal)))) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (Classical.choose hreal)) :=
            core.envs_actualTruth (Classical.choose hreal)
      _ = truth := hselected
  envs_nonempty := by
    intro _ hreal
    exact core.envs_nonempty (Classical.choose hreal)

/-- Forget the length bound from a truth-factor blockwise core. -/
