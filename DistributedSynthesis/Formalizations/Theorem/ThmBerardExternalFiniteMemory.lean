/--
Right-congruence extends from one appended letter to any appended suffix.
-/
theorem rightCongruent_append
    {Env : Type u} {State : Type v}
    (stateOf : List Env -> State)
    (hright :
      ∀ (xs ys : List Env) (env : Env),
        stateOf xs = stateOf ys ->
          stateOf (xs ++ [env]) = stateOf (ys ++ [env]))
    {xs ys : List Env}
    (hxy : stateOf xs = stateOf ys) :
    ∀ suffix : List Env, stateOf (xs ++ suffix) = stateOf (ys ++ suffix) := by
  intro suffix
  induction suffix using List.reverseRecOn with
  | nil =>
      simpa using hxy
  | append_singleton suffix env ih =>
      simpa [List.append_assoc] using
        hright (xs ++ suffix) (ys ++ suffix) env ih

/--
Finite-state pumping for generated representatives.

If the generated state is right-congruent under appending one environment
letter, every generated state has a representative of length at most the number
of finite states.
-/
theorem boundedRepresentatives_of_rightCongruent_card
    {Env : Type u} {State : Type v}
    [Fintype State]
    (stateOf : List Env -> State)
    (hright :
      ∀ (xs ys : List Env) (env : Env),
        stateOf xs = stateOf ys ->
          stateOf (xs ++ [env]) = stateOf (ys ++ [env])) :
    ∀ xs : List Env,
      ∃ rep : List Env,
        stateOf rep = stateOf xs ∧ rep.length ≤ Fintype.card State := by
  classical
  intro xs
  induction hlen : xs.length using Nat.strong_induction_on generalizing xs with
  | h n ih =>
      by_cases hshort : xs.length ≤ Fintype.card State
      · exact ⟨xs, rfl, hshort⟩
      · have hcard_lt_len : Fintype.card State < xs.length := Nat.lt_of_not_ge hshort
        have hcard_lt_fin :
            Fintype.card State < Fintype.card (Fin (xs.length + 1)) := by
          simp
          omega
        rcases Fintype.exists_ne_map_eq_of_card_lt
            (fun i : Fin (xs.length + 1) => stateOf (xs.take i.1))
            hcard_lt_fin with
          ⟨i, j, hij_ne, hij_state⟩
        have hij_nat_ne : (i : Nat) ≠ (j : Nat) := by
          intro h
          exact hij_ne (Fin.ext h)
        have hij_lt_or : (i : Nat) < (j : Nat) ∨ (j : Nat) < (i : Nat) :=
          lt_or_gt_of_ne hij_nat_ne
        rcases hij_lt_or with hij_lt | hji_lt
        · let cut : List Env := xs.take i.1 ++ xs.drop j.1
          have hi_le : (i : Nat) ≤ xs.length := by
            exact Nat.le_of_lt_succ i.2
          have hj_le : (j : Nat) ≤ xs.length := by
            exact Nat.le_of_lt_succ j.2
          have hcut_len : cut.length < xs.length := by
            dsimp [cut]
            simp [List.length_take, List.length_drop,
              Nat.min_eq_left hi_le]
            omega
          have hcut_state : stateOf cut = stateOf xs := by
            dsimp [cut]
            have hsuffix :=
              rightCongruent_append stateOf hright hij_state (xs.drop j.1)
            have hj_take_drop : xs.take j.1 ++ xs.drop j.1 = xs := by
              exact List.take_append_drop j.1 xs
            simpa [hj_take_drop] using hsuffix
          have hcut_len_n : cut.length < n := by
            simpa [hlen] using hcut_len
          rcases ih cut.length hcut_len_n cut rfl with ⟨rep, hrep, hrep_bound⟩
          exact ⟨rep, hrep.trans hcut_state, hrep_bound⟩
        · let cut : List Env := xs.take j.1 ++ xs.drop i.1
          have hj_le : (j : Nat) ≤ xs.length := by
            exact Nat.le_of_lt_succ j.2
          have hi_le : (i : Nat) ≤ xs.length := by
            exact Nat.le_of_lt_succ i.2
          have hcut_len : cut.length < xs.length := by
            dsimp [cut]
            simp [List.length_take, List.length_drop,
              Nat.min_eq_left hj_le]
            omega
          have hcut_state : stateOf cut = stateOf xs := by
            dsimp [cut]
            have hsuffix :=
              rightCongruent_append stateOf hright hij_state.symm (xs.drop i.1)
            have hi_take_drop : xs.take i.1 ++ xs.drop i.1 = xs := by
              exact List.take_append_drop i.1 xs
            simpa [hi_take_drop] using hsuffix
          have hcut_len_n : cut.length < n := by
            simpa [hlen] using hcut_len
          rcases ih cut.length hcut_len_n cut rfl with ⟨rep, hrep, hrep_bound⟩
          exact ⟨rep, hrep.trans hcut_state, hrep_bound⟩

/-- A finite family of natural numbers has a finite uniform bound. -/
theorem finiteFamilyNatBound
    {α : Type u} [Fintype α] (len : α -> Nat) :
    ∃ N : Nat, ∀ a : α, len a ≤ N := by
  classical
  let N : Nat := ((Finset.univ : Finset α).image len).sum id
  refine ⟨N, ?_⟩
  intro a
  have hmem : len a ∈ ((Finset.univ : Finset α).image len) := by
    exact Finset.mem_image.mpr ⟨a, by simp, rfl⟩
  exact Finset.single_le_sum (by intro n _hn; exact Nat.zero_le n) hmem

namespace TransitionRationalTree

@[simp]
theorem controlAt_nil
    {Branch : Type u} {Alphabet : Type v}
    (tree : TransitionRationalTree.{u, v, x} Branch Alphabet) :
    tree.controlAt [] = tree.initial := by
  rfl

@[simp]
theorem controlAt_snoc
    {Branch : Type u} {Alphabet : Type v}
    (tree : TransitionRationalTree.{u, v, x} Branch Alphabet)
    (node : TreeNode Branch) (branch : Branch) :
    tree.controlAt (node ++ [branch]) =
      tree.step (tree.controlAt node) branch := by
  simp [TransitionRationalTree.controlAt, List.foldl_append]

@[simp]
theorem labeledTree_apply
    {Branch : Type u} {Alphabet : Type v}
    (tree : TransitionRationalTree.{u, v, x} Branch Alphabet)
    (node : TreeNode Branch) :
    tree.labeledTree node = tree.labelOf (tree.controlAt node) := by
  rfl

end TransitionRationalTree

