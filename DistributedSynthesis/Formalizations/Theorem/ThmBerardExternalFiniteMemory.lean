/--
Completion data that turns the corrected direct product observer into the
public finite-truth-quotient core.

The direct observer itself is only a generated-prefix object.  To feed the
paper-facing no-direct theorem, the Bérard construction must also show that
every realized stabilized truth atom has a nonempty bounded generated
representative whose product state carries that atom, and that raw epoch and
receipt/order are invariant under equality of realized truth atoms on arbitrary
histories.
-/
structure BerardDirectProductObserverRealizedTruthCompletionForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  observer :
    BerardDirectProductObserverConstructionForHeader header
  envsOfRealizedTruth :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth ->
        List (EnvironmentRound In₁ In₂)
  stateOfRealizedTruth :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth ->
        observer.ProductState
  envs_state :
    ∀ (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
      (hreal :
        StabilizedSaturationBasisNoDirectRealizedTruthAtom
          header.cert (pathOfHistoryByRound header.edgeOfRound) truth),
      observer.stateOfGenerated (envsOfRealizedTruth truth hreal) =
        stateOfRealizedTruth truth hreal
  state_truth :
    ∀ (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
      (hreal :
        StabilizedSaturationBasisNoDirectRealizedTruthAtom
          header.cert (pathOfHistoryByRound header.edgeOfRound) truth),
      observer.truthOfState (stateOfRealizedTruth truth hreal) = truth
  envs_bound :
    ∀ (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
      (hreal :
        StabilizedSaturationBasisNoDirectRealizedTruthAtom
          header.cert (pathOfHistoryByRound header.edgeOfRound) truth),
      (envsOfRealizedTruth truth hreal).length ≤ header.generationBound
  envs_nonempty :
    ∀ (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
      (hreal :
        StabilizedSaturationBasisNoDirectRealizedTruthAtom
          header.cert (pathOfHistoryByRound header.edgeOfRound) truth),
      envsOfRealizedTruth truth hreal ≠ []
  rawEpochState_invariant :
    header.cert.determinesPathData ->
    header.cert.predecessorClosed ->
    (∀ boundaryState, header.cert.boundaryClosed boundaryState) ->
    header.cert.continuationClosed ->
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h') ->
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h'
  receiptOrder_invariant :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h')
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

namespace BerardDirectProductObserverRealizedTruthCompletionForHeader

/-- The selected representative for a realized truth atom really realizes it. -/
theorem envs_realizes
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (completion :
      BerardDirectProductObserverRealizedTruthCompletionForHeader header)
    (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
    (hreal :
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth) :
    regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (completion.envsOfRealizedTruth truth hreal))) =
      truth := by
  calc
    regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (completion.envsOfRealizedTruth truth hreal))) =
        completion.observer.truthOfState
          (completion.observer.stateOfGenerated
            (completion.envsOfRealizedTruth truth hreal)) := by
          exact
            (completion.observer.generated_truth
              (completion.envsOfRealizedTruth truth hreal)).symm
    _ =
        completion.observer.truthOfState
          (completion.stateOfRealizedTruth truth hreal) := by
          rw [completion.envs_state truth hreal]
    _ = truth := completion.state_truth truth hreal

/--
The corrected direct product observer plus realized-truth completion data
constructs the public finite-truth-quotient main-math core.
-/
noncomputable def toFiniteTruthQuotientInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (completion :
      BerardDirectProductObserverRealizedTruthCompletionForHeader header) :
    NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
      header := by
  classical
  let TruthAtom := RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  let Realized : TruthAtom -> Prop :=
    fun truth =>
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth
  refine
    { Q := { truth : TruthAtom // Realized truth }
      qFinite := ?_
      truthOf := fun q => q.1
      stateOfRealizedTruth := fun truth hreal => ⟨truth, hreal⟩
      state_truth_eq := ?_
      envsOf := fun q => completion.envsOfRealizedTruth q.1 q.2
      envs_bound := ?_
      envs_realizes := ?_
      envs_nonempty := ?_
      rawEpochState_invariant := completion.rawEpochState_invariant
      receiptOrder_invariant := completion.receiptOrder_invariant
      coherentHistoryNonempty := completion.coherentHistoryNonempty }
  · letI : Fintype TruthAtom :=
      regularTestTruthAtomFintype (stabilizedSaturationBasis header.cert)
    infer_instance
  · intro truth hreal
    rfl
  · intro q
    exact completion.envs_bound q.1 q.2
  · intro q
    exact completion.envs_realizes q.1 q.2
  · intro q
    exact completion.envs_nonempty q.1 q.2

/--
Adding the standard concrete-fringe backend to the direct-product completion
gives the named no-direct restricted DPA certificate.
-/
noncomputable def toNoDirectReversalRestrictedCertificate
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (completion :
      BerardDirectProductObserverRealizedTruthCompletionForHeader header)
    (backend :
      NoDirectDPAJournalBoundedLocalConcreteFringeCompilerBackendForHeader
        header.toCurrentOrderHeader.toHeader) :
    NoDirectDPAJournalNoDirectReversalRestrictedCertificate In₁ In₂ Out₁ Out₂ A
    where
  header := header
  mainMath := completion.toFiniteTruthQuotientInvariantCore
  backend := backend

/--
End-to-end DPA-level consequence of the direct-product completion route.
-/
noncomputable def toNoDirectDPASynthesisDecidable
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (completion :
      BerardDirectProductObserverRealizedTruthCompletionForHeader header)
    (backend :
      NoDirectDPAJournalBoundedLocalConcreteFringeCompilerBackendForHeader
        header.toCurrentOrderHeader.toHeader) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  noDirectDPASynthesisDecidable_ofNoDirectReversalRestrictedCertificate
    A (completion.toNoDirectReversalRestrictedCertificate backend)

/--
Extract the empty-safe realized-truth representative table from the older
direct-product completion.  The older nonempty and coherent-history fields are
not used by this handoff.
-/
noncomputable def toRealizedTruthRepresentativeData
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (completion :
      BerardDirectProductObserverRealizedTruthCompletionForHeader header) :
    NoDirectDPAJournalBoundedLocalRealizedTruthRepresentativeDataForActualTruthAutomatonParityCurrentOrderHeader
      header where
  envsOfRealizedTruth := completion.envsOfRealizedTruth
  envs_bound := completion.envs_bound
  envs_realizes := completion.envs_realizes

/--
Compatibility projection from the older bounded realized-truth completion to
the new empty-safe invariant-data boundary.  The older nonempty and
coherent-history fields are ignored; the automaton invariant is definitional
for the actual-truth header.
-/
noncomputable def toRealizedTruthClosureInvariantData
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (completion :
      BerardDirectProductObserverRealizedTruthCompletionForHeader header) :
    NoDirectDPAJournalBoundedLocalRealizedTruthClosureInvariantDataForActualTruthAutomatonParityCurrentOrderHeader
      header where
  representatives := completion.toRealizedTruthRepresentativeData
  closureInvariants :=
    { rawEpochState_invariant := by
        intro hdet hpred hboundary hcont h h' htruth
        exact
          completion.rawEpochState_invariant hdet hpred hboundary hcont
            h h' htruth
      automatonOfHistory_invariant := by
        intro _hcont h h' htruth
        change
          header.automatonOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h)) =
            header.automatonOfTruth
              (regularTestTruthVector (stabilizedSaturationBasis header.cert)
                (pathOfHistoryByRound header.edgeOfRound h'))
        exact congrArg header.automatonOfTruth htruth }
  receiptOrder_invariant := completion.receiptOrder_invariant

end BerardDirectProductObserverRealizedTruthCompletionForHeader

/--
Any all-history actual-truth invariant core already contains enough data for
the public finite-truth quotient: choose, for each realized truth atom, one
history realizing it and use the core's generated representative for that
history.
-/
noncomputable def finiteTruthQuotientInvariantCore_of_actualTruthInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
      header := by
  classical
  let TruthAtom := RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  let actualTruth : History In₁ In₂ Graph Out₁ Out₂ -> TruthAtom :=
    fun h =>
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound h)
  let Realized : TruthAtom -> Prop :=
    fun truth =>
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth
  let selectedHistory : { truth : TruthAtom // Realized truth } ->
      History In₁ In₂ Graph Out₁ Out₂ :=
    fun q => Classical.choose q.2
  refine
    { Q := { truth : TruthAtom // Realized truth }
      qFinite := ?_
      truthOf := fun q => q.1
      stateOfRealizedTruth := fun truth hreal => ⟨truth, hreal⟩
      state_truth_eq := ?_
      envsOf := fun q => core.envsOfHistory (selectedHistory q)
      envs_bound := ?_
      envs_realizes := ?_
      envs_nonempty := ?_
      rawEpochState_invariant := core.rawEpochState_invariant
      receiptOrder_invariant := core.receiptOrder_invariant
      coherentHistoryNonempty := core.coherentHistoryNonempty }
  · letI : Fintype TruthAtom :=
      regularTestTruthAtomFintype (stabilizedSaturationBasis header.cert)
    infer_instance
  · intro truth hreal
    rfl
  · intro q
    exact core.envs_bound (selectedHistory q)
  · intro q
    have hselected : actualTruth (selectedHistory q) = q.1 := by
      simpa [selectedHistory, Realized, actualTruth] using Classical.choose_spec q.2
    calc
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound
            (executionPrefixFromList header.σ
              (core.envsOfHistory (selectedHistory q)))) =
          actualTruth (selectedHistory q) := by
            exact core.envs_actualTruth (selectedHistory q)
      _ = q.1 := hselected
  · intro q
    exact core.envs_nonempty (selectedHistory q)

namespace NoDirectDPAJournalBoundedLocalActualTruthInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader

/-- Method-form of `finiteTruthQuotientInvariantCore_of_actualTruthInvariantCore`. -/
noncomputable def toFiniteTruthQuotientInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
      header :=
  finiteTruthQuotientInvariantCore_of_actualTruthInvariantCore core

end NoDirectDPAJournalBoundedLocalActualTruthInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader

namespace BerardDirectProductObserverConstructionForHeader

/--
A direct product observer plus a finite-truth-quotient invariant core gives the
new realized-truth completion object.  The selected state for a realized truth is
the observer state reached by the quotient representative.
-/
noncomputable def completionOfFiniteTruthQuotientInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer :
      BerardDirectProductObserverConstructionForHeader header)
    (core :
      NoDirectDPAJournalBoundedLocalFiniteTruthQuotientInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    BerardDirectProductObserverRealizedTruthCompletionForHeader header where
  observer := observer
  envsOfRealizedTruth := fun truth hreal =>
    core.envsOf (core.stateOfRealizedTruth truth hreal)
  stateOfRealizedTruth := fun truth hreal =>
    observer.stateOfGenerated
      (core.envsOf (core.stateOfRealizedTruth truth hreal))
  envs_state := by
    intro truth hreal
    rfl
  state_truth := by
    intro truth hreal
    calc
      observer.truthOfState
          (observer.stateOfGenerated
            (core.envsOf (core.stateOfRealizedTruth truth hreal))) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound
              (executionPrefixFromList header.σ
                (core.envsOf (core.stateOfRealizedTruth truth hreal)))) :=
          observer.generated_truth (core.envsOf (core.stateOfRealizedTruth truth hreal))
      _ = core.truthOf (core.stateOfRealizedTruth truth hreal) :=
          core.envs_realizes (core.stateOfRealizedTruth truth hreal)
      _ = truth := core.state_truth_eq truth hreal
  envs_bound := by
    intro truth hreal
    exact core.envs_bound (core.stateOfRealizedTruth truth hreal)
  envs_nonempty := by
    intro truth hreal
    exact core.envs_nonempty (core.stateOfRealizedTruth truth hreal)
  rawEpochState_invariant := core.rawEpochState_invariant
  receiptOrder_invariant := core.receiptOrder_invariant
  coherentHistoryNonempty := core.coherentHistoryNonempty

/--
A direct product observer plus an all-history invariant core gives the
realized-truth completion, via finite choice over realized truth atoms.
-/
noncomputable def completionOfActualTruthInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer :
      BerardDirectProductObserverConstructionForHeader header)
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    BerardDirectProductObserverRealizedTruthCompletionForHeader header :=
  observer.completionOfFiniteTruthQuotientInvariantCore
    core.toFiniteTruthQuotientInvariantCore

end BerardDirectProductObserverConstructionForHeader

/--
Bounded representative property for generated no-direct observations.

Every reachable observation has some generated representative of length at
most `header.generationBound`.
-/
def BerardGeneratedObservationBoundedRepresentatives
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) : Prop :=
  ∀ envs : List (EnvironmentRound In₁ In₂),
    ∃ rep : List (EnvironmentRound In₁ In₂),
      berardNoDirectGeneratedObservation header rep =
        berardNoDirectGeneratedObservation header envs ∧
      rep.length ≤ header.generationBound

/--
The finite transition on observation states obtained by choosing one generated
representative for a reachable state and appending the next environment round.
-/
noncomputable def berardGeneratedObservationStepFromRepresentative
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) :
    BerardNoDirectGeneratedObservationState header ->
      EnvironmentRound In₁ In₂ ->
      BerardNoDirectGeneratedObservationState header :=
  fun state env => by
    classical
    exact
      if h :
          ∃ envs : List (EnvironmentRound In₁ In₂),
            berardNoDirectGeneratedObservation header envs = state then
        berardNoDirectGeneratedObservation header (Classical.choose h ++ [env])
      else
        state

theorem berardGeneratedObservationStepFromRepresentative_snoc
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (hright : BerardGeneratedObservationRightCongruent header) :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      berardNoDirectGeneratedObservation header (envs ++ [env]) =
        berardGeneratedObservationStepFromRepresentative header
          (berardNoDirectGeneratedObservation header envs) env := by
  classical
  intro envs env
  let reachable :
      ∃ envs' : List (EnvironmentRound In₁ In₂),
        berardNoDirectGeneratedObservation header envs' =
          berardNoDirectGeneratedObservation header envs :=
    ⟨envs, rfl⟩
  dsimp [berardGeneratedObservationStepFromRepresentative]
  rw [dif_pos reachable]
  have hchosen := Classical.choose_spec reachable
  exact (hright (Classical.choose reachable) envs env hchosen).symm

theorem boundedReachableObservation_of_boundedRepresentatives
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (hbounded : BerardGeneratedObservationBoundedRepresentatives header) :
    ∀ s : BerardNoDirectGeneratedObservationState header,
      (∃ envs : List (EnvironmentRound In₁ In₂),
        berardNoDirectGeneratedObservation header envs = s) ->
      ∃ envs : List (EnvironmentRound In₁ In₂),
        berardNoDirectGeneratedObservation header envs = s ∧
          envs.length ≤ header.generationBound := by
  intro s hs
  rcases hs with ⟨envs, hstate⟩
  rcases hbounded envs with ⟨rep, hrep, hbound⟩
  exact ⟨rep, hrep.trans hstate, hbound⟩

/--
The bounded-representative field follows from right-congruence once the
generation bound dominates the finite observation-state space.
-/
theorem boundedRepresentatives_of_rightCongruent_cardBound
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (hright : BerardGeneratedObservationRightCongruent header)
    (hcardBound :
      Fintype.card (BerardNoDirectGeneratedObservationState header) ≤
        header.generationBound) :
    BerardGeneratedObservationBoundedRepresentatives header := by
  intro envs
  rcases boundedRepresentatives_of_rightCongruent_card
      (berardNoDirectGeneratedObservation header) hright envs with
    ⟨rep, hrep, hrep_bound⟩
  exact ⟨rep, hrep, le_trans hrep_bound hcardBound⟩

/--
The no-direct assembly theorem's exact hypotheses.

The finite Bérard controllers must first be assembled into a finite controller
realizing `header.σ`.  Then the product monitor must prove that the generated
observation tuple has a finite right-congruent transition and bounded reachable
representatives.  These are precisely the pieces needed to build the reachable
observer payload.
-/
structure BerardNoDirectControllerAssemblyForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  controller : FiniteControllerGeneratesHeaderStrategy header
  observationStep :
    BerardNoDirectGeneratedObservationState header ->
      EnvironmentRound In₁ In₂ ->
      BerardNoDirectGeneratedObservationState header
  observation_snoc :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      berardNoDirectGeneratedObservation header (envs ++ [env]) =
        observationStep (berardNoDirectGeneratedObservation header envs) env
  bounded_reachable_observation :
    ∀ s : BerardNoDirectGeneratedObservationState header,
      (∃ envs : List (EnvironmentRound In₁ In₂),
        berardNoDirectGeneratedObservation header envs = s) ->
      ∃ envs : List (EnvironmentRound In₁ In₂),
        berardNoDirectGeneratedObservation header envs = s ∧
          envs.length ≤ header.generationBound
  outputRealizer : Prop
  outputRealizer_proof : outputRealizer

namespace BerardNoDirectControllerAssemblyForHeader

/--
Checked no-direct assembly theorem.

Once the Bérard controllers have been shown to generate `header.σ`, and once
the product monitor has supplied right-congruence, bounded representatives, and
the receipt/order monitor equations, Lean constructs the reachable observer
payload with no further mathematical assumptions.
-/
noncomputable def toReachableObserverConstruction
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly : BerardNoDirectControllerAssemblyForHeader header) :
    ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader
      header where
  State := ULift.{max u v x y aut} (BerardNoDirectGeneratedObservationState header)
  stateFinite := by
    classical
    letI :
        Fintype
          (RegularTestTruthAtom (stabilizedSaturationBasis header.cert)) :=
      regularTestTruthAtomFintype (stabilizedSaturationBasis header.cert)
    letI :
        Fintype
          (EpochRotatingAccessState
            header.toCurrentOrderHeader.toHeader.importedUniform.boundary
            (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
            (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two)) :=
      Classical.choice
        (noDirectEpochTransformer_rotating_state_finite
          header.toCurrentOrderHeader.toHeader.importedUniform)
    letI : Fintype header.AState := header.aStateFinite
    infer_instance
  stateOfGenerated := fun envs => ULift.up (berardNoDirectGeneratedObservation header envs)
  initialState := ULift.up (berardNoDirectGeneratedObservation header [])
  initial_state := rfl
  step := fun s env => ULift.up (assembly.observationStep s.down env)
  state_snoc := by
    intro envs env
    exact congrArg ULift.up (assembly.observation_snoc envs env)
  truthOfState := fun s => s.down.1
  epochOfState := fun s => s.down.2.1
  automatonOfState := fun s => s.down.2.2.1
  receiptOfState := fun s => s.down.2.2.2
  generated_truth := by
    intro envs
    rfl
  generated_epoch := by
    intro envs
    rfl
  generated_automaton := by
    intro envs
    rfl
  generated_receipt := by
    intro envs
    rfl
  bounded_reachable_state := by
    intro s hs
    have hsDown :
        ∃ envs : List (EnvironmentRound In₁ In₂),
          berardNoDirectGeneratedObservation header envs = s.down := by
      rcases hs with ⟨envs, henvs⟩
      exact ⟨envs, congrArg ULift.down henvs⟩
    rcases assembly.bounded_reachable_observation s.down hsDown with
      ⟨envs, hstate, hbound⟩
    exact ⟨envs, by exact congrArg ULift.up hstate, hbound⟩
  outputRealizer := assembly.outputRealizer
  outputRealizer_proof := assembly.outputRealizer_proof

/-- The same assembly also supplies the corrected direct-product observer. -/
noncomputable def toDirectProductObserverConstruction
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly : BerardNoDirectControllerAssemblyForHeader header) :
    BerardDirectProductObserverConstructionForHeader header :=
  assembly.toReachableObserverConstruction.toDirectProductObserverConstruction

end BerardNoDirectControllerAssemblyForHeader

/--
Round-aware finite-controller form of the no-direct assembly theorem.

This is closer to the output one expects from the external Bérard construction:
first assemble the one-directional block controllers into a round-aware
controller for the no-direct epoch transformer; prove that it matches
`header.σ` on generated prefixes; then prove that the product observation
monitor is right-congruent and has bounded reachable representatives.
-/
structure BerardNoDirectRoundAwareControllerAssemblyForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  controller :
    FiniteEpochTransformer.RoundAwareControllerCode
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer
  controller_matches :
    FiniteControllerGeneratesHeaderStrategy.RoundAwareControllerMatchesHeaderStrategyOnGeneratedPrefixes
      header controller
  observationStep :
    BerardNoDirectGeneratedObservationState header ->
      EnvironmentRound In₁ In₂ ->
      BerardNoDirectGeneratedObservationState header
  observation_snoc :
    ∀ (envs : List (EnvironmentRound In₁ In₂)) (env : EnvironmentRound In₁ In₂),
      berardNoDirectGeneratedObservation header (envs ++ [env]) =
        observationStep (berardNoDirectGeneratedObservation header envs) env
  bounded_reachable_observation :
    ∀ s : BerardNoDirectGeneratedObservationState header,
      (∃ envs : List (EnvironmentRound In₁ In₂),
        berardNoDirectGeneratedObservation header envs = s) ->
      ∃ envs : List (EnvironmentRound In₁ In₂),
        berardNoDirectGeneratedObservation header envs = s ∧
          envs.length ≤ header.generationBound
  outputRealizer : Prop
  outputRealizer_proof : outputRealizer

namespace BerardNoDirectRoundAwareControllerAssemblyForHeader

/--
Checked conversion from the round-aware controller assembly to the generic
finite-controller assembly.
-/
noncomputable def toControllerAssembly
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly : BerardNoDirectRoundAwareControllerAssemblyForHeader header) :
    BerardNoDirectControllerAssemblyForHeader header where
  controller :=
    FiniteControllerGeneratesHeaderStrategy.ofRoundAwareController
      header assembly.controller assembly.controller_matches
  observationStep := assembly.observationStep
  observation_snoc := assembly.observation_snoc
  bounded_reachable_observation := assembly.bounded_reachable_observation
  outputRealizer := assembly.outputRealizer
  outputRealizer_proof := assembly.outputRealizer_proof

/--
Round-aware assembly theorem: once the external construction supplies the
matching controller and monitor obligations, Lean constructs the reachable
observer payload.
-/
noncomputable def toReachableObserverConstruction
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly : BerardNoDirectRoundAwareControllerAssemblyForHeader header) :
  ReachableNoDirectBerardFiniteControllerObserverConstructionForActualTruthAutomatonParityCurrentOrderHeader
      header :=
  assembly.toControllerAssembly.toReachableObserverConstruction

/-- The round-aware assembly also supplies the corrected direct-product observer. -/
noncomputable def toDirectProductObserverConstruction
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly : BerardNoDirectRoundAwareControllerAssemblyForHeader header) :
    BerardDirectProductObserverConstructionForHeader header :=
  assembly.toReachableObserverConstruction.toDirectProductObserverConstruction

end BerardNoDirectRoundAwareControllerAssemblyForHeader

/--
Finite-memory package form of the no-direct Bérard construction.

Compared with `BerardNoDirectRoundAwareControllerAssemblyForHeader`, this is
the mathematical package one proves from the Bérard construction: a
round-aware controller that matches the generated strategy, right-congruence
of the generated observation tuple, and bounded generated representatives.
The actual finite transition is constructed below by choosing representatives.
-/
structure BerardNoDirectFiniteMemoryPackageForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  controller :
    FiniteEpochTransformer.RoundAwareControllerCode
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer
