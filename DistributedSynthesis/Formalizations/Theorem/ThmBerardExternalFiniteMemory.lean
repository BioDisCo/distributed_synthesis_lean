/--
Seed-surjectivity for realized stabilized truth atoms.

This is the genuinely all-history representative part separated from the
raw-epoch/receipt determinacy fields.  It says that every stabilized truth atom
realized by some history has a nonempty environment word generated by the fixed
strategy `header.σ` with the same atom.
-/
structure BerardRealizedTruthSeedSurjectivityForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfRealizedTruth :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth ->
        List (EnvironmentRound In₁ In₂)
  envs_realizes :
    ∀ (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
      (hreal :
        StabilizedSaturationBasisNoDirectRealizedTruthAtom
          header.cert (pathOfHistoryByRound header.edgeOfRound) truth),
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (envsOfRealizedTruth truth hreal))) =
        truth
  envs_nonempty :
    ∀ (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
      (hreal :
        StabilizedSaturationBasisNoDirectRealizedTruthAtom
          header.cert (pathOfHistoryByRound header.edgeOfRound) truth),
      envsOfRealizedTruth truth hreal ≠ []

/--
All-history truth determinacy needed by the no-direct handoff.

This isolates the hidden-bit part from seed-surjectivity: equal stabilized truth
must determine the raw no-direct epoch state and the current receipt/order data.
-/
structure BerardActualTruthDeterminacyForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  rawEpochState_invariant :
    header.cert.determinesPathData ->
    header.cert.predecessorClosed ->
    (∀ boundaryState, header.cert.boundaryClosed boundaryState) ->
    header.cert.continuationClosed ->
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h') ->
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h'
  receiptOrder_invariant :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h')
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

/--
Empty-safe coverage of realized stabilized truth atoms.

This is the representative half of the sharp invariant route.  Unlike
`BerardRealizedTruthSeedSurjectivityForHeader`, it does not require the chosen
generated representatives to be nonempty.
-/
structure BerardRealizedTruthCoverageForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  envsOfRealizedTruth :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth ->
        List (EnvironmentRound In₁ In₂)
  envs_realizes :
    ∀ (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
      (hreal :
        StabilizedSaturationBasisNoDirectRealizedTruthAtom
          header.cert (pathOfHistoryByRound header.edgeOfRound) truth),
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
        (pathOfHistoryByRound header.edgeOfRound
          (executionPrefixFromList header.σ
            (envsOfRealizedTruth truth hreal))) =
        truth

/--
Empty-safe truth determinacy for the closure-invariant route.

Unlike `BerardActualTruthDeterminacyForHeader`, this record does not include a
global coherent-history nonemptiness field.
-/
structure BerardActualTruthClosureDeterminacyForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
