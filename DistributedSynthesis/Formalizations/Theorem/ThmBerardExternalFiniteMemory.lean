/-!
# External Bérard finite-memory payloads

This module derives finite-memory and synthesis consequences from explicit
external payloads: reachable observer payloads and representative-complete
finite-cover payloads. The payload assumptions are part of the theorem
statements. The module also provides finite encodings of bounded local
histories for these constructions.
-/

namespace DistributedSynthesis

universe u v x y aut ap fg fg2 br lab tr

/--
Finite code for lists whose length is known to be bounded by `N`.

The Bérard label construction naturally manipulates finite local summaries, but
the older lambda interface represents histories as lists.  On the reachable
part of a finite controller those lists are uniformly bounded, so this code is
the finite carrier used to turn bounded list histories into genuine finite
summary types.
-/
abbrev BoundedListCode (α : Type u) (N : Nat) :=
  Fin N -> Option α

namespace BoundedListCode

/-- Encode a list by its entries below the ambient bound. -/
def encode (N : Nat) (xs : List α) : BoundedListCode α N :=
  fun i => xs[i.1]?

/--
The bounded-list code is injective on lists of length at most `N`.

This is the exact technical fact needed when finite lambda summaries are
implemented by bounded history lists: equality of the finite code implies
equality of the original list, hence the old finite-lambda local-observability
lemmas can still be applied.
-/
theorem encode_injective_of_length_le
    {N : Nat} {xs ys : List α}
    (hxs : xs.length ≤ N) (hys : ys.length ≤ N)
    (hcode : encode N xs = encode N ys) :
    xs = ys := by
  apply List.ext_getElem?'
  intro n hn
  have hmax : max xs.length ys.length ≤ N := Nat.max_le.mpr ⟨hxs, hys⟩
  have hnN : n < N := lt_of_lt_of_le hn hmax
  simpa [encode] using congrFun hcode ⟨n, hnN⟩

end BoundedListCode

namespace DPAToFiniteGameCompilation

/--
Lift only the finite-game universe of a DPA finite-game compilation.

The realizability equivalence is transported through the generic finite-game
universe lift.  This is bookkeeping needed when a reusable backend compiler
produces a smaller finite-game carrier than a downstream certificate interface
expects.
-/
noncomputable def liftFiniteGame
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (comp : DPAToFiniteGameCompilation.{u, v, x, y, fg, aut} Out₂ A) :
    DPAToFiniteGameCompilation.{u, v, x, y, max fg fg2, aut} Out₂ A where
  finiteGame := FiniteDynamicHierarchyParityGame.lift comp.finiteGame
  realizabilityEquivalent :=
    (FiniteDynamicHierarchyParityGame.lift_realizable_iff
      (game := comp.finiteGame)).trans comp.realizabilityEquivalent

end DPAToFiniteGameCompilation

namespace DPAFiniteGameCompiler

/--
Combine separate actual and rejected branch-prefix local-view hypotheses into
the disjunction-shaped premise consumed by the branch-prefix backend wrappers.
-/
theorem branchPrefixViews_of_actualAndRejected
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    (uniform :
      ∀ _A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        UniformOneDirectionalFiniteIndexLemma.{max u v x y, u, v, x, y, max u v x y}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary :
      ∀ A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        (uniform A).boundary)
    (viewOne :
      ∀ A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        FiniteEpochTransformer.GameState
            ((uniform A).noDirectEpochTransformer) ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      ∀ A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        FiniteEpochTransformer.GameState
            ((uniform A).noDirectEpochTransformer) ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (actualPrefixViews :
      ∀ A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ controller :
          ((uniform A).noDirectEpochTransformer).RoundAwareLocalControllerCode
            (viewOne A) (viewTwo A),
          ∀ env : EnvironmentSequence In₁ In₂,
            ∀ n : Nat,
              let σ :=
                FiniteEpochTransformer.strategyOfRoundAwareLocalController
                  ((uniform A).noDirectEpochTransformer)
                  (viewOne A) (viewTwo A) controller defaultOne defaultTwo
              let state :=
                (uniform A).noDirectEpochStateAfterHistory (initialBoundary A)
                  (FiniteEpochTransformer.wordPrefix (execution σ env) n)
              viewOne A state (env n) =
                  nextView Proc.one (executionPrefix σ env n) (env n) ∧
                viewTwo A state (env n) =
                  nextView Proc.two (executionPrefix σ env n) (env n))
    (rejectedPrefixViews :
      ∀ A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ controller :
          ((uniform A).noDirectEpochTransformer).RoundAwareLocalControllerCode
            (viewOne A) (viewTwo A),
          ∀ (env : EnvironmentSequence In₁ In₂)
            (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
            let σ :=
              FiniteEpochTransformer.strategyOfRoundAwareLocalController
                ((uniform A).noDirectEpochTransformer)
                (viewOne A) (viewTwo A) controller defaultOne defaultTwo
            FiniteEpochTransformer.RoundAwareLocalControllerCompatibleDecodedExecution
              ((uniform A).noDirectEpochTransformer) (viewOne A) (viewTwo A)
              controller σ env word ->
            ¬ A.Accepts word ->
              ∀ n : Nat,
                let state :=
                  (uniform A).noDirectEpochStateAfterHistory (initialBoundary A)
                    (FiniteEpochTransformer.wordPrefix word n)
                viewOne A state (env n) =
                    nextView Proc.one (executionPrefix σ env n) (env n) ∧
                  viewTwo A state (env n) =
                    nextView Proc.two (executionPrefix σ env n) (env n)) :
    ∀ A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      ∀ controller :
        ((uniform A).noDirectEpochTransformer).RoundAwareLocalControllerCode
          (viewOne A) (viewTwo A),
        ∀ (env : EnvironmentSequence In₁ In₂)
          (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          word =
              execution
                (FiniteEpochTransformer.strategyOfRoundAwareLocalController
                  ((uniform A).noDirectEpochTransformer)
                  (viewOne A) (viewTwo A) controller defaultOne defaultTwo)
                env ∨
            (FiniteEpochTransformer.RoundAwareLocalControllerCompatibleDecodedExecution
                ((uniform A).noDirectEpochTransformer) (viewOne A) (viewTwo A)
                controller
                (FiniteEpochTransformer.strategyOfRoundAwareLocalController
                  ((uniform A).noDirectEpochTransformer)
                  (viewOne A) (viewTwo A) controller defaultOne defaultTwo)
                env word ∧
              ¬ A.Accepts word) ->
            ∀ n : Nat,
              let state :=
                (uniform A).noDirectEpochStateAfterHistory (initialBoundary A)
                  (FiniteEpochTransformer.wordPrefix word n)
              viewOne A state (env n) =
                  nextView Proc.one
                    (executionPrefix
                      (FiniteEpochTransformer.strategyOfRoundAwareLocalController
                        ((uniform A).noDirectEpochTransformer)
                        (viewOne A) (viewTwo A) controller defaultOne defaultTwo)
                      env n)
                    (env n) ∧
                viewTwo A state (env n) =
                  nextView Proc.two
                    (executionPrefix
                      (FiniteEpochTransformer.strategyOfRoundAwareLocalController
                        ((uniform A).noDirectEpochTransformer)
                        (viewOne A) (viewTwo A) controller defaultOne defaultTwo)
                      env n)
                    (env n) := by
  intro A controller env word hbranch n
  let σ :=
    FiniteEpochTransformer.strategyOfRoundAwareLocalController
      ((uniform A).noDirectEpochTransformer)
      (viewOne A) (viewTwo A) controller defaultOne defaultTwo
  rcases hbranch with hactual | hrej
  · subst word
    simpa [σ] using actualPrefixViews A controller env n
  · rcases hrej with ⟨hcompatible, hreject⟩
    simpa [σ] using
      rejectedPrefixViews A controller env word hcompatible hreject n

/--
Variant of `branchPrefixViews_of_actualAndRejected` for callers whose actual
branch is stated on the concrete no-direct state stream rather than on
`wordPrefix (execution σ env)`.

This only transports the actual-view hypothesis across
`FiniteEpochTransformer.wordPrefix_execution`; the rejected prefix-view premise
is still assumed unchanged.
-/
theorem branchPrefixViews_of_stateStreamActualAndRejected
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    (uniform :
      ∀ _A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        UniformOneDirectionalFiniteIndexLemma.{max u v x y, u, v, x, y, max u v x y}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary :
      ∀ A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        (uniform A).boundary)
    (viewOne :
      ∀ A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        FiniteEpochTransformer.GameState
            ((uniform A).noDirectEpochTransformer) ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      ∀ A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        FiniteEpochTransformer.GameState
            ((uniform A).noDirectEpochTransformer) ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (actualViews :
      ∀ A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ controller :
          ((uniform A).noDirectEpochTransformer).RoundAwareLocalControllerCode
            (viewOne A) (viewTwo A),
          ∀ env : EnvironmentSequence In₁ In₂,
            ∀ n : Nat,
              let σ :=
                FiniteEpochTransformer.strategyOfRoundAwareLocalController
                  ((uniform A).noDirectEpochTransformer)
                  (viewOne A) (viewTwo A) controller defaultOne defaultTwo
              viewOne A
                  ((uniform A).noDirectEpochStateStream (initialBoundary A)
                    σ env n)
                  (env n) =
                    nextView Proc.one (executionPrefix σ env n) (env n) ∧
                viewTwo A
                  ((uniform A).noDirectEpochStateStream (initialBoundary A)
                    σ env n)
                  (env n) =
                    nextView Proc.two (executionPrefix σ env n) (env n))
    (rejectedPrefixViews :
      ∀ A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        ∀ controller :
          ((uniform A).noDirectEpochTransformer).RoundAwareLocalControllerCode
            (viewOne A) (viewTwo A),
          ∀ (env : EnvironmentSequence In₁ In₂)
            (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
            let σ :=
              FiniteEpochTransformer.strategyOfRoundAwareLocalController
                ((uniform A).noDirectEpochTransformer)
                (viewOne A) (viewTwo A) controller defaultOne defaultTwo
            FiniteEpochTransformer.RoundAwareLocalControllerCompatibleDecodedExecution
              ((uniform A).noDirectEpochTransformer) (viewOne A) (viewTwo A)
              controller σ env word ->
            ¬ A.Accepts word ->
              ∀ n : Nat,
                let state :=
                  (uniform A).noDirectEpochStateAfterHistory (initialBoundary A)
                    (FiniteEpochTransformer.wordPrefix word n)
                viewOne A state (env n) =
                    nextView Proc.one (executionPrefix σ env n) (env n) ∧
                  viewTwo A state (env n) =
                    nextView Proc.two (executionPrefix σ env n) (env n)) :
    ∀ A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      ∀ controller :
        ((uniform A).noDirectEpochTransformer).RoundAwareLocalControllerCode
          (viewOne A) (viewTwo A),
        ∀ (env : EnvironmentSequence In₁ In₂)
          (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
          word =
              execution
                (FiniteEpochTransformer.strategyOfRoundAwareLocalController
                  ((uniform A).noDirectEpochTransformer)
                  (viewOne A) (viewTwo A) controller defaultOne defaultTwo)
                env ∨
            (FiniteEpochTransformer.RoundAwareLocalControllerCompatibleDecodedExecution
                ((uniform A).noDirectEpochTransformer) (viewOne A) (viewTwo A)
                controller
                (FiniteEpochTransformer.strategyOfRoundAwareLocalController
                  ((uniform A).noDirectEpochTransformer)
                  (viewOne A) (viewTwo A) controller defaultOne defaultTwo)
                env word ∧
              ¬ A.Accepts word) ->
            ∀ n : Nat,
              let state :=
                (uniform A).noDirectEpochStateAfterHistory (initialBoundary A)
                  (FiniteEpochTransformer.wordPrefix word n)
              viewOne A state (env n) =
                  nextView Proc.one
                    (executionPrefix
                      (FiniteEpochTransformer.strategyOfRoundAwareLocalController
                        ((uniform A).noDirectEpochTransformer)
                        (viewOne A) (viewTwo A) controller defaultOne defaultTwo)
                      env n)
                    (env n) ∧
                viewTwo A state (env n) =
                  nextView Proc.two
                    (executionPrefix
                      (FiniteEpochTransformer.strategyOfRoundAwareLocalController
                        ((uniform A).noDirectEpochTransformer)
                        (viewOne A) (viewTwo A) controller defaultOne defaultTwo)
                      env n)
                    (env n) :=
  branchPrefixViews_of_actualAndRejected
    uniform initialBoundary viewOne viewTwo defaultOne defaultTwo
    (fun A controller env =>
      FiniteEpochTransformer.noDirectEpochStateAfterHistory_actualPrefixViews_of_stateStreamActualViews
        (uniform A) (initialBoundary A) (viewOne A) (viewTwo A)
        (FiniteEpochTransformer.strategyOfRoundAwareLocalController
          ((uniform A).noDirectEpochTransformer)
          (viewOne A) (viewTwo A) controller defaultOne defaultTwo)
        env
        (fun n =>
          actualViews A controller env n))
    rejectedPrefixViews

/--
Lift only the finite-game universe of a uniform DPA finite-game compiler.
-/
noncomputable def liftFiniteGame
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    (compiler :
      DPAFiniteGameCompiler.{u, v, x, y, fg, aut} In₁ In₂ Out₁ Out₂) :
    DPAFiniteGameCompiler.{u, v, x, y, max fg fg2, aut} In₁ In₂ Out₁ Out₂ where
  compile := fun A => (compiler.compile A).liftFiniteGame

/--
Build the finite-game compiler required by the Bérard endpoint from the
paper-facing rotating-rational-run certificate family.

The rational-run backend naturally produces a smaller finite-game universe; the
last step lifts it to the universe expected by the strategy-reachable Bérard
certificate.
-/
noncomputable def ofRationalRunCertificatesForBerard
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (certificates :
      ∀ A : DetParityAutomaton.{max u v x y, aut}
          (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        RotatingRationalRunEpochBackendCertificate.{u, v, x, y, br, lab, tr} A) :
    DPAFiniteGameCompiler.{u, v, x, y, max (max (max (max u v) x) y) aut, aut}
      In₁ In₂ Out₁ Out₂ :=
  let base :=
    (DPARotatingRationalRunEpochCompiler.ofCertificates certificates)
      |>.toDPAFiniteGameCompiler
  { compile := fun A =>
      let comp := base.compile A
      { finiteGame :=
          FiniteDynamicHierarchyParityGame.lift.{max u v x y, max u v x y, aut, 0}
            comp.finiteGame
        realizabilityEquivalent :=
          (FiniteDynamicHierarchyParityGame.lift_realizable_iff.{max u v x y, max u v x y, aut, 0}
            (game := comp.finiteGame)).trans comp.realizabilityEquivalent } }

end DPAFiniteGameCompiler

/--
Operational synchronized-choice data for the rotating rational-run backend.

This is one step below the opaque per-DPA
`RotatingRationalRunEpochBackendCertificate` family: the caller supplies the
paper-facing rotating targets, the epoch transformer, language equivalence,
the hierarchy/parity facts, synchronized decoded state choices, and matching
finite controllers.  Lean derives the decoded soundness/completeness boundary
and hence the ordinary finite-game compiler.
-/
structure DPARotatingRationalRunSynchronizedBackendData
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂] where
  Branch :
    ∀ _A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      Proc -> Type br
  Label :
    ∀ _A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      Proc -> Type lab
  target :
    ∀ A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      (side : Proc) -> InputFreeParityTreeAutomaton.{br, lab, tr}
        (Branch A side) (Label A side)
  targetNonempty :
    ∀ A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      ∀ side : Proc,
        ∃ tree : LabeledTree (Branch A side) (Label A side),
          (target A side).acceptsTree tree
  transformer :
    ∀ _A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      FiniteEpochTransformer.{max u v x y, u, v, x, y, max u v x y}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂
  gameStateDecidable :
    ∀ A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      DecidableEq (FiniteEpochTransformer.GameState (transformer A))
  initialBoundary :
    ∀ A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      (transformer A).boundary
  automaton_equiv :
    ∀ A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      ∀ word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂),
        (transformer A).automaton.Accepts word ↔ A.Accepts word
  dynamicHierarchy :
    ∀ _A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      Prop
  parityObjective :
    ∀ _A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      Prop
  dynamicHierarchy_proof :
    ∀ A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      dynamicHierarchy A
  parityObjective_proof :
    ∀ A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      parityObjective A
  synchronizedChoices :
    ∀ A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      letI : DecidableEq (FiniteEpochTransformer.GameState (transformer A)) :=
        gameStateDecidable A
      ∀ controller : (transformer A).ControllerCode,
        ∀ (env : EnvironmentSequence In₁ In₂)
          (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)),
            FiniteEpochTransformer.CompatibleDecodedExecution
              (transformer A) (initialBoundary A) controller env word ->
            ∃ stateStream : Nat -> FiniteEpochTransformer.GameState (transformer A),
              FiniteEpochTransformer.CompatibleDecodedExecutionSynchronizedStateChoices
                (transformer A) (initialBoundary A) controller env word stateStream
  matchingControllers :
    ∀ A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      letI : DecidableEq (FiniteEpochTransformer.GameState (transformer A)) :=
        gameStateDecidable A
      FiniteEpochTransformer.GameExecutionStrategiesHaveMatchingControllers
        (transformer A) (initialBoundary A)

namespace DPARotatingRationalRunSynchronizedBackendData

/--
Construct the uniform rotating rational-run epoch compiler from operational
synchronized-choice backend data.
-/
noncomputable def toEpochCompiler
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (data :
      DPARotatingRationalRunSynchronizedBackendData In₁ In₂ Out₁ Out₂) :
    DPARotatingRationalRunEpochCompiler.{u, v, x, y, br, lab, tr, aut}
      In₁ In₂ Out₁ Out₂ :=
  DPARotatingRationalRunEpochCompiler.ofSynchronizedStateChoicesAndMatchingControllers
    data.Branch data.Label data.target data.targetNonempty
    data.transformer data.gameStateDecidable data.initialBoundary
    data.automaton_equiv data.dynamicHierarchy data.parityObjective
    data.dynamicHierarchy_proof data.parityObjective_proof
    data.synchronizedChoices data.matchingControllers

/--
The operational synchronized-choice data yields the per-objective rotating
rational-run certificate family used by older theorem endpoints.
-/
noncomputable def toCertificates
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (data :
      DPARotatingRationalRunSynchronizedBackendData In₁ In₂ Out₁ Out₂) :
    ∀ A : DetParityAutomaton.{max u v x y, aut}
        (RoundRecord In₁ In₂ Graph Out₁ Out₂),
      RotatingRationalRunEpochBackendCertificate.{u, v, x, y, br, lab, tr} A :=
  (data.toEpochCompiler).compile

/--
Construct the Bérard finite-game compiler from operational synchronized-choice
rational-run backend data, rather than from an opaque certificate family.
-/
noncomputable def toDPAFiniteGameCompilerForBerard
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (data :
      DPARotatingRationalRunSynchronizedBackendData In₁ In₂ Out₁ Out₂) :
    DPAFiniteGameCompiler.{u, v, x, y, max (max (max (max u v) x) y) aut, aut}
      In₁ In₂ Out₁ Out₂ :=
  DPAFiniteGameCompiler.ofRationalRunCertificatesForBerard
    data.toCertificates

end DPARotatingRationalRunSynchronizedBackendData

namespace DPARoundAwareLambdaRotatingRationalRunEpochCompiler

/--
Construct the Bérard finite-game compiler from the paper-facing round-aware
lambda rotating rational-run backend.

This keeps the theorem boundary below an opaque `DPAFiniteGameCompiler`: the
finite game comes from the lambda-local rotating backend, then is lifted to the
finite-game universe expected by the strategy-reachable Bérard certificate.
-/
noncomputable def toDPAFiniteGameCompilerForBerard
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    [Inhabited In₁]
    [Inhabited In₂]
    [Fintype In₁]
    [Fintype In₂]
    [Fintype Out₁]
    [Fintype Out₂]
    (compiler :
      DPARoundAwareLambdaRotatingRationalRunEpochCompiler.{u, v, x, y, br, lab, tr, aut}
        In₁ In₂ Out₁ Out₂) :
    DPAFiniteGameCompiler.{u, v, x, y, max (max (max (max u v) x) y) aut, aut}
      In₁ In₂ Out₁ Out₂ :=
  let base := compiler.toDPAFiniteGameCompiler
  { compile := fun A =>
      let comp := base.compile A
      { finiteGame :=
          FiniteDynamicHierarchyParityGame.lift.{max u v x y, max u v x y, aut, 0}
            comp.finiteGame
        realizabilityEquivalent :=
