/--
A round-aware finite controller that matches `header.σ` on every generated
prefix is a finite controller generating the header strategy.
-/
noncomputable def ofRoundAwareController
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (controller :
      FiniteEpochTransformer.RoundAwareControllerCode
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer)
    (hmatch :
      RoundAwareControllerMatchesHeaderStrategyOnGeneratedPrefixes
        header controller) :
    FiniteControllerGeneratesHeaderStrategy header where
  Control :=
    ULift.{max u v x y aut}
      (FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer)
  controlFinite := by
    classical
    letI :
        Fintype
          (FiniteEpochTransformer.GameState
            header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer) :=
      Classical.choice
        (noDirectEpochTransformer_rotating_state_finite
          header.toCurrentOrderHeader.toHeader.importedUniform)
    infer_instance
  initial := ULift.up (Sum.inl header.initialBoundary)
  step := fun state env =>
    ULift.up
      (FiniteEpochTransformer.roundAwareGameTransition
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer
        controller state.down env)
  output := fun state env => controller state.down env
  controlOfGenerated := fun envs =>
    ULift.up (roundAwareControlOfGenerated header controller envs)
  control_nil := rfl
  control_snoc := by
    intro envs env
    exact congrArg ULift.up
      (roundAwareControlOfGenerated_snoc header controller envs env)
  output_correct := by
    intro envs env
    exact hmatch envs env

end FiniteControllerGeneratesHeaderStrategy

/--
Finite observation state used by the reachable no-direct assembly theorem.

It is exactly the theorem-facing monitor tuple: stabilized truth, raw no-direct
epoch state, actual-truth automaton state, and current receipt/order data.
-/
abbrev BerardNoDirectGeneratedObservationState
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) :=
  RegularTestTruthAtom (stabilizedSaturationBasis header.cert) ×
    EpochRotatingAccessState
      header.toCurrentOrderHeader.toHeader.importedUniform.boundary
      (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
      (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two) ×
    header.AState ×
    ReceiptOrderData

noncomputable instance berardNoDirectGeneratedObservationStateFintype
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) :
    Fintype (BerardNoDirectGeneratedObservationState header) := by
  classical
  letI :
      Fintype
        (RegularTestTruthAtom (stabilizedSaturationBasis header.cert)) :=
    regularTestTruthAtomFintype (stabilizedSaturationBasis header.cert)
  letI :
      Fintype
        (EpochRotatingAccessState
          header.toCurrentOrderHeader.toHeader.importedUniform.boundary
          (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.one)
          (header.toCurrentOrderHeader.toHeader.importedUniform.summary Proc.two)) :=
    Classical.choice
      (noDirectEpochTransformer_rotating_state_finite
        header.toCurrentOrderHeader.toHeader.importedUniform)
  letI : Fintype header.AState := header.aStateFinite
  infer_instance

/-- The theorem-facing observation tuple of a generated prefix. -/
noncomputable def berardNoDirectGeneratedObservation
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A)
    (envs : List (EnvironmentRound In₁ In₂)) :
    BerardNoDirectGeneratedObservationState header :=
  let h := executionPrefixFromList header.σ envs
  let truth :=
    regularTestTruthVector (stabilizedSaturationBasis header.cert)
      (pathOfHistoryByRound header.edgeOfRound h)
  ( truth
  , header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
      header.initialBoundary h
  , header.automatonOfTruth truth
  , currentReceiptOrderData h (historyCurrentContainmentOrder h) )

/--
Right-congruence of the generated no-direct observation tuple.

This is the core finite-memory invariant: once two generated prefixes have the
same theorem-facing observation, appending the same next environment round
keeps the observations equal.
-/
def BerardGeneratedObservationRightCongruent
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) : Prop :=
  ∀ (envs envs' : List (EnvironmentRound In₁ In₂))
    (env : EnvironmentRound In₁ In₂),
    berardNoDirectGeneratedObservation header envs =
      berardNoDirectGeneratedObservation header envs' ->
    berardNoDirectGeneratedObservation header (envs ++ [env]) =
      berardNoDirectGeneratedObservation header (envs' ++ [env])

/--
Equal current local views imply equal next local views for the same environment
round.  This is the small deterministic bridge needed before applying
`nextRound_eq_of_nextView_eq`.
-/
theorem nextView_eq_of_currentViews_eq
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    (p : Proc)
    {h h' : History In₁ In₂ Graph Out₁ Out₂}
    (env : EnvironmentRound In₁ In₂)
    (hviews :
      (currentView Proc.one h, currentView Proc.two h) =
        (currentView Proc.one h', currentView Proc.two h')) :
    nextView p h env = nextView p h' env := by
  have hpair : viewPair h = viewPair h' := by
    simpa [currentView] using hviews
  cases p <;> simpa [nextView, hpair]

/--
The exact low-level facts needed to prove right-congruence of the generated
observation tuple.

These are the mathematically substantive obligations of the external no-direct
Bérard construction:

* stabilized truth determines the current pair of local views;
* stabilized truth is preserved by appending the same generated round;
* stabilized truth determines the current receipt/order payload.

The no-direct raw epoch component is not a separate assumption: once the
generated round is the same, it follows from the checked epoch-transition
lemma.
-/
structure BerardGeneratedObservationRightCongruenceCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  currentViews_determined :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      (currentView Proc.one h, currentView Proc.two h) =
        (currentView Proc.one h', currentView Proc.two h')
  truth_append_congruent :
    ∀ (h h' : History In₁ In₂ Graph Out₁ Out₂)
      (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound (History.append h r)) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound (History.append h' r))
  receipt_eq_of_truth_eq :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h')

/--
Plain path-level append-congruence for a stabilized certificate.

This is the theorem one would need from the saturation/Bérard backend if the
right-congruence core were to be derived from `header.cert` itself.
-/
def StabilizedSaturationBasisPathAppendCongruent
    {Alphabet : Type u} {EdgeType : Type v} {Boundary : Type x}
    {In₁ : Type y} {In₂ : Type aut}
    {sat :
      RegularTestSaturation.{u, v, x, y, aut, max u v x y aut}
        Alphabet EdgeType Boundary In₁ In₂}
    {n : Nat}
    (cert : StabilizedSaturationBasisCertificate sat n) : Prop :=
  ∀ (path path' : TypedPath EdgeType) (edge : EdgeType),
    StabilizedSaturationBasisPathEquivalent cert path path' ->
      StabilizedSaturationBasisPathEquivalent cert
        (path ++ [edge]) (path' ++ [edge])

/--
Path-level append-congruence gives the truth-vector append law used by the
generated-observation observer.

This theorem is only a bridge from an explicit append-congruence assumption; it
does not claim that the current saturation certificate interface implies that
assumption.
-/
theorem truthAppendCongruent_of_pathAppendCongruent
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (happend : StabilizedSaturationBasisPathAppendCongruent header.cert) :
    ∀ (h h' : History In₁ In₂ Graph Out₁ Out₂)
      (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound (History.append h r)) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound (History.append h' r)) := by
  intro h h' r htruth
  have hpath :
      StabilizedSaturationBasisPathEquivalent header.cert
        (pathOfHistoryByRound header.edgeOfRound h)
        (pathOfHistoryByRound header.edgeOfRound h') :=
    stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth
  have hpathAppend :=
    happend
      (pathOfHistoryByRound header.edgeOfRound h)
      (pathOfHistoryByRound header.edgeOfRound h')
      (header.edgeOfRound r)
      hpath
  exact
    stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent
      (by
        simpa [pathOfHistoryByRound, History.append] using hpathAppend)

namespace BerardGeneratedObservationRightCongruenceCore

/--
Build the generated-observation right-congruence core from the currently
smallest checked factors.

The current-view core supplies truth-determinacy of current views.  The
truth-factor blockwise core supplies receipt/order determinacy through its
truth-indexed receipt decoder.  The only remaining field is append-congruence
of the stabilized truth vector for appending the same generated round.
-/
def ofCurrentViewsTruthFactorAndAppendTruth
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (viewCore :
      NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsCoreForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (truthCore :
      NoDirectDPAJournalBoundedLocalTruthFactorBlockwiseCoreForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (truth_append_congruent :
      ∀ (h h' : History In₁ In₂ Graph Out₁ Out₂)
        (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h') ->
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound (History.append h r)) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound (History.append h' r))) :
    BerardGeneratedObservationRightCongruenceCore header where
  currentViews_determined := viewCore.currentViews_determined
  truth_append_congruent := truth_append_congruent
  receipt_eq_of_truth_eq := by
    intro h h' htruth
    calc
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
          truthCore.receiptOrderOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h)) :=
            truthCore.receiptOrder_factor h
      _ =
          truthCore.receiptOrderOfTruth
            (regularTestTruthVector (stabilizedSaturationBasis header.cert)
              (pathOfHistoryByRound header.edgeOfRound h')) := by
            rw [htruth]
      _ =
          currentReceiptOrderData h' (historyCurrentContainmentOrder h') :=
            (truthCore.receiptOrder_factor h').symm

/--
Factorized-current-view version of
`ofCurrentViewsTruthFactorAndAppendTruth`.
-/
def ofCurrentViewsFactorTruthFactorAndAppendTruth
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (viewCore :
      NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsFactorCoreForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (truthCore :
      NoDirectDPAJournalBoundedLocalTruthFactorBlockwiseCoreForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (truth_append_congruent :
      ∀ (h h' : History In₁ In₂ Graph Out₁ Out₂)
        (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h') ->
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound (History.append h r)) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound (History.append h' r))) :
    BerardGeneratedObservationRightCongruenceCore header :=
  ofCurrentViewsTruthFactorAndAppendTruth
    viewCore.toCurrentViewsCore truthCore truth_append_congruent

/--
Version of `ofCurrentViewsTruthFactorAndAppendTruth` that consumes the named
path-level append-congruence obligation.
-/
def ofCurrentViewsTruthFactorAndPathAppendCongruent
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (viewCore :
      NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsCoreForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (truthCore :
      NoDirectDPAJournalBoundedLocalTruthFactorBlockwiseCoreForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (happend : StabilizedSaturationBasisPathAppendCongruent header.cert) :
    BerardGeneratedObservationRightCongruenceCore header :=
  ofCurrentViewsTruthFactorAndAppendTruth viewCore truthCore
    (truthAppendCongruent_of_pathAppendCongruent happend)

/--
Factorized-current-view version consuming the named path-level
append-congruence obligation.
-/
def ofCurrentViewsFactorTruthFactorAndPathAppendCongruent
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (viewCore :
      NoDirectDPAJournalBoundedLocalActualTruthClosureCurrentViewsFactorCoreForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (truthCore :
      NoDirectDPAJournalBoundedLocalTruthFactorBlockwiseCoreForActualTruthAutomatonParityCurrentOrderHeader
        header)
    (happend : StabilizedSaturationBasisPathAppendCongruent header.cert) :
    BerardGeneratedObservationRightCongruenceCore header :=
  ofCurrentViewsFactorTruthFactorAndAppendTruth viewCore truthCore
    (truthAppendCongruent_of_pathAppendCongruent happend)

/--
Checked observer right-congruence theorem from the concrete low-level
Bérard/no-direct obligations.

If two generated prefixes have the same product observation, the truth
component determines equal current views.  Therefore the same environment
round produces the same generated round record.  Truth append-congruence gives
the next truth atom, the checked no-direct epoch-transition lemma gives the
next raw epoch state, and receipt/order determinacy gives the next receipt
payload.  The automaton component is a function of the next truth atom.
-/
theorem observation_rightCongruent
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core : BerardGeneratedObservationRightCongruenceCore header) :
    BerardGeneratedObservationRightCongruent header := by
  intro envs envs' env hobs
  let h : History In₁ In₂ Graph Out₁ Out₂ :=
    executionPrefixFromList header.σ envs
  let h' : History In₁ In₂ Graph Out₁ Out₂ :=
    executionPrefixFromList header.σ envs'
  let r : RoundRecord In₁ In₂ Graph Out₁ Out₂ :=
    nextRound header.σ h env
  let r' : RoundRecord In₁ In₂ Graph Out₁ Out₂ :=
    nextRound header.σ h' env
  have htruth :
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') := by
    simpa [berardNoDirectGeneratedObservation, h, h'] using
      congrArg Prod.fst hobs
  have hepoch :
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary h =
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary h' := by
    simpa [berardNoDirectGeneratedObservation, h, h'] using
      congrArg (fun s => s.2.1) hobs
  have hviews := core.currentViews_determined h h' htruth
  have hnextOne :
      nextView Proc.one h env = nextView Proc.one h' env :=
    nextView_eq_of_currentViews_eq Proc.one env hviews
  have hnextTwo :
      nextView Proc.two h env = nextView Proc.two h' env :=
    nextView_eq_of_currentViews_eq Proc.two env hviews
  have hround : r = r' := by
    dsimp [r, r']
    exact nextRound_eq_of_nextView_eq header.σ hnextOne hnextTwo
  have htruthNextSame :
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound (History.append h r)) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound (History.append h' r)) :=
    core.truth_append_congruent h h' r htruth
  have htruthNext :
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound (History.append h r)) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound (History.append h' r')) := by
    simpa [hround] using htruthNextSame
  have hepochNextSame :
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (History.append h r) =
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (History.append h' r) := by
    calc
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (History.append h r)
          =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateTransition
            (header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
              header.initialBoundary h) r := by
            rw [
              UniformOneDirectionalFiniteIndexLemma.noDirectEpochStateAfterHistory_append_round]
      _ =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateTransition
            (header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
              header.initialBoundary h') r := by
            rw [hepoch]
      _ =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary (History.append h' r) := by
            rw [
              UniformOneDirectionalFiniteIndexLemma.noDirectEpochStateAfterHistory_append_round]
  have hepochNext :
      header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (History.append h r) =
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (History.append h' r') := by
    simpa [hround] using hepochNextSame
  have hreceiptNext :
      currentReceiptOrderData (History.append h r)
          (historyCurrentContainmentOrder (History.append h r)) =
        currentReceiptOrderData (History.append h' r')
          (historyCurrentContainmentOrder (History.append h' r')) :=
    core.receipt_eq_of_truth_eq (History.append h r) (History.append h' r')
      htruthNext
  have hprod :
      ( regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound (History.append h r))
      , header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (History.append h r)
      , header.automatonOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound (History.append h r)))
      , currentReceiptOrderData (History.append h r)
          (historyCurrentContainmentOrder (History.append h r)) )
      =
      ( regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound (History.append h' r'))
      , header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
          header.initialBoundary (History.append h' r')
      , header.automatonOfTruth
          (regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound (History.append h' r')))
      , currentReceiptOrderData (History.append h' r')
          (historyCurrentContainmentOrder (History.append h' r')) ) :=
    Prod.ext htruthNext
      (Prod.ext hepochNext
        (Prod.ext (congrArg header.automatonOfTruth htruthNext) hreceiptNext))
  simpa [berardNoDirectGeneratedObservation, executionPrefixFromList_snoc,
    h, h', r, r'] using hprod

end BerardGeneratedObservationRightCongruenceCore

/--
Path-equivalence form of the right-congruence core.

This is the standard semantic formulation expected from a finite-memory
regular-test construction: equality in the stabilized path quotient determines
the current views and receipt/order payload, and is stable when the same typed
round is appended.
-/
structure BerardGeneratedObservationPathRightCongruenceCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  currentViews_determined :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      StabilizedSaturationBasisPathEquivalent header.cert
        (pathOfHistoryByRound header.edgeOfRound h)
        (pathOfHistoryByRound header.edgeOfRound h') ->
      (currentView Proc.one h, currentView Proc.two h) =
        (currentView Proc.one h', currentView Proc.two h')
  path_append_congruent :
    ∀ (h h' : History In₁ In₂ Graph Out₁ Out₂)
      (r : RoundRecord In₁ In₂ Graph Out₁ Out₂),
      StabilizedSaturationBasisPathEquivalent header.cert
        (pathOfHistoryByRound header.edgeOfRound h)
        (pathOfHistoryByRound header.edgeOfRound h') ->
      StabilizedSaturationBasisPathEquivalent header.cert
        (pathOfHistoryByRound header.edgeOfRound (History.append h r))
        (pathOfHistoryByRound header.edgeOfRound (History.append h' r))
  receipt_eq_of_pathEquivalent :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
