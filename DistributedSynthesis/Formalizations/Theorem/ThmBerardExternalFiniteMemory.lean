end StrategyReachableNoDirectFiniteRetractionForHeader

/--
Header-level local-lambda reachable payload.

This is the exact remaining Bérard construction target before the ordinary DPA
finite-game compiler is plugged in: construct the raw generated observer, prove
which generated states are non-initial handoff states, and provide the concrete
finite local-lambda bridge.
-/
structure BerardLocalLambdaReachablePayloadForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  observer : BerardDirectProductObserverRawConstructionForHeader header
  HandoffState : observer.ProductState -> Prop
  handoff_ne_initial :
    ∀ s : observer.ProductState, HandoffState s -> s ≠ observer.initialState
  localLambda : BerardLocalLambdaBridgeForRawObserver observer

namespace BerardLocalLambdaReachablePayloadForHeader

/--
The local-lambda reachable payload contains a genuine finite controller that
generates the strategy stored in the header.  The controller state is the raw
product-observer state and its output table is the locally factored lambda
output table from the bridge.
-/
noncomputable def toFiniteControllerGeneratesHeaderStrategy
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header) :
    FiniteControllerGeneratesHeaderStrategy header where
  Control := payload.observer.ProductState
  controlFinite := payload.observer.productFinite
  initial := payload.observer.initialState
  step := payload.observer.step
  output := fun state env =>
    (payload.localLambda.outputOne state env,
      payload.localLambda.outputTwo state env)
  controlOfGenerated := payload.observer.stateOfGenerated
  control_nil := payload.observer.initial_state
  control_snoc := payload.observer.state_snoc
  output_correct := payload.localLambda.output_generated_correct

/--
Concrete finite carrier used by the theorem-facing Bérard counterexample
reflection.

The first component is the generated product-observer state.  The second
component is the real DPA run state.  Pairing in the DPA state avoids relying
on the auxiliary `header.AState` monitor as the actual automaton state.
-/
abbrev GeneratedDPAFiniteCarrierState
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header) :
    Type (max u v x y aut) :=
  payload.observer.ProductState × A.State

/-- Initial state of the concrete Bérard/DPA finite carrier. -/
def generatedDPAFiniteCarrierInitial
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header) :
    GeneratedDPAFiniteCarrierState payload :=
  (payload.observer.initialState, A.initial)

/--
Finite-carrier emission.  The local-lambda bridge supplies the finite output
tables; the current environment round supplies the input/graph components.
-/
def generatedDPAFiniteCarrierEmit
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header) :
    GeneratedDPAFiniteCarrierState payload ->
      EnvironmentRound In₁ In₂ ->
        RoundRecord In₁ In₂ Graph Out₁ Out₂ :=
  fun state env =>
    { inputOne := env.inputOne
      inputTwo := env.inputTwo
      graph := env.graph
      outputOne := payload.localLambda.outputOne state.1 env
      outputTwo := payload.localLambda.outputTwo state.1 env }

/--
Concrete carrier transition: advance the product observer by the environment
round and advance the DPA state by the emitted round.
-/
def generatedDPAFiniteCarrierStep
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header) :
    GeneratedDPAFiniteCarrierState payload ->
      EnvironmentRound In₁ In₂ ->
        GeneratedDPAFiniteCarrierState payload :=
  fun state env =>
    (payload.observer.step state.1 env,
      A.step state.2 (generatedDPAFiniteCarrierEmit payload state env))

/--
The generated source stream over the concrete Bérard/DPA carrier for an
environment sequence.
-/
def generatedDPAFiniteCarrierStateStream
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (env : EnvironmentSequence In₁ In₂) :
    Nat -> GeneratedDPAFiniteCarrierState payload :=
  fun n =>
    (payload.observer.stateOfGenerated
      (FiniteControllerGeneratesHeaderStrategy.environmentPrefixList env n),
      A.run (execution header.σ env) n)

theorem generatedDPAFiniteCarrierStateStream_zero
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (env : EnvironmentSequence In₁ In₂) :
    generatedDPAFiniteCarrierStateStream payload env 0 =
      generatedDPAFiniteCarrierInitial payload := by
  ext <;>
    simp [generatedDPAFiniteCarrierStateStream,
      generatedDPAFiniteCarrierInitial, payload.observer.initial_state]

/--
On generated states, the finite-carrier emission is exactly the real execution
round of the header strategy.
-/
theorem generatedDPAFiniteCarrierEmit_stateStream_eq_execution
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (env : EnvironmentSequence In₁ In₂)
    (n : Nat) :
    generatedDPAFiniteCarrierEmit payload
        (generatedDPAFiniteCarrierStateStream payload env n) (env n) =
      execution header.σ env n := by
  rw [execution_apply]
  let envs := FiniteControllerGeneratesHeaderStrategy.environmentPrefixList env n
  have hprefix :
      executionPrefixFromList header.σ envs =
        executionPrefix header.σ env n := by
    simpa [envs] using
      FiniteControllerGeneratesHeaderStrategy.executionPrefixFromList_environmentPrefixList
        header.σ env n
  have hout := payload.localLambda.output_generated_correct envs (env n)
  have houtOne := congrArg Prod.fst hout
  have houtTwo := congrArg Prod.snd hout
  cases henv : env n with
  | mk inputOne inputTwo graph =>
      have houtOneRecord :
          payload.localLambda.outputOne
              (payload.observer.stateOfGenerated envs)
              { inputOne := inputOne, inputTwo := inputTwo, graph := graph } =
            header.σ.one
              (nextView Proc.one (executionPrefix header.σ env n)
                { inputOne := inputOne, inputTwo := inputTwo, graph := graph }) := by
        simpa [nextRound, hprefix, henv] using houtOne
      have houtTwoRecord :
          payload.localLambda.outputTwo
              (payload.observer.stateOfGenerated envs)
              { inputOne := inputOne, inputTwo := inputTwo, graph := graph } =
            header.σ.two
              (nextView Proc.two (executionPrefix header.σ env n)
                { inputOne := inputOne, inputTwo := inputTwo, graph := graph }) := by
        simpa [nextRound, hprefix, henv] using houtTwo
      simp [generatedDPAFiniteCarrierEmit,
        generatedDPAFiniteCarrierStateStream, envs, nextRound, henv,
        hprefix, houtOneRecord, houtTwoRecord]

theorem generatedDPAFiniteCarrierStateStream_succ
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (env : EnvironmentSequence In₁ In₂)
    (n : Nat) :
    generatedDPAFiniteCarrierStateStream payload env (n + 1) =
      generatedDPAFiniteCarrierStep payload
        (generatedDPAFiniteCarrierStateStream payload env n) (env n) := by
  ext
  · simp [generatedDPAFiniteCarrierStateStream,
      generatedDPAFiniteCarrierStep, payload.observer.state_snoc]
  · change
      A.run (execution header.σ env) (n + 1) =
        A.step (A.run (execution header.σ env) n)
          (generatedDPAFiniteCarrierEmit payload
            (generatedDPAFiniteCarrierStateStream payload env n) (env n))
    rw [A.run_succ,
      generatedDPAFiniteCarrierEmit_stateStream_eq_execution payload env n]

theorem generatedDPAFiniteCarrierWord_eq_execution
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (env : EnvironmentSequence In₁ In₂) :
    FiniteEpochTransformer.finiteCarrierWord
        (generatedDPAFiniteCarrierEmit payload)
        (generatedDPAFiniteCarrierStateStream payload env) env =
      execution header.σ env := by
  funext n
  simpa [FiniteEpochTransformer.finiteCarrierWord] using
    generatedDPAFiniteCarrierEmit_stateStream_eq_execution payload env n

theorem generatedDPAFiniteCarrierDPAInit
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (env : EnvironmentSequence In₁ In₂) :
    (generatedDPAFiniteCarrierStateStream payload env 0).2 = A.initial := by
  simp [generatedDPAFiniteCarrierStateStream]

theorem generatedDPAFiniteCarrierDPAStep
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (env : EnvironmentSequence In₁ In₂) :
    ∀ n : Nat,
      (generatedDPAFiniteCarrierStateStream payload env (n + 1)).2 =
        A.step
          (generatedDPAFiniteCarrierStateStream payload env n).2
          (FiniteEpochTransformer.finiteCarrierWord
            (generatedDPAFiniteCarrierEmit payload)
            (generatedDPAFiniteCarrierStateStream payload env) env n) := by
  intro n
  change
    A.run (execution header.σ env) (n + 1) =
      A.step (A.run (execution header.σ env) n)
        (generatedDPAFiniteCarrierEmit payload
          (generatedDPAFiniteCarrierStateStream payload env n) (env n))
  rw [A.run_succ,
    generatedDPAFiniteCarrierEmit_stateStream_eq_execution payload env n]

/--
Rejected header executions reflect to rejected memoryless environment codes over
the concrete non-stuttering Bérard/DPA finite carrier.

This is the first theorem-facing instantiation of the generic `Q` backend:
there is no raw `GameState` stutter and no external lasso certificate.
-/
theorem exists_finiteCarrierCode_rejected_playWord_of_rejected_headerExecution
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (env : EnvironmentSequence In₁ In₂)
    (hreject : ¬ A.Accepts (execution header.σ env)) :
    ∃ code :
        GeneratedDPAFiniteCarrierState payload -> EnvironmentRound In₁ In₂,
      ¬ A.Accepts
        (FiniteEpochTransformer.finiteCarrierPlayWord
          (generatedDPAFiniteCarrierInitial payload)
          (generatedDPAFiniteCarrierStep payload)
          (generatedDPAFiniteCarrierEmit payload) code) := by
  classical
  letI : Fintype payload.observer.ProductState := payload.observer.productFinite
  letI : Fintype A.State := A.stateFinite
  have hword :
      FiniteEpochTransformer.finiteCarrierWord
          (generatedDPAFiniteCarrierEmit payload)
          (generatedDPAFiniteCarrierStateStream payload env) env =
        execution header.σ env :=
    generatedDPAFiniteCarrierWord_eq_execution payload env
  have hrejectWord :
      ¬ A.Accepts
        (FiniteEpochTransformer.finiteCarrierWord
          (generatedDPAFiniteCarrierEmit payload)
          (generatedDPAFiniteCarrierStateStream payload env) env) := by
    intro hacc
    exact hreject (by simpa [hword] using hacc)
  exact
    FiniteEpochTransformer.exists_finiteCarrierCode_rejected_playWord_of_rejected_dpaProgress_stateStream
      (generatedDPAFiniteCarrierInitial payload)
      (generatedDPAFiniteCarrierStep payload)
      (generatedDPAFiniteCarrierEmit payload)
      A
      (generatedDPAFiniteCarrierStateStream payload env)
      env
      Prod.snd
      (generatedDPAFiniteCarrierStateStream_zero payload env)
      (generatedDPAFiniteCarrierStateStream_succ payload env)
      (generatedDPAFiniteCarrierDPAInit payload env)
      (generatedDPAFiniteCarrierDPAStep payload env)
      hrejectWord

/--
Rejected compatible decoded words for the generated-header-view local
controller reflect through the concrete Bérard/DPA carrier.

The compatibility predicate is first collapsed to the actual decoded execution;
the generated-prefix view theorem then identifies that execution with the
header strategy, so the generated-header carrier theorem applies.
-/
theorem exists_finiteCarrierCode_rejected_playWord_of_rejected_headerViewsCompatibleDecodedExecution
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (viewOne :
      FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.one)
    (viewTwo :
      FiniteEpochTransformer.GameState
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer ->
          EnvironmentRound In₁ In₂ -> View In₁ In₂ Proc.two)
    (hviews :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        viewOne
            (FiniteControllerGeneratesHeaderStrategy.roundAwareControlOfGenerated
              header
              (FiniteControllerGeneratesHeaderStrategy.roundAwareControllerOfHeaderStrategyViews
                header viewOne viewTwo)
              envs)
            env =
          nextView Proc.one (executionPrefixFromList header.σ envs) env ∧
        viewTwo
            (FiniteControllerGeneratesHeaderStrategy.roundAwareControlOfGenerated
              header
              (FiniteControllerGeneratesHeaderStrategy.roundAwareControllerOfHeaderStrategyViews
                header viewOne viewTwo)
              envs)
            env =
          nextView Proc.two (executionPrefixFromList header.σ envs) env)
    (defaultOne : Out₁)
    (defaultTwo : Out₂)
    (env : EnvironmentSequence In₁ In₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hcompatible :
      FiniteEpochTransformer.RoundAwareLocalControllerCompatibleDecodedExecution
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer
        viewOne viewTwo
        (FiniteControllerGeneratesHeaderStrategy.roundAwareLocalControllerOfHeaderStrategyViews
          header viewOne viewTwo)
        (FiniteEpochTransformer.strategyOfRoundAwareLocalController
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer
          viewOne viewTwo
          (FiniteControllerGeneratesHeaderStrategy.roundAwareLocalControllerOfHeaderStrategyViews
            header viewOne viewTwo)
          defaultOne defaultTwo)
        env word)
    (hreject : ¬ A.Accepts word) :
    ∃ code :
        GeneratedDPAFiniteCarrierState payload -> EnvironmentRound In₁ In₂,
      ¬ A.Accepts
        (FiniteEpochTransformer.finiteCarrierPlayWord
          (generatedDPAFiniteCarrierInitial payload)
          (generatedDPAFiniteCarrierStep payload)
          (generatedDPAFiniteCarrierEmit payload) code) := by
  let T :=
    header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer
  let controller :=
    FiniteControllerGeneratesHeaderStrategy.roundAwareLocalControllerOfHeaderStrategyViews
      header viewOne viewTwo
  let σ :=
    FiniteEpochTransformer.strategyOfRoundAwareLocalController
      T viewOne viewTwo controller defaultOne defaultTwo
  have hwordStrategy : word = execution σ env := by
    simpa [T, controller, σ] using
      FiniteEpochTransformer.roundAwareLocalControllerCompatibleDecodedExecution_eq_execution_strategyOf
        T viewOne viewTwo controller defaultOne defaultTwo env word
        (by simpa [T, controller, σ] using hcompatible)
  have hexec : execution σ env = execution header.σ env := by
    simpa [T, controller, σ] using
      FiniteControllerGeneratesHeaderStrategy.execution_strategyOf_roundAwareLocalControllerOfHeaderStrategyViews
        header viewOne viewTwo hviews defaultOne defaultTwo env
  have hwordHeader : word = execution header.σ env := by
    rw [hwordStrategy, hexec]
  have hrejectHeader : ¬ A.Accepts (execution header.σ env) := by
    intro hacc
    exact hreject (by simpa [hwordHeader] using hacc)
  exact
    exists_finiteCarrierCode_rejected_playWord_of_rejected_headerExecution
      payload env hrejectHeader

/--
Canonical product-observer source stream for an arbitrary word: run the
generated observer on the finite prefix of decoded environment rounds of the
word.
-/
def wordSourceObserverState
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)) :
    Nat -> payload.observer.ProductState :=
  fun n =>
    payload.observer.stateOfGenerated
      (FiniteControllerGeneratesHeaderStrategy.environmentPrefixList
        ((fun k => FiniteEpochTransformer.environmentRoundOfWord word k) :
          EnvironmentSequence In₁ In₂) n)

@[simp]
theorem wordSourceObserverState_zero
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)) :
    wordSourceObserverState payload word 0 = payload.observer.initialState := by
  simp [wordSourceObserverState, payload.observer.initial_state]

theorem wordSourceObserverState_succ
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (n : Nat) :
    wordSourceObserverState payload word (n + 1) =
      payload.observer.step (wordSourceObserverState payload word n)
        (FiniteEpochTransformer.environmentRoundOfWord word n) := by
  simp [wordSourceObserverState, payload.observer.state_snoc]

/--
Rejected words reflect to rejected memoryless environment codes over the same
concrete Bérard/DPA carrier, once the rejected word has been equipped with a
coherent product-observer source stream.

This is the compatible-word bridge shape: the remaining decoded-branch work is
exactly to construct `sourceObserverState` from compatible decoded prefixes and
prove the initial/step/emission equations below.
-/
theorem exists_finiteCarrierCode_rejected_playWord_of_rejected_wordCarrierStream
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (sourceObserverState : Nat -> payload.observer.ProductState)
    (hsourceObserverInit :
      sourceObserverState 0 = payload.observer.initialState)
    (hsourceObserverStep :
      ∀ n : Nat,
        sourceObserverState (n + 1) =
          payload.observer.step (sourceObserverState n)
            (FiniteEpochTransformer.environmentRoundOfWord word n))
    (hemit :
      ∀ n : Nat,
        generatedDPAFiniteCarrierEmit payload
            (sourceObserverState n, A.run word n)
            (FiniteEpochTransformer.environmentRoundOfWord word n) =
          word n)
    (hreject : ¬ A.Accepts word) :
    ∃ code :
        GeneratedDPAFiniteCarrierState payload -> EnvironmentRound In₁ In₂,
      ¬ A.Accepts
        (FiniteEpochTransformer.finiteCarrierPlayWord
          (generatedDPAFiniteCarrierInitial payload)
          (generatedDPAFiniteCarrierStep payload)
          (generatedDPAFiniteCarrierEmit payload) code) := by
  classical
  letI : Fintype payload.observer.ProductState := payload.observer.productFinite
  letI : Fintype A.State := A.stateFinite
  let sourceMove : Nat -> EnvironmentRound In₁ In₂ :=
    fun n => FiniteEpochTransformer.environmentRoundOfWord word n
  let sourceState : Nat -> GeneratedDPAFiniteCarrierState payload :=
    fun n => (sourceObserverState n, A.run word n)
  have hsourceInit :
      sourceState 0 = generatedDPAFiniteCarrierInitial payload := by
    ext <;>
      simp [sourceState, generatedDPAFiniteCarrierInitial,
        hsourceObserverInit]
  have hsourceStep :
      ∀ n : Nat,
        sourceState (n + 1) =
          generatedDPAFiniteCarrierStep payload
            (sourceState n) (sourceMove n) := by
    intro n
    ext
    · simpa [sourceState, sourceMove, generatedDPAFiniteCarrierStep]
        using hsourceObserverStep n
    · change
        A.run word (n + 1) =
          A.step (A.run word n)
            (generatedDPAFiniteCarrierEmit payload
              (sourceObserverState n, A.run word n)
              (FiniteEpochTransformer.environmentRoundOfWord word n))
      rw [A.run_succ, hemit n]
  have hword :
      FiniteEpochTransformer.finiteCarrierWord
          (generatedDPAFiniteCarrierEmit payload) sourceState sourceMove =
        word := by
    funext n
    simpa [FiniteEpochTransformer.finiteCarrierWord, sourceState, sourceMove]
      using hemit n
  have hdpaSourceInit :
      Prod.snd (sourceState 0) = A.initial := by
    simp [sourceState]
  have hdpaSourceStep :
      ∀ n : Nat,
        Prod.snd (sourceState (n + 1)) =
          A.step (Prod.snd (sourceState n))
            (FiniteEpochTransformer.finiteCarrierWord
              (generatedDPAFiniteCarrierEmit payload) sourceState
              sourceMove n) := by
    intro n
    change
      A.run word (n + 1) =
        A.step (A.run word n)
          (generatedDPAFiniteCarrierEmit payload
            (sourceObserverState n, A.run word n)
            (FiniteEpochTransformer.environmentRoundOfWord word n))
    rw [A.run_succ, hemit n]
  have hrejectWord :
      ¬ A.Accepts
        (FiniteEpochTransformer.finiteCarrierWord
          (generatedDPAFiniteCarrierEmit payload) sourceState sourceMove) := by
    intro hacc
    exact hreject (by simpa [hword] using hacc)
  exact
    FiniteEpochTransformer.exists_finiteCarrierCode_rejected_playWord_of_rejected_dpaProgress_stateStream
      (generatedDPAFiniteCarrierInitial payload)
      (generatedDPAFiniteCarrierStep payload)
      (generatedDPAFiniteCarrierEmit payload)
      A
      sourceState
      sourceMove
      Prod.snd
      hsourceInit
      hsourceStep
      hdpaSourceInit
      hdpaSourceStep
      hrejectWord

/--
Canonical-prefix version of
`exists_finiteCarrierCode_rejected_playWord_of_rejected_wordCarrierStream`.

The product-observer initial and step equations are supplied by
`wordSourceObserverState`; the only remaining compatible-word work is the
per-round emission equality.
-/
theorem exists_finiteCarrierCode_rejected_playWord_of_rejected_wordPrefixCarrierStream
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hemit :
      ∀ n : Nat,
        generatedDPAFiniteCarrierEmit payload
            (wordSourceObserverState payload word n, A.run word n)
            (FiniteEpochTransformer.environmentRoundOfWord word n) =
          word n)
    (hreject : ¬ A.Accepts word) :
    ∃ code :
        GeneratedDPAFiniteCarrierState payload -> EnvironmentRound In₁ In₂,
      ¬ A.Accepts
        (FiniteEpochTransformer.finiteCarrierPlayWord
          (generatedDPAFiniteCarrierInitial payload)
          (generatedDPAFiniteCarrierStep payload)
          (generatedDPAFiniteCarrierEmit payload) code) :=
  exists_finiteCarrierCode_rejected_playWord_of_rejected_wordCarrierStream
    payload word (wordSourceObserverState payload word)
    (wordSourceObserverState_zero payload word)
    (wordSourceObserverState_succ payload word)
    hemit hreject

/--
Local-lambda emission bridge for the canonical word-prefix observer stream.

If, at round `n`, the canonical prefix observer has the same finite
process-local observations as the two witness states that generate `word n`,
then the concrete Bérard/DPA carrier emits exactly `word n`.
-/
theorem generatedDPAFiniteCarrierEmit_wordSourceObserverState_eq_of_localLambdaWitnesses
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (n : Nat)
    (stateOne stateTwo : payload.observer.ProductState)
    (hhistOne :
      payload.localLambda.histOne
          (wordSourceObserverState payload word n)
          (FiniteEpochTransformer.environmentRoundOfWord word n) =
        payload.localLambda.histOne stateOne
          (FiniteEpochTransformer.environmentRoundOfWord word n))
    (hfringeOne :
      payload.localLambda.fringeOne
          (wordSourceObserverState payload word n)
          (FiniteEpochTransformer.environmentRoundOfWord word n) =
        payload.localLambda.fringeOne stateOne
          (FiniteEpochTransformer.environmentRoundOfWord word n))
    (hhistTwo :
      payload.localLambda.histTwo
          (wordSourceObserverState payload word n)
          (FiniteEpochTransformer.environmentRoundOfWord word n) =
        payload.localLambda.histTwo stateTwo
          (FiniteEpochTransformer.environmentRoundOfWord word n))
    (hfringeTwo :
      payload.localLambda.fringeTwo
          (wordSourceObserverState payload word n)
          (FiniteEpochTransformer.environmentRoundOfWord word n) =
        payload.localLambda.fringeTwo stateTwo
          (FiniteEpochTransformer.environmentRoundOfWord word n))
    (hword :
      word n =
        { inputOne :=
            (FiniteEpochTransformer.environmentRoundOfWord word n).inputOne
          inputTwo :=
            (FiniteEpochTransformer.environmentRoundOfWord word n).inputTwo
          graph :=
            (FiniteEpochTransformer.environmentRoundOfWord word n).graph
          outputOne :=
            payload.localLambda.outputOne stateOne
              (FiniteEpochTransformer.environmentRoundOfWord word n)
          outputTwo :=
            payload.localLambda.outputTwo stateTwo
              (FiniteEpochTransformer.environmentRoundOfWord word n) }) :
    generatedDPAFiniteCarrierEmit payload
        (wordSourceObserverState payload word n, A.run word n)
        (FiniteEpochTransformer.environmentRoundOfWord word n) =
      word n := by
  let envRound := FiniteEpochTransformer.environmentRoundOfWord word n
  have houtOne :
      payload.localLambda.outputOne
          (wordSourceObserverState payload word n) envRound =
        payload.localLambda.outputOne stateOne envRound :=
    payload.localLambda.outputOne_local
      (wordSourceObserverState payload word n) envRound
      stateOne envRound hhistOne hfringeOne
  have houtTwo :
      payload.localLambda.outputTwo
          (wordSourceObserverState payload word n) envRound =
        payload.localLambda.outputTwo stateTwo envRound :=
    payload.localLambda.outputTwo_local
      (wordSourceObserverState payload word n) envRound
      stateTwo envRound hhistTwo hfringeTwo
  rw [hword]
  cases henv : FiniteEpochTransformer.environmentRoundOfWord word n with
  | mk inputOne inputTwo graph =>
      simpa [generatedDPAFiniteCarrierEmit, envRound, henv] using
        And.intro houtOne houtTwo

/--
The canonical prefix observer sees the finite local observations decoded from
the candidate word's own prefix.

This is the remaining synchronization statement needed to turn a
self-compatible local-lambda word into a concrete Bérard/DPA carrier emission
proof.
-/
def wordSourceObserverMatchesLocalViews
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)) : Prop :=
  ∀ n : Nat,
    let envRound := FiniteEpochTransformer.environmentRoundOfWord word n
    payload.localLambda.histOne
        (wordSourceObserverState payload word n) envRound =
          payload.localLambda.histOfViewOne
            (nextView Proc.one
              (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
      payload.localLambda.fringeOne
        (wordSourceObserverState payload word n) envRound =
          payload.localLambda.fringeOfViewOne
            (nextView Proc.one
              (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
      payload.localLambda.histTwo
        (wordSourceObserverState payload word n) envRound =
          payload.localLambda.histOfViewTwo
            (nextView Proc.two
              (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
      payload.localLambda.fringeTwo
        (wordSourceObserverState payload word n) envRound =
          payload.localLambda.fringeOfViewTwo
            (nextView Proc.two
              (FiniteEpochTransformer.wordPrefix word n) envRound)

/--
Self-compatible local-lambda word stated directly over the concrete Bérard
payload state space.

The two witness states may be different; they only have to supply the finite
local observations whose output table generates the current word round.
-/
def localLambdaSelfCompatibleWord
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂)) : Prop :=
  ∀ n : Nat,
    let envRound := FiniteEpochTransformer.environmentRoundOfWord word n
    ∃ stateOne : payload.observer.ProductState,
      payload.localLambda.histOne stateOne envRound =
          payload.localLambda.histOfViewOne
            (nextView Proc.one
              (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
        payload.localLambda.fringeOne stateOne envRound =
          payload.localLambda.fringeOfViewOne
            (nextView Proc.one
              (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
        ∃ stateTwo : payload.observer.ProductState,
          payload.localLambda.histTwo stateTwo envRound =
              payload.localLambda.histOfViewTwo
                (nextView Proc.two
                  (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
            payload.localLambda.fringeTwo stateTwo envRound =
              payload.localLambda.fringeOfViewTwo
                (nextView Proc.two
                  (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
            word n =
              { inputOne := envRound.inputOne
                inputTwo := envRound.inputTwo
                graph := envRound.graph
                outputOne := payload.localLambda.outputOne stateOne envRound
                outputTwo := payload.localLambda.outputTwo stateTwo envRound }

/--
Rejected canonical-prefix words reflect to rejected carrier codes once the
compatible-word output witnesses are synchronized with the canonical
product-observer local observations.
-/
theorem exists_finiteCarrierCode_rejected_playWord_of_rejected_wordPrefixCarrierStream_of_localLambdaWitnesses
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hwitness :
      ∀ n : Nat,
        ∃ stateOne : payload.observer.ProductState,
          payload.localLambda.histOne
              (wordSourceObserverState payload word n)
              (FiniteEpochTransformer.environmentRoundOfWord word n) =
            payload.localLambda.histOne stateOne
              (FiniteEpochTransformer.environmentRoundOfWord word n) ∧
          payload.localLambda.fringeOne
              (wordSourceObserverState payload word n)
              (FiniteEpochTransformer.environmentRoundOfWord word n) =
            payload.localLambda.fringeOne stateOne
              (FiniteEpochTransformer.environmentRoundOfWord word n) ∧
          ∃ stateTwo : payload.observer.ProductState,
            payload.localLambda.histTwo
                (wordSourceObserverState payload word n)
                (FiniteEpochTransformer.environmentRoundOfWord word n) =
              payload.localLambda.histTwo stateTwo
                (FiniteEpochTransformer.environmentRoundOfWord word n) ∧
            payload.localLambda.fringeTwo
                (wordSourceObserverState payload word n)
                (FiniteEpochTransformer.environmentRoundOfWord word n) =
              payload.localLambda.fringeTwo stateTwo
                (FiniteEpochTransformer.environmentRoundOfWord word n) ∧
            word n =
              { inputOne :=
                  (FiniteEpochTransformer.environmentRoundOfWord word n).inputOne
                inputTwo :=
                  (FiniteEpochTransformer.environmentRoundOfWord word n).inputTwo
                graph :=
                  (FiniteEpochTransformer.environmentRoundOfWord word n).graph
                outputOne :=
                  payload.localLambda.outputOne stateOne
                    (FiniteEpochTransformer.environmentRoundOfWord word n)
                outputTwo :=
                  payload.localLambda.outputTwo stateTwo
                    (FiniteEpochTransformer.environmentRoundOfWord word n) })
    (hreject : ¬ A.Accepts word) :
    ∃ code :
        GeneratedDPAFiniteCarrierState payload -> EnvironmentRound In₁ In₂,
      ¬ A.Accepts
        (FiniteEpochTransformer.finiteCarrierPlayWord
          (generatedDPAFiniteCarrierInitial payload)
          (generatedDPAFiniteCarrierStep payload)
          (generatedDPAFiniteCarrierEmit payload) code) := by
  refine
    exists_finiteCarrierCode_rejected_playWord_of_rejected_wordPrefixCarrierStream
      payload word ?_ hreject
  intro n
  rcases hwitness n with
    ⟨stateOne, hhistOne, hfringeOne,
      stateTwo, hhistTwo, hfringeTwo, hword⟩
  exact
    generatedDPAFiniteCarrierEmit_wordSourceObserverState_eq_of_localLambdaWitnesses
      payload word n stateOne stateTwo
      hhistOne hfringeOne hhistTwo hfringeTwo hword

/--
Payload-local self-compatibility plus canonical prefix-observer local-view
synchronization yields the rejected finite-carrier reflection.
-/
theorem exists_finiteCarrierCode_rejected_playWord_of_rejected_wordPrefixCarrierStream_of_localLambdaSelfCompatibleWord
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hsource :
      wordSourceObserverMatchesLocalViews payload word)
    (hcompatible :
      localLambdaSelfCompatibleWord payload word)
    (hreject : ¬ A.Accepts word) :
    ∃ code :
        GeneratedDPAFiniteCarrierState payload -> EnvironmentRound In₁ In₂,
      ¬ A.Accepts
        (FiniteEpochTransformer.finiteCarrierPlayWord
          (generatedDPAFiniteCarrierInitial payload)
          (generatedDPAFiniteCarrierStep payload)
          (generatedDPAFiniteCarrierEmit payload) code) := by
  refine
    exists_finiteCarrierCode_rejected_playWord_of_rejected_wordPrefixCarrierStream_of_localLambdaWitnesses
      payload word ?_ hreject
  intro n
  rcases hsource n with
    ⟨hsourceHistOne, hsourceFringeOne,
      hsourceHistTwo, hsourceFringeTwo⟩
  rcases hcompatible n with
    ⟨stateOne, hstateHistOne, hstateFringeOne,
      stateTwo, hstateHistTwo, hstateFringeTwo, hword⟩
  refine
    ⟨stateOne, ?_, ?_, stateTwo, ?_, ?_, hword⟩
  · exact hsourceHistOne.trans hstateHistOne.symm
  · exact hsourceFringeOne.trans hstateFringeOne.symm
  · exact hsourceHistTwo.trans hstateHistTwo.symm
  · exact hsourceFringeTwo.trans hstateFringeTwo.symm

/--
Assemble the theorem-facing strategy-reachable finite-memory object from the
local-lambda payload.
-/
noncomputable def toStrategyReachableFiniteRetraction
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header) :
    StrategyReachableNoDirectFiniteRetractionForHeader header :=
  StrategyReachableNoDirectFiniteRetractionForHeader.ofRawObserverAndLocalLambdaBridge
    payload.observer payload.HandoffState payload.handoff_ne_initial
    payload.localLambda

end BerardLocalLambdaReachablePayloadForHeader

/--
No-direct restricted certificate through the strategy-reachable finite
retraction.

This is the all-history-free theorem-facing endpoint.  The finite-memory field
is the generated product observer plus local-observation bridge.  The remaining
backend field is exactly the finite dynamic-hierarchy game and its
realizability equivalence for the DPA objective.
-/
structure NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCertificate
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  header :
    NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
      In₁ In₂ Out₁ Out₂ A
  finiteMemory :
    StrategyReachableNoDirectFiniteRetractionForHeader header
  finiteGame :
    FiniteDynamicHierarchyParityGame.{max u v x y aut, max u v x y}
  finiteGameRealizableIff :
    finiteGame.realizable ↔
      ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution σ env)

namespace NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCertificate

/--
Build the fixed-objective no-direct certificate from the local-lambda reachable
payload and one certified finite-game compilation for the objective at hand.
-/
noncomputable def ofLocalLambdaReachablePayloadAndDPAToFiniteGameCompilation
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (gameCompilation :
      DPAToFiniteGameCompilation.{u, v, x, y, max u v x y aut} Out₂ A) :
    NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCertificate
      In₁ In₂ Out₁ Out₂ A where
  header := header
  finiteMemory := payload.toStrategyReachableFiniteRetraction
  finiteGame := gameCompilation.finiteGame
  finiteGameRealizableIff := gameCompilation.realizabilityEquivalent

/--
Build the fixed-objective no-direct certificate from a raw observer bridge and
one certified finite-game compilation for the objective at hand.
-/
noncomputable def ofRawObserverAndLocalLambdaBridgeAndDPAToFiniteGameCompilation
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header)
    (HandoffState : observer.ProductState -> Prop)
    (handoff_ne_initial :
      ∀ s : observer.ProductState, HandoffState s -> s ≠ observer.initialState)
    (bridge : BerardLocalLambdaBridgeForRawObserver observer)
    (gameCompilation :
      DPAToFiniteGameCompilation.{u, v, x, y, max u v x y aut} Out₂ A) :
    NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCertificate
      In₁ In₂ Out₁ Out₂ A :=
  ofLocalLambdaReachablePayloadAndDPAToFiniteGameCompilation
    { observer := observer
      HandoffState := HandoffState
      handoff_ne_initial := handoff_ne_initial
      localLambda := bridge }
    gameCompilation

/--
View the strategy-reachable certificate as an effective parity specification.
This is the direct replacement for the old route through represented truth
payloads.
-/
noncomputable def toDPAEffectiveParitySpecification
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert :
      NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCertificate
        In₁ In₂ Out₁ Out₂ A) :
    EffectiveParitySpecification.{u, v, x, y, max u v x y aut, max u v x y}
      In₁ In₂ Out₁ Out₂ where
  predicate := dpaSpecification A
  finiteGame := cert.finiteGame
  realizabilityEquivalent := by
    simpa [dpaSpecification] using cert.finiteGameRealizableIff

/--
DPA-level no-direct restricted decidability from the strategy-reachable
certificate.
-/
noncomputable def dpaSynthesisDecidable
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert :
      NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCertificate
        In₁ In₂ Out₁ Out₂ A) :
    Decidable (SynthesisProblem (dpaSpecification A)) := by
  let finiteGameDecision :=
    finite_dynamic_hierarchy_parity_game_decidable cert.finiteGame
  cases finiteGameDecision with
  | isTrue hfinite =>
      exact
        isTrue
          (by
            simpa [SynthesisProblem, Realizes, dpaSpecification]
              using cert.finiteGameRealizableIff.mp hfinite)
  | isFalse hfinite =>
      exact
        isFalse
          (by
            intro hsynth
            exact hfinite
              (cert.finiteGameRealizableIff.mpr
                (by
                  simpa [SynthesisProblem, Realizes, dpaSpecification]
                    using hsynth)))

/--
Formula-level no-direct restricted decidability through an LTL-to-DPA compiler
and the strategy-reachable certificate for the compiled DPA.
-/
noncomputable def ltlSynthesisDecidable
    {AP : Type ap}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    [DecidableEq AP]
    (compiler :
      LTLToDPACompiler.{ap, max u v x y, aut}
        AP
        (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (formula : LTL AP)
    (cert :
      NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCertificate
        In₁ In₂ Out₁ Out₂ (compiler.compile formula)) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          LTL.Satisfies compiler.interp word formula)) := by
  let A := compiler.compile formula
  let dpaDecision :
      Decidable (SynthesisProblem (dpaSpecification A)) :=
    cert.dpaSynthesisDecidable
  cases dpaDecision with
  | isTrue h =>
      exact
        isTrue
          (by
            rcases h with ⟨σ, hσ⟩
            exact
              ⟨σ, fun env =>
                (compiler.correct formula (execution σ env)).mp (hσ env)⟩)
  | isFalse h =>
      exact
        isFalse
          (by
            intro hltl
            rcases hltl with ⟨σ, hσ⟩
            exact
              h
                ⟨σ, fun env =>
                  (compiler.correct formula (execution σ env)).mpr (hσ env)⟩)

end NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCertificate

/--
Compiler-backed version of the strategy-reachable no-direct certificate.

Compared with
`NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCertificate`, this
does not expose a raw `finiteGameRealizableIff` field.  The finite game and its
correctness are obtained from the supplied uniform DPA finite-game compiler.
-/
structure NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCompilerCertificate
    (In₁ : Type u) (In₂ : Type v) (Out₁ : Type x) (Out₂ : Type y)
    (A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)) where
  header :
    NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
      In₁ In₂ Out₁ Out₂ A
  finiteMemory :
    StrategyReachableNoDirectFiniteRetractionForHeader header
  gameCompiler :
    DPAFiniteGameCompiler.{u, v, x, y, max u v x y aut, aut}
      In₁ In₂ Out₁ Out₂

namespace NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCompilerCertificate

/--
Build the compiler-backed no-direct certificate from the concrete local-lambda
reachable Bérard payload and the reusable DPA finite-game compiler.
-/
noncomputable def ofLocalLambdaReachablePayload
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardLocalLambdaReachablePayloadForHeader header)
    (gameCompiler :
      DPAFiniteGameCompiler.{u, v, x, y, max u v x y aut, aut}
        In₁ In₂ Out₁ Out₂) :
    NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCompilerCertificate
      In₁ In₂ Out₁ Out₂ A where
  header := header
  finiteMemory := payload.toStrategyReachableFiniteRetraction
  gameCompiler := gameCompiler

/--
Direct compiler-backed certificate from the safe product-observer route.

This is the theorem-facing Lean endpoint matching the paper proof after the
finite-memory audit: the external Bérard construction supplies the raw
reachable product observer and the local-lambda bridge.  Lean chooses reachable
representatives, proves their monitor preservation, and invokes the reusable
DPA finite-game compiler.
-/
noncomputable def ofRawObserverAndLocalLambdaBridge
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer : BerardDirectProductObserverRawConstructionForHeader header)
    (HandoffState : observer.ProductState -> Prop)
    (handoff_ne_initial :
      ∀ s : observer.ProductState, HandoffState s -> s ≠ observer.initialState)
    (bridge : BerardLocalLambdaBridgeForRawObserver observer)
    (gameCompiler :
      DPAFiniteGameCompiler.{u, v, x, y, max u v x y aut, aut}
        In₁ In₂ Out₁ Out₂) :
    NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCompilerCertificate
      In₁ In₂ Out₁ Out₂ A :=
  ofLocalLambdaReachablePayload
    { observer := observer
      HandoffState := HandoffState
      handoff_ne_initial := handoff_ne_initial
      localLambda := bridge }
    gameCompiler

/-- Forget the compiler-backed certificate to the fixed-objective certificate. -/
noncomputable def toFixedGameCertificate
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert :
      NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCompilerCertificate
        In₁ In₂ Out₁ Out₂ A) :
    NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCertificate
      In₁ In₂ Out₁ Out₂ A where
  header := cert.header
  finiteMemory := cert.finiteMemory
  finiteGame := (cert.gameCompiler.compile A).finiteGame
  finiteGameRealizableIff := (cert.gameCompiler.compile A).realizabilityEquivalent

/--
The finite-game equivalence used in the paper proof after applying the
compiler to the deterministic parity objective.
-/
theorem fixedGameRealizableIff
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert :
      NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCompilerCertificate
        In₁ In₂ Out₁ Out₂ A) :
    (cert.gameCompiler.compile A).finiteGame.realizable ↔
      ∃ σ : StrategyPair In₁ In₂ Out₁ Out₂,
        ∀ env : EnvironmentSequence In₁ In₂,
          A.Accepts (execution σ env) :=
  (cert.gameCompiler.compile A).realizabilityEquivalent

/-- DPA-level decidability from the compiler-backed strategy-reachable certificate. -/
noncomputable def dpaSynthesisDecidable
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (cert :
      NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCompilerCertificate
        In₁ In₂ Out₁ Out₂ A) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  cert.toFixedGameCertificate.dpaSynthesisDecidable

/--
DPA-level decidability directly from the safe product-observer route.
-/
noncomputable def dpaSynthesisDecidableOfRawObserverAndLocalLambdaBridge
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
