/--
Self-compatible rejected words do not need an extra output-tracking premise.

If the concrete no-direct prefix state carries the same two local summaries and
fringe arguments as the self-compatible witness states, locality of the
round-aware lambda controller forces the controller outputs to agree with the
word's outputs.  This turns prefix summary/fringe tracking into the older
summary/fringe/output prefix-choice package.
-/
theorem rejectedPrefixChoices_of_prefixTracking
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {H₁ : Type br} {H₂ : Type lab} {R₁ : Type tr} {R₂ : Type aut}
    (uniform :
      UniformOneDirectionalFiniteIndexLemma
        (RoundRecord In₁ In₂ Graph Out₁ Out₂) In₁ In₂ Out₁ Out₂)
    (initialBoundary : uniform.boundary)
    (historyOne :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> List H₁)
    (historyTwo :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> List H₂)
    (fringeOne :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> R₁)
    (fringeTwo :
      FiniteEpochTransformer.GameState uniform.noDirectEpochTransformer ->
        EnvironmentRound In₁ In₂ -> R₂)
    (controller :
      uniform.noDirectEpochTransformer.RoundAwareLambdaControllerCode
        historyOne historyTwo fringeOne fringeTwo)
    (historyOfViewOne : View In₁ In₂ Proc.one -> List H₁)
    (historyOfViewTwo : View In₁ In₂ Proc.two -> List H₂)
    (fringeOfViewOne : View In₁ In₂ Proc.one -> R₁)
    (fringeOfViewTwo : View In₁ In₂ Proc.two -> R₂)
    (word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (hself :
      FiniteEpochTransformer.RoundAwareLambdaControllerSelfCompatibleExecution
        uniform.noDirectEpochTransformer
        historyOne historyTwo fringeOne fringeTwo controller
        historyOfViewOne historyOfViewTwo
        fringeOfViewOne fringeOfViewTwo
        word)
    (htrack :
      ∀ n : Nat,
        let state :=
          uniform.noDirectEpochStateAfterHistory initialBoundary
            (FiniteEpochTransformer.wordPrefix word n)
        let envRound :=
          FiniteEpochTransformer.environmentRoundOfWord word n
        historyOne state envRound =
            historyOfViewOne
              (nextView Proc.one
                (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
          fringeOne state envRound =
            fringeOfViewOne
              (nextView Proc.one
                (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
          historyTwo state envRound =
            historyOfViewTwo
              (nextView Proc.two
                (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
          fringeTwo state envRound =
            fringeOfViewTwo
              (nextView Proc.two
                (FiniteEpochTransformer.wordPrefix word n) envRound)) :
    ∀ n : Nat,
      let state :=
        uniform.noDirectEpochStateAfterHistory initialBoundary
          (FiniteEpochTransformer.wordPrefix word n)
      let envRound :=
        FiniteEpochTransformer.environmentRoundOfWord word n
      historyOne state envRound =
          historyOfViewOne
            (nextView Proc.one
              (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
        fringeOne state envRound =
          fringeOfViewOne
            (nextView Proc.one
              (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
        historyTwo state envRound =
          historyOfViewTwo
            (nextView Proc.two
              (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
        fringeTwo state envRound =
          fringeOfViewTwo
            (nextView Proc.two
              (FiniteEpochTransformer.wordPrefix word n) envRound) ∧
        word n =
          {
            inputOne := envRound.inputOne
            inputTwo := envRound.inputTwo
            graph := envRound.graph
            outputOne := (controller.1 state envRound).1
            outputTwo := (controller.1 state envRound).2
          } := by
  intro n
  let state :=
    uniform.noDirectEpochStateAfterHistory initialBoundary
      (FiniteEpochTransformer.wordPrefix word n)
  let envRound :=
    FiniteEpochTransformer.environmentRoundOfWord word n
  rcases htrack n with
    ⟨hhistoryOne, hfringeOne, hhistoryTwo, hfringeTwo⟩
  rcases hself n with
    ⟨stateOne, hhistoryOneWitness, hfringeOneWitness,
      stateTwo, hhistoryTwoWitness, hfringeTwoWitness, hword⟩
  have hhistoryOneLocal :
      historyOne stateOne envRound = historyOne state envRound := by
    rw [hhistoryOneWitness, hhistoryOne]
  have hfringeOneLocal :
      fringeOne stateOne envRound = fringeOne state envRound := by
    rw [hfringeOneWitness, hfringeOne]
  have hhistoryTwoLocal :
      historyTwo stateTwo envRound = historyTwo state envRound := by
    rw [hhistoryTwoWitness, hhistoryTwo]
  have hfringeTwoLocal :
      fringeTwo stateTwo envRound = fringeTwo state envRound := by
    rw [hfringeTwoWitness, hfringeTwo]
  have hone :
      (controller.1 stateOne envRound).1 =
        (controller.1 state envRound).1 :=
    controller.2.1 stateOne envRound state envRound
      hhistoryOneLocal hfringeOneLocal
  have htwo :
      (controller.1 stateTwo envRound).2 =
        (controller.1 state envRound).2 :=
    controller.2.2 stateTwo envRound state envRound
      hhistoryTwoLocal hfringeTwoLocal
  refine ⟨hhistoryOne, hfringeOne, hhistoryTwo, hfringeTwo, ?_⟩
  rw [hword, hone, htwo]

