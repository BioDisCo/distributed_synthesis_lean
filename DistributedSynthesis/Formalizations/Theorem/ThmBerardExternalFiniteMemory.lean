      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)
  truth_append_congruent := by
    intro h h' r htruth
    exact stabilizedSaturationBasis_truthVector_eq_of_pathEquivalent
      (core.path_append_congruent h h' r
        (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth))
  receipt_eq_of_truth_eq := by
    intro h h' htruth
    exact core.receipt_eq_of_pathEquivalent h h'
      (stabilizedSaturationBasis_pathEquivalent_of_truthVector_eq htruth)

/--
