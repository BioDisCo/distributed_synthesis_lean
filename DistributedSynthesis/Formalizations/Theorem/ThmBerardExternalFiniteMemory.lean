  ofRawRepresentativeInvariantCore
    (BerardRawRealizedTruthRepresentativeInvariantCoreForHeader.ofFiniteTruthQuotientInvariantCore
      core)

/-- Empty-safe projection from the all-history actual-truth invariant core. -/
noncomputable def ofActualTruthInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      NoDirectDPAJournalBoundedLocalActualTruthInvariantCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    BerardRawRealizedTruthClosureInvariantCoreForHeader header :=
  ofRawRepresentativeInvariantCore
    (BerardRawRealizedTruthRepresentativeInvariantCoreForHeader.ofActualTruthInvariantCore
      core)

/-- Finite bound for the representatives of realized truth atoms. -/
noncomputable def truthRepresentativeGenerationBound
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      BerardRawRealizedTruthClosureInvariantCoreForHeader header) :
    Nat := by
  classical
  let TruthAtom := RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  let Realized : TruthAtom -> Prop :=
    fun truth =>
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth
  letI : Fintype TruthAtom :=
    regularTestTruthAtomFintype (stabilizedSaturationBasis header.cert)
  exact
    Classical.choose
      (finiteFamilyNatBound
        (fun q : { truth : TruthAtom // Realized truth } =>
          (core.envsOfRealizedTruth q.1 q.2).length))

theorem truthRepresentativeGenerationBound_spec
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      BerardRawRealizedTruthClosureInvariantCoreForHeader header)
    (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
    (hreal :
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth) :
    (core.envsOfRealizedTruth truth hreal).length ≤
      core.truthRepresentativeGenerationBound := by
  classical
  let TruthAtom := RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  let Realized : TruthAtom -> Prop :=
    fun truth =>
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth
  letI : Fintype TruthAtom :=
    regularTestTruthAtomFintype (stabilizedSaturationBasis header.cert)
  have hspec :=
    Classical.choose_spec
      (finiteFamilyNatBound
        (fun q : { truth : TruthAtom // Realized truth } =>
          (core.envsOfRealizedTruth q.1 q.2).length))
  exact hspec ⟨truth, hreal⟩

/-- The final bound needed by the invariant-data route. -/
noncomputable def generationBound
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      BerardRawRealizedTruthClosureInvariantCoreForHeader header) :
    Nat :=
  core.truthRepresentativeGenerationBound

/--
Convert the empty-safe unbounded core to the checked bounded invariant-data
endpoint, choosing the finite representative bound internally.
-/
noncomputable def toRealizedTruthClosureInvariantData
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      BerardRawRealizedTruthClosureInvariantCoreForHeader header) :
    NoDirectDPAJournalBoundedLocalRealizedTruthClosureInvariantDataForActualTruthAutomatonParityCurrentOrderHeader
      (header.withGenerationBound core.generationBound) where
  representatives :=
    { envsOfRealizedTruth := fun truth hreal =>
        core.envsOfRealizedTruth truth hreal
      envs_bound := by
        intro truth hreal
        simpa [
          generationBound,
          NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.withGenerationBound]
          using core.truthRepresentativeGenerationBound_spec truth hreal
      envs_realizes := by
        intro truth hreal
        simpa [
          NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.withGenerationBound]
          using core.envs_realizes truth hreal }
  closureInvariants :=
    { rawEpochState_invariant := by
        intro hdet hpred hboundary hcont h h' htruth
        simpa [
          NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.withGenerationBound]
          using core.rawEpochState_invariant hdet hpred hboundary hcont h h' htruth
      automatonOfHistory_invariant := by
        intro _hcont h h' htruth
        dsimp [
          NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.withGenerationBound,
          NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.toCurrentOrderHeader]
        exact congrArg header.automatonOfTruth htruth }
  receiptOrder_invariant := by
    intro h h' htruth
    exact core.receiptOrder_invariant h h' htruth

/--
DPA-level consequence of the empty-safe unbounded invariant core and a backend
for the internally bounded header.
-/
noncomputable def toNoDirectDPASynthesisDecidableViaRealizedTruthClosureInvariantData
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      BerardRawRealizedTruthClosureInvariantCoreForHeader header)
    (backend :
      NoDirectDPAJournalBoundedLocalConcreteFringeCompilerBackendForHeader
        (header.withGenerationBound core.generationBound).toCurrentOrderHeader.toHeader) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  noDirectDPASynthesisDecidable_ofJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeaderRealizedTruthClosureInvariantDataConcreteFringeCompilerBackend
    A (header.withGenerationBound core.generationBound)
    core.toRealizedTruthClosureInvariantData
    backend

/--
Same consequence using an original-header backend; the backend fields are
independent of the generation bound and are retargeted structurally.
-/
noncomputable def toNoDirectDPASynthesisDecidableViaRealizedTruthClosureInvariantDataWithOriginalBackend
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (core :
      BerardRawRealizedTruthClosureInvariantCoreForHeader header)
    (backend :
      NoDirectDPAJournalBoundedLocalConcreteFringeCompilerBackendForHeader
        header.toCurrentOrderHeader.toHeader) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  core.toNoDirectDPASynthesisDecidableViaRealizedTruthClosureInvariantData
    (backend.retarget :
      NoDirectDPAJournalBoundedLocalConcreteFringeCompilerBackendForHeader
        (header.withGenerationBound core.generationBound).toCurrentOrderHeader.toHeader)

end BerardRawRealizedTruthClosureInvariantCoreForHeader

/--
Realized-truth completion before choosing the final header generation bound.

The external Bérard construction only has to supply representatives for the
finitely many realized truth atoms.  This raw interface does not ask for a bound
on those representatives; Lean computes one from finiteness.
-/
structure BerardDirectProductObserverRawRealizedTruthCompletionForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  observer :
    BerardDirectProductObserverRawConstructionForHeader header
  envsOfRealizedTruth :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth ->
        List (EnvironmentRound In₁ In₂)
  stateOfRealizedTruth :
    ∀ truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert),
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth ->
        observer.ProductState
  envs_state :
    ∀ (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
      (hreal :
        StabilizedSaturationBasisNoDirectRealizedTruthAtom
          header.cert (pathOfHistoryByRound header.edgeOfRound) truth),
      observer.stateOfGenerated (envsOfRealizedTruth truth hreal) =
        stateOfRealizedTruth truth hreal
  state_truth :
    ∀ (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
      (hreal :
        StabilizedSaturationBasisNoDirectRealizedTruthAtom
          header.cert (pathOfHistoryByRound header.edgeOfRound) truth),
      observer.truthOfState (stateOfRealizedTruth truth hreal) = truth
  envs_nonempty :
    ∀ (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
      (hreal :
        StabilizedSaturationBasisNoDirectRealizedTruthAtom
          header.cert (pathOfHistoryByRound header.edgeOfRound) truth),
      envsOfRealizedTruth truth hreal ≠ []
  rawEpochState_invariant :
    header.cert.determinesPathData ->
    header.cert.predecessorClosed ->
    (∀ boundaryState, header.cert.boundaryClosed boundaryState) ->
    header.cert.continuationClosed ->
      ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h) =
          regularTestTruthVector (stabilizedSaturationBasis header.cert)
            (pathOfHistoryByRound header.edgeOfRound h') ->
        header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h =
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochStateAfterHistory
            header.initialBoundary h'
  receiptOrder_invariant :
    ∀ h h' : History In₁ In₂ Graph Out₁ Out₂,
      regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h) =
        regularTestTruthVector (stabilizedSaturationBasis header.cert)
          (pathOfHistoryByRound header.edgeOfRound h') ->
      currentReceiptOrderData h (historyCurrentContainmentOrder h) =
        currentReceiptOrderData h' (historyCurrentContainmentOrder h')
  coherentHistoryNonempty :
    ∀ c :
      CoherentContinuationConfiguration
        header.containmentOrder historyCurrentContainmentOrder
        (header.toCurrentOrderHeader.automatonOfHistory),
      c.1.history ≠ []

namespace BerardDirectProductObserverRawRealizedTruthCompletionForHeader

/-- Finite bound for the representatives of realized truth atoms. -/
noncomputable def truthRepresentativeGenerationBound
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (completion :
      BerardDirectProductObserverRawRealizedTruthCompletionForHeader header) :
    Nat := by
  classical
  let TruthAtom := RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  let Realized : TruthAtom -> Prop :=
    fun truth =>
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth
  letI : Fintype TruthAtom :=
    regularTestTruthAtomFintype (stabilizedSaturationBasis header.cert)
  exact
    Classical.choose
      (finiteFamilyNatBound
        (fun q : { truth : TruthAtom // Realized truth } =>
          (completion.envsOfRealizedTruth q.1 q.2).length))

theorem truthRepresentativeGenerationBound_spec
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (completion :
      BerardDirectProductObserverRawRealizedTruthCompletionForHeader header)
    (truth : RegularTestTruthAtom (stabilizedSaturationBasis header.cert))
    (hreal :
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth) :
    (completion.envsOfRealizedTruth truth hreal).length ≤
      completion.truthRepresentativeGenerationBound := by
  classical
  let TruthAtom := RegularTestTruthAtom (stabilizedSaturationBasis header.cert)
  let Realized : TruthAtom -> Prop :=
    fun truth =>
      StabilizedSaturationBasisNoDirectRealizedTruthAtom
        header.cert (pathOfHistoryByRound header.edgeOfRound) truth
  letI : Fintype TruthAtom :=
    regularTestTruthAtomFintype (stabilizedSaturationBasis header.cert)
  have hspec :=
    Classical.choose_spec
      (finiteFamilyNatBound
        (fun q : { truth : TruthAtom // Realized truth } =>
          (completion.envsOfRealizedTruth q.1 q.2).length))
  exact hspec ⟨truth, hreal⟩

/--
The final bound chosen for the bounded header: it dominates both the reachable
observer-state representatives and the realized-truth representatives.
-/
noncomputable def generationBound
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (completion :
      BerardDirectProductObserverRawRealizedTruthCompletionForHeader header) :
    Nat :=
  completion.observer.reachableGenerationBound +
    completion.truthRepresentativeGenerationBound

/--
Convert the raw completion into the theorem-facing bounded completion by
choosing the final header bound internally.
-/
noncomputable def toBoundedRealizedTruthCompletion
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (completion :
      BerardDirectProductObserverRawRealizedTruthCompletionForHeader header) :
    BerardDirectProductObserverRealizedTruthCompletionForHeader
      (header.withGenerationBound completion.generationBound) where
  observer :=
    completion.observer.toBoundedDirectProductObserverConstructionWithBound
      completion.generationBound (by
        dsimp [generationBound]
        omega)
  envsOfRealizedTruth := fun truth hreal =>
    completion.envsOfRealizedTruth truth hreal
  stateOfRealizedTruth := fun truth hreal =>
    completion.stateOfRealizedTruth truth hreal
  envs_state := by
    intro truth hreal
    exact completion.envs_state truth hreal
  state_truth := by
    intro truth hreal
    exact completion.state_truth truth hreal
  envs_bound := by
    intro truth hreal
    have hlen := completion.truthRepresentativeGenerationBound_spec truth hreal
    dsimp [
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.withGenerationBound,
      generationBound]
    omega
  envs_nonempty := by
    intro truth hreal
    exact completion.envs_nonempty truth hreal
  rawEpochState_invariant := by
    intro hdet hpred hboundary hcont h h' htruth
    exact completion.rawEpochState_invariant hdet hpred hboundary hcont h h' htruth
  receiptOrder_invariant := by
    intro h h' htruth
    exact completion.receiptOrder_invariant h h' htruth
  coherentHistoryNonempty := by
    intro c
    exact completion.coherentHistoryNonempty c

/--
End-to-end no-direct restricted certificate from the raw completion.  The only
header used by the public certificate is the same header with the internally
computed generation bound.
-/
noncomputable def toNoDirectReversalRestrictedCertificate
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (completion :
      BerardDirectProductObserverRawRealizedTruthCompletionForHeader header)
    (backend :
