    (assembly :
      BerardFullProductControllerMonitorAssemblyForHeader
        (problem := problem) header)
    (boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary)
    (labelData : LocalLambdaLabelData assembly boundaryOfObservation)
    (gameCompiler :
      DPAFiniteGameCompiler.{u, v, x, y, max u v x y aut, aut}
        In₁ In₂ Out₁ Out₂) :
    NoDirectDPAJournalStrategyReachableNoDirectReversalRestrictedCompilerCertificate
      In₁ In₂ Out₁ Out₂ A :=
  (assembly.toSafeRawFiniteMemoryPayloadOfLabelData
      boundaryOfObservation labelData).toCompilerCertificate gameCompiler

/--
Fixed-objective no-direct certificate from the full product assembly plus
local-label data and one certified finite-game compilation.
-/
noncomputable def fixedGameCertificateOfLabelDataWithDPAToFiniteGameCompilation
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
