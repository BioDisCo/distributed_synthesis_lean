        viewTwo
            (roundAwareControlOfGenerated header
              (roundAwareControllerOfHeaderStrategyViews header viewOne viewTwo)
              envs)
            env =
          nextView Proc.two (executionPrefixFromList header.σ envs) env)
    (defaultOne : Out₁)
    (defaultTwo : Out₂) :
    ∀ (env : EnvironmentSequence In₁ In₂) (n : Nat),
      let σ :=
        FiniteEpochTransformer.strategyOfRoundAwareLocalController
          header.toCurrentOrderHeader.toHeader.importedUniform.noDirectEpochTransformer
