/--
LTL decidability from the full product assembly plus local-label data and one
certified finite-game compilation for the compiled DPA objective.
-/
noncomputable def ltlSynthesisDecidableOfLabelDataWithDPAToFiniteGameCompilation
    {AP : Type ap}
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    [DecidableEq AP]
    (compiler :
      LTLToDPACompiler.{ap, max u v x y, aut}
        AP
        (RoundRecord In₁ In₂ Graph Out₁ Out₂))
    (formula : LTL AP)
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ (compiler.compile formula)}
    (assembly :
      BerardFullProductControllerMonitorAssemblyForHeader
        (problem := problem) header)
    (boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary)
    (labelData : LocalLambdaLabelData assembly boundaryOfObservation)
    (gameCompilation :
      DPAToFiniteGameCompilation.{u, v, x, y, max u v x y aut}
        Out₂ (compiler.compile formula)) :
    Decidable
      (SynthesisProblem
        (fun word : OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) =>
          LTL.Satisfies compiler.interp word formula)) :=
  (assembly.fixedGameCertificateOfLabelDataWithDPAToFiniteGameCompilation
      boundaryOfObservation labelData gameCompilation)
    |>.ltlSynthesisDecidable compiler formula

/--
Build the local-lambda reachable payload from a full product assembly and the
bounded round-aware lambda data used by the Bérard labels.

This is the assembly-level endpoint matching the paper proof: the external
construction supplies bounded local histories/fringes and their soundness laws;
Lean packages them as `LocalLambdaLabelData` and then builds the reachable
local-lambda payload.
-/
noncomputable def toLocalLambdaReachablePayloadOfBoundedRoundAwareLambdaController
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly :
      BerardFullProductControllerMonitorAssemblyForHeader
        (problem := problem) header)
    (boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary)
    {H₁ H₂ R₁ R₂ : Type (max u v x y aut)}
    [histAtomOneFinite : Fintype H₁]
    [histAtomTwoFinite : Fintype H₂]
    [fringeOneFinite : Fintype R₁]
    [fringeTwoFinite : Fintype R₂]
    (T :
      FiniteEpochTransformer
