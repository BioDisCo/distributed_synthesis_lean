/--
Label-level endpoint for the transition-rational Bérard table.

The old raw observer interface has an opaque `outputRealizer : Prop` field.
At the label/table boundary the real output obligation is the explicit equation
`output_correct`: reading the label selected by the folded finite table and
translating it with the current environment round gives the next output of
`header.σ`.  This constructor stores that equation in the intermediate
`FiniteControllerGeneratesHeaderStrategy` and discharges the obsolete opaque
payload field with `True`.
-/
noncomputable def toRawComputedBoundExternalPayloadOfLabelRightCongruenceCoreAndTruthFactorBlockwiseCore
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly :
      BerardUniformControllerMonitorAssemblyForHeader
        (problem := problem) header)
    (boundaryOfObservation :
      BerardNoDirectGeneratedObservationState header -> Boundary)
    (outputOfLabel :
      Alphabet -> EnvironmentRound In₁ In₂ -> Out₁ × Out₂)
    (output_correct :
      ∀ (envs : List (EnvironmentRound In₁ In₂))
        (env : EnvironmentRound In₁ In₂),
        outputOfLabel
            (assembly.table.labelAt
              (assembly.controlOfGenerated envs)
              (boundaryOfObservation
                (berardNoDirectGeneratedObservation header envs)))
            env =
          ((nextRound header.σ (executionPrefixFromList header.σ envs) env).outputOne,
            (nextRound header.σ (executionPrefixFromList header.σ envs) env).outputTwo))
    (rightCore : BerardGeneratedObservationRightCongruenceCore header)
    (truthCore :
      NoDirectDPAJournalBoundedLocalTruthFactorBlockwiseCoreForActualTruthAutomatonParityCurrentOrderHeader
        header) :
    BerardRawComputedBoundExternalPayloadForHeader header :=
  (assembly.toFiniteControllerGeneratesHeaderStrategyOfLabel
      boundaryOfObservation outputOfLabel output_correct)
    |>.toRawComputedBoundExternalPayloadOfRightCongruenceCoreAndTruthFactorBlockwiseCore
      rightCore True True.intro truthCore

