                        (FiniteEpochTransformer.strategyOfRoundAwareLocalController
                          ((backendUniform A).noDirectEpochTransformer)
                          (backendViewOne A) (backendViewTwo A) controller
                          backendDefaultOne backendDefaultTwo)
