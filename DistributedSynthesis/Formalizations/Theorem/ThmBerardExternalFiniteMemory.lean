      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardRawComputedBoundExternalPayloadForHeader header)
    (backend :
      NoDirectDPAJournalBoundedLocalConcreteFringeCompilerBackendForHeader
        header.toCurrentOrderHeader.toHeader) :
    NoDirectDPAJournalNoDirectReversalRestrictedCertificate In₁ In₂ Out₁ Out₂ A :=
  payload.toRawRealizedTruthCompletion
    |>.toNoDirectReversalRestrictedCertificateWithOriginalBackend backend

/-- DPA-level consequence of the narrow raw payload and an original-header backend. -/
noncomputable def toNoDirectDPASynthesisDecidableWithOriginalBackend
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardRawComputedBoundExternalPayloadForHeader header)
    (backend :
      NoDirectDPAJournalBoundedLocalConcreteFringeCompilerBackendForHeader
        header.toCurrentOrderHeader.toHeader) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  noDirectDPASynthesisDecidable_ofNoDirectReversalRestrictedCertificate
    A (payload.toNoDirectReversalRestrictedCertificateWithOriginalBackend backend)

end BerardRawComputedBoundExternalPayloadForHeader

/--
Empty-safe raw/computed-bound external payload.

This is the generated-prefix Bérard payload paired with the sharper invariant
core.  The raw observer records the finite generated-prefix construction, while
the invariant core supplies only realized representatives and truth
determinacy.  The final public generation bound is computed internally and
dominates both the reachable observer representatives and the realized-truth
representatives.
-/
structure BerardRawComputedClosureInvariantExternalPayloadForHeader
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    (header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A) where
  observer :
    BerardDirectProductObserverRawConstructionForHeader header
  invariants :
    BerardRawRealizedTruthClosureInvariantCoreForHeader header

namespace BerardRawComputedClosureInvariantExternalPayloadForHeader

/-- Finite bound for the realized-truth representatives in the payload. -/
noncomputable def truthRepresentativeGenerationBound
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload :
      BerardRawComputedClosureInvariantExternalPayloadForHeader header) :
    Nat :=
  payload.invariants.truthRepresentativeGenerationBound

/--
The final bound chosen for the bounded header: it dominates both the reachable
observer-state representatives and the realized-truth representatives.
-/
noncomputable def generationBound
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload :
      BerardRawComputedClosureInvariantExternalPayloadForHeader header) :
    Nat :=
  payload.observer.reachableGenerationBound +
    payload.truthRepresentativeGenerationBound

/--
Convert the raw empty-safe payload into the theorem-facing invariant-data
endpoint after internally choosing the final generation bound.
-/
noncomputable def toRealizedTruthClosureInvariantData
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload :
      BerardRawComputedClosureInvariantExternalPayloadForHeader header) :
    NoDirectDPAJournalBoundedLocalRealizedTruthClosureInvariantDataForActualTruthAutomatonParityCurrentOrderHeader
      (header.withGenerationBound payload.generationBound) where
  representatives :=
    { envsOfRealizedTruth := fun truth hreal =>
        payload.invariants.envsOfRealizedTruth truth hreal
      envs_bound := by
        intro truth hreal
        have hlen :=
          payload.invariants.truthRepresentativeGenerationBound_spec truth hreal
        dsimp [
          generationBound,
          truthRepresentativeGenerationBound,
          NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.withGenerationBound]
        omega
      envs_realizes := by
        intro truth hreal
        simpa [
          NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.withGenerationBound]
          using payload.invariants.envs_realizes truth hreal }
  closureInvariants :=
    { rawEpochState_invariant := by
        intro hdet hpred hboundary hcont h h' htruth
        simpa [
          NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.withGenerationBound]
          using payload.invariants.rawEpochState_invariant
            hdet hpred hboundary hcont h h' htruth
      automatonOfHistory_invariant := by
        intro _hcont h h' htruth
        dsimp [
          NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.withGenerationBound,
          NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader.toCurrentOrderHeader]
        exact congrArg header.automatonOfTruth htruth }
  receiptOrder_invariant := by
    intro h h' htruth
    exact payload.invariants.receiptOrder_invariant h h' htruth

/-- Compatibility projection from the older raw/computed-bound payload. -/
noncomputable def ofRawComputedBoundExternalPayload
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload : BerardRawComputedBoundExternalPayloadForHeader header) :
    BerardRawComputedClosureInvariantExternalPayloadForHeader header where
  observer := payload.observer
  invariants :=
    BerardRawRealizedTruthClosureInvariantCoreForHeader.ofRawRepresentativeInvariantCore
      payload.representatives

/-- Assemble from a raw observer and the empty-safe invariant core. -/
noncomputable def ofRawDirectProductObserverConstructionAndClosureInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer :
      BerardDirectProductObserverRawConstructionForHeader header)
    (invariants :
      BerardRawRealizedTruthClosureInvariantCoreForHeader header) :
    BerardRawComputedClosureInvariantExternalPayloadForHeader header where
  observer := observer
  invariants := invariants

/-- Assemble from a raw semantic product observer and the empty-safe core. -/
noncomputable def ofRawSemanticProductObserverConstructionAndClosureInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (observer :
      BerardRawSemanticProductObserverConstructionForHeader header)
    (invariants :
      BerardRawRealizedTruthClosureInvariantCoreForHeader header) :
    BerardRawComputedClosureInvariantExternalPayloadForHeader header :=
  ofRawDirectProductObserverConstructionAndClosureInvariantCore
    observer.toRawDirectProductObserverConstruction invariants

/-- Assemble from a raw finite-memory package and the empty-safe core. -/
noncomputable def ofRawFiniteMemoryPackageAndClosureInvariantCore
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (pkg : BerardNoDirectRawFiniteMemoryPackageForHeader header)
    (invariants :
      BerardRawRealizedTruthClosureInvariantCoreForHeader header) :
    BerardRawComputedClosureInvariantExternalPayloadForHeader header :=
  ofRawDirectProductObserverConstructionAndClosureInvariantCore
    pkg.toRawDirectProductObserverConstruction invariants

/-- Assemble from the controller-table/monitor product assembly and the empty-safe core. -/
noncomputable def ofUniformControllerMonitorAssemblyAndClosureInvariantCore
    {Boundary : Type u} {Branch : Type v} {Alphabet : Type x}
    {problem :
      OneDirectionalFiniteMemoryProblem.{u, v, x, aut} Boundary Branch Alphabet}
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (assembly :
      BerardUniformControllerMonitorAssemblyForHeader
        (problem := problem) header)
    (invariants :
      BerardRawRealizedTruthClosureInvariantCoreForHeader header) :
    BerardRawComputedClosureInvariantExternalPayloadForHeader header :=
  ofRawDirectProductObserverConstructionAndClosureInvariantCore
    assembly.toRawDirectProductObserverConstruction invariants

/--
DPA-level consequence of the raw empty-safe payload and a backend for the
internally bounded header.
-/
noncomputable def toNoDirectDPASynthesisDecidableViaRealizedTruthClosureInvariantData
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload :
      BerardRawComputedClosureInvariantExternalPayloadForHeader header)
    (backend :
      NoDirectDPAJournalBoundedLocalConcreteFringeCompilerBackendForHeader
        (header.withGenerationBound payload.generationBound).toCurrentOrderHeader.toHeader) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  noDirectDPASynthesisDecidable_ofJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeaderRealizedTruthClosureInvariantDataConcreteFringeCompilerBackend
    A (header.withGenerationBound payload.generationBound)
    payload.toRealizedTruthClosureInvariantData
    backend

/--
Same consequence using an original-header backend; the backend is retargeted to
the internally chosen generation bound.
-/
noncomputable def toNoDirectDPASynthesisDecidableViaRealizedTruthClosureInvariantDataWithOriginalBackend
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
    {A : DetParityAutomaton.{max u v x y, aut}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂)}
    {header :
      NoDirectDPAJournalBoundedLocalActualTruthAutomatonParityCurrentOrderHeader
        In₁ In₂ Out₁ Out₂ A}
    (payload :
      BerardRawComputedClosureInvariantExternalPayloadForHeader header)
    (backend :
      NoDirectDPAJournalBoundedLocalConcreteFringeCompilerBackendForHeader
        header.toCurrentOrderHeader.toHeader) :
    Decidable (SynthesisProblem (dpaSpecification A)) :=
  payload.toNoDirectDPASynthesisDecidableViaRealizedTruthClosureInvariantData
    (backend.retarget :
      NoDirectDPAJournalBoundedLocalConcreteFringeCompilerBackendForHeader
        (header.withGenerationBound payload.generationBound).toCurrentOrderHeader.toHeader)

end BerardRawComputedClosureInvariantExternalPayloadForHeader

namespace FiniteControllerGeneratesHeaderStrategy

/--
A finite controller that generates `header.σ`, together with generated
observation right-congruence, supplies the raw direct product observer.

The product state produced by the checked assembly contains both the controller
state and the theorem-facing observation tuple.
-/
noncomputable def toRawDirectProductObserverConstruction
    {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
