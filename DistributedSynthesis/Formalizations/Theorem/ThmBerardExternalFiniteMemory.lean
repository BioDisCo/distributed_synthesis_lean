      In₁ In₂ Out₁ Out₂ A :=
  assembly.fixedGameCertificateOfContingentStrategyWithGeneratedReceiptHierarchyOfFiniteLabelBoundsWithDPAToFiniteGameCompilation
    boundaryOfObservation T historyOne historyTwo fringeOne fringeTwo strategy
