import DistributedSynthesis.Formalizations.Theorem.ThmPairedProfiledOpenObservableThreads

/-!
# The same-strategy semantic observable tree

The unrestricted observation alphabet contains canonical classes that need
not be generated by the fixed raw realizer.  Requiring a legal move at those
unreachable nodes is stronger than the synthesis problem.  This file uses
the finite subtype of classes realized by one fixed winning strategy.  The
proof of realizability is proof-side data only; the public value remains the
canonical finite class and contains no distinguished root or leader bit.

Every node has a canonical legal semantic move.  Consequently the only
remaining condition for this tree to win is universal parity of its coherent
hidden-root threads.
-/

namespace DistributedSynthesis

universe u v x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

section

noncomputable section

variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
variable [DecidableEq In₁] [DecidableEq In₂]

/-- A public class is available when it has a realization by the one fixed
winning strategy.  The sink is always available. -/
def ProfiledOpenObservation.RealizedBy
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis) :
    ProfiledOpenObservation A → Prop
  | .sink => True
  | .right source =>
      Nonempty (ProfiledOpenRightRealization A strategy hwin basis source)
  | .left source =>
      Nonempty (ProfiledOpenLeftRealization A strategy hwin basis source)

/-- Finite public observations generated by one fixed strategy.  The subtype
proof is erased logically and does not reveal a root, orientation decision,
or strict-leader signal to either process. -/
abbrev ProfiledOpenSemanticObservation
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis) :=
  { observation : ProfiledOpenObservation A //
    observation.RealizedBy A strategy hwin basis }

noncomputable instance profiledOpenSemanticObservationFintype
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis) :
    Fintype (ProfiledOpenSemanticObservation A strategy hwin basis) := by
  classical
  infer_instance

noncomputable instance profiledOpenSemanticObservationDecidableEq
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis) :
    DecidableEq (ProfiledOpenSemanticObservation A strategy hwin basis) :=
  Classical.decEq _

instance profiledOpenSemanticObservationInhabited
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis) :
    Inhabited (ProfiledOpenSemanticObservation A strategy hwin basis) :=
  ⟨⟨.sink, trivial⟩⟩

/-- Forget only the proof that a public class is generated by the fixed
strategy. -/
def ProfiledOpenSemanticObservation.public
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis} :
    ProfiledOpenSemanticObservation A strategy hwin basis →
      ProfiledOpenObservation A :=
  Subtype.val

/-- Select a realization witness without changing the public class. -/
noncomputable def ProfiledOpenSemanticObservation.move
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (observation : ProfiledOpenSemanticObservation A strategy hwin basis) :
    ProfiledOpenRepresentableMove A := by
  rcases observation with ⟨observation, hrealized⟩
  cases observation with
  | sink => exact .sink
  | right source =>
      exact Classical.choice hrealized |>.observableMove A
  | left source =>
      exact Classical.choice hrealized |>.observableMove A

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- The selected semantic move is legal for exactly the public class. -/
theorem ProfiledOpenSemanticObservation.move_valid
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (observation : ProfiledOpenSemanticObservation A strategy hwin basis) :
    ProfiledOpenObservableMoveValid A observation.public
      (observation.move A) := by
  rcases observation with ⟨observation, hrealized⟩
  cases observation with
  | sink =>
      simp [ProfiledOpenSemanticObservation.move,
        ProfiledOpenSemanticObservation.public,
        ProfiledOpenObservableMoveValid,
        ProfiledOpenRepresentableMove.Valid,
        ProfiledOpenRepresentableMove.roots,
        ProfiledOpenObservation.roots]
  | right source =>
      simpa [ProfiledOpenSemanticObservation.move,
        ProfiledOpenSemanticObservation.public] using
        (Classical.choice hrealized).observableMove_valid A
  | left source =>
      simpa [ProfiledOpenSemanticObservation.move,
        ProfiledOpenSemanticObservation.public] using
        (Classical.choice hrealized).observableMove_valid A

/-- The canonical same-strategy semantic tree.  Its label depends only on the
history of public finite classes. -/
noncomputable def profiledOpenSemanticMoveTree
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis)
    (initial : ProfiledOpenSemanticObservation A strategy hwin basis) :
    LabeledTree (ProfiledOpenSemanticObservation A strategy hwin basis)
      (ProfiledOpenRepresentableMove A) :=
  fun node => (observableAt initial node).move A

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- All labels of the semantic tree are legal; unreachable foreign classes
are absent from its branch type rather than patched by arbitrary moves. -/
theorem profiledOpenSemanticMoveTree_valid
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis)
    (initial : ProfiledOpenSemanticObservation A strategy hwin basis) :
    ∀ node,
      ProfiledOpenObservableMoveValid A
        (observableAt initial node).public
        (profiledOpenSemanticMoveTree A strategy hwin basis initial node) := by
  intro node
  exact (observableAt initial node).move_valid A

/-- Coherent hidden roots over the restricted same-strategy observation
alphabet.  Only the public-class wrapper changes; the retained root and the
concrete exit relation are exactly those of `profiledOpenThreadSystem`. -/
noncomputable def profiledOpenSemanticThreadSystem
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis)
    (initial : ProfiledOpenSemanticObservation A strategy hwin basis) :
    FiniteThreadSystem
      (ProfiledOpenRepresentableMove A ×
        ProfiledOpenSemanticObservation A strategy hwin basis) where
  State := ProfiledOpenThreadState A
  stateFinite := inferInstance
  initial := .initial
  Resolution := ProfiledOpenClassifiedDirection A
  step := fun state letter direction =>
    profiledOpenThreadStep A initial.public state
      (letter.1, letter.2.public) direction
  priority := fun state =>
    match state with
    | .initial | .dead => 0
    | .live anchor => profiledOpenClassifiedAnchorPriority A anchor

/-- The observable monitor over same-strategy generated classes. -/
noncomputable abbrev profiledOpenSemanticTreeMonitor
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis)
    (initial : ProfiledOpenSemanticObservation A strategy hwin basis) :=
  observableThreadTreeMonitor
    (profiledOpenSemanticThreadSystem A strategy hwin basis initial) initial
    (fun observation move =>
      ProfiledOpenObservableMoveValid A observation.public move)

/-- Exact global obligation for the corrected semantic tree.  There is no
local block-pasting premise hidden in this definition: every coherent actual
root resolution is quantified by the universal-run DPA. -/
def ProfiledOpenSemanticGlobalParity
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis)
    (initial : ProfiledOpenSemanticObservation A strategy hwin basis) : Prop :=
  ∀ branch : Nat → ProfiledOpenSemanticObservation A strategy hwin basis,
    (profiledOpenSemanticThreadSystem A strategy hwin basis initial).universalRunDPA.Accepts
      (observableThreadWord
        (profiledOpenSemanticMoveTree A strategy hwin basis initial) branch)

section
omit [Inhabited Out₁] [Inhabited Out₂]

/-- Fully unfolded form of the residual: every run of retained concrete roots
over every public-class branch has min-even epoch parity. -/
theorem profiledOpenSemanticGlobalParity_iff_allRuns
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis)
    (initial : ProfiledOpenSemanticObservation A strategy hwin basis) :
    ProfiledOpenSemanticGlobalParity A strategy hwin basis initial ↔
      ∀ branch : Nat → ProfiledOpenSemanticObservation A strategy hwin basis,
        ∀ run : Nat → ProfiledOpenThreadState A,
          (profiledOpenSemanticThreadSystem A strategy hwin basis initial).IsRun
              (observableThreadWord
                (profiledOpenSemanticMoveTree A strategy hwin basis initial)
                branch) run →
            NatSeqMinEvenParity (fun n =>
              (profiledOpenSemanticThreadSystem A strategy hwin basis
                initial).priority (run n)) := by
  unfold ProfiledOpenSemanticGlobalParity
  constructor <;> intro h branch
  · exact ((profiledOpenSemanticThreadSystem A strategy hwin basis initial).universalRunDPA_accepts_iff
      (observableThreadWord
        (profiledOpenSemanticMoveTree A strategy hwin basis initial)
        branch)).mp (h branch)
  · exact ((profiledOpenSemanticThreadSystem A strategy hwin basis initial).universalRunDPA_accepts_iff
      (observableThreadWord
        (profiledOpenSemanticMoveTree A strategy hwin basis initial)
        branch)).2 (h branch)

/-- For the canonical same-strategy tree, winning is exactly the global
coherent-thread parity statement.  Node legality is already proved. -/
theorem profiledOpenSemanticMoveTree_winning_iff_globalParity
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis)
    (initial : ProfiledOpenSemanticObservation A strategy hwin basis) :
    (profiledOpenSemanticTreeMonitor A strategy hwin basis initial).WinningTree
        (profiledOpenSemanticMoveTree A strategy hwin basis initial) ↔
      ProfiledOpenSemanticGlobalParity A strategy hwin basis initial := by
  rw [observableThreadTreeMonitor_winning_iff]
  constructor
  · exact fun h => h.2
  · intro hparity
    exact ⟨profiledOpenSemanticMoveTree_valid A strategy hwin basis initial,
      hparity⟩

/-- Once the genuine global parity theorem is established, ordinary checked
Rabin extraction produces the finite observable table. -/
theorem exists_finite_profiledOpenSemanticTable_of_globalParity
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis)
    (initial : ProfiledOpenSemanticObservation A strategy hwin basis)
    (hparity : ProfiledOpenSemanticGlobalParity A strategy hwin basis initial) :
    ∃ table : RunParityTreeAutomaton.StateControlledTreeTable
        (profiledOpenSemanticTreeMonitor A strategy hwin basis initial).toRunAutomaton,
      (profiledOpenSemanticTreeMonitor A strategy hwin basis initial).WinningTree
        table.toTransitionRationalTree.labeledTree := by
  apply exists_stateControlled_observableThreadTree_of_winning
    (profiledOpenSemanticThreadSystem A strategy hwin basis initial) initial
    (fun observation move =>
      ProfiledOpenObservableMoveValid A observation.public move)
    (profiledOpenSemanticMoveTree A strategy hwin basis initial)
  exact (profiledOpenSemanticMoveTree_winning_iff_globalParity A strategy hwin
    basis initial).2 hparity

end

