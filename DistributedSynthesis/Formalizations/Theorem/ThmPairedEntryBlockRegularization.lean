import DistributedSynthesis.Formalizations.Theorem.ThmPairedEntryRationalPolicy
import DistributedSynthesis.Formalizations.Theorem.ThmBundleDeterminization
import DistributedSynthesis.Formalizations.Theorem.ThmGlobalTreeWinning

/-!
# Finite-branching regularization of paired entry blocks

Macro rationalization leaves a possibly nonregular function on an arbitrarily
long homogeneous block.  This file expands one paired block to the ordinary
finite per-round branching used by sender narrowing.  Its first component is
the deterministic universal DPA for the two pending entry variants.

The closing constraint uses only the finite `PairedRationalPolicy.Allowed`
relation.  The preceding file proves that arbitrary mixing of allowed edges
preserves global switching acceptance, so regularization need not reproduce
the original direction-to-successor function.
-/

namespace DistributedSynthesis

universe u v x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A :
    DetParityAutomaton.{max u v x y, s}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂))

/-- All receiver/full-information responses needed at one interior right-block
node: the ordinary output for both old rows and the process-one output for a
possible `both` close from either row. -/
structure PairedRightReceiverOutput where
  informedFirst : Out₂
  informedBoth : Out₂
  closingFirst : Out₁
  closingBoth : Out₁
deriving Fintype, Inhabited

/-- Finite per-round letter seen by the paired right-block monitor. -/
abbrev PairedRightBlockLetter :=
  RealizedBlockRound In₂ In₁
    (PairedRightReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂)) Out₁

/-- The DPA record selected by one old-row thread from a paired block letter. -/
def pairedRightRecordForRow
    (row : PairedEntryRow)
    (letter : PairedRightBlockLetter
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :
    RoundRecord In₁ In₂ Graph Out₁ Out₂ :=
  match row with
  | .first =>
      rightRoundRecord letter.1 letter.2.2 letter.2.1.informedFirst
  | .both =>
      rightRoundRecord letter.1 letter.2.2 letter.2.1.informedBoth

/-- Two fixed-row DPA threads, with a dummy common root.  The resolution is
used only on the first transition; afterwards the selected row is retained. -/
def pairedRightThreadSystem
    (code : A.State × A.State) :
    FiniteThreadSystem
      (PairedRightBlockLetter
        (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) where
  State := PUnit ⊕ (PairedEntryRow × A.State)
  stateFinite := inferInstance
  initial := Sum.inl PUnit.unit
  Resolution := PairedEntryRow
  step state letter resolution :=
    match state with
    | Sum.inl _ =>
        let start := match resolution with
          | .first => code.1
          | .both => code.2
        Sum.inr (resolution,
          A.step start (pairedRightRecordForRow resolution letter))
    | Sum.inr (row, current) =>
        Sum.inr (row, A.step current (pairedRightRecordForRow row letter))
  priority state :=
    match state with
    | Sum.inl _ => 0
    | Sum.inr (_, current) => A.priority current

/-- Per-round word generated by a paired right lambda. -/
def pairedRightBlockWord
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (env : Nat -> In₂ × In₁) :
    OmegaWord
      (PairedRightBlockLetter
        (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :=
  fun n =>
    let past := omegaPrefix env n
    let move := env n
    (move,
      ⟨lambda.informedLeft past move,
        lambda.informedBoth past move,
        lambda.bothOneLeft past move,
        lambda.bothOneBoth past move⟩,
      lambda.blind (senderWord past) move.2)

/-- The finite letter presented at one block node. -/
def pairedRightBlockLetterAt
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (past : List (In₂ × In₁)) (move : In₂ × In₁) :
    PairedRightBlockLetter
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂) :=
  (move,
    ⟨lambda.informedLeft past move,
      lambda.informedBoth past move,
      lambda.bothOneLeft past move,
      lambda.bothOneBoth past move⟩,
    lambda.blind (senderWord past) move.2)

theorem pairedRightBlockWord_eq_letterAt
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (env : Nat -> In₂ × In₁) (n : Nat) :
    pairedRightBlockWord lambda env n =
      pairedRightBlockLetterAt lambda (omegaPrefix env n) (env n) := rfl

/-- Appending one move appends exactly its locally generated DPA record. -/
theorem pairedRightWordFrom_append_singleton
    (blind : SenderBlockStrategy In₁ Out₁)
    (informed : ReceiverBlockStrategy In₂ In₁ Out₂)
    (initialPast moves : List (In₂ × In₁)) (move : In₂ × In₁) :
    pairedRightWordFrom blind informed initialPast (moves ++ [move]) =
      pairedRightWordFrom blind informed initialPast moves ++
        [rightRoundRecord move
          (blind (senderWord (initialPast ++ moves)) move.2)
          (informed (initialPast ++ moves) move)] := by
  induction moves generalizing initialPast with
  | nil => simp [pairedRightWordFrom]
  | cons first rest ih =>
      simp only [List.cons_append, pairedRightWordFrom]
      rw [ih (initialPast ++ [first])]
      simp [List.append_assoc]

/-- Finite scan state: current DPA state and minimum-priority representative,
for each of the two old entry rows. -/
abbrev PairedRightScanState :=
  (A.State × A.State) × (A.State × A.State)

theorem blockEndAndMin_fst_eq_foldl
    (state : A.State)
    (word : List (RoundRecord In₁ In₂ Graph Out₁ Out₂)) :
    (blockEndAndMin A state word).1 = word.foldl A.step state := by
  induction word using List.reverseRecOn with
  | nil => rfl
  | append_singleton word record ih =>
      rw [blockEndAndMin_snoc, List.foldl_append]
      simp [ih]

def pairedRightScanInitial (code : A.State × A.State) :
    PairedRightScanState A :=
  (code, code)

def pairedRightScanStep
    (scan : PairedRightScanState A)
    (letter : PairedRightBlockLetter
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :
    PairedRightScanState A :=
  let nextFirst := A.step scan.1.1
    (pairedRightRecordForRow .first letter)
  let nextBoth := A.step scan.1.2
    (pairedRightRecordForRow .both letter)
  ((nextFirst, nextBoth),
    (A.minPriorityState scan.2.1 nextFirst,
      A.minPriorityState scan.2.2 nextBoth))

/-- Mathematical scan after a concrete lambda prefix. -/
def pairedRightScanAfter
    (code : A.State × A.State)
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (past : List (In₂ × In₁)) : PairedRightScanState A :=
  ((pairedRightSuccessorCode A code lambda past),
    (blockMinState A code.1 (lambda.leftWord past),
      blockMinState A code.2 (lambda.bothWord past)))

@[simp]
theorem pairedRightScanAfter_nil
    (code : A.State × A.State)
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :
    pairedRightScanAfter A code lambda [] = pairedRightScanInitial A code := by
  rfl

/-- The mathematical scan obeys the finite per-letter update. -/
theorem pairedRightScanAfter_append
    (code : A.State × A.State)
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (past : List (In₂ × In₁)) (move : In₂ × In₁) :
    pairedRightScanAfter A code lambda (past ++ [move]) =
      pairedRightScanStep A (pairedRightScanAfter A code lambda past)
        (pairedRightBlockLetterAt lambda past move) := by
  have hleft := pairedRightWordFrom_append_singleton
    lambda.blind lambda.informedLeft [] past move
  have hboth := pairedRightWordFrom_append_singleton
    lambda.blind lambda.informedBoth [] past move
  simp only [List.nil_append] at hleft hboth
  unfold pairedRightScanAfter pairedRightSuccessorCode
  simp only [ProcOnePairedRightLambda.leftWord,
    ProcOnePairedRightLambda.bothWord]
  rw [hleft, hboth, List.foldl_append, List.foldl_append]
  simp only [blockMinState]
  rw [
    blockEndAndMin_snoc, blockEndAndMin_snoc]
  simp [pairedRightScanStep, pairedRightBlockLetterAt,
    pairedRightRecordForRow, blockEndAndMin_fst_eq_foldl]

/-- The fresh paired child computed from a scan and one possible close. -/
def pairedRightCloseTarget
    (scan : PairedRightScanState A) (row : PairedEntryRow)
    (letter : PairedRightBlockLetter
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :
    PairedEntryTreeState A :=
  let current := match row with | .first => scan.1.1 | .both => scan.1.2
  let minimum := match row with | .first => scan.2.1 | .both => scan.2.2
  let informed := match row with
    | .first => letter.2.1.informedFirst
    | .both => letter.2.1.informedBoth
  let closing := match row with
    | .first => letter.2.1.closingFirst
    | .both => letter.2.1.closingBoth
  let childCode :=
    (A.step current (rightRoundRecord letter.1 letter.2.2 informed),
      A.step current
        (bothRoundRecord (letter.1.2, letter.1.1) closing informed))
  Sum.inr (Sum.inr (childCode, minimum))

/-- Scan-level closing is definitionally the paired macro child. -/
theorem pairedRightCloseTarget_scanAfter
    (code : A.State × A.State)
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (past : List (In₂ × In₁)) (move : In₂ × In₁)
    (row : PairedEntryRow) :
    pairedRightCloseTarget A (pairedRightScanAfter A code lambda past) row
        (pairedRightBlockLetterAt lambda past move) =
      pairedOneChild A code lambda row past move := by
  cases row <;>
    rfl

/-- Receiver/full-information component of a paired lambda in the product
output alphabet consumed by sender narrowing. -/
def pairedRightReceiverStrategy
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :
    ReceiverBlockStrategy In₂ In₁
      (PairedRightReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂)) :=
  fun past move =>
    ⟨lambda.informedLeft past move,
      lambda.informedBoth past move,
      lambda.bothOneLeft past move,
      lambda.bothOneBoth past move⟩

/-- Blind sender component of the paired lambda. -/
def pairedRightSenderStrategy
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :
    SenderBlockStrategy In₁ Out₁ :=
  lambda.blind

/-- State of the finite paired block monitor: the universal two-row DPA,
the exact two-row DPA/minimum scan, and a sticky closing-safety bit. -/
structure PairedRightMonitorState
    (universalState : Type*) where
  universal : universalState
  scan : PairedRightScanState A
  safe : Bool
deriving Fintype

/- The finite record monitor used to regularize one reachable process-one
macro state.  Its parity component checks T2 for both old rows; its sticky
safety component checks that every possible close remains in `Allowed`. -/
noncomputable def pairedRightBlockMonitor
    {initialState : PairedEntryTreeState A}
    (policy :
      (pairedEntryRunAutomaton A initialState).RationalTransitionPolicy)
    (code : A.State × A.State) (minimum : A.State) :
    BlockRecordMonitor In₂ In₁
      (PairedRightReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂)) Out₁ := by
  classical
  let U := (pairedRightThreadSystem A code).universalRunDPA
  let source : PairedEntryTreeState A := Sum.inr (Sum.inl (code, minimum))
  exact {
    State := U.State × PairedRightScanState A × Bool
    stateFinite := inferInstance
    initial := (U.initial, pairedRightScanInitial A code, true)
    step := fun state letter =>
      let closesSafe :=
        PairedRationalPolicy.Allowed A policy source
            (pairedRightCloseTarget A state.2.1 .first letter) ∧
          PairedRationalPolicy.Allowed A policy source
            (pairedRightCloseTarget A state.2.1 .both letter)
      (U.step state.1 letter,
        pairedRightScanStep A state.2.1 letter,
        state.2.2 && decide closesSafe)
    priority := fun state =>
      if state.2.2 then U.priority state.1 + 2 else 1
  }

/-- The local pair induced by a lambda emits exactly its paired block word. -/
theorem branchNode_eq_omegaPrefix
    (env : Nat -> In₂ × In₁) (n : Nat) :
    branchNode env n = omegaPrefix env n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [branchNode, omegaPrefix_succ, ih]

theorem pairedRight_pairPlay_eq_blockWord
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (env : Nat -> In₂ × In₁) :
    pairPlay (pairedRightReceiverStrategy lambda)
        (pairedRightSenderStrategy lambda) env =
      pairedRightBlockWord lambda env := by
  funext n
  rw [pairPlay, treePlay, treeOfPair, branchNode_eq_omegaPrefix]
  simp [blockLabelApply,
    pairedRightReceiverStrategy, pairedRightSenderStrategy,
    pairedRightBlockWord, senderWord, omegaPrefix]

/-- Exact monitor state along a T2-and-closing-safe lambda play. -/
theorem pairedRightBlockMonitor_run_eq
    {initialState : PairedEntryTreeState A}
    (policy :
      (pairedEntryRunAutomaton A initialState).RationalTransitionPolicy)
    (code : A.State × A.State) (minimum : A.State)
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (hclose : PairedRationalPolicy.ProcessOneCloseSafe
      A policy code minimum lambda)
    (env : Nat -> In₂ × In₁) :
    ∀ n,
      (pairedRightBlockMonitor A policy code minimum).run
          (pairPlay (pairedRightReceiverStrategy lambda)
            (pairedRightSenderStrategy lambda) env) n =
        ((pairedRightThreadSystem A code).universalRunDPA.run
            (pairedRightBlockWord lambda env) n,
          pairedRightScanAfter A code lambda (omegaPrefix env n),
          true) := by
  intro n
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [BlockRecordMonitor.run, ih,
        pairedRight_pairPlay_eq_blockWord lambda env]
      rw [pairedRightBlockWord_eq_letterAt,
        omegaPrefix_succ, pairedRightScanAfter_append]
      have hfirst := hclose .first (omegaPrefix env n) (env n)
      have hboth := hclose .both (omegaPrefix env n) (env n)
      rw [← pairedRightCloseTarget_scanAfter A code lambda
          (omegaPrefix env n) (env n) .first] at hfirst
      rw [← pairedRightCloseTarget_scanAfter A code lambda
          (omegaPrefix env n) (env n) .both] at hboth
      simp [pairedRightBlockMonitor, hfirst, hboth]
      rw [pairedRightBlockWord_eq_letterAt]

/-- Canonical fixed-row thread through the paired block word. -/
def pairedRightThreadRun
    (code : A.State × A.State)
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (env : Nat -> In₂ × In₁) (row : PairedEntryRow) :
    Nat -> (pairedRightThreadSystem A code).State
  | 0 => Sum.inl PUnit.unit
  | n + 1 =>
      let start := match row with | .first => code.1 | .both => code.2
      let word := match row with
        | .first => pairedRightOmegaWord lambda.blind lambda.informedLeft env
        | .both => pairedRightOmegaWord lambda.blind lambda.informedBoth env
      Sum.inr (row, A.runFrom start word (n + 1))

/-- The canonical fixed-row evolution is a thread-system run. -/
theorem pairedRightThreadRun_isRun
    (code : A.State × A.State)
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (env : Nat -> In₂ × In₁) (row : PairedEntryRow) :
    (pairedRightThreadSystem A code).IsRun
      (pairedRightBlockWord lambda env)
      (pairedRightThreadRun A code lambda env row) := by
  constructor
  · rfl
  · intro n
    refine ⟨row, ?_⟩
    cases n with
    | zero =>
        cases row <;> rfl
    | succ n =>
        cases row <;> rfl

/-- T2 for both pending variants implies acceptance by the deterministic
universal-thread DPA on every full-input block word. -/
theorem pairedRightUniversalDPA_accepts_of_forever
    (code : A.State × A.State)
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (hforever : PairedRightForeverAccepts A code lambda)
    (env : Nat -> In₂ × In₁) :
    (pairedRightThreadSystem A code).universalRunDPA.Accepts
      (pairedRightBlockWord lambda env) := by
  rw [FiniteThreadSystem.universalRunDPA_accepts_iff]
  intro q hq
  -- Every run chooses one row on its first transition and then retains it.
  rcases hq with ⟨hqzero, hqstep⟩
  rcases hqstep 0 with ⟨row, hrow⟩
  have htail : ∀ n, q (n + 1) = pairedRightThreadRun A code lambda env row (n + 1) := by
    intro n
    induction n with
    | zero =>
        rw [hqzero] at hrow
        cases row <;>
          simpa [pairedRightThreadRun, pairedRightThreadSystem,
            pairedRightBlockWord, pairedRightRecordForRow,
            pairedRightOmegaWord] using hrow
    | succ n ih =>
        rcases hqstep (n + 1) with ⟨resolution, hnext⟩
        rw [ih] at hnext
        cases row <;> simpa [pairedRightThreadRun, pairedRightThreadSystem] using hnext
  have hshift : NatSeqMinEvenParity
      (fun n => (pairedRightThreadSystem A code).priority (q (n + 1))) := by
    cases row with
    | first =>
        have hparity : NatSeqMinEvenParity
            (fun n => A.priority
              (A.runFrom code.1
                (pairedRightOmegaWord lambda.blind lambda.informedLeft env) n)) :=
          hforever.1 env
        have hparity' : NatSeqMinEvenParity
            (fun n => A.priority
              (A.runFrom code.1
                (pairedRightOmegaWord lambda.blind lambda.informedLeft env)
                (n + 1))) := by
          simpa [Nat.add_comm] using
            (natSeqMinEvenParity_shift _ 1).mpr hparity
        convert hparity' using 1
        funext n
        rw [htail n]
        rfl
    | both =>
        have hparity : NatSeqMinEvenParity
            (fun n => A.priority
              (A.runFrom code.2
                (pairedRightOmegaWord lambda.blind lambda.informedBoth env) n)) :=
          hforever.2 env
        have hparity' : NatSeqMinEvenParity
            (fun n => A.priority
              (A.runFrom code.2
                (pairedRightOmegaWord lambda.blind lambda.informedBoth env)
                (n + 1))) := by
          simpa [Nat.add_comm] using
            (natSeqMinEvenParity_shift _ 1).mpr hparity
        convert hparity' using 1
        funext n
        rw [htail n]
        rfl
  have h := (natSeqMinEvenParity_shift
    (fun n => (pairedRightThreadSystem A code).priority (q n)) 1).mp
      (by simpa [Nat.add_comm] using hshift)
  exact h

/-- A T2-and-closing-safe macro lambda realizes the finite per-round block
monitor. -/
theorem pairedRightBlockMonitor_realizable
    {initialState : PairedEntryTreeState A}
    (policy :
      (pairedEntryRunAutomaton A initialState).RationalTransitionPolicy)
    (code : A.State × A.State) (minimum : A.State)
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (hforever : PairedRightForeverAccepts A code lambda)
    (hclose : PairedRationalPolicy.ProcessOneCloseSafe
      A policy code minimum lambda) :
    ∀ env : Nat -> In₂ × In₁,
      (pairedRightBlockMonitor A policy code minimum).WinsPlay
        (pairPlay (pairedRightReceiverStrategy lambda)
          (pairedRightSenderStrategy lambda) env) := by
  intro env
  have huniversal := pairedRightUniversalDPA_accepts_of_forever
    A code lambda hforever env
  have hparity : NatSeqMinEvenParity
      (fun n =>
        (pairedRightThreadSystem A code).universalRunDPA.priority
          ((pairedRightThreadSystem A code).universalRunDPA.run
            (pairedRightBlockWord lambda env) n)) := by
    exact huniversal
  have hshifted : NatSeqMinEvenParity
      (fun n =>
        (pairedRightThreadSystem A code).universalRunDPA.priority
          ((pairedRightThreadSystem A code).universalRunDPA.run
            (pairedRightBlockWord lambda env) n) + 2) := by
    exact (natSeqMinEvenParity_add_const (d := 2) ⟨1, rfl⟩).mpr hparity
  unfold BlockRecordMonitor.WinsPlay
  convert hshifted using 1
  funext n
  rw [pairedRightBlockMonitor_run_eq A policy code minimum lambda hclose env n]
  simp [pairedRightBlockMonitor]
  rfl

/- Unconditional finite-state regularization of every reachable process-one
block.  The controller branches only on the blind sender's finite input
alphabet; its receiver table is indexed by the finite monitor state. -/
theorem exists_finite_processOneBlockController
    [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
    [DecidableEq In₁] [DecidableEq In₂]
    {initialState : PairedEntryTreeState A}
    (policy :
      (pairedEntryRunAutomaton A initialState).RationalTransitionPolicy)
    (code : A.State × A.State) (minimum : A.State)
    (hreachable : PairedRationalPolicy.Reachable A policy
      (Sum.inr (Sum.inl (code, minimum)))) :
    ∃ controller :
        TransitionRationalTree.{u, max u v x y s, s} In₁
          (NarrowedBlockLabel In₂ In₁
            (PairedRightReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂)) Out₁
            (pairedRightBlockMonitor.{u, v, x, y, s, 0}
              A policy code minimum).State),
      NarrowedAllThreadsWin
        (pairedRightBlockMonitor.{u, v, x, y, s, 0}
          A policy code minimum)
        controller.labeledTree := by
  rcases PairedRationalPolicy.exists_processOneLambda_closeSafe
      A policy code minimum hreachable with
    ⟨lambda, hforever, hclose⟩
  refine (block_realizable_iff_implementable_controller_unconditional
    (pairedRightBlockMonitor.{u, v, x, y, s, 0}
      A policy code minimum)).mp ?_
  exact ⟨pairedRightReceiverStrategy lambda,
    pairedRightSenderStrategy lambda,
    pairedRightBlockMonitor_realizable.{u, v, x, y, s, 0}
      A policy code minimum lambda
      hforever hclose⟩

/-! ## Process-two / left-block mirror -/

structure PairedLeftReceiverOutput where
  informedFirst : Out₁
  informedBoth : Out₁
  closingFirst : Out₂
  closingBoth : Out₂
deriving Fintype, Inhabited

abbrev PairedLeftBlockLetter :=
  RealizedBlockRound In₁ In₂
    (PairedLeftReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂)) Out₂

def pairedLeftRecordForRow
    (row : PairedEntryRow)
    (letter : PairedLeftBlockLetter
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :
    RoundRecord In₁ In₂ Graph Out₁ Out₂ :=
  match row with
  | .first => leftRoundRecord letter.1 letter.2.1.informedFirst letter.2.2
  | .both => leftRoundRecord letter.1 letter.2.1.informedBoth letter.2.2

def pairedLeftThreadSystem
    (code : A.State × A.State) :
    FiniteThreadSystem
      (PairedLeftBlockLetter
        (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) where
  State := PUnit ⊕ (PairedEntryRow × A.State)
  stateFinite := inferInstance
  initial := Sum.inl PUnit.unit
  Resolution := PairedEntryRow
  step state letter resolution :=
    match state with
    | Sum.inl _ =>
        let start := match resolution with
          | .first => code.1
          | .both => code.2
        Sum.inr (resolution, A.step start (pairedLeftRecordForRow resolution letter))
    | Sum.inr (row, current) =>
        Sum.inr (row, A.step current (pairedLeftRecordForRow row letter))
  priority state :=
    match state with
    | Sum.inl _ => 0
    | Sum.inr (_, current) => A.priority current

def pairedLeftBlockLetterAt
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (past : List (In₁ × In₂)) (move : In₁ × In₂) :
    PairedLeftBlockLetter
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂) :=
  (move,
    ⟨lambda.informedRight past move, lambda.informedBoth past move,
      lambda.bothTwoRight past move, lambda.bothTwoBoth past move⟩,
    lambda.blind (senderWord past) move.2)

def pairedLeftBlockWord
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (env : Nat -> In₁ × In₂) :
    OmegaWord
      (PairedLeftBlockLetter
        (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :=
  fun n => pairedLeftBlockLetterAt lambda (omegaPrefix env n) (env n)

theorem pairedLeftWordFrom_append_singleton
    (blind : SenderBlockStrategy In₂ Out₂)
    (informed : ReceiverBlockStrategy In₁ In₂ Out₁)
    (initialPast moves : List (In₁ × In₂)) (move : In₁ × In₂) :
    pairedLeftWordFrom blind informed initialPast (moves ++ [move]) =
      pairedLeftWordFrom blind informed initialPast moves ++
        [leftRoundRecord move
          (informed (initialPast ++ moves) move)
          (blind (senderWord (initialPast ++ moves)) move.2)] := by
  induction moves generalizing initialPast with
  | nil => simp [pairedLeftWordFrom]
  | cons first rest ih =>
      simp only [List.cons_append, pairedLeftWordFrom]
      rw [ih (initialPast ++ [first])]
      simp [List.append_assoc]

abbrev PairedLeftScanState :=
  (A.State × A.State) × (A.State × A.State)

def pairedLeftScanInitial (code : A.State × A.State) : PairedLeftScanState A :=
  (code, code)

def pairedLeftScanStep
    (scan : PairedLeftScanState A)
    (letter : PairedLeftBlockLetter
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :
    PairedLeftScanState A :=
  let nextFirst := A.step scan.1.1 (pairedLeftRecordForRow .first letter)
  let nextBoth := A.step scan.1.2 (pairedLeftRecordForRow .both letter)
  ((nextFirst, nextBoth),
    (A.minPriorityState scan.2.1 nextFirst,
      A.minPriorityState scan.2.2 nextBoth))

def pairedLeftScanAfter
    (code : A.State × A.State)
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (past : List (In₁ × In₂)) : PairedLeftScanState A :=
  (pairedLeftSuccessorCode A code lambda past,
    (blockMinState A code.1 (lambda.rightWord past),
      blockMinState A code.2 (lambda.bothWord past)))

@[simp] theorem pairedLeftScanAfter_nil
    (code : A.State × A.State)
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :
    pairedLeftScanAfter A code lambda [] = pairedLeftScanInitial A code := rfl

theorem pairedLeftScanAfter_append
    (code : A.State × A.State)
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (past : List (In₁ × In₂)) (move : In₁ × In₂) :
    pairedLeftScanAfter A code lambda (past ++ [move]) =
      pairedLeftScanStep A (pairedLeftScanAfter A code lambda past)
        (pairedLeftBlockLetterAt lambda past move) := by
  have hfirst := pairedLeftWordFrom_append_singleton
    lambda.blind lambda.informedRight [] past move
  have hboth := pairedLeftWordFrom_append_singleton
    lambda.blind lambda.informedBoth [] past move
  simp only [List.nil_append] at hfirst hboth
  unfold pairedLeftScanAfter pairedLeftSuccessorCode
  simp only [ProcTwoPairedLeftLambda.rightWord, ProcTwoPairedLeftLambda.bothWord]
  rw [hfirst, hboth, List.foldl_append, List.foldl_append]
  simp only [blockMinState]
  rw [blockEndAndMin_snoc, blockEndAndMin_snoc]
  simp [pairedLeftScanStep, pairedLeftBlockLetterAt, pairedLeftRecordForRow,
    blockEndAndMin_fst_eq_foldl]

def pairedLeftCloseTarget
    (scan : PairedLeftScanState A) (row : PairedEntryRow)
    (letter : PairedLeftBlockLetter
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :
    PairedEntryTreeState A :=
  let current := match row with | .first => scan.1.1 | .both => scan.1.2
  let minimum := match row with | .first => scan.2.1 | .both => scan.2.2
  let informed := match row with
    | .first => letter.2.1.informedFirst | .both => letter.2.1.informedBoth
  let closing := match row with
    | .first => letter.2.1.closingFirst | .both => letter.2.1.closingBoth
  let childCode :=
    (A.step current (leftRoundRecord letter.1 informed letter.2.2),
      A.step current (bothRoundRecord letter.1 informed closing))
  Sum.inr (Sum.inl (childCode, minimum))

theorem pairedLeftCloseTarget_scanAfter
    (code : A.State × A.State)
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (past : List (In₁ × In₂)) (move : In₁ × In₂) (row : PairedEntryRow) :
    pairedLeftCloseTarget A (pairedLeftScanAfter A code lambda past) row
        (pairedLeftBlockLetterAt lambda past move) =
      pairedTwoChild A code lambda row past move := by
  cases row <;> rfl

def pairedLeftReceiverStrategy
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :
    ReceiverBlockStrategy In₁ In₂
      (PairedLeftReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂)) :=
  fun past move =>
    ⟨lambda.informedRight past move, lambda.informedBoth past move,
      lambda.bothTwoRight past move, lambda.bothTwoBoth past move⟩

def pairedLeftSenderStrategy
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :
    SenderBlockStrategy In₂ Out₂ := lambda.blind

noncomputable def pairedLeftBlockMonitor
    {initialState : PairedEntryTreeState A}
    (policy : (pairedEntryRunAutomaton A initialState).RationalTransitionPolicy)
    (code : A.State × A.State) (minimum : A.State) :
    BlockRecordMonitor In₁ In₂
      (PairedLeftReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂)) Out₂ := by
  classical
  let U := (pairedLeftThreadSystem A code).universalRunDPA
  let source : PairedEntryTreeState A := Sum.inr (Sum.inr (code, minimum))
  exact {
    State := U.State × PairedLeftScanState A × Bool
    stateFinite := inferInstance
    initial := (U.initial, pairedLeftScanInitial A code, true)
    step := fun state letter =>
      let closesSafe :=
        PairedRationalPolicy.Allowed A policy source
            (pairedLeftCloseTarget A state.2.1 .first letter) ∧
          PairedRationalPolicy.Allowed A policy source
            (pairedLeftCloseTarget A state.2.1 .both letter)
      (U.step state.1 letter, pairedLeftScanStep A state.2.1 letter,
        state.2.2 && decide closesSafe)
    priority := fun state => if state.2.2 then U.priority state.1 + 2 else 1
  }

theorem pairedLeft_pairPlay_eq_blockWord
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (env : Nat -> In₁ × In₂) :
    pairPlay (pairedLeftReceiverStrategy lambda)
        (pairedLeftSenderStrategy lambda) env = pairedLeftBlockWord lambda env := by
  funext n
  rw [pairPlay, treePlay, treeOfPair, branchNode_eq_omegaPrefix]
  simp [blockLabelApply, pairedLeftReceiverStrategy, pairedLeftSenderStrategy,
    pairedLeftBlockWord, pairedLeftBlockLetterAt, senderWord, omegaPrefix]

theorem pairedLeftBlockMonitor_run_eq
    {initialState : PairedEntryTreeState A}
    (policy : (pairedEntryRunAutomaton A initialState).RationalTransitionPolicy)
    (code : A.State × A.State) (minimum : A.State)
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (hclose : PairedRationalPolicy.ProcessTwoCloseSafe
      A policy code minimum lambda)
    (env : Nat -> In₁ × In₂) :
    ∀ n,
      (pairedLeftBlockMonitor A policy code minimum).run
          (pairPlay (pairedLeftReceiverStrategy lambda)
            (pairedLeftSenderStrategy lambda) env) n =
        ((pairedLeftThreadSystem A code).universalRunDPA.run
            (pairedLeftBlockWord lambda env) n,
          pairedLeftScanAfter A code lambda (omegaPrefix env n), true) := by
  intro n
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [BlockRecordMonitor.run, ih, pairedLeft_pairPlay_eq_blockWord lambda env]
      rw [omegaPrefix_succ, pairedLeftScanAfter_append]
      have hfirst := hclose .first (omegaPrefix env n) (env n)
      have hboth := hclose .both (omegaPrefix env n) (env n)
      rw [← pairedLeftCloseTarget_scanAfter A code lambda
          (omegaPrefix env n) (env n) .first] at hfirst
      rw [← pairedLeftCloseTarget_scanAfter A code lambda
          (omegaPrefix env n) (env n) .both] at hboth
      simp [pairedLeftBlockMonitor, hfirst, hboth, pairedLeftBlockWord]

def pairedLeftThreadRun
    (code : A.State × A.State)
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (env : Nat -> In₁ × In₂) (row : PairedEntryRow) :
    Nat -> (pairedLeftThreadSystem A code).State
  | 0 => Sum.inl PUnit.unit
  | n + 1 =>
      let start := match row with | .first => code.1 | .both => code.2
      let word := match row with
        | .first => pairedLeftOmegaWord lambda.blind lambda.informedRight env
        | .both => pairedLeftOmegaWord lambda.blind lambda.informedBoth env
      Sum.inr (row, A.runFrom start word (n + 1))

theorem pairedLeftUniversalDPA_accepts_of_forever
    (code : A.State × A.State)
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (hforever : PairedLeftForeverAccepts A code lambda)
    (env : Nat -> In₁ × In₂) :
    (pairedLeftThreadSystem A code).universalRunDPA.Accepts
      (pairedLeftBlockWord lambda env) := by
  rw [FiniteThreadSystem.universalRunDPA_accepts_iff]
  intro q hq
  rcases hq with ⟨hqzero, hqstep⟩
  rcases hqstep 0 with ⟨row, hrow⟩
  have htail : ∀ n, q (n + 1) = pairedLeftThreadRun A code lambda env row (n + 1) := by
    intro n
    induction n with
    | zero =>
        rw [hqzero] at hrow
        cases row <;>
          simpa [pairedLeftThreadRun, pairedLeftThreadSystem,
            pairedLeftBlockWord, pairedLeftBlockLetterAt,
            pairedLeftRecordForRow, pairedLeftOmegaWord] using hrow
    | succ n ih =>
        rcases hqstep (n + 1) with ⟨resolution, hnext⟩
        rw [ih] at hnext
        cases row <;> simpa [pairedLeftThreadRun, pairedLeftThreadSystem] using hnext
  have hshift : NatSeqMinEvenParity
      (fun n => (pairedLeftThreadSystem A code).priority (q (n + 1))) := by
    cases row with
    | first =>
        have hp : NatSeqMinEvenParity
            (fun n => A.priority (A.runFrom code.1
              (pairedLeftOmegaWord lambda.blind lambda.informedRight env) n)) :=
          hforever.1 env
        have hp' : NatSeqMinEvenParity
            (fun n => A.priority (A.runFrom code.1
              (pairedLeftOmegaWord lambda.blind lambda.informedRight env) (n + 1))) := by
          simpa [Nat.add_comm] using (natSeqMinEvenParity_shift _ 1).mpr hp
        convert hp' using 1
        funext n
        rw [htail n]
        rfl
    | both =>
        have hp : NatSeqMinEvenParity
            (fun n => A.priority (A.runFrom code.2
              (pairedLeftOmegaWord lambda.blind lambda.informedBoth env) n)) :=
          hforever.2 env
        have hp' : NatSeqMinEvenParity
            (fun n => A.priority (A.runFrom code.2
              (pairedLeftOmegaWord lambda.blind lambda.informedBoth env) (n + 1))) := by
          simpa [Nat.add_comm] using (natSeqMinEvenParity_shift _ 1).mpr hp
        convert hp' using 1
        funext n
        rw [htail n]
        rfl
  exact (natSeqMinEvenParity_shift
    (fun n => (pairedLeftThreadSystem A code).priority (q n)) 1).mp
      (by simpa [Nat.add_comm] using hshift)

theorem pairedLeftBlockMonitor_realizable
    {initialState : PairedEntryTreeState A}
    (policy : (pairedEntryRunAutomaton A initialState).RationalTransitionPolicy)
    (code : A.State × A.State) (minimum : A.State)
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (hforever : PairedLeftForeverAccepts A code lambda)
    (hclose : PairedRationalPolicy.ProcessTwoCloseSafe
      A policy code minimum lambda) :
    ∀ env : Nat -> In₁ × In₂,
      (pairedLeftBlockMonitor A policy code minimum).WinsPlay
        (pairPlay (pairedLeftReceiverStrategy lambda)
          (pairedLeftSenderStrategy lambda) env) := by
  intro env
  have hu := pairedLeftUniversalDPA_accepts_of_forever A code lambda hforever env
  have hp : NatSeqMinEvenParity
      (fun n => (pairedLeftThreadSystem A code).universalRunDPA.priority
        ((pairedLeftThreadSystem A code).universalRunDPA.run
          (pairedLeftBlockWord lambda env) n)) := hu
  have hp' : NatSeqMinEvenParity
      (fun n => (pairedLeftThreadSystem A code).universalRunDPA.priority
        ((pairedLeftThreadSystem A code).universalRunDPA.run
          (pairedLeftBlockWord lambda env) n) + 2) :=
    (natSeqMinEvenParity_add_const (d := 2) ⟨1, rfl⟩).mpr hp
  unfold BlockRecordMonitor.WinsPlay
  convert hp' using 1
  funext n
  rw [pairedLeftBlockMonitor_run_eq A policy code minimum lambda hclose env n]
  simp [pairedLeftBlockMonitor]
  rfl

theorem exists_finite_processTwoBlockController
    [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
    [DecidableEq In₁] [DecidableEq In₂]
    {initialState : PairedEntryTreeState A}
    (policy : (pairedEntryRunAutomaton A initialState).RationalTransitionPolicy)
    (code : A.State × A.State) (minimum : A.State)
    (hreachable : PairedRationalPolicy.Reachable A policy
      (Sum.inr (Sum.inr (code, minimum)))) :
    ∃ controller :
        TransitionRationalTree.{v, max u v x y s, s} In₂
          (NarrowedBlockLabel In₁ In₂
            (PairedLeftReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂)) Out₂
            (pairedLeftBlockMonitor.{u, v, x, y, s, 0}
              A policy code minimum).State),
      NarrowedAllThreadsWin
        (pairedLeftBlockMonitor.{u, v, x, y, s, 0} A policy code minimum)
        controller.labeledTree := by
  rcases PairedRationalPolicy.exists_processTwoLambda_closeSafe
      A policy code minimum hreachable with ⟨lambda, hforever, hclose⟩
  refine (block_realizable_iff_implementable_controller_unconditional
    (pairedLeftBlockMonitor.{u, v, x, y, s, 0} A policy code minimum)).mp ?_
  exact ⟨pairedLeftReceiverStrategy lambda, pairedLeftSenderStrategy lambda,
    pairedLeftBlockMonitor_realizable.{u, v, x, y, s, 0}
      A policy code minimum lambda hforever hclose⟩

/-- Orientation-independent finite block-controller obligation at a macro
state.  The accepting sink needs no controller. -/
def HasFinitePairedBlockController
    {initialState : PairedEntryTreeState A}
    (policy : (pairedEntryRunAutomaton A initialState).RationalTransitionPolicy) :
    PairedEntryTreeState A -> Prop
  | Sum.inl _ => True
  | Sum.inr (Sum.inl (code, minimum)) =>
      ∃ controller :
          TransitionRationalTree.{u, max u v x y s, s} In₁
            (NarrowedBlockLabel In₂ In₁
              (PairedRightReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂)) Out₁
              (pairedRightBlockMonitor.{u, v, x, y, s, 0}
                A policy code minimum).State),
        NarrowedAllThreadsWin
          (pairedRightBlockMonitor.{u, v, x, y, s, 0}
            A policy code minimum) controller.labeledTree
  | Sum.inr (Sum.inr (code, minimum)) =>
      ∃ controller :
          TransitionRationalTree.{v, max u v x y s, s} In₂
            (NarrowedBlockLabel In₁ In₂
              (PairedLeftReceiverOutput (Out₁ := Out₁) (Out₂ := Out₂)) Out₂
              (pairedLeftBlockMonitor.{u, v, x, y, s, 0}
                A policy code minimum).State),
        NarrowedAllThreadsWin
          (pairedLeftBlockMonitor.{u, v, x, y, s, 0}
            A policy code minimum) controller.labeledTree

/-- Every reachable rational macro state has its required finite block
controller.  This is the complete finite-choice input for the local handoff
automaton. -/
theorem hasFinitePairedBlockController_of_reachable
    [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
    [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
    [DecidableEq In₁] [DecidableEq In₂]
    {initialState : PairedEntryTreeState A}
    (policy : (pairedEntryRunAutomaton A initialState).RationalTransitionPolicy)
    (state : PairedEntryTreeState A)
    (hreachable : PairedRationalPolicy.Reachable A policy state) :
    HasFinitePairedBlockController A policy state := by
  rcases state with sink | live
  · trivial
  · rcases live with processOne | processTwo
    · exact exists_finite_processOneBlockController A policy
        processOne.1 processOne.2 hreachable
    · exact exists_finite_processTwoBlockController A policy
        processTwo.1 processTwo.2 hreachable

end DetParityAutomaton

