import DistributedSynthesis.Formalizations.Theorem.ThmPairedProfiledOpenBlockMonitor
import DistributedSynthesis.Formalizations.Lemma.LemFiniteRootFamilyNarrowing

/-!
# Simultaneous pre-policy family moves

This is the corrected dangerous-zone move.  A finite root stores only a
profiled paired state whose continuation language has a rational run.  Two
raw paired entries with the same blind local view are narrowed together
before either continuation policy chooses its root lambda.
-/

namespace DistributedSynthesis

universe u v x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

section

noncomputable section

variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
variable [DecidableEq In₁] [DecidableEq In₂]

/-- Finite right root before selecting an inner transition policy. -/
abbrev ProfiledOpenRightRoot :=
  {live : (((A.State × A.State) × A.State) ×
      RightInitialActionProfile
        (In₁ := In₁) (In₂ := In₂) (Out₂ := Out₂)) //
    (pairedProfiledEntryRunAutomaton A (.inr (.inl live))).HasRationalRun}

/-- Left mirror. -/
abbrev ProfiledOpenLeftRoot :=
  {live : (((A.State × A.State) × A.State) ×
      LeftInitialActionProfile
        (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁)) //
    (pairedProfiledEntryRunAutomaton A (.inr (.inr live))).HasRationalRun}

noncomputable instance : Fintype (ProfiledOpenRightRoot A) := by
  classical
  infer_instance

noncomputable instance : Fintype (ProfiledOpenLeftRoot A) := by
  classical
  infer_instance

noncomputable abbrev profiledOpenRightRootMonitor
    (root : ProfiledOpenRightRoot A) :=
  profiledOpenRightBlockMonitor A root.1.1.1 root.1.1.2 root.1.2

noncomputable abbrev profiledOpenLeftRootMonitor
    (root : ProfiledOpenLeftRoot A) :=
  profiledOpenLeftBlockMonitor A root.1.1.1 root.1.1.2 root.1.2

/-- The raw winning strategy supplies the pre-policy right root. -/
noncomputable def profiledOpenRightRootOfWinning
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (entry : ProcOnePairedEntryRep strategy) (minimum : A.State)
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis) :
    ProfiledOpenRightRoot A := by
  let memory : PairedStrategyMemory A strategy := .processOne entry minimum
  refine ⟨((entry.code, minimum),
    rightInitialFirstProfile entry.lambdaOfStrategy), ?_⟩
  simpa [memory, PairedStrategyMemory.toProfiledTreeState] using
    (memory.profiledHasRationalRun (A := A)
      (basis (PairedStrategyMemory.toProfiledTreeState (A := A) memory))
      (memory.foreverAccepts_of_winning (A := A) hwin)
      (PairedStrategyMemory.switchingAccepts_of_winning hwin memory))

/-- Left mirror. -/
noncomputable def profiledOpenLeftRootOfWinning
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (entry : ProcTwoPairedEntryRep strategy) (minimum : A.State)
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis) :
    ProfiledOpenLeftRoot A := by
  let memory : PairedStrategyMemory A strategy := .processTwo entry minimum
  refine ⟨((entry.code, minimum),
    leftInitialFirstProfile entry.lambdaOfStrategy), ?_⟩
  simpa [memory, PairedStrategyMemory.toProfiledTreeState] using
    (memory.profiledHasRationalRun (A := A)
      (basis (PairedStrategyMemory.toProfiledTreeState (A := A) memory))
      (memory.foreverAccepts_of_winning (A := A) hwin)
      (PairedStrategyMemory.switchingAccepts_of_winning hwin memory))

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- The two open right roots generated by locally indistinguishable semantic
entries have one common sender that wins both monitors. -/
theorem profiledOpenRight_sharedSender_wins
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (entry : Bool → ProcOnePairedEntryRep strategy)
    (minimum : Bool → A.State)
    (hview : currentView Proc.one (entry false).leftHistory =
      currentView Proc.one (entry true).leftHistory)
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis) :
    let root := fun anchor => profiledOpenRightRootOfWinning A strategy hwin
      (entry anchor) (minimum anchor) basis
    let receiver := fun anchor => profiledRightReceiverStrategy A
      (entry anchor).code (entry anchor).lambdaOfStrategy
    ∀ anchor env,
      (profiledOpenRightRootMonitor A (root anchor)).WinsPlay
        (pairPlay (receiver anchor)
          (pairedRightSenderStrategy (entry false).lambdaOfStrategy) env) := by
  dsimp only
  intro anchor env
  have hanchor := profiledOpenRightBlockMonitor_realizable_of_winning A
    strategy hwin (entry anchor) (minimum anchor) basis env
  cases anchor with
  | false => simpa [profiledOpenRightRootOfWinning] using hanchor
  | true =>
      have hsender :
          pairedRightSenderStrategy (entry false).lambdaOfStrategy =
            pairedRightSenderStrategy (entry true).lambdaOfStrategy := by
        unfold pairedRightSenderStrategy
        exact blockSenderOne_eq_of_view_eq strategy hview
      rw [hsender]
      simpa [profiledOpenRightRootOfWinning] using hanchor

/-- The unconditional finite simultaneous right-family table extracted from
the raw winner. -/
noncomputable def profiledOpenRightFamilyTableOfWinning
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (entry : Bool → ProcOnePairedEntryRep strategy)
    (minimum : Bool → A.State)
    (hview : currentView Proc.one (entry false).leftHistory =
      currentView Proc.one (entry true).leftHistory)
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis) :
    let root := fun anchor => profiledOpenRightRootOfWinning A strategy hwin
      (entry anchor) (minimum anchor) basis
    FiniteRootFamilyTable (fun anchor : Bool =>
      profiledOpenRightRootMonitor A (root anchor)) := by
  dsimp only
  let root := fun anchor => profiledOpenRightRootOfWinning A strategy hwin
    (entry anchor) (minimum anchor) basis
  let receiver := fun anchor => profiledRightReceiverStrategy A
    (entry anchor).code (entry anchor).lambdaOfStrategy
  exact finiteRootFamilyTable (fun anchor : Bool =>
      profiledOpenRightRootMonitor A (root anchor)) receiver
    (pairedRightSenderStrategy (entry false).lambdaOfStrategy)
    (profiledOpenRight_sharedSender_wins A strategy hwin entry minimum hview
      basis)

/-- The extracted right-family table satisfies the combined all-thread
certificate, so it is a genuine finite move rather than merely data. -/
theorem profiledOpenRightFamilyTableOfWinning_wins
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (entry : Bool → ProcOnePairedEntryRep strategy)
    (minimum : Bool → A.State)
    (hview : currentView Proc.one (entry false).leftHistory =
      currentView Proc.one (entry true).leftHistory)
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis) :
    let root := fun anchor => profiledOpenRightRootOfWinning A strategy hwin
      (entry anchor) (minimum anchor) basis
    NarrowedAllThreadsWin
      (finiteRootFamilyMonitor (fun anchor : Bool =>
        profiledOpenRightRootMonitor A (root anchor)))
      (profiledOpenRightFamilyTableOfWinning A strategy hwin entry minimum
        hview basis).toTransitionRationalTree.labeledTree := by
  dsimp only
  let root := fun anchor => profiledOpenRightRootOfWinning A strategy hwin
    (entry anchor) (minimum anchor) basis
  let receiver := fun anchor => profiledRightReceiverStrategy A
    (entry anchor).code (entry anchor).lambdaOfStrategy
  simpa [profiledOpenRightFamilyTableOfWinning] using
    (finiteRootFamilyTable_wins (fun anchor : Bool =>
      profiledOpenRightRootMonitor A (root anchor)) receiver
      (pairedRightSenderStrategy (entry false).lambdaOfStrategy)
      (profiledOpenRight_sharedSender_wins A strategy hwin entry minimum hview
        basis))

/-! The left construction is symmetric. -/

omit [Inhabited Out₁] [Inhabited Out₂] in
theorem profiledOpenLeft_sharedSender_wins
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (entry : Bool → ProcTwoPairedEntryRep strategy)
    (minimum : Bool → A.State)
    (hview : currentView Proc.two (entry false).rightHistory =
      currentView Proc.two (entry true).rightHistory)
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis) :
    let root := fun anchor => profiledOpenLeftRootOfWinning A strategy hwin
      (entry anchor) (minimum anchor) basis
    let receiver := fun anchor => profiledLeftReceiverStrategy A
      (entry anchor).code (entry anchor).lambdaOfStrategy
    ∀ anchor env,
      (profiledOpenLeftRootMonitor A (root anchor)).WinsPlay
        (pairPlay (receiver anchor)
          (pairedLeftSenderStrategy (entry false).lambdaOfStrategy) env) := by
  dsimp only
  intro anchor env
  have hanchor := profiledOpenLeftBlockMonitor_realizable_of_winning A
    strategy hwin (entry anchor) (minimum anchor) basis env
  cases anchor with
  | false => simpa [profiledOpenLeftRootOfWinning] using hanchor
  | true =>
      have hsender :
          pairedLeftSenderStrategy (entry false).lambdaOfStrategy =
            pairedLeftSenderStrategy (entry true).lambdaOfStrategy := by
        unfold pairedLeftSenderStrategy
        exact blockSenderTwo_eq_of_view_eq strategy hview
      rw [hsender]
      simpa [profiledOpenLeftRootOfWinning] using hanchor

noncomputable def profiledOpenLeftFamilyTableOfWinning
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (entry : Bool → ProcTwoPairedEntryRep strategy)
    (minimum : Bool → A.State)
    (hview : currentView Proc.two (entry false).rightHistory =
      currentView Proc.two (entry true).rightHistory)
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis) :
    let root := fun anchor => profiledOpenLeftRootOfWinning A strategy hwin
      (entry anchor) (minimum anchor) basis
    FiniteRootFamilyTable (fun anchor : Bool =>
      profiledOpenLeftRootMonitor A (root anchor)) := by
  dsimp only
  let root := fun anchor => profiledOpenLeftRootOfWinning A strategy hwin
    (entry anchor) (minimum anchor) basis
  let receiver := fun anchor => profiledLeftReceiverStrategy A
    (entry anchor).code (entry anchor).lambdaOfStrategy
  exact finiteRootFamilyTable (fun anchor : Bool =>
      profiledOpenLeftRootMonitor A (root anchor)) receiver
    (pairedLeftSenderStrategy (entry false).lambdaOfStrategy)
    (profiledOpenLeft_sharedSender_wins A strategy hwin entry minimum hview
      basis)

theorem profiledOpenLeftFamilyTableOfWinning_wins
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (entry : Bool → ProcTwoPairedEntryRep strategy)
    (minimum : Bool → A.State)
    (hview : currentView Proc.two (entry false).rightHistory =
      currentView Proc.two (entry true).rightHistory)
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis) :
    let root := fun anchor => profiledOpenLeftRootOfWinning A strategy hwin
      (entry anchor) (minimum anchor) basis
    NarrowedAllThreadsWin
      (finiteRootFamilyMonitor (fun anchor : Bool =>
        profiledOpenLeftRootMonitor A (root anchor)))
      (profiledOpenLeftFamilyTableOfWinning A strategy hwin entry minimum
        hview basis).toTransitionRationalTree.labeledTree := by
  dsimp only
  let root := fun anchor => profiledOpenLeftRootOfWinning A strategy hwin
    (entry anchor) (minimum anchor) basis
  let receiver := fun anchor => profiledLeftReceiverStrategy A
    (entry anchor).code (entry anchor).lambdaOfStrategy
  simpa [profiledOpenLeftFamilyTableOfWinning] using
    (finiteRootFamilyTable_wins (fun anchor : Bool =>
      profiledOpenLeftRootMonitor A (root anchor)) receiver
      (pairedLeftSenderStrategy (entry false).lambdaOfStrategy)
      (profiledOpenLeft_sharedSender_wins A strategy hwin entry minimum hview
        basis))

end

end

end DetParityAutomaton

end DistributedSynthesis
