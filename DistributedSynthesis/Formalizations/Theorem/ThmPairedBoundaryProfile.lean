import DistributedSynthesis.Formalizations.Theorem.ThmPairedGuardedBoundaryCommitment

/-!
# Finite profiles at recurrent paired boundaries

The phase-switch overlap needed by the local implementation is a finite
depth-one property.  After a possible close of a right block, the old
receiver's prediction for process one's output on a following `both` round
must equal the first informed output of the fresh left block.  The mirror
condition holds after a left block.

Only the fresh block's `.first` row occurs at first activation: if the new
receiver had received on the preceding round, it already activated on that
round.  This is a reachability/timing fact, not a leader flag available to a
process.

This file isolates the finite functions compared at that boundary and proves
that the raw tree generated by an arbitrary distributed strategy satisfies
the comparison.  No objective or winning assumption is used.
-/

namespace DistributedSynthesis

universe u v x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

section

variable [Inhabited In₁] [Inhabited In₂]

/-- Finite output profile with which a right block closes into a left block. -/
def rightClosingProfile
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (row : PairedEntryRow) (past : List (In₂ × In₁))
    (move : In₂ × In₁) : In₁ × In₂ → Out₁ :=
  fun nextMove =>
    match row with
    | .first => lambda.bothOneLeft (past ++ [move]) (nextMove.2, nextMove.1)
    | .both => lambda.bothOneBoth (past ++ [move]) (nextMove.2, nextMove.1)

/-- The `.first`-row informed profile of a newly entered left block. -/
def leftInitialFirstProfile
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :
    In₁ × In₂ → Out₁ :=
  lambda.informedRight []

/-- Finite output profile with which a left block closes into a right block. -/
def leftClosingProfile
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (row : PairedEntryRow) (past : List (In₁ × In₂))
    (move : In₁ × In₂) : In₂ × In₁ → Out₂ :=
  fun nextMove =>
    match row with
    | .first => lambda.bothTwoRight (past ++ [move]) (nextMove.2, nextMove.1)
    | .both => lambda.bothTwoBoth (past ++ [move]) (nextMove.2, nextMove.1)

/-- The `.first`-row informed profile of a newly entered right block. -/
def rightInitialFirstProfile
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) :
    In₂ × In₁ → Out₂ :=
  lambda.informedLeft []

/-- A raw strategy-generated right-to-left edge has matching finite boundary
profiles.  This is local-view consistency, independent of acceptance. -/
theorem rightClosingProfile_lambdaOfStrategy
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (entry : ProcOnePairedEntryRep strategy)
    (row : PairedEntryRow) (past : List (In₂ × In₁))
    (move : In₂ × In₁) :
    let child := match row with
      | .first => procTwoFreshPair strategy
          (extendPrefix strategy entry.leftHistory (past.map rightEnvironment))
          (strategyGenerated_extendPrefix_basic strategy entry.leftGenerated _)
          move.2 move.1
      | .both => procTwoFreshPair strategy
          (extendPrefix strategy entry.bothHistory (past.map rightEnvironment))
          (strategyGenerated_extendPrefix_basic strategy entry.bothGenerated _)
          move.2 move.1
    rightClosingProfile entry.lambdaOfStrategy row past move =
      leftInitialFirstProfile child.lambdaOfStrategy := by
  funext nextMove
  cases row <;>
    simp only [rightClosingProfile, leftInitialFirstProfile,
      ProcOnePairedEntryRep.lambdaOfStrategy,
      ProcTwoPairedEntryRep.lambdaOfStrategy, procTwoFreshPair] <;>
    rw [blockReceiverOne_eq_both, List.map_append, List.map_singleton,
      extendPrefix_snoc] <;>
    rfl

/-- Mirror raw-strategy boundary equality. -/
theorem leftClosingProfile_lambdaOfStrategy
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (entry : ProcTwoPairedEntryRep strategy)
    (row : PairedEntryRow) (past : List (In₁ × In₂))
    (move : In₁ × In₂) :
    let child := match row with
      | .first => procOneFreshPair strategy
          (extendPrefix strategy entry.rightHistory (past.map leftEnvironment))
          (strategyGenerated_extendPrefix_basic strategy entry.rightGenerated _)
          move.1 move.2
      | .both => procOneFreshPair strategy
          (extendPrefix strategy entry.bothHistory (past.map leftEnvironment))
          (strategyGenerated_extendPrefix_basic strategy entry.bothGenerated _)
          move.1 move.2
    leftClosingProfile entry.lambdaOfStrategy row past move =
      rightInitialFirstProfile child.lambdaOfStrategy := by
  funext nextMove
  cases row <;>
    simp only [leftClosingProfile, rightInitialFirstProfile,
      ProcTwoPairedEntryRep.lambdaOfStrategy,
      ProcOnePairedEntryRep.lambdaOfStrategy, procOneFreshPair] <;>
    rw [blockReceiverTwo_eq_both, List.map_append, List.map_singleton,
      extendPrefix_snoc] <;>
    rfl

end

end DetParityAutomaton

end DistributedSynthesis
