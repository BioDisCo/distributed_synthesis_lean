import DistributedSynthesis.Formalizations.Theorem.ThmPairedProfiledOpenPolicyFreeFamilyStep
import DistributedSynthesis.Formalizations.Theorem.ThmPairedEntryBranchFlatten

/-!
# The pointed semantic unfolding and its epoch parity

This file keeps the proof-side semantic representative across arbitrarily many
alternating blocks.  At a live node the next pointed realization is the
literal child returned by the policy-free coherent family table.  The table's
finite history can hide a different semantic history, so every step also
records the recovered `PairedEntryDirection` followed by the raw strategy.

The construction deliberately has no public measurability claim.  It is the
parity coordinate that a future simultaneous public/semantic product must
carry, not yet a public strategy tree.  In particular, neither process is
given the orientation, the selected family member, or a strict-leader bit.
-/

namespace DistributedSynthesis

universe u v x y s

namespace DetParityAutomaton

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}
variable
  (A : DetParityAutomaton.{max u v x y, s}
    (RoundRecord In₁ In₂ Graph Out₁ Out₂))

section

noncomputable section

variable [Inhabited In₁] [Inhabited In₂] [Inhabited Out₁] [Inhabited Out₂]
variable [Fintype In₁] [Fintype In₂] [Fintype Out₁] [Fintype Out₂]
variable [DecidableEq In₁] [DecidableEq In₂]

/-- A proof-side semantic state.  Live states retain both the finite public
view class and one literal representative generated by the fixed strategy. -/
inductive ProfiledOpenPointedSemanticState
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis) where
  | sink
  | right {source : ProfiledOpenRightViewClass A}
      (pointed : ProfiledOpenRightPointedRealization A strategy hwin basis
        source)
  | left {source : ProfiledOpenLeftViewClass A}
      (pointed : ProfiledOpenLeftPointedRealization A strategy hwin basis
        source)

/-- Forget the finite class and retain exactly the raw operational memory. -/
def ProfiledOpenPointedSemanticState.memory
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis} :
    ProfiledOpenPointedSemanticState A strategy hwin basis →
      PairedStrategyMemory A strategy
  | .sink => .sink
  | .right pointed =>
      .processOne pointed.actualEntry pointed.actualMinimum
  | .left pointed =>
      .processTwo pointed.actualEntry pointed.actualMinimum

/-- The selected classified anchor retained by a semantic state. -/
def ProfiledOpenPointedSemanticState.anchor
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis} :
    ProfiledOpenPointedSemanticState A strategy hwin basis →
      ProfiledOpenClassifiedAnchor A
  | .sink => .sink
  | .right pointed => .right pointed.selected.1
  | .left pointed => .left pointed.selected.1

/-- Epoch priority of the selected root. -/
def ProfiledOpenPointedSemanticState.priority
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (state : ProfiledOpenPointedSemanticState A strategy hwin basis) : Nat :=
  profiledOpenClassifiedAnchorPriority A (state.anchor A)

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- The selected-root priority is exactly the priority of the retained raw
strategy memory. -/
theorem ProfiledOpenPointedSemanticState.priority_eq_memory
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (state : ProfiledOpenPointedSemanticState A strategy hwin basis) :
    state.priority A = pairedEntryPriority A (state.memory A).toTreeState := by
  cases state with
  | sink => rfl
  | @right source pointed =>
      have hroot := pointed.realization.root_eq pointed.selected
      rw [pointed.entry_selected, pointed.minimum_selected] at hroot
      have hvalue : pointed.selected.1.1 =
          ((pointed.actualEntry.code, pointed.actualMinimum),
            rightInitialFirstProfile pointed.actualEntry.lambdaOfStrategy) := by
        rw [← hroot]
        rfl
      simp only [ProfiledOpenPointedSemanticState.priority,
        ProfiledOpenPointedSemanticState.anchor,
        profiledOpenClassifiedAnchorPriority, pairedProfiledEntryPriority,
        erasePairedProfiledState, ProfiledOpenPointedSemanticState.memory,
        PairedStrategyMemory.toTreeState]
      rw [hvalue]
  | @left source pointed =>
      have hroot := pointed.realization.root_eq pointed.selected
      rw [pointed.entry_selected, pointed.minimum_selected] at hroot
      have hvalue : pointed.selected.1.1 =
          ((pointed.actualEntry.code, pointed.actualMinimum),
            leftInitialFirstProfile pointed.actualEntry.lambdaOfStrategy) := by
        rw [← hroot]
        rfl
      simp only [ProfiledOpenPointedSemanticState.priority,
        ProfiledOpenPointedSemanticState.anchor,
        profiledOpenClassifiedAnchorPriority, pairedProfiledEntryPriority,
        erasePairedProfiledState, ProfiledOpenPointedSemanticState.memory,
        PairedStrategyMemory.toTreeState]
      rw [hvalue]

/-- One semantic advance packages the literal child and the raw direction
whose finite history was recovered from coherent-table provenance. -/
structure ProfiledOpenPointedSemanticAdvance
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (current : ProfiledOpenPointedSemanticState A strategy hwin basis) where
  next : ProfiledOpenPointedSemanticState A strategy hwin basis
  recoveredDirection : PairedEntryDirection (In₁ := In₁) (In₂ := In₂)
  memory_step : next.memory A =
    (current.memory A).step (A := A) recoveredDirection

/-- Advance one proof-side semantic state.  A direction of the wrong
orientation goes to the existing even sink.  A compatible direction follows
the selected member of the one common family table and retains its literal
pointed child. -/
noncomputable def profiledOpenPointedSemanticAdvance
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (current : ProfiledOpenPointedSemanticState A strategy hwin basis)
    (requested : PairedEntryDirection (In₁ := In₁) (In₂ := In₂)) :
    ProfiledOpenPointedSemanticAdvance A current := by
  classical
  cases current with
  | sink =>
      exact ⟨.sink, requested, rfl⟩
  | @right source pointed =>
      cases requested with
      | fromTwo row past input =>
          exact ⟨.sink, .fromTwo row past input, rfl⟩
      | fromOne row past input =>
          let hex := exists_profiledOpenRightPolicyFreeFamilyStep A
            pointed.realization pointed.selected row past input
          let semanticPast := Classical.choose hex
          let hchild := Classical.choose_spec hex
          let child := Classical.choose hchild
          have hmemory := (Classical.choose_spec hchild).2.2
          let recoveredPast :=
            semanticPast.map fun old => (old.1.2, old.2)
          refine ⟨.left child, .fromOne row recoveredPast input, ?_⟩
          dsimp only [ProfiledOpenPointedSemanticState.memory, child,
            recoveredPast, semanticPast]
          simpa only [pointed.entry_selected, pointed.minimum_selected] using
            hmemory.symm
  | @left source pointed =>
      cases requested with
      | fromOne row past input =>
          exact ⟨.sink, .fromOne row past input, rfl⟩
      | fromTwo row past input =>
          let hex := exists_profiledOpenLeftPolicyFreeFamilyStep A
            pointed.realization pointed.selected row past input
          let semanticPast := Classical.choose hex
          let hchild := Classical.choose_spec hex
          let child := Classical.choose hchild
          have hmemory := (Classical.choose_spec hchild).2.2
          let recoveredPast :=
            semanticPast.map fun old => (old.1.2, old.2)
          refine ⟨.right child, .fromTwo row recoveredPast input, ?_⟩
          dsimp only [ProfiledOpenPointedSemanticState.memory, child,
            recoveredPast, semanticPast]
          simpa only [pointed.entry_selected, pointed.minimum_selected] using
            hmemory.symm

/-- State component of one semantic advance. -/
noncomputable def profiledOpenPointedSemanticStep
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (current : ProfiledOpenPointedSemanticState A strategy hwin basis)
    (requested : PairedEntryDirection (In₁ := In₁) (In₂ := In₂)) :
    ProfiledOpenPointedSemanticState A strategy hwin basis :=
  (profiledOpenPointedSemanticAdvance A current requested).next

/-- Raw direction recovered by one semantic advance. -/
noncomputable def profiledOpenPointedRecoveredDirection
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (current : ProfiledOpenPointedSemanticState A strategy hwin basis)
    (requested : PairedEntryDirection (In₁ := In₁) (In₂ := In₂)) :
    PairedEntryDirection (In₁ := In₁) (In₂ := In₂) :=
  (profiledOpenPointedSemanticAdvance A current requested).recoveredDirection

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- The memory projection commutes with every semantic step. -/
theorem profiledOpenPointedSemanticStep_memory
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (current : ProfiledOpenPointedSemanticState A strategy hwin basis)
    (requested : PairedEntryDirection (In₁ := In₁) (In₂ := In₂)) :
    (profiledOpenPointedSemanticStep A current requested).memory A =
      (current.memory A).step (A := A)
        (profiledOpenPointedRecoveredDirection A current requested) :=
  (profiledOpenPointedSemanticAdvance A current requested).memory_step

/-- Arbitrary finite semantic unfolding. -/
noncomputable def profiledOpenPointedSemanticAtNode
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (initial : ProfiledOpenPointedSemanticState A strategy hwin basis) :
    List (PairedEntryDirection (In₁ := In₁) (In₂ := In₂)) →
      ProfiledOpenPointedSemanticState A strategy hwin basis
  | [] => initial
  | requested :: tail =>
      profiledOpenPointedSemanticAtNode
        (profiledOpenPointedSemanticStep A initial requested) tail

/-- Recover the genuine raw-strategy direction list followed by a finite
semantic unfolding. -/
noncomputable def profiledOpenPointedRecoveredNode
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (initial : ProfiledOpenPointedSemanticState A strategy hwin basis) :
    List (PairedEntryDirection (In₁ := In₁) (In₂ := In₂)) →
      List (PairedEntryDirection (In₁ := In₁) (In₂ := In₂))
  | [] => []
  | requested :: tail =>
      profiledOpenPointedRecoveredDirection A initial requested ::
        profiledOpenPointedRecoveredNode
          (profiledOpenPointedSemanticStep A initial requested) tail

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- Finite-path commutation: the semantic unfolding projects to the raw
strategy memory reached along the recovered direction list. -/
theorem profiledOpenPointedSemanticAtNode_memory
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (initial : ProfiledOpenPointedSemanticState A strategy hwin basis)
    (node : List (PairedEntryDirection (In₁ := In₁) (In₂ := In₂))) :
    (profiledOpenPointedSemanticAtNode A initial node).memory A =
      PairedStrategyMemory.atNode (A := A) (initial.memory A)
        (profiledOpenPointedRecoveredNode A initial node) := by
  induction node generalizing initial with
  | nil => rfl
  | cons requested tail ih =>
      rw [profiledOpenPointedSemanticAtNode,
        profiledOpenPointedRecoveredNode, ih]
      change List.foldl (PairedStrategyMemory.step (A := A))
          ((profiledOpenPointedSemanticStep A initial requested).memory A)
          (profiledOpenPointedRecoveredNode A
            (profiledOpenPointedSemanticStep A initial requested) tail) =
        List.foldl (PairedStrategyMemory.step (A := A))
          ((initial.memory A).step (A := A)
            (profiledOpenPointedRecoveredDirection A initial requested))
          (profiledOpenPointedRecoveredNode A
            (profiledOpenPointedSemanticStep A initial requested) tail)
      rw [profiledOpenPointedSemanticStep_memory A initial requested]

omit [Inhabited Out₁] [Inhabited Out₂] in
/-- Stateful recovery distributes over concatenation when the second list is
started at the semantic state reached by the first. -/
theorem profiledOpenPointedRecoveredNode_append
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (initial : ProfiledOpenPointedSemanticState A strategy hwin basis)
    (head suffix :
      List (PairedEntryDirection (In₁ := In₁) (In₂ := In₂))) :
    profiledOpenPointedRecoveredNode A initial (head ++ suffix) =
      profiledOpenPointedRecoveredNode A initial head ++
        profiledOpenPointedRecoveredNode A
          (profiledOpenPointedSemanticAtNode A initial head) suffix := by
  induction head generalizing initial with
  | nil => rfl
  | cons requested tail ih =>
      simp only [List.cons_append, profiledOpenPointedRecoveredNode,
        profiledOpenPointedSemanticAtNode, List.cons.injEq, true_and]
      exact ih (profiledOpenPointedSemanticStep A initial requested)

/-- State at time `n` of an infinite requested branch. -/
noncomputable def profiledOpenPointedSemanticAt
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (initial : ProfiledOpenPointedSemanticState A strategy hwin basis)
    (branch : Nat → PairedEntryDirection (In₁ := In₁) (In₂ := In₂))
    (n : Nat) : ProfiledOpenPointedSemanticState A strategy hwin basis :=
  profiledOpenPointedSemanticAtNode A initial (branchNode branch n)

/-- Infinite branch of recovered raw directions. -/
noncomputable def profiledOpenPointedRecoveredBranch
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (initial : ProfiledOpenPointedSemanticState A strategy hwin basis)
    (branch : Nat → PairedEntryDirection (In₁ := In₁) (In₂ := In₂))
    (n : Nat) : PairedEntryDirection (In₁ := In₁) (In₂ := In₂) :=
  profiledOpenPointedRecoveredDirection A
    (profiledOpenPointedSemanticAt A initial branch n) (branch n)

section
omit [Inhabited Out₁] [Inhabited Out₂]

/-- Recovered finite prefixes agree with the recovered infinite branch. -/
theorem profiledOpenPointedRecoveredNode_branchNode
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (initial : ProfiledOpenPointedSemanticState A strategy hwin basis)
    (branch : Nat → PairedEntryDirection (In₁ := In₁) (In₂ := In₂))
    (n : Nat) :
    profiledOpenPointedRecoveredNode A initial (branchNode branch n) =
      branchNode (profiledOpenPointedRecoveredBranch A initial branch) n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [show branchNode branch (n + 1) =
        branchNode branch n ++ [branch n] from rfl]
      rw [show branchNode
        (profiledOpenPointedRecoveredBranch A initial branch) (n + 1) =
          branchNode (profiledOpenPointedRecoveredBranch A initial branch) n ++
            [profiledOpenPointedRecoveredBranch A initial branch n] from rfl]
      rw [profiledOpenPointedRecoveredNode_append, ih]
      rfl

/-- At every time on an infinite requested branch, the retained semantic
memory is exactly the raw-strategy memory at the corresponding recovered
prefix. -/
theorem profiledOpenPointedSemanticAt_memory
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    {hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env)}
    {basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis}
    (initial : ProfiledOpenPointedSemanticState A strategy hwin basis)
    (branch : Nat → PairedEntryDirection (In₁ := In₁) (In₂ := In₂))
    (n : Nat) :
    (profiledOpenPointedSemanticAt A initial branch n).memory A =
      PairedStrategyMemory.atNode (A := A) (initial.memory A)
        (branchNode
          (profiledOpenPointedRecoveredBranch A initial branch) n) := by
  unfold profiledOpenPointedSemanticAt
  rw [profiledOpenPointedSemanticAtNode_memory,
    profiledOpenPointedRecoveredNode_branchNode]

/-- Every infinite branch of the pointed semantic unfolding has min-even
selected epoch priorities.  This follows from the original winning strategy
on the recovered raw direction branch; no rational-policy reset or branch
pasting is used here. -/
theorem profiledOpenPointedSemanticBranch_minEven
    {strategy : StrategyPair In₁ In₂ Out₁ Out₂}
    (hwin : ∀ env : EnvironmentSequence In₁ In₂,
      A.Accepts (execution strategy env))
    (basis : ∀ state : PairedProfiledTreeState A,
      (pairedProfiledEntryRunAutomaton A state).RationalRunBasis)
    (initial : ProfiledOpenPointedSemanticState A strategy hwin basis)
    (branch : Nat → PairedEntryDirection (In₁ := In₁) (In₂ := In₂)) :
    NatSeqMinEvenParity (fun n =>
      (profiledOpenPointedSemanticAt A initial branch n).priority A) := by
  let recovered := profiledOpenPointedRecoveredBranch A initial branch
  have hparity : NatSeqMinEvenParity (fun n =>
      pairedEntryPriority A
        (PairedStrategyMemory.run (A := A) (initial.memory A)
          (branchNode recovered n))) :=
    (PairedStrategyMemory.switchingAccepts_of_winning (A := A) hwin
      (initial.memory A)) recovered
  convert hparity using 1
  funext n
  rw [ProfiledOpenPointedSemanticState.priority_eq_memory,
    profiledOpenPointedSemanticAt_memory]
  rfl

end

