import DistributedSynthesis.Formalizations.Lemma.LemPairedEntryTransitionFactorMirror
import DistributedSynthesis.Formalizations.Theorem.ThmInputFreeRationalRun

/-!
# The alternating paired-entry input-free tree automaton

This is the automaton-level form of the Bérard route.  A tree node represents
one whole pending entry class, not one concrete history.  Its nondeterministic
transition selects the single shared blind lambda and the two informed
fragments.  A direction selects the old concrete row, an arbitrary finite
homogeneous block, and the inputs of the reversing receive.  The successor is
the fresh opposite-orientation pair proved in the two transition-factor files.

The state also carries the minimum-priority representative of the preceding
compressed block.  The fresh acknowledgement choice is not part of the
direction: both alternatives remain one paired child, so priority bookkeeping
does not reintroduce the forbidden split.
-/

namespace DistributedSynthesis

universe u v x y s

variable {In₁ : Type u} {In₂ : Type v} {Out₁ : Type x} {Out₂ : Type y}

namespace DetParityAutomaton

variable
  (A :
    DetParityAutomaton.{max u v x y, s}
      (RoundRecord In₁ In₂ Graph Out₁ Out₂))

/-- Which old row of a paired entry is the real one for this block. -/
inductive PairedEntryRow
  | first
  | both
deriving DecidableEq, Fintype

/-- Directions of the alternating paired tree.  `fromOne` leaves a
process-one pending node through a right block; `fromTwo` is its mirror. -/
inductive PairedEntryDirection
  | fromOne : PairedEntryRow -> List (In₂ × In₁) -> (In₂ × In₁) ->
      PairedEntryDirection
  | fromTwo : PairedEntryRow -> List (In₁ × In₂) -> (In₁ × In₂) ->
      PairedEntryDirection

/-- A finite automaton state: accepting sink, process-one pending pair, or
process-two pending pair.  Each live state stores the paired entry code and
the minimum-priority state of the preceding compressed block. -/
abbrev PairedEntryTreeState :=
  PUnit.{s + 1} ⊕
    ((A.State × A.State) × A.State) ⊕
    ((A.State × A.State) × A.State)

/-- Scan a finite DPA word while retaining a state of minimum priority.  The
starting state is included, while the fresh paired closing states are left to
the next compressed block. -/
def blockEndAndMin
    (state : A.State)
    (word : List (RoundRecord In₁ In₂ Graph Out₁ Out₂)) :
    A.State × A.State :=
  word.foldl
    (fun currentMin record =>
      let next := A.step currentMin.1 record
      (next, A.minPriorityState currentMin.2 next))
    (state, state)

def blockMinState
    (state : A.State)
    (word : List (RoundRecord In₁ In₂ Graph Out₁ Out₂)) : A.State :=
  (blockEndAndMin A state word).2

/-- Finite prefix of an omega word of block inputs. -/
def omegaPrefix {Move : Type*} (env : Nat -> Move) (n : Nat) : List Move :=
  List.ofFn fun i : Fin n => env i

/-- Infinite right-block word generated by one row of a paired lambda. -/
def pairedRightOmegaWord
    (blind : SenderBlockStrategy In₁ Out₁)
    (informed : ReceiverBlockStrategy In₂ In₁ Out₂)
    (env : Nat -> In₂ × In₁) :
    OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) :=
  fun n =>
    let past := omegaPrefix env n
    let move := env n
    rightRoundRecord move (blind (senderWord past) move.2)
      (informed past move)

/-- Infinite left-block mirror. -/
def pairedLeftOmegaWord
    (blind : SenderBlockStrategy In₂ Out₂)
    (informed : ReceiverBlockStrategy In₁ In₂ Out₁)
    (env : Nat -> In₁ × In₂) :
    OmegaWord (RoundRecord In₁ In₂ Graph Out₁ Out₂) :=
  fun n =>
    let past := omegaPrefix env n
    let move := env n
    leftRoundRecord move (informed past move)
      (blind (senderWord past) move.2)

/-- Bérard T2 for a process-one pending node: both possible real rows win if
the right block continues forever. -/
def PairedRightForeverAccepts
    (code : A.State × A.State)
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) : Prop :=
  (∀ env : Nat -> In₂ × In₁,
    A.AcceptsFrom code.1
      (pairedRightOmegaWord lambda.blind lambda.informedLeft env)) ∧
  (∀ env : Nat -> In₂ × In₁,
    A.AcceptsFrom code.2
      (pairedRightOmegaWord lambda.blind lambda.informedBoth env))

/-- Mirror T2 condition. -/
def PairedLeftForeverAccepts
    (code : A.State × A.State)
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂)) : Prop :=
  (∀ env : Nat -> In₁ × In₂,
    A.AcceptsFrom code.1
      (pairedLeftOmegaWord lambda.blind lambda.informedRight env)) ∧
  (∀ env : Nat -> In₁ × In₂,
    A.AcceptsFrom code.2
      (pairedLeftOmegaWord lambda.blind lambda.informedBoth env))

def pairedOneChild
    (code : A.State × A.State)
    (lambda : ProcOnePairedRightLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (row : PairedEntryRow) (past : List (In₂ × In₁))
    (move : In₂ × In₁) : PairedEntryTreeState A :=
  let start := match row with | .first => code.1 | .both => code.2
  let word := match row with
    | .first => lambda.leftWord past
    | .both => lambda.bothWord past
  let childCode := match row with
    | .first => pairedRightFreshChildCodeLeft A code lambda past move
    | .both => pairedRightFreshChildCodeBoth A code lambda past move
  Sum.inr (Sum.inr (childCode, blockMinState A start word))

def pairedTwoChild
    (code : A.State × A.State)
    (lambda : ProcTwoPairedLeftLambda
      (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂))
    (row : PairedEntryRow) (past : List (In₁ × In₂))
    (move : In₁ × In₂) : PairedEntryTreeState A :=
  let start := match row with | .first => code.1 | .both => code.2
  let word := match row with
    | .first => lambda.rightWord past
    | .both => lambda.bothWord past
  let childCode := match row with
    | .first => pairedLeftFreshChildCodeRight A code lambda past move
    | .both => pairedLeftFreshChildCodeBoth A code lambda past move
  Sum.inr (Sum.inl (childCode, blockMinState A start word))

/-- Transition relation of the input-free paired tree automaton. -/
def pairedEntryDelta
    (state : PairedEntryTreeState A)
    (_ : PUnit.{1})
    (children : PairedEntryDirection (In₁ := In₁) (In₂ := In₂) ->
      PairedEntryTreeState A) : Prop :=
  match state with
  | Sum.inl _ => ∀ direction, children direction = Sum.inl PUnit.unit
  | Sum.inr (Sum.inl (code, _)) =>
      ∃ lambda : ProcOnePairedRightLambda
          (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂),
        PairedRightForeverAccepts A code lambda ∧
          ∀ direction,
            children direction =
              match direction with
              | .fromOne row past move => pairedOneChild A code lambda row past move
              | .fromTwo _ _ _ => Sum.inl PUnit.unit
  | Sum.inr (Sum.inr (code, _)) =>
      ∃ lambda : ProcTwoPairedLeftLambda
          (In₁ := In₁) (In₂ := In₂) (Out₁ := Out₁) (Out₂ := Out₂),
        PairedLeftForeverAccepts A code lambda ∧
          ∀ direction,
            children direction =
              match direction with
              | .fromOne _ _ _ => Sum.inl PUnit.unit
              | .fromTwo row past move => pairedTwoChild A code lambda row past move

/-- Priority of the preceding compressed block; the irrelevant sink is even. -/
def pairedEntryPriority : PairedEntryTreeState A -> Nat
  | Sum.inl _ => 0
  | Sum.inr (Sum.inl (_, minimum)) => A.priority minimum
  | Sum.inr (Sum.inr (_, minimum)) => A.priority minimum

/-- The paired-entry input-free automaton from an explicit paired starting
code and initial priority representative. -/
def pairedEntryRunAutomaton
    (initialState : PairedEntryTreeState A) :
    InputFreeRunParityTreeAutomaton
      (PairedEntryDirection (In₁ := In₁) (In₂ := In₂)) where
  State := PairedEntryTreeState A
  stateFinite := inferInstance
  initial := initialState
  delta := pairedEntryDelta A
  priority := pairedEntryPriority A

/-! ## The run supplied by a raw distributed strategy -/

/-- Operational paired-node memory generated from one raw distributed
strategy.  It retains representatives only for proving that the finite
automaton run is legal; `toTreeState` erases them completely. -/
inductive PairedStrategyMemory
    (strategy : StrategyPair In₁ In₂ Out₁ Out₂)
  | sink
  | processOne : ProcOnePairedEntryRep strategy -> A.State ->
      PairedStrategyMemory strategy
  | processTwo : ProcTwoPairedEntryRep strategy -> A.State ->
      PairedStrategyMemory strategy

namespace PairedStrategyMemory

variable {A}
variable {strategy : StrategyPair In₁ In₂ Out₁ Out₂}

def toTreeState : PairedStrategyMemory A strategy -> PairedEntryTreeState A
  | .sink => Sum.inl PUnit.unit
  | .processOne entry minimum =>
      Sum.inr (Sum.inl (entry.code, minimum))
  | .processTwo entry minimum =>
      Sum.inr (Sum.inr (entry.code, minimum))

/-- Follow one compressed direction in the raw strategy tree. -/
def step
    [Inhabited In₁] [Inhabited In₂]
    (memory : PairedStrategyMemory A strategy)
    (direction : PairedEntryDirection (In₁ := In₁) (In₂ := In₂)) :
    PairedStrategyMemory A strategy :=
  match memory, direction with
  | .sink, _ => .sink
  | .processOne _ _, .fromTwo _ _ _ => .sink
  | .processTwo _ _, .fromOne _ _ _ => .sink
  | .processOne entry _, .fromOne .first past move =>
      let lambda := entry.lambdaOfStrategy
      .processTwo
        (procTwoFreshPair strategy
          (extendPrefix strategy entry.leftHistory
            (past.map rightEnvironment))
          (strategyGenerated_extendPrefix_basic strategy
            entry.leftGenerated _)
          move.2 move.1)
        (blockMinState A entry.code.1 (lambda.leftWord past))
  | .processOne entry _, .fromOne .both past move =>
      let lambda := entry.lambdaOfStrategy
      .processTwo
        (procTwoFreshPair strategy
          (extendPrefix strategy entry.bothHistory
            (past.map rightEnvironment))
          (strategyGenerated_extendPrefix_basic strategy
            entry.bothGenerated _)
          move.2 move.1)
        (blockMinState A entry.code.2 (lambda.bothWord past))
  | .processTwo entry _, .fromTwo .first past move =>
      let lambda := entry.lambdaOfStrategy
      .processOne
        (procOneFreshPair strategy
          (extendPrefix strategy entry.rightHistory
            (past.map leftEnvironment))
          (strategyGenerated_extendPrefix_basic strategy
            entry.rightGenerated _)
          move.1 move.2)
        (blockMinState A entry.code.1 (lambda.rightWord past))
  | .processTwo entry _, .fromTwo .both past move =>
      let lambda := entry.lambdaOfStrategy
      .processOne
        (procOneFreshPair strategy
          (extendPrefix strategy entry.bothHistory
            (past.map leftEnvironment))
          (strategyGenerated_extendPrefix_basic strategy
            entry.bothGenerated _)
          move.1 move.2)
        (blockMinState A entry.code.2 (lambda.bothWord past))

/-- The operational successor erases to the history-free automaton child. -/
theorem toTreeState_step
    [Inhabited In₁] [Inhabited In₂]
    (memory : PairedStrategyMemory A strategy)
    (direction : PairedEntryDirection (In₁ := In₁) (In₂ := In₂)) :
    (memory.step (A := A) direction).toTreeState =
      match memory with
      | .sink => Sum.inl PUnit.unit
      | .processOne entry _ =>
          match direction with
          | .fromOne row past move =>
              pairedOneChild A entry.code entry.lambdaOfStrategy row past move
          | .fromTwo _ _ _ => Sum.inl PUnit.unit
      | .processTwo entry _ =>
          match direction with
          | .fromOne _ _ _ => Sum.inl PUnit.unit
          | .fromTwo row past move =>
              pairedTwoChild A entry.code entry.lambdaOfStrategy row past move := by
  cases memory with
  | sink => rfl
  | processOne entry minimum =>
      cases direction with
      | fromTwo row past move => rfl
      | fromOne row past move =>
          cases row with
          | first =>
              simp only [step, toTreeState, pairedOneChild]
              rw [pairedRightFreshChildCodeLeft_lambdaOfStrategy A strategy entry]
          | both =>
              simp only [step, toTreeState, pairedOneChild]
              rw [pairedRightFreshChildCodeBoth_lambdaOfStrategy A strategy entry]
  | processTwo entry minimum =>
      cases direction with
      | fromOne row past move => rfl
      | fromTwo row past move =>
          cases row with
          | first =>
              simp only [step, toTreeState, pairedTwoChild]
              rw [pairedLeftFreshChildCodeRight_lambdaOfStrategy A strategy entry]
          | both =>
              simp only [step, toTreeState, pairedTwoChild]
              rw [pairedLeftFreshChildCodeBoth_lambdaOfStrategy A strategy entry]

def atNode
    [Inhabited In₁] [Inhabited In₂]
    (initial : PairedStrategyMemory A strategy)
    (node : TreeNode (PairedEntryDirection (In₁ := In₁) (In₂ := In₂))) :
    PairedStrategyMemory A strategy :=
  node.foldl (step (A := A)) initial

def run
    [Inhabited In₁] [Inhabited In₂]
    (initial : PairedStrategyMemory A strategy) :
    TreeNode (PairedEntryDirection (In₁ := In₁) (In₂ := In₂)) ->
      PairedEntryTreeState A :=
  fun node => (atNode (A := A) initial node).toTreeState

theorem atNode_append
    [Inhabited In₁] [Inhabited In₂]
    (initial : PairedStrategyMemory A strategy)
    (node : TreeNode (PairedEntryDirection (In₁ := In₁) (In₂ := In₂)))
    (direction : PairedEntryDirection (In₁ := In₁) (In₂ := In₂)) :
    atNode (A := A) initial (node ++ [direction]) =
      (atNode (A := A) initial node).step (A := A) direction := by
  simp [atNode, List.foldl_append]

/-- Local T2 obligation on every paired representative reached by the raw
strategy tree. -/
def ForeverAccepts
    [Inhabited In₁] [Inhabited In₂]
    (initial : PairedStrategyMemory A strategy) : Prop :=
  ∀ node,
    match atNode (A := A) initial node with
    | .sink => True
    | .processOne entry _ =>
        PairedRightForeverAccepts A entry.code entry.lambdaOfStrategy
    | .processTwo entry _ =>
        PairedLeftForeverAccepts A entry.code entry.lambdaOfStrategy

/-- Under the local infinite-block obligations, the raw strategy supplies a
legal run of the paired input-free automaton. -/
theorem isRun
    [Inhabited In₁] [Inhabited In₂]
    (initial : PairedStrategyMemory A strategy)
    (hforever : ForeverAccepts (A := A) initial) :
    (pairedEntryRunAutomaton A initial.toTreeState).IsRun
      InputFreeRunParityTreeAutomaton.uniqueTree
      (run (A := A) initial) := by
  constructor
  · rfl
  · intro node
    change pairedEntryDelta A
      ((atNode (A := A) initial node).toTreeState) (PUnit.unit : PUnit.{1})
      (fun direction => run (A := A) initial (node ++ [direction]))
    cases hmemory : atNode (A := A) initial node with
    | sink =>
        simp only [toTreeState, pairedEntryDelta]
        intro direction
        rw [run, atNode_append, hmemory, toTreeState_step]
    | processOne entry minimum =>
        simp only [toTreeState, pairedEntryDelta]
        refine ⟨entry.lambdaOfStrategy, ?_, ?_⟩
        · simpa [ForeverAccepts, hmemory] using hforever node
        · intro direction
          rw [run, atNode_append, toTreeState_step, hmemory]
    | processTwo entry minimum =>
        simp only [toTreeState, pairedEntryDelta]
        refine ⟨entry.lambdaOfStrategy, ?_, ?_⟩
        · simpa [ForeverAccepts, hmemory] using hforever node
        · intro direction
          rw [run, atNode_append, toTreeState_step, hmemory]

/-- Global switching obligation: every infinite sequence of compressed
directions has accepting parity in the run-state priorities.  The separate
`ForeverAccepts` field handles branches that stop switching and remain in one
homogeneous block forever. -/
def SwitchingAccepts
    [Inhabited In₁] [Inhabited In₂]
    (initial : PairedStrategyMemory A strategy) : Prop :=
  ∀ branch : Nat -> PairedEntryDirection (In₁ := In₁) (In₂ := In₂),
    NatSeqMinEvenParity (fun n =>
      pairedEntryPriority A
        (run (A := A) initial (branchNode branch n)))

/-- The two semantic obligations are exactly sufficient for the raw strategy
tree to be an accepting run of the paired-entry automaton. -/
theorem isAcceptingRun
    [Inhabited In₁] [Inhabited In₂]
    (initial : PairedStrategyMemory A strategy)
    (hforever : ForeverAccepts (A := A) initial)
    (hswitching : SwitchingAccepts (A := A) initial) :
    (pairedEntryRunAutomaton A initial.toTreeState).IsAcceptingRun
      InputFreeRunParityTreeAutomaton.uniqueTree
      (run (A := A) initial) := by
  exact ⟨isRun (A := A) initial hforever, hswitching⟩

/-- Hence the paired-entry input-free language is nonempty. -/
theorem nonemptyLanguage
    [Inhabited In₁] [Inhabited In₂]
    (initial : PairedStrategyMemory A strategy)
    (hforever : ForeverAccepts (A := A) initial)
    (hswitching : SwitchingAccepts (A := A) initial) :
    (pairedEntryRunAutomaton A initial.toTreeState).NonemptyLanguage :=
  ⟨run (A := A) initial, isAcceptingRun (A := A) initial hforever hswitching⟩

/-- Bérard's input-free rational-run basis now applies without any finiteness
assumption on the direction type.  All model-specific work is confined to
the two semantic obligations above. -/
theorem hasRationalRun
    [Inhabited In₁] [Inhabited In₂]
    (initial : PairedStrategyMemory A strategy)
    (basis :
      (pairedEntryRunAutomaton A initial.toTreeState).RationalRunBasis)
    (hforever : ForeverAccepts (A := A) initial)
    (hswitching : SwitchingAccepts (A := A) initial) :
    (pairedEntryRunAutomaton A initial.toTreeState).HasRationalRun :=
  basis (nonemptyLanguage (A := A) initial hforever hswitching)

end PairedStrategyMemory

end DetParityAutomaton

end DistributedSynthesis
