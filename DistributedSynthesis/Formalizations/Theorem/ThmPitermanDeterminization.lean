        recurrentName.val)
    (hgreenE : recurrentName.val < next.1.e.val) :
    ∃ acceptingState sourceNode sourceState,
      A.accepting acceptingState ∧
        live.1.active sourceNode = true ∧
        sourceState ∈ live.1.label sourceNode ∧
        ReachableAfter A A.initial word n sourceState ∧
        SegmentVisitsAccepting A word n 1 sourceState acceptingState ∧
        ReachableAfter A A.initial word (n + 1) acceptingState ∧
        (acceptingState ∈ next.1.label green ∨
          (live.1.name sourceNode).val <
            (((live.1.stage1 A (word n)).stage2 A
              (livePlan A live (word n)).stage2Plan).name green).val) := by
  rcases automaton_run_live_green_stage2Trigger_accepting_segment_green_stage3_or_lower_reachable
      A word hrun htrigger hgreen with
    ⟨acceptingState, sourceNode, sourceState, haccepting, hsourceActive,
      hsourceState, hsourceReachable, hsegment, htargetReachable,
      hgreenOrLower⟩
  refine ⟨acceptingState, sourceNode, sourceState, haccepting, hsourceActive,
    hsourceState, hsourceReachable, hsegment, htargetReachable, ?_⟩
  rcases hgreenOrLower with hstateGreen | hlower
  · exact Or.inl
      (automaton_run_green_event_stage3_label_mem_next A word hrun hnext
        hnextName hgreen hgreenName hgreenE hstateGreen)
  · exact Or.inr hlower

theorem automaton_run_live_green_stage2Trigger_accepting_segment_reachable
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live : LiveState A}
    (hrun : (automaton A).run word n = some live)
    {green : Node A}
    (htrigger :
      green ∈ (live.1.stage1 A (word n)).stage2Triggers A)
    (hgreen :
      green ∈
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).greenNodes A) :
    ∃ acceptingState sourceNode sourceState,
      A.accepting acceptingState ∧
        live.1.active sourceNode = true ∧
          sourceState ∈ live.1.label sourceNode ∧
            ReachableAfter A A.initial word n sourceState ∧
            SegmentVisitsAccepting A word n 1 sourceState acceptingState ∧
            ReachableAfter A A.initial word (n + 1) acceptingState ∧
            (acceptingState ∈
                (((live.1.stage1 A (word n)).stage2 A
                  (livePlan A live (word n)).stage2Plan).stage3 A).label
                  green ∨
              ∃ ancestor older,
                ((live.1.stage1 A (word n)).stage2 A
                    (livePlan A live (word n)).stage2Plan).IsAncestorOrSelf A
                  ancestor
                  ((livePlan A live (word n)).stage2Plan.freshChild green) ∧
                ((live.1.stage1 A (word n)).stage2 A
                    (livePlan A live (word n)).stage2Plan).OlderSibling A
                  older ancestor ∧
                acceptingState ∈
                  ((live.1.stage1 A (word n)).stage2 A
                    (livePlan A live (word n)).stage2Plan).label older) := by
  rcases live_green_stage2Trigger_accepting_segment_from_source_or_routes
      A word live htrigger hgreen with
    ⟨acceptingState, sourceNode, sourceState, haccepting, hsourceActive,
      hsourceState, hsegment, hcases⟩
  have hsourceReachable :
      ReachableAfter A A.initial word n sourceState :=
    automaton_run_live_active_label_reachable A word hrun hsourceActive
      hsourceState
  have htargetReachable :
      ReachableAfter A A.initial word (n + 1) acceptingState := by
    have hreach :=
      reachableAfter_of_segmentVisitsAccepting A A.initial word
        hsourceReachable hsegment
    simpa using hreach
  exact ⟨acceptingState, sourceNode, sourceState, haccepting, hsourceActive,
    hsourceState, hsourceReachable, hsegment, htargetReachable, hcases⟩

def StableGreenTriggerSegmentEvent
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (recurrentName : Name A) (N k : Nat) : Prop :=
  N ≤ k ∧
    ∃ prev next : LiveState A,
      (automaton A).run word k = some prev ∧
      (automaton A).run word (k + 1) = some next ∧
      next.1.f = recurrentName ∧
      ∃ green child state,
        green ∈
          (((prev.1.stage1 A (word k)).stage2 A
              (livePlan A prev (word k)).stage2Plan).stage3 A).greenNodes A ∧
        child ∈
          (((prev.1.stage1 A (word k)).stage2 A
              (livePlan A prev (word k)).stage2Plan).stage3 A).children A green ∧
        ((((prev.1.stage1 A (word k)).stage2 A
              (livePlan A prev (word k)).stage2Plan).stage3 A).name
            green).val =
          recurrentName.val ∧
        recurrentName.val < next.1.e.val ∧
        state ∈
          (((prev.1.stage1 A (word k)).stage2 A
              (livePlan A prev (word k)).stage2Plan).stage3 A).label child ∧
        state ∈
          (((prev.1.stage1 A (word k)).stage2 A
              (livePlan A prev (word k)).stage2Plan).stage3 A).label green ∧
        ReachablePrefix A A.initial word (k + 1) state ∧
        (green ∈ (prev.1.stage1 A (word k)).stage2Triggers A ->
          ∃ acceptingState sourceNode sourceState,
            A.accepting acceptingState ∧
              prev.1.active sourceNode = true ∧
              sourceState ∈ prev.1.label sourceNode ∧
              ReachableAfter A A.initial word k sourceState ∧
              SegmentVisitsAccepting A word k 1 sourceState acceptingState ∧
              ReachableAfter A A.initial word (k + 1) acceptingState ∧
              (acceptingState ∈
                  next.1.label green ∨
                (prev.1.name sourceNode).val <
                  (((prev.1.stage1 A (word k)).stage2 A
                    (livePlan A prev (word k)).stage2Plan).name green).val))

theorem StableGreenTriggerSegmentEvent.next_green_reachable_state
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {recurrentName : Name A} {N k : Nat}
    (hevent : StableGreenTriggerSegmentEvent A word recurrentName N k) :
    ∃ prev next : LiveState A,
      (automaton A).run word k = some prev ∧
        (automaton A).run word (k + 1) = some next ∧
        next.1.f = recurrentName ∧
        ∃ green state,
          ((((prev.1.stage1 A (word k)).stage2 A
                (livePlan A prev (word k)).stage2Plan).stage3 A).name
              green).val =
            recurrentName.val ∧
          recurrentName.val < next.1.e.val ∧
          state ∈ next.1.label green ∧
          ReachablePrefix A A.initial word (k + 1) state := by
  rcases hevent with
    ⟨_hNk, prev, next, hprev, hnext, hnextName, green, _child, state,
      hgreen, _hchild, hgreenName, hgreenE, _hstateChild, hstateGreen,
      hprefix, _htriggerSegment⟩
  have hstateNext : state ∈ next.1.label green :=
    automaton_run_green_event_stage3_label_mem_next A word hprev hnext
      hnextName hgreen hgreenName hgreenE hstateGreen
  exact ⟨prev, next, hprev, hnext, hnextName, green, state, hgreenName,
    hgreenE, hstateNext, hprefix⟩

theorem StableGreenTriggerSegmentEvent.next_green_label_nonempty
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {recurrentName : Name A} {N k : Nat}
    (hevent : StableGreenTriggerSegmentEvent A word recurrentName N k) :
    ∃ prev next : LiveState A,
      (automaton A).run word k = some prev ∧
