  rcases hfixed with ⟨hnameEvent, _liveFixed, _hrunFixed, _hfixedPayload⟩
  rcases hnameEvent with ⟨hancestorEvent, _liveName, _hrunName,
    _hnamePayload⟩
  rcases hancestorEvent with ⟨hsameChildEvent, _liveAncestor,
    _hrunAncestor, _hancestorPayload⟩
  rcases hsameChildEvent with ⟨hmeasureEvent, _nextSame, _hrunNextSame,
    _hchildSame, _htargetSame⟩
  rcases hmeasureEvent with ⟨hcoveredEvent, _liveMeasure, _nextMeasure,
    _hrunMeasure, _hrunNextMeasure, _hmeasurePayload⟩
  rcases hcoveredEvent with ⟨hsurvivesEvent, _nextCovered,
    _hrunNextCovered, _htargetCovered⟩
  rcases
      settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent_to_coverage_payload
        A run hsurvivesEvent with
    ⟨_livePayload, nextPayload, _hrunPayload, hrunNextPayload, htargetEq,
      haccepting, _hcover⟩
  have hnextPayloadEq : nextPayload = next := by
    have hsome : some nextPayload = some next := by
      rw [← hrunNextPayload, hrunNext]
