theorem live_green_stage2Trigger_routed_accepting_segment_source_name_lt_freshChild
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} (live : LiveState A)
    {green : Node A}
    (htrigger :
      green ∈ (live.1.stage1 A (word n)).stage2Triggers A)
    {acceptingState : A.State}
    (hstateFresh :
      acceptingState ∈
        ((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).label
          ((livePlan A live (word n)).stage2Plan.freshChild green))
    (hnot :
      acceptingState ∉
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label
          ((livePlan A live (word n)).stage2Plan.freshChild green)) :
    ∃ sourceNode sourceState ancestor older,
      live.1.active sourceNode = true ∧
        sourceState ∈ live.1.label sourceNode ∧
        SegmentVisitsAccepting A word n 1 sourceState acceptingState ∧
        ((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).IsAncestorOrSelf A
          ancestor
          ((livePlan A live (word n)).stage2Plan.freshChild green) ∧
        ((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).OlderSibling A older ancestor ∧
        acceptingState ∈
          ((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).label older ∧
        (live.1.name sourceNode).val <
          (((live.1.stage1 A (word n)).stage2 A
              (livePlan A live (word n)).stage2Plan).name
            ((livePlan A live (word n)).stage2Plan.freshChild green)).val := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  rcases stage2_stage3_removed_freshChild_blocked_by_older A t1 plan
      (by simpa [t1] using htrigger)
      (by simpa [t1, plan, t2] using hstateFresh)
      (by simpa [t1, plan, t2] using hnot) with
    ⟨ancestor, older, hancestor, holder, holderState, haccepting⟩
  rcases stage1_stage2_active_label_segment_from_source_name_le
      A live.1 word plan (olderSibling_older_active A t2 holder)
      holderState with
    ⟨sourceNode, sourceState, hsourceActive, hsourceState, hsegment,
      hsourceNameLeOlder⟩
  have hrootActive_t1 :
      t1.active (root A) = true := by
    simpa [t1, stage1_active A live.1 (word n) (root A)] using live.2.1
  rcases live.2 with
    ⟨_hrootActive, _hrootName, hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have ht1RootParent : t1.parent (root A) = root A := by
    simpa [t1, stage1_parent A live.1 (word n) (root A)] using hrootParent
  have ht1ParentInvariant :
      ∀ node, t1.active node = true -> node ≠ root A ->
        t1.active (t1.parent node) = true ∧
          (t1.name (t1.parent node)).val < (t1.name node).val := by
    simpa [t1] using
      (stage1_preserves_parent_active_and_name_lt A live.1 (word n)
        hparentInvariant)
  have ht2RootParent : t2.parent (root A) = root A := by
    simpa [t1, t2] using
      (stage2_root_parent A t1 plan hrootActive_t1).trans ht1RootParent
  have ht2ParentInvariant :
      ∀ node, t2.active node = true -> node ≠ root A ->
        t2.active (t2.parent node) = true ∧
          (t2.name (t2.parent node)).val < (t2.name node).val := by
    simpa [t1, t2] using
      (stage2_preserves_parent_active_and_name_lt A t1 plan
        ht1ParentInvariant)
  have hfreshActive : t2.active (plan.freshChild green) = true :=
    stage2_freshChild_active A t1 plan (by simpa [t1] using htrigger)
  have hancestorLeFresh :
      (t2.name ancestor).val ≤ (t2.name (plan.freshChild green)).val :=
    name_le_of_isAncestorOrSelf A t2 ht2RootParent ht2ParentInvariant
      hfreshActive hancestor
  have hsourceLtFresh :
      (live.1.name sourceNode).val <
        (t2.name (plan.freshChild green)).val := by
    have hsourceLeOlder :
        (live.1.name sourceNode).val ≤ (t2.name older).val := by
      simpa [t1, t2] using hsourceNameLeOlder
    have holderLt : (t2.name older).val < (t2.name ancestor).val :=
      olderSibling_name_lt A t2 holder
    omega
  exact ⟨sourceNode, sourceState, ancestor, older,
    by simpa [stage1] using hsourceActive, hsourceState,
    segmentVisitsAccepting_of_segment_accepting_target A word hsegment
      haccepting,
    by simpa [t1, plan, t2] using hancestor,
    by simpa [t1, plan, t2] using holder,
    by simpa [t1, plan, t2] using holderState,
    by simpa [t1, plan, t2] using hsourceLtFresh⟩

theorem live_green_stage2Trigger_routed_accepting_segment_source_name_lt_green_of_above
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} (live : LiveState A)
    {green ancestor older sourceNode : Node A}
    (hancestorGreen :
