theorem live_green_stage2Trigger_routed_freshChild_case_state_mem_green_stage2
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} (live : LiveState A)
    {green ancestor older : Node A} {acceptingState : A.State}
    (htrigger :
      green ∈ (live.1.stage1 A (word n)).stage2Triggers A)
