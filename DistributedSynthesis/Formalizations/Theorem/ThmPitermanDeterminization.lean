/--
Cutoff-aware cut/source package for accepting child/name/state reachability.
Every selected accepting occurrence is at or after `N`, so eventual
no-smaller hypotheses can be applied directly at the selected cuts.
-/
theorem exists_strict_cuts_after_acceptingChildCoverageChildNameStateReachableAt_split_last
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v child : Node A}
    {a childName : Nat} {target : A.State}
    (N : Nat)
    (hfreq :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingChildCoverageChildNameStateReachableAt A run v child a
          childName target t) :
    ∃ cuts : Nat -> Nat, ∃ sources : Nat -> A.State,
      cuts 0 = 0 ∧
        (∀ i : Nat, cuts i < cuts (i + 1)) ∧
        (∀ i : Nat, N ≤ cuts (i + 1)) ∧
        (∀ i : Nat,
          AcceptingChildCoverageChildNameStateReachableAt A run v child a
            childName target (cuts (i + 1))) ∧
        ∀ i : Nat,
          ReachablePrefix A A.initial word (cuts (i + 1) - 1) (sources i) ∧
            SegmentVisitsAccepting A word (cuts (i + 1) - 1) 1
              (sources i) target := by
  have hfreqAfter :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        (N ≤ t ∧
          AcceptingChildCoverageChildNameStateReachableAt A run v child a
            childName target t) := by
    intro n
    rcases hfreq (max n N) with ⟨t, ht, hevent⟩
    exact ⟨t, le_trans (le_max_left n N) ht,
      le_trans (le_max_right n N) ht, hevent⟩
  rcases exists_strict_cuts_from_zero_of_frequently_at_or_after
      hfreqAfter with
    ⟨cuts, hzero, hstrict, heventsAfter⟩
  have hevents :
      ∀ i : Nat,
        AcceptingChildCoverageChildNameStateReachableAt A run v child a
          childName target (cuts (i + 1)) := by
    intro i
    exact (heventsAfter i).2
  rcases
      exists_sources_strict_cuts_acceptingChildCoverageChildNameStateReachableAt_split_last
        A run hstrict hevents with
    ⟨sources, hsources⟩
  exact ⟨cuts, sources, hzero, hstrict, (fun i => (heventsAfter i).1),
    hevents, hsources⟩

/--
Source-compaction branch in cut/source-sequence form.  Cofinal source-name drops
below `sourceName` concentrate on one smaller source name, then the fixed
accepting target occurrences can be upgraded to reachable strict cuts with a
predecessor source state for each cut.
-/
theorem exists_sourceNameLt_strict_cuts_acceptingNodeNameStateReachableAt_split_last
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextSourceNameLtEvent
          A run v sourceNode child a sourceName childName sourceState target
          uncovered k) :
    ∃ smallerSourceName : Nat,
      smallerSourceName ∈ Finset.range sourceName ∧
        ∃ cuts : Nat -> Nat, ∃ sources : Nat -> A.State,
          cuts 0 = 0 ∧
            (∀ i : Nat, cuts i < cuts (i + 1)) ∧
            (∀ i : Nat,
              AcceptingNodeNameStateReachableAt A run sourceNode
                smallerSourceName target (cuts (i + 1))) ∧
            ∀ i : Nat,
              ReachablePrefix A A.initial word (cuts (i + 1) - 1)
                  (sources i) ∧
                SegmentVisitsAccepting A word (cuts (i + 1) - 1) 1
                  (sources i) target := by
  rcases exists_frequently_acceptingNodeNameStateAt_lt_of_sourceNameLt
      A run hfreq with
    ⟨smallerSourceName, hsmallerSourceName, hfreqAccepting⟩
  have hfreqReachable :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateReachableAt A run sourceNode
          smallerSourceName target t :=
    frequently_acceptingNodeNameStateAt_to_reachable A run hfreqAccepting
  rcases exists_strict_cuts_acceptingNodeNameStateReachableAt
      A run hfreqReachable with
    ⟨cuts, hzero, hstrict, hevents⟩
  rcases exists_sources_strict_cuts_acceptingNodeNameStateReachableAt_split_last
      A run hstrict hevents with
    ⟨sources, hsources⟩
  exact ⟨smallerSourceName, hsmallerSourceName, cuts, sources, hzero,
    hstrict, hevents, hsources⟩

/--
Cutoff-aware source-compaction cut package.  This strengthens
`exists_sourceNameLt_strict_cuts_acceptingNodeNameStateReachableAt_split_last`
with `N ≤ cuts (i+1)` for every selected accepting occurrence, so the eventual
no-smaller hypotheses can be applied at each cut.
-/
theorem exists_sourceNameLt_strict_cuts_after_acceptingNodeNameStateReachableAt_split_last
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    (N : Nat)
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextSourceNameLtEvent
          A run v sourceNode child a sourceName childName sourceState target
          uncovered k) :
    ∃ smallerSourceName : Nat,
      smallerSourceName ∈ Finset.range sourceName ∧
        ∃ cuts : Nat -> Nat, ∃ sources : Nat -> A.State,
          cuts 0 = 0 ∧
            (∀ i : Nat, cuts i < cuts (i + 1)) ∧
            (∀ i : Nat, N ≤ cuts (i + 1)) ∧
            (∀ i : Nat,
              AcceptingNodeNameStateReachableAt A run sourceNode
                smallerSourceName target (cuts (i + 1))) ∧
            ∀ i : Nat,
              ReachablePrefix A A.initial word (cuts (i + 1) - 1)
                  (sources i) ∧
                SegmentVisitsAccepting A word (cuts (i + 1) - 1) 1
                  (sources i) target := by
  rcases exists_frequently_acceptingNodeNameStateAt_lt_of_sourceNameLt
      A run hfreq with
    ⟨smallerSourceName, hsmallerSourceName, hfreqAccepting⟩
  have hfreqReachable :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateReachableAt A run sourceNode
          smallerSourceName target t :=
    frequently_acceptingNodeNameStateAt_to_reachable A run hfreqAccepting
  have hfreqAfter :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        (N ≤ t ∧
          AcceptingNodeNameStateReachableAt A run sourceNode
            smallerSourceName target t) := by
    intro n
    rcases hfreqReachable (max n N) with ⟨t, ht, hevent⟩
    exact ⟨t, le_trans (le_max_left n N) ht,
      le_trans (le_max_right n N) ht, hevent⟩
  rcases exists_strict_cuts_from_zero_of_frequently_at_or_after
      hfreqAfter with
    ⟨cuts, hzero, hstrict, heventsAfter⟩
  have hevents :
      ∀ i : Nat,
        AcceptingNodeNameStateReachableAt A run sourceNode
          smallerSourceName target (cuts (i + 1)) := by
    intro i
    exact (heventsAfter i).2
  rcases exists_sources_strict_cuts_acceptingNodeNameStateReachableAt_split_last
      A run hstrict hevents with
    ⟨sources, hsources⟩
  exact ⟨smallerSourceName, hsmallerSourceName, cuts, sources, hzero,
    hstrict, (fun i => (heventsAfter i).1), hevents, hsources⟩

/--
If smaller ordinary child-coverage names have disappeared after a cutoff, then
no concrete child-coverage witness after that cutoff can have such a smaller
name.  This is the time-local form used by the persistence proof.
-/
theorem not_child_coverage_name_lt_of_eventual_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v child : Node A}
    {a childName t N : Nat} {live : LiveState A}
    (hnoSmaller :
      ∀ t smaller : Nat, N ≤ t ->
        smaller < childName ->
          smaller ∈ Finset.range (Fintype.card A.State) ->
            a < smaller ->
              ¬ SettledChildCoverageNameAt A run v a smaller t)
    (hNt : N ≤ t)
    (hrun : (automaton A).run word t = some live)
    (hchild : child ∈ live.1.children A v)
    (hmem : run.path t ∈ live.1.label child)
    (hsmaller : (live.1.name child).val < childName)
    (hgt : a < (live.1.name child).val) :
    False := by
  have hactive : live.1.active child = true := by
    rw [children, Finset.mem_filter] at hchild
    exact hchild.2.1
  have hcard : (live.1.name child).val ∈
      Finset.range (Fintype.card A.State) := by
    rcases live.2 with
      ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
        _hinactiveLabel, hbound, _hinjective, _hconsecutive, _hproper,
        _hchildSubset, _hsiblingDisjoint⟩
    exact Finset.mem_range.mpr (hbound child hactive)
  exact hnoSmaller t (live.1.name child).val hNt hsmaller hcard hgt
    (settledChildCoverageNameAt_of_child_witness A run hrun hchild hmem rfl hgt)

/--
One-step persistence, stays case: if the run is in a child of `v` with the
selected least recurring coverage name and the trapping step keeps it in the
same child, then the next time is again ordinary coverage by that same name.
Name nonincrease gives `≤`; the post-cutoff no-smaller invariant rules out `<`.
-/
theorem run_path_succ_stays_settledChildCoverageNameAt_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k N : Nat}
    {live next : LiveState A} {v child : Node A} {a childName : Nat}
    (hnoSmaller :
      ∀ t smaller : Nat, N ≤ t ->
        smaller < childName ->
          smaller ∈ Finset.range (Fintype.card A.State) ->
            a < smaller ->
              ¬ SettledChildCoverageNameAt A run v a smaller t)
    (hNk1 : N ≤ k + 1)
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hchild : child ∈ live.1.children A v)
    (hmem : run.path k ∈ live.1.label child)
    (hname : (live.1.name child).val = childName)
    (hnextVName : (next.1.name v).val = a)
    (hstays : run.path (k + 1) ∈ next.1.label child) :
    SettledChildCoverageNameAt A run v a childName (k + 1) := by
  rw [children, Finset.mem_filter] at hchild
  obtain ⟨_, hactive, hneRoot, hparent⟩ := hchild
  have hnextTree : next.1 = liveNextTree A live (word k) :=
    automaton_run_live_nextTree A word hrun hrunNext
  have hactiveNext : next.1.active child = true :=
    active_of_mem_label A next.1 next.2 hstays
  have hparentNext : next.1.parent child = v := by
    rw [hnextTree]
    simp only [liveNextTree]
    rw [transitionWithPlan_preserves_active_node_parent A live.1 (word k)
      (livePlan A live (word k)) hactive]
    exact hparent
  have hchildNext : child ∈ next.1.children A v := by
    rw [children, Finset.mem_filter]
    exact ⟨Finset.mem_univ child, hactiveNext, hneRoot, hparentNext⟩
  have hnameLe : (next.1.name child).val ≤ childName := by
    have hle :=
      automaton_run_live_name_val_le_of_active_next_label
        A word hrun hrunNext hactive hstays
    omega
  have hnameEq : (next.1.name child).val = childName := by
    by_contra hne
    have hlt : (next.1.name child).val < childName := by omega
    have hgt : a < (next.1.name child).val := by
      rcases next.2 with
        ⟨_hrootActive, _hrootName, _hrootParent, hparentInvariant,
          _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
          _hchildSubset, _hsiblingDisjoint⟩
      rw [children, Finset.mem_filter] at hchildNext
      have hp := (hparentInvariant child hchildNext.2.1 hchildNext.2.2.1).2
      rw [hchildNext.2.2.2, hnextVName] at hp
      exact hp
    exact not_child_coverage_name_lt_of_eventual_no_smaller
      A run hnoSmaller hNk1 hrunNext hchildNext hstays hlt hgt
  have hgtFinal : a < childName := by
    rcases next.2 with
      ⟨_hrootActive, _hrootName, _hrootParent, hparentInvariant,
        _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
        _hchildSubset, _hsiblingDisjoint⟩
    have hchildNextSpec := hchildNext
    rw [children, Finset.mem_filter] at hchildNextSpec
    have hp := (hparentInvariant child hchildNextSpec.2.1
      hchildNextSpec.2.2.1).2
    rw [hchildNextSpec.2.2.2, hnextVName, hnameEq] at hp
    exact hp
  exact settledChildCoverageNameAt_of_child_witness
    A run hrunNext hchildNext hstays hnameEq hgtFinal

/--
One-step persistence for the selected least ordinary child-coverage name.  In
the stays case this is `run_path_succ_stays_settledChildCoverageNameAt_of_no_smaller`.
In the blocked case, the settled successor membership in `v` rules out ancestor
blockers; finite older-child iteration yields a final child with a strictly
smaller name, contradicting the post-cutoff no-smaller invariant.
-/
theorem run_path_succ_settledChildCoverageNameAt_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k N : Nat}
    {live next : LiveState A} {v : Node A} {a childName : Nat}
    (hnoSmaller :
      ∀ t smaller : Nat, N ≤ t ->
        smaller < childName ->
          smaller ∈ Finset.range (Fintype.card A.State) ->
            a < smaller ->
              ¬ SettledChildCoverageNameAt A run v a smaller t)
    (hNk1 : N ≤ k + 1)
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hevent : SettledChildCoverageNameAt A run v a childName k)
    (hnextVName : (next.1.name v).val = a)
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    SettledChildCoverageNameAt A run v a childName (k + 1) := by
  classical
  rcases hevent with
    ⟨live0, child, hrun0, hchild, hmem, hname, hgt⟩
  have hlive0 : live0 = live := by
    rw [hrun] at hrun0
    exact (Option.some.inj hrun0).symm
  subst live0
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  have hchildSpec := hchild
  rw [children, Finset.mem_filter] at hchildSpec
  obtain ⟨_, hactiveChild, _hchildNeRoot, _hchildParent⟩ := hchildSpec
  have hnextTree : next.1 = liveNextTree A live (word k) :=
    automaton_run_live_nextTree A word hrun hrunNext
  rcases run_path_succ_trapping_run A run hrun hrunNext hactiveChild hmem with
    hstays | hblocked | hgreen
  · exact run_path_succ_stays_settledChildCoverageNameAt_of_no_smaller
      A run hnoSmaller hNk1 hrun hrunNext hchild hmem hname hnextVName
      hstays
  · have hchildT1 : child ∈ t1.children A v := by
      simpa [t1, stage1_children A live.1 (word k) v] using hchild
    have hchildT2 : child ∈ t2.children A v := by
      exact stage2_preserves_old_child_mem A t1 plan hchildT1
    rcases
        run_path_succ_stage2_child_blocked_older_child_of_settled
          A run hrun hrunNext
          (by simpa [t1, plan, t2] using hchildT2)
          (by simpa [t1, plan, t2] using hblocked)
          hsettle with
      ⟨older, holderChild, holderMem, holderLt⟩
    rcases
        run_path_succ_stage2_child_eventually_persists_witness_of_settled
          A run hrun hrunNext
          (by simpa [t1, plan, t2] using holderChild)
          (by simpa [t1, plan, t2] using holderMem)
          hvNotGreen hsettle with
      ⟨survivor, hsurvivorChild, hsurvivorMem, hsurvivorNameLe⟩
    have hchildNameT2 : (t2.name child).val = childName := by
      have hactiveT1 : t1.active child = true := by
        simpa [t1, stage1_active A live.1 (word k) child] using hactiveChild
      rw [show t2.name child = t1.name child from
        stage2_preserves_active_node_name A t1 plan hactiveT1]
      rw [show t1.name child = live.1.name child from
        stage1_name A live.1 (word k) child]
      exact hname
    have hsurvivorLt : (next.1.name survivor).val < childName := by
      have hleOlder :
          (next.1.name survivor).val ≤ (t2.name older).val := by
        simpa [t1, plan, t2] using hsurvivorNameLe
      have holderLt' : (t2.name older).val < (t2.name child).val := by
        simpa [t1, plan, t2] using holderLt
      omega
    have hsurvivorGt : a < (next.1.name survivor).val := by
      rcases next.2 with
        ⟨_hrootActive, _hrootName, _hrootParent, hparentInvariant,
          _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
          _hchildSubset, _hsiblingDisjoint⟩
      have hsurvivorChildSpec := hsurvivorChild
      rw [children, Finset.mem_filter] at hsurvivorChildSpec
      have hp := (hparentInvariant survivor hsurvivorChildSpec.2.1
        hsurvivorChildSpec.2.2.1).2
      rw [hsurvivorChildSpec.2.2.2, hnextVName] at hp
      exact hp
    exact False.elim
      (not_child_coverage_name_lt_of_eventual_no_smaller
        A run hnoSmaller hNk1 hrunNext hsurvivorChild hsurvivorMem
        hsurvivorLt hsurvivorGt)
  · exact False.elim
      (run_path_succ_green_case_contradiction A run live next hnextTree hchild
        hvNotGreen hgreen hsettle)

/--
Ordinary child-coverage event with both the child node and dynamic child name
fixed.  This is the all-times form needed to turn the coverage branch into an
actual `RunSettlesAtName` witness.
-/
def SettledChildCoverageChildNameAt [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v child : Node A)
    (a childName t : Nat) : Prop :=
  ∃ live,
    (automaton A).run word t = some live ∧
      child ∈ live.1.children A v ∧
      run.path t ∈ live.1.label child ∧
      (live.1.name child).val = childName ∧
      a < childName

/--
An accepting fixed child/name/state occurrence is, in particular, an ordinary
fixed child/name coverage occurrence at the same live time.  This removes the
accepting-state adornment and exposes the paper's "the run is in a son" payload.
-/
theorem acceptingChildCoverageChildNameStateAt_to_settledChildCoverageChildNameAt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v child : Node A}
    {a childName : Nat} {target : A.State} {t : Nat}
    (hevent :
      AcceptingChildCoverageChildNameStateAt A run v child a childName target t) :
    SettledChildCoverageChildNameAt A run v child a childName t := by
  rcases hevent with
    ⟨live, hrun, htargetEq, _haccepting, hchild, htargetMem, hname, hgt⟩
  exact ⟨live, hrun, hchild, by simpa [htargetEq] using htargetMem,
    hname, hgt⟩

/--
Cofinal accepting fixed child/name/state occurrences give cofinal ordinary fixed
child/name coverage occurrences.
-/
theorem frequently_acceptingChildCoverageChildNameStateAt_to_settledChildCoverageChildNameAt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v child : Node A}
    {a childName : Nat} {target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingChildCoverageChildNameStateAt A run v child a childName
          target t) :
    ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
      SettledChildCoverageChildNameAt A run v child a childName t := by
  intro n
  rcases hfreq n with ⟨t, hnt, hevent⟩
  exact ⟨t, hnt,
    acceptingChildCoverageChildNameStateAt_to_settledChildCoverageChildNameAt
      A run hevent⟩

theorem settledChildCoverageChildNameAt_to_nameAt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v child : Node A}
    {a childName t : Nat}
    (hevent :
      SettledChildCoverageChildNameAt A run v child a childName t) :
    SettledChildCoverageNameAt A run v a childName t := by
  rcases hevent with ⟨live, hrun, hchild, hmem, hname, hgt⟩
  exact ⟨live, child, hrun, hchild, hmem, hname, hgt⟩

/--
Finite-node pigeonhole for ordinary coverage at a fixed dynamic name: if a fixed
coverage name recurs arbitrarily late, then some fixed child carries that name
arbitrarily late.
-/
theorem exists_frequently_settledChildCoverageChildNameAt_of_nameAt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a childName : Nat}
    (hfreq :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        SettledChildCoverageNameAt A run v a childName t) :
    ∃ child : Node A,
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        SettledChildCoverageChildNameAt A run v child a childName t := by
  classical
  have hfreqFilter :
      ∃ᶠ t in Filter.atTop,
        ∃ child ∈ (Finset.univ : Finset (Node A)),
          SettledChildCoverageChildNameAt A run v child a childName t := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with
      ⟨t, hnt, live, child, hrun, hchild, hmem, hname, hgt⟩
    exact ⟨t, hnt, child, Finset.mem_univ child,
      live, hrun, hchild, hmem, hname, hgt⟩
  rw [Finset.frequently_exists] at hfreqFilter
  rcases hfreqFilter with ⟨child, _hchildMem, hchildFreq⟩
  refine ⟨child, ?_⟩
  intro n
  exact (Filter.frequently_atTop).1 hchildFreq n

/--
One-step persistence for a fixed child carrying the selected least ordinary
coverage name.  The only real case is the trapping "stays" case; blocked and
green-removal alternatives contradict the settled/non-green/no-smaller regime.
-/
theorem run_path_succ_settledChildCoverageChildNameAt_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k N : Nat}
    {live next : LiveState A} {v child : Node A} {a childName : Nat}
    (hnoSmaller :
      ∀ t smaller : Nat, N ≤ t ->
        smaller < childName ->
          smaller ∈ Finset.range (Fintype.card A.State) ->
            a < smaller ->
              ¬ SettledChildCoverageNameAt A run v a smaller t)
    (hNk1 : N ≤ k + 1)
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hevent :
      SettledChildCoverageChildNameAt A run v child a childName k)
    (hnextVName : (next.1.name v).val = a)
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    SettledChildCoverageChildNameAt A run v child a childName (k + 1) := by
  classical
  rcases hevent with ⟨live0, hrun0, hchild, hmem, hname, hgt⟩
  have hlive0 : live0 = live := by
    rw [hrun] at hrun0
    exact (Option.some.inj hrun0).symm
  subst live0
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  have hchildSpec := hchild
  rw [children, Finset.mem_filter] at hchildSpec
  obtain ⟨_, hactiveChild, hchildNeRoot, hchildParent⟩ := hchildSpec
  have hnextTree : next.1 = liveNextTree A live (word k) :=
    automaton_run_live_nextTree A word hrun hrunNext
  rcases run_path_succ_trapping_run A run hrun hrunNext hactiveChild hmem with
    hstays | hblocked | hgreen
  · have hactiveNext : next.1.active child = true :=
      active_of_mem_label A next.1 next.2 hstays
    have hparentNext : next.1.parent child = v := by
      rw [hnextTree]
      simp only [liveNextTree]
      rw [transitionWithPlan_preserves_active_node_parent A live.1 (word k)
        (livePlan A live (word k)) hactiveChild]
      exact hchildParent
    have hchildNext : child ∈ next.1.children A v := by
      rw [children, Finset.mem_filter]
      exact ⟨Finset.mem_univ child, hactiveNext, hchildNeRoot, hparentNext⟩
    have hnameLe : (next.1.name child).val ≤ childName := by
      have hle :=
        automaton_run_live_name_val_le_of_active_next_label
          A word hrun hrunNext hactiveChild hstays
      omega
    have hnameEq : (next.1.name child).val = childName := by
      by_contra hne
      have hlt : (next.1.name child).val < childName := by omega
      have hgtNext : a < (next.1.name child).val := by
        rcases next.2 with
          ⟨_hrootActive, _hrootName, _hrootParent, hparentInvariant,
            _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
            _hchildSubset, _hsiblingDisjoint⟩
        have hchildNextSpec := hchildNext
        rw [children, Finset.mem_filter] at hchildNextSpec
        have hp := (hparentInvariant child hchildNextSpec.2.1
          hchildNextSpec.2.2.1).2
        rw [hchildNextSpec.2.2.2, hnextVName] at hp
        exact hp
      exact not_child_coverage_name_lt_of_eventual_no_smaller
        A run hnoSmaller hNk1 hrunNext hchildNext hstays hlt hgtNext
    exact ⟨next, hrunNext, hchildNext, hstays, hnameEq, by
      simpa [hnameEq] using hgt⟩
  · have hnameEvent :
        SettledChildCoverageNameAt A run v a childName k :=
      ⟨live, child, hrun, hchild, hmem, hname, hgt⟩
    have hnextEvent :=
      run_path_succ_settledChildCoverageNameAt_of_no_smaller
        A run hnoSmaller hNk1 hrun hrunNext hnameEvent hnextVName
        hvNotGreen hsettle
    rcases hnextEvent with
      ⟨next0, survivor, hrunNext0, hsurvivorChild, hsurvivorMem,
        hsurvivorName, hsurvivorGt⟩
    have hnext0 : next0 = next := by
      rw [hrunNext] at hrunNext0
      exact (Option.some.inj hrunNext0).symm
    subst next0
    rcases
        run_path_succ_stage2_child_blocked_older_child_of_settled
          A run hrun hrunNext
          (by
            have hchildT1 : child ∈ t1.children A v := by
              simpa [t1, stage1_children A live.1 (word k) v] using hchild
            have hchildT2 : child ∈ t2.children A v :=
              stage2_preserves_old_child_mem A t1 plan hchildT1
            simpa [t1, plan, t2] using hchildT2)
          (by simpa [t1, plan, t2] using hblocked)
          hsettle with
      ⟨older, holderChild, holderMem, holderLt⟩
    rcases
        run_path_succ_stage2_child_eventually_persists_witness_of_settled
          A run hrun hrunNext
          (by simpa [t1, plan, t2] using holderChild)
          (by simpa [t1, plan, t2] using holderMem)
          hvNotGreen hsettle with
      ⟨survivor', hsurvivorChild', hsurvivorMem', hsurvivorNameLe⟩
    have hchildNameT2 : (t2.name child).val = childName := by
      have hactiveT1 : t1.active child = true := by
        simpa [t1, stage1_active A live.1 (word k) child] using hactiveChild
      rw [show t2.name child = t1.name child from
        stage2_preserves_active_node_name A t1 plan hactiveT1]
      rw [show t1.name child = live.1.name child from
        stage1_name A live.1 (word k) child]
      exact hname
    have hsurvivorLt : (next.1.name survivor').val < childName := by
      have hleOlder :
          (next.1.name survivor').val ≤ (t2.name older).val := by
        simpa [t1, plan, t2] using hsurvivorNameLe
      have holderLt' : (t2.name older).val < (t2.name child).val := by
        simpa [t1, plan, t2] using holderLt
      omega
    have hsurvivorGt' : a < (next.1.name survivor').val := by
      rcases next.2 with
        ⟨_hrootActive, _hrootName, _hrootParent, hparentInvariant,
          _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
          _hchildSubset, _hsiblingDisjoint⟩
      have hsurvivorChildSpec := hsurvivorChild'
      rw [children, Finset.mem_filter] at hsurvivorChildSpec
      have hp := (hparentInvariant survivor' hsurvivorChildSpec.2.1
        hsurvivorChildSpec.2.2.1).2
      rw [hsurvivorChildSpec.2.2.2, hnextVName] at hp
      exact hp
    exact False.elim
      (not_child_coverage_name_lt_of_eventual_no_smaller
        A run hnoSmaller hNk1 hrunNext hsurvivorChild' hsurvivorMem'
        hsurvivorLt hsurvivorGt')
  · exact False.elim
      (run_path_succ_green_case_contradiction A run live next hnextTree hchild
        hvNotGreen hgreen hsettle)

/--
Coverage branch handler: in the settled non-green regime, if accepting visits
are covered by children of `v` arbitrarily late, then the run settles forever in
some fixed child name `a' > a`.  The proof chooses the least recurring ordinary
coverage name, rules out smaller-name side moves after a cutoff, pigeonholes a
fixed child for that name, and iterates the same-child one-step persistence.
-/
theorem runSettles_coverage_branch_to_runSettlesAtName
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hng : ¬ RunNodeGreensIO A run v)
    (hcoverage :
      ∀ n : Nat, ∃ k live next,
        n ≤ k ∧
          (automaton A).run word k = some live ∧
          (automaton A).run word (k + 1) = some next ∧
          A.accepting (run.path (k + 1)) ∧
          run.path (k + 1) ∈ next.1.childLabelUnion A v) :
    ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a' := by
  classical
  rcases exists_min_frequently_settledChildCoverageNameAt_of_coverage_branch
      A run hsettle hcoverage with
    ⟨childName, _hchildNameMem, hgt, hfreqName, hminimal⟩
  rcases
      exists_eventually_no_smaller_settledChildCoverageNameAt_of_minimal
        A run hminimal with
    ⟨Nsmall, hnoSmaller⟩
  rcases
      exists_frequently_settledChildCoverageChildNameAt_of_nameAt
        A run hfreqName with
    ⟨child, hfreqChild⟩
  rcases exists_eventually_settled_not_green A run hsettle hng with
    ⟨Nregime, hregime⟩
  rcases hfreqChild (max Nsmall Nregime) with
    ⟨t0, ht0Cutoff, ht0Event⟩
  have hNsmall_t0 : Nsmall ≤ t0 := by
    exact le_trans (le_max_left Nsmall Nregime) ht0Cutoff
  have hNregime_t0 : Nregime ≤ t0 := by
    exact le_trans (le_max_right Nsmall Nregime) ht0Cutoff
  have hforever :
      ∀ m : Nat,
        SettledChildCoverageChildNameAt A run v child a childName (t0 + m) := by
    intro m
    induction m with
    | zero =>
        simpa using ht0Event
    | succ m ih =>
        let k := t0 + m
        have hNk : Nregime ≤ k := by
          dsimp [k]
          omega
        have hNk1 : Nregime ≤ k + 1 := by
          omega
        rcases hregime k hNk with
          ⟨⟨live, hrun, _hmemV, _hnameV⟩, hnotGreen⟩
        rcases hregime (k + 1) hNk1 with
          ⟨⟨next, hrunNext, hmemNextV, hnameNextV⟩, _hnotGreenNext⟩
        have hNsmall_k1 : Nsmall ≤ k + 1 := by
          dsimp [k]
          omega
        have hstep :
            SettledChildCoverageChildNameAt A run v child a childName (k + 1) :=
          run_path_succ_settledChildCoverageChildNameAt_of_no_smaller
            A run hnoSmaller hNsmall_k1 hrun hrunNext
            (by simpa [k] using ih) hnameNextV (hnotGreen live hrun)
            hmemNextV
        simpa [k, Nat.add_assoc] using hstep
  refine ⟨childName, hgt, child, t0, ?_⟩
  intro k hk
  have hkeq : t0 + (k - t0) = k := by omega
  have hevent := hforever (k - t0)
  rw [hkeq] at hevent
  rcases hevent with ⟨live, hrun, _hchild, hmem, hname, _hgt⟩
  exact ⟨live, hrun, hmem, hname⟩

/--
Closed descent horn for Piterman proof 4.  If the tracked accepting run has
settled at `v` and `v` does not green infinitely often, then the accepting
successor is child-covered cofinally; the coverage branch theorem then gives a
strictly larger settled name.
-/
theorem runSettles_descendHorn
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hng : ¬ RunNodeGreensIO A run v) :
    ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a' :=
  runSettles_coverage_branch_to_runSettlesAtName A run hsettle hng
    (runSettles_not_green_frequently_accepting_childLabelUnion
      A run hrunAccepts hsettle hng)

/--
Descent horn reduced to the two global settled non-green branches.  The local
construction work now gives a genuine dichotomy; the remaining descent content is
exactly to handle the fixed coverage child/name branch and the fixed lower-source
name branch.
-/
theorem runSettles_descendHorn_of_branch_handlers
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hng : ¬ RunNodeGreensIO A run v)
    (coverageHandler :
      (∃ child childName,
        childName ∈ Finset.range (Fintype.card A.State) ∧
          a < childName ∧
          ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
            SettledCoverageChildNameEvent A run v child a childName k) ->
        ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a')
    (lowerHandler :
      (∃ sourceName,
        sourceName ∈ Finset.range a ∧
          ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
            SettledLowerSourceNameEvent A run sourceName k) ->
        ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a' := by
  rcases
      runSettles_not_green_frequently_childLabelUnion_or_lower_source_branch
        A run hrunAccepts hsettle hng with
    hcoverage | hlower
  · exact coverageHandler
      (exists_frequently_settledCoverageChildNameEvent_of_coverage_branch
        A run hsettle hcoverage)
  · exact lowerHandler
      (exists_frequently_settledLowerSourceNameEvent_of_frequently_lower_source
        A run hlower)

/--
Sharper descent horn endpoint matching the paper's finite sideways-descent
argument: the coverage branch is focused to a fixed child carrying the least
recurring coverage name.  This minimality is what rules out infinitely many
older-sibling moves in the eventual coverage handler.
-/
theorem runSettles_descendHorn_of_minimal_branch_handlers
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hng : ¬ RunNodeGreensIO A run v)
    (coverageHandler :
      (∃ child childName,
        childName ∈ Finset.range (Fintype.card A.State) ∧
          a < childName ∧
          (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
            SettledCoverageChildNameEvent A run v child a childName k) ∧
          ∀ smaller : Nat, smaller < childName ->
            ¬ (smaller ∈ Finset.range (Fintype.card A.State) ∧
                a < smaller ∧
                ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                  SettledCoverageNameEvent A run v a smaller k)) ->
        ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a')
    (lowerHandler :
      (∃ sourceName,
        sourceName ∈ Finset.range a ∧
          ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
            SettledLowerSourceNameEvent A run sourceName k) ->
        ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a' := by
  rcases
      runSettles_not_green_frequently_childLabelUnion_or_lower_source_branch
        A run hrunAccepts hsettle hng with
    hcoverage | hlower
  · exact coverageHandler
      (exists_min_frequently_settledCoverageChildNameEvent_of_coverage_branch
        A run hsettle hcoverage)
  · exact lowerHandler
      (exists_frequently_settledLowerSourceNameEvent_of_frequently_lower_source
        A run hlower)

/--
Descent horn with the coverage branch closed.  The only remaining settled
non-green branch obligation is the fixed lower-source-name case.
-/
theorem runSettles_descendHorn_of_lower_handler
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hng : ¬ RunNodeGreensIO A run v)
    (lowerHandler :
      (∃ sourceName,
        sourceName ∈ Finset.range a ∧
          ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
            SettledLowerSourceNameEvent A run sourceName k) ->
        ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a' := by
  rcases
      runSettles_not_green_frequently_childLabelUnion_or_lower_source_branch
        A run hrunAccepts hsettle hng with
    hcoverage | hlower
  · exact runSettles_coverage_branch_to_runSettlesAtName
      A run hsettle hng hcoverage
  · exact lowerHandler
      (exists_frequently_settledLowerSourceNameEvent_of_frequently_lower_source
        A run hlower)

/--
Descent horn with the lower-source branch pushed through the finite
sideways-descent recursion.  The lower-source name branch is now consumed by
`exists_frequently_settledLowerSourceStage3ChildUnion_of_nameEvent`, so the only
remaining settled non-green obligation is the fixed stage-(3) child-union
coverage endpoint at a fixed source node: recurrent coverage of the fixed
accepting target by the children of a fixed lower source.
-/
theorem runSettles_descendHorn_of_lowerChildUnion_handler
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hng : ¬ RunNodeGreensIO A run v)
    (childUnionHandler :
      (∃ (sn : Nat) (sourceNode : Node A) (sourceState target : A.State),
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceStage3ChildUnionEvent A run sourceNode sn
            sourceState target k) ->
        ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a' := by
  refine runSettles_descendHorn_of_lower_handler A run hrunAccepts
    hsettle hng ?_
  intro hlowerName
  rcases hlowerName with ⟨sourceName, _hmem, hfreqName⟩
  exact childUnionHandler
    (exists_frequently_settledLowerSourceStage3ChildUnion_of_nameEvent
      A run sourceName hfreqName)

/--
Descent horn with the lower-source branch focused to a fixed source node/name.
-/
theorem runSettles_descendHorn_of_lower_node_handler
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hng : ¬ RunNodeGreensIO A run v)
    (lowerNodeHandler :
      (∃ sourceName sourceNode,
        sourceName ∈ Finset.range a ∧
          ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
            SettledLowerSourceNodeNameEvent A run sourceNode sourceName k) ->
        ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a' := by
  refine runSettles_descendHorn_of_lower_handler A run hrunAccepts
    hsettle hng ?_
  intro hlowerName
  rcases hlowerName with ⟨sourceName, hsourceNameMem, hfreqName⟩
  rcases exists_frequently_settledLowerSourceNodeNameEvent_of_nameEvent
      A run hfreqName with
    ⟨sourceNode, hfreqNode⟩
  exact lowerNodeHandler
    ⟨sourceName, sourceNode, hsourceNameMem, hfreqNode⟩

/--
Descent horn with the lower-source branch focused past all finite choices: a
fixed lower source name, fixed source node, fixed source state, and fixed
accepting target.  This is the sharpest conditional settled-descent endpoint;
the remaining content is the compactness/stitching argument for that fixed
quadruple.
-/
theorem runSettles_descendHorn_of_lower_state_target_handler
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
