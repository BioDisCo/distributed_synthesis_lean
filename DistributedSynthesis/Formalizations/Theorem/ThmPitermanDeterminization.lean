      ∀ child state,
        child ∈
          (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).children A green ->
        child ≠ (livePlan A live (word n)).stage2Plan.freshChild green ->
        state ∈
          (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label child ->
        ∃ source,
          source ∈ live.1.label green ∧
            SegmentVisitsAccepting A word n 1 source state) :
    ∀ state,
