/--
Paper-facing endpoint after following the fixed son in the lower-source branch.
The proof internally handles:
* cofinally zero source breakpoint measure;
* cofinally green-removal of the fixed child by a green ancestor.

The only remaining handler is the aligned surviving-child branch: a least
lower-source name, a fixed positive uncovered witness, and a fixed child carrying
the accepting target into the next live label cofinally.
-/
theorem automaton_accepts_of_accepts_of_minLowerPositiveWitnessChildSurvivesHandler
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word)
    (survivesHandler :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ (m : Nat) (sourceNode child : Node A)
              (sourceState target uncovered : A.State),
            m ∈ Finset.range a ∧
              (∀ j : Nat, j < m ->
                ¬ (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                    SettledLowerSourceNameEvent A run j k)) ∧
              ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent
                  A run sourceNode child m sourceState target uncovered k) ->
          (automaton A).Accepts word) :
    (automaton A).Accepts word := by
  rcases haccepts with ⟨run, hrunAccepts⟩
  refine automaton_accepts_of_runSettlesDescent A run ?_
  rintro a ⟨v, hsettle⟩
  by_cases hg : RunNodeGreensIO A run v
  · exact Or.inl
      (automaton_accepts_of_accepting_runNodeGreensIO A run hrunAccepts hsettle hg)
  · rcases
      runSettles_not_green_frequently_childLabelUnion_or_lower_source_branch
        A run hrunAccepts hsettle hg with
      hcoverage | hlower
    · exact Or.inr
        (runSettles_coverage_branch_to_runSettlesAtName A run hsettle hg hcoverage)
    · have hlowerName :
          ∃ sourceName,
            sourceName ∈ Finset.range a ∧
              ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledLowerSourceNameEvent A run sourceName k :=
        exists_frequently_settledLowerSourceNameEvent_of_frequently_lower_source
          A run hlower
      have hminBranch :
          ∃ (m : Nat) (sourceNode : Node A) (sourceState target : A.State),
            m ∈ Finset.range a ∧
              (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledLowerSourceStage3ChildUnionEvent A run sourceNode m
                  sourceState target k) ∧
              ∀ j : Nat, j < m ->
                ¬ (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                    SettledLowerSourceNameEvent A run j k) :=
        exists_frequently_settledLowerSourceStage3ChildUnion_at_minName_bounded
          A run hlowerName
      rcases hminBranch with
        ⟨m, sourceNode, sourceState, target, hmMem, hfreqChildUnion, hnoLeak⟩
      rcases
          frequently_settledLowerSourceStage3ChildUnion_zero_or_positiveWitness
            A run hfreqChildUnion with
        hzero | hpositiveWitness
      · have hfreqGreen :
            ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
              SettledLowerSourceStage3ChildUnionEvent A run sourceNode m
                  sourceState target k ∧
              ∃ live : LiveState A,
                (automaton A).run word k = some live ∧
                  sourceNode ∈ (((live.1.stage1 A (word k)).stage2 A
                    (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A := by
          intro n
          rcases hzero n with ⟨k, hnk, hzeroEvent⟩
          rcases
              settledLowerSourceStage3ChildUnionZeroEvent_to_sourceGreen
                A run hzeroEvent with
            ⟨hchildUnionEvent, hgreenPayload⟩
          exact ⟨k, hnk, hchildUnionEvent, hgreenPayload⟩
        exact Or.inl
          (automaton_accepts_of_settled_childUnion_sourceNodeGreensIO
            A run hrunAccepts hsettle hmMem hfreqGreen)
      · rcases hpositiveWitness with ⟨uncovered, hfreqPositiveWitness⟩
        rcases
            exists_frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildEvent
              A run hfreqPositiveWitness with
          ⟨child, hfreqPositiveChild⟩
        rcases
            frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChild_removedByGreen_or_survives
              A run hfreqPositiveChild with
          hremoved | hsurvives
        · have hfreqRemoved :
              ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledLowerSourceStage3ChildUnionChildRemovedByGreenEvent A run
                  sourceNode child m sourceState target k := by
            intro n
            rcases hremoved n with ⟨k, hnk, hremovedEvent⟩
            exact ⟨k, hnk, hremovedEvent.2⟩
          exact Or.inl
            (automaton_accepts_of_settled_childUnionChild_removedByGreenIO
              A run hrunAccepts hsettle hmMem hfreqRemoved)
        · exact Or.inl
            (survivesHandler run hrunAccepts v a hsettle hg
              ⟨m, sourceNode, child, sourceState, target, uncovered, hmMem,
                hnoLeak, hsurvives⟩)

