/--
Every measure-facing covered event exposes some successor child carrying the
fixed target, by unfolding `childLabelUnion` in the successor live tree.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent_nextChild_witness
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent
        A run sourceNode child sourceName sourceState target uncovered k) :
    ∃ coveredChild : Node A,
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureNextChildEvent
        A run sourceNode child coveredChild sourceName sourceState target
        uncovered k := by
  have heventCopy := hevent
  rcases hevent with
    ⟨_hcovered, live, next, _hrun, hrunNext, _huncoveredLabel,
      _huncoveredPrivate, htargetCovered⟩
  rw [childLabelUnion, Finset.mem_biUnion] at htargetCovered
  rcases htargetCovered with ⟨coveredChild, hchild, htargetChild⟩
  exact ⟨coveredChild, heventCopy, next, hrunNext, hchild, htargetChild⟩

/--
Finite-node pigeonhole for the successor-son step: if measure-facing covered
events recur, then one concrete successor child carries the fixed target
arbitrarily late.
-/
theorem exists_frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureNextChildEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent
          A run sourceNode child sourceName sourceState target uncovered k) :
    ∃ coveredChild : Node A,
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureNextChildEvent
          A run sourceNode child coveredChild sourceName sourceState target
          uncovered k := by
  classical
  have hfreqFilter :
      ∃ᶠ k in Filter.atTop,
        ∃ coveredChild ∈ (Finset.univ : Finset (Node A)),
          SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureNextChildEvent
            A run sourceNode child coveredChild sourceName sourceState target
            uncovered k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with ⟨k, hnk, hevent⟩
    rcases
        settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent_nextChild_witness
          A run hevent with
      ⟨coveredChild, hnextChildEvent⟩
    exact ⟨k, hnk, coveredChild, Finset.mem_univ coveredChild,
      hnextChildEvent⟩
  rw [Finset.frequently_exists] at hfreqFilter
  rcases hfreqFilter with ⟨coveredChild, _hchildMem, hchildFreq⟩
  exact ⟨coveredChild, fun n => (Filter.frequently_atTop).1 hchildFreq n⟩

/--
The arbitrary successor-child witness in the covered event is the original fixed
surviving child: both are children of the same lower source in the same successor
tree and both labels contain the fixed target, so sibling disjointness forces
equality.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureNextChildEvent_coveredChild_eq_child
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child coveredChild : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureNextChildEvent
        A run sourceNode child coveredChild sourceName sourceState target
        uncovered k) :
    coveredChild = child := by
  rcases hevent with ⟨hmeasure, nextCovered, hrunNextCovered,
    hcoveredChild, htargetCoveredChild⟩
  have hsurvives :
      SettledLowerSourceStage3ChildUnionChildSurvivesEvent A run sourceNode child
        sourceName sourceState target k := hmeasure.1.1.2
  rcases
      settledLowerSourceStage3ChildUnionChildSurvivesEvent_to_next_child
        A run hsurvives with
    ⟨nextChild, hrunNextChild, hchild, htargetChild⟩
  have hnextEq : nextChild = nextCovered := by
    have hsome : some nextChild = some nextCovered := by
      rw [← hrunNextChild, hrunNextCovered]
    exact Option.some.inj hsome
  subst nextChild
  by_contra hne
  rcases nextCovered.2 with
    ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, hsiblingDisjoint⟩
  have hdisjoint :=
    hsiblingDisjoint sourceNode coveredChild child hcoveredChild hchild hne
  exact (Finset.disjoint_left.mp hdisjoint htargetCoveredChild) htargetChild

/--
The next-child event can always be viewed in the same-child form.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureNextChildEvent_to_sameChild
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child coveredChild : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureNextChildEvent
        A run sourceNode child coveredChild sourceName sourceState target
        uncovered k) :
    SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildEvent
      A run sourceNode child sourceName sourceState target uncovered k := by
  rcases hevent with ⟨hmeasure, next, hrunNext, _hcoveredChild, _htargetCovered⟩
  have hsurvives :
      SettledLowerSourceStage3ChildUnionChildSurvivesEvent A run sourceNode child
        sourceName sourceState target k := hmeasure.1.1.2
  rcases
      settledLowerSourceStage3ChildUnionChildSurvivesEvent_to_next_child
        A run hsurvives with
    ⟨nextChild, hrunNextChild, hchild, htargetChild⟩
  have hnextEq : nextChild = next := by
    have hsome : some nextChild = some next := by
      rw [← hrunNextChild, hrunNext]
    exact Option.some.inj hsome
  subst nextChild
  exact ⟨hmeasure, next, hrunNext, hchild, htargetChild⟩

/--
Cofinal next-child events can be tightened to cofinal same-child events.
-/
theorem frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureNextChild_to_sameChild
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child coveredChild : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureNextChildEvent
          A run sourceNode child coveredChild sourceName sourceState target
          uncovered k) :
    ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildEvent
        A run sourceNode child sourceName sourceState target uncovered k := by
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  exact ⟨k, hnk,
    settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureNextChildEvent_to_sameChild
      A run hevent⟩

/--
Cofinal same-child events inherit the settled-descent geometry cofinally: after
the settling cutoff, every such event places the fixed child on the stage-(3)
ancestor path to the settled node.
-/
theorem frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChild_to_ancestor
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName : Nat} {sourceState target uncovered : A.State}
    (hsettle : RunSettlesAt A run v a)
    (hsourceLt : sourceName ∈ Finset.range a)
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildEvent
          A run sourceNode child sourceName sourceState target uncovered k) :
    ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorEvent
        A run v sourceNode child sourceName sourceState target uncovered k := by
  rcases hsettle with ⟨Nsettle, hsettleAt⟩
  intro n
  rcases hfreq (max n Nsettle) with ⟨k, hk, hevent⟩
  have hnk : n ≤ k := le_trans (le_max_left n Nsettle) hk
  have hNk : Nsettle ≤ k := le_trans (le_max_right n Nsettle) hk
  rcases hevent with ⟨hmeasure, _nextSame, _hrunNextSame, _hchildNext,
    _htargetNextChild⟩
  have hpositiveSurvives :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent A run
        sourceNode child sourceName sourceState target uncovered k := hmeasure.1.1
  rcases hpositiveSurvives with ⟨hpositiveChild, _hchildSurvives⟩
  rcases hpositiveChild with ⟨_hpositiveWitness, hchildEvent⟩
  rcases hchildEvent with ⟨hchildUnionEvent, liveChild, hrunChild, hchildRaw⟩
  rcases hchildUnionEvent with ⟨hbase, liveCU, hrunCU, _hchildUnion⟩
  rcases hbase with
    ⟨live, next, hrun, hrunNext, htarget, _haccepting, hsourceActive,
      _hsourceState, _hsegment, hsourceName⟩
  have hliveCUEq : liveCU = live := by
    have hsome : some liveCU = some live := by
      rw [← hrunCU, hrun]
    exact Option.some.inj hsome
  subst liveCU
  have hliveChildEq : liveChild = live := by
    have hsome : some liveChild = some live := by
      rw [← hrunChild, hrun]
    exact Option.some.inj hsome
  subst liveChild
  rcases hsettleAt k hNk with
    ⟨settledLive, hsettledRun, hmemV, hnameV⟩
  have hsettledLiveEq : settledLive = live := by
    have hsome : some settledLive = some live := by
      rw [← hsettledRun, hrun]
    exact Option.some.inj hsome
  subst settledLive
  rcases hsettleAt (k + 1) (by omega) with
    ⟨settledNext, hsettledNextRun, hmemNextV, _hnameNextV⟩
  have hsettledNextEq : settledNext = next := by
    have hsome : some settledNext = some next := by
      rw [← hsettledNextRun, hrunNext]
    exact Option.some.inj hsome
  subst settledNext
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases hchildRaw with ⟨hchild, htargetChild⟩
  have hvActive : live.1.active v = true :=
    active_of_mem_label A live.1 live.2 hmemV
  have hsourceLtNat : sourceName < a := Finset.mem_range.mp hsourceLt
  have hancestor :
      t3.IsAncestorOrSelf A child v :=
    stage3_child_isAncestorOrSelf_of_settled_childUnionChild
      A run hrun hrunNext htarget hsourceActive hsourceName
      (by simpa [t1, plan, t2, t3] using hchild)
      (by simpa [t1, plan, t2, t3] using htargetChild)
      hvActive hnameV hmemNextV hsourceLtNat
  exact ⟨k, hnk, ⟨hmeasure, _nextSame, _hrunNextSame, _hchildNext,
      _htargetNextChild⟩, live, hrun,
    by simpa [t1, plan, t2, t3] using hancestor⟩

/--
Add the bounded-name payload to a cofinal same-child ancestor branch.  The lower
bound comes from the stage-(3) parent invariant (`child` is a child of
`sourceNode`); the upper bound comes from the already proved ancestor relation
from `child` to the settled node `v`.
-/
theorem frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestor_to_nameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName : Nat} {sourceState target uncovered : A.State}
    (hsettle : RunSettlesAt A run v a)
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorEvent
          A run v sourceNode child sourceName sourceState target uncovered k) :
    ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorNameEvent
        A run v sourceNode child a sourceName sourceState target uncovered k := by
  rcases hsettle with ⟨Nsettle, hsettleAt⟩
  intro n
  rcases hfreq (max n Nsettle) with ⟨k, hk, hevent⟩
  have hnk : n ≤ k := le_trans (le_max_left n Nsettle) hk
  have hNk : Nsettle ≤ k := le_trans (le_max_right n Nsettle) hk
  rcases hevent with ⟨hsame, liveAncestor, hrunAncestor, hancestorRaw⟩
  rcases hsame with ⟨hmeasure, _nextSame, _hrunNextSame, _hchildNext,
    _htargetNextChild⟩
  have hpositiveSurvives :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent A run
        sourceNode child sourceName sourceState target uncovered k := hmeasure.1.1
  rcases hpositiveSurvives with ⟨hpositiveChild, _hchildSurvives⟩
  rcases hpositiveChild with ⟨_hpositiveWitness, hchildEvent⟩
  rcases hchildEvent with ⟨hchildUnionEvent, liveChild, hrunChild, hchildRaw⟩
  rcases hchildUnionEvent with ⟨hbase, liveCU, hrunCU, _hchildUnion⟩
  rcases hbase with
    ⟨live, _next, hrun, _hrunNext, _htarget, _haccepting, hsourceActive,
      _hsourceState, _hsegment, hsourceName⟩
  have hliveAncestorEq : liveAncestor = live := by
    have hsome : some liveAncestor = some live := by
      rw [← hrunAncestor, hrun]
    exact Option.some.inj hsome
  subst liveAncestor
  have hliveCUEq : liveCU = live := by
    have hsome : some liveCU = some live := by
      rw [← hrunCU, hrun]
    exact Option.some.inj hsome
  subst liveCU
  have hliveChildEq : liveChild = live := by
    have hsome : some liveChild = some live := by
      rw [← hrunChild, hrun]
    exact Option.some.inj hsome
  subst liveChild
  rcases hsettleAt k hNk with
    ⟨settledLive, hsettledRun, hmemV, hnameV⟩
  have hsettledLiveEq : settledLive = live := by
    have hsome : some settledLive = some live := by
      rw [← hsettledRun, hrun]
    exact Option.some.inj hsome
  subst settledLive
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases hchildRaw with ⟨hchild, _htargetChild⟩
  have hancestor : t3.IsAncestorOrSelf A child v := by
    simpa [t1, plan, t2, t3] using hancestorRaw
  rcases live.2 with
    ⟨hrootActive, _hrootName, hrootParent, hparentInvariant, _hinactiveLabel,
      _hbound, hinjective, _hconsecutive, _hproper, hchildSubset,
      _hsiblingDisjoint⟩
  obtain ⟨_hwfRoot, hwfParent, _hwfChild, _hwfSibling⟩ :=
    stage1_stage2_stage3_invariants A live.1 (word k) plan
      hrootActive hrootParent hparentInvariant hchildSubset hinjective
  have hchildSpec := hchild
  rw [children, Finset.mem_filter] at hchildSpec
  rcases hchildSpec with ⟨_hchildMem, hchildActive, hchildNeRoot, hchildParent⟩
  have hsourceLtChild : sourceName < (t3.name child).val := by
    have hp := (hwfParent child hchildActive hchildNeRoot).2
    rw [hchildParent] at hp
    have hpT3 : (t3.name sourceNode).val < (t3.name child).val := by
      simpa [t1, plan, t2, t3] using hp
    have hsourceNameT3 : (t3.name sourceNode).val = sourceName := by
      have hactiveT1 : t1.active sourceNode = true := by
        simpa [t1, stage1_active A live.1 (word k) sourceNode] using
          hsourceActive
      have hnameT2 : t2.name sourceNode = t1.name sourceNode :=
        stage2_preserves_active_node_name A t1 plan hactiveT1
      rw [show t3.name sourceNode = t2.name sourceNode from
        stage3_name A t2 sourceNode]
      rw [hnameT2]
      rw [show t1.name sourceNode = live.1.name sourceNode from
        stage1_name A live.1 (word k) sourceNode]
      exact hsourceName
    omega
  have hvActive : t3.active v = true := by
    have hvLiveActive : live.1.active v = true :=
      active_of_mem_label A live.1 live.2 hmemV
    have hactiveT1 : t1.active v = true := by
      simpa [t1, stage1_active A live.1 (word k) v] using hvLiveActive
    have hactiveT2 : t2.active v = true :=
      stage2_preserves_active_node_active A t1 plan hactiveT1
    simpa [t2, t3, stage3_active A t2 v] using hactiveT2
  have hchildLeV :
      (t3.name child).val ≤ (t3.name v).val :=
    name_le_of_isAncestorOrSelf A t3
      (by
        obtain ⟨hwfRoot, _hwfParent, _hwfChild, _hwfSibling⟩ :=
          stage1_stage2_stage3_invariants A live.1 (word k) plan
            hrootActive hrootParent hparentInvariant hchildSubset hinjective
        exact hwfRoot)
      hwfParent hvActive hancestor
  have hvNameT3 : (t3.name v).val = a := by
    have hvLiveActive : live.1.active v = true :=
      active_of_mem_label A live.1 live.2 hmemV
    have hactiveT1 : t1.active v = true := by
      simpa [t1, stage1_active A live.1 (word k) v] using hvLiveActive
    have hnameT2 : t2.name v = t1.name v :=
      stage2_preserves_active_node_name A t1 plan hactiveT1
    rw [show t3.name v = t2.name v from stage3_name A t2 v]
    rw [hnameT2]
    rw [show t1.name v = live.1.name v from
      stage1_name A live.1 (word k) v]
    exact hnameV
  have hchildLeA : (t3.name child).val ≤ a := by
    omega
  have hbounds :
      sourceName < (t3.name child).val ∧ (t3.name child).val ≤ a :=
    ⟨hsourceLtChild, hchildLeA⟩
  exact ⟨k, hnk,
    ⟨⟨⟨hmeasure, _nextSame, _hrunNextSame, _hchildNext,
      _htargetNextChild⟩, live, hrun,
      by simpa [t1, plan, t2, t3] using hancestor⟩,
      live, hrun, by simpa [t1, plan, t2, t3] using hbounds⟩⟩

/--
Finite-name pigeonhole for the bounded ancestor-name branch: since the followed
child's stage-(3) name is always in the finite interval `sourceName < name ≤ a`,
one concrete dynamic child name recurs cofinally.
-/
theorem exists_frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorNameEvent
          A run v sourceNode child a sourceName sourceState target uncovered k) :
    ∃ childName : Nat,
      sourceName < childName ∧ childName ≤ a ∧
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
            A run v sourceNode child a sourceName childName sourceState target
            uncovered k := by
  classical
  have hfreqFilter :
      ∃ᶠ k in Filter.atTop,
        ∃ childName ∈ Finset.range (a + 1),
          SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
            A run v sourceNode child a sourceName childName sourceState target
            uncovered k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with ⟨k, hnk, hevent⟩
    rcases hevent with ⟨hancestorEvent, live, hrun, hboundsRaw⟩
    let t1 := live.1.stage1 A (word k)
    let plan := (livePlan A live (word k)).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    let childName : Nat := (t3.name child).val
    have hbounds :
        sourceName < (t3.name child).val ∧ (t3.name child).val ≤ a := by
      simpa [t1, plan, t2, t3] using hboundsRaw
    have hchildNameMem : childName ∈ Finset.range (a + 1) := by
      exact Finset.mem_range.mpr (by
        have hle := hbounds.2
        simpa [childName] using Nat.lt_succ_of_le hle)
    have hnameEvent :
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorNameEvent
          A run v sourceNode child a sourceName sourceState target uncovered k :=
      ⟨hancestorEvent, live, hrun, by simpa [t1, plan, t2, t3] using hbounds⟩
    exact ⟨k, hnk, childName, hchildNameMem, hnameEvent, live, hrun,
      by simp [childName, t1, plan, t2, t3],
      by simpa [childName] using hbounds.1,
      by simpa [childName] using hbounds.2⟩
  rw [Finset.frequently_exists] at hfreqFilter
  rcases hfreqFilter with ⟨childName, _hchildNameMem, hchildNameFreq⟩
  have hfreqFixed :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
          A run v sourceNode child a sourceName childName sourceState target
          uncovered k :=
    fun n => (Filter.frequently_atTop).1 hchildNameFreq n
  have hbounds : sourceName < childName ∧ childName ≤ a := by
    rcases hfreqFixed 0 with
      ⟨k, _hk, _hnameEvent, live, _hrun, _hchildNameEq, hlt, hle⟩
    exact ⟨hlt, hle⟩
  exact ⟨childName, hbounds.1, hbounds.2, hfreqFixed⟩

/--
Least recurring fixed child name in the bounded ancestor-name branch.  This is
the finite-descent form needed to rule out infinitely many later compacted-name
drops below the selected child name.
-/
theorem exists_min_frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorNameEvent
          A run v sourceNode child a sourceName sourceState target uncovered k) :
    ∃ childName : Nat,
      sourceName < childName ∧ childName ≤ a ∧
        (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
            A run v sourceNode child a sourceName childName sourceState target
            uncovered k) ∧
        ∀ smaller : Nat, smaller < childName ->
          ¬ (sourceName < smaller ∧ smaller ≤ a ∧
            ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
              SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
                A run v sourceNode child a sourceName smaller sourceState target
                uncovered k) := by
  classical
  let P : Nat -> Prop := fun childName =>
    sourceName < childName ∧ childName ≤ a ∧
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
          A run v sourceNode child a sourceName childName sourceState target
          uncovered k
  have hexists : ∃ childName, P childName :=
    exists_frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
      A run hfreq
  let childName : Nat := Nat.find hexists
  have hspec : P childName := by
    simpa [childName] using Nat.find_spec hexists
  refine ⟨childName, hspec.1, hspec.2.1, hspec.2.2, ?_⟩
  intro smaller hsmaller
  exact Nat.find_min hexists (by simpa [childName] using hsmaller)

/--
Finite cutoff for smaller fixed child-name events below the least recurring
child name.  After selecting the least recurring name, every strictly smaller
name in the same bounded interval occurs only finitely often.
-/
theorem exists_eventually_no_smaller_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent_of_minimal
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    (hminimal :
      ∀ smaller : Nat, smaller < childName ->
        ¬ (sourceName < smaller ∧ smaller ≤ a ∧
          ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
            SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
              A run v sourceNode child a sourceName smaller sourceState target
              uncovered k)) :
    ∃ N : Nat, ∀ k smaller : Nat, N ≤ k ->
      smaller < childName ->
        sourceName < smaller ->
          smaller ≤ a ->
            ¬ SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
              A run v sourceNode child a sourceName smaller sourceState target
              uncovered k := by
  classical
  let smallNames : Finset Nat :=
    (Finset.range childName).filter
      (fun smaller => sourceName < smaller ∧ smaller ≤ a)
  have hbound :
      ∀ smaller : Nat, smaller ∈ smallNames ->
        ∃ N : Nat, ∀ k : Nat, N ≤ k ->
          ¬ SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
            A run v sourceNode child a sourceName smaller sourceState target
            uncovered k := by
    intro smaller hsmall
    have hlt : smaller < childName :=
      Finset.mem_range.mp ((Finset.mem_filter.mp hsmall).1)
    have hsourceLt : sourceName < smaller :=
      (Finset.mem_filter.mp hsmall).2.1
    have hleA : smaller ≤ a :=
      (Finset.mem_filter.mp hsmall).2.2
    have hnotFreq :
        ¬ ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
            A run v sourceNode child a sourceName smaller sourceState target
            uncovered k := by
      intro hfreq
      exact hminimal smaller hlt ⟨hsourceLt, hleA, hfreq⟩
    push Not at hnotFreq
    exact hnotFreq
  let boundOf : Nat -> Nat := fun smaller =>
    if hsmall : smaller ∈ smallNames then
      Classical.choose (hbound smaller hsmall)
    else
      0
  refine ⟨smallNames.sup boundOf, ?_⟩
  intro k smaller hNk hlt hsourceLt hleA hevent
  have hsmall : smaller ∈ smallNames := by
    rw [Finset.mem_filter]
    exact ⟨Finset.mem_range.mpr hlt, hsourceLt, hleA⟩
  have hboundLe : boundOf smaller ≤ smallNames.sup boundOf :=
    Finset.le_sup hsmall
  have hboundOf :
      boundOf smaller = Classical.choose (hbound smaller hsmall) := by
    simp [boundOf, hsmall]
  have hchooseLe : Classical.choose (hbound smaller hsmall) ≤ k := by
    omega
  exact (Classical.choose_spec (hbound smaller hsmall)) k hchooseLe hevent

/--
Expose the successor-name nonincrease already present in a fixed-name event.
Stages (3)--(5) preserve the child's stage-(2) name and stage (6) can only
compact it downward when the child survives with a nonempty final label.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent_to_nextNameLe
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
        A run v sourceNode child a sourceName childName sourceState target
        uncovered k) :
    SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLeEvent
      A run v sourceNode child a sourceName childName sourceState target
      uncovered k := by
  have heventCopy := hevent
  rcases hevent with ⟨hnameEvent, liveFixed, hrunFixed, hfixedRaw⟩
  rcases hnameEvent with ⟨hancestorEvent, _liveBounds, _hrunBounds,
    _hboundsRaw⟩
  rcases hancestorEvent with ⟨hsameChild, _liveAncestor, _hrunAncestor,
    _hancestorRaw⟩
  rcases hsameChild with ⟨_hmeasure, next, hrunNext, hchildNext,
    htargetNextChild⟩
  let t1 := liveFixed.1.stage1 A (word k)
  let plan := (livePlan A liveFixed (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hchildNameT3 : (t3.name child).val = childName := by
    have hfixed :
        (t3.name child).val = childName ∧ sourceName < childName ∧
          childName ≤ a := by
      simpa [t1, plan, t2, t3] using hfixedRaw
    exact hfixed.1
  have hchildNameT2 : (t2.name child).val = childName := by
    rw [show t3.name child = t2.name child from stage3_name A t2 child] at hchildNameT3
    exact hchildNameT3
  have hnameLe :
      (next.1.name child).val ≤ childName := by
    have hle :=
      automaton_run_live_next_name_val_le_stage2_of_next_label
        A word hrunFixed hrunNext htargetNextChild
    have hleT2 : (next.1.name child).val ≤ (t2.name child).val := by
      simpa [t1, plan, t2] using hle
    omega
  exact ⟨heventCopy, next, hrunNext, hchildNext, htargetNextChild, hnameLe⟩

/--
Cofinal fixed-name events can be enriched with the successor-name nonincrease
payload without changing the cofinal sequence.
-/
theorem frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedName_to_nextNameLe
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
          A run v sourceNode child a sourceName childName sourceState target
          uncovered k) :
    ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLeEvent
        A run v sourceNode child a sourceName childName sourceState target
        uncovered k := by
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  exact ⟨k, hnk,
    settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent_to_nextNameLe
      A run hevent⟩

/--
Every successor-name nonincrease event splits into the equality branch or the
strict name-drop branch.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLeEvent_eq_or_lt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLeEvent
        A run v sourceNode child a sourceName childName sourceState target
        uncovered k) :
    SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameEqEvent
        A run v sourceNode child a sourceName childName sourceState target
        uncovered k ∨
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtEvent
        A run v sourceNode child a sourceName childName sourceState target
        uncovered k := by
  rcases hevent with ⟨hfixed, next, hrunNext, hchildNext,
    htargetNextChild, hnameLe⟩
  rcases Nat.lt_or_eq_of_le hnameLe with hlt | heq
  · exact Or.inr
      ⟨⟨hfixed, next, hrunNext, hchildNext, htargetNextChild, hnameLe⟩,
        next, hrunNext, hchildNext, htargetNextChild, hlt⟩
  · exact Or.inl
      ⟨⟨hfixed, next, hrunNext, hchildNext, htargetNextChild, hnameLe⟩,
        next, hrunNext, hchildNext, htargetNextChild, heq⟩

/--
Cofinal successor-name nonincrease events concentrate on either the equality
branch or the strict name-drop branch.
-/
theorem frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLe_eq_or_lt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLeEvent
          A run v sourceNode child a sourceName childName sourceState target
          uncovered k) :
    (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameEqEvent
        A run v sourceNode child a sourceName childName sourceState target
        uncovered k) ∨
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtEvent
          A run v sourceNode child a sourceName childName sourceState target
          uncovered k := by
  apply frequently_left_or_right_of_frequently_or
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  exact ⟨k, hnk,
    settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLeEvent_eq_or_lt
      A run hevent⟩

/--
Expose successor parent/child name order in the strict-drop branch.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtEvent_to_ordered
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtEvent
        A run v sourceNode child a sourceName childName sourceState target
        uncovered k) :
    SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtOrderedEvent
      A run v sourceNode child a sourceName childName sourceState target
      uncovered k := by
  rcases hevent with ⟨hleEvent, next, hrunNext, hchildNext,
    htargetNextChild, hchildNameLt⟩
  have hchildSpec := hchildNext
  rw [children, Finset.mem_filter] at hchildSpec
  rcases hchildSpec with ⟨_hmem, hchildActive, hchildNeRoot, hchildParent⟩
  rcases next.2 with
    ⟨_hrootActive, _hrootName, _hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have hparentLt :
      (next.1.name sourceNode).val < (next.1.name child).val := by
    have hp := (hparentInvariant child hchildActive hchildNeRoot).2
    rwa [hchildParent] at hp
  exact ⟨⟨hleEvent, next, hrunNext, hchildNext, htargetNextChild,
      hchildNameLt⟩,
    next, hrunNext, hchildNext, htargetNextChild, hparentLt, hchildNameLt⟩

/--
Cofinal strict-drop events can be enriched with successor parent/child name
order.
-/
theorem frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLt_to_ordered
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtEvent
          A run v sourceNode child a sourceName childName sourceState target
          uncovered k) :
    ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtOrderedEvent
        A run v sourceNode child a sourceName childName sourceState target
        uncovered k := by
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  exact ⟨k, hnk,
    settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtEvent_to_ordered
      A run hevent⟩

/--
An ordered strict-drop event either keeps the successor child name above the
lower-source name, or the successor source name has dropped below the
lower-source name.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtOrderedEvent_aboveSource_or_sourceLt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtOrderedEvent
        A run v sourceNode child a sourceName childName sourceState target
        uncovered k) :
    SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtAboveSourceEvent
        A run v sourceNode child a sourceName childName sourceState target
        uncovered k ∨
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextSourceNameLtEvent
        A run v sourceNode child a sourceName childName sourceState target
        uncovered k := by
  rcases hevent with ⟨hltEvent, next, hrunNext, hchildNext,
    htargetNextChild, hparentLtChild, hchildLt⟩
  by_cases habove : sourceName < (next.1.name child).val
  · exact Or.inl
      ⟨⟨hltEvent, next, hrunNext, hchildNext, htargetNextChild,
          hparentLtChild, hchildLt⟩,
        next, hrunNext, hchildNext, htargetNextChild, habove, hchildLt⟩
  · have hsourceLt : (next.1.name sourceNode).val < sourceName := by
      omega
    exact Or.inr
      ⟨⟨hltEvent, next, hrunNext, hchildNext, htargetNextChild,
          hparentLtChild, hchildLt⟩,
        next, hrunNext, hchildNext, htargetNextChild, hsourceLt, hchildLt⟩

/--
Cofinal ordered strict-drop events concentrate on either the above-source child
drop branch or the source-compaction branch.
-/
theorem frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtOrdered_aboveSource_or_sourceLt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtOrderedEvent
          A run v sourceNode child a sourceName childName sourceState target
          uncovered k) :
    (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtAboveSourceEvent
        A run v sourceNode child a sourceName childName sourceState target
        uncovered k) ∨
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextSourceNameLtEvent
          A run v sourceNode child a sourceName childName sourceState target
          uncovered k := by
  apply frequently_left_or_right_of_frequently_or
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  exact ⟨k, hnk,
    settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtOrderedEvent_aboveSource_or_sourceLt
      A run hevent⟩

/--
After the minimal no-leakage cutoff, every cofinal surviving-positive event can
be strengthened to the source-covered form.
-/
theorem frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvives_to_covered_of_noLeak
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State}
    (hnoLeak :
      ∀ j : Nat, j < sourceName ->
        ¬ (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceNameEvent A run j k))
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent A
          run sourceNode child sourceName sourceState target uncovered k) :
    ∃ N : Nat,
      (∀ k j : Nat, N ≤ k -> j < sourceName ->
        ¬ SettledLowerSourceNameEvent A run j k) ∧
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredEvent
          A run sourceNode child sourceName sourceState target uncovered k := by
  rcases
      exists_eventually_no_smaller_settledLowerSourceNameEvent_of_noLeak
        A run hnoLeak with
    ⟨N, hnoSmaller⟩
  refine ⟨N, hnoSmaller, ?_⟩
  intro n
  rcases hfreq (max n N) with ⟨k, hk, hevent⟩
  have hnk : n ≤ k := le_trans (le_max_left n N) hk
  have hNk : N ≤ k := le_trans (le_max_right n N) hk
  have hcovered :=
    settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent_source_covered_of_no_smaller
      A run hnoSmaller hNk hevent
  exact ⟨k, hnk, hevent, hcovered⟩

/--
Coverage branch witness: if final child coverage of a settled node `v` happens
arbitrarily late on accepting transitions, then arbitrarily late an actual child
of `v` carries the accepting target and has name strictly larger than the
settled name `a`.
-/
theorem runSettles_coverage_branch_frequently_child_name_gt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hcoverage :
      ∀ n : Nat, ∃ k live next,
        n ≤ k ∧
          (automaton A).run word k = some live ∧
          (automaton A).run word (k + 1) = some next ∧
          A.accepting (run.path (k + 1)) ∧
          run.path (k + 1) ∈ next.1.childLabelUnion A v) :
    ∀ n : Nat, ∃ k next child,
      n ≤ k ∧
        (automaton A).run word (k + 1) = some next ∧
        A.accepting (run.path (k + 1)) ∧
        child ∈ next.1.children A v ∧
        run.path (k + 1) ∈ next.1.label child ∧
        a < (next.1.name child).val := by
  rcases hsettle with ⟨N, hsettle⟩
  intro n
  rcases hcoverage (max n N) with
    ⟨k, _live, next, hk, _hrun, hrunNext, haccepting, hcover⟩
  have hnk : n ≤ k := le_trans (le_max_left n N) hk
  have hNk1 : N ≤ k + 1 := by
    have hNk : N ≤ k := le_trans (le_max_right n N) hk
    omega
  rcases hsettle (k + 1) hNk1 with
    ⟨settledNext, hsettledNextRun, _hmemNext, hnameNext⟩
  have hnextEq : next = settledNext := by
    have hsome : some next = some settledNext := by
      rw [← hrunNext, hsettledNextRun]
    exact Option.some.inj hsome
  subst settledNext
  rcases childLabelUnion_witness_name_gt A next.1 next.2 hnameNext hcover with
    ⟨child, hchild, hmemChild, hnameGt⟩
  exact ⟨k, next, child, hnk, hrunNext, haccepting, hchild, hmemChild,
    hnameGt⟩

/--
Coverage event for one fixed child node of a settled node `v`.
-/
def SettledCoverageChildEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v child : Node A) (a k : Nat) : Prop :=
  ∃ next : LiveState A,
    (automaton A).run word (k + 1) = some next ∧
      A.accepting (run.path (k + 1)) ∧
      child ∈ next.1.children A v ∧
      run.path (k + 1) ∈ next.1.label child ∧
      a < (next.1.name child).val

/--
Finite-node pigeonhole for the coverage branch: if accepting targets are
arbitrarily often covered by some child of the settled node `v`, then one fixed
child node witnesses this arbitrarily often.
-/
theorem exists_frequently_settledCoverageChildEvent_of_coverage_branch
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hcoverage :
      ∀ n : Nat, ∃ k live next,
        n ≤ k ∧
          (automaton A).run word k = some live ∧
          (automaton A).run word (k + 1) = some next ∧
          A.accepting (run.path (k + 1)) ∧
          run.path (k + 1) ∈ next.1.childLabelUnion A v) :
    ∃ child : Node A,
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledCoverageChildEvent A run v child a k := by
  classical
  have hfreq :
      ∃ᶠ k in Filter.atTop,
        ∃ child ∈ (Finset.univ : Finset (Node A)),
          SettledCoverageChildEvent A run v child a k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases runSettles_coverage_branch_frequently_child_name_gt
        A run hsettle hcoverage n with
      ⟨k, next, child, hnk, hrunNext, haccepting, hchild, hmemChild,
        hnameGt⟩
    exact ⟨k, hnk, child, Finset.mem_univ child, next, hrunNext,
      haccepting, hchild, hmemChild, hnameGt⟩
  rw [Finset.frequently_exists] at hfreq
  rcases hfreq with ⟨child, _hchildMem, hchildFreq⟩
  refine ⟨child, ?_⟩
  intro n
  exact (Filter.frequently_atTop).1 hchildFreq n

/-- Coverage event for a fixed child node and fixed dynamic child name. -/
def SettledCoverageChildNameEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v child : Node A)
    (a childName k : Nat) : Prop :=
  ∃ next : LiveState A,
    (automaton A).run word (k + 1) = some next ∧
      A.accepting (run.path (k + 1)) ∧
      child ∈ next.1.children A v ∧
      run.path (k + 1) ∈ next.1.label child ∧
      (next.1.name child).val = childName ∧
      a < childName

/--
A fixed coverage child/name event is an instantaneous settled-at witness for
that child and name at time `k+1`.
-/
theorem settledCoverageChildNameEvent_instant_settle_witness
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v child : Node A}
    {a childName k : Nat}
    (hevent :
      SettledCoverageChildNameEvent A run v child a childName k) :
    ∃ next : LiveState A,
      (automaton A).run word (k + 1) = some next ∧
        run.path (k + 1) ∈ next.1.label child ∧
        (next.1.name child).val = childName ∧
        a < childName := by
  rcases hevent with
    ⟨next, hrunNext, _haccepting, _hchild, hmemChild, hnameChild,
      hnameGt⟩
  exact ⟨next, hrunNext, hmemChild, hnameChild, hnameGt⟩

/--
Frequency form of the previous witness: a fixed coverage child/name branch gives
arbitrarily late times at which the run is already in that fixed child with the
fixed larger name.
-/
theorem settledCoverageChildNameEvent_frequently_in_child_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v child : Node A}
    {a childName : Nat}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledCoverageChildNameEvent A run v child a childName k) :
    ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
      ∃ live : LiveState A,
        (automaton A).run word t = some live ∧
          run.path t ∈ live.1.label child ∧
          (live.1.name child).val = childName ∧
          a < childName := by
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  rcases settledCoverageChildNameEvent_instant_settle_witness
      A run hevent with
    ⟨next, hrunNext, hmemChild, hnameChild, hnameGt⟩
  exact ⟨k + 1, by omega, next, hrunNext, hmemChild, hnameChild, hnameGt⟩

/--
Finite-name pigeonhole for a fixed coverage child: if one child witnesses
coverage arbitrarily often above name `a`, then one dynamic child name `> a`
witnesses it arbitrarily often.
-/
theorem exists_frequently_settledCoverageChildNameEvent_of_child
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v child : Node A} {a : Nat}
    (hfreqChild :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledCoverageChildEvent A run v child a k) :
    ∃ childName,
      childName ∈ Finset.range (Fintype.card A.State) ∧
        a < childName ∧
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledCoverageChildNameEvent A run v child a childName k := by
  classical
  have hfreq :
      ∃ᶠ k in Filter.atTop,
        ∃ childName ∈ Finset.range (Fintype.card A.State),
          SettledCoverageChildNameEvent A run v child a childName k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreqChild n with
      ⟨k, hnk, next, hrunNext, haccepting, hchild, hmemChild, hnameGt⟩
    let childName : Nat := (next.1.name child).val
    have hchildActive : next.1.active child = true := by
      rw [children, Finset.mem_filter] at hchild
      exact hchild.2.1
    have hchildNameMem :
        childName ∈ Finset.range (Fintype.card A.State) := by
      rcases next.2 with
        ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
          _hinactiveLabel, hbound, _hinjective, _hconsecutive, _hproper,
          _hchildSubset, _hsiblingDisjoint⟩
      exact Finset.mem_range.mpr
        (by simpa [childName] using hbound child hchildActive)
    exact ⟨k, hnk, childName, hchildNameMem, next, hrunNext, haccepting,
      hchild, hmemChild, rfl, by simpa [childName] using hnameGt⟩
  rw [Finset.frequently_exists] at hfreq
  rcases hfreq with ⟨childName, hchildNameMem, hchildNameFreq⟩
  have hnameGt : a < childName := by
    rcases (Filter.frequently_atTop).1 hchildNameFreq 0 with
      ⟨k, _hk, next, _hrunNext, _haccepting, _hchild, _hmemChild,
        hchildName, hgt⟩
    exact hgt
  refine ⟨childName, hchildNameMem, hnameGt, ?_⟩
  intro n
  exact (Filter.frequently_atTop).1 hchildNameFreq n

/--
Direct fixed child/name summary for the coverage branch of the settled
non-green descent.
-/
theorem exists_frequently_settledCoverageChildNameEvent_of_coverage_branch
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hcoverage :
      ∀ n : Nat, ∃ k live next,
        n ≤ k ∧
          (automaton A).run word k = some live ∧
          (automaton A).run word (k + 1) = some next ∧
          A.accepting (run.path (k + 1)) ∧
          run.path (k + 1) ∈ next.1.childLabelUnion A v) :
    ∃ child childName,
      childName ∈ Finset.range (Fintype.card A.State) ∧
        a < childName ∧
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledCoverageChildNameEvent A run v child a childName k := by
  rcases exists_frequently_settledCoverageChildEvent_of_coverage_branch
      A run hsettle hcoverage with
    ⟨child, hfreqChild⟩
  rcases exists_frequently_settledCoverageChildNameEvent_of_child
      A run hfreqChild with
    ⟨childName, hchildNameMem, hnameGt, hfreqName⟩
  exact ⟨child, childName, hchildNameMem, hnameGt, hfreqName⟩

/--
Coverage event for a fixed dynamic child name, hiding the particular child node.
This is the right finite measure for the older-child descent inside the coverage
branch: blocking may move to another child, but it strictly lowers the child
name.
-/
def SettledCoverageNameEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v : Node A)
    (a childName k : Nat) : Prop :=
  ∃ child : Node A,
    SettledCoverageChildNameEvent A run v child a childName k

/--
Forget the fixed child component of a coverage child/name event.
-/
theorem settledCoverageNameEvent_of_childNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v child : Node A}
    {a childName k : Nat}
    (hevent :
      SettledCoverageChildNameEvent A run v child a childName k) :
    SettledCoverageNameEvent A run v a childName k :=
  ⟨child, hevent⟩

/--
Name-only coverage summary: if the coverage branch occurs, some child name
`> a` occurs arbitrarily late, regardless of which child node carries it.
-/
theorem exists_frequently_settledCoverageNameEvent_of_coverage_branch
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hcoverage :
      ∀ n : Nat, ∃ k live next,
        n ≤ k ∧
          (automaton A).run word k = some live ∧
          (automaton A).run word (k + 1) = some next ∧
          A.accepting (run.path (k + 1)) ∧
          run.path (k + 1) ∈ next.1.childLabelUnion A v) :
    ∃ childName,
      childName ∈ Finset.range (Fintype.card A.State) ∧
        a < childName ∧
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledCoverageNameEvent A run v a childName k := by
  rcases exists_frequently_settledCoverageChildNameEvent_of_coverage_branch
      A run hsettle hcoverage with
    ⟨child, childName, hchildNameMem, hnameGt, hfreq⟩
  refine ⟨childName, hchildNameMem, hnameGt, ?_⟩
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  exact ⟨k, hnk,
    settledCoverageNameEvent_of_childNameEvent A run hevent⟩

/--
Minimal recurring coverage name.  The coverage branch can be focused on a
least dynamic child name that recurs arbitrarily late; any strictly smaller
name cannot itself recur arbitrarily late as a coverage name.  This is the
finite-name fact needed to rule out an infinite older-sibling escape in the
coverage handler.
-/
theorem exists_min_frequently_settledCoverageNameEvent_of_coverage_branch
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hcoverage :
      ∀ n : Nat, ∃ k live next,
        n ≤ k ∧
          (automaton A).run word k = some live ∧
          (automaton A).run word (k + 1) = some next ∧
          A.accepting (run.path (k + 1)) ∧
          run.path (k + 1) ∈ next.1.childLabelUnion A v) :
    ∃ childName,
      childName ∈ Finset.range (Fintype.card A.State) ∧
        a < childName ∧
        (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledCoverageNameEvent A run v a childName k) ∧
        ∀ smaller : Nat, smaller < childName ->
          ¬ (smaller ∈ Finset.range (Fintype.card A.State) ∧
              a < smaller ∧
              ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledCoverageNameEvent A run v a smaller k) := by
  classical
  let P : Nat -> Prop := fun childName =>
    childName ∈ Finset.range (Fintype.card A.State) ∧
      a < childName ∧
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledCoverageNameEvent A run v a childName k
  have hexists : ∃ childName, P childName := by
    exact exists_frequently_settledCoverageNameEvent_of_coverage_branch
      A run hsettle hcoverage
  let childName : Nat := Nat.find hexists
  have hspec : P childName := by
    simpa [childName] using Nat.find_spec hexists
  refine ⟨childName, hspec.1, hspec.2.1, hspec.2.2, ?_⟩
  intro smaller hsmaller
  exact Nat.find_min hexists (by simpa [childName] using hsmaller)

/--
Finite-node pigeonhole for a fixed recurring coverage name: some fixed child
node carries that same dynamic name arbitrarily late.
-/
theorem exists_frequently_settledCoverageChildNameEvent_of_nameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a childName : Nat}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledCoverageNameEvent A run v a childName k) :
    ∃ child : Node A,
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledCoverageChildNameEvent A run v child a childName k := by
  classical
  have hfreqFilter :
      ∃ᶠ k in Filter.atTop,
        ∃ child ∈ (Finset.univ : Finset (Node A)),
          SettledCoverageChildNameEvent A run v child a childName k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with ⟨k, hnk, child, hevent⟩
    exact ⟨k, hnk, child, Finset.mem_univ child, hevent⟩
  rw [Finset.frequently_exists] at hfreqFilter
  rcases hfreqFilter with ⟨child, _hchildMem, hchildFreq⟩
  refine ⟨child, ?_⟩
  intro n
  exact (Filter.frequently_atTop).1 hchildFreq n

/--
Coverage branch packaged in the paper-proof form: choose a least recurring child
name and then a fixed child carrying it arbitrarily late.  The final field says
no smaller child name can recur as a coverage-name event.
-/
theorem exists_min_frequently_settledCoverageChildNameEvent_of_coverage_branch
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hcoverage :
      ∀ n : Nat, ∃ k live next,
        n ≤ k ∧
          (automaton A).run word k = some live ∧
          (automaton A).run word (k + 1) = some next ∧
          A.accepting (run.path (k + 1)) ∧
          run.path (k + 1) ∈ next.1.childLabelUnion A v) :
    ∃ child childName,
      childName ∈ Finset.range (Fintype.card A.State) ∧
        a < childName ∧
        (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledCoverageChildNameEvent A run v child a childName k) ∧
        ∀ smaller : Nat, smaller < childName ->
          ¬ (smaller ∈ Finset.range (Fintype.card A.State) ∧
              a < smaller ∧
              ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledCoverageNameEvent A run v a smaller k) := by
  rcases exists_min_frequently_settledCoverageNameEvent_of_coverage_branch
      A run hsettle hcoverage with
    ⟨childName, hchildNameMem, hnameGt, hfreqName, hminimal⟩
  rcases exists_frequently_settledCoverageChildNameEvent_of_nameEvent
      A run hfreqName with
    ⟨child, hfreqChildName⟩
  exact ⟨child, childName, hchildNameMem, hnameGt, hfreqChildName,
    hminimal⟩

/--
Finite sideways-move cutoff for the minimal coverage name: once a least
recurring coverage name has been selected, all smaller coverage-name events
disappear after some finite time.  This is the formal version of Piterman proof
4's sentence that moving to a son with a smaller name can happen only finitely
often.
-/
theorem exists_eventually_no_smaller_settledCoverageNameEvent_of_minimal
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a childName : Nat}
    (hminimal :
      ∀ smaller : Nat, smaller < childName ->
        ¬ (smaller ∈ Finset.range (Fintype.card A.State) ∧
            a < smaller ∧
            ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
              SettledCoverageNameEvent A run v a smaller k)) :
    ∃ N : Nat, ∀ k smaller : Nat, N ≤ k ->
      smaller < childName ->
        smaller ∈ Finset.range (Fintype.card A.State) ->
          a < smaller ->
            ¬ SettledCoverageNameEvent A run v a smaller k := by
  classical
  let smallNames : Finset Nat :=
    (Finset.range childName).filter
      (fun smaller =>
        smaller ∈ Finset.range (Fintype.card A.State) ∧ a < smaller)
  have hbound :
      ∀ smaller : Nat, smaller ∈ smallNames ->
        ∃ N : Nat, ∀ k : Nat, N ≤ k ->
          ¬ SettledCoverageNameEvent A run v a smaller k := by
    intro smaller hsmall
    have hlt : smaller < childName := by
      exact Finset.mem_range.mp ((Finset.mem_filter.mp hsmall).1)
    have hcard : smaller ∈ Finset.range (Fintype.card A.State) :=
      (Finset.mem_filter.mp hsmall).2.1
    have hagt : a < smaller :=
      (Finset.mem_filter.mp hsmall).2.2
    have hnotFreq :
        ¬ ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledCoverageNameEvent A run v a smaller k := by
      intro hfreq
      exact hminimal smaller hlt ⟨hcard, hagt, hfreq⟩
    push Not at hnotFreq
    exact hnotFreq
  let boundOf : Nat -> Nat := fun smaller =>
    if hsmall : smaller ∈ smallNames then
      Classical.choose (hbound smaller hsmall)
    else
      0
  refine ⟨smallNames.sup boundOf, ?_⟩
  intro k smaller hNk hlt hcard hagt hevent
  have hsmall : smaller ∈ smallNames := by
    rw [Finset.mem_filter]
    exact ⟨Finset.mem_range.mpr hlt, hcard, hagt⟩
  have hboundLe : boundOf smaller ≤ smallNames.sup boundOf :=
    Finset.le_sup hsmall
  have hboundOf :
      boundOf smaller = Classical.choose (hbound smaller hsmall) := by
    simp [boundOf, hsmall]
  have hchooseLe : Classical.choose (hbound smaller hsmall) ≤ k := by
    omega
  exact (Classical.choose_spec (hbound smaller hsmall)) k hchooseLe hevent

/--
Ordinary child-coverage event at a concrete time, without requiring that this
time was reached by an accepting transition.  This is the all-times event needed
for the final settling argument; accepting coverage events are just one source
of these ordinary coverage events.
-/
def SettledChildCoverageNameAt [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v : Node A)
    (a childName t : Nat) : Prop :=
  ∃ live child,
    (automaton A).run word t = some live ∧
      child ∈ live.1.children A v ∧
      run.path t ∈ live.1.label child ∧
      (live.1.name child).val = childName ∧
      a < childName

/--
Every accepting coverage-name event gives an ordinary child-coverage event at
the successor time.
-/
theorem settledCoverageNameEvent_to_childCoverageNameAt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {a childName k : Nat}
    (hevent : SettledCoverageNameEvent A run v a childName k) :
    SettledChildCoverageNameAt A run v a childName (k + 1) := by
  rcases hevent with
    ⟨child, next, hrunNext, _haccepting, hchild, hmemChild, hnameChild,
      hnameGt⟩
  exact ⟨next, child, hrunNext, hchild, hmemChild, hnameChild, hnameGt⟩

/--
An accepting coverage branch yields an ordinary child-coverage name that recurs
arbitrarily late.
-/
theorem exists_frequently_settledChildCoverageNameAt_of_coverage_branch
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hcoverage :
      ∀ n : Nat, ∃ k live next,
        n ≤ k ∧
          (automaton A).run word k = some live ∧
          (automaton A).run word (k + 1) = some next ∧
          A.accepting (run.path (k + 1)) ∧
          run.path (k + 1) ∈ next.1.childLabelUnion A v) :
    ∃ childName,
      childName ∈ Finset.range (Fintype.card A.State) ∧
        a < childName ∧
        ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
          SettledChildCoverageNameAt A run v a childName t := by
  rcases exists_frequently_settledCoverageNameEvent_of_coverage_branch
      A run hsettle hcoverage with
    ⟨childName, hchildNameMem, hnameGt, hfreqName⟩
  refine ⟨childName, hchildNameMem, hnameGt, ?_⟩
  intro n
  rcases hfreqName n with ⟨k, hnk, hevent⟩
  exact ⟨k + 1, by omega,
    settledCoverageNameEvent_to_childCoverageNameAt A run hevent⟩

/--
Choose a least recurring ordinary child-coverage name.  This is the finite
measure for the final coverage handler, where non-accepting transitions also
matter.
-/
theorem exists_min_frequently_settledChildCoverageNameAt_of_coverage_branch
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hcoverage :
      ∀ n : Nat, ∃ k live next,
        n ≤ k ∧
          (automaton A).run word k = some live ∧
          (automaton A).run word (k + 1) = some next ∧
          A.accepting (run.path (k + 1)) ∧
          run.path (k + 1) ∈ next.1.childLabelUnion A v) :
    ∃ childName,
      childName ∈ Finset.range (Fintype.card A.State) ∧
        a < childName ∧
        (∀ n : Nat, ∃ t : Nat, n ≤ t ∧
          SettledChildCoverageNameAt A run v a childName t) ∧
        ∀ smaller : Nat, smaller < childName ->
          ¬ (smaller ∈ Finset.range (Fintype.card A.State) ∧
              a < smaller ∧
              ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
                SettledChildCoverageNameAt A run v a smaller t) := by
  classical
  let P : Nat -> Prop := fun childName =>
    childName ∈ Finset.range (Fintype.card A.State) ∧
      a < childName ∧
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        SettledChildCoverageNameAt A run v a childName t
  have hexists : ∃ childName, P childName := by
    exact exists_frequently_settledChildCoverageNameAt_of_coverage_branch
      A run hsettle hcoverage
  let childName : Nat := Nat.find hexists
  have hspec : P childName := by
    simpa [childName] using Nat.find_spec hexists
  refine ⟨childName, hspec.1, hspec.2.1, hspec.2.2, ?_⟩
  intro smaller hsmaller
  exact Nat.find_min hexists (by simpa [childName] using hsmaller)

/--
Cutoff for smaller ordinary child-coverage names below the least recurring
ordinary coverage name.
-/
theorem exists_eventually_no_smaller_settledChildCoverageNameAt_of_minimal
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a childName : Nat}
    (hminimal :
      ∀ smaller : Nat, smaller < childName ->
        ¬ (smaller ∈ Finset.range (Fintype.card A.State) ∧
            a < smaller ∧
            ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
              SettledChildCoverageNameAt A run v a smaller t)) :
    ∃ N : Nat, ∀ t smaller : Nat, N ≤ t ->
      smaller < childName ->
        smaller ∈ Finset.range (Fintype.card A.State) ->
          a < smaller ->
            ¬ SettledChildCoverageNameAt A run v a smaller t := by
  classical
  let smallNames : Finset Nat :=
    (Finset.range childName).filter
      (fun smaller =>
        smaller ∈ Finset.range (Fintype.card A.State) ∧ a < smaller)
  have hbound :
      ∀ smaller : Nat, smaller ∈ smallNames ->
        ∃ N : Nat, ∀ t : Nat, N ≤ t ->
          ¬ SettledChildCoverageNameAt A run v a smaller t := by
    intro smaller hsmall
    have hlt : smaller < childName := by
      exact Finset.mem_range.mp ((Finset.mem_filter.mp hsmall).1)
    have hcard : smaller ∈ Finset.range (Fintype.card A.State) :=
      (Finset.mem_filter.mp hsmall).2.1
    have hagt : a < smaller :=
      (Finset.mem_filter.mp hsmall).2.2
    have hnotFreq :
        ¬ ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
          SettledChildCoverageNameAt A run v a smaller t := by
      intro hfreq
      exact hminimal smaller hlt ⟨hcard, hagt, hfreq⟩
    push Not at hnotFreq
    exact hnotFreq
  let boundOf : Nat -> Nat := fun smaller =>
    if hsmall : smaller ∈ smallNames then
      Classical.choose (hbound smaller hsmall)
    else
      0
  refine ⟨smallNames.sup boundOf, ?_⟩
  intro t smaller hNt hlt hcard hagt hevent
  have hsmall : smaller ∈ smallNames := by
    rw [Finset.mem_filter]
    exact ⟨Finset.mem_range.mpr hlt, hcard, hagt⟩
  have hboundLe : boundOf smaller ≤ smallNames.sup boundOf :=
    Finset.le_sup hsmall
  have hboundOf :
      boundOf smaller = Classical.choose (hbound smaller hsmall) := by
    simp [boundOf, hsmall]
  have hchooseLe : Classical.choose (hbound smaller hsmall) ≤ t := by
    omega
  exact (Classical.choose_spec (hbound smaller hsmall)) t hchooseLe hevent

/--
Package a concrete child-coverage witness at time `t` as an ordinary
child-coverage-name event.
-/
theorem settledChildCoverageNameAt_of_child_witness
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v child : Node A}
    {a childName t : Nat} {live : LiveState A}
    (hrun : (automaton A).run word t = some live)
    (hchild : child ∈ live.1.children A v)
    (hmem : run.path t ∈ live.1.label child)
    (hname : (live.1.name child).val = childName)
    (hgt : a < childName) :
    SettledChildCoverageNameAt A run v a childName t :=
  ⟨live, child, hrun, hchild, hmem, hname, hgt⟩

/--
Accepting-run state currently carried by a fixed node at a fixed live-tree name.
This is the successor-time payload exposed by source-name compaction: it is not
yet a lower-source event of the old one-step shape, but it is the exact
accepting-time recurrence needed for the next compactness step.
-/
def AcceptingNodeNameAt [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v : Node A) (nodeName t : Nat) : Prop :=
  ∃ live,
    (automaton A).run word t = some live ∧
      run.path t ∈ live.1.label v ∧
      A.accepting (run.path t) ∧
      (live.1.name v).val = nodeName

/--
Fixed accepting-state form of `AcceptingNodeNameAt`.
-/
def AcceptingNodeNameStateAt [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v : Node A)
    (nodeName : Nat) (target : A.State) (t : Nat) : Prop :=
  ∃ live,
    (automaton A).run word t = some live ∧
      run.path t = target ∧
      A.accepting target ∧
      target ∈ live.1.label v ∧
      (live.1.name v).val = nodeName

/--
Fixed accepting target carried by a fixed child of a fixed source at a fixed
live-tree child name.
-/
def AcceptingChildCoverageChildNameStateAt [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v child : Node A)
    (a childName : Nat) (target : A.State) (t : Nat) : Prop :=
  ∃ live,
    (automaton A).run word t = some live ∧
      run.path t = target ∧
      A.accepting target ∧
      child ∈ live.1.children A v ∧
      target ∈ live.1.label child ∧
      (live.1.name child).val = childName ∧
      a < childName

/--
Reachability-enriched accepting node/name/state occurrence.
-/
def AcceptingNodeNameStateReachableAt [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v : Node A)
    (nodeName : Nat) (target : A.State) (t : Nat) : Prop :=
  AcceptingNodeNameStateAt A run v nodeName target t ∧
    ReachablePrefix A A.initial word t target

/--
Strict source-name drop in the source-survives branch yields the existing
accepting node/name/state payload at the smaller successor source name.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameLtEvent_to_acceptingNodeNameStateAt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameLtEvent
        A run v sourceNode child sourceName sourceState target uncovered k) :
    ∃ smallerName : Nat,
      smallerName ∈ Finset.range sourceName ∧
        AcceptingNodeNameStateAt A run sourceNode smallerName target (k + 1) := by
  rcases hevent with ⟨hsurvives, next, hrunNext, _huncoveredNext, hlt⟩
  rcases hsurvives with ⟨hancestorEvent, nextSurv, hrunNextSurv,
    _huncoveredSurv⟩
  have hnextEqSurv : nextSurv = next := by
    have hsome : some nextSurv = some next := by
      rw [← hrunNextSurv, hrunNext]
    exact Option.some.inj hsome
  subst nextSurv
  rcases hancestorEvent with ⟨hsameChildEvent, _liveAncestor,
    _hrunAncestor, _hancestorRaw⟩
  rcases hsameChildEvent with
    ⟨hmeasureEvent, _nextSame, _hrunNextSame, _hchildNext, _htargetSame⟩
  rcases hmeasureEvent with ⟨hcoveredEvent, _liveMeasure, nextMeasure,
    _hrunMeasure, hrunNextMeasure, _huncoveredLabel, _huncoveredPrivate,
    htargetCovered⟩
  have hnextMeasureEq : nextMeasure = next := by
    have hsome : some nextMeasure = some next := by
      rw [← hrunNextMeasure, hrunNext]
    exact Option.some.inj hsome
  subst nextMeasure
  rcases hcoveredEvent with ⟨hsurvivesEvent, _nextCovered,
    _hrunNextCovered, _htargetCoveredNext⟩
  rcases hsurvivesEvent with ⟨hpositiveChildEvent, _hchildSurvives⟩
  rcases hpositiveChildEvent with ⟨_hpositiveWitness, hchildEvent⟩
  rcases hchildEvent with ⟨hchildUnionEvent, _liveChild, _hrunChild,
    _hchildPayload⟩
  rcases hchildUnionEvent with ⟨hbase, _liveCU, _hrunCU, _hchildUnion⟩
  rcases hbase with
    ⟨_liveBase, nextBase, _hrunBase, hrunNextBase, htargetEq, haccepting,
      _hsourceActive, _hsourceState, _hsegment, _hsourceName⟩
  have hnextBaseEq : nextBase = next := by
    have hsome : some nextBase = some next := by
      rw [← hrunNextBase, hrunNext]
    exact Option.some.inj hsome
  subst nextBase
  let smallerName : Nat := (next.1.name sourceNode).val
  have htargetSource : target ∈ next.1.label sourceNode := by
    rcases next.2 with
      ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
        _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
        hchildSubset, _hsiblingDisjoint⟩
    exact childLabelUnion_subset_label A next.1 hchildSubset sourceNode
      htargetCovered
  exact ⟨smallerName, Finset.mem_range.mpr (by simpa [smallerName] using hlt),
    next, hrunNext, htargetEq, haccepting, htargetSource, rfl⟩

/--
Cofinal strict source-name drops in the source-survives branch concentrate on a
fixed smaller source name in the standard accepting node/name/state payload.
-/
theorem exists_frequently_acceptingNodeNameStateAt_lt_of_sourceUncoveredSurvives_sourceNameLt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameLtEvent
          A run v sourceNode child sourceName sourceState target uncovered k) :
    ∃ smallerName : Nat,
      smallerName ∈ Finset.range sourceName ∧
        ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
          AcceptingNodeNameStateAt A run sourceNode smallerName target t := by
  classical
  have hfreqFilter :
      ∃ᶠ t in Filter.atTop,
        ∃ smallerName ∈ Finset.range sourceName,
          AcceptingNodeNameStateAt A run sourceNode smallerName target t := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with ⟨k, hnk, hevent⟩
    rcases
        settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameLtEvent_to_acceptingNodeNameStateAt
          A run hevent with
      ⟨smallerName, hmem, hnodeAt⟩
    exact ⟨k + 1, by omega, smallerName, hmem, hnodeAt⟩
  rw [Finset.frequently_exists] at hfreqFilter
  rcases hfreqFilter with ⟨smallerName, hmem, hfreqSmaller⟩
  refine ⟨smallerName, hmem, ?_⟩
  intro n
  rcases (Filter.frequently_atTop).1 hfreqSmaller n with
    ⟨t, hnt, hnodeAt⟩
  exact ⟨t, hnt, hnodeAt⟩

/--
Same-source-name survival gives the accepting node/name/state payload at the
unchanged lower-source name, with the fixed uncovered witness still present in
the same successor source label.  This is the interval/countdown payload for the
last branch: the accepting target is already child-covered, but the source has
not compacted below `sourceName`.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameEqEvent_to_acceptingNodeNameStateAt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameEqEvent
        A run v sourceNode child sourceName sourceState target uncovered k) :
    AcceptingNodeNameStateAt A run sourceNode sourceName target (k + 1) ∧
      ∃ next : LiveState A,
        (automaton A).run word (k + 1) = some next ∧
          uncovered ∈ next.1.label sourceNode ∧
          target ∈ next.1.childLabelUnion A sourceNode ∧
          (next.1.name sourceNode).val = sourceName ∧
          target ≠ uncovered := by
  rcases hevent with ⟨hsurvives, next, hrunNext, huncoveredNext, hnameEq⟩
  rcases
      settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent_payload
        A run hsurvives with
    ⟨_live, nextPayload, _hrun, hrunNextPayload, _hactive, _hname,
      _huncoveredPayload, htargetCovered, hne⟩
  have hnextPayloadEq : nextPayload = next := by
    have hsome : some nextPayload = some next := by
      rw [← hrunNextPayload, hrunNext]
    exact Option.some.inj hsome
  subst nextPayload
  rcases hsurvives with ⟨hancestorEvent, nextSurv, hrunNextSurv,
    _huncoveredSurv⟩
  have hnextSurvEq : nextSurv = next := by
    have hsome : some nextSurv = some next := by
      rw [← hrunNextSurv, hrunNext]
    exact Option.some.inj hsome
  subst nextSurv
  rcases hancestorEvent with ⟨hsameChildEvent, _liveAncestor,
    _hrunAncestor, _hancestorRaw⟩
  rcases hsameChildEvent with
    ⟨hmeasureEvent, _nextSame, _hrunNextSame, _hchildNext, _htargetSame⟩
  rcases hmeasureEvent with ⟨hcoveredEvent, _liveMeasure, nextMeasure,
    _hrunMeasure, hrunNextMeasure, _huncoveredLabel, _huncoveredPrivate,
    _htargetCoveredMeasure⟩
  have hnextMeasureEq : nextMeasure = next := by
    have hsome : some nextMeasure = some next := by
      rw [← hrunNextMeasure, hrunNext]
    exact Option.some.inj hsome
  subst nextMeasure
  rcases hcoveredEvent with ⟨hsurvivesEvent, _nextCovered,
    _hrunNextCovered, _htargetCoveredNext⟩
  rcases hsurvivesEvent with ⟨hpositiveChildEvent, _hchildSurvives⟩
  rcases hpositiveChildEvent with ⟨_hpositiveWitness, hchildEvent⟩
  rcases hchildEvent with ⟨hchildUnionEvent, _liveChild, _hrunChild,
    _hchildPayload⟩
  rcases hchildUnionEvent with ⟨hbase, _liveCU, _hrunCU, _hchildUnion⟩
  rcases hbase with
    ⟨_liveBase, nextBase, _hrunBase, hrunNextBase, htargetEq, haccepting,
      _hsourceActive, _hsourceState, _hsegment, _hsourceName⟩
  have hnextBaseEq : nextBase = next := by
    have hsome : some nextBase = some next := by
      rw [← hrunNextBase, hrunNext]
    exact Option.some.inj hsome
  subst nextBase
  have htargetSource : target ∈ next.1.label sourceNode := by
    rcases next.2 with
      ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
        _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
        hchildSubset, _hsiblingDisjoint⟩
    exact childLabelUnion_subset_label A next.1 hchildSubset sourceNode
      htargetCovered
  exact
    ⟨⟨next, hrunNext, htargetEq, haccepting, htargetSource, hnameEq⟩,
      next, hrunNext, huncoveredNext, htargetCovered, hnameEq, hne⟩

/--
Cofinal same-source-name survival gives cofinal accepting occurrences of the
same lower source at the same name.
-/
theorem frequently_sourceNameEq_to_acceptingNodeNameStateAt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameEqEvent
          A run v sourceNode child sourceName sourceState target uncovered k) :
    ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
      AcceptingNodeNameStateAt A run sourceNode sourceName target t := by
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  exact ⟨k + 1, by omega,
    (settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameEqEvent_to_acceptingNodeNameStateAt
      A run hevent).1⟩

/--
Cofinal same-source-name survival is already a cofinal child-coverage branch
for the fixed lower source: the accepting successor target lies in the
successor child-union of `sourceNode`.
-/
theorem frequently_sourceNameEq_to_source_childCoverage_branch
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameEqEvent
          A run v sourceNode child sourceName sourceState target uncovered k) :
    ∀ n : Nat, ∃ k live next,
      n ≤ k ∧
        (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        A.accepting (run.path (k + 1)) ∧
        run.path (k + 1) ∈ next.1.childLabelUnion A sourceNode := by
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  rcases hevent with ⟨hsurvives, next, hrunNext, _huncoveredNext, _hnameEq⟩
  rcases
      settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent_payload
        A run hsurvives with
    ⟨live, nextPayload, hrun, hrunNextPayload, _hactive, _hname,
      _huncoveredPayload, htargetCovered, _hne⟩
  have hnextPayloadEq : nextPayload = next := by
    have hsome : some nextPayload = some next := by
      rw [← hrunNextPayload, hrunNext]
    exact Option.some.inj hsome
  subst nextPayload
  rcases
      settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameEqEvent_to_acceptingNodeNameStateAt
        A run ⟨hsurvives, next, hrunNext, _huncoveredNext, _hnameEq⟩ with
    ⟨hnodeAt, _payload⟩
  rcases hnodeAt with
    ⟨_nextNode, hrunNode, htargetEq, haccepting, _htargetSource,
      _hnameNode⟩
  have hnextNodeEq : next = next := rfl
  exact
    ⟨k, live, next, hnk, hrun, hrunNext,
      by simpa [htargetEq],
      by simpa [htargetEq, hnextNodeEq] using htargetCovered⟩

/--
Current-tree payload of a fixed accepting node/name/state occurrence.  This is
the direct formal counterpart of the paper statement that the accepting run is
currently carried by the fixed node with the fixed dynamic name.
-/
theorem acceptingNodeNameStateAt_current_active_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t : Nat}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t) :
    ∃ live : LiveState A,
      (automaton A).run word t = some live ∧
        live.1.active v = true ∧
        target ∈ live.1.label v ∧
        (live.1.name v).val = nodeName ∧
        run.path t = target ∧
        A.accepting target := by
  rcases hevent with
    ⟨live, hrun, htargetEq, haccepting, htargetLabel, hname⟩
  exact ⟨live, hrun, active_of_mem_label A live.1 live.2 htargetLabel,
    htargetLabel, hname, htargetEq, haccepting⟩

/--
Strict-cut current-tree payload.  At every selected source-drop cut, the fixed
source node is active with the fixed lower name in the live tree at that cut.
-/
theorem strict_cuts_acceptingNodeNameStateAt_current_active_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {cuts : Nat -> Nat}
    (hevents :
      ∀ i : Nat,
        AcceptingNodeNameStateAt A run v nodeName target
          (cuts (i + 1))) :
    ∀ i : Nat,
      ∃ live : LiveState A,
        (automaton A).run word (cuts (i + 1)) = some live ∧
          live.1.active v = true ∧
          target ∈ live.1.label v ∧
          (live.1.name v).val = nodeName ∧
          run.path (cuts (i + 1)) = target ∧
          A.accepting target := by
  intro i
  exact acceptingNodeNameStateAt_current_active_name A run (hevents i)

/--
Strict-cut predecessor/current payload.  In the nonzero strict-cut sequence, the
previous live tree at `cut - 1` exists, and the current cut tree carries the
fixed accepting state in the fixed node/name.  The still-missing paper step is
to relate these two live trees by showing that the current node/name survived
from the predecessor unless a lower-source or green-ancestor alternative occurs.
-/
theorem strict_cuts_acceptingNodeNameStateAt_prev_live_current_active_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    {v : Node A} {nodeName : Nat} {target : A.State}
    {cuts : Nat -> Nat}
    (hstrict : ∀ i : Nat, cuts i < cuts (i + 1))
    (hevents :
      ∀ i : Nat,
        AcceptingNodeNameStateAt A run v nodeName target
          (cuts (i + 1))) :
    ∀ i : Nat,
      ∃ prev live : LiveState A,
        (automaton A).run word (cuts (i + 1) - 1) = some prev ∧
          (automaton A).run word (cuts (i + 1)) = some live ∧
          live.1.active v = true ∧
          target ∈ live.1.label v ∧
          (live.1.name v).val = nodeName ∧
          run.path (cuts (i + 1)) = target ∧
          A.accepting target := by
  intro i
  have hpos : 0 < cuts (i + 1) := by
    have hle : i + 1 ≤ cuts (i + 1) :=
      self_le_of_strict_succ_cuts cuts hstrict (i + 1)
    omega
  rcases acceptingNodeNameStateAt_current_active_name A run (hevents i) with
    ⟨live, hrunLive, hactive, htargetLabel, hname, htargetEq, haccepting⟩
  have hsucc : cuts (i + 1) - 1 + 1 = cuts (i + 1) :=
    Nat.sub_add_cancel hpos
  rcases
      automaton_run_exists_live_of_later_run
        A word (start := cuts (i + 1) - 1) (length := 1) (i := 0)
        (by omega)
        (by simpa [hsucc] using hrunLive) with
    ⟨prev, hprev⟩
  exact ⟨prev, live, hprev, hrunLive, hactive, htargetLabel, hname,
    htargetEq, haccepting⟩

/--
One-step name monotonicity at an accepting node/name cut.  If the fixed node was
already active in the predecessor live tree, then the selected cut either has
the same predecessor name required by the stage-(1) source bridge, or the node's
dynamic name strictly decreased across this transition.  This is the local Lean
form of the paper's "the run may move to a son with a smaller name" clause.
-/
theorem acceptingNodeNameStateAt_prev_active_same_or_name_decreases
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactivePrev : prev.1.active v = true) :
    (prev.1.name v).val = nodeName ∨
      nodeName < (prev.1.name v).val := by
  rcases hevent with
    ⟨live, hrunLive, htargetEq, _haccepting, htargetLabel, hnameLive⟩
  have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel hpos
  have hle :
      (live.1.name v).val ≤ (prev.1.name v).val :=
    automaton_run_live_name_val_le_of_active_next_label
      A word hprev (by simpa [hsucc] using hrunLive) hactivePrev
      (by simpa [hsucc] using htargetLabel)
  have hnodeLe : nodeName ≤ (prev.1.name v).val := by
    omega
  rcases Nat.eq_or_lt_of_le hnodeLe with hEq | hLt
  · exact Or.inl (by omega)
  · exact Or.inr hLt

/--
Strict-cut version of the one-step name fork.  For each selected cut, if the
fixed source node is active in the predecessor live tree, then either the
predecessor already has the fixed lower name, or the transition strictly
decreased that node's dynamic name.
-/
theorem strict_cuts_acceptingNodeNameStateAt_prev_active_same_or_name_decreases
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {cuts : Nat -> Nat}
    (hstrict : ∀ i : Nat, cuts i < cuts (i + 1))
    (hevents :
      ∀ i : Nat,
        AcceptingNodeNameStateAt A run v nodeName target
          (cuts (i + 1)))
    (hprevs :
      ∀ i : Nat,
        ∃ prev : LiveState A,
          (automaton A).run word (cuts (i + 1) - 1) = some prev ∧
            prev.1.active v = true) :
    ∀ i : Nat,
      ∃ prev : LiveState A,
        (automaton A).run word (cuts (i + 1) - 1) = some prev ∧
          prev.1.active v = true ∧
          ((prev.1.name v).val = nodeName ∨
            nodeName < (prev.1.name v).val) := by
  intro i
  have hpos : 0 < cuts (i + 1) := by
    have hle : i + 1 ≤ cuts (i + 1) :=
      self_le_of_strict_succ_cuts cuts hstrict (i + 1)
    omega
  rcases hprevs i with ⟨prev, hprev, hactivePrev⟩
  exact ⟨prev, hprev, hactivePrev,
    acceptingNodeNameStateAt_prev_active_same_or_name_decreases
      A run (hevents i) hpos hprev hactivePrev⟩

/--
Paper-facing fresh-child origin for the complementary one-step case.  If the
fixed node carrying the accepting target at a nonzero cut was inactive in the
predecessor live tree, then that occurrence was created by stage (2) as the
fresh child of a concrete predecessor parent.  Moreover the accepting run step
is witnessed by a real one-step segment from the predecessor label of that
parent.  This is the formal version of the paper clause where the run enters a
new son after an accepting transition.
-/
theorem acceptingNodeNameStateAt_prev_inactive_fresh_source_segment
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hprevInactive : prev.1.active v = false) :
    ∃ parent sourceState,
      parent ∈ (prev.1.stage1 A (word (t - 1))).stage2Triggers A ∧
        (livePlan A prev (word (t - 1))).stage2Plan.freshChild parent = v ∧
        sourceState ∈ prev.1.label parent ∧
          SegmentVisitsAccepting A word (t - 1) 1 sourceState target := by
  let t1 := prev.1.stage1 A (word (t - 1))
  let plan := livePlan A prev (word (t - 1))
  let t2 := t1.stage2 A plan.stage2Plan
  let t3 := t2.stage3 A
  rcases hevent with
    ⟨live, hrunLive, _htargetEq, haccepting, htargetLabel, _hnameLive⟩
  have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel hpos
  have hnextTree :
      live.1 = liveNextTree A prev (word (t - 1)) :=
    automaton_run_live_nextTree A word hprev
      (by simpa [hsucc] using hrunLive)
  have htargetLiveNext :
      target ∈ (liveNextTree A prev (word (t - 1))).label v := by
    simpa [hnextTree] using htargetLabel
  have htargetT3 : target ∈ t3.label v := by
    exact
      (transitionWithPlan_label_subset_stage3
        A prev.1 (word (t - 1)) plan v)
        (by simpa [liveNextTree, t1, plan, t2, t3] using
          htargetLiveNext)
  have htargetT2 : target ∈ t2.label v :=
    stage3_label_subset A t2 v htargetT3
  rcases prev.2 with
    ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
      hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have hinactiveT1 :
      ∀ node, t1.active node = false -> t1.label node = ∅ := by
    simpa [t1] using
      stage1_preserves_inactive_label A prev.1 (word (t - 1))
        hinactiveLabel
  have hinactiveT2 :
      ∀ node, t2.active node = false -> t2.label node = ∅ := by
    simpa [t2] using
      stage2_preserves_inactive_label A t1 plan.stage2Plan hinactiveT1
  have hactiveT2 : t2.active v = true := by
    cases hactive : t2.active v
    · have hempty : t2.label v = ∅ := hinactiveT2 v hactive
      rw [hempty] at htargetT2
      simp at htargetT2
    · rfl
  rcases stage2_active_cases A t1 plan.stage2Plan hactiveT2 with
    hold | hfresh
  · have hprevActive : prev.1.active v = true := by
      simpa [t1, stage1_active A prev.1 (word (t - 1)) v] using hold
    rw [hprevInactive] at hprevActive
    simp at hprevActive
  · rcases hfresh with ⟨parent, htrigger, hfresh⟩
    have htargetFresh :
        target ∈ t2.label (plan.stage2Plan.freshChild parent) := by
      simpa [hfresh] using htargetT2
    have htargetParent :
        target ∈ t1.label parent ∧ A.accepting target :=
      (mem_stage2_freshChild_label A t1 plan.stage2Plan htrigger).mp
        htargetFresh
    rcases stage1_label_segment A prev.1 word htargetParent.1 with
      ⟨sourceState, hsourceState, hsegment⟩
    refine ⟨parent, sourceState, htrigger, hfresh, hsourceState, ?_⟩
    exact
      segmentVisitsAccepting_of_segment_accepting_target A word hsegment
        htargetParent.2

/--
Complete one-step fixed-son fork.  At a nonzero accepting node/name cut, the
tracked node either already existed in the predecessor with the same dynamic
name, existed with a larger predecessor name (the paper's finite "move to a
smaller name" case), or was just created as a fresh son from a concrete
accepting predecessor-parent segment.
-/
theorem acceptingNodeNameStateAt_prev_same_or_decreases_or_fresh_source_segment
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev) :
    (prev.1.active v = true ∧ (prev.1.name v).val = nodeName) ∨
      (prev.1.active v = true ∧ nodeName < (prev.1.name v).val) ∨
      ∃ parent sourceState,
        prev.1.active v = false ∧
          parent ∈ (prev.1.stage1 A (word (t - 1))).stage2Triggers A ∧
          (livePlan A prev (word (t - 1))).stage2Plan.freshChild parent = v ∧
          sourceState ∈ prev.1.label parent ∧
            SegmentVisitsAccepting A word (t - 1) 1 sourceState target := by
  cases hactivePrev : prev.1.active v
  · rcases
        acceptingNodeNameStateAt_prev_inactive_fresh_source_segment
          A run hevent hpos hprev hactivePrev with
      ⟨parent, sourceState, htrigger, hfresh, hsourceState, hsegment⟩
    exact Or.inr <| Or.inr
      ⟨parent, sourceState, rfl, htrigger, hfresh, hsourceState,
        hsegment⟩
  · have hactivePrevTrue : prev.1.active v = true := hactivePrev
    rcases
        acceptingNodeNameStateAt_prev_active_same_or_name_decreases
          A run hevent hpos hprev hactivePrevTrue with
      hsame | hdecreases
    · exact Or.inl ⟨rfl, hsame⟩
    · exact Or.inr <| Or.inl ⟨rfl, hdecreases⟩

/--
Fresh-son lower-source extraction.  In the predecessor-inactive branch of a
fixed accepting node/name cut, the predecessor parent that created the fresh son
is itself a genuine lower-source node/name/source/target event at time `t - 1`.
This is the construction-facing contradiction hook for ruling out infinitely
many fresh-son moves below the minimal lower-source cutoff.
-/
theorem acceptingNodeNameStateAt_prev_inactive_fresh_parent_to_lowerSourceNodeNameStateTargetEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hprevInactive : prev.1.active v = false) :
    ∃ parent sourceState,
      parent ∈ (prev.1.stage1 A (word (t - 1))).stage2Triggers A ∧
        (livePlan A prev (word (t - 1))).stage2Plan.freshChild parent = v ∧
        SettledLowerSourceNodeNameStateTargetEvent A run parent
          (prev.1.name parent).val sourceState target (t - 1) := by
  rcases
      acceptingNodeNameStateAt_prev_inactive_fresh_source_segment
        A run hevent hpos hprev hprevInactive with
    ⟨parent, sourceState, htrigger, hfresh, hsourceState, hsegment⟩
  rcases hevent with
    ⟨next, hrunNext, htargetEq, haccepting, _htargetLabel, _hnodeName⟩
  have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel hpos
  have hparentActiveStage1 :
      (prev.1.stage1 A (word (t - 1))).active parent = true :=
    (mem_stage2Triggers A (prev.1.stage1 A (word (t - 1)))).mp
      htrigger |>.1
  have hparentActive : prev.1.active parent = true := by
    simpa [stage1_active A prev.1 (word (t - 1)) parent] using
      hparentActiveStage1
  refine ⟨parent, sourceState, htrigger, hfresh, prev, next, hprev, ?_, ?_,
    haccepting, hparentActive, hsourceState, hsegment, rfl⟩
  · simpa [hsucc] using hrunNext
  · simpa [hsucc] using htargetEq

/--
No-smaller consequence for the fresh-son branch.  After the lower-source cutoff,
the predecessor parent that creates a fresh son at a selected accepting cut
cannot have name below the ambient minimal name `m`; otherwise the previous
lemma gives a forbidden lower-source event at `t - 1`.
-/
theorem acceptingNodeNameStateAt_prev_inactive_fresh_parent_name_ge_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m N : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ t - 1)
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hprevInactive : prev.1.active v = false) :
    ∃ parent sourceState,
      parent ∈ (prev.1.stage1 A (word (t - 1))).stage2Triggers A ∧
        (livePlan A prev (word (t - 1))).stage2Plan.freshChild parent = v ∧
        m ≤ (prev.1.name parent).val ∧
        SettledLowerSourceNodeNameStateTargetEvent A run parent
          (prev.1.name parent).val sourceState target (t - 1) := by
  rcases
      acceptingNodeNameStateAt_prev_inactive_fresh_parent_to_lowerSourceNodeNameStateTargetEvent
        A run hevent hpos hprev hprevInactive with
    ⟨parent, sourceState, htrigger, hfresh, hlowerTarget⟩
  have hnameGe : m ≤ (prev.1.name parent).val := by
    by_contra hnot
    have hlt : (prev.1.name parent).val < m := by omega
    have hlowerName :
        SettledLowerSourceNameEvent A run (prev.1.name parent).val (t - 1) :=
      settledLowerSourceNodeNameEvent_to_nameEvent A run
        (settledLowerSourceNodeNameStateEvent_to_nodeNameEvent A run
          (settledLowerSourceNodeNameStateTargetEvent_to_stateEvent A run
            hlowerTarget))
    exact hnoSmaller (t - 1) (prev.1.name parent).val hNk hlt hlowerName
  exact ⟨parent, sourceState, htrigger, hfresh, hnameGe, hlowerTarget⟩

/--
Predecessor-active lower-source extraction at the predecessor's own dynamic
name.  Unlike `acceptingNodeNameStateAt_prev_active_name_to_lowerSourceNameEvent`
below, this does not require the predecessor name to equal the compacted current
name at the accepting cut.  It is the branch hook for the paper's finite
name-drop case: before a compacting drop, the old node/name was still a real
lower-source event at the previous time.
-/
theorem acceptingNodeNameStateAt_prev_active_to_lowerSourceNodeNameStateTargetEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true) :
    ∃ sourceState : A.State,
      SettledLowerSourceNodeNameStateTargetEvent A run v
        (prev.1.name v).val sourceState target (t - 1) := by
  rcases hevent with
    ⟨next, hrunNext, htargetEq, haccepting, htargetLabel, _hnodeName⟩
  have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel hpos
  have hrunNextPrev :
      (automaton A).run word ((t - 1) + 1) = some next := by
    simpa [hsucc] using hrunNext
  have hnextTree : next.1 = liveNextTree A prev (word (t - 1)) :=
    automaton_run_live_nextTree A word hprev hrunNextPrev
  have htargetNextTree :
      target ∈ (liveNextTree A prev (word (t - 1))).label v := by
    simpa [hnextTree] using htargetLabel
  rcases
      liveNextTree_active_label_segment_from_same_node
        A word (n := t - 1) prev hactive htargetNextTree with
    ⟨sourceState, hsource, hsegment⟩
  have hsegmentAccepting :
      SegmentVisitsAccepting A word (t - 1) 1 sourceState target :=
    segmentVisitsAccepting_of_segment_accepting_target A word hsegment
      haccepting
  exact ⟨sourceState, prev, next, hprev, hrunNextPrev,
    by simpa [hsucc] using htargetEq, haccepting, hactive, hsource,
    hsegmentAccepting, rfl⟩

/--
No-smaller consequence for the predecessor-active branch.  After the cutoff for
lower-source events below ambient `m`, any predecessor-active carrier of a
selected accepting cut must have predecessor name at least `m`; otherwise the
previous lemma creates a forbidden lower-source event at `t - 1`.
-/
theorem acceptingNodeNameStateAt_prev_active_name_ge_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m N : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ t - 1)
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true) :
    m ≤ (prev.1.name v).val := by
  by_contra hnot
  have hlt : (prev.1.name v).val < m := by omega
  rcases
      acceptingNodeNameStateAt_prev_active_to_lowerSourceNodeNameStateTargetEvent
        A run hevent hpos hprev hactive with
    ⟨sourceState, hlowerTarget⟩
  have hlowerName :
      SettledLowerSourceNameEvent A run (prev.1.name v).val (t - 1) :=
    settledLowerSourceNodeNameEvent_to_nameEvent A run
      (settledLowerSourceNodeNameStateEvent_to_nodeNameEvent A run
        (settledLowerSourceNodeNameStateTargetEvent_to_stateEvent A run
          hlowerTarget))
  exact hnoSmaller (t - 1) (prev.1.name v).val hNk hlt hlowerName

/--
Accepting-cut specialization of the stage-(6) compaction witness.  If the fixed
node was active in the predecessor and the selected current name is strictly
smaller than the predecessor name, then the transition removed some node with
old stage-(5) name below that predecessor name.  The returned tree is the exact
stage-(5) tree used by the transition from `t - 1` to `t`.
-/
theorem acceptingNodeNameStateAt_prev_active_name_drop_removed_before
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hdrop : nodeName < (prev.1.name v).val) :
    let t1 := prev.1.stage1 A (word (t - 1))
    let plan := (livePlan A prev (word (t - 1))).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    let t4 := t3.stage4 A
    let t5 := t4.stage5 A (t3.greenRemovedNodes A)
    let removed := t3.greenRemovedNodes A ∪ t4.emptyActiveNodes A
    ∃ old,
      old ∈ removed ∧ (t5.name old).val < (prev.1.name v).val := by
  rcases hevent with
    ⟨next, hrunNext, _htargetEq, _haccepting, htargetLabel, hnodeName⟩
  have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel hpos
  have hdropNext : (next.1.name v).val < (prev.1.name v).val := by
    omega
  exact
    automaton_run_live_name_drop_exists_removed_before
      A word hprev (by simpa [hsucc] using hrunNext) hactive
      (by simpa [hsucc] using htargetLabel) hdropNext

/--
No-smaller form of the previous compaction witness.  At a late selected cut,
if the fixed source node was predecessor-active and its current selected name
strictly dropped below its predecessor name, then the predecessor name is at
least the ambient minimal name `m`, and the transition exposes a removed
lower-name node before that predecessor carrier.
-/
theorem acceptingNodeNameStateAt_prev_active_name_drop_removed_before_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m N : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ t - 1)
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hdrop : nodeName < (prev.1.name v).val) :
    let t1 := prev.1.stage1 A (word (t - 1))
    let plan := (livePlan A prev (word (t - 1))).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    let t4 := t3.stage4 A
    let t5 := t4.stage5 A (t3.greenRemovedNodes A)
    let removed := t3.greenRemovedNodes A ∪ t4.emptyActiveNodes A
    m ≤ (prev.1.name v).val ∧
      ∃ old,
        old ∈ removed ∧ (t5.name old).val < (prev.1.name v).val := by
  refine ⟨?_, ?_⟩
  · exact acceptingNodeNameStateAt_prev_active_name_ge_of_no_smaller
      A run hnoSmaller hNk hevent hpos hprev hactive
  · exact acceptingNodeNameStateAt_prev_active_name_drop_removed_before
      A run hevent hpos hprev hactive hdrop

/--
Threshold version of the compaction-drop witness at an accepting cut.  Once
late lower-source events below `m` have been excluded, a predecessor-active
carrier whose current selected name lies below `m` can only get there by
compacting past a removed node whose old stage-(5) name was already below `m`.
This is the paper-facing finite-name-drop case, phrased at the fixed minimal
lower-source threshold rather than at the predecessor carrier's old name.
-/
theorem acceptingNodeNameStateAt_prev_active_name_threshold_drop_removed_before_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m N : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ t - 1)
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hnodeLt : nodeName < m) :
    let t1 := prev.1.stage1 A (word (t - 1))
    let plan := (livePlan A prev (word (t - 1))).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    let t4 := t3.stage4 A
    let t5 := t4.stage5 A (t3.greenRemovedNodes A)
    let removed := t3.greenRemovedNodes A ∪ t4.emptyActiveNodes A
    m ≤ (prev.1.name v).val ∧
      ∃ old,
        old ∈ removed ∧ (t5.name old).val < m := by
  refine ⟨?_, ?_⟩
  · exact acceptingNodeNameStateAt_prev_active_name_ge_of_no_smaller
      A run hnoSmaller hNk hevent hpos hprev hactive
  · rcases hevent with
      ⟨next, hrunNext, _htargetEq, _haccepting, htargetLabel, hnodeName⟩
    have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel hpos
    have hdropNext : (next.1.name v).val < m := by
      omega
    exact
      automaton_run_live_name_threshold_drop_exists_removed_before
        A word hprev (by simpa [hsucc] using hrunNext) hactive
        (by simpa [hsucc] using htargetLabel)
        (acceptingNodeNameStateAt_prev_active_name_ge_of_no_smaller
          A run hnoSmaller hNk
          ⟨next, hrunNext, _htargetEq, _haccepting, htargetLabel,
            hnodeName⟩
          hpos hprev hactive)
        hdropNext

/--
Construction-cause split for the strict-name-drop witness.  The removed
lower-name node exposed by compaction is either removed by a green ancestor in
stage (4), or is an empty active node removed in stage (5).  These are the two
remaining paper branches behind a late strict source-name drop.
-/
theorem acceptingNodeNameStateAt_prev_active_name_drop_green_or_empty_removed_before_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m N : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ t - 1)
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hdrop : nodeName < (prev.1.name v).val) :
    let t1 := prev.1.stage1 A (word (t - 1))
    let plan := (livePlan A prev (word (t - 1))).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    let t4 := t3.stage4 A
    let t5 := t4.stage5 A (t3.greenRemovedNodes A)
    m ≤ (prev.1.name v).val ∧
      ((∃ old,
        old ∈ t3.greenRemovedNodes A ∧
          (t5.name old).val < (prev.1.name v).val) ∨
        ∃ old,
          old ∈ t4.emptyActiveNodes A ∧
            (t5.name old).val < (prev.1.name v).val) := by
  let t1 := prev.1.stage1 A (word (t - 1))
  let plan := (livePlan A prev (word (t - 1))).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let t5 := t4.stage5 A (t3.greenRemovedNodes A)
  rcases
      acceptingNodeNameStateAt_prev_active_name_drop_removed_before_of_no_smaller
        A run hnoSmaller hNk hevent hpos hprev hactive hdrop with
    ⟨hnameGe, old, hold, hnameOldLt⟩
  refine ⟨hnameGe, ?_⟩
  have holdSplit :
      old ∈ t3.greenRemovedNodes A ∨ old ∈ t4.emptyActiveNodes A := by
    have hold' :
        old ∈ t3.greenRemovedNodes A ∪ t4.emptyActiveNodes A := by
      simpa [t1, plan, t2, t3, t4, t5] using hold
    exact Finset.mem_union.mp hold'
  rcases holdSplit with hgreen | hempty
  · exact Or.inl ⟨old, hgreen, by simpa [t1, plan, t2, t3, t4, t5] using hnameOldLt⟩
  · exact Or.inr ⟨old, hempty, by simpa [t1, plan, t2, t3, t4, t5] using hnameOldLt⟩

/--
Threshold construction-cause split for a late accepting cut below the minimal
lower-source name.  The compaction witness below `m` is either a stage-(4)
green-removal witness or a stage-(5) empty-removal witness.  This is the exact
branch split needed to eliminate the last source-persistence obstruction.
-/
theorem acceptingNodeNameStateAt_prev_active_name_threshold_drop_green_or_empty_removed_before_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m N : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ t - 1)
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hnodeLt : nodeName < m) :
    let t1 := prev.1.stage1 A (word (t - 1))
    let plan := (livePlan A prev (word (t - 1))).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    let t4 := t3.stage4 A
    let t5 := t4.stage5 A (t3.greenRemovedNodes A)
    m ≤ (prev.1.name v).val ∧
      ((∃ old,
        old ∈ t3.greenRemovedNodes A ∧
          (t5.name old).val < m) ∨
        ∃ old,
          old ∈ t4.emptyActiveNodes A ∧
            (t5.name old).val < m) := by
  let t1 := prev.1.stage1 A (word (t - 1))
  let plan := (livePlan A prev (word (t - 1))).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let t5 := t4.stage5 A (t3.greenRemovedNodes A)
  rcases
      acceptingNodeNameStateAt_prev_active_name_threshold_drop_removed_before_of_no_smaller
        A run hnoSmaller hNk hevent hpos hprev hactive hnodeLt with
    ⟨hnameGe, old, hold, hnameOldLt⟩
  refine ⟨hnameGe, ?_⟩
  have holdSplit :
      old ∈ t3.greenRemovedNodes A ∨ old ∈ t4.emptyActiveNodes A := by
    have hold' :
        old ∈ t3.greenRemovedNodes A ∪ t4.emptyActiveNodes A := by
      simpa [t1, plan, t2, t3, t4, t5] using hold
    exact Finset.mem_union.mp hold'
  rcases holdSplit with hgreen | hempty
  · exact Or.inl ⟨old, hgreen, by simpa [t1, plan, t2, t3, t4, t5] using hnameOldLt⟩
  · exact Or.inr ⟨old, hempty, by simpa [t1, plan, t2, t3, t4, t5] using hnameOldLt⟩

/--
Green-removal refinement of the strict-drop witness.  In the green half of the
stage-(6) compaction split, the removed lower-name node has an actual green
ancestor in the stage-(3) tree, and that green node's name is still below the
predecessor carrier's old name.  This exposes the concrete green firing behind
the opaque `greenRemovedNodes` membership.
-/
theorem acceptingNodeNameStateAt_prev_active_name_drop_green_removed_before_green_witness
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hdrop : nodeName < (prev.1.name v).val)
    (hgreenRemoved :
      let t1 := prev.1.stage1 A (word (t - 1))
      let plan := (livePlan A prev (word (t - 1))).stage2Plan
      let t2 := t1.stage2 A plan
      let t3 := t2.stage3 A
      let t4 := t3.stage4 A
      let t5 := t4.stage5 A (t3.greenRemovedNodes A)
      ∃ old,
        old ∈ t3.greenRemovedNodes A ∧
          (t5.name old).val < (prev.1.name v).val) :
    let t1 := prev.1.stage1 A (word (t - 1))
    let plan := (livePlan A prev (word (t - 1))).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    ∃ old green,
      old ∈ t3.greenRemovedNodes A ∧
        green ∈ t3.greenNodes A ∧
        (t3.name green).val < (prev.1.name v).val := by
  let t1 := prev.1.stage1 A (word (t - 1))
  let plan := (livePlan A prev (word (t - 1))).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let t5 := t4.stage5 A (t3.greenRemovedNodes A)
  rcases hgreenRemoved with ⟨old, holdGreen, holdNameLt⟩
  have hremoved : t3.RemovedByGreen A old :=
    (mem_greenRemovedNodes A t3).mp holdGreen
  rcases prev.2 with
    ⟨hrootActive, _hrootName, hrootParent, hparentInvariant, _hinactiveLabel,
      _hbound, hinjective, _hconsecutive, _hproper, hchildSubset,
      _hsiblingDisjoint⟩
  obtain ⟨hwfRoot, hwfParent, _hwfChild, _hwfSibling⟩ :=
    stage1_stage2_stage3_invariants A prev.1 (word (t - 1)) plan
      hrootActive hrootParent hparentInvariant hchildSubset hinjective
  rcases
      removedByGreen_exists_green_name_lt A t3 hwfRoot hwfParent hremoved with
    ⟨green, hgreen, hgreenLtOld⟩
  have ht5NameOld : (t5.name old).val = (t3.name old).val := by
    simp [t4, t5, stage5_name A t4 (t3.greenRemovedNodes A) old,
      stage4_name A t3 old]
  have holdNameLtT3 : (t3.name old).val < (prev.1.name v).val := by
    rwa [← ht5NameOld]
  refine ⟨old, green, holdGreen, hgreen, ?_⟩
  exact lt_trans hgreenLtOld holdNameLtT3

/--
No-smaller version of the green-removal refinement.  A late strict drop whose
compaction witness lies in `greenRemovedNodes` exposes both the predecessor
carrier bound `m ≤ oldName` and a concrete stage-(3) green node firing below
that predecessor name.
-/
theorem acceptingNodeNameStateAt_prev_active_name_drop_green_removed_before_green_witness_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m N : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ t - 1)
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hdrop : nodeName < (prev.1.name v).val)
    (hgreenRemoved :
      let t1 := prev.1.stage1 A (word (t - 1))
      let plan := (livePlan A prev (word (t - 1))).stage2Plan
      let t2 := t1.stage2 A plan
      let t3 := t2.stage3 A
      let t4 := t3.stage4 A
      let t5 := t4.stage5 A (t3.greenRemovedNodes A)
      ∃ old,
        old ∈ t3.greenRemovedNodes A ∧
          (t5.name old).val < (prev.1.name v).val) :
    let t1 := prev.1.stage1 A (word (t - 1))
    let plan := (livePlan A prev (word (t - 1))).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    m ≤ (prev.1.name v).val ∧
      ∃ old green,
        old ∈ t3.greenRemovedNodes A ∧
          green ∈ t3.greenNodes A ∧
          (t3.name green).val < (prev.1.name v).val := by
  refine ⟨?_, ?_⟩
  · exact acceptingNodeNameStateAt_prev_active_name_ge_of_no_smaller
      A run hnoSmaller hNk hevent hpos hprev hactive
  · exact
      acceptingNodeNameStateAt_prev_active_name_drop_green_removed_before_green_witness
        A run hevent hpos hprev hactive hdrop hgreenRemoved

/--
Threshold green-removal payload.  If the cutoff-level compaction witness lies
in `greenRemovedNodes`, then the stage-(3) tree contains a concrete green node
whose name is already below the minimal lower-source threshold `m`.
-/
theorem acceptingNodeNameStateAt_prev_active_name_threshold_drop_green_removed_before_green_witness
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hgreenRemoved :
      let t1 := prev.1.stage1 A (word (t - 1))
      let plan := (livePlan A prev (word (t - 1))).stage2Plan
      let t2 := t1.stage2 A plan
      let t3 := t2.stage3 A
      let t4 := t3.stage4 A
      let t5 := t4.stage5 A (t3.greenRemovedNodes A)
      ∃ old,
        old ∈ t3.greenRemovedNodes A ∧
          (t5.name old).val < m) :
    let t1 := prev.1.stage1 A (word (t - 1))
    let plan := (livePlan A prev (word (t - 1))).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    ∃ old green,
      old ∈ t3.greenRemovedNodes A ∧
        green ∈ t3.greenNodes A ∧
        (t3.name green).val < m := by
  let t1 := prev.1.stage1 A (word (t - 1))
  let plan := (livePlan A prev (word (t - 1))).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let t5 := t4.stage5 A (t3.greenRemovedNodes A)
  rcases hgreenRemoved with ⟨old, holdGreen, holdNameLt⟩
  have hremoved : t3.RemovedByGreen A old :=
    (mem_greenRemovedNodes A t3).mp holdGreen
  rcases prev.2 with
    ⟨hrootActive, _hrootName, hrootParent, hparentInvariant, _hinactiveLabel,
      _hbound, hinjective, _hconsecutive, _hproper, hchildSubset,
      _hsiblingDisjoint⟩
  obtain ⟨hwfRoot, hwfParent, _hwfChild, _hwfSibling⟩ :=
    stage1_stage2_stage3_invariants A prev.1 (word (t - 1)) plan
      hrootActive hrootParent hparentInvariant hchildSubset hinjective
  rcases
      removedByGreen_exists_green_name_lt A t3 hwfRoot hwfParent hremoved with
    ⟨green, hgreen, hgreenLtOld⟩
  have ht5NameOld : (t5.name old).val = (t3.name old).val := by
    simp [t4, t5, stage5_name A t4 (t3.greenRemovedNodes A) old,
      stage4_name A t3 old]
  have holdNameLtT3 : (t3.name old).val < m := by
    rwa [← ht5NameOld]
  exact ⟨old, green, holdGreen, hgreen,
    lt_trans hgreenLtOld holdNameLtT3⟩

