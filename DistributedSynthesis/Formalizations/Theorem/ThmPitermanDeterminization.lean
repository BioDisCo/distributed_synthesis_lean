/--
Zero breakpoint measure at the lower source is the corresponding source-green
payload in the same stage-(3) tree.
-/
theorem settledLowerSourceStage3ChildUnionZeroEvent_to_sourceGreen
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionZeroEvent A run sourceNode sourceName
        sourceState target k) :
    SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
        sourceState target k ∧
      ∃ live : LiveState A,
        (automaton A).run word k = some live ∧
          sourceNode ∈ (((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A := by
  rcases hevent with ⟨hchildUnionEvent, liveZero, hrunZero, hzeroRaw⟩
  rcases hchildUnionEvent with ⟨hbase, _liveCU, _hrunCU, _hchildUnion⟩
  rcases hbase with
    ⟨live, _next, hrun, _hrunNext, _htarget, _haccepting, hsourceActive,
      _hsourceState, _hsegment, _hsourceName⟩
  have hliveZeroEq : liveZero = live := by
    have hsome : some liveZero = some live := by
      rw [← hrunZero, hrun]
    exact Option.some.inj hsome
  subst liveZero
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hsourceActiveT1 : t1.active sourceNode = true := by
    simpa [t1, stage1_active A live.1 (word k) sourceNode] using
      hsourceActive
  have hsourceActiveT2 : t2.active sourceNode = true := by
    simpa [t1, plan, t2] using
      stage2_preserves_active_node_active A t1 plan hsourceActiveT1
  have hsourceActiveT3 : t3.active sourceNode = true := by
    simpa [t2, t3, stage3_active A t2 sourceNode] using hsourceActiveT2
  rcases live.2 with
    ⟨hrootActive, _hrootName, hrootParent, hparentInvariant, _hinactiveLabel,
      _hbound, hinjective, _hconsecutive, _hproper, hchildSubset,
      _hsiblingDisjoint⟩
  obtain ⟨_hwfRoot, _hwfParent, hwfChild, _hwfSibling⟩ :=
    stage1_stage2_stage3_invariants A live.1 (word k) plan
      hrootActive hrootParent hparentInvariant hchildSubset hinjective
  have hsub : t3.childLabelUnion A sourceNode ⊆ t3.label sourceNode :=
    childLabelUnion_subset_label A t3 hwfChild sourceNode
  have hgreen :
      sourceNode ∈ t3.greenNodes A :=
    (green_iff_uncoveredCount_zero A t3 hsourceActiveT3 hsub).mpr
      (by simpa [t1, plan, t2, t3] using hzeroRaw)
  exact ⟨
    ⟨⟨live, _next, hrun, _hrunNext, _htarget, _haccepting, hsourceActive,
      _hsourceState, _hsegment, _hsourceName⟩, _liveCU, _hrunCU, _hchildUnion⟩,
    live, hrun, by simpa [t1, plan, t2, t3] using hgreen⟩

/--
Conversely, a source-green payload at a lower-source child-union event is exactly
a zero breakpoint-measure event for that source in the same stage-(3) tree.
This lets source-persistence forks feed the existing zero-handler interface.
-/
theorem settledLowerSourceStage3ChildUnionEvent_sourceGreen_to_zeroEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
        sourceState target k)
    (hgreenPayload :
      ∃ live : LiveState A,
        (automaton A).run word k = some live ∧
          sourceNode ∈ (((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A) :
    SettledLowerSourceStage3ChildUnionZeroEvent A run sourceNode sourceName
      sourceState target k := by
  rcases hevent with ⟨hbase, liveCU, hrunCU, hchildUnion⟩
  rcases hbase with
    ⟨live, next, hrun, hrunNext, htarget, haccepting, hsourceActive,
      hsourceState, hsegment, hsourceName⟩
  have hliveCUEq : liveCU = live := by
    have hsome : some liveCU = some live := by
      rw [← hrunCU, hrun]
    exact Option.some.inj hsome
  subst liveCU
  rcases hgreenPayload with ⟨liveGreen, hrunGreen, hgreenRaw⟩
  have hliveGreenEq : liveGreen = live := by
    have hsome : some liveGreen = some live := by
      rw [← hrunGreen, hrun]
    exact Option.some.inj hsome
  subst liveGreen
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hgreen : sourceNode ∈ t3.greenNodes A := by
    simpa [t1, plan, t2, t3] using hgreenRaw
  have hsourceActiveT3 : t3.active sourceNode = true :=
    (mem_greenNodes A t3).mp hgreen |>.1
  rcases live.2 with
    ⟨hrootActive, _hrootName, hrootParent, hparentInvariant, _hinactiveLabel,
      _hbound, hinjective, _hconsecutive, _hproper, hchildSubset,
      _hsiblingDisjoint⟩
  obtain ⟨_hwfRoot, _hwfParent, hwfChild, _hwfSibling⟩ :=
    stage1_stage2_stage3_invariants A live.1 (word k) plan
      hrootActive hrootParent hparentInvariant hchildSubset hinjective
  have hsub : t3.childLabelUnion A sourceNode ⊆ t3.label sourceNode :=
    childLabelUnion_subset_label A t3 hwfChild sourceNode
  have hzero : t3.uncoveredCount A sourceNode = 0 :=
    (green_iff_uncoveredCount_zero A t3 hsourceActiveT3 hsub).mp hgreen
  exact
    ⟨⟨⟨live, next, hrun, hrunNext, htarget, haccepting, hsourceActive,
      hsourceState, hsegment, hsourceName⟩, live, hrun, hchildUnion⟩,
      live, hrun, by simpa [t1, plan, t2, t3] using hzero⟩

/--
Cofinal source-green child-union events are exactly the zero-event package
expected by the breakpoint-zero handler.
-/
theorem frequently_settledLowerSourceStage3ChildUnion_sourceGreen_to_zero
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
          sourceState target k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            sourceNode ∈ (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A) :
    ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionZeroEvent A run sourceNode sourceName
        sourceState target k := by
  intro n
  rcases hfreq n with ⟨k, hnk, hevent, hgreenPayload⟩
  exact ⟨k, hnk,
    settledLowerSourceStage3ChildUnionEvent_sourceGreen_to_zeroEvent
      A run hevent hgreenPayload⟩

/--
Fixed lower-source event whose fresh child is blocked at stage (3).
-/
def SettledLowerSourceStage3BlockedEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode : Node A)
    (sourceName : Nat) (sourceState target : A.State) (k : Nat) : Prop :=
  SettledLowerSourceNodeNameStateTargetEvent A run sourceNode sourceName
    sourceState target k ∧
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        let t1 := live.1.stage1 A (word k)
        let plan := (livePlan A live (word k)).stage2Plan
        let t2 := t1.stage2 A plan
        t2.BlockedByOlderSibling A (plan.freshChild sourceNode) target

/--
Package the checked stage-(3) local split into the two named fixed lower-source
stage-(3) branch events.
-/
theorem settledLowerSourceNodeNameStateTargetEvent_to_stage3_branch
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceNodeNameStateTargetEvent A run sourceNode sourceName
        sourceState target k) :
    SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
        sourceState target k ∨
      SettledLowerSourceStage3BlockedEvent A run sourceNode sourceName
        sourceState target k := by
  rcases
      settledLowerSourceNodeNameStateTargetEvent_stage3_childLabelUnion_or_blocked
        A run hevent with
    ⟨live, _next, hrun, _hrunNext, _hsourceName, hcase⟩
  rcases hcase with hchildUnion | hblocked
  · exact Or.inl ⟨hevent, live, hrun, hchildUnion⟩
  · exact Or.inr ⟨hevent, live, hrun, hblocked⟩

/--
Cofinal stage-(3) split for the fixed lower-source/source-state/target branch:
one of the two stage-(3) outcomes occurs arbitrarily late.
-/
theorem frequently_settledLowerSource_stage3_childUnion_or_blocked
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNodeNameStateTargetEvent A run sourceNode
          sourceName sourceState target k) :
    (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
        sourceState target k) ∨
      (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3BlockedEvent A run sourceNode sourceName
          sourceState target k) := by
  let P : Nat -> Prop := fun k =>
    SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
      sourceState target k
  let Q : Nat -> Prop := fun k =>
    SettledLowerSourceStage3BlockedEvent A run sourceNode sourceName
      sourceState target k
  have hfreqPQ : ∀ n : Nat, ∃ k : Nat, n ≤ k ∧ (P k ∨ Q k) := by
    intro n
    rcases hfreq n with ⟨k, hnk, hevent⟩
    exact ⟨k, hnk,
      settledLowerSourceNodeNameStateTargetEvent_to_stage3_branch
        A run hevent⟩
  rcases frequently_left_or_right_of_frequently_or hfreqPQ with hP | hQ
  · exact Or.inl hP
  · exact Or.inr hQ

/--
Structural split for the blocked half of the fixed lower-source branch.  If the
fresh child below the fixed lower source is blocked at stage (3), then the fixed
target is either already in an older stage-(2) child of the same lower source, or
the blocker is carried by a node whose stage-(2) name is strictly below the fixed
lower source name.  This is the lower-source analogue of the finite sideways
move in Piterman proof 4.
-/
theorem settledLowerSourceStage3BlockedEvent_older_child_or_lower_source
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3BlockedEvent A run sourceNode sourceName
        sourceState target k) :
    ∃ live next,
      (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        (live.1.name sourceNode).val = sourceName ∧
        let t1 := live.1.stage1 A (word k)
        let plan := (livePlan A live (word k)).stage2Plan
        let t2 := t1.stage2 A plan
        ((∃ older,
            older ∈ t2.children A sourceNode ∧
              target ∈ t2.label older ∧
              (t2.name older).val < (t2.name (plan.freshChild sourceNode)).val) ∨
          (∃ lower,
            t2.active lower = true ∧
              target ∈ t2.label lower ∧
              (t2.name lower).val < sourceName)) := by
  rcases hevent with ⟨hbase, liveBlocked, hrunBlocked, hblockedRaw⟩
  have hstep :=
    settledLowerSourceNodeNameStateTargetEvent_step A run hbase
  rcases hbase with
    ⟨live, next, hrun, hrunNext, _htarget, haccepting, hsourceActive,
      hsourceState, _hsegment, hsourceName⟩
  have hliveBlocked : liveBlocked = live := by
    have hsome : some liveBlocked = some live := by
      rw [← hrunBlocked, hrun]
    exact Option.some.inj hsome
  subst liveBlocked
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  have htargetStage1 : target ∈ t1.label sourceNode :=
    (mem_stage1_label A live.1 (word k)).mpr
      ⟨sourceState, hsourceState, hstep⟩
  have hsourceActiveT1 : t1.active sourceNode = true := by
    simpa [t1, stage1_active A live.1 (word k) sourceNode] using
      hsourceActive
  have htrigger : sourceNode ∈ t1.stage2Triggers A :=
    mem_stage2Triggers_of_accepting_label A t1 hsourceActiveT1
      htargetStage1 haccepting
  have hrootActiveT1 : t1.active (root A) = true := by
    simpa [t1, stage1_active A live.1 (word k) (root A)] using live.2.1
  have hfreshChild :
      plan.freshChild sourceNode ∈ t2.children A sourceNode := by
    simpa [t1, plan, t2] using
      stage2_freshChild_mem_children A t1 plan hrootActiveT1 htrigger
  have hsourceNameT2 : (t2.name sourceNode).val = sourceName := by
    have ht2Name :
        t2.name sourceNode = t1.name sourceNode :=
      stage2_preserves_active_node_name A t1 plan hsourceActiveT1
    have ht1Name :
        t1.name sourceNode = live.1.name sourceNode :=
      stage1_name A live.1 (word k) sourceNode
    rw [ht2Name, ht1Name]
    exact hsourceName
  rcases
      run_path_succ_stage2_child_blocked_same_parent_or_lower_name
        A (word := word) (k := k) (live := live)
        (v := sourceNode) (child := plan.freshChild sourceNode)
        (state := target)
        (by simpa [t1, plan, t2] using hfreshChild)
        (by simpa [t1, plan, t2] using hblockedRaw) with
    holder | hlower
  · refine ⟨live, next, hrun, hrunNext, hsourceName, Or.inl ?_⟩
    rcases holder with ⟨older, holderChild, holderMem, holderLt⟩
    exact ⟨older,
      by simpa [t1, plan, t2] using holderChild,
      by simpa [t1, plan, t2] using holderMem,
      by simpa [t1, plan, t2] using holderLt⟩
  · refine ⟨live, next, hrun, hrunNext, hsourceName, Or.inr ?_⟩
    rcases hlower with ⟨lower, hlowerActive, hlowerMem, hlowerLt⟩
    have hlowerLtSourceName : (t2.name lower).val < sourceName := by
      have hlowerLt' : (t2.name lower).val < (t2.name sourceNode).val := by
        simpa [t1, plan, t2] using hlowerLt
      omega
    exact ⟨lower,
      by simpa [t1, plan, t2] using hlowerActive,
      by simpa [t1, plan, t2] using hlowerMem,
      hlowerLtSourceName⟩

/--
Finite stage-(2) child iteration below a fixed lower source.  Starting from any
stage-(2) child of `sourceNode` that contains `target`, repeated stage-(3)
blocking can only move to older children with strictly smaller stage-(2) names.
Therefore the target either reaches the stage-(3) child-label union of
`sourceNode`, or the blocker is already carried by a node whose name is strictly
below the fixed source name.
-/
theorem live_stage2_child_stage3_childLabelUnion_or_lower_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {k : Nat} {live : LiveState A}
    {sourceNode child : Node A} {sourceName : Nat} {target : A.State}
    (hsourceActive : live.1.active sourceNode = true)
    (hsourceName : (live.1.name sourceNode).val = sourceName)
    (hchild :
      child ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).children A sourceNode)
    (hmem :
      target ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).label child) :
    let t1 := live.1.stage1 A (word k)
    let plan := (livePlan A live (word k)).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    target ∈ t3.childLabelUnion A sourceNode ∨
      ∃ lower,
        t2.active lower = true ∧
          target ∈ t2.label lower ∧
          (t2.name lower).val < sourceName := by
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hsourceActiveT1 : t1.active sourceNode = true := by
    simpa [t1, stage1_active A live.1 (word k) sourceNode] using
      hsourceActive
  have hsourceNameT2 : (t2.name sourceNode).val = sourceName := by
    have ht2Name :
        t2.name sourceNode = t1.name sourceNode :=
      stage2_preserves_active_node_name A t1 plan hsourceActiveT1
    have ht1Name :
        t1.name sourceNode = live.1.name sourceNode :=
      stage1_name A live.1 (word k) sourceNode
    rw [ht2Name, ht1Name]
    exact hsourceName
  let P : Nat -> Prop := fun n =>
    ∀ child : Node A,
      (t2.name child).val = n ->
        child ∈ t2.children A sourceNode ->
          target ∈ t2.label child ->
            target ∈ t3.childLabelUnion A sourceNode ∨
              ∃ lower,
                t2.active lower = true ∧
                  target ∈ t2.label lower ∧
                  (t2.name lower).val < sourceName
  have hmain : ∀ n, P n := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
        intro c hcName hcChild hcMem
        by_cases hblocked : t2.BlockedByOlderSibling A c target
        · rcases
            run_path_succ_stage2_child_blocked_same_parent_or_lower_name
              A (word := word) (k := k) (live := live)
              (v := sourceNode) (child := c) (state := target)
              (by simpa [t1, plan, t2] using hcChild)
              (by simpa [t1, plan, t2] using hblocked) with
            holder | hlower
          · rcases holder with ⟨older, holderChild, holderMem, holderLt⟩
            have holderLtN : (t2.name older).val < n := by
              have holderLt' : (t2.name older).val < (t2.name c).val := by
                simpa [t1, plan, t2] using holderLt
              omega
            exact ih (t2.name older).val holderLtN older rfl
              (by simpa [t1, plan, t2] using holderChild)
              (by simpa [t1, plan, t2] using holderMem)
          · rcases hlower with ⟨lower, hlowerActive, hlowerMem, hlowerLt⟩
            have hlowerLtSourceName :
                (t2.name lower).val < sourceName := by
              have hlowerLt' :
                  (t2.name lower).val < (t2.name sourceNode).val := by
                simpa [t1, plan, t2] using hlowerLt
              omega
            exact Or.inr ⟨lower,
              by simpa [t1, plan, t2] using hlowerActive,
              by simpa [t1, plan, t2] using hlowerMem,
              hlowerLtSourceName⟩
        · have hmem3 : target ∈ t3.label c :=
            (mem_stage3_label A t2).mpr ⟨hcMem, hblocked⟩
          have hchild3 : c ∈ t3.children A sourceNode := by
            simpa [t3, stage3_children A t2 sourceNode] using hcChild
          exact Or.inl (by
            rw [childLabelUnion, Finset.mem_biUnion]
            exact ⟨c, hchild3, hmem3⟩)
  have hresult := hmain (t2.name child).val child rfl
    (by simpa [t1, plan, t2] using hchild)
    (by simpa [t1, plan, t2] using hmem)
  simpa [t1, plan, t2, t3] using hresult

/--
Fixed lower-source event whose target is routed, after finite stage-(2)
older-child iteration, to a node whose stage-(2) name is strictly below the fixed
lower source name.
-/
def SettledLowerSourceStage2LowerNameEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode : Node A)
    (sourceName : Nat) (sourceState target : A.State) (k : Nat) : Prop :=
  SettledLowerSourceNodeNameStateTargetEvent A run sourceNode sourceName
    sourceState target k ∧
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        let t1 := live.1.stage1 A (word k)
        let plan := (livePlan A live (word k)).stage2Plan
        let t2 := t1.stage2 A plan
        ∃ lower,
          t2.active lower = true ∧
            target ∈ t2.label lower ∧
            (t2.name lower).val < sourceName

/--
The blocked lower-source branch, after finite older-child iteration, either
becomes stage-(3) child-union coverage of the fixed lower source or exposes a
stage-(2) source whose name is strictly below the fixed lower source name.
-/
theorem settledLowerSourceStage3BlockedEvent_stage3_childUnion_or_lower_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3BlockedEvent A run sourceNode sourceName
        sourceState target k) :
    SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
        sourceState target k ∨
      SettledLowerSourceStage2LowerNameEvent A run sourceNode sourceName
        sourceState target k := by
  rcases hevent with ⟨hbase, _liveBlocked, _hrunBlocked, _hblockedRaw⟩
  have hstep :=
    settledLowerSourceNodeNameStateTargetEvent_step A run hbase
  rcases hbase with
    ⟨live, next, hrun, _hrunNext, _htarget, haccepting, hsourceActive,
      hsourceState, _hsegment, hsourceName⟩
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  have htargetStage1 : target ∈ t1.label sourceNode :=
    (mem_stage1_label A live.1 (word k)).mpr
      ⟨sourceState, hsourceState, hstep⟩
  have hsourceActiveT1 : t1.active sourceNode = true := by
    simpa [t1, stage1_active A live.1 (word k) sourceNode] using
      hsourceActive
  have htrigger : sourceNode ∈ t1.stage2Triggers A :=
    mem_stage2Triggers_of_accepting_label A t1 hsourceActiveT1
      htargetStage1 haccepting
  have hrootActiveT1 : t1.active (root A) = true := by
    simpa [t1, stage1_active A live.1 (word k) (root A)] using live.2.1
  have hfreshChild :
      plan.freshChild sourceNode ∈ t2.children A sourceNode := by
    simpa [t1, plan, t2] using
      stage2_freshChild_mem_children A t1 plan hrootActiveT1 htrigger
  have htargetFresh :
      target ∈ t2.label (plan.freshChild sourceNode) := by
    exact (mem_stage2_freshChild_label A t1 plan htrigger).mpr
      ⟨htargetStage1, haccepting⟩
  have hbase' :
      SettledLowerSourceNodeNameStateTargetEvent A run sourceNode sourceName
        sourceState target k :=
    ⟨live, next, hrun, _hrunNext, _htarget, haccepting, hsourceActive,
      hsourceState, _hsegment, hsourceName⟩
  rcases
      live_stage2_child_stage3_childLabelUnion_or_lower_name
        A (word := word) (k := k) (live := live)
        (sourceNode := sourceNode) (child := plan.freshChild sourceNode)
        (sourceName := sourceName) (target := target)
        hsourceActive hsourceName
        (by simpa [t1, plan, t2] using hfreshChild)
        (by simpa [t1, plan, t2] using htargetFresh) with
    hchildUnion | hlower
  · exact Or.inl ⟨hbase', live, hrun,
      by simpa [t1, plan, t2] using hchildUnion⟩
  · exact Or.inr ⟨hbase', live, hrun,
      by simpa [t1, plan, t2] using hlower⟩

/--
Cofinal split for recurrent blocked lower-source events after finite
older-child iteration.
-/
theorem frequently_settledLowerSourceStage3Blocked_childUnion_or_lower_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3BlockedEvent A run sourceNode sourceName
          sourceState target k) :
    (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
        sourceState target k) ∨
      (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage2LowerNameEvent A run sourceNode sourceName
          sourceState target k) := by
  let P : Nat -> Prop := fun k =>
    SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
      sourceState target k
  let Q : Nat -> Prop := fun k =>
    SettledLowerSourceStage2LowerNameEvent A run sourceNode sourceName
      sourceState target k
  have hfreqPQ : ∀ n : Nat, ∃ k : Nat, n ≤ k ∧ (P k ∨ Q k) := by
    intro n
    rcases hfreq n with ⟨k, hnk, hevent⟩
    exact ⟨k, hnk,
      settledLowerSourceStage3BlockedEvent_stage3_childUnion_or_lower_name
        A run hevent⟩
  rcases frequently_left_or_right_of_frequently_or hfreqPQ with hP | hQ
  · exact Or.inl hP
  · exact Or.inr hQ

/--
Convert the stage-(2) smaller-name payload back to the existing lower-source
event interface.  The stage-(2) label state has a one-step source in the previous
live tree whose dynamic name is no larger, hence strictly below the fixed lower
source name.
-/
theorem settledLowerSourceStage2LowerNameEvent_to_lowerSourceNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage2LowerNameEvent A run sourceNode sourceName
        sourceState target k) :
    ∃ smallerName,
      smallerName ∈ Finset.range sourceName ∧
        SettledLowerSourceNameEvent A run smallerName k := by
  rcases hevent with ⟨hbase, liveLower, hrunLower, hlowerPayload⟩
  rcases hbase with
    ⟨live, next, hrun, hrunNext, htarget, haccepting, _hsourceActive,
      _hsourceState, _hsegment, _hsourceName⟩
  have hliveLower : liveLower = live := by
    have hsome : some liveLower = some live := by
      rw [← hrunLower, hrun]
    exact Option.some.inj hsome
  subst liveLower
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  rcases hlowerPayload with
    ⟨lower, hlowerActive, hlowerMem, hlowerLt⟩
  rcases
      stage1_stage2_active_label_segment_from_source_name_le
        A live.1 word plan
        (by simpa [t1, plan, t2] using hlowerActive)
        (by simpa [t1, plan, t2] using hlowerMem) with
    ⟨smallerNode, smallerState, hsmallerActive, hsmallerMem, hsegment,
      hsmallerNameLe⟩
  let smallerName := (live.1.name smallerNode).val
  have hsmallerLt : smallerName < sourceName := by
    have hsmallerNameLe' :
        (live.1.name smallerNode).val ≤ (t2.name lower).val := by
      simpa [t1, plan, t2] using hsmallerNameLe
    have hlowerLt' : (t2.name lower).val < sourceName := by
      simpa [t1, plan, t2] using hlowerLt
    omega
  have hsmallerMemRange : smallerName ∈ Finset.range sourceName := by
    rw [Finset.mem_range]
    exact hsmallerLt
  refine ⟨smallerName, hsmallerMemRange, ?_⟩
  exact ⟨live, next, smallerNode, smallerState, hrun, hrunNext,
    by simpa [htarget] using haccepting,
    hsmallerActive, hsmallerMem,
    by
      have hsegmentAccepting :
          SegmentVisitsAccepting A word k 1 smallerState target :=
        segmentVisitsAccepting_of_segment_accepting_target A word hsegment
          haccepting
      simpa [htarget] using hsegmentAccepting,
    rfl⟩

/--
Cofinal form of `settledLowerSourceStage2LowerNameEvent_to_lowerSourceNameEvent`.
-/
theorem frequently_settledLowerSourceStage2LowerName_to_lowerSourceNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage2LowerNameEvent A run sourceNode sourceName
          sourceState target k) :
    ∃ smallerName,
      smallerName ∈ Finset.range sourceName ∧
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceNameEvent A run smallerName k := by
  classical
  have hfreqFilter :
      ∃ᶠ k in Filter.atTop,
        ∃ smallerName ∈ Finset.range sourceName,
          SettledLowerSourceNameEvent A run smallerName k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with ⟨k, hnk, hevent⟩
    rcases
        settledLowerSourceStage2LowerNameEvent_to_lowerSourceNameEvent
          A run hevent with
      ⟨smallerName, hsmallerNameMem, hsmallerEvent⟩
    exact ⟨k, hnk, smallerName, hsmallerNameMem, hsmallerEvent⟩
  rw [Finset.frequently_exists] at hfreqFilter
  rcases hfreqFilter with
    ⟨smallerName, hsmallerNameMem, hsmallerFreq⟩
  exact ⟨smallerName, hsmallerNameMem,
    fun n => (Filter.frequently_atTop).1 hsmallerFreq n⟩

/--
Combined fixed lower-source fork after finite older-child iteration.  A recurrent
fixed lower-source/source-state/target branch either gives recurrent stage-(3)
child-union coverage below that fixed lower source, or it produces recurrent
lower-source events at a strictly smaller source name.
-/
theorem frequently_settledLowerSource_childUnion_or_smallerLowerSourceName
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNodeNameStateTargetEvent A run sourceNode
          sourceName sourceState target k) :
    (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
        sourceState target k) ∨
      (∃ smallerName,
        smallerName ∈ Finset.range sourceName ∧
          ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
            SettledLowerSourceNameEvent A run smallerName k) := by
  rcases
      frequently_settledLowerSource_stage3_childUnion_or_blocked
        A run hfreq with
    hchildUnion | hblocked
  · exact Or.inl hchildUnion
  · rcases
      frequently_settledLowerSourceStage3Blocked_childUnion_or_lower_name
        A run hblocked with
      hchildUnion | hlower
    · exact Or.inl hchildUnion
    · exact Or.inr
        (frequently_settledLowerSourceStage2LowerName_to_lowerSourceNameEvent
          A run hlower)

/--
Well-founded descent on the lower-source name.  Strong induction on the fixed
source name: a recurrent fixed lower-source event either reaches recurrent
stage-(3) child-union coverage at the current source, or descends to a strictly
smaller source name and recurses.  Since names are bounded below by `0`, the
descent terminates in the child-union branch.  This is the Lean counterpart of
the "finitely many sideways moves" step in Piterman proof 4: the source name
cannot strictly decrease forever, so the recurrent lower-source events must
eventually settle into stage-(3) child-union coverage at a fixed source node.
-/
theorem exists_frequently_settledLowerSourceStage3ChildUnion_of_nameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) :
    ∀ sourceName : Nat,
      (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNameEvent A run sourceName k) ->
      ∃ (sn : Nat) (sourceNode : Node A) (sourceState target : A.State),
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceStage3ChildUnionEvent A run sourceNode sn
            sourceState target k := by
  intro sourceName
  induction sourceName using Nat.strong_induction_on with
  | h sourceName ih =>
      intro hfreq
      rcases exists_frequently_settledLowerSourceNodeNameEvent_of_nameEvent
          A run hfreq with
        ⟨sourceNode, hfreqNode⟩
      rcases
          exists_frequently_settledLowerSourceNodeNameStateTargetEvent_of_nodeNameBranch
            A run hfreqNode with
        ⟨sourceState, target, _haccepting, hfreqTarget⟩
      rcases
          frequently_settledLowerSource_childUnion_or_smallerLowerSourceName
            A run hfreqTarget with
        hchildUnion | hsmaller
      · exact ⟨sourceName, sourceNode, sourceState, target, hchildUnion⟩
      · rcases hsmaller with ⟨smallerName, hmem, hfreqSmaller⟩
        exact ih smallerName (Finset.mem_range.mp hmem) hfreqSmaller

/--
Bounded form of
`exists_frequently_settledLowerSourceStage3ChildUnion_of_nameEvent`: if the
starting recurrent lower-source name is below the settled name `a`, then the
child-union name reached after the finite smaller-name recursion is still below
`a`.  This is the form needed by the child-union kernel, whose geometry requires
`sourceName < a`.
-/
theorem exists_frequently_settledLowerSourceStage3ChildUnion_of_bounded_nameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) :
    ∀ sourceName : Nat,
      ∀ {a : Nat},
        sourceName ∈ Finset.range a ->
        (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceNameEvent A run sourceName k) ->
        ∃ (sn : Nat) (sourceNode : Node A) (sourceState target : A.State),
          sn ∈ Finset.range a ∧
            ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
              SettledLowerSourceStage3ChildUnionEvent A run sourceNode sn
                sourceState target k := by
  intro sourceName
  induction sourceName using Nat.strong_induction_on with
  | h sourceName ih =>
      intro a hsourceNameMem hfreq
      rcases exists_frequently_settledLowerSourceNodeNameEvent_of_nameEvent
          A run hfreq with
        ⟨sourceNode, hfreqNode⟩
      rcases
          exists_frequently_settledLowerSourceNodeNameStateTargetEvent_of_nodeNameBranch
            A run hfreqNode with
        ⟨sourceState, target, _haccepting, hfreqTarget⟩
      rcases
          frequently_settledLowerSource_childUnion_or_smallerLowerSourceName
            A run hfreqTarget with
        hchildUnion | hsmaller
      · exact ⟨sourceName, sourceNode, sourceState, target, hsourceNameMem,
          hchildUnion⟩
      · rcases hsmaller with ⟨smallerName, hsmallerMem, hfreqSmaller⟩
        have hsmallerMemA : smallerName ∈ Finset.range a := by
          rw [Finset.mem_range]
          have hsmallerLtSource : smallerName < sourceName :=
            Finset.mem_range.mp hsmallerMem
          have hsourceLtA : sourceName < a :=
            Finset.mem_range.mp hsourceNameMem
          omega
        exact ih smallerName (Finset.mem_range.mp hsmallerMem) hsmallerMemA
          hfreqSmaller

/--
Child-union coverage at the *minimal* recurring lower-source name.  Take the least
name `m` whose lower-source events recur (`Nat.find`); at `m` the finite
sideways-move fork cannot take the "strictly smaller source name" branch, since
that would contradict minimality, so it lands in recurrent stage-(3) child-union
coverage at a fixed source node of name `m`.  The minimality field
(`∀ j < m, ¬ recurrent`) is the **no-leakage** hypothesis the breakpoint argument
needs: below `m`, lower-source events occur only finitely often.
-/
theorem exists_frequently_settledLowerSourceStage3ChildUnion_at_minName
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (hexists :
      ∃ sourceName : Nat, ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNameEvent A run sourceName k) :
    ∃ (m : Nat) (sourceNode : Node A) (sourceState target : A.State),
      (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionEvent A run sourceNode m
          sourceState target k) ∧
      ∀ j : Nat, j < m ->
        ¬ (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
            SettledLowerSourceNameEvent A run j k) := by
  classical
  let m : Nat := Nat.find hexists
  have hspec : ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceNameEvent A run m k := Nat.find_spec hexists
  have hmin : ∀ j : Nat, j < m ->
      ¬ (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceNameEvent A run j k) :=
    fun j hj => Nat.find_min hexists hj
  rcases exists_frequently_settledLowerSourceNodeNameEvent_of_nameEvent
      A run hspec with
    ⟨sourceNode, hfreqNode⟩
  rcases
      exists_frequently_settledLowerSourceNodeNameStateTargetEvent_of_nodeNameBranch
        A run hfreqNode with
    ⟨sourceState, target, _haccepting, hfreqTarget⟩
  rcases
      frequently_settledLowerSource_childUnion_or_smallerLowerSourceName
        A run hfreqTarget with
    hchildUnion | hsmaller
  · exact ⟨m, sourceNode, sourceState, target, hchildUnion, hmin⟩
  · exfalso
    rcases hsmaller with ⟨smallerName, hmem, hfreqSmaller⟩
    exact hmin smallerName (Finset.mem_range.mp hmem) hfreqSmaller

/--
Bounded minimal lower-source child-union branch.  If some recurrent lower-source
name is below `a`, then the least recurrent lower-source name is also below `a`;
at that least name the finite smaller-name fork must land in child-union coverage.
-/
theorem exists_frequently_settledLowerSourceStage3ChildUnion_at_minName_bounded
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {a : Nat}
    (hexists :
      ∃ sourceName : Nat,
        sourceName ∈ Finset.range a ∧
          ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
            SettledLowerSourceNameEvent A run sourceName k) :
    ∃ (m : Nat) (sourceNode : Node A) (sourceState target : A.State),
      m ∈ Finset.range a ∧
        (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceStage3ChildUnionEvent A run sourceNode m
            sourceState target k) ∧
        ∀ j : Nat, j < m ->
          ¬ (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
              SettledLowerSourceNameEvent A run j k) := by
  classical
  let hexistsAll :
      ∃ sourceName : Nat, ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNameEvent A run sourceName k := by
    rcases hexists with ⟨sourceName, _hsourceNameMem, hfreq⟩
    exact ⟨sourceName, hfreq⟩
  let m : Nat := Nat.find hexistsAll
  have hspec : ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceNameEvent A run m k := Nat.find_spec hexistsAll
  have hmin : ∀ j : Nat, j < m ->
      ¬ (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceNameEvent A run j k) :=
    fun j hj => Nat.find_min hexistsAll hj
  have hmMem : m ∈ Finset.range a := by
    rw [Finset.mem_range]
    rcases hexists with ⟨sourceName, hsourceNameMem, hfreqSource⟩
    have hsourceLtA : sourceName < a := Finset.mem_range.mp hsourceNameMem
    by_contra hnot
    have hsourceLtM : sourceName < m := by omega
    exact hmin sourceName hsourceLtM hfreqSource
  rcases exists_frequently_settledLowerSourceNodeNameEvent_of_nameEvent
      A run hspec with
    ⟨sourceNode, hfreqNode⟩
  rcases
      exists_frequently_settledLowerSourceNodeNameStateTargetEvent_of_nodeNameBranch
        A run hfreqNode with
    ⟨sourceState, target, _haccepting, hfreqTarget⟩
  rcases
      frequently_settledLowerSource_childUnion_or_smallerLowerSourceName
        A run hfreqTarget with
    hchildUnion | hsmaller
  · exact ⟨m, sourceNode, sourceState, target, hmMem, hchildUnion, hmin⟩
  · exfalso
    rcases hsmaller with ⟨smallerName, hmem, hfreqSmaller⟩
    exact hmin smallerName (Finset.mem_range.mp hmem) hfreqSmaller

/--
Cut-sequence form of the fixed lower-source/source-state/target branch.  This is
the interface expected by the existing König/segment-chain lemmas: a strict
cofinal sequence whose positive cuts are all fixed lower-source target events.
-/
theorem exists_strict_cuts_settledLowerSourceNodeNameStateTargetEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNodeNameStateTargetEvent A run sourceNode
          sourceName sourceState target k) :
    ∃ cuts : Nat -> Nat,
      cuts 0 = 0 ∧
        (∀ i : Nat, cuts i < cuts (i + 1)) ∧
          ∀ i : Nat,
            SettledLowerSourceNodeNameStateTargetEvent A run sourceNode
              sourceName sourceState target (cuts (i + 1)) := by
  exact exists_strict_cuts_from_zero_of_frequently_at_or_after hfreq

/--
Finite-name pigeonhole for the lower-source branch: if lower-source events occur
arbitrarily late below a settled name `a`, then some fixed source name `< a`
occurs arbitrarily late.
-/
theorem exists_frequently_settledLowerSourceNameEvent_of_frequently_lower_source
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {a : Nat}
    (hlower :
      ∀ n : Nat, ∃ k live next sourceNode sourceState,
        n ≤ k ∧
          (automaton A).run word k = some live ∧
          (automaton A).run word (k + 1) = some next ∧
          A.accepting (run.path (k + 1)) ∧
          live.1.active sourceNode = true ∧
          sourceState ∈ live.1.label sourceNode ∧
          SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) ∧
          (live.1.name sourceNode).val < a) :
    ∃ sourceName,
      sourceName ∈ Finset.range a ∧
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceNameEvent A run sourceName k := by
  classical
  have hfreq :
      ∃ᶠ k in Filter.atTop,
        ∃ sourceName ∈ Finset.range a,
          SettledLowerSourceNameEvent A run sourceName k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hlower n with
      ⟨k, live, next, sourceNode, sourceState, hnk, hrun, hrunNext,
        haccepting, hsourceActive, hsourceState, hsegment, hsourceLt⟩
    let sourceName : Nat := (live.1.name sourceNode).val
    have hsourceNameMem : sourceName ∈ Finset.range a := by
      exact Finset.mem_range.mpr (by simpa [sourceName] using hsourceLt)
    exact ⟨k, hnk, sourceName, hsourceNameMem,
      live, next, sourceNode, sourceState, hrun, hrunNext, haccepting,
      hsourceActive, hsourceState, hsegment, rfl⟩
  rw [Finset.frequently_exists] at hfreq
  rcases hfreq with ⟨sourceName, hsourceNameMem, hsourceNameFreq⟩
  refine ⟨sourceName, hsourceNameMem, ?_⟩
  intro n
  exact (Filter.frequently_atTop).1 hsourceNameFreq n

/--
Finite cutoff extracted from minimality of the recurrent lower-source name.  If
no name below `m` occurs as a lower source cofinally, then after one global cutoff
no lower-source event with name `< m` occurs at all.
-/
theorem exists_eventually_no_smaller_settledLowerSourceNameEvent_of_noLeak
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {m : Nat}
    (hnoLeak :
      ∀ j : Nat, j < m ->
        ¬ (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceNameEvent A run j k)) :
    ∃ N : Nat, ∀ k j : Nat, N ≤ k -> j < m ->
      ¬ SettledLowerSourceNameEvent A run j k := by
  classical
  let lowerNames : Finset Nat := Finset.range m
  have hbound :
      ∀ j : Nat, j ∈ lowerNames ->
        ∃ N : Nat, ∀ k : Nat, N ≤ k ->
          ¬ SettledLowerSourceNameEvent A run j k := by
    intro j hj
    have hjlt : j < m := Finset.mem_range.mp hj
    have hnotFreq := hnoLeak j hjlt
    push Not at hnotFreq
    exact hnotFreq
  let boundOf : Nat -> Nat := fun j =>
    if hj : j ∈ lowerNames then
      Classical.choose (hbound j hj)
    else
      0
  refine ⟨lowerNames.sup boundOf, ?_⟩
  intro k j hNk hjlt hevent
  have hj : j ∈ lowerNames := Finset.mem_range.mpr hjlt
  have hboundLe : boundOf j ≤ lowerNames.sup boundOf :=
    Finset.le_sup hj
  have hboundOf :
      boundOf j = Classical.choose (hbound j hj) := by
    simp [boundOf, hj]
  have hchooseLe : Classical.choose (hbound j hj) ≤ k := by
    omega
  exact (Classical.choose_spec (hbound j hj)) k hchooseLe hevent

/--
The aligned surviving-child branch, in the form needed by the final
source-stability lemma: all smaller lower-source names disappear after a cutoff,
and the fixed lower source has cofinally many ordinary successor coverage events.
-/
theorem minLowerPositiveWitnessChildSurvives_branch_to_noSmaller_and_coverage
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {m : Nat} {sourceNode child : Node A}
    {sourceState target uncovered : A.State}
    (hnoLeak :
      ∀ j : Nat, j < m ->
        ¬ (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceNameEvent A run j k))
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent A
          run sourceNode child m sourceState target uncovered k) :
    ∃ N : Nat,
      (∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k) ∧
      ∀ n : Nat, ∃ k live next,
        n ≤ k ∧
          (automaton A).run word k = some live ∧
          (automaton A).run word (k + 1) = some next ∧
          A.accepting (run.path (k + 1)) ∧
          run.path (k + 1) ∈ next.1.childLabelUnion A sourceNode := by
  rcases
      exists_eventually_no_smaller_settledLowerSourceNameEvent_of_noLeak
        A run hnoLeak with
    ⟨N, hnoSmaller⟩
  exact ⟨N, hnoSmaller,
    frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvives_to_coverage_payload
      A run hfreq⟩

/--
Accepting one-step source persistence.  If an accepting successor remains in a
non-green source node `v`, then either it is covered by a child of `v` in the
successor live tree, or the step exposes a lower-source event whose name is
strictly below `v`'s current name.
-/
theorem run_path_succ_accepting_source_covered_or_lowerSourceNameEvent_of_not_green
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v : Node A} {m : Nat}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hactive : live.1.active v = true)
    (hname : (live.1.name v).val = m)
    (hmem : run.path k ∈ live.1.label v)
    (haccepting : A.accepting (run.path (k + 1)))
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v ∨
      ∃ j : Nat,
        j ∈ Finset.range m ∧
          SettledLowerSourceNameEvent A run j k := by
  classical
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hactiveStage1 : t1.active v = true := by
    simpa [t1, stage1_active A live.1 (word k) v] using hactive
  rcases
      run_path_succ_accepting_childLabelUnion_or_freshChild_blocked_of_not_green
        A run hrun hrunNext hactiveStage1 hmem haccepting hvNotGreen hsettle with
    hcovered | hblocked
  · exact Or.inl hcovered
  · let target := run.path (k + 1)
    let sourceState := run.path k
    have hsegment :
        SegmentVisitsAccepting A word k 1 sourceState target :=
      segmentVisitsAccepting_of_step_accepting_target A word
        (run.step_valid k) (by simpa [target] using haccepting)
    have hbase :
        SettledLowerSourceNodeNameStateTargetEvent A run v m sourceState target k :=
      ⟨live, next, hrun, hrunNext, by simp [target],
        by simpa [target] using haccepting, hactive,
        by simpa [sourceState] using hmem, hsegment, hname⟩
    have hblockedEvent :
        SettledLowerSourceStage3BlockedEvent A run v m sourceState target k :=
      ⟨hbase, live, hrun, by simpa [target, t1, plan, t2] using hblocked⟩
    rcases
        settledLowerSourceStage3BlockedEvent_stage3_childUnion_or_lower_name
          A run hblockedEvent with
      hchildUnion | hlower
    · rcases hchildUnion with ⟨_hbaseCU, liveCU, hrunCU, hchildUnionRaw⟩
      have hliveCU : liveCU = live := by
        have hsome : some liveCU = some live := by
          rw [← hrunCU, hrun]
        exact Option.some.inj hsome
      subst liveCU
      have hcover3 :
          run.path (k + 1) ∈ t3.childLabelUnion A v := by
        simpa [target, t1, plan, t2, t3] using hchildUnionRaw
      exact Or.inl
        (run_path_succ_stage3_childLabelUnion_persists_of_not_green
          A run hrun hrunNext
          (by simpa [t1, plan, t2, t3] using hvNotGreen)
          hsettle
          (by simpa [t1, plan, t2, t3] using hcover3))
    · rcases
        settledLowerSourceStage2LowerNameEvent_to_lowerSourceNameEvent
          A run hlower with
        ⟨j, hjMem, hjEvent⟩
      exact Or.inr ⟨j, hjMem, hjEvent⟩

/--
One-step source-persistence trichotomy.  For an accepting transition that starts
in a fixed source node `v` and whose target remains in `v`, either `v` is already
green in the stage-(3) tree, the target is covered by a child of `v` in the
successor live tree, or the step exposes a lower-source event at a strictly
smaller name.  This is the local form used by the breakpoint kernel before the
eventual no-smaller cutoff eliminates the last alternative.
-/
theorem run_path_succ_accepting_source_green_or_covered_or_lowerSourceNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v : Node A} {m : Nat}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hactive : live.1.active v = true)
    (hname : (live.1.name v).val = m)
    (hmem : run.path k ∈ live.1.label v)
    (haccepting : A.accepting (run.path (k + 1)))
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    (∃ live' : LiveState A,
      (automaton A).run word k = some live' ∧
        v ∈ (((live'.1.stage1 A (word k)).stage2 A
          (livePlan A live' (word k)).stage2Plan).stage3 A).greenNodes A) ∨
      run.path (k + 1) ∈ next.1.childLabelUnion A v ∨
        ∃ j : Nat,
          j ∈ Finset.range m ∧
            SettledLowerSourceNameEvent A run j k := by
  by_cases hgreen :
      v ∈ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A
  · exact Or.inl ⟨live, hrun, hgreen⟩
  · rcases
      run_path_succ_accepting_source_covered_or_lowerSourceNameEvent_of_not_green
        A run hrun hrunNext hactive hname hmem haccepting hgreen hsettle with
    hcovered | hlower
    · exact Or.inr (Or.inl hcovered)
    · exact Or.inr (Or.inr hlower)

/--
Cutoff-specialized trichotomy.  Once all lower-source events below `m` have
disappeared, any accepting transition whose target remains in the fixed source
node either greens that source in stage (3), or keeps the accepting target
covered by one of its children in the successor live tree.
-/
theorem run_path_succ_accepting_source_green_or_covered_of_no_smaller_lowerSource
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k N : Nat} {live next : LiveState A}
    {v : Node A} {m : Nat}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ k)
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hactive : live.1.active v = true)
    (hname : (live.1.name v).val = m)
    (hmem : run.path k ∈ live.1.label v)
    (haccepting : A.accepting (run.path (k + 1)))
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    (∃ live' : LiveState A,
      (automaton A).run word k = some live' ∧
        v ∈ (((live'.1.stage1 A (word k)).stage2 A
          (livePlan A live' (word k)).stage2Plan).stage3 A).greenNodes A) ∨
      run.path (k + 1) ∈ next.1.childLabelUnion A v := by
  rcases
      run_path_succ_accepting_source_green_or_covered_or_lowerSourceNameEvent
        A run hrun hrunNext hactive hname hmem haccepting hsettle with
    hgreen | hcoveredOrLower
  · exact Or.inl hgreen
  · rcases hcoveredOrLower with hcovered | hlower
    · exact Or.inr hcovered
    · rcases hlower with ⟨j, hjMem, hjEvent⟩
      exact False.elim
        (hnoSmaller k j hNk (Finset.mem_range.mp hjMem) hjEvent)

/--
Cutoff-specialized accepting one-step source persistence.  Once all smaller
lower-source events below `m` have disappeared, the lower-source alternative in
`run_path_succ_accepting_source_covered_or_lowerSourceNameEvent_of_not_green`
is impossible, so an accepting successor that remains in the non-green source
node is covered by a child of that source in the successor live tree.
-/
theorem run_path_succ_accepting_source_covered_of_no_smaller_lowerSource
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k N : Nat} {live next : LiveState A}
    {v : Node A} {m : Nat}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ k)
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hactive : live.1.active v = true)
    (hname : (live.1.name v).val = m)
    (hmem : run.path k ∈ live.1.label v)
    (haccepting : A.accepting (run.path (k + 1)))
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v := by
  rcases
      run_path_succ_accepting_source_covered_or_lowerSourceNameEvent_of_not_green
        A run hrun hrunNext hactive hname hmem haccepting hvNotGreen hsettle with
    hcovered | hlower
  · exact hcovered
  · rcases hlower with ⟨j, hjMem, hjEvent⟩
    exact False.elim
      (hnoSmaller k j hNk (Finset.mem_range.mp hjMem) hjEvent)

/--
Event-based one-step source persistence, matching the lower-source branch.  A
fixed source-state/target event at source node `v` either already routes the
accepting target to child coverage of `v` in the successor live tree, or exposes
a lower-source event with name `< m`.  The premise `hsettle` is the geometric
condition that the target is still in `v`'s successor label.
-/
theorem settledLowerSourceNodeNameStateTargetEvent_source_covered_or_lowerSourceNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {m : Nat}
    {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceNodeNameStateTargetEvent A run v m sourceState target k)
    (hvNotGreen :
      ∃ live : LiveState A,
        (automaton A).run word k = some live ∧
          v ∉ (((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle :
      ∃ next : LiveState A,
        (automaton A).run word (k + 1) = some next ∧
          target ∈ next.1.label v) :
    (∃ next : LiveState A,
      (automaton A).run word (k + 1) = some next ∧
        target ∈ next.1.childLabelUnion A v) ∨
      ∃ j : Nat,
        j ∈ Finset.range m ∧
          SettledLowerSourceNameEvent A run j k := by
  classical
  rcases hevent with
    ⟨live, nextBase, hrun, hrunNextBase, htarget, _haccepting, _hactive,
      _hsourceState, _hsegment, _hname⟩
  rcases hvNotGreen with ⟨liveNG, hrunNG, hvNotGreenRaw⟩
  have hliveNG : liveNG = live := by
    have hsome : some liveNG = some live := by
      rw [← hrunNG, hrun]
    exact Option.some.inj hsome
  subst liveNG
  rcases hsettle with ⟨nextSettle, hrunNextSettle, htargetNext⟩
  have hnextSettle : nextSettle = nextBase := by
    have hsome : some nextSettle = some nextBase := by
      rw [← hrunNextSettle, hrunNextBase]
    exact Option.some.inj hsome
  subst nextSettle
  have heventCopy :
      SettledLowerSourceNodeNameStateTargetEvent A run v m sourceState target k :=
    ⟨live, nextBase, hrun, hrunNextBase, htarget, _haccepting, _hactive,
      _hsourceState, _hsegment, _hname⟩
  rcases
      settledLowerSourceNodeNameStateTargetEvent_to_stage3_branch
        A run heventCopy with
    hchildUnion | hblocked
  · rcases hchildUnion with ⟨_hbase, liveCU, hrunCU, hchildUnionRaw⟩
    have hliveCU : liveCU = live := by
      have hsome : some liveCU = some live := by
        rw [← hrunCU, hrun]
      exact Option.some.inj hsome
    subst liveCU
    let t1 := live.1.stage1 A (word k)
    let plan := (livePlan A live (word k)).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    have hcover3 :
        run.path (k + 1) ∈ t3.childLabelUnion A v := by
      rw [htarget]
      simpa [t1, plan, t2, t3] using hchildUnionRaw
    have hcoveredNext :
        run.path (k + 1) ∈ nextBase.1.childLabelUnion A v :=
      run_path_succ_stage3_childLabelUnion_persists_of_not_green
        A run hrun hrunNextBase
        (by simpa [t1, plan, t2, t3] using hvNotGreenRaw)
        (by rw [htarget]; exact htargetNext)
        (by simpa [t1, plan, t2, t3] using hcover3)
    exact Or.inl ⟨nextBase, hrunNextBase, by rwa [htarget] at hcoveredNext⟩
  · rcases
        settledLowerSourceStage3BlockedEvent_stage3_childUnion_or_lower_name
          A run hblocked with
      hchildUnion | hlower
    · rcases hchildUnion with ⟨_hbase, liveCU, hrunCU, hchildUnionRaw⟩
      have hliveCU : liveCU = live := by
        have hsome : some liveCU = some live := by
          rw [← hrunCU, hrun]
        exact Option.some.inj hsome
      subst liveCU
      let t1 := live.1.stage1 A (word k)
      let plan := (livePlan A live (word k)).stage2Plan
      let t2 := t1.stage2 A plan
      let t3 := t2.stage3 A
      have hcover3 :
          run.path (k + 1) ∈ t3.childLabelUnion A v := by
        rw [htarget]
        simpa [t1, plan, t2, t3] using hchildUnionRaw
      have hcoveredNext :
          run.path (k + 1) ∈ nextBase.1.childLabelUnion A v :=
        run_path_succ_stage3_childLabelUnion_persists_of_not_green
          A run hrun hrunNextBase
          (by simpa [t1, plan, t2, t3] using hvNotGreenRaw)
          (by rw [htarget]; exact htargetNext)
          (by simpa [t1, plan, t2, t3] using hcover3)
      exact Or.inl ⟨nextBase, hrunNextBase, by rwa [htarget] at hcoveredNext⟩
    · rcases
        settledLowerSourceStage2LowerNameEvent_to_lowerSourceNameEvent
          A run hlower with
        ⟨j, hjMem, hjEvent⟩
      exact Or.inr ⟨j, hjMem, hjEvent⟩

/--
Event-based source-persistence trichotomy.  A lower-source source/target event
whose accepting target remains in the source node either has that source green in
the event's stage-(3) tree, routes the target to successor child coverage of the
source, or exposes a strictly smaller lower-source event.
-/
theorem settledLowerSourceNodeNameStateTargetEvent_source_green_or_covered_or_lowerSourceNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {m : Nat}
    {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceNodeNameStateTargetEvent A run v m sourceState target k)
    (hsettle :
      ∃ next : LiveState A,
        (automaton A).run word (k + 1) = some next ∧
          target ∈ next.1.label v) :
    (∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        v ∈ (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A) ∨
      (∃ next : LiveState A,
        (automaton A).run word (k + 1) = some next ∧
          target ∈ next.1.childLabelUnion A v) ∨
        ∃ j : Nat,
          j ∈ Finset.range m ∧
            SettledLowerSourceNameEvent A run j k := by
  rcases hevent with
    ⟨live, nextBase, hrun, hrunNextBase, htarget, _haccepting, _hactive,
      _hsourceState, _hsegment, _hname⟩
  by_cases hgreen :
      v ∈ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A
  · exact Or.inl ⟨live, hrun, hgreen⟩
  · have heventCopy :
        SettledLowerSourceNodeNameStateTargetEvent A run v m sourceState target k :=
      ⟨live, nextBase, hrun, hrunNextBase, htarget, _haccepting, _hactive,
        _hsourceState, _hsegment, _hname⟩
    rcases
        settledLowerSourceNodeNameStateTargetEvent_source_covered_or_lowerSourceNameEvent
          A run heventCopy ⟨live, hrun, hgreen⟩ hsettle with
      hcovered | hlower
    · exact Or.inr (Or.inl hcovered)
    · exact Or.inr (Or.inr hlower)

/--
Cutoff-specialized event-based source-persistence trichotomy.  Once smaller
lower-source events below `m` have disappeared, a lower-source source/target
event whose target remains in the source node either greens the source or routes
the target to successor child coverage of that source.
-/
theorem settledLowerSourceNodeNameStateTargetEvent_source_green_or_covered_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {m N : Nat}
    {sourceState target : A.State} {k : Nat}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ k)
    (hevent :
      SettledLowerSourceNodeNameStateTargetEvent A run v m sourceState target k)
    (hsettle :
      ∃ next : LiveState A,
        (automaton A).run word (k + 1) = some next ∧
          target ∈ next.1.label v) :
    (∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        v ∈ (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A) ∨
      ∃ next : LiveState A,
        (automaton A).run word (k + 1) = some next ∧
          target ∈ next.1.childLabelUnion A v := by
  rcases
      settledLowerSourceNodeNameStateTargetEvent_source_green_or_covered_or_lowerSourceNameEvent
        A run hevent hsettle with
    hgreen | hcoveredOrLower
  · exact Or.inl hgreen
  · rcases hcoveredOrLower with hcovered | hlower
    · exact Or.inr hcovered
    · rcases hlower with ⟨j, hjMem, hjEvent⟩
      exact False.elim
        (hnoSmaller k j hNk (Finset.mem_range.mp hjMem) hjEvent)

/--
Child-union source-persistence fork in the exact form expected by the
breakpoint kernel.  After the no-smaller cutoff, if the accepting target still
lies in the fixed lower source at the successor time, then the local step either
zeros the source breakpoint measure or routes the target to successor
child-coverage of the same source.
-/
theorem settledLowerSourceStage3ChildUnionEvent_zero_or_successor_childCovered_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName N : Nat} {sourceState target : A.State} {k : Nat}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < sourceName ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ k)
    (hevent :
      SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
        sourceState target k)
    (hsettle :
      ∃ next : LiveState A,
        (automaton A).run word (k + 1) = some next ∧
          target ∈ next.1.label sourceNode) :
    SettledLowerSourceStage3ChildUnionZeroEvent A run sourceNode sourceName
        sourceState target k ∨
      ∃ next : LiveState A,
        (automaton A).run word (k + 1) = some next ∧
          target ∈ next.1.childLabelUnion A sourceNode := by
  rcases
      settledLowerSourceNodeNameStateTargetEvent_source_green_or_covered_of_no_smaller
        A run hnoSmaller hNk hevent.1 hsettle with
    hgreen | hcovered
  · exact Or.inl
      (settledLowerSourceStage3ChildUnionEvent_sourceGreen_to_zeroEvent
        A run hevent hgreen)
  · exact Or.inr hcovered

/--
Cutoff-specialized event-based source persistence.  Under the no-smaller
lower-source cutoff, the event-based fork cannot take the lower-source branch.
-/
theorem settledLowerSourceNodeNameStateTargetEvent_source_covered_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {m N : Nat}
    {sourceState target : A.State} {k : Nat}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ k)
    (hevent :
      SettledLowerSourceNodeNameStateTargetEvent A run v m sourceState target k)
    (hvNotGreen :
      ∃ live : LiveState A,
        (automaton A).run word k = some live ∧
          v ∉ (((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle :
      ∃ next : LiveState A,
        (automaton A).run word (k + 1) = some next ∧
          target ∈ next.1.label v) :
    ∃ next : LiveState A,
      (automaton A).run word (k + 1) = some next ∧
        target ∈ next.1.childLabelUnion A v := by
  rcases
      settledLowerSourceNodeNameStateTargetEvent_source_covered_or_lowerSourceNameEvent
        A run hevent hvNotGreen hsettle with
    hcovered | hlower
  · exact hcovered
  · rcases hlower with ⟨j, hjMem, hjEvent⟩
    exact False.elim
      (hnoSmaller k j hNk (Finset.mem_range.mp hjMem) hjEvent)

/--
Positive witness projection: if a fixed source has a state in its stage-(3) label
which is not in the child-label union, then that source is not green in the same
stage-(3) tree.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessEvent_source_not_green
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessEvent A run sourceNode
        sourceName sourceState target uncovered k) :
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        sourceNode ∉ (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A := by
  rcases hevent with ⟨_hpositive, live, hrun, huncoveredRaw⟩
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases huncoveredRaw with ⟨hlabelRaw, hnotCoverRaw⟩
  have hlabel : uncovered ∈ t3.label sourceNode := by
    simpa [t1, plan, t2, t3] using hlabelRaw
  have hnotCover : uncovered ∉ t3.childLabelUnion A sourceNode := by
    simpa [t1, plan, t2, t3] using hnotCoverRaw
  refine ⟨live, hrun, ?_⟩
  intro hgreenRaw
  have hgreen : sourceNode ∈ t3.greenNodes A := by
    simpa [t1, plan, t2, t3] using hgreenRaw
  exact hnotCover (green_label_mem_childLabelUnion A t3 hgreen hlabel)

/--
Surviving positive-witness events expose exactly the hypotheses needed by the
event-based one-step source-persistence lemma: the source is non-green in the
event's stage-(3) tree, and the fixed target is still in the source label in the
successor live tree.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent_source_not_green_and_target_next_label
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent A run
        sourceNode child sourceName sourceState target uncovered k) :
    (∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        sourceNode ∉ (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A) ∧
      ∃ next : LiveState A,
        (automaton A).run word (k + 1) = some next ∧
          target ∈ next.1.label sourceNode := by
  constructor
  · exact
      settledLowerSourceStage3ChildUnionPositiveWitnessEvent_source_not_green
        A run hevent.1.1
  · rcases
      settledLowerSourceStage3ChildUnionChildSurvivesEvent_to_next_childLabelUnion
        A run hevent.2 with
    ⟨next, hrunNext, _haccepting, hcover⟩
    rcases next.2 with
      ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
        _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
        hchildSubset, _hsiblingDisjoint⟩
    exact ⟨next, hrunNext,
      childLabelUnion_subset_label A next.1 hchildSubset sourceNode hcover⟩

/--
No-smaller version for the aligned surviving-positive branch.  After the
minimal-name cutoff, every surviving positive-witness event has its fixed target
covered by the source's children in the successor tree.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent_source_covered_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName N : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < sourceName ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ k)
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent A run
        sourceNode child sourceName sourceState target uncovered k) :
    ∃ next : LiveState A,
      (automaton A).run word (k + 1) = some next ∧
        target ∈ next.1.childLabelUnion A sourceNode := by
  rcases
      settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent_source_not_green_and_target_next_label
        A run hevent with
    ⟨hnotGreen, htargetNext⟩
  have hbase :
      SettledLowerSourceNodeNameStateTargetEvent A run sourceNode sourceName
        sourceState target k := by
    rcases hevent.2 with ⟨hchildEvent, _hsurvives⟩
    rcases hchildEvent with ⟨hchildUnionEvent, _hchildPayload⟩
    exact hchildUnionEvent.1
  exact
    settledLowerSourceNodeNameStateTargetEvent_source_covered_of_no_smaller
      A run hnoSmaller hNk hbase hnotGreen htargetNext

/--
Surviving-positive event enriched with the source-persistence conclusion: the
fixed target is child-covered by the fixed source in the successor live tree.
-/
def SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode child : Node A)
    (sourceName : Nat) (sourceState target uncovered : A.State)
    (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent A run
    sourceNode child sourceName sourceState target uncovered k ∧
    ∃ next : LiveState A,
      (automaton A).run word (k + 1) = some next ∧
        target ∈ next.1.childLabelUnion A sourceNode

/--
Measure-facing form of the covered surviving-positive event.  It keeps the
existing event package and exposes the exact stage-(3) uncovered witness together
with the successor child coverage forced by source persistence.
-/
def SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode child : Node A)
    (sourceName : Nat) (sourceState target uncovered : A.State)
    (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredEvent A
    run sourceNode child sourceName sourceState target uncovered k ∧
    ∃ live next : LiveState A,
      (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
          let t1 := live.1.stage1 A (word k)
          let plan := (livePlan A live (word k)).stage2Plan
          let t2 := t1.stage2 A plan
          let t3 := t2.stage3 A
          uncovered ∈ t3.label sourceNode ∧
            uncovered ∉ t3.childLabelUnion A sourceNode ∧
            target ∈ next.1.childLabelUnion A sourceNode

/--
The covered surviving-positive event already contains the exact measure payload:
the positive witness gives the uncovered stage-(3) state, and the covered suffix
gives successor child coverage at the fixed source.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredEvent_to_measureEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredEvent
        A run sourceNode child sourceName sourceState target uncovered k) :
    SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent
      A run sourceNode child sourceName sourceState target uncovered k := by
  have heventCopy := hevent
  rcases hevent with ⟨hsurvives, next, hrunNext, htargetCovered⟩
  rcases hsurvives with ⟨hpositiveChild, _hchildSurvives⟩
  rcases hpositiveChild with ⟨hpositive, _hchildEvent⟩
  rcases hpositive with ⟨_hpositiveEvent, live, hrun, huncovered⟩
  exact ⟨heventCopy, live, next, hrun, hrunNext, by simpa using huncovered.1,
    by simpa using huncovered.2, by simpa using htargetCovered⟩

/--
The measure-facing positive branch still carries the raw positive-witness
separation: the accepting target followed into a successor child is distinct
from the uncovered state left outside the source's stage-(3) child union.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent_target_ne_uncovered
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent
        A run sourceNode child sourceName sourceState target uncovered k) :
    target ≠ uncovered :=
  settledLowerSourceStage3ChildUnionPositiveWitnessEvent_target_ne_uncovered
    A run hevent.1.1.1.1

/--
Measure-facing source-persistence payload.  A covered positive-measure event
exposes the exact local hypotheses used by the remaining persistence argument:
the source is not green in the event's stage-(3) tree, the accepting target is
still in the source label at the successor live tree, and that target is not the
uncovered witness.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent_persistence_payload
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent
        A run sourceNode child sourceName sourceState target uncovered k) :
    (∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        sourceNode ∉ (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A) ∧
      (∃ next : LiveState A,
        (automaton A).run word (k + 1) = some next ∧
          target ∈ next.1.label sourceNode) ∧
        target ≠ uncovered := by
  have hpersist :=
    settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent_source_not_green_and_target_next_label
      A run hevent.1.1
  exact ⟨hpersist.1, hpersist.2,
    settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent_target_ne_uncovered
      A run hevent⟩

/--
Strict breakpoint-progress payload for the positive measure branch.  Once the
previously uncovered witness is covered in any comparison tree with the same
source label and at least the old child coverage, the source's uncovered-count
measure strictly decreases.  The remaining global kernel is exactly to supply
such a comparison tree, or else derive a forbidden smaller lower-source event.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent_uncoveredCount_decreases_to_tree
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    {live : LiveState A} {tree₂ : CompactTreeData A}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent
        A run sourceNode child sourceName sourceState target uncovered k)
    (hrun : (automaton A).run word k = some live)
    (hlabel :
      (let t1 := live.1.stage1 A (word k)
       let plan := (livePlan A live (word k)).stage2Plan
       let t2 := t1.stage2 A plan
       let t3 := t2.stage3 A
       t3.label sourceNode) = tree₂.label sourceNode)
    (hcover :
      (let t1 := live.1.stage1 A (word k)
       let plan := (livePlan A live (word k)).stage2Plan
       let t2 := t1.stage2 A plan
       let t3 := t2.stage3 A
       t3.childLabelUnion A sourceNode) ⊆ tree₂.childLabelUnion A sourceNode)
    (hnew : uncovered ∈ tree₂.childLabelUnion A sourceNode) :
    (let t1 := live.1.stage1 A (word k)
     let plan := (livePlan A live (word k)).stage2Plan
     let t2 := t1.stage2 A plan
     let t3 := t2.stage3 A
     tree₂.uncoveredCount A sourceNode < t3.uncoveredCount A sourceNode) := by
  rcases hevent with
    ⟨_hcovered, liveEvent, _nextEvent, hrunEvent, _hrunNextEvent,
      huncoveredLabel, huncoveredPrivate, _htargetCovered⟩
  have hliveEvent : liveEvent = live := by
    have hsome : some liveEvent = some live := by
      rw [← hrunEvent, hrun]
    exact Option.some.inj hsome
  subst liveEvent
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  exact
    uncoveredCount_lt_of_label_eq_of_newly_covered A t3 tree₂ sourceNode
      (by simpa [t1, plan, t2, t3] using hlabel)
      (by simpa [t1, plan, t2, t3] using hcover)
      (by simpa [t1, plan, t2, t3] using huncoveredLabel)
      (by simpa [t1, plan, t2, t3] using huncoveredPrivate)
      hnew

/--
Cofinal covered surviving-positive events can be viewed in the measure-facing
form without losing the cofinality witness.
-/
theorem frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCovered_to_measureEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredEvent
          A run sourceNode child sourceName sourceState target uncovered k) :
    ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent
        A run sourceNode child sourceName sourceState target uncovered k := by
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  exact ⟨k, hnk,
    settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredEvent_to_measureEvent
      A run hevent⟩

/--
Measure-facing covered event with the actual successor child carrying the fixed
target also exposed.  This is the Lean form of the paper step that, after the
run is covered by sons of the current node, follows one concrete son.
-/
def SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureNextChildEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode child coveredChild : Node A)
    (sourceName : Nat) (sourceState target uncovered : A.State)
    (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent
    A run sourceNode child sourceName sourceState target uncovered k ∧
    ∃ next : LiveState A,
      (automaton A).run word (k + 1) = some next ∧
        coveredChild ∈ next.1.children A sourceNode ∧
        target ∈ next.1.label coveredChild

/--
Same-child form of the measure-facing covered event.  The target is not merely
covered by some successor child of the lower source; it is carried by the
already fixed surviving child.
-/
def SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode child : Node A)
    (sourceName : Nat) (sourceState target uncovered : A.State)
    (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent
    A run sourceNode child sourceName sourceState target uncovered k ∧
    ∃ next : LiveState A,
      (automaton A).run word (k + 1) = some next ∧
        child ∈ next.1.children A sourceNode ∧
        target ∈ next.1.label child

/--
Same-child branch enriched with the settled-descent geometry: in the event's
stage-(3) tree, the fixed child is an ancestor of the already settled node `v`.
-/
def SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v sourceNode child : Node A)
    (sourceName : Nat) (sourceState target uncovered : A.State)
    (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildEvent
    A run sourceNode child sourceName sourceState target uncovered k ∧
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        let t1 := live.1.stage1 A (word k)
        let plan := (livePlan A live (word k)).stage2Plan
        let t2 := t1.stage2 A plan
        let t3 := t2.stage3 A
        t3.IsAncestorOrSelf A child v

/--
Source-label persistence for the positive same-child/ancestor kernel.  If the
fixed lower source is not removed by a green ancestor in the event's stage-(3)
tree, then the uncovered source witness survives the remaining transition
stages into the successor live tree at the same source node.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorEvent_uncovered_survives_of_source_not_removedByGreen
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorEvent
        A run v sourceNode child sourceName sourceState target uncovered k)
    (hnotRemoved :
      ∃ live : LiveState A,
        (automaton A).run word k = some live ∧
          ¬ (((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen A
            sourceNode) :
    ∃ next : LiveState A,
      (automaton A).run word (k + 1) = some next ∧
        uncovered ∈ next.1.label sourceNode := by
  rcases hevent with ⟨hsameChildEvent, _liveAncestor, _hrunAncestor,
    _hchildAncestor⟩
  rcases hsameChildEvent with
    ⟨hmeasureEvent, _nextSame, _hrunNextSame, _hchildNext, _htargetSame⟩
  rcases hmeasureEvent with
    ⟨_hcoveredEvent, live, next, hrun, hrunNext, huncoveredLabel,
      _huncoveredPrivate, _htargetCovered⟩
  rcases hnotRemoved with ⟨liveNR, hrunNR, hnotRemovedRaw⟩
  have hliveNREq : liveNR = live := by
    have hsome : some liveNR = some live := by
      rw [← hrunNR, hrun]
    exact Option.some.inj hsome
  subst liveNR
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hnotRemovedT3 : ¬ t3.RemovedByGreen A sourceNode := by
    simpa [t1, plan, t2, t3] using hnotRemovedRaw
  have huncoveredFinal :
      uncovered ∈ (liveNextTree A live (word k)).label sourceNode := by
    have hsurv :=
      mem_stage456_label_of_not_green A t3
        (by simpa [t1, plan, t2, t3] using huncoveredLabel)
        hnotRemovedT3
    simpa [liveNextTree, livePlan, t1, plan, t2, t3] using hsurv
  have hnextTree : next.1 = liveNextTree A live (word k) :=
    automaton_run_live_nextTree A word hrun hrunNext
  exact ⟨next, hrunNext, by simpa [hnextTree] using huncoveredFinal⟩

/--
Positive same-child/ancestor event where the fixed uncovered source witness
survives one step in the same lower-source label.
-/
def SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v sourceNode child : Node A)
    (sourceName : Nat) (sourceState target uncovered : A.State)
    (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorEvent
    A run v sourceNode child sourceName sourceState target uncovered k ∧
    ∃ next : LiveState A,
      (automaton A).run word (k + 1) = some next ∧
        uncovered ∈ next.1.label sourceNode

/--
Payload exposed by the source-survives branch.  At the event time the fixed
source is active with the fixed lower name; in the successor tree the uncovered
witness is still in the source label, while the accepting target is already
covered by a child of that source.  The two states are distinct.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent_payload
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent
        A run v sourceNode child sourceName sourceState target uncovered k) :
    ∃ live next : LiveState A,
      (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        live.1.active sourceNode = true ∧
        (live.1.name sourceNode).val = sourceName ∧
        uncovered ∈ next.1.label sourceNode ∧
        target ∈ next.1.childLabelUnion A sourceNode ∧
        target ≠ uncovered := by
  rcases hevent with ⟨hancestorEvent, nextSurv, hrunNextSurv,
    huncoveredNext⟩
  rcases hancestorEvent with ⟨hsameChildEvent, _liveAncestor,
    _hrunAncestor, _hancestorRaw⟩
  rcases hsameChildEvent with
    ⟨hmeasureEvent, _nextSame, _hrunNextSame, _hchildNext, _htargetSame⟩
  have hmeasureEventCopy := hmeasureEvent
  rcases hmeasureEvent with
    ⟨hcoveredEvent, liveMeasure, nextMeasure, hrunMeasure, hrunNextMeasure,
      _huncoveredLabel, _huncoveredPrivate, htargetCovered⟩
  rcases hcoveredEvent with ⟨hsurvivesEvent, _nextCovered,
    _hrunNextCovered, _htargetCoveredNext⟩
  rcases hsurvivesEvent with ⟨hpositiveChildEvent, _hchildSurvives⟩
  rcases hpositiveChildEvent with ⟨_hpositiveWitness, hchildEvent⟩
  rcases hchildEvent with ⟨hchildUnionEvent, _liveChild, _hrunChild,
    _hchildPayload⟩
  rcases hchildUnionEvent with ⟨hbase, _liveCU, _hrunCU, _hchildUnion⟩
  rcases hbase with
    ⟨liveBase, _nextBase, hrunBase, _hrunNextBase, _htargetEq,
      _haccepting, hsourceActive, _hsourceState, _hsegment, hsourceName⟩
  have hliveMeasureEq : liveMeasure = liveBase := by
    have hsome : some liveMeasure = some liveBase := by
      rw [← hrunMeasure, hrunBase]
    exact Option.some.inj hsome
  subst liveMeasure
  have hnextMeasureEq : nextMeasure = nextSurv := by
    have hsome : some nextMeasure = some nextSurv := by
      rw [← hrunNextMeasure, hrunNextSurv]
    exact Option.some.inj hsome
  subst nextMeasure
  exact ⟨liveBase, nextSurv, hrunBase, hrunNextSurv, hsourceActive,
    hsourceName, huncoveredNext, htargetCovered,
    settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureEvent_target_ne_uncovered
      A run hmeasureEventCopy⟩

/--
In the source-survives branch the fixed source's successor name cannot increase.
The source was active with name `sourceName` before the transition, and the
surviving uncovered witness gives a nonempty successor label at the same node;
stage (6) only compacts names downward.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent_next_sourceName_le
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent
        A run v sourceNode child sourceName sourceState target uncovered k) :
    ∃ next : LiveState A,
      (automaton A).run word (k + 1) = some next ∧
        uncovered ∈ next.1.label sourceNode ∧
        (next.1.name sourceNode).val ≤ sourceName := by
  rcases
      settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent_payload
        A run hevent with
    ⟨live, next, hrun, hrunNext, hactive, hname, huncoveredNext,
      _htargetCovered, _hne⟩
  have hnextTree : next.1 = liveNextTree A live (word k) :=
    automaton_run_live_nextTree A word hrun hrunNext
  have hle :
      ((liveNextTree A live (word k)).name sourceNode).val ≤
        (live.1.name sourceNode).val :=
    liveNextTree_name_val_le_of_active_next_label A live (word k)
      hactive (by simpa [hnextTree] using huncoveredNext)
  exact ⟨next, hrunNext, huncoveredNext, by
    rw [← hname]
    simpa [hnextTree] using hle⟩

/-- Source-survives branch where the fixed source keeps its name in the successor tree. -/
def SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameEqEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v sourceNode child : Node A)
    (sourceName : Nat) (sourceState target uncovered : A.State)
    (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent
    A run v sourceNode child sourceName sourceState target uncovered k ∧
    ∃ next : LiveState A,
      (automaton A).run word (k + 1) = some next ∧
        uncovered ∈ next.1.label sourceNode ∧
        (next.1.name sourceNode).val = sourceName

/-- Source-survives branch where stage-(6) compacts the fixed source below its old name. -/
def SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameLtEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v sourceNode child : Node A)
    (sourceName : Nat) (sourceState target uncovered : A.State)
    (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent
    A run v sourceNode child sourceName sourceState target uncovered k ∧
    ∃ next : LiveState A,
      (automaton A).run word (k + 1) = some next ∧
        uncovered ∈ next.1.label sourceNode ∧
        (next.1.name sourceNode).val < sourceName

/--
The source-survives branch splits into successor source-name equality or strict
source-name drop.  There is no third case because the source name cannot increase.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent_sourceName_eq_or_lt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent
        A run v sourceNode child sourceName sourceState target uncovered k) :
    SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameEqEvent
        A run v sourceNode child sourceName sourceState target uncovered k ∨
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameLtEvent
        A run v sourceNode child sourceName sourceState target uncovered k := by
  rcases
      settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent_next_sourceName_le
        A run hevent with
    ⟨next, hrunNext, huncoveredNext, hle⟩
  rcases Nat.lt_or_eq_of_le hle with hlt | heq
  · exact Or.inr ⟨hevent, next, hrunNext, huncoveredNext, hlt⟩
  · exact Or.inl ⟨hevent, next, hrunNext, huncoveredNext, heq⟩

/--
Cofinal source-survives branches split cofinally into same-source-name events or
strict source-name-drop events.
-/
theorem frequently_settled_positiveSameChildAncestor_sourceUncoveredSurvives_sourceName_eq_or_lt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent
          A run v sourceNode child sourceName sourceState target uncovered k) :
    (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameEqEvent
        A run v sourceNode child sourceName sourceState target uncovered k) ∨
      (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameLtEvent
          A run v sourceNode child sourceName sourceState target uncovered k) := by
  apply frequently_left_or_right_of_frequently_or
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  exact ⟨k, hnk,
    settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent_sourceName_eq_or_lt
      A run hevent⟩

/--
Strict-cut package for the source-survives branch, with all cuts chosen after a
given cutoff.  This is the cut-level form consumed by the interval-cover and
breakpoint-countdown lemmas.
-/
theorem exists_strict_cuts_after_settled_positiveSameChildAncestor_sourceUncoveredSurvives
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State}
    (N : Nat)
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent
          A run v sourceNode child sourceName sourceState target uncovered k) :
    ∃ cuts : Nat -> Nat,
      cuts 0 = 0 ∧
        (∀ i : Nat, cuts i < cuts (i + 1)) ∧
        (∀ i : Nat, N ≤ cuts (i + 1)) ∧
        ∀ i : Nat,
          SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent
            A run v sourceNode child sourceName sourceState target uncovered
            (cuts (i + 1)) := by
  have hfreqAfter :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        (N ≤ k ∧
          SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent
            A run v sourceNode child sourceName sourceState target uncovered
            k) := by
    intro n
    rcases hfreq (max n N) with ⟨k, hk, hevent⟩
    exact ⟨k, le_trans (le_max_left n N) hk,
      le_trans (le_max_right n N) hk, hevent⟩
  rcases exists_strict_cuts_from_zero_of_frequently_at_or_after
      hfreqAfter with
    ⟨cuts, hzero, hstrict, heventsAfter⟩
  exact ⟨cuts, hzero, hstrict, (fun i => (heventsAfter i).1),
    fun i => (heventsAfter i).2⟩

/--
One-step source-persistence split for the positive same-child/ancestor event:
either the fixed lower source is removed by a green ancestor in stage (4), or the
uncovered source witness survives into the successor source label.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorEvent_sourceRemovedByGreen_or_uncovered_survives
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorEvent
        A run v sourceNode child sourceName sourceState target uncovered k) :
    (SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorEvent
        A run v sourceNode child sourceName sourceState target uncovered k ∧
      ∃ live : LiveState A,
        (automaton A).run word k = some live ∧
          (((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen A
            sourceNode) ∨
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent
        A run v sourceNode child sourceName sourceState target uncovered k := by
  rcases hevent with ⟨hsameChildEvent, live, hrun, hancestorRaw⟩
  by_cases hremoved :
      (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen A
        sourceNode
  · exact Or.inl
      ⟨⟨hsameChildEvent, live, hrun, hancestorRaw⟩, live, hrun, hremoved⟩
  · exact Or.inr
      ⟨⟨hsameChildEvent, live, hrun, hancestorRaw⟩,
        settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorEvent_uncovered_survives_of_source_not_removedByGreen
          A run ⟨hsameChildEvent, live, hrun, hancestorRaw⟩
          ⟨live, hrun, hremoved⟩⟩

/--
Same-child ancestor event with the numeric bounded-descent payload: the fixed
child's stage-(3) name lies strictly above the lower-source name and at most the
already settled name `a`.
