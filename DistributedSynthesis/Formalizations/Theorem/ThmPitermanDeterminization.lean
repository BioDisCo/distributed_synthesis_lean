theorem acceptingFrontierNameEvent_exists_of_accepting_frontier
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {k : Nat}
    (hevent :
      ∃ live : LiveState A,
        (automaton A).run word k = some live ∧
          ∃ frontier state,
            live.1.active frontier = true ∧
              live.1.IsAncestorOrSelf A (root A) frontier ∧
                state ∈ live.1.label frontier ∧
                  state ∉ live.1.childLabelUnion A frontier ∧
                    A.accepting state) :
    ∃ frontierName,
      frontierName ∈ Finset.range (Fintype.card A.State) ∧
