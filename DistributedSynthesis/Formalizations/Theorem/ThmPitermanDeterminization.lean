theorem rootStage2SurvivesEvent_freshChild_trigger_segment
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {k : Nat}
    (hevent : RootStage2SurvivesEvent A word k) :
    ∃ live : LiveState A, ∃ acceptingState,
      (automaton A).run word k = some live ∧
        let t1 := live.1.stage1 A (word k)
        let plan := (livePlan A live (word k)).stage2Plan
        let t2 := t1.stage2 A plan
        let t3 := t2.stage3 A
        root A ∈ t1.stage2Triggers A ∧
          A.accepting acceptingState ∧
          ReachableAfter A A.initial word (k + 1) acceptingState ∧
          acceptingState ∈ t3.label (plan.freshChild (root A)) ∧
          plan.freshChild (root A) ∈ t3.children A (root A) ∧
          SegmentVisitsAcceptingCover A word k 1
            (live.1.label (root A))
            (t3.label (plan.freshChild (root A))) ∧
          (live.1.name (root A)).val <
            (t3.name (plan.freshChild (root A))).val := by
  rcases hevent with
    ⟨live, hrun, htrigger, acceptingState, haccepting, hreachable,
      hsurvives⟩
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hrootActive_t1 : t1.active (root A) = true := by
    rcases live.2 with
      ⟨hrootActive, _hrootName, _hrootParent, _hparentInvariant,
        _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
        _hchildSubset, _hsiblingDisjoint⟩
    simpa [t1, stage1] using hrootActive
  have hchild : plan.freshChild (root A) ∈ t3.children A (root A) := by
    simpa [t1, plan, t2, t3] using
      stage2_stage3_freshChild_mem_children A t1 plan hrootActive_t1
        (by simpa [t1] using htrigger)
  have hcover :
      SegmentVisitsAcceptingCover A word k 1
        (live.1.label (root A))
        (t3.label (plan.freshChild (root A))) := by
    simpa [t1, plan, t2, t3] using
      live_stage2Trigger_freshChild_stage3_label_segmentVisitsAcceptingCover
        A word live htrigger
  have hnameLt_t1 :
      (t1.name (root A)).val < (plan.freshName (root A)).val :=
    stage2_fresh_name_gt_root_name A t1 plan hrootActive_t1
      (by simpa [t1] using htrigger)
  have hnameLt :
      (live.1.name (root A)).val <
        (t3.name (plan.freshChild (root A))).val := by
    rw [show live.1.name (root A) = t1.name (root A) by
      simp [t1, stage1_name A live.1 (word k) (root A)]]
    rw [show t3.name (plan.freshChild (root A)) =
        t2.name (plan.freshChild (root A)) by
      simp [t3, stage3_name A t2 (plan.freshChild (root A))]]
    rw [stage2_freshChild_name A t1 plan (by simpa [t1] using htrigger)]
    exact hnameLt_t1
  exact ⟨live, acceptingState, hrun, by
    dsimp [t1, plan, t2, t3]
    exact ⟨by simpa [t1] using htrigger, haccepting, hreachable,
      by simpa [t1, plan, t2, t3] using hsurvives,
      by simpa [t1, plan, t2, t3] using hchild,
      by simpa [t1, plan, t2, t3] using hcover,
      by simpa [t1, plan, t2, t3] using hnameLt⟩⟩

theorem rootStage2SurvivesEvent_next_root_accepting_head
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {k : Nat}
    (hevent : RootStage2SurvivesEvent A word k) :
    ∃ live next acceptingState sourceState,
      (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        A.accepting acceptingState ∧
        sourceState ∈ live.1.label (root A) ∧
        ReachableAfter A A.initial word k sourceState ∧
        SegmentVisitsAccepting A word k 1 sourceState acceptingState ∧
        acceptingState ∈ next.1.label (root A) := by
  rcases rootStage2SurvivesEvent_freshChild_trigger_segment A hevent with
    ⟨live, acceptingState, hrun, hpayload⟩
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases hpayload with
    ⟨htrigger, haccepting, _hreachable, hsurvives, _hchild, hcover,
      _hnameLt⟩
  rcases hcover acceptingState hsurvives with
    ⟨sourceState, hsourceState, hsegment⟩
  have hsourceReachable :
      ReachableAfter A A.initial word k sourceState :=
    automaton_run_live_root_label_reachable A word k live hrun sourceState
      hsourceState
  have hstepAccepting :
      acceptingState ∈ stepImage A (word k) (live.1.label (root A)) := by
    rw [mem_stepImage A]
    refine ⟨sourceState, hsourceState, ?_⟩
    have hsegment' :
        Segment A word k 1 sourceState acceptingState :=
      segmentVisitsAccepting_to_segment A word hsegment
    rcases hsegment' with ⟨path, hsource, htarget, hstep⟩
    simpa [hsource, htarget] using hstep 0 (by omega)
  have hrootLabel : liveRootLabelNonempty A live (word k) := by
    exact Finset.ne_empty_of_mem
      (stepImage_subset_liveStage4RootLabel A live (word k) hstepAccepting)
  let next : LiveState A :=
    ⟨liveNextTree A live (word k),
      liveNextTree_wellFormed_of_rootLabelNonempty A live (word k)
        hrootLabel⟩
  have hrunNext : (automaton A).run word (k + 1) = some next := by
    have hstepNext :
        (automaton A).step (some live) (word k) = some next := by
      simpa [next] using
        automaton_step_live_eq_some_of_rootLabel_nonempty A live (word k)
          hrootLabel
    have hstepRun :
        (automaton A).step ((automaton A).run word k) (word k) = some next := by
      simpa [hrun] using hstepNext
    simpa [DetParityAutomaton.run] using hstepRun
  have htargetNext : acceptingState ∈ next.1.label (root A) := by
    change acceptingState ∈ (liveNextTree A live (word k)).label (root A)
    exact stepImage_subset_liveNextTree_root_label A live (word k)
      hstepAccepting
  exact ⟨live, next, acceptingState, sourceState, hrun, hrunNext,
    haccepting, hsourceState, hsourceReachable, hsegment, htargetNext⟩

theorem rootStage2SurvivesEvent_cuts_root_frontiers
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {cuts : Nat -> Nat}
    (hevents :
      ∀ i : Nat,
        RootStage2SurvivesEvent A word (cuts (i + 1))) :
    ∃ frontierLive : Nat -> LiveState A,
      (∀ i : Nat,
        (automaton A).run word (shiftedEventFrontierCuts cuts i) =
          some (frontierLive i)) ∧
      (∀ i : Nat, (frontierLive i).1.active (root A) = true) ∧
      (∀ i : Nat,
        ((frontierLive i).1.name (root A)).val = (rootName A).val) ∧
      (∀ i : Nat, ((frontierLive i).1.label (root A)).Nonempty) ∧
      (∀ i : Nat, ∀ state,
        state ∈ (frontierLive i).1.label (root A) ->
          ReachablePrefix A A.initial word
            (shiftedEventFrontierCuts cuts i) state) := by
  classical
  have hexists :
      ∀ i : Nat,
        ∃ next : LiveState A,
          (automaton A).run word (shiftedEventFrontierCuts cuts i) =
            some next ∧
          next.1.active (root A) = true ∧
          (next.1.name (root A)).val = (rootName A).val ∧
          (next.1.label (root A)).Nonempty ∧
          ∀ state,
            state ∈ next.1.label (root A) ->
              ReachablePrefix A A.initial word
                (shiftedEventFrontierCuts cuts i) state := by
    intro i
    rcases rootStage2SurvivesEvent_next_root_accepting_head A (hevents i) with
      ⟨_live, next, acceptingState, _sourceState, _hrun, hnext,
        _haccepting, _hsourceState, _hsourceReachable, _hsegment,
        htargetNext⟩
    rcases next.2 with
      ⟨hrootActive, hrootName, _hrootParent, _hparentInvariant,
        _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
        _hchildSubset, _hsiblingDisjoint⟩
    refine ⟨next, ?_, hrootActive, hrootName, ⟨acceptingState, htargetNext⟩,
      ?_⟩
    · simpa [shiftedEventFrontierCuts] using hnext
    · intro state hstate
      simpa [shiftedEventFrontierCuts] using
        automaton_run_live_active_label_reachablePrefix
          A word hnext hrootActive hstate
  let frontierLive : Nat -> LiveState A :=
    fun i => Classical.choose (hexists i)
  refine ⟨frontierLive, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    exact (Classical.choose_spec (hexists i)).1
  · intro i
    exact (Classical.choose_spec (hexists i)).2.1
  · intro i
    exact (Classical.choose_spec (hexists i)).2.2.1
  · intro i
    exact (Classical.choose_spec (hexists i)).2.2.2.1
  · intro i state hstate
    exact (Classical.choose_spec (hexists i)).2.2.2.2 state hstate

theorem live_stage3_green_label_cover_of_all_child_covers
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} (live : LiveState A)
    {green : Node A}
    (hgreen :
      green ∈
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).greenNodes A)
    (hchildCover :
      ∀ child state,
        child ∈
          (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).children A green ->
        state ∈
          (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label child ->
        ∃ source,
          source ∈ live.1.label green ∧
            SegmentVisitsAccepting A word n 1 source state) :
    ∀ state,
      state ∈
        (((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).stage3 A).label green ->
      ∃ source,
        source ∈ live.1.label green ∧
          SegmentVisitsAccepting A word n 1 source state := by
  intro state hstateGreen
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hstateUnion : state ∈ t3.childLabelUnion A green :=
    green_label_mem_childLabelUnion A t3
      (by simpa [t1, plan, t2, t3] using hgreen)
      (by simpa [t1, plan, t2, t3] using hstateGreen)
  rw [childLabelUnion, Finset.mem_biUnion] at hstateUnion
  rcases hstateUnion with ⟨child, hchild, hstateChild⟩
  exact hchildCover child state
    (by simpa [t1, plan, t2, t3] using hchild)
    (by simpa [t1, plan, t2, t3] using hstateChild)

