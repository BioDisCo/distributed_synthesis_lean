@[simp]
theorem automaton_priority_sink [DecidableEq A.State] :
    (automaton A).priority none = 1 :=
  rfl

@[simp]
theorem automaton_priority_live [DecidableEq A.State]
    (state : LiveState A) :
    (automaton A).priority (some state) = priority A state.1 :=
  rfl

@[simp]
theorem automaton_runFrom_sink [DecidableEq A.State]
    (word : OmegaWord Alphabet) (n : Nat) :
    (automaton A).runFrom none word n = none := by
  induction n with
  | zero => rfl
  | succ n ih =>
      simp [DetParityAutomaton.runFrom, ih]

theorem automaton_prioritySeenFrom_sink_iff [DecidableEq A.State]
    (word : OmegaWord Alphabet) (p : Nat) :
    (automaton A).PrioritySeenInfinitelyOftenFrom none word p ↔ p = 1 := by
  constructor
  · intro hseen
    rcases hseen 0 with ⟨k, _hk, hkprio⟩
    simpa using hkprio.symm
  · intro hp n
    exact ⟨n, Nat.le_refl n, by simp [hp]⟩

theorem automaton_sink_not_acceptsFrom [DecidableEq A.State]
    (word : OmegaWord Alphabet) :
    ¬ (automaton A).AcceptsFrom none word := by
  intro haccepts
  rcases haccepts with ⟨p, hpEven, hpSeen, _hpMin⟩
  have hp : p = 1 :=
    (automaton_prioritySeenFrom_sink_iff A word p).mp hpSeen
  subst p
  rcases hpEven with ⟨m, hm⟩
  omega

theorem automaton_not_acceptsFrom_of_step_sink [DecidableEq A.State]
    (state : DPWState A) (word : OmegaWord Alphabet)
    (hstep : (automaton A).step state (word 0) = none) :
    ¬ (automaton A).AcceptsFrom state word := by
  intro haccepts
  rcases haccepts with ⟨p, hpEven, hpSeen, hpMin⟩
  have hpSeenSink :
      (automaton A).PrioritySeenInfinitelyOftenFrom
        none (OmegaWord.drop word 1) p := by
    rw [← hstep]
    exact ((automaton A).prioritySeenInfinitelyOftenFrom_step_drop_iff
      state word p).mpr hpSeen
  have hp : p = 1 :=
    (automaton_prioritySeenFrom_sink_iff A (OmegaWord.drop word 1) p).mp
      hpSeenSink
  subst p
  rcases hpEven with ⟨m, hm⟩
  omega

theorem automaton_not_acceptsFrom_live_of_rootLabel_empty
    [DecidableEq A.State]
    (state : LiveState A) (word : OmegaWord Alphabet)
    (hrootLabel : ¬ liveRootLabelNonempty A state (word 0)) :
    ¬ (automaton A).AcceptsFrom (some state) word :=
  automaton_not_acceptsFrom_of_step_sink A (some state) word
    (automaton_step_live_eq_none_of_rootLabel_empty A state (word 0)
      hrootLabel)

theorem automaton_not_acceptsFrom_of_runFrom_sink
    [DecidableEq A.State]
    (state : DPWState A) (word : OmegaWord Alphabet) (n : Nat)
    (hrun : (automaton A).runFrom state word n = none) :
    ¬ (automaton A).AcceptsFrom state word := by
  intro haccepts
  have hsinkAccepts :
      (automaton A).AcceptsFrom none (OmegaWord.drop word n) := by
    rw [← hrun]
    exact ((automaton A).acceptsFrom_runFrom_drop_iff state word n).mpr
      haccepts
  exact automaton_sink_not_acceptsFrom A (OmegaWord.drop word n) hsinkAccepts

theorem automaton_runFrom_ne_sink_of_acceptsFrom
    [DecidableEq A.State]
    (state : DPWState A) (word : OmegaWord Alphabet)
    (haccepts : (automaton A).AcceptsFrom state word) (n : Nat) :
    (automaton A).runFrom state word n ≠ none := by
  intro hrun
  exact automaton_not_acceptsFrom_of_runFrom_sink A state word n hrun
    haccepts

theorem automaton_run_exists_live_of_accepts
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (haccepts : (automaton A).Accepts word) (n : Nat) :
    ∃ live : LiveState A, (automaton A).run word n = some live := by
  have hne :
      (automaton A).run word n ≠ none := by
    simpa [DetParityAutomaton.run] using
      automaton_runFrom_ne_sink_of_acceptsFrom A (automaton A).initial
        word haccepts n
  cases hrun : (automaton A).run word n with
  | none =>
      exact False.elim (hne hrun)
  | some live =>
      exact ⟨live, rfl⟩

theorem automaton_run_interval_lives_of_accepts
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (haccepts : (automaton A).Accepts word)
    (start length : Nat) :
    ∃ lives : Nat -> LiveState A,
      ∀ i : Nat, i ≤ length ->
        (automaton A).run word (start + i) = some (lives i) := by
  classical
  let liveAt : Nat -> LiveState A := fun n =>
    Classical.choose (automaton_run_exists_live_of_accepts A word haccepts n)
  refine ⟨fun i => liveAt (start + i), ?_⟩
  intro i _hi
  exact Classical.choose_spec
    (automaton_run_exists_live_of_accepts A word haccepts (start + i))

theorem automaton_run_exists_live_of_later_run
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {start length i : Nat} {last : LiveState A}
    (hi : i ≤ length)
    (hrunLast : (automaton A).run word (start + length) = some last) :
    ∃ live : LiveState A,
      (automaton A).run word (start + i) = some live := by
  by_cases hrun : (automaton A).run word (start + i) = none
  · have hdrop :
        (automaton A).runFrom ((automaton A).run word (start + i))
          (OmegaWord.drop word (start + i)) (length - i) =
          (automaton A).run word (start + length) := by
      simpa [DetParityAutomaton.run, Nat.add_assoc, Nat.add_left_comm,
        Nat.add_comm, Nat.add_sub_of_le hi] using
        ((automaton A).runFrom_drop (automaton A).initial word
          (start + i) (length - i))
    rw [hrun, automaton_runFrom_sink] at hdrop
    rw [hrunLast] at hdrop
    simp at hdrop
  · cases hrunSome : (automaton A).run word (start + i) with
    | none => exact False.elim (hrun hrunSome)
    | some live => exact ⟨live, rfl⟩

theorem automaton_run_interval_lives_of_later_run
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {start length : Nat} {last : LiveState A}
    (hrunLast : (automaton A).run word (start + length) = some last) :
    ∃ lives : Nat -> LiveState A,
      ∀ i : Nat, i ≤ length ->
        (automaton A).run word (start + i) = some (lives i) := by
  classical
  let liveAt : Nat -> LiveState A := fun i =>
    if hi : i ≤ length then
      Classical.choose
        (automaton_run_exists_live_of_later_run A word
          (i := i) hi hrunLast)
    else
      last
  refine ⟨liveAt, ?_⟩
  intro i hi
  simp [liveAt, hi]
  exact Classical.choose_spec
    (automaton_run_exists_live_of_later_run A word
      (i := i) hi hrunLast)

theorem automaton_run_live_e_pos
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live : LiveState A}
    (hrun : (automaton A).run word n = some live) :
    0 < live.1.e.val := by
  cases n with
  | zero =>
      have hlive :
          live = ⟨initial A, initial_wellFormed A⟩ := by
        have hsome : some ⟨initial A, initial_wellFormed A⟩ = some live := hrun
        injection hsome with hlive'
        exact hlive'.symm
      subst live
      simp [initial, sentinel]
      exact Fintype.card_pos_iff.mpr ⟨A.initial⟩
  | succ n =>
      let prevState := (automaton A).run word n
      have hstep :
          (automaton A).step prevState (word n) = some live := by
        simpa [prevState, DetParityAutomaton.run] using hrun
      cases hprev : prevState with
      | none =>
          rw [hprev] at hstep
          simp at hstep
      | some prevLive =>
          rw [hprev] at hstep
          by_cases hrootLabel : liveRootLabelNonempty A prevLive (word n)
          · have hsome :
                some
                  ⟨liveNextTree A prevLive (word n),
                    liveNextTree_wellFormed_of_rootLabelNonempty A
                      prevLive (word n) hrootLabel⟩ = some live := by
              rw [← automaton_step_live_eq_some_of_rootLabel_nonempty A
                prevLive (word n) hrootLabel]
              exact hstep
            injection hsome with hlive'
            have hlive :
                live =
                  ⟨liveNextTree A prevLive (word n),
                    liveNextTree_wellFormed_of_rootLabelNonempty A
                      prevLive (word n) hrootLabel⟩ := hlive'.symm
            subst live
            exact liveNextTree_e_pos_of_rootLabelNonempty A prevLive
              (word n) hrootLabel
          · have hnone :
                (automaton A).step (some prevLive) (word n) = none :=
              automaton_step_live_eq_none_of_rootLabel_empty A prevLive
                (word n) hrootLabel
            rw [hnone] at hstep
            simp at hstep

theorem automaton_acceptsFrom_frequently_live_f_lt_e
    [DecidableEq A.State]
    (state : DPWState A) (word : OmegaWord Alphabet)
    (haccepts : (automaton A).AcceptsFrom state word) :
    ∃ p : Nat,
      DetParityAutomaton.NatEven p ∧
        (automaton A).PrioritySeenInfinitelyOftenFrom state word p ∧
        (∀ q : Nat,
          (automaton A).PrioritySeenInfinitelyOftenFrom state word q -> p ≤ q) ∧
        ∀ n : Nat,
          ∃ k : Nat, n ≤ k ∧
            ∃ live : LiveState A,
              (automaton A).runFrom state word k = some live ∧
                live.1.f.val < live.1.e.val ∧ priority A live.1 = p := by
  rcases haccepts with ⟨p, hpEven, hpSeen, hpMin⟩
  refine ⟨p, hpEven, hpSeen, hpMin, ?_⟩
  intro n
  rcases hpSeen n with ⟨k, hk, hkprio⟩
  have hnotSink :
      (automaton A).runFrom state word k ≠ none :=
    automaton_runFrom_ne_sink_of_acceptsFrom A state word
      ⟨p, hpEven, hpSeen, hpMin⟩ k
  cases hrun : (automaton A).runFrom state word k with
  | none =>
      exact False.elim (hnotSink hrun)
  | some live =>
      have hprioLive : priority A live.1 = p := by
        simpa [hrun] using hkprio
      have hevenLive : DetParityAutomaton.NatEven (priority A live.1) := by
        rw [hprioLive]
        exact hpEven
      exact ⟨k, hk, live, hrun,
        (priority_even_iff_f_lt_e A live.1).mp hevenLive, hprioLive⟩

theorem automaton_acceptsFrom_frequently_live_min_name
    [DecidableEq A.State]
    (state : DPWState A) (word : OmegaWord Alphabet)
    (haccepts : (automaton A).AcceptsFrom state word) :
    ∃ recurrentName : Name A,
      (∀ q : Nat,
        (automaton A).PrioritySeenInfinitelyOftenFrom state word q ->
          2 * recurrentName.val ≤ q) ∧
      ∀ n : Nat,
        ∃ k : Nat, n ≤ k ∧
          ∃ live : LiveState A,
            (automaton A).runFrom state word k = some live ∧
              live.1.f = recurrentName ∧
              live.1.f.val < live.1.e.val := by
  rcases automaton_acceptsFrom_frequently_live_f_lt_e A state word haccepts with
    ⟨p, _hpEven, hpSeen, hpMin, hfreq⟩
  rcases hfreq 0 with ⟨k0, _hk0, live0, _hrun0, hfe0, hprio0⟩
  let recurrentName : Name A := live0.1.f
  have hp_eq_name : p = 2 * recurrentName.val := by
    rw [← hprio0]
    simp [priority, hfe0, recurrentName]
  refine ⟨recurrentName, ?_, ?_⟩
  · intro q hq
    have hpq : p ≤ q := hpMin q hq
    omega
  · intro n
    rcases hfreq n with ⟨k, hk, live, hrun, hfe, hprio⟩
    have hp_eq_live : p = 2 * live.1.f.val := by
      rw [← hprio]
      simp [priority, hfe]
    have hval : live.1.f.val = recurrentName.val := by
      omega
    exact ⟨k, hk, live, hrun, Fin.ext hval, hfe⟩

theorem automaton_acceptsFrom_eventually_priority_ge_min_name
    [DecidableEq A.State]
    (state : DPWState A) (word : OmegaWord Alphabet)
    (haccepts : (automaton A).AcceptsFrom state word) :
    ∃ recurrentName : Name A,
      (∀ q : Nat,
        (automaton A).PrioritySeenInfinitelyOftenFrom state word q ->
          2 * recurrentName.val ≤ q) ∧
      (∀ n : Nat,
        ∃ k : Nat, n ≤ k ∧
          ∃ live : LiveState A,
            (automaton A).runFrom state word k = some live ∧
              live.1.f = recurrentName ∧
              live.1.f.val < live.1.e.val) ∧
      ∃ N : Nat,
        ∀ k : Nat, N ≤ k ->
          2 * recurrentName.val ≤
            (automaton A).priority ((automaton A).runFrom state word k) := by
  classical
  rcases automaton_acceptsFrom_frequently_live_min_name A state word haccepts with
    ⟨recurrentName, hmin, hfreq⟩
  let lowPriorities : Finset Nat := Finset.range (2 * recurrentName.val)
  have hnotSeen :
      ∀ q ∈ lowPriorities,
        ¬ (automaton A).PrioritySeenInfinitelyOftenFrom state word q := by
    intro q hq hseen
    have hlt : q < 2 * recurrentName.val := Finset.mem_range.mp hq
    have hle : 2 * recurrentName.val ≤ q := hmin q hseen
    omega
  have hbound :
      ∀ q ∈ lowPriorities,
        ∃ N : Nat,
          ∀ k : Nat, N ≤ k ->
            (automaton A).priority
                ((automaton A).runFrom state word k) ≠ q := by
    intro q hq
    by_contra hnone
    have hseen :
        (automaton A).PrioritySeenInfinitelyOftenFrom state word q := by
      intro n
      by_contra hnoAtOrAfter
      apply hnone
      refine ⟨n, ?_⟩
      intro k hk hprio
      exact hnoAtOrAfter ⟨k, hk, hprio⟩
    exact hnotSeen q hq hseen
  let boundOf : Nat -> Nat := fun q =>
    if hq : q ∈ lowPriorities then Nat.find (hbound q hq) else 0
  refine ⟨recurrentName, hmin, hfreq, lowPriorities.sup boundOf, ?_⟩
  intro k hk
  by_contra hlt_not
  have hlt :
      (automaton A).priority ((automaton A).runFrom state word k) <
        2 * recurrentName.val := by
    omega
  have hprioMem :
      (automaton A).priority ((automaton A).runFrom state word k) ∈
        lowPriorities := by
    exact Finset.mem_range.mpr hlt
  have hbound_le :
      boundOf ((automaton A).priority ((automaton A).runFrom state word k)) ≤
        lowPriorities.sup boundOf :=
    Finset.le_sup hprioMem
  have hfindSpec :=
    Nat.find_spec
      (hbound
        ((automaton A).priority ((automaton A).runFrom state word k))
        hprioMem)
  have hboundOf_eq :
      boundOf ((automaton A).priority ((automaton A).runFrom state word k)) =
        Nat.find
          (hbound
            ((automaton A).priority ((automaton A).runFrom state word k))
            hprioMem) := by
    simp [boundOf, hprioMem]
  rw [hboundOf_eq] at hbound_le
  have hfind_le_k :
      Nat.find
          (hbound
            ((automaton A).priority ((automaton A).runFrom state word k))
            hprioMem) ≤ k :=
    Nat.le_trans hbound_le hk
  exact hfindSpec k hfind_le_k rfl

theorem automaton_acceptsFrom_eventually_no_smaller_name_events
    [DecidableEq A.State]
    (state : DPWState A) (word : OmegaWord Alphabet)
    (haccepts : (automaton A).AcceptsFrom state word) :
    ∃ recurrentName : Name A,
      (∀ q : Nat,
        (automaton A).PrioritySeenInfinitelyOftenFrom state word q ->
          2 * recurrentName.val ≤ q) ∧
      (∀ n : Nat,
        ∃ k : Nat, n ≤ k ∧
          ∃ live : LiveState A,
            (automaton A).runFrom state word k = some live ∧
              live.1.f = recurrentName ∧
              live.1.f.val < live.1.e.val) ∧
      ∃ N : Nat,
        ∀ k : Nat, N ≤ k ->
          ∀ live : LiveState A,
            (automaton A).runFrom state word k = some live ->
              (live.1.f.val < live.1.e.val -> recurrentName.val ≤ live.1.f.val) ∧
              (¬ live.1.f.val < live.1.e.val -> recurrentName.val ≤ live.1.e.val) := by
  rcases automaton_acceptsFrom_eventually_priority_ge_min_name A state word
      haccepts with
    ⟨recurrentName, hmin, hfreq, N, hprioLower⟩
  refine ⟨recurrentName, hmin, hfreq, N, ?_⟩
  intro k hk live hrun
  have hprioLowerLive :
      2 * recurrentName.val ≤ priority A live.1 := by
    have hlower := hprioLower k hk
    simpa [hrun] using hlower
  constructor
  · intro hfe
    by_contra hlt_not
    have hlt : live.1.f.val < recurrentName.val := by omega
    have hprio_lt :
        priority A live.1 < 2 * recurrentName.val := by
      simp [priority, hfe]
      omega
    omega
  · intro hnfe
    by_contra hlt_not
    have hlt : live.1.e.val < recurrentName.val := by omega
    have hprio_lt :
        priority A live.1 < 2 * recurrentName.val := by
      cases hval : live.1.e.val with
      | zero =>
          simp [priority, hval]
          omega
      | succ pred =>
          have hnotLe : ¬ live.1.f.val ≤ pred := by
            intro hle
            exact hnfe (by simpa [hval] using Nat.lt_succ_of_le hle)
          simp [priority, hval, hnotLe]
          omega
    omega

theorem automaton_accepts_eventually_no_smaller_or_same_name_events
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (haccepts : (automaton A).Accepts word) :
    ∃ recurrentName : Name A,
      (∀ q : Nat,
        (automaton A).PrioritySeenInfinitelyOften word q ->
          2 * recurrentName.val ≤ q) ∧
      (∀ n : Nat,
        ∃ k : Nat, n ≤ k ∧
          ∃ live : LiveState A,
            (automaton A).run word k = some live ∧
              live.1.f = recurrentName ∧
              live.1.f.val < live.1.e.val) ∧
      ∃ N : Nat,
        ∀ k : Nat, N ≤ k ->
          ∀ live : LiveState A,
            (automaton A).run word k = some live ->
              (live.1.f.val < live.1.e.val ->
                recurrentName.val ≤ live.1.f.val) ∧
              (¬ live.1.f.val < live.1.e.val ->
                recurrentName.val < live.1.e.val) := by
  rcases automaton_acceptsFrom_eventually_priority_ge_min_name A
      (automaton A).initial word haccepts with
    ⟨recurrentName, hminFrom, hfreqFrom, N, hprioLower⟩
  refine ⟨recurrentName, ?_, ?_, N, ?_⟩
  · intro q hq
    exact hminFrom q hq
  · intro n
    rcases hfreqFrom n with ⟨k, hk, live, hrun, hfname, hfe⟩
    refine ⟨k, hk, live, ?_, hfname, hfe⟩
    simpa [DetParityAutomaton.run] using hrun
  · intro k hk live hrun
    have hrunFrom :
        (automaton A).runFrom (automaton A).initial word k = some live := by
      simpa [DetParityAutomaton.run] using hrun
    have hprioLowerLive :
        2 * recurrentName.val ≤ priority A live.1 := by
      have hlower := hprioLower k hk
      rw [hrunFrom] at hlower
      simpa using hlower
    constructor
    · intro hfe
      by_contra hlt_not
      have hlt : live.1.f.val < recurrentName.val := by omega
      have hprio_lt :
          priority A live.1 < 2 * recurrentName.val := by
        simp [priority, hfe]
        omega
      omega
    · intro hnfe
      by_contra hlt_not
      have hle : live.1.e.val ≤ recurrentName.val := by omega
      have hepos : 0 < live.1.e.val :=
        automaton_run_live_e_pos A word hrun
      have hprio_lt :
          priority A live.1 < 2 * recurrentName.val := by
        cases hval : live.1.e.val with
        | zero =>
            omega
        | succ pred =>
            have hnotLe : ¬ live.1.f.val ≤ pred := by
              intro hlePred
              exact hnfe (by simpa [hval] using Nat.lt_succ_of_le hlePred)
            simp [priority, hval, hnotLe]
            omega
      omega

theorem no_smaller_name_events_strict_e_of_ne
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {recurrentName : Name A} {N k : Nat}
    (hstable :
      ∀ k : Nat, N ≤ k ->
        ∀ live : LiveState A,
          (automaton A).run word k = some live ->
            (live.1.f.val < live.1.e.val ->
              recurrentName.val ≤ live.1.f.val) ∧
            (¬ live.1.f.val < live.1.e.val ->
              recurrentName.val ≤ live.1.e.val))
    (hNk : N ≤ k)
    {live : LiveState A}
    (hrun : (automaton A).run word k = some live)
    (hneDelete : live.1.e.val ≠ recurrentName.val) :
    recurrentName.val ≤ live.1.f.val ∧
      recurrentName.val < live.1.e.val := by
  rcases hstable k hNk live hrun with ⟨hgreen, hdelete⟩
  by_cases hfe : live.1.f.val < live.1.e.val
  · have hf := hgreen hfe
    exact ⟨hf, by omega⟩
  · have he := hdelete hfe
    exact ⟨by omega, by omega⟩

theorem stable_live_interval_no_smaller_next_of_no_same_delete
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {recurrentName : Name A} {N start length : Nat}
    (hstable :
      ∀ k : Nat, N ≤ k ->
        ∀ live : LiveState A,
          (automaton A).run word k = some live ->
            (live.1.f.val < live.1.e.val ->
              recurrentName.val ≤ live.1.f.val) ∧
            (¬ live.1.f.val < live.1.e.val ->
              recurrentName.val ≤ live.1.e.val))
    (hNstart : N ≤ start)
    (lives : Nat -> LiveState A)
    (hrun :
      ∀ i : Nat, i ≤ length ->
        (automaton A).run word (start + i) = some (lives i))
    (hnoSameDelete :
      ∀ i : Nat, i < length ->
        ((lives (i + 1)).1.e).val ≠ recurrentName.val) :
    ∀ i : Nat, i < length ->
      recurrentName.val ≤ ((lives (i + 1)).1.f).val ∧
        recurrentName.val < ((lives (i + 1)).1.e).val := by
  intro i hi
  exact no_smaller_name_events_strict_e_of_ne A hstable
    (by omega)
    (hrun (i + 1) (by omega))
    (hnoSameDelete i hi)

theorem automaton_run_interval_segmentCover_from_active_node_no_same_delete
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {recurrentName : Name A} {N start length : Nat}
    (hstable :
      ∀ k : Nat, N ≤ k ->
        ∀ live : LiveState A,
          (automaton A).run word k = some live ->
            (live.1.f.val < live.1.e.val ->
              recurrentName.val ≤ live.1.f.val) ∧
            (¬ live.1.f.val < live.1.e.val ->
              recurrentName.val ≤ live.1.e.val))
    (hNstart : N ≤ start)
    (lives : Nat -> LiveState A)
    (hrun :
      ∀ i : Nat, i ≤ length ->
        (automaton A).run word (start + i) = some (lives i))
    {node : Node A}
    (hactive0 : (lives 0).1.active node = true)
    (hname0 : ((lives 0).1.name node).val = recurrentName.val)
    (hnoSameDelete :
      ∀ i : Nat, i < length ->
        ((lives (i + 1)).1.e).val ≠ recurrentName.val) :
    SegmentCover A word start length
      ((lives 0).1.label node) ((lives length).1.label node) := by
  rcases (lives 0).2 with
    ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
      _hinactiveLabel, hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have hnoSmallerNext :
      ∀ i : Nat, i < length ->
        recurrentName.val ≤ ((lives (i + 1)).1.f).val ∧
          recurrentName.val < ((lives (i + 1)).1.e).val :=
    stable_live_interval_no_smaller_next_of_no_same_delete A word
      hstable hNstart lives hrun hnoSameDelete
  have hactive :
      ∀ i : Nat, i ≤ length ->
        (lives i).1.active node = true ∧
          ((lives i).1.name node).val = recurrentName.val :=
    automaton_run_interval_preserves_active_name_of_fixed_next_bounds
      A word start length lives hrun hactive0
      (by simpa [hactive0] using hbound node hactive0)
      hname0 hnoSmallerNext
  intro target htarget
  rcases automaton_run_interval_active_label_segment_from_same_node
      A word start length lives hrun
      (fun i hi => (hactive i (by omega)).1) htarget with
    ⟨source, hsource, hsegment⟩
  exact ⟨source, hsource, hsegment⟩

theorem LiveState.active_node_eq_of_same_name
    [DecidableEq A.State]
    (live : LiveState A)
    {left right : Node A}
    (hleftActive : live.1.active left = true)
    (hrightActive : live.1.active right = true)
    (hleftName : (live.1.name left).val = m)
    (hrightName : (live.1.name right).val = m) :
    left = right := by
  rcases live.2 with
    ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
      _hinactiveLabel, _hbound, hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have hnameEq : live.1.name left = live.1.name right := by
    apply Fin.ext
    omega
  exact hinjective left right hleftActive hrightActive hnameEq

theorem automaton_accepts_frequently_transition_green
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (haccepts : (automaton A).Accepts word) :
    ∀ n : Nat,
      ∃ k : Nat, n ≤ k ∧
        ∃ prev next : LiveState A,
          (automaton A).run word k = some prev ∧
          (automaton A).run word (k + 1) = some next ∧
          ∃ green,
            green ∈
              (((prev.1.stage1 A (word k)).stage2 A
                  (livePlan A prev (word k)).stage2Plan).stage3 A).greenNodes A ∧
            ((((prev.1.stage1 A (word k)).stage2 A
                  (livePlan A prev (word k)).stage2Plan).stage3 A).name
                green).val =
              next.1.f.val ∧
            next.1.f.val < next.1.e.val ∧
            (((prev.1.stage1 A (word k)).stage2 A
                (livePlan A prev (word k)).stage2Plan).stage3 A).label green ≠
              ∅ := by
  rcases automaton_acceptsFrom_frequently_live_f_lt_e A
      (automaton A).initial word haccepts with
    ⟨p, hpEven, hpSeen, hpMin, hfreq⟩
  intro n
  rcases hfreq (n + 1) with
    ⟨j, hj, next, hrunNext, hfe, _hprio⟩
  cases j with
  | zero =>
      omega
  | succ k =>
      have hnk : n ≤ k := by omega
      have hrunNextRun :
          (automaton A).run word (k + 1) = some next := by
        simpa [DetParityAutomaton.run] using hrunNext
      let prevState := (automaton A).run word k
      have hstep :
          (automaton A).step prevState (word k) = some next := by
        simpa [prevState, DetParityAutomaton.run] using hrunNextRun
      cases hprev : prevState with
      | none =>
          rw [hprev] at hstep
          simp at hstep
      | some prev =>
          rw [hprev] at hstep
          by_cases hrootLabel : liveRootLabelNonempty A prev (word k)
          · have hsome :
                some
                  ⟨liveNextTree A prev (word k),
                    liveNextTree_wellFormed_of_rootLabelNonempty A
                      prev (word k) hrootLabel⟩ = some next := by
              rw [← automaton_step_live_eq_some_of_rootLabel_nonempty A
                prev (word k) hrootLabel]
              exact hstep
            injection hsome with hnext'
            have hnext :
                next =
                  ⟨liveNextTree A prev (word k),
                    liveNextTree_wellFormed_of_rootLabelNonempty A
                      prev (word k) hrootLabel⟩ := hnext'.symm
            subst next
            rcases liveNextTree_exists_green_name_eq_f_of_f_lt_e A
                prev (word k) hfe with
              ⟨green, hgreen, hgreenName⟩
            have hgreenNonempty :
                (((prev.1.stage1 A (word k)).stage2 A
                    (livePlan A prev (word k)).stage2Plan).stage3 A).label
                    green ≠ ∅ :=
              liveNextTree_green_name_eq_f_label_nonempty_of_f_lt_e A
                prev (word k) hgreen hgreenName hfe
            refine ⟨k, hnk, prev,
              ⟨liveNextTree A prev (word k),
                liveNextTree_wellFormed_of_rootLabelNonempty A
                  prev (word k) hrootLabel⟩, ?_, ?_, green, hgreen,
              hgreenName, hfe, hgreenNonempty⟩
            · simpa [prevState] using hprev
            · exact hrunNextRun
          · have hnone :
                (automaton A).step (some prev) (word k) = none :=
              automaton_step_live_eq_none_of_rootLabel_empty A prev
                (word k) hrootLabel
            rw [hnone] at hstep
            simp at hstep

theorem automaton_accepts_frequently_transition_green_min_name
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (haccepts : (automaton A).Accepts word) :
