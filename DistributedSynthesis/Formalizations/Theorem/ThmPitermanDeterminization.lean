/--
An accepting node/name/state reachability event at a positive time exposes the
last one-step accepting segment of the reachable prefix.
-/
theorem acceptingNodeNameStateReachableAt_split_last
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t : Nat}
    (hevent :
      AcceptingNodeNameStateReachableAt A run v nodeName target t)
    (hpos : 0 < t) :
    ∃ source : A.State,
      ReachablePrefix A A.initial word (t - 1) source ∧
        SegmentVisitsAccepting A word (t - 1) 1 source target := by
  rcases hevent with
    ⟨⟨_live, _hrun, _htargetEq, haccepting, _htargetLabel, _hname⟩,
      hreachable⟩
  exact reachablePrefix_split_last_accepting A A.initial word hreachable
    haccepting hpos

/--
If the predecessor source exposed by an accepting node/name/state cut is already
in the same node with the same name at the previous live time, then that previous
time is a genuine lower-source event.  This is the local bridge needed by the
source-compaction residual branch: the hypothesis is
the predecessor label-membership premise along the strict cuts.
-/
theorem acceptingNodeNameStateReachableAt_predecessor_label_to_lowerSourceNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target source : A.State} {t : Nat}
    {prev : LiveState A}
    (hevent :
      AcceptingNodeNameStateReachableAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hsource : source ∈ prev.1.label v)
    (hname : (prev.1.name v).val = nodeName)
    (hsegment :
      SegmentVisitsAccepting A word (t - 1) 1 source target) :
    SettledLowerSourceNameEvent A run nodeName (t - 1) := by
  rcases hevent with
    ⟨⟨next, hrunNext, htargetEq, haccepting, _htargetLabel, _hnodeName⟩,
      _hreachable⟩
  have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel hpos
  refine ⟨prev, next, v, source, hprev, ?_, ?_, hactive, hsource, ?_, hname⟩
  · simpa [hsucc] using hrunNext
  · simpa [hsucc, htargetEq] using haccepting
  · simpa [hsucc, htargetEq] using hsegment

/--
Cut-sequence contradiction form of
`acceptingNodeNameStateReachableAt_predecessor_label_to_lowerSourceNameEvent`.
If every accepting cut has a predecessor source that lies in the same node with
the smaller source name at the previous live time, then a sufficiently late cut
violates the no-smaller lower-source cutoff.
-/
theorem acceptingNodeNameStateReachableCuts_predecessor_labels_contradict_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m N : Nat} {target : A.State}
    {cuts : Nat -> Nat} {sources : Nat -> A.State}
    (hnodeLt : nodeName < m)
    (hstrict : ∀ i : Nat, cuts i < cuts (i + 1))
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hevents :
      ∀ i : Nat,
        AcceptingNodeNameStateReachableAt A run v nodeName target
          (cuts (i + 1)))
    (hsources :
      ∀ i : Nat,
        ReachablePrefix A A.initial word (cuts (i + 1) - 1) (sources i) ∧
          SegmentVisitsAccepting A word (cuts (i + 1) - 1) 1
            (sources i) target)
    (hlabels :
      ∀ i : Nat,
        ∃ prev : LiveState A,
          (automaton A).run word (cuts (i + 1) - 1) = some prev ∧
            prev.1.active v = true ∧
            sources i ∈ prev.1.label v ∧
            (prev.1.name v).val = nodeName) :
    False := by
  let i : Nat := N
  let t : Nat := cuts (i + 1)
  have hpos : 0 < t := by
    have hle : i + 1 ≤ t := by
      simpa [t] using self_le_of_strict_succ_cuts cuts hstrict (i + 1)
    omega
  have hNk : N ≤ t - 1 := by
    have hle : i + 1 ≤ t := by
      simpa [t] using self_le_of_strict_succ_cuts cuts hstrict (i + 1)
    simp [i] at hle
    omega
  rcases hlabels i with
    ⟨prev, hprev, hactive, hsource, hname⟩
  have hsegment := (hsources i).2
  have hlower :
      SettledLowerSourceNameEvent A run nodeName (t - 1) :=
    acceptingNodeNameStateReachableAt_predecessor_label_to_lowerSourceNameEvent
      A run (by simpa [t] using hevents i) hpos
      (by simpa [t] using hprev) hactive hsource hname
      (by simpa [t] using hsegment)
  exact hnoSmaller (t - 1) nodeName hNk hnodeLt hlower

/--
An accepting child/name/state reachability event at a positive time exposes the
