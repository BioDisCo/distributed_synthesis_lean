                (state ∈
                    (((live.1.stage1 A (word k)).stage2 A
                      (livePlan A live (word k)).stage2Plan).stage3 A).label
                      ((livePlan A live (word k)).stage2Plan.freshChild (root A)) ∨
                  ∃ ancestor older,
                    ((live.1.stage1 A (word k)).stage2 A
                        (livePlan A live (word k)).stage2Plan).IsAncestorOrSelf A
                      ancestor
                      ((livePlan A live (word k)).stage2Plan.freshChild (root A)) ∧
                    ((live.1.stage1 A (word k)).stage2 A
                        (livePlan A live (word k)).stage2Plan).OlderSibling A
                      older ancestor ∧
                    state ∈
                      ((live.1.stage1 A (word k)).stage2 A
                        (livePlan A live (word k)).stage2Plan).label older) := by
  intro n
  rcases automaton_run_frequently_root_stage2Trigger_of_accepts A haccepts n with
    ⟨k, hk, live, hrun, htrigger⟩
  rcases automaton_run_live_stage2Trigger_accepting_survives_or_routes
      A word hrun htrigger with
    ⟨state, haccepting, hreachable, hcases⟩
  exact ⟨k, hk, live, hrun, htrigger, state, haccepting, hreachable,
    hcases⟩

