theorem automaton_run_frequently_accepting_transition_frontier_of_runFrom
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (haccepting : run.Accepts) :
    ∀ n : Nat,
      ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            ∃ frontier,
              live.1.active frontier = true ∧
                live.1.IsAncestorOrSelf A (root A) frontier ∧
                  run.path k ∈ live.1.label frontier ∧
                    run.path k ∉ live.1.childLabelUnion A frontier ∧
                      A.accepting (run.path (k + 1)) ∧
                        frontier ∈
                          (live.1.stage1 A (word k)).stage2Triggers A := by
  intro n
  rcases haccepting (n + 1) with ⟨t, ht, htAccepting⟩
  let k : Nat := t - 1
  have htpos : 0 < t := by omega
  have ht_eq : t = k + 1 := by omega
  have hnle : n ≤ k := by omega
  rcases automaton_run_exists_live_root_label_of_runFrom A run k with
    ⟨live, hrun, hrootState⟩
  rcases live_exists_root_label_frontier A live hrootState with
    ⟨frontier, hfrontierActive, hancestor, hfrontierState,
      hfrontierPrivate⟩
  have hnextAccepting : A.accepting (run.path (k + 1)) := by
    simpa [ht_eq] using htAccepting
  have htrigger :
      frontier ∈ (live.1.stage1 A (word k)).stage2Triggers A :=
    automaton_run_frontier_stage2Trigger_of_next_accepting
      A run hfrontierActive hfrontierState hnextAccepting
  exact ⟨k, hnle, live, hrun, frontier, hfrontierActive, hancestor,
    hfrontierState, hfrontierPrivate, hnextAccepting, htrigger⟩

