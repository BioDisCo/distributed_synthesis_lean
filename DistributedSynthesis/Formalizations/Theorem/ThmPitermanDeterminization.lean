theorem exists_frequently_acceptingFrontierNameEvent_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    ∃ frontierName,
      frontierName ∈ Finset.range (Fintype.card A.State) ∧
        ∀ n : Nat,
          ∃ k : Nat, n ≤ k ∧
            AcceptingFrontierNameEvent A word frontierName k := by
  classical
  have hfreq :
      ∃ᶠ k in Filter.atTop,
        ∃ frontierName ∈ Finset.range (Fintype.card A.State),
          AcceptingFrontierNameEvent A word frontierName k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases automaton_run_frequently_accepting_frontier_of_accepts
        A haccepts n with
      ⟨k, hk, live, hrun, frontier, state, hfrontierActive, hancestor,
        hfrontierState, hfrontierPrivate, hfrontierAccepting⟩
    rcases acceptingFrontierNameEvent_exists_of_accepting_frontier A
        (k := k)
        ⟨live, hrun, frontier, state, hfrontierActive, hancestor,
          hfrontierState, hfrontierPrivate, hfrontierAccepting⟩ with
      ⟨frontierName, hfrontierNameMem, hnameEvent⟩
    exact ⟨k, hk, frontierName, hfrontierNameMem, hnameEvent⟩
  rw [Finset.frequently_exists] at hfreq
  rcases hfreq with ⟨frontierName, hfrontierNameMem, hnameFreq⟩
  refine ⟨frontierName, hfrontierNameMem, ?_⟩
  intro n
  exact (Filter.frequently_atTop).1 hnameFreq n

theorem automaton_accepts_acceptingFrontierNameEvent_cuts_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    ∃ frontierName,
      frontierName ∈ Finset.range (Fintype.card A.State) ∧
        ∃ cuts : Nat -> Nat,
          cuts 0 = 0 ∧
            (∀ i : Nat, cuts i < cuts (i + 1)) ∧
