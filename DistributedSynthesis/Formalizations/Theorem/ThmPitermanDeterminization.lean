theorem automaton_run_live_green_freshChild_accepting_reachable
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live : LiveState A}
    (hrun : (automaton A).run word n = some live)
    {parent : Node A}
    (hparent :
      parent ∈ (live.1.stage1 A (word n)).stage2Triggers A)
    (hgreen :
      parent ∈
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).greenNodes A)
    {state : A.State}
    (hstate :
      state ∈
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label
          ((livePlan A live (word n)).stage2Plan.freshChild parent)) :
    state ∈
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label parent ∧
      A.accepting state ∧
        ReachableAfter A A.initial word (n + 1) state := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  have hrootActiveLive : live.1.active (root A) = true := live.2.1
  have hrootActiveT1 : t1.active (root A) = true := by
    simpa [t1, stage1_active A live.1 (word n) (root A)] using
      hrootActiveLive
  have hsubset :
      (((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).stage3 A).label
          ((livePlan A live (word n)).stage2Plan.freshChild parent) ⊆
        (((live.1.stage1 A (word n)).stage2 A
