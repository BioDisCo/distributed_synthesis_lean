        (∀ i : Nat, ∀ state,
          state ∈ (frontierLive i).1.label (frontierNode i) ->
            ReachablePrefix A A.initial word
              (shiftedEventFrontierCuts cuts i) state) := by
  classical
  have hexists :
      ∀ i : Nat,
        ∃ pair : LiveState A × Node A,
          (automaton A).run word (shiftedEventFrontierCuts cuts i) =
            some pair.1 ∧
          pair.1.1.active pair.2 = true ∧
          (pair.1.1.name pair.2).val = recurrentName.val ∧
          (pair.1.1.label pair.2).Nonempty ∧
          ∀ state, state ∈ pair.1.1.label pair.2 ->
            ReachablePrefix A A.initial word
              (shiftedEventFrontierCuts cuts i) state := by
    intro i
    rcases hevents i with
      ⟨_hNk, prev, next, hprev, hnext, hnextName, green, _child, state,
        hgreen, _hchild, hgreenName, hgreenE, _hstateChild, hstateGreen,
        _hprefix, _htriggerSegment⟩
    rcases automaton_run_green_event_survives_to_next
        A word hprev hnext hnextName hgreen hgreenName hgreenE with
      ⟨hactiveNext, hnameNext⟩
    have hstateNext : state ∈ next.1.label green :=
      automaton_run_green_event_stage3_label_mem_next A word hprev hnext
        hnextName hgreen hgreenName hgreenE hstateGreen
