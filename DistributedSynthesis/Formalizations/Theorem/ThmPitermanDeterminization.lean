      ancestor = (livePlan A live (word n)).stage2Plan.freshChild green)
    (holder :
      ((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).OlderSibling A
        older ancestor)
    (holderState :
      acceptingState ∈
        ((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).label older) :
    acceptingState ∈
      ((live.1.stage1 A (word n)).stage2 A
        (livePlan A live (word n)).stage2Plan).label green := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  rcases live.2 with
    ⟨hrootActive, _hrootName, hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      hchildSubset, _hsiblingDisjoint⟩
  have holder' : t2.OlderSibling A older (plan.freshChild green) := by
    simpa [t1, plan, t2, hancestorFresh] using holder
  have holderState' : acceptingState ∈ t2.label older := by
    simpa [t1, plan, t2] using holderState
  by_cases hsame : older = green
  · simpa [t1, plan, t2, hsame] using holderState'
  · have hrootActive_t1 :
        t1.active (root A) = true := by
      simpa [t1, stage1_active A live.1 (word n) (root A)] using hrootActive
    have ht1RootParent : t1.parent (root A) = root A := by
      simpa [t1, stage1_parent A live.1 (word n) (root A)] using hrootParent
    have ht1ParentInvariant :
        ∀ node, t1.active node = true -> node ≠ root A ->
          t1.active (t1.parent node) = true ∧
            (t1.name (t1.parent node)).val < (t1.name node).val := by
      simpa [t1] using
        (stage1_preserves_parent_active_and_name_lt A live.1 (word n)
          hparentInvariant)
    have ht1ChildSubset :
        ∀ node child, child ∈ t1.children A node ->
          t1.label child ⊆ t1.label node := by
      simpa [t1] using
        (stage1_preserves_child_label_subset A live.1 (word n)
          hchildSubset)
    have ht2RootParent : t2.parent (root A) = root A := by
      simpa [t1, t2] using
        (stage2_root_parent A t1 plan hrootActive_t1).trans ht1RootParent
    have ht2ChildSubset :
        ∀ node child, child ∈ t2.children A node ->
          t2.label child ⊆ t2.label node := by
      simpa [t1, t2] using
        (stage2_preserves_child_label_subset A t1 plan ht1ParentInvariant
          ht1ChildSubset)
    have hparentOlder : t2.parent older = green := by
      have hsameParent :
          t2.parent older = t2.parent (plan.freshChild green) :=
        holder'.2.2.2.2.1
      rw [stage2_freshChild_parent A t1 plan (by simpa [t1] using htrigger)]
        at hsameParent
      exact hsameParent
    have hnotRoot : older ≠ root A := by
      intro hroot
      have hgreenRoot : green = root A := by
        have hparentOlder' := hparentOlder
        rw [hroot, ht2RootParent] at hparentOlder'
        exact hparentOlder'.symm
      exact hsame (hroot.trans hgreenRoot.symm)
    have hchild : older ∈ t2.children A green := by
      rw [children, Finset.mem_filter]
      exact ⟨Finset.mem_univ _, holder'.1, hnotRoot, hparentOlder⟩
    exact ht2ChildSubset green older hchild holderState'

theorem live_green_stage2Trigger_routed_freshChild_case_older_mem_children_stage2
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} (live : LiveState A)
    {green ancestor older : Node A}
    (htrigger :
      green ∈ (live.1.stage1 A (word n)).stage2Triggers A)
    (hancestorFresh :
      ancestor = (livePlan A live (word n)).stage2Plan.freshChild green)
    (holder :
      ((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).OlderSibling A
        older ancestor) :
    older ∈
      ((live.1.stage1 A (word n)).stage2 A
        (livePlan A live (word n)).stage2Plan).children A green := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  rcases live.2 with
    ⟨hrootActive, _hrootName, hrootParent, _hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have holder' : t2.OlderSibling A older (plan.freshChild green) := by
    simpa [t1, plan, t2, hancestorFresh] using holder
  have hrootActive_t1 :
      t1.active (root A) = true := by
    simpa [t1, stage1_active A live.1 (word n) (root A)] using hrootActive
  have ht1RootParent : t1.parent (root A) = root A := by
    simpa [t1, stage1_parent A live.1 (word n) (root A)] using hrootParent
  have ht2RootParent : t2.parent (root A) = root A := by
    simpa [t1, t2] using
      (stage2_root_parent A t1 plan hrootActive_t1).trans ht1RootParent
  have hparentOlder : t2.parent older = green := by
    have hsameParent :
        t2.parent older = t2.parent (plan.freshChild green) :=
      holder'.2.2.2.2.1
    rw [stage2_freshChild_parent A t1 plan (by simpa [t1] using htrigger)]
      at hsameParent
    exact hsameParent
  have hnotRoot : older ≠ root A := by
    intro hroot
    have hself : t2.parent older = older := by
      simpa [hroot] using ht2RootParent
    exact holder'.2.2.1 hself
  rw [children, Finset.mem_filter]
  exact ⟨Finset.mem_univ older, holder'.1, hnotRoot, hparentOlder⟩

theorem automaton_run_live_green_stage2Trigger_routed_accepting_segment_source_name_lt_freshChild
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live : LiveState A}
    (hrun : (automaton A).run word n = some live)
    {green : Node A}
    (htrigger :
      green ∈ (live.1.stage1 A (word n)).stage2Triggers A)
    {acceptingState : A.State}
    (hstateFresh :
      acceptingState ∈
        ((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).label
          ((livePlan A live (word n)).stage2Plan.freshChild green))
    (hnot :
      acceptingState ∉
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label
          ((livePlan A live (word n)).stage2Plan.freshChild green)) :
    ∃ sourceNode sourceState ancestor older,
      live.1.active sourceNode = true ∧
        sourceState ∈ live.1.label sourceNode ∧
        ReachableAfter A A.initial word n sourceState ∧
        SegmentVisitsAccepting A word n 1 sourceState acceptingState ∧
        ReachableAfter A A.initial word (n + 1) acceptingState ∧
        ((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).IsAncestorOrSelf A
          ancestor
          ((livePlan A live (word n)).stage2Plan.freshChild green) ∧
        ((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).OlderSibling A older ancestor ∧
        acceptingState ∈
          ((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).label older ∧
        (live.1.name sourceNode).val <
          (((live.1.stage1 A (word n)).stage2 A
              (livePlan A live (word n)).stage2Plan).name
            ((livePlan A live (word n)).stage2Plan.freshChild green)).val := by
  rcases live_green_stage2Trigger_routed_accepting_segment_source_name_lt_freshChild
      A word live htrigger hstateFresh hnot with
    ⟨sourceNode, sourceState, ancestor, older, hsourceActive, hsourceState,
      hsegment, hancestor, holder, holderState, hsourceNameLt⟩
  have hsourceReachable :
      ReachableAfter A A.initial word n sourceState :=
    automaton_run_live_active_label_reachable A word hrun hsourceActive
      hsourceState
  have htargetReachable :
      ReachableAfter A A.initial word (n + 1) acceptingState :=
    reachableAfter_of_segmentVisitsAccepting A A.initial word
      hsourceReachable hsegment
  exact ⟨sourceNode, sourceState, ancestor, older, hsourceActive, hsourceState,
    hsourceReachable, hsegment, htargetReachable, hancestor, holder,
    holderState, hsourceNameLt⟩

theorem automaton_run_live_root_stage2Trigger_accepting_survives_or_lower
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live : LiveState A}
    (hrun : (automaton A).run word n = some live)
    (htrigger :
      root A ∈ (live.1.stage1 A (word n)).stage2Triggers A) :
    ∃ acceptingState,
      A.accepting acceptingState ∧
        ReachableAfter A A.initial word (n + 1) acceptingState ∧
        (acceptingState ∈
            (((live.1.stage1 A (word n)).stage2 A
              (livePlan A live (word n)).stage2Plan).stage3 A).label
              ((livePlan A live (word n)).stage2Plan.freshChild (root A)) ∨
          ∃ sourceNode sourceState ancestor older,
            live.1.active sourceNode = true ∧
              sourceState ∈ live.1.label sourceNode ∧
              ReachableAfter A A.initial word n sourceState ∧
              SegmentVisitsAccepting A word n 1 sourceState acceptingState ∧
              ((live.1.stage1 A (word n)).stage2 A
                  (livePlan A live (word n)).stage2Plan).IsAncestorOrSelf A
                ancestor
                ((livePlan A live (word n)).stage2Plan.freshChild (root A)) ∧
              ((live.1.stage1 A (word n)).stage2 A
                  (livePlan A live (word n)).stage2Plan).OlderSibling A
                older ancestor ∧
              acceptingState ∈
                ((live.1.stage1 A (word n)).stage2 A
                  (livePlan A live (word n)).stage2Plan).label older ∧
              (live.1.name sourceNode).val <
                (((live.1.stage1 A (word n)).stage2 A
                    (livePlan A live (word n)).stage2Plan).name
                  ((livePlan A live (word n)).stage2Plan.freshChild
                    (root A))).val) := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases exists_accepting_label_of_stage2Trigger A t1
      (by simpa [t1] using htrigger) with
    ⟨acceptingState, hstateRoot, haccepting⟩
  have hstateFresh :
      acceptingState ∈ t2.label (plan.freshChild (root A)) := by
    rw [stage2_freshChild_label A t1 plan (by simpa [t1] using htrigger)]
    rw [mem_acceptingPart A t1]
    exact ⟨hstateRoot, haccepting⟩
  by_cases hsurvives : acceptingState ∈ t3.label (plan.freshChild (root A))
  · have hwitness :=
      automaton_run_live_stage3_freshChild_accepting_reachable A word hrun
        htrigger (by simpa [t1, plan, t2, t3] using hsurvives)
    exact ⟨acceptingState, hwitness.1, hwitness.2,
      Or.inl (by simpa [t1, plan, t2, t3] using hsurvives)⟩
  · rcases
      automaton_run_live_green_stage2Trigger_routed_accepting_segment_source_name_lt_freshChild
        A word hrun htrigger
        (by simpa [t1, plan, t2] using hstateFresh)
        (by simpa [t1, plan, t2, t3] using hsurvives) with
      ⟨sourceNode, sourceState, ancestor, older, hsourceActive,
        hsourceState, hsourceReachable, hsegment, htargetReachable,
        hancestor, holder, holderState, hsourceNameLt⟩
    exact ⟨acceptingState, haccepting, htargetReachable,
      Or.inr ⟨sourceNode, sourceState, ancestor, older, hsourceActive,
        hsourceState, hsourceReachable, hsegment,
        by simpa [t1, plan, t2] using hancestor,
        by simpa [t1, plan, t2] using holder,
        by simpa [t1, plan, t2] using holderState,
        by simpa [t1, plan, t2] using hsourceNameLt⟩⟩

/--
Root trigger, routed in the tree rather than by name: the accepting state either
survives in the root's fresh child at stage (3), or it is already carried by a
genuine root child in the stage-(2) tree.  This is the local post-fix fact needed
to keep the descent inside real sons of the root.
-/
theorem automaton_run_live_root_stage2Trigger_accepting_survives_or_root_child
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live : LiveState A}
    (hrun : (automaton A).run word n = some live)
    (htrigger :
      root A ∈ (live.1.stage1 A (word n)).stage2Triggers A) :
    ∃ acceptingState,
      A.accepting acceptingState ∧
        ReachableAfter A A.initial word (n + 1) acceptingState ∧
        (acceptingState ∈
            (((live.1.stage1 A (word n)).stage2 A
              (livePlan A live (word n)).stage2Plan).stage3 A).label
              ((livePlan A live (word n)).stage2Plan.freshChild (root A)) ∨
          ∃ rootChild,
            rootChild ∈
              ((live.1.stage1 A (word n)).stage2 A
                (livePlan A live (word n)).stage2Plan).children A (root A) ∧
            acceptingState ∈
              ((live.1.stage1 A (word n)).stage2 A
                (livePlan A live (word n)).stage2Plan).label rootChild) := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases exists_accepting_label_of_stage2Trigger A t1
      (by simpa [t1] using htrigger) with
    ⟨acceptingState, hstateRoot, haccepting⟩
  have hstateFresh :
      acceptingState ∈ t2.label (plan.freshChild (root A)) := by
    rw [stage2_freshChild_label A t1 plan (by simpa [t1] using htrigger)]
    rw [mem_acceptingPart A t1]
    exact ⟨hstateRoot, haccepting⟩
  by_cases hsurvives : acceptingState ∈ t3.label (plan.freshChild (root A))
  · have hwitness :=
      automaton_run_live_stage3_freshChild_accepting_reachable A word hrun
        htrigger (by simpa [t1, plan, t2, t3] using hsurvives)
    exact ⟨acceptingState, hwitness.1, hwitness.2,
      Or.inl (by simpa [t1, plan, t2, t3] using hsurvives)⟩
  · rcases live.2 with
      ⟨hrootActive, hrootName, hrootParent, _hparentInvariant,
        _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
        _hchildSubset, _hsiblingDisjoint⟩
    have hrootActive_t1 : t1.active (root A) = true := by
      simpa [t1, stage1_active A live.1 (word n) (root A)] using hrootActive
    have hrootName_t1 : (t1.name (root A)).val = (rootName A).val := by
      simpa [t1, stage1_name A live.1 (word n) (root A)] using hrootName
    have hrootParent_t1 : t1.parent (root A) = root A := by
      simpa [t1, stage1_parent A live.1 (word n) (root A)] using hrootParent
    rcases stage2_stage3_removed_root_freshChild_blocked_by_root_child
        A t1 plan hrootActive_t1 hrootName_t1 hrootParent_t1
        (by simpa [t1] using htrigger)
        (by simpa [t1, plan, t2] using hstateFresh)
        (by simpa [t1, plan, t2, t3] using hsurvives) with
      ⟨rootChild, hrootChild, _holder, hrootChildState, _haccepting'⟩
    have hrootChildActive_t2 : t2.active rootChild = true := by
      rw [children, Finset.mem_filter] at hrootChild
      exact hrootChild.2.1
    have hreachable :
        ReachableAfter A A.initial word (n + 1) acceptingState :=
      automaton_run_live_stage2_active_label_reachable A word hrun
        (by simpa [t1, plan, t2] using hrootChildActive_t2)
        (by simpa [t1, plan, t2] using hrootChildState)
    exact ⟨acceptingState, haccepting, hreachable,
      Or.inr ⟨rootChild,
        by simpa [t1, plan, t2] using hrootChild,
        by simpa [t1, plan, t2] using hrootChildState⟩⟩

theorem automaton_run_frequently_root_stage2Trigger_survives_or_lower_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    ∀ n : Nat,
      ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            root A ∈ (live.1.stage1 A (word k)).stage2Triggers A ∧
            ∃ acceptingState,
              A.accepting acceptingState ∧
                ReachableAfter A A.initial word (k + 1) acceptingState ∧
                (acceptingState ∈
                    (((live.1.stage1 A (word k)).stage2 A
                      (livePlan A live (word k)).stage2Plan).stage3 A).label
                      ((livePlan A live (word k)).stage2Plan.freshChild
                        (root A)) ∨
                  ∃ sourceNode sourceState ancestor older,
                    live.1.active sourceNode = true ∧
                      sourceState ∈ live.1.label sourceNode ∧
                      ReachableAfter A A.initial word k sourceState ∧
                      SegmentVisitsAccepting A word k 1 sourceState
                        acceptingState ∧
                      ((live.1.stage1 A (word k)).stage2 A
                          (livePlan A live (word k)).stage2Plan).IsAncestorOrSelf A
                        ancestor
                        ((livePlan A live (word k)).stage2Plan.freshChild
                          (root A)) ∧
                      ((live.1.stage1 A (word k)).stage2 A
                          (livePlan A live (word k)).stage2Plan).OlderSibling A
                        older ancestor ∧
                      acceptingState ∈
                        ((live.1.stage1 A (word k)).stage2 A
                          (livePlan A live (word k)).stage2Plan).label older ∧
                      (live.1.name sourceNode).val <
                        (((live.1.stage1 A (word k)).stage2 A
                            (livePlan A live (word k)).stage2Plan).name
                          ((livePlan A live (word k)).stage2Plan.freshChild
                            (root A))).val) := by
  intro n
  rcases automaton_run_frequently_root_stage2Trigger_of_accepts A haccepts n with
    ⟨k, hk, live, hrun, htrigger⟩
  rcases automaton_run_live_root_stage2Trigger_accepting_survives_or_lower
      A word hrun htrigger with
    ⟨acceptingState, haccepting, hreachable, hcases⟩
  exact ⟨k, hk, live, hrun, htrigger, acceptingState, haccepting,
    hreachable, hcases⟩

/--
Root-level measured event used in the NBW-to-DPW direction.

At time `k`, the accepting NBW run has forced a root stage-(2) trigger.  The
fresh accepting copy either survives stage (3), or the construction already
routes a one-letter Büchi segment through an older sibling whose live source
name is strictly smaller than the fresh child's temporary name.  This is the
local event that the remaining finite-name descent will iterate.
-/
def RootStage2MeasuredEvent [DecidableEq A.State]
    (word : OmegaWord Alphabet) (k : Nat) : Prop :=
  ∃ live : LiveState A,
    (automaton A).run word k = some live ∧
      root A ∈ (live.1.stage1 A (word k)).stage2Triggers A ∧
      ∃ acceptingState,
        A.accepting acceptingState ∧
          ReachableAfter A A.initial word (k + 1) acceptingState ∧
          (acceptingState ∈
              (((live.1.stage1 A (word k)).stage2 A
                (livePlan A live (word k)).stage2Plan).stage3 A).label
                ((livePlan A live (word k)).stage2Plan.freshChild
                  (root A)) ∨
            ∃ sourceNode sourceState ancestor older,
              live.1.active sourceNode = true ∧
                sourceState ∈ live.1.label sourceNode ∧
                ReachableAfter A A.initial word k sourceState ∧
                SegmentVisitsAccepting A word k 1 sourceState
                  acceptingState ∧
                ((live.1.stage1 A (word k)).stage2 A
                    (livePlan A live (word k)).stage2Plan).IsAncestorOrSelf A
                  ancestor
                  ((livePlan A live (word k)).stage2Plan.freshChild
                    (root A)) ∧
                ((live.1.stage1 A (word k)).stage2 A
                    (livePlan A live (word k)).stage2Plan).OlderSibling A
                  older ancestor ∧
                acceptingState ∈
                  ((live.1.stage1 A (word k)).stage2 A
                    (livePlan A live (word k)).stage2Plan).label older ∧
                (live.1.name sourceNode).val <
                  (((live.1.stage1 A (word k)).stage2 A
                      (livePlan A live (word k)).stage2Plan).name
                    ((livePlan A live (word k)).stage2Plan.freshChild
                      (root A))).val)

def RootStage2SurvivesEvent [DecidableEq A.State]
    (word : OmegaWord Alphabet) (k : Nat) : Prop :=
  ∃ live : LiveState A,
    (automaton A).run word k = some live ∧
      root A ∈ (live.1.stage1 A (word k)).stage2Triggers A ∧
      ∃ acceptingState,
        A.accepting acceptingState ∧
          ReachableAfter A A.initial word (k + 1) acceptingState ∧
          acceptingState ∈
            (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).stage3 A).label
              ((livePlan A live (word k)).stage2Plan.freshChild (root A))

def RootStage2LowerEvent [DecidableEq A.State]
    (word : OmegaWord Alphabet) (k : Nat) : Prop :=
  ∃ live : LiveState A,
    (automaton A).run word k = some live ∧
      root A ∈ (live.1.stage1 A (word k)).stage2Triggers A ∧
      ∃ acceptingState,
        A.accepting acceptingState ∧
          ReachableAfter A A.initial word (k + 1) acceptingState ∧
          ∃ sourceNode sourceState ancestor older,
            live.1.active sourceNode = true ∧
              sourceState ∈ live.1.label sourceNode ∧
              ReachableAfter A A.initial word k sourceState ∧
              SegmentVisitsAccepting A word k 1 sourceState acceptingState ∧
              ((live.1.stage1 A (word k)).stage2 A
                  (livePlan A live (word k)).stage2Plan).IsAncestorOrSelf A
                ancestor
                ((livePlan A live (word k)).stage2Plan.freshChild
                  (root A)) ∧
              ((live.1.stage1 A (word k)).stage2 A
                  (livePlan A live (word k)).stage2Plan).OlderSibling A
                older ancestor ∧
              acceptingState ∈
                ((live.1.stage1 A (word k)).stage2 A
                  (livePlan A live (word k)).stage2Plan).label older ∧
              (live.1.name sourceNode).val <
                (((live.1.stage1 A (word k)).stage2 A
                    (livePlan A live (word k)).stage2Plan).name
                  ((livePlan A live (word k)).stage2Plan.freshChild
                    (root A))).val

def RootStage2LowerNameEvent [DecidableEq A.State]
    (word : OmegaWord Alphabet) (sourceName : Nat) (k : Nat) : Prop :=
  ∃ live : LiveState A,
    (automaton A).run word k = some live ∧
      root A ∈ (live.1.stage1 A (word k)).stage2Triggers A ∧
      ∃ acceptingState,
        A.accepting acceptingState ∧
          ReachableAfter A A.initial word (k + 1) acceptingState ∧
          ∃ sourceNode sourceState ancestor older,
            live.1.active sourceNode = true ∧
              (live.1.name sourceNode).val = sourceName ∧
              sourceState ∈ live.1.label sourceNode ∧
              ReachableAfter A A.initial word k sourceState ∧
              SegmentVisitsAccepting A word k 1 sourceState acceptingState ∧
              ((live.1.stage1 A (word k)).stage2 A
                  (livePlan A live (word k)).stage2Plan).IsAncestorOrSelf A
                ancestor
                ((livePlan A live (word k)).stage2Plan.freshChild
                  (root A)) ∧
              ((live.1.stage1 A (word k)).stage2 A
                  (livePlan A live (word k)).stage2Plan).OlderSibling A
                older ancestor ∧
              acceptingState ∈
                ((live.1.stage1 A (word k)).stage2 A
                  (livePlan A live (word k)).stage2Plan).label older ∧
              (live.1.name sourceNode).val <
                (((live.1.stage1 A (word k)).stage2 A
                    (livePlan A live (word k)).stage2Plan).name
                  ((livePlan A live (word k)).stage2Plan.freshChild
                    (root A))).val

theorem rootStage2LowerEvent_exists_sourceName
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {k : Nat}
    (hevent : RootStage2LowerEvent A word k) :
    ∃ sourceName,
      sourceName ∈ Finset.range (Fintype.card A.State) ∧
        RootStage2LowerNameEvent A word sourceName k := by
  rcases hevent with
    ⟨live, hrun, htrigger, acceptingState, haccepting, hreachable,
      sourceNode, sourceState, ancestor, older, hsourceActive, hsourceState,
      hsourceReachable, hsegment, hancestor, holder, holderState,
      hsourceNameLt⟩
  let sourceName : Nat := (live.1.name sourceNode).val
  have hsourceNameMem :
      sourceName ∈ Finset.range (Fintype.card A.State) := by
    rcases live.2 with
      ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
        _hinactiveLabel, hbound, _hinjective, _hconsecutive, _hproper,
        _hchildSubset, _hsiblingDisjoint⟩
    exact Finset.mem_range.mpr
      (by simpa [sourceName] using hbound sourceNode hsourceActive)
  exact ⟨sourceName, hsourceNameMem, live, hrun, htrigger, acceptingState,
    haccepting, hreachable, sourceNode, sourceState, ancestor, older,
    hsourceActive, rfl, hsourceState, hsourceReachable, hsegment,
    hancestor, holder, holderState, hsourceNameLt⟩

theorem rootStage2LowerEvent_of_lowerNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {k sourceName : Nat}
    (hevent : RootStage2LowerNameEvent A word sourceName k) :
    RootStage2LowerEvent A word k := by
  rcases hevent with
    ⟨live, hrun, htrigger, acceptingState, haccepting, hreachable,
      sourceNode, sourceState, ancestor, older, hsourceActive, _hsourceName,
      hsourceState, hsourceReachable, hsegment, hancestor, holder,
      holderState, hsourceNameLt⟩
  exact ⟨live, hrun, htrigger, acceptingState, haccepting, hreachable,
    sourceNode, sourceState, ancestor, older, hsourceActive, hsourceState,
    hsourceReachable, hsegment, hancestor, holder, holderState,
    hsourceNameLt⟩

theorem rootStage2LowerNameEvent_witness
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {k sourceName : Nat}
    (hevent : RootStage2LowerNameEvent A word sourceName k) :
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        root A ∈ (live.1.stage1 A (word k)).stage2Triggers A ∧
        ∃ acceptingState sourceNode sourceState,
          A.accepting acceptingState ∧
            live.1.active sourceNode = true ∧
            (live.1.name sourceNode).val = sourceName ∧
            sourceState ∈ live.1.label sourceNode ∧
            ReachableAfter A A.initial word k sourceState ∧
            SegmentVisitsAccepting A word k 1 sourceState acceptingState ∧
            ReachableAfter A A.initial word (k + 1) acceptingState ∧
            sourceName <
              (((live.1.stage1 A (word k)).stage2 A
                  (livePlan A live (word k)).stage2Plan).name
                ((livePlan A live (word k)).stage2Plan.freshChild
                  (root A))).val := by
  rcases hevent with
    ⟨live, hrun, htrigger, acceptingState, haccepting, hreachable,
      sourceNode, sourceState, ancestor, older, hsourceActive, hsourceName,
      hsourceState, hsourceReachable, hsegment, _hancestor, _holder,
      _holderState, hsourceNameLt⟩
  refine ⟨live, hrun, htrigger, acceptingState, sourceNode, sourceState,
    haccepting, hsourceActive, hsourceName, hsourceState, hsourceReachable,
    hsegment, hreachable, ?_⟩
  simpa [hsourceName] using hsourceNameLt

theorem rootStage2MeasuredEvent_iff_survives_or_lower
    [DecidableEq A.State]
    (word : OmegaWord Alphabet) (k : Nat) :
    RootStage2MeasuredEvent A word k ↔
      RootStage2SurvivesEvent A word k ∨
        RootStage2LowerEvent A word k := by
  constructor
  · intro hevent
    rcases hevent with
      ⟨live, hrun, htrigger, acceptingState, haccepting, hreachable,
        hcase⟩
    rcases hcase with hsurvives | hlower
    · exact Or.inl
        ⟨live, hrun, htrigger, acceptingState, haccepting, hreachable,
          hsurvives⟩
    · exact Or.inr
        ⟨live, hrun, htrigger, acceptingState, haccepting, hreachable,
          hlower⟩
  · intro hcase
    rcases hcase with hsurvives | hlower
    · rcases hsurvives with
        ⟨live, hrun, htrigger, acceptingState, haccepting, hreachable,
          hsurvives⟩
      exact ⟨live, hrun, htrigger, acceptingState, haccepting, hreachable,
        Or.inl hsurvives⟩
    · rcases hlower with
        ⟨live, hrun, htrigger, acceptingState, haccepting, hreachable,
          hlower⟩
      exact ⟨live, hrun, htrigger, acceptingState, haccepting, hreachable,
        Or.inr hlower⟩

theorem rootStage2MeasuredEvent_of_run_live_root_stage2Trigger
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {k : Nat} {live : LiveState A}
    (hrun : (automaton A).run word k = some live)
    (htrigger :
      root A ∈ (live.1.stage1 A (word k)).stage2Triggers A) :
    RootStage2MeasuredEvent A word k := by
  rcases automaton_run_live_root_stage2Trigger_accepting_survives_or_lower
      A word hrun htrigger with
    ⟨acceptingState, haccepting, hreachable, hcases⟩
  exact ⟨live, hrun, htrigger, acceptingState, haccepting, hreachable,
    hcases⟩

theorem automaton_run_frequently_rootStage2MeasuredEvent_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    ∀ n : Nat, ∃ k : Nat, n ≤ k ∧ RootStage2MeasuredEvent A word k := by
  intro n
  rcases automaton_run_frequently_root_stage2Trigger_of_accepts A haccepts n
      with ⟨k, hk, live, hrun, htrigger⟩
  exact ⟨k, hk,
    rootStage2MeasuredEvent_of_run_live_root_stage2Trigger A word hrun
      htrigger⟩

theorem automaton_accepts_rootStage2MeasuredEvent_cuts_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    ∃ cuts : Nat -> Nat,
      cuts 0 = 0 ∧
        (∀ i : Nat, cuts i < cuts (i + 1)) ∧
          ∀ i : Nat,
            RootStage2MeasuredEvent A word (cuts (i + 1)) := by
  exact exists_strict_cuts_from_zero_of_frequently_at_or_after
    (automaton_run_frequently_rootStage2MeasuredEvent_of_accepts A haccepts)

theorem automaton_accepts_frequently_rootStage2Survives_or_lower_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    (∀ n : Nat,
      ∃ k : Nat, n ≤ k ∧ RootStage2SurvivesEvent A word k) ∨
      (∀ n : Nat,
        ∃ k : Nat, n ≤ k ∧ RootStage2LowerEvent A word k) := by
  apply frequently_left_or_right_of_frequently_or
  intro n
  rcases automaton_run_frequently_rootStage2MeasuredEvent_of_accepts
      A haccepts n with
    ⟨k, hk, hevent⟩
  exact ⟨k, hk,
    (rootStage2MeasuredEvent_iff_survives_or_lower A word k).mp hevent⟩

theorem automaton_accepts_rootStage2Survives_or_lower_cuts_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    (∃ cuts : Nat -> Nat,
      cuts 0 = 0 ∧
        (∀ i : Nat, cuts i < cuts (i + 1)) ∧
          ∀ i : Nat,
            RootStage2SurvivesEvent A word (cuts (i + 1))) ∨
      (∃ cuts : Nat -> Nat,
        cuts 0 = 0 ∧
          (∀ i : Nat, cuts i < cuts (i + 1)) ∧
            ∀ i : Nat,
              RootStage2LowerEvent A word (cuts (i + 1))) := by
  rcases automaton_accepts_frequently_rootStage2Survives_or_lower_of_accepts
      A haccepts with hsurvives | hlower
  · exact Or.inl
      (exists_strict_cuts_from_zero_of_frequently_at_or_after hsurvives)
  · exact Or.inr
      (exists_strict_cuts_from_zero_of_frequently_at_or_after hlower)

theorem exists_frequently_rootStage2LowerNameEvent_of_frequently_lower
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (hlower :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧ RootStage2LowerEvent A word k) :
    ∃ sourceName,
      sourceName ∈ Finset.range (Fintype.card A.State) ∧
        ∀ n : Nat,
          ∃ k : Nat, n ≤ k ∧
            RootStage2LowerNameEvent A word sourceName k := by
  classical
  have hfreq :
      ∃ᶠ k in Filter.atTop,
        ∃ sourceName ∈ Finset.range (Fintype.card A.State),
          RootStage2LowerNameEvent A word sourceName k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hlower n with ⟨k, hk, hevent⟩
    rcases rootStage2LowerEvent_exists_sourceName A hevent with
      ⟨sourceName, hsourceNameMem, hnameEvent⟩
    exact ⟨k, hk, sourceName, hsourceNameMem, hnameEvent⟩
  rw [Finset.frequently_exists] at hfreq
  rcases hfreq with ⟨sourceName, hsourceNameMem, hsourceNameFreq⟩
  refine ⟨sourceName, hsourceNameMem, ?_⟩
  intro n
  exact (Filter.frequently_atTop).1 hsourceNameFreq n

theorem automaton_accepts_rootStage2Survives_or_lowerName_cuts_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    (∃ cuts : Nat -> Nat,
      cuts 0 = 0 ∧
        (∀ i : Nat, cuts i < cuts (i + 1)) ∧
          ∀ i : Nat,
            RootStage2SurvivesEvent A word (cuts (i + 1))) ∨
      (∃ sourceName,
        sourceName ∈ Finset.range (Fintype.card A.State) ∧
          ∃ cuts : Nat -> Nat,
            cuts 0 = 0 ∧
              (∀ i : Nat, cuts i < cuts (i + 1)) ∧
                ∀ i : Nat,
                  RootStage2LowerNameEvent A word sourceName
                    (cuts (i + 1))) := by
  rcases automaton_accepts_frequently_rootStage2Survives_or_lower_of_accepts
      A haccepts with hsurvives | hlower
  · exact Or.inl
      (exists_strict_cuts_from_zero_of_frequently_at_or_after hsurvives)
  · rcases exists_frequently_rootStage2LowerNameEvent_of_frequently_lower
        A hlower with
      ⟨sourceName, hsourceNameMem, hfreqName⟩
    exact Or.inr
      ⟨sourceName, hsourceNameMem,
        exists_strict_cuts_from_zero_of_frequently_at_or_after hfreqName⟩

theorem live_green_stage2Trigger_routed_accepting_segment_split
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} (live : LiveState A)
    {green : Node A}
    (htrigger :
      green ∈ (live.1.stage1 A (word n)).stage2Triggers A)
    (hgreenActive :
      (((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).active green) = true)
    {acceptingState : A.State}
    (hstateFresh :
      acceptingState ∈
        ((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).label
          ((livePlan A live (word n)).stage2Plan.freshChild green))
    (hnot :
      acceptingState ∉
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label
          ((livePlan A live (word n)).stage2Plan.freshChild green)) :
    ∃ sourceNode sourceState ancestor older,
      live.1.active sourceNode = true ∧
        sourceState ∈ live.1.label sourceNode ∧
        SegmentVisitsAccepting A word n 1 sourceState acceptingState ∧
        ((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).IsAncestorOrSelf A
          ancestor
          ((livePlan A live (word n)).stage2Plan.freshChild green) ∧
        ((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).OlderSibling A older ancestor ∧
        acceptingState ∈
          ((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).label older ∧
        (ancestor = (livePlan A live (word n)).stage2Plan.freshChild green ∨
          (live.1.name sourceNode).val <
            (((live.1.stage1 A (word n)).stage2 A
              (livePlan A live (word n)).stage2Plan).name green).val) := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  rcases stage2_stage3_removed_freshChild_blocked_by_older A t1 plan
      (by simpa [t1] using htrigger)
      (by simpa [t1, plan, t2] using hstateFresh)
      (by simpa [t1, plan, t2] using hnot) with
    ⟨ancestor, older, hancestor, holder, holderState, haccepting⟩
  rcases stage1_stage2_active_label_segment_from_source_name_le
      A live.1 word plan (olderSibling_older_active A t2 holder)
      holderState with
    ⟨sourceNode, sourceState, hsourceActive, hsourceState, hsegment,
      hsourceNameLeOlder⟩
  have hcases :=
    stage2_isAncestorOrSelf_freshChild_cases A t1 plan
      (by simpa [t1] using htrigger) hancestor
  have hsplit :
      ancestor = plan.freshChild green ∨
        (live.1.name sourceNode).val < (t2.name green).val := by
    rcases hcases with hsame | habove
    · exact Or.inl hsame
    · exact Or.inr
        (live_green_stage2Trigger_routed_accepting_segment_source_name_lt_green_of_above
          A word live
          (green := green) (ancestor := ancestor) (older := older)
          (sourceNode := sourceNode)
          (by simpa [t1, plan, t2] using habove)
          (by simpa [t1, plan, t2] using holder)
          (by simpa [t1, plan, t2] using hsourceNameLeOlder)
          (by simpa [t1, plan, t2] using hgreenActive))
  exact ⟨sourceNode, sourceState, ancestor, older,
    by simpa [stage1] using hsourceActive, hsourceState,
    segmentVisitsAccepting_of_segment_accepting_target A word hsegment
      haccepting,
    by simpa [t1, plan, t2] using hancestor,
    by simpa [t1, plan, t2] using holder,
    by simpa [t1, plan, t2] using holderState,
    by simpa [t1, plan, t2] using hsplit⟩

theorem live_green_stage2Trigger_routed_accepting_segment_green_stage2_or_lower
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} (live : LiveState A)
    {green : Node A}
    (htrigger :
      green ∈ (live.1.stage1 A (word n)).stage2Triggers A)
    (hgreenActive :
      (((live.1.stage1 A (word n)).stage2 A
