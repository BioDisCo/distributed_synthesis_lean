/--
One-step paper fork for the remaining source-persistence case.  At a late
accepting cut whose selected source name is below the minimal lower-source
threshold `m`, the construction has only four possibilities:

* the same node was already active with the same selected name in the
  predecessor tree;
* the node was freshly created from a concrete predecessor parent, giving a
  lower-source parent event whose old name is forced to be at least `m`;
* stage (6)'s drop was caused by stage-(4) green removal, exposing an actual
  green node below `m`;
* stage (6)'s drop was caused by stage-(5) empty removal, exposing an active
  empty node below `m`.

This is the local Lean version of Piterman's finite stabilization argument:
below the cutoff, silent name movement is impossible; every non-stable move has
a construction cause.
-/
theorem acceptingNodeNameStateAt_late_prev_stable_or_fresh_parent_or_green_or_empty_below
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m N : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hnodeLt : nodeName < m)
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ t - 1)
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev) :
    (prev.1.active v = true ∧ (prev.1.name v).val = nodeName) ∨
      (∃ parent sourceState,
        parent ∈ (prev.1.stage1 A (word (t - 1))).stage2Triggers A ∧
          (livePlan A prev (word (t - 1))).stage2Plan.freshChild parent = v ∧
          m ≤ (prev.1.name parent).val ∧
          SettledLowerSourceNodeNameStateTargetEvent A run parent
            (prev.1.name parent).val sourceState target (t - 1)) ∨
      (let t1 := prev.1.stage1 A (word (t - 1))
       let plan := (livePlan A prev (word (t - 1))).stage2Plan
       let t2 := t1.stage2 A plan
       let t3 := t2.stage3 A
       ∃ old green,
        old ∈ t3.greenRemovedNodes A ∧
          green ∈ t3.greenNodes A ∧
          (t3.name green).val < m) ∨
      (let t1 := prev.1.stage1 A (word (t - 1))
       let plan := (livePlan A prev (word (t - 1))).stage2Plan
       let t2 := t1.stage2 A plan
       let t3 := t2.stage3 A
       let t4 := t3.stage4 A
       let t5 := t4.stage5 A (t3.greenRemovedNodes A)
       ∃ old,
        t4.active old = true ∧
          t4.label old = ∅ ∧
          (t5.name old).val < m) := by
  let t1 := prev.1.stage1 A (word (t - 1))
  let plan := (livePlan A prev (word (t - 1))).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let t5 := t4.stage5 A (t3.greenRemovedNodes A)
  cases hactive : prev.1.active v
  · rcases
        acceptingNodeNameStateAt_prev_inactive_fresh_parent_name_ge_of_no_smaller
          A run hnoSmaller hNk hevent hpos hprev hactive with
      ⟨parent, sourceState, htrigger, hfresh, hparentNameGe,
        hlowerTarget⟩
    exact Or.inr <| Or.inl
      ⟨parent, sourceState, htrigger, hfresh, hparentNameGe,
        hlowerTarget⟩
  · have hactiveTrue : prev.1.active v = true := hactive
    rcases
        acceptingNodeNameStateAt_prev_active_same_or_name_decreases
          A run hevent hpos hprev hactiveTrue with
      hsame | hdrop
    · exact Or.inl ⟨rfl, hsame⟩
    · rcases
          acceptingNodeNameStateAt_prev_active_name_threshold_drop_green_or_empty_removed_before_of_no_smaller
            A run hnoSmaller hNk hevent hpos hprev hactiveTrue hnodeLt with
        ⟨_hcarrierGe, hsplit⟩
      rcases hsplit with hgreenRemoved | hemptyRemoved
      · have hgreenPayload :
            let t1 := prev.1.stage1 A (word (t - 1))
            let plan := (livePlan A prev (word (t - 1))).stage2Plan
            let t2 := t1.stage2 A plan
            let t3 := t2.stage3 A
            ∃ old green,
              old ∈ t3.greenRemovedNodes A ∧
                green ∈ t3.greenNodes A ∧
                (t3.name green).val < m :=
          acceptingNodeNameStateAt_prev_active_name_threshold_drop_green_removed_before_green_witness
            A run hevent hpos hprev hactiveTrue hgreenRemoved
        exact Or.inr <| Or.inr <| Or.inl
          (by simpa [t1, plan, t2, t3] using hgreenPayload)
      · have hemptyPayload :
            let t1 := prev.1.stage1 A (word (t - 1))
            let plan := (livePlan A prev (word (t - 1))).stage2Plan
            let t2 := t1.stage2 A plan
            let t3 := t2.stage3 A
            let t4 := t3.stage4 A
            let t5 := t4.stage5 A (t3.greenRemovedNodes A)
            ∃ old,
              t4.active old = true ∧
                t4.label old = ∅ ∧
                (t5.name old).val < m :=
          acceptingNodeNameStateAt_prev_active_name_threshold_drop_empty_removed_before_payload
            A run hevent hpos hprev hactiveTrue hemptyRemoved
        exact Or.inr <| Or.inr <| Or.inr
          (by simpa [t1, plan, t2, t3, t4, t5] using hemptyPayload)

/--
Stable predecessor branch at a non-accepting accepting-source cut.  This is the
good stabilization case: the selected source node/name was already present in
the previous live tree.
-/
def AcceptingNodeNameStatePrevStableNonacceptingAt [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v : Node A)
    (nodeName : Nat) (target : A.State) (t : Nat) : Prop :=
  AcceptingNodeNameStateAt A run v nodeName target t ∧
    ¬ A.accepting (run.path (t + 1)) ∧
      ∃ prev : LiveState A,
        (automaton A).run word (t - 1) = some prev ∧
          prev.1.active v = true ∧
          (prev.1.name v).val = nodeName

/--
Fresh-parent branch at a non-accepting accepting-source cut.  The selected
source was freshly created from a concrete predecessor parent, and after the
no-smaller cutoff that parent's old name is at least the ambient threshold `m`.
-/
def AcceptingNodeNameStateFreshParentNonacceptingAt [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v : Node A)
    (nodeName m : Nat) (target : A.State) (t : Nat) : Prop :=
  AcceptingNodeNameStateAt A run v nodeName target t ∧
    ¬ A.accepting (run.path (t + 1)) ∧
      ∃ (prev : LiveState A) (parent : Node A) (sourceState : A.State),
        (automaton A).run word (t - 1) = some prev ∧
          parent ∈ (prev.1.stage1 A (word (t - 1))).stage2Triggers A ∧
          (livePlan A prev (word (t - 1))).stage2Plan.freshChild parent = v ∧
          m ≤ (prev.1.name parent).val ∧
          SettledLowerSourceNodeNameStateTargetEvent A run parent
            (prev.1.name parent).val sourceState target (t - 1)

/--
Green-removal branch at a non-accepting accepting-source cut.  The below-`m`
source-name drop exposes a concrete stage-(3) green node below `m`.
-/
def AcceptingNodeNameStateGreenBelowNonacceptingAt [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v : Node A)
    (nodeName m : Nat) (target : A.State) (t : Nat) : Prop :=
  AcceptingNodeNameStateAt A run v nodeName target t ∧
    ¬ A.accepting (run.path (t + 1)) ∧
      ∃ prev : LiveState A,
        (automaton A).run word (t - 1) = some prev ∧
          (let t1 := prev.1.stage1 A (word (t - 1))
           let plan := (livePlan A prev (word (t - 1))).stage2Plan
           let t2 := t1.stage2 A plan
           let t3 := t2.stage3 A
           ∃ old green,
            old ∈ t3.greenRemovedNodes A ∧
              green ∈ t3.greenNodes A ∧
              (t3.name green).val < m)

/--
Empty-removal branch at a non-accepting accepting-source cut.  The below-`m`
source-name drop exposes a stage-(4) active-empty node below `m`.
-/
def AcceptingNodeNameStateEmptyBelowNonacceptingAt [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v : Node A)
    (nodeName m : Nat) (target : A.State) (t : Nat) : Prop :=
  AcceptingNodeNameStateAt A run v nodeName target t ∧
    ¬ A.accepting (run.path (t + 1)) ∧
      ∃ prev : LiveState A,
        (automaton A).run word (t - 1) = some prev ∧
          (let t1 := prev.1.stage1 A (word (t - 1))
           let plan := (livePlan A prev (word (t - 1))).stage2Plan
           let t2 := t1.stage2 A plan
           let t3 := t2.stage3 A
           let t4 := t3.stage4 A
           let t5 := t4.stage5 A (t3.greenRemovedNodes A)
           ∃ old,
            t4.active old = true ∧
              t4.label old = ∅ ∧
              (t5.name old).val < m)

/--
Fresh-parent source movement below the ambient cutoff is not an independent
paper case.  A freshly created child is born above its predecessor parent's old
name; if the final selected successor name is below `m`, stage (6) must have
compacted it past a removed node below `m`.  That removed node is either caused
by a stage-(3) green node below `m`, or by a stage-(4) active-empty node below
`m`.
-/
theorem acceptingNodeNameStateFreshParentNonacceptingAt_green_or_empty_below
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m : Nat} {target : A.State} {t : Nat}
    (hnodeLt : nodeName < m)
    (hpos : 0 < t)
    (hfresh :
      AcceptingNodeNameStateFreshParentNonacceptingAt A run v nodeName m
        target t) :
    AcceptingNodeNameStateGreenBelowNonacceptingAt A run v nodeName m
        target t ∨
      AcceptingNodeNameStateEmptyBelowNonacceptingAt A run v nodeName m
        target t := by
  rcases hfresh with
    ⟨hevent, hnonaccepting, prev, parent, _sourceState, hprev, htrigger,
      hfreshChild, hparentNameGe, _hlowerTarget⟩
  rcases hevent with
    ⟨next, hrunNext, htargetEq, haccepting, htargetLabel, hnodeName⟩
  let t1 := prev.1.stage1 A (word (t - 1))
  let plan := (livePlan A prev (word (t - 1))).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let t5 := t4.stage5 A (t3.greenRemovedNodes A)
  have heventRebuilt :
      AcceptingNodeNameStateAt A run v nodeName target t :=
    ⟨next, hrunNext, htargetEq, haccepting, htargetLabel, hnodeName⟩
  have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel hpos
  have hdropNext : (next.1.name v).val < m := by
    omega
  rcases
      automaton_run_fresh_child_name_threshold_drop_exists_removed_before
        A word hprev (by simpa [hsucc] using hrunNext)
        (by simpa [t1] using htrigger)
        (by simpa [plan] using hfreshChild) hparentNameGe
        htargetLabel hdropNext with
    ⟨old, hold, holdNameLt⟩
  have holdSplit :
      old ∈ t3.greenRemovedNodes A ∨ old ∈ t4.emptyActiveNodes A := by
    have hold' :
        old ∈ t3.greenRemovedNodes A ∪ t4.emptyActiveNodes A := by
      simpa [t1, plan, t2, t3, t4, t5] using hold
    exact Finset.mem_union.mp hold'
  rcases holdSplit with holdGreen | holdEmpty
  · have hremoved : t3.RemovedByGreen A old :=
      (mem_greenRemovedNodes A t3).mp holdGreen
    rcases prev.2 with
      ⟨hrootActive, _hrootName, hrootParent, hparentInvariant,
        _hinactiveLabel, _hbound, hinjective, _hconsecutive, _hproper,
        hchildSubset, _hsiblingDisjoint⟩
    obtain ⟨hwfRoot, hwfParent, _hwfChild, _hwfSibling⟩ :=
      stage1_stage2_stage3_invariants A prev.1 (word (t - 1)) plan
        hrootActive hrootParent hparentInvariant hchildSubset hinjective
    rcases
        removedByGreen_exists_green_name_lt A t3 hwfRoot hwfParent
          hremoved with
      ⟨green, hgreen, hgreenLtOld⟩
    have ht5NameOld : (t5.name old).val = (t3.name old).val := by
      simp [t4, t5, stage5_name A t4 (t3.greenRemovedNodes A) old,
        stage4_name A t3 old]
    have holdNameLtT3 : (t3.name old).val < m := by
      have holdNameLt' : (t5.name old).val < m := by
        simpa [t1, plan, t2, t3, t4, t5] using holdNameLt
      rwa [← ht5NameOld]
    have hgreenNameLt : (t3.name green).val < m :=
      lt_trans hgreenLtOld holdNameLtT3
    exact Or.inl
      ⟨heventRebuilt, hnonaccepting, prev, hprev,
        by
          refine ⟨old, green, ?_, ?_, ?_⟩
          · simpa [t1, plan, t2, t3] using holdGreen
          · simpa [t1, plan, t2, t3] using hgreen
          · simpa [t1, plan, t2, t3] using hgreenNameLt⟩
  · have hempty := (mem_emptyActiveNodes A t4).mp holdEmpty
    have holdNameLt' : (t5.name old).val < m := by
      simpa [t1, plan, t2, t3, t4, t5] using holdNameLt
    exact Or.inr
      ⟨heventRebuilt, hnonaccepting, prev, hprev,
        by
          refine ⟨old, ?_, ?_, ?_⟩
          · simpa [t1, plan, t2, t3, t4, t5] using hempty.1
          · simpa [t1, plan, t2, t3, t4, t5] using hempty.2
          · simpa [t1, plan, t2, t3, t4, t5] using holdNameLt'⟩

/--
Cofinal fresh-parent elimination.  If fresh-parent source movement below `m`
recurs, then cofinally either the green-below branch recurs or the active-empty
below branch recurs.  The positivity side condition is obtained by selecting
cuts at or after time `1`.
-/
theorem frequently_acceptingNodeNameStateFreshParentNonacceptingAt_green_or_empty_below
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m : Nat} {target : A.State}
    (hnodeLt : nodeName < m)
    (hfreq :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateFreshParentNonacceptingAt A run v nodeName m
          target t) :
    (∀ n : Nat, ∃ t : Nat, n ≤ t ∧
      AcceptingNodeNameStateGreenBelowNonacceptingAt A run v nodeName m
        target t) ∨
      (∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateEmptyBelowNonacceptingAt A run v nodeName m
          target t) := by
  apply frequently_left_or_right_of_frequently_or
  intro n
  rcases hfreq (max n 1) with ⟨t, ht, hfresh⟩
  have hnt : n ≤ t := le_trans (Nat.le_max_left n 1) ht
  have hpos : 0 < t := by
    have h1t : 1 ≤ t := le_trans (Nat.le_max_right n 1) ht
    omega
  exact ⟨t, hnt,
    acceptingNodeNameStateFreshParentNonacceptingAt_green_or_empty_below
      A run hnodeLt hpos hfresh⟩

/--
Cofinal form of the one-step source-persistence fork.  A recurring
non-accepting accepting-source cut below the minimal threshold `m` has a cofinal
subsequence in exactly one of the paper alternatives: stable predecessor,
fresh-parent move, green removal below `m`, or empty removal below `m`.
-/
theorem frequently_acceptingNodeNameStateAt_next_nonaccepting_late_prev_stable_or_fresh_parent_or_green_or_empty_below
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {nodeName m N : Nat} {target : A.State}
    (hnodeLt : nodeName < m)
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hfreq :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateAt A run v nodeName target t ∧
          ¬ A.accepting (run.path (t + 1))) :
    (∀ n : Nat, ∃ t : Nat, n ≤ t ∧
      AcceptingNodeNameStatePrevStableNonacceptingAt A run v nodeName target t) ∨
      (∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateFreshParentNonacceptingAt A run v nodeName m
          target t) ∨
      (∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateGreenBelowNonacceptingAt A run v nodeName m
          target t) ∨
      (∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateEmptyBelowNonacceptingAt A run v nodeName m
          target t) := by
  have hfreqSplit :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        (AcceptingNodeNameStatePrevStableNonacceptingAt A run v nodeName target t ∨
          AcceptingNodeNameStateFreshParentNonacceptingAt A run v nodeName m target t ∨
          AcceptingNodeNameStateGreenBelowNonacceptingAt A run v nodeName m target t ∨
          AcceptingNodeNameStateEmptyBelowNonacceptingAt A run v nodeName m target t) := by
    intro n
    rcases hfreq (max n (N + 1)) with
      ⟨t, hmaxt, hevent, hnonaccepting⟩
    have hnt : n ≤ t := le_trans (Nat.le_max_left n (N + 1)) hmaxt
    have hpos : 0 < t := by
      have hN1t : N + 1 ≤ t :=
        le_trans (Nat.le_max_right n (N + 1)) hmaxt
      omega
    have hNk : N ≤ t - 1 := by
      have hN1t : N + 1 ≤ t :=
        le_trans (Nat.le_max_right n (N + 1)) hmaxt
      omega
    rcases hevent with
      ⟨live, hrunLive, htargetEq, haccepting, htargetLabel, hnodeName⟩
    have heventRebuilt :
        AcceptingNodeNameStateAt A run v nodeName target t :=
      ⟨live, hrunLive, htargetEq, haccepting, htargetLabel, hnodeName⟩
    have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel hpos
    rcases
        automaton_run_exists_live_of_later_run
          A word (start := t - 1) (length := 1) (i := 0)
          (by omega)
          (by simpa [hsucc] using hrunLive) with
      ⟨prev, hprev⟩
    rcases
        acceptingNodeNameStateAt_late_prev_stable_or_fresh_parent_or_green_or_empty_below
          A run hnodeLt hnoSmaller hNk heventRebuilt hpos hprev with
      hstable | hfresh | hgreen | hempty
    · exact ⟨t, hnt, Or.inl
        ⟨heventRebuilt, hnonaccepting, prev, hprev, hstable.1,
          hstable.2⟩⟩
    · rcases hfresh with
        ⟨parent, sourceState, htrigger, hfreshChild, hparentNameGe,
          hlowerTarget⟩
      exact ⟨t, hnt, Or.inr <| Or.inl
        ⟨heventRebuilt, hnonaccepting, prev, parent, sourceState, hprev,
          htrigger, hfreshChild, hparentNameGe, hlowerTarget⟩⟩
    · exact ⟨t, hnt, Or.inr <| Or.inr <| Or.inl
        ⟨heventRebuilt, hnonaccepting, prev, hprev, hgreen⟩⟩
    · exact ⟨t, hnt, Or.inr <| Or.inr <| Or.inr
        ⟨heventRebuilt, hnonaccepting, prev, hprev, hempty⟩⟩
  rcases frequently_left_or_right_of_frequently_or hfreqSplit with
    hstableFreq | hnonstableFreq
  · exact Or.inl hstableFreq
  · right
    rcases frequently_left_or_right_of_frequently_or hnonstableFreq with
      hfreshFreq | hgreenOrEmptyFreq
    · exact Or.inl hfreshFreq
    · right
      rcases frequently_left_or_right_of_frequently_or hgreenOrEmptyFreq with
        hgreenFreq | hemptyFreq
      · exact Or.inl hgreenFreq
      · exact Or.inr hemptyFreq

/--
Reachability-enriched accepting child/name/state occurrence.
-/
def AcceptingChildCoverageChildNameStateReachableAt [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v child : Node A)
    (a childName : Nat) (target : A.State) (t : Nat) : Prop :=
  AcceptingChildCoverageChildNameStateAt A run v child a childName target t ∧
    ReachablePrefix A A.initial word t target

/--
An above-source strict successor-name drop is an ordinary child-coverage event
for the lower source at the successor time, with a concrete child name strictly
between the lower-source name and the previously fixed child name.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtAboveSourceEvent_to_childCoverageNameAt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtAboveSourceEvent
        A run v sourceNode child a sourceName childName sourceState target
        uncovered k) :
    ∃ smallerName : Nat,
      smallerName ∈ Finset.range (Fintype.card A.State) ∧
        sourceName < smallerName ∧
        smallerName < childName ∧
        SettledChildCoverageNameAt A run sourceNode sourceName smallerName
          (k + 1) := by
  rcases hevent with
    ⟨hordered, next, hrunNext, hchildNext, htargetNextChild, habove,
      hchildLt⟩
  rcases hordered with ⟨hltEvent, _nextOrd, _hrunNextOrd, _hchildNextOrd,
    _htargetNextChildOrd, _hparentLtChild, _hchildLtOrd⟩
  rcases hltEvent with ⟨hleEvent, _nextLt, _hrunNextLt, _hchildNextLt,
    _htargetNextChildLt, _hchildLtRaw⟩
  rcases hleEvent with ⟨hfixed, _nextLe, _hrunNextLe, _hchildNextLe,
    _htargetNextChildLe, _hnameLe⟩
  rcases hfixed with ⟨hnameEvent, _liveFixed, _hrunFixed, _hfixedPayload⟩
  rcases hnameEvent with ⟨hancestorEvent, _liveName, _hrunName,
    _hnamePayload⟩
  rcases hancestorEvent with ⟨hsameChildEvent, _liveAncestor,
    _hrunAncestor, _hancestorPayload⟩
  rcases hsameChildEvent with ⟨hmeasureEvent, _nextSame, _hrunNextSame,
    _hchildSame, _htargetSame⟩
  rcases hmeasureEvent with ⟨hcoveredEvent, _liveMeasure, _nextMeasure,
    _hrunMeasure, _hrunNextMeasure, _hmeasurePayload⟩
  rcases hcoveredEvent with ⟨hsurvivesEvent, _nextCovered,
    _hrunNextCovered, _htargetCovered⟩
  rcases
      settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent_to_coverage_payload
        A run hsurvivesEvent with
    ⟨_livePayload, nextPayload, _hrunPayload, hrunNextPayload, htargetEq,
      _haccepting, _hcover⟩
  have hnextPayloadEq : nextPayload = next := by
    have hsome : some nextPayload = some next := by
      rw [← hrunNextPayload, hrunNext]
    exact Option.some.inj hsome
  subst nextPayload
  let smallerName : Nat := (next.1.name child).val
  have hactiveChild : next.1.active child = true := by
    have hchildSpec := hchildNext
    rw [children, Finset.mem_filter] at hchildSpec
    exact hchildSpec.2.1
  have hcard : smallerName ∈ Finset.range (Fintype.card A.State) := by
    rcases next.2 with
      ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
        _hinactiveLabel, hbound, _hinjective, _hconsecutive, _hproper,
        _hchildSubset, _hsiblingDisjoint⟩
    exact Finset.mem_range.mpr (hbound child hactiveChild)
  have hpathMem : run.path (k + 1) ∈ next.1.label child := by
    rw [htargetEq]
    exact htargetNextChild
  refine ⟨smallerName, hcard, by simpa [smallerName] using habove,
    by simpa [smallerName] using hchildLt, ?_⟩
  exact settledChildCoverageNameAt_of_child_witness
    A run hrunNext hchildNext hpathMem rfl
    (by simpa [smallerName] using habove)

/--
Cofinal above-source strict drops concentrate on one ordinary lower-source
coverage name which is still strictly below the previously fixed child name.
-/
theorem exists_frequently_settledChildCoverageNameAt_lt_of_aboveSourceDrops
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtAboveSourceEvent
          A run v sourceNode child a sourceName childName sourceState target
          uncovered k) :
    ∃ smallerName : Nat,
      smallerName ∈ Finset.range (Fintype.card A.State) ∧
        sourceName < smallerName ∧
        smallerName < childName ∧
        ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
          SettledChildCoverageNameAt A run sourceNode sourceName smallerName t := by
  classical
  have hfreqFilter :
      ∃ᶠ t in Filter.atTop,
        ∃ smallerName ∈ Finset.range (Fintype.card A.State),
          sourceName < smallerName ∧
            smallerName < childName ∧
            SettledChildCoverageNameAt A run sourceNode sourceName
              smallerName t := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with ⟨k, hnk, hevent⟩
    rcases
        settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtAboveSourceEvent_to_childCoverageNameAt
          A run hevent with
      ⟨smallerName, hcard, hsourceLt, hlt, hcoverage⟩
    exact ⟨k + 1, by omega, smallerName, hcard, hsourceLt, hlt,
      hcoverage⟩
  rw [Finset.frequently_exists] at hfreqFilter
  rcases hfreqFilter with ⟨smallerName, hcard, hfreqSmaller⟩
  have hsourceLt : sourceName < smallerName := by
    rcases (Filter.frequently_atTop).1 hfreqSmaller 0 with
      ⟨_t, _ht, hsourceLt, _hlt, _hcoverage⟩
    exact hsourceLt
  have hlt : smallerName < childName := by
    rcases (Filter.frequently_atTop).1 hfreqSmaller 0 with
      ⟨_t, _ht, _hsourceLt, hlt, _hcoverage⟩
    exact hlt
  refine ⟨smallerName, hcard, hsourceLt, hlt, ?_⟩
  intro n
  rcases (Filter.frequently_atTop).1 hfreqSmaller n with
    ⟨t, hnt, _hsourceLt, _hlt, hcoverage⟩
  exact ⟨t, hnt, hcoverage⟩

/--
Stronger above-source payload: the fixed accepting target is carried by the
fixed successor child at the strictly smaller successor child name.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtAboveSourceEvent_to_acceptingChildCoverageChildNameStateAt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameLtAboveSourceEvent
        A run v sourceNode child a sourceName childName sourceState target
        uncovered k) :
    ∃ smallerName : Nat,
      smallerName ∈ Finset.range (Fintype.card A.State) ∧
        sourceName < smallerName ∧
        smallerName < childName ∧
        AcceptingChildCoverageChildNameStateAt A run sourceNode child
          sourceName smallerName target (k + 1) := by
  rcases hevent with
    ⟨hordered, next, hrunNext, hchildNext, htargetNextChild, habove,
      hchildLt⟩
  rcases hordered with ⟨hltEvent, _nextOrd, _hrunNextOrd, _hchildNextOrd,
