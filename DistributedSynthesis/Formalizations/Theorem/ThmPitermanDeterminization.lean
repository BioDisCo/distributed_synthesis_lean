import Mathlib.Order.KonigLemma
import DistributedSynthesis.Library.Automata.PitermanAllocation

set_option linter.unusedVariables false

/-!
# Piterman determinization

This file proves language correctness of Piterman's construction from
``From Nondeterministic Büchi and Streett Automata to Deterministic Parity
Automata'' (LMCS 2007, arXiv:0705.2205).

The compact-tree transition machinery is in `Library.Automata.PitermanTransition`.
`Library.Automata.PitermanAllocation` supplies sorted fresh-node allocation.
Both the canonical proof here and the executable compiler use this allocation;
the semantic interface still uses classical deciders for arbitrary NBW predicates.
-/

namespace DistributedSynthesis
universe u v
namespace NondetBuchiAutomaton
namespace Piterman
variable {Alphabet : Type u}
namespace CompactTreeData
variable (A : NondetBuchiAutomaton.{u, v} Alphabet)

/-- Canonical sorted allocation, using classical deciders only because the
semantic NBW interface permits arbitrary proposition-valued predicates. -/
noncomputable def livePlan [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet) :
    TransitionPlan A state.1 letter :=
  Computable.transitionPlan A (fun _ _ _ => Classical.propDecidable _)
    (fun _ => Classical.propDecidable _) state.1 state.2 letter

noncomputable def liveNextTree [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet) : CompactTreeData A :=
  state.1.transitionWithPlan A letter (livePlan A state letter)

noncomputable def liveStage4RootLabel [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet) : Finset A.State :=
  (((state.1.stage1 A letter).stage2 A
      (livePlan A state letter).stage2Plan).stage3 A).stage4 A
    |>.label (root A)

noncomputable def liveRootLabelNonempty [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet) : Prop :=
  liveStage4RootLabel A state letter ≠ ∅

theorem liveNextTree_wellFormed_of_rootLabelNonempty
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet)
    (hrootLabel : liveRootLabelNonempty A state letter) :
    (liveNextTree A state letter).WellFormed A := by
  simpa [liveNextTree, livePlan, liveRootLabelNonempty,
    liveStage4RootLabel] using
    (transitionWithPlan_preserves_wellFormed_of_stage4_root_label_nonempty
      A state.1 letter (livePlan A state letter) state.2 hrootLabel)

theorem liveNextTree_root_label_subset_stepImage
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet) :
    (liveNextTree A state letter).label (root A) ⊆
      stepImage A letter (state.1.label (root A)) := by
  rcases state.2 with
    ⟨hrootActive, _hrootName, _hrootParent, _hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  simpa [liveNextTree, livePlan] using
    (transitionWithPlan_root_label_subset_stepImage A state.1 letter
      (livePlan A state letter) hrootActive)

theorem stepImage_subset_liveStage4RootLabel
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet) :
    stepImage A letter (state.1.label (root A)) ⊆
      liveStage4RootLabel A state letter := by
  rcases state.2 with
    ⟨hrootActive, hrootName, hrootParent, _hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  simpa [liveStage4RootLabel, livePlan] using
    (stepImage_subset_transitionWithPlan_stage4_root_label A state.1 letter
      (livePlan A state letter) hrootActive hrootName hrootParent)

theorem stepImage_subset_liveNextTree_root_label
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet) :
    stepImage A letter (state.1.label (root A)) ⊆
      (liveNextTree A state letter).label (root A) := by
  rcases state.2 with
    ⟨hrootActive, hrootName, hrootParent, _hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  simpa [liveNextTree, livePlan] using
    (stepImage_subset_transitionWithPlan_root_label A state.1 letter
      (livePlan A state letter) hrootActive hrootName hrootParent)

theorem liveNextTree_root_label_eq_stepImage
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet) :
    (liveNextTree A state letter).label (root A) =
      stepImage A letter (state.1.label (root A)) :=
  Finset.Subset.antisymm
    (liveNextTree_root_label_subset_stepImage A state letter)
    (stepImage_subset_liveNextTree_root_label A state letter)

theorem liveNextTree_active_label_segment_from_same_node
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} (state : LiveState A)
    {node : Node A} {target : A.State}
    (hactive : state.1.active node = true)
    (htarget : target ∈ (liveNextTree A state (word n)).label node) :
    ∃ source,
      source ∈ state.1.label node ∧
        Segment A word n 1 source target := by
  let t1 := state.1.stage1 A (word n)
  let plan := (livePlan A state (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let stage4Removed := t3.greenRemovedNodes A
  let t5 := t4.stage5 A stage4Removed
  let stage5Removed := stage4Removed ∪ t4.emptyActiveNodes A
  have htarget_t5 : target ∈ t5.label node := by
    simpa [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed] using htarget
  have htarget_t4 : target ∈ t4.label node :=
    stage5_label_subset A t4 stage4Removed node htarget_t5
  have htarget_t3 : target ∈ t3.label node :=
    stage4_label_subset A t3 node htarget_t4
  have htarget_t2 : target ∈ t2.label node :=
    stage3_label_subset A t2 node htarget_t3
  have hactive_t1 : t1.active node = true := by
    simpa [t1, stage1_active A state.1 (word n) node] using hactive
  have htarget_t1 : target ∈ t1.label node := by
    have hlabel : t2.label node = t1.label node :=
      stage2_preserves_active_node_label A t1 plan hactive_t1
    simpa [hlabel] using htarget_t2
  rcases stage1_label_segment A state.1 word htarget_t1 with
    ⟨source, hsource, hsegment⟩
  exact ⟨source, hsource, hsegment⟩

theorem liveNextTree_name_val_eq_stage5_name_of_stage5_e_ge
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet)
    {node : Node A} :
    let t1 := state.1.stage1 A letter
    let t2 := t1.stage2 A (livePlan A state letter).stage2Plan
    let t3 := t2.stage3 A
    let t4 := t3.stage4 A
    let stage4Removed := t3.greenRemovedNodes A
    let t5 := t4.stage5 A stage4Removed
    t5.label node ≠ ∅ ->
      (t5.name node).val < Fintype.card A.State ->
        (t5.name node).val ≤
          ((liveNextTree A state letter).e).val ->
          ((liveNextTree A state letter).name node).val =
            (t5.name node).val := by
  simpa [liveNextTree] using
    (transitionWithPlan_name_val_eq_stage5_name_of_stage5_e_ge
      A state.1 letter (livePlan A state letter) (node := node))

/--
Old active nodes never receive a larger dynamic name across one live
transition.  Stage (6) only compacts names downward, while stages (1)-(5)
preserve the name of an already-active node.  The nonempty next label selects
the nonempty/compacted branch of stage (6).
-/
theorem liveNextTree_name_val_le_of_active_next_label
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet)
    {node : Node A} {target : A.State}
    (hactive : state.1.active node = true)
    (hmem : target ∈ (liveNextTree A state letter).label node) :
    ((liveNextTree A state letter).name node).val ≤
      (state.1.name node).val := by
  let t1 := state.1.stage1 A letter
  let plan := (livePlan A state letter).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let stage4Removed := t3.greenRemovedNodes A
  let t5 := t4.stage5 A stage4Removed
  let stage5Removed := stage4Removed ∪ t4.emptyActiveNodes A
  have hactive1 : t1.active node = true := by
    simpa [t1, stage1_active A state.1 letter node] using hactive
  have hnameT5 :
      (t5.name node).val = (state.1.name node).val := by
    rw [show t5.name node = t4.name node from
      stage5_name A t4 stage4Removed node]
    rw [show t4.name node = t3.name node from stage4_name A t3 node]
    rw [show t3.name node = t2.name node from stage3_name A t2 node]
    rw [show t2.name node = t1.name node from
      stage2_preserves_active_node_name A t1 plan hactive1]
    rw [show t1.name node = state.1.name node from
      stage1_name A state.1 letter node]
  have hlabelT5 : t5.label node ≠ ∅ := by
    intro hempty
    have hmemFinal :
        target ∈ (t5.stage6 A stage5Removed).label node := by
      simpa [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
        stage4Removed, t5, stage5Removed] using hmem
    rw [stage6_preserves_label A t5 stage5Removed node, hempty] at hmemFinal
    simp at hmemFinal
  have hnameNext :
      (liveNextTree A state letter).name node =
        (t5.stage6 A stage5Removed).name node := by
    simp [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed]
  have hcompact :
      ((t5.stage6 A stage5Removed).name node).val ≤ (t5.name node).val := by
    rw [stage6_nonempty_name A t5 stage5Removed hlabelT5]
    exact compactedName_le_oldName A t5 stage5Removed node
  have hcompactOld :
      ((t5.stage6 A stage5Removed).name node).val ≤
        (state.1.name node).val := by
    rwa [hnameT5] at hcompact
  rw [hnameNext]
  exact hcompactOld

theorem liveNextTree_stage4_keeps_active_of_name_le_f
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet)
    {node : Node A} :
    let t1 := state.1.stage1 A letter
    let t2 := t1.stage2 A (livePlan A state letter).stage2Plan
    let t3 := t2.stage3 A
    t3.active node = true ->
      (t3.name node).val < Fintype.card A.State ->
        (t3.name node).val ≤ ((liveNextTree A state letter).f).val ->
          (t3.stage4 A).active node = true := by
  rcases state.2 with
    ⟨hrootActive, _hrootName, hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  simpa [liveNextTree] using
    (transitionWithPlan_stage4_keeps_active_of_name_le_f A state.1 letter
      (livePlan A state letter) hrootActive hrootParent hparentInvariant
      (node := node))

theorem liveNextTree_preserves_active_name_of_no_smaller_event
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet)
    {node : Node A} :
    let t1 := state.1.stage1 A letter
    let t2 := t1.stage2 A (livePlan A state letter).stage2Plan
    let t3 := t2.stage3 A
    t3.active node = true ->
      (t3.name node).val < Fintype.card A.State ->
        (t3.name node).val ≤ ((liveNextTree A state letter).f).val ->
          (t3.name node).val < ((liveNextTree A state letter).e).val ->
            (liveNextTree A state letter).active node = true ∧
              ((liveNextTree A state letter).name node).val =
                (t3.name node).val := by
  rcases state.2 with
    ⟨hrootActive, _hrootName, hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  simpa [liveNextTree] using
    (transitionWithPlan_preserves_active_name_of_no_smaller_event
      A state.1 letter (livePlan A state letter) hrootActive hrootParent
      hparentInvariant (node := node))

theorem liveNextTree_preserves_live_active_name_of_no_smaller_event
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet)
    {node : Node A}
    (hactive : state.1.active node = true)
    (hnodeBound : (state.1.name node).val < Fintype.card A.State)
    (hf : (state.1.name node).val ≤ ((liveNextTree A state letter).f).val)
    (he : (state.1.name node).val < ((liveNextTree A state letter).e).val) :
    (liveNextTree A state letter).active node = true ∧
      ((liveNextTree A state letter).name node).val =
        (state.1.name node).val := by
  let t1 := state.1.stage1 A letter
  let t2 := t1.stage2 A (livePlan A state letter).stage2Plan
  let t3 := t2.stage3 A
  have ht1Active : t1.active node = true := by
    simpa [t1, stage1_active A state.1 letter node] using hactive
  have ht1Name : (t1.name node).val = (state.1.name node).val := by
    simp [t1, stage1_name A state.1 letter node]
  have ht2Active : t2.active node = true :=
    stage2_preserves_active_node_active A t1
      (livePlan A state letter).stage2Plan ht1Active
  have ht2Name : (t2.name node).val = (state.1.name node).val := by
    rw [show t2.name node = t1.name node from
      stage2_preserves_active_node_name A t1
        (livePlan A state letter).stage2Plan ht1Active]
    exact ht1Name
  have ht3Active : t3.active node = true := by
    simpa [t3, stage3_active A t2 node] using ht2Active
  have ht3Name : (t3.name node).val = (state.1.name node).val := by
    rw [show t3.name node = t2.name node from stage3_name A t2 node]
    exact ht2Name
  have ht3Bound : (t3.name node).val < Fintype.card A.State := by
    omega
  have hf3 : (t3.name node).val ≤ ((liveNextTree A state letter).f).val := by
    omega
  have he3 : (t3.name node).val < ((liveNextTree A state letter).e).val := by
    omega
  rcases liveNextTree_preserves_active_name_of_no_smaller_event
      A state letter (node := node) ht3Active ht3Bound hf3 he3 with
    ⟨hnextActive, hnextName⟩
  have hnextNameLive :
      ((liveNextTree A state letter).name node).val =
        (state.1.name node).val := by
    rw [hnextName, ht3Name]
  exact ⟨hnextActive, hnextNameLive⟩

theorem liveSequence_preserves_active_name_of_no_smaller_event
    [DecidableEq A.State]
    (word : OmegaWord Alphabet) (start length : Nat)
    (lives : Nat -> LiveState A)
    {node : Node A}
    (hstep :
      ∀ i : Nat, i < length ->
        (lives (i + 1)).1 =
          liveNextTree A (lives i) (word (start + i)))
    (hactive0 : (lives 0).1.active node = true)
    (hbound0 : ((lives 0).1.name node).val < Fintype.card A.State)
    (hnoSmaller :
      ∀ i : Nat, i < length ->
        (lives i).1.active node = true ->
        ((lives i).1.name node).val = ((lives 0).1.name node).val ->
          ((lives i).1.name node).val ≤
              ((liveNextTree A (lives i) (word (start + i))).f).val ∧
            ((lives i).1.name node).val <
              ((liveNextTree A (lives i) (word (start + i))).e).val) :
    ∀ i : Nat, i ≤ length ->
      (lives i).1.active node = true ∧
        ((lives i).1.name node).val =
          ((lives 0).1.name node).val := by
  intro i
  induction i with
  | zero =>
      intro _hi
      exact ⟨hactive0, rfl⟩
  | succ i ih =>
      intro hiLen
      have hiLt : i < length := by omega
      have hiLe : i ≤ length := by omega
      rcases ih hiLe with ⟨hactive, hname⟩
      rcases hnoSmaller i hiLt hactive hname with ⟨hf, he⟩
      have hbound : ((lives i).1.name node).val < Fintype.card A.State := by
        rw [hname]
        exact hbound0
      rcases liveNextTree_preserves_live_active_name_of_no_smaller_event
          A (lives i) (word (start + i)) (node := node)
          hactive hbound hf he with
        ⟨hnextActive, hnextName⟩
      have hstepEq := hstep i hiLt
      constructor
      · rw [hstepEq]
        exact hnextActive
      · rw [hstepEq]
        rw [hnextName, hname]

theorem liveNextTree_exists_green_name_eq_f
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet)
    (hboundedGreen :
      ∃ green,
        green ∈
          ((((state.1.stage1 A letter).stage2 A
              (livePlan A state letter).stage2Plan).stage3 A).greenNodes A) ∧
        (((((state.1.stage1 A letter).stage2 A
              (livePlan A state letter).stage2Plan).stage3 A).name green).val) <
          Fintype.card A.State) :
    ∃ green,
      green ∈
        (((state.1.stage1 A letter).stage2 A
          (livePlan A state letter).stage2Plan).stage3 A).greenNodes A ∧
      ((((state.1.stage1 A letter).stage2 A
          (livePlan A state letter).stage2Plan).stage3 A).name green).val =
        ((liveNextTree A state letter).f).val := by
  simpa [liveNextTree, livePlan] using
    (transitionWithPlan_exists_green_name_eq_f A state.1 letter
      (livePlan A state letter) hboundedGreen)

theorem liveNextTree_exists_green_name_eq_f_of_f_lt_e
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet)
    (hfe :
      ((liveNextTree A state letter).f).val <
        ((liveNextTree A state letter).e).val) :
    ∃ green,
      green ∈
        (((state.1.stage1 A letter).stage2 A
          (livePlan A state letter).stage2Plan).stage3 A).greenNodes A ∧
      ((((state.1.stage1 A letter).stage2 A
          (livePlan A state letter).stage2Plan).stage3 A).name green).val =
        ((liveNextTree A state letter).f).val := by
  simpa [liveNextTree, livePlan] using
    (transitionWithPlan_exists_green_name_eq_f_of_f_lt_e A state.1 letter
      (livePlan A state letter) hfe)

theorem liveNextTree_green_name_eq_f_label_nonempty_of_f_lt_e
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet)
    {green : Node A}
    (hgreen :
      green ∈
        (((state.1.stage1 A letter).stage2 A
          (livePlan A state letter).stage2Plan).stage3 A).greenNodes A)
    (hname :
      ((((state.1.stage1 A letter).stage2 A
          (livePlan A state letter).stage2Plan).stage3 A).name green).val =
        ((liveNextTree A state letter).f).val)
    (hfe :
      ((liveNextTree A state letter).f).val <
        ((liveNextTree A state letter).e).val) :
    (((state.1.stage1 A letter).stage2 A
        (livePlan A state letter).stage2Plan).stage3 A).label green ≠ ∅ := by
  simpa [liveNextTree, livePlan] using
    (transitionWithPlan_green_name_eq_f_label_nonempty_of_f_lt_e
      A state.1 letter (livePlan A state letter) hgreen hname hfe)

theorem liveNextTree_e_pos_of_rootLabelNonempty
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet)
    (hrootLabel : liveRootLabelNonempty A state letter) :
    0 < ((liveNextTree A state letter).e).val := by
  simpa [liveNextTree, livePlan, liveRootLabelNonempty,
    liveStage4RootLabel] using
    (transitionWithPlan_e_pos_of_stage4_root_label_nonempty
      A state.1 letter (livePlan A state letter) state.2 hrootLabel)

noncomputable def liveTransition [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet) : DPWState A := by
  classical
  by_cases hrootLabel : liveRootLabelNonempty A state letter
  · exact some
      ⟨liveNextTree A state letter,
        liveNextTree_wellFormed_of_rootLabelNonempty A state letter hrootLabel⟩
  · exact none

theorem liveTransition_eq_none_of_rootLabel_empty [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet)
    (hrootLabel : ¬ liveRootLabelNonempty A state letter) :
    liveTransition A state letter = none := by
  simp [liveTransition, hrootLabel]

theorem liveTransition_eq_none_iff [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet) :
    liveTransition A state letter = none ↔
      ¬ liveRootLabelNonempty A state letter := by
  by_cases hrootLabel : liveRootLabelNonempty A state letter
  · simp [liveTransition, hrootLabel]
  · simp [liveTransition, hrootLabel]

theorem liveTransition_eq_some_of_rootLabel_nonempty [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet)
    (hrootLabel : liveRootLabelNonempty A state letter) :
    liveTransition A state letter =
      some
        ⟨liveNextTree A state letter,
          liveNextTree_wellFormed_of_rootLabelNonempty A state letter
            hrootLabel⟩ := by
  simp [liveTransition, hrootLabel]

/-- The paper's parity priority from the dynamic `e`/`f` values.

The paper uses one-based names and assigns an even priority exactly when
`f < e`.  This zero-based form sends `f < e` to priority `2 * f`; otherwise
deletion of one-based name `i + 2` becomes odd priority `2 * i + 1`.  The
paper's unclassified `e = 1` case is the zero-based `e = 0` branch below; it
is a rejecting odd priority and should only arise at the empty-root sink
boundary.
-/
def priority (tree : CompactTreeData A) : Nat :=
  if tree.f.val < tree.e.val then
    2 * tree.f.val
  else
    match tree.e.val with
    | 0 => 1
    | Nat.succ pred => 2 * pred + 1

theorem priority_even_of_f_lt_e
    (tree : CompactTreeData A) (h : tree.f.val < tree.e.val) :
    DetParityAutomaton.NatEven (priority A tree) := by
  refine ⟨tree.f.val, ?_⟩
  simp [priority, h]

theorem priority_odd_of_not_f_lt_e
    (tree : CompactTreeData A) (h : ¬ tree.f.val < tree.e.val) :
    ¬ DetParityAutomaton.NatEven (priority A tree) := by
  intro heven
  rcases heven with ⟨m, hm⟩
  cases hval : tree.e.val with
  | zero =>
      have hodd : 1 = 2 * m := by
        simpa [priority, h, hval] using hm
      omega
  | succ pred =>
      have hnotLe : ¬ tree.f.val ≤ pred := by
        intro hle
        exact h (by simpa [hval] using Nat.lt_succ_of_le hle)
      have hodd : 2 * pred + 1 = 2 * m := by
        simpa [priority, hval, hnotLe] using hm
      omega

theorem priority_even_iff_f_lt_e
    (tree : CompactTreeData A) :
    DetParityAutomaton.NatEven (priority A tree) ↔
      tree.f.val < tree.e.val := by
  constructor
  · intro heven
    by_contra h
    exact priority_odd_of_not_f_lt_e A tree h heven
  · exact priority_even_of_f_lt_e A tree

noncomputable def automaton [DecidableEq A.State] :
    DetParityAutomaton Alphabet where
  State := DPWState A
  stateFinite := by
    classical
    letI : DecidablePred (fun tree : CompactTreeData A => tree.WellFormed A) :=
      fun tree => Classical.dec (tree.WellFormed A)
    haveI : Fintype (CompactTreeData A) := inferInstance
    infer_instance
  initial := some ⟨initial A, initial_wellFormed A⟩
  step state letter :=
    match state with
    | none => none
    | some live => liveTransition A live letter
  priority state :=
    match state with
    | none => 1
    | some live => priority A live.1

@[simp]
theorem automaton_initial [DecidableEq A.State] :
    (automaton A).initial = some ⟨initial A, initial_wellFormed A⟩ :=
  rfl

@[simp]
theorem automaton_step_sink [DecidableEq A.State]
    (letter : Alphabet) :
    (automaton A).step none letter = none :=
  rfl

theorem automaton_step_live_eq_none_of_rootLabel_empty
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet)
    (hrootLabel : ¬ liveRootLabelNonempty A state letter) :
    (automaton A).step (some state) letter = none := by
  exact liveTransition_eq_none_of_rootLabel_empty A state letter hrootLabel

theorem automaton_step_live_eq_none_iff
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet) :
    (automaton A).step (some state) letter = none ↔
      ¬ liveRootLabelNonempty A state letter :=
  liveTransition_eq_none_iff A state letter

theorem automaton_step_live_eq_some_of_rootLabel_nonempty
    [DecidableEq A.State]
    (state : LiveState A) (letter : Alphabet)
    (hrootLabel : liveRootLabelNonempty A state letter) :
    (automaton A).step (some state) letter =
      some
        ⟨liveNextTree A state letter,
          liveNextTree_wellFormed_of_rootLabelNonempty A state letter
            hrootLabel⟩ := by
  exact liveTransition_eq_some_of_rootLabel_nonempty A state letter hrootLabel

theorem automaton_run_live_nextTree
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live next : LiveState A}
    (hrun : (automaton A).run word n = some live)
    (hrunNext : (automaton A).run word (n + 1) = some next) :
    next.1 = liveNextTree A live (word n) := by
  have hstep :
      (automaton A).step ((automaton A).run word n) (word n) =
        some next := by
    simpa [DetParityAutomaton.run] using hrunNext
  rw [hrun] at hstep
  by_cases hrootLabel : liveRootLabelNonempty A live (word n)
  · have hsome :
        some
          ⟨liveNextTree A live (word n),
            liveNextTree_wellFormed_of_rootLabelNonempty A live (word n)
              hrootLabel⟩ =
          some next := by
      rw [← automaton_step_live_eq_some_of_rootLabel_nonempty A live
        (word n) hrootLabel]
      exact hstep
    injection hsome with hnext
    have hnext' :
        next =
          ⟨liveNextTree A live (word n),
            liveNextTree_wellFormed_of_rootLabelNonempty A live (word n)
              hrootLabel⟩ := hnext.symm
    simp [hnext']
  · have hnone :
        (automaton A).step (some live) (word n) = none :=
      automaton_step_live_eq_none_of_rootLabel_empty A live (word n)
        hrootLabel
    rw [hnone] at hstep
    simp at hstep

/--
Settled-descent geometry on `t3`.  At a child-union event the accepting target is
covered by a child of `sourceNode` (so it lies in `sourceNode`'s post-stage-(3)
label) and, since the settled node `v` carries the same target one step later, the
reverse `t3`→live monotonicity pulls that target back onto `t3.label v`.  Both
holding in `t3` with `sourceNode` of strictly smaller name than `v` forces
`sourceNode` to be an ancestor of `v` in `t3` (chain property pinned by names).
This is the non-circular step that lets the breakpoint kernel place the source
node above the settled node.
-/
theorem stage3_sourceNode_isAncestorOrSelf_of_settled_childUnion
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    {k : Nat} {live next : LiveState A} {sourceNode v : Node A}
    {m a : Nat} {target : A.State}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (htarget : run.path (k + 1) = target)
    (hsourceActive : live.1.active sourceNode = true)
    (hsourceName : (live.1.name sourceNode).val = m)
    (hchildUnion :
      target ∈
        (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).childLabelUnion A
          sourceNode)
    (hvActive : live.1.active v = true)
    (hvName : (live.1.name v).val = a)
    (hvNext : run.path (k + 1) ∈ next.1.label v)
    (hmlt : m < a) :
    (((live.1.stage1 A (word k)).stage2 A
      (livePlan A live (word k)).stage2Plan).stage3 A).IsAncestorOrSelf A
        sourceNode v := by
  classical
  obtain ⟨hRootActive, _hRootName, hRootParent, hParentInv, _hInactive,
      _hBound, hInjective, _hDensity, _hProper, hChildSubset, _hSibling⟩ := live.2
  let plan := (livePlan A live (word k)).stage2Plan
  let t3 := ((live.1.stage1 A (word k)).stage2 A plan).stage3 A
  obtain ⟨hwfRoot, hwfParent, hwfChild, hwfSibling⟩ :=
    stage1_stage2_stage3_invariants A live.1 (word k) plan
      hRootActive hRootParent hParentInv hChildSubset hInjective
  have activeT3 : ∀ node, live.1.active node = true -> t3.active node = true := by
    intro node hnode
    have h1 : (live.1.stage1 A (word k)).active node = true := by
      simpa [stage1_active] using hnode
    have h2 := stage2_preserves_active_node_active A (live.1.stage1 A (word k))
      plan h1
    simpa [t3, stage3_active] using h2
  have nameT3 : ∀ node, live.1.active node = true ->
      (t3.name node).val = (live.1.name node).val := by
    intro node hnode
    have h1 : (live.1.stage1 A (word k)).active node = true := by
      simpa [stage1_active] using hnode
    have h2 := stage2_preserves_active_node_name A (live.1.stage1 A (word k))
      plan h1
    simp only [t3, stage3_name, h2, stage1_name]
  have hsourceMem : target ∈ t3.label sourceNode :=
    childLabelUnion_subset_label A t3 hwfChild sourceNode hchildUnion
  have hnextTree : next.1 = liveNextTree A live (word k) :=
    automaton_run_live_nextTree A word hrun hrunNext
  have hvMemT3 : target ∈ t3.label v := by
    have hsub :=
      transitionWithPlan_label_subset_stage3 A live.1 (word k)
        (livePlan A live (word k)) v
    have hvMemNext : target ∈ next.1.label v := by rw [← htarget]; exact hvNext
    rw [hnextTree] at hvMemNext
    exact hsub hvMemNext
  refine isAncestorOrSelf_of_mem_label_of_name_lt A t3 hwfRoot hwfParent hwfChild
    hwfSibling (activeT3 sourceNode hsourceActive) (activeT3 v hvActive)
    hsourceMem hvMemT3 ?_
  rw [nameT3 sourceNode hsourceActive, nameT3 v hvActive, hsourceName, hvName]
  exact hmlt

/--
At a lower-source child-union event, any fixed child carrying the accepting target
is the child of the source node on the path to the settled node `v`.  The target is
also in `v`'s stage-(3) label, and stage-(3) sibling labels are disjoint, so the
covering child cannot be a different sibling.
-/
theorem stage3_child_isAncestorOrSelf_of_settled_childUnionChild
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    {k : Nat} {live next : LiveState A} {sourceNode child v : Node A}
    {m a : Nat} {target : A.State}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (htarget : run.path (k + 1) = target)
    (hsourceActive : live.1.active sourceNode = true)
    (hsourceName : (live.1.name sourceNode).val = m)
    (hchild :
      child ∈
        (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).children A sourceNode)
    (htargetChild :
      target ∈
        (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).label child)
    (hvActive : live.1.active v = true)
    (hvName : (live.1.name v).val = a)
    (hvNext : run.path (k + 1) ∈ next.1.label v)
    (hmlt : m < a) :
    (((live.1.stage1 A (word k)).stage2 A
      (livePlan A live (word k)).stage2Plan).stage3 A).IsAncestorOrSelf A
        child v := by
  classical
  obtain ⟨hRootActive, _hRootName, hRootParent, hParentInv, _hInactive,
      _hBound, hInjective, _hDensity, _hProper, hChildSubset, _hSibling⟩ := live.2
  let plan := (livePlan A live (word k)).stage2Plan
  let t3 := ((live.1.stage1 A (word k)).stage2 A plan).stage3 A
  obtain ⟨hwfRoot, hwfParent, hwfChild, hwfSibling⟩ :=
    stage1_stage2_stage3_invariants A live.1 (word k) plan
      hRootActive hRootParent hParentInv hChildSubset hInjective
  have activeT3 : ∀ node, live.1.active node = true -> t3.active node = true := by
    intro node hnode
    have h1 : (live.1.stage1 A (word k)).active node = true := by
      simpa [stage1_active] using hnode
    have h2 := stage2_preserves_active_node_active A (live.1.stage1 A (word k))
      plan h1
    simpa [t3, stage3_active] using h2
  have nameT3 : ∀ node, live.1.active node = true ->
      (t3.name node).val = (live.1.name node).val := by
    intro node hnode
    have h1 : (live.1.stage1 A (word k)).active node = true := by
      simpa [stage1_active] using hnode
    have h2 := stage2_preserves_active_node_name A (live.1.stage1 A (word k))
      plan h1
    simp only [t3, stage3_name, h2, stage1_name]
  have hchildUnion :
      target ∈ t3.childLabelUnion A sourceNode := by
    rw [childLabelUnion, Finset.mem_biUnion]
    exact ⟨child, by simpa [t3, plan] using hchild,
      by simpa [t3, plan] using htargetChild⟩
  have hsourceAncestor :
      t3.IsAncestorOrSelf A sourceNode v :=
    stage3_sourceNode_isAncestorOrSelf_of_settled_childUnion
      A run hrun hrunNext htarget hsourceActive hsourceName
      (by simpa [t3, plan] using hchildUnion)
      hvActive hvName hvNext hmlt
  have hsourceNeV : sourceNode ≠ v := by
    intro hsame
    have hnames : m = a := by
      rw [← hsourceName, ← hvName, hsame]
    omega
  obtain ⟨pathChild, hpathChild, hpathAncestor⟩ :=
    exists_child_of_isAncestorOrSelf_ne A t3 hwfRoot hwfParent
      (activeT3 v hvActive) hsourceAncestor hsourceNeV
  have hnextTree : next.1 = liveNextTree A live (word k) :=
    automaton_run_live_nextTree A word hrun hrunNext
  have hvMemT3 : target ∈ t3.label v := by
    have hsub :=
      transitionWithPlan_label_subset_stage3 A live.1 (word k)
        (livePlan A live (word k)) v
    have hvMemNext : target ∈ next.1.label v := by rw [← htarget]; exact hvNext
    rw [hnextTree] at hvMemNext
    exact hsub hvMemNext
  have htargetPathChild : target ∈ t3.label pathChild :=
    label_subset_of_isAncestorOrSelf A t3 hwfRoot hwfParent hwfChild
      (activeT3 v hvActive) hpathAncestor hvMemT3
  have hchildEq : child = pathChild := by
    by_contra hne
    have hdisjoint :=
      hwfSibling sourceNode child pathChild
        (by simpa [t3, plan] using hchild) hpathChild hne
    exact (Finset.disjoint_left.mp hdisjoint
      (by simpa [t3, plan] using htargetChild)) htargetPathChild
  rw [hchildEq]
  exact hpathAncestor

theorem automaton_run_live_active_label_segment_from_same_node
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live next : LiveState A}
    {node : Node A} {target : A.State}
    (hrun : (automaton A).run word n = some live)
    (hrunNext : (automaton A).run word (n + 1) = some next)
    (hactive : live.1.active node = true)
    (htarget : target ∈ next.1.label node) :
    ∃ source,
      source ∈ live.1.label node ∧
        Segment A word n 1 source target := by
  have hnextTree : next.1 = liveNextTree A live (word n) :=
    automaton_run_live_nextTree A word hrun hrunNext
  apply liveNextTree_active_label_segment_from_same_node A word live hactive
  rw [← hnextTree]
  exact htarget

/--
Run-level form of name nonincrease for an old active node that carries a state
in the next live tree.
-/
theorem automaton_run_live_name_val_le_of_active_next_label
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live next : LiveState A}
    {node : Node A} {target : A.State}
    (hrun : (automaton A).run word n = some live)
    (hrunNext : (automaton A).run word (n + 1) = some next)
    (hactive : live.1.active node = true)
    (htarget : target ∈ next.1.label node) :
    (next.1.name node).val ≤ (live.1.name node).val := by
  have hnextTree : next.1 = liveNextTree A live (word n) :=
    automaton_run_live_nextTree A word hrun hrunNext
  rw [hnextTree] at htarget ⊢
  exact liveNextTree_name_val_le_of_active_next_label A live (word n)
    hactive htarget

/--
Run-level stage-(6) compaction witness.  If an old active node still carries a
state in the next live tree but its dynamic name strictly decreases, then the
transition removed some lower-name node before it.  This is the local arithmetic
source of Piterman's finite "move to a smaller name" argument.
-/
theorem automaton_run_live_name_drop_exists_removed_before
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live next : LiveState A}
    {node : Node A} {target : A.State}
    (hrun : (automaton A).run word n = some live)
    (hrunNext : (automaton A).run word (n + 1) = some next)
    (hactive : live.1.active node = true)
    (htarget : target ∈ next.1.label node)
    (hdrop : (next.1.name node).val < (live.1.name node).val) :
    let t1 := live.1.stage1 A (word n)
    let plan := (livePlan A live (word n)).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    let t4 := t3.stage4 A
    let t5 := t4.stage5 A (t3.greenRemovedNodes A)
    let removed := t3.greenRemovedNodes A ∪ t4.emptyActiveNodes A
    ∃ old,
      old ∈ removed ∧ (t5.name old).val < (live.1.name node).val := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let stage4Removed := t3.greenRemovedNodes A
  let t5 := t4.stage5 A stage4Removed
  let stage5Removed := stage4Removed ∪ t4.emptyActiveNodes A
  have hnextTree : next.1 = liveNextTree A live (word n) :=
    automaton_run_live_nextTree A word hrun hrunNext
  have htargetFinal :
      target ∈ (t5.stage6 A stage5Removed).label node := by
    rw [hnextTree] at htarget
    simpa [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed] using htarget
  have hlabelT5 : t5.label node ≠ ∅ := by
    intro hempty
    rw [stage6_preserves_label A t5 stage5Removed node, hempty] at htargetFinal
    simp at htargetFinal
  have hactive1 : t1.active node = true := by
    simpa [t1, stage1_active A live.1 (word n) node] using hactive
  have hnameT5 :
      (t5.name node).val = (live.1.name node).val := by
    rw [show t5.name node = t4.name node from
      stage5_name A t4 stage4Removed node]
    rw [show t4.name node = t3.name node from stage4_name A t3 node]
    rw [show t3.name node = t2.name node from stage3_name A t2 node]
    rw [show t2.name node = t1.name node from
      stage2_preserves_active_node_name A t1 plan hactive1]
    rw [show t1.name node = live.1.name node from
      stage1_name A live.1 (word n) node]
  have hnextNameStage6 :
      next.1.name node = (t5.stage6 A stage5Removed).name node := by
    rw [hnextTree]
    simp [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed]
  have hstage6Drop :
      ((t5.stage6 A stage5Removed).name node).val < (t5.name node).val := by
    rw [← hnextNameStage6, hnameT5]
    exact hdrop
  rcases live.2 with
    ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
      _hinactiveLabel, _hbound, hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have ht1_injective :
      ∀ left right,
        t1.active left = true ->
        t1.active right = true ->
        t1.name left = t1.name right ->
          left = right := by
    simpa [t1] using
      (stage1_preserves_name_injective A live.1 (word n) hinjective)
  have ht2_injective :
      ∀ left right,
        t2.active left = true ->
        t2.active right = true ->
        t2.name left = t2.name right ->
          left = right := by
    simpa [t2] using
      (stage2_preserves_name_injective A t1 plan ht1_injective)
  have ht3_injective :
      ∀ left right,
        t3.active left = true ->
        t3.active right = true ->
        t3.name left = t3.name right ->
          left = right := by
    simpa [t3] using
      (stage3_preserves_name_injective A t2 ht2_injective)
  have hremovedInjective :
      ∀ left right,
        left ∈ stage5Removed ->
        right ∈ stage5Removed ->
        t5.name left = t5.name right ->
          left = right := by
    intro left right hleft hright hname
    exact
      stage4_stage5_name_injective_on_removed_or_active A t3 ht3_injective
        left right
        (Or.inl (by simpa [t4, stage4Removed, t5, stage5Removed] using hleft))
        (Or.inl (by simpa [t4, stage4Removed, t5, stage5Removed] using hright))
        (by simpa [t4, stage4Removed, t5, stage5Removed] using hname)
  rcases
      stage6_nonempty_name_val_lt_oldName_exists_removedBeforeName_of_removed_name_injective
        A t5 stage5Removed hlabelT5 hremovedInjective hstage6Drop with
    ⟨old, hold, hnameOldLt⟩
  refine ⟨old, ?_, ?_⟩
  · simpa [t4, stage4Removed, t5, stage5Removed] using hold
  · rwa [hnameT5] at hnameOldLt

/--
Run-level threshold form of the stage-(6) compaction witness.  If an old active
node carries a state in the next live tree, its old name is at least `threshold`,
and its next name is below `threshold`, then the transition removed a node whose
old stage-(5) name was below `threshold`.
-/
theorem automaton_run_live_name_threshold_drop_exists_removed_before
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live next : LiveState A}
    {node : Node A} {target : A.State} {threshold : Nat}
    (hrun : (automaton A).run word n = some live)
    (hrunNext : (automaton A).run word (n + 1) = some next)
    (hactive : live.1.active node = true)
    (htarget : target ∈ next.1.label node)
    (hthreshold : threshold ≤ (live.1.name node).val)
    (hdrop : (next.1.name node).val < threshold) :
    let t1 := live.1.stage1 A (word n)
    let plan := (livePlan A live (word n)).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    let t4 := t3.stage4 A
    let t5 := t4.stage5 A (t3.greenRemovedNodes A)
    let removed := t3.greenRemovedNodes A ∪ t4.emptyActiveNodes A
    ∃ old,
      old ∈ removed ∧ (t5.name old).val < threshold := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let stage4Removed := t3.greenRemovedNodes A
  let t5 := t4.stage5 A stage4Removed
  let stage5Removed := stage4Removed ∪ t4.emptyActiveNodes A
  have hnextTree : next.1 = liveNextTree A live (word n) :=
    automaton_run_live_nextTree A word hrun hrunNext
  have htargetFinal :
      target ∈ (t5.stage6 A stage5Removed).label node := by
    rw [hnextTree] at htarget
    simpa [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed] using htarget
  have hlabelT5 : t5.label node ≠ ∅ := by
    intro hempty
    rw [stage6_preserves_label A t5 stage5Removed node, hempty] at htargetFinal
    simp at htargetFinal
  have hactive1 : t1.active node = true := by
    simpa [t1, stage1_active A live.1 (word n) node] using hactive
  have hnameT5 :
      (t5.name node).val = (live.1.name node).val := by
    rw [show t5.name node = t4.name node from
      stage5_name A t4 stage4Removed node]
    rw [show t4.name node = t3.name node from stage4_name A t3 node]
    rw [show t3.name node = t2.name node from stage3_name A t2 node]
    rw [show t2.name node = t1.name node from
      stage2_preserves_active_node_name A t1 plan hactive1]
    rw [show t1.name node = live.1.name node from
      stage1_name A live.1 (word n) node]
  have hnextNameStage6 :
      next.1.name node = (t5.stage6 A stage5Removed).name node := by
    rw [hnextTree]
    simp [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed]
  have hstage6Drop :
      ((t5.stage6 A stage5Removed).name node).val < threshold := by
    rwa [← hnextNameStage6]
  rcases live.2 with
    ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
      _hinactiveLabel, _hbound, hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have ht1_injective :
      ∀ left right,
        t1.active left = true ->
        t1.active right = true ->
        t1.name left = t1.name right ->
          left = right := by
    simpa [t1] using
      (stage1_preserves_name_injective A live.1 (word n) hinjective)
  have ht2_injective :
      ∀ left right,
        t2.active left = true ->
        t2.active right = true ->
        t2.name left = t2.name right ->
          left = right := by
    simpa [t2] using
      (stage2_preserves_name_injective A t1 plan ht1_injective)
  have ht3_injective :
      ∀ left right,
        t3.active left = true ->
        t3.active right = true ->
        t3.name left = t3.name right ->
          left = right := by
    simpa [t3] using
      (stage3_preserves_name_injective A t2 ht2_injective)
  have hremovedInjective :
      ∀ left right,
        left ∈ stage5Removed ->
        right ∈ stage5Removed ->
        t5.name left = t5.name right ->
          left = right := by
    intro left right hleft hright hname
    exact
      stage4_stage5_name_injective_on_removed_or_active A t3 ht3_injective
        left right
        (Or.inl (by simpa [t4, stage4Removed, t5, stage5Removed] using hleft))
        (Or.inl (by simpa [t4, stage4Removed, t5, stage5Removed] using hright))
        (by simpa [t4, stage4Removed, t5, stage5Removed] using hname)
  have hthresholdT5 : threshold ≤ (t5.name node).val := by
    omega
  rcases
      stage6_nonempty_name_val_lt_threshold_exists_removedBeforeName
        A t5 stage5Removed hlabelT5 hremovedInjective hthresholdT5
        hstage6Drop with
    ⟨old, hold, hnameOldLt⟩
  refine ⟨old, ?_, ?_⟩
  · simpa [t4, stage4Removed, t5, stage5Removed] using hold
  · exact hnameOldLt

/--
Fresh-child threshold form of the stage-(6) compaction witness.  A child born in
stage (2) has a fresh name strictly above every old active name, in particular
above its predecessor parent.  Therefore, if the successor tree still carries a
state at that fresh child but the final compacted name is below `threshold`,
stage (6) must have crossed a removed node whose pre-compaction name is below
`threshold`.
-/
theorem automaton_run_fresh_child_name_threshold_drop_exists_removed_before
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live next : LiveState A}
    {parent node : Node A} {target : A.State} {threshold : Nat}
    (hrun : (automaton A).run word n = some live)
    (hrunNext : (automaton A).run word (n + 1) = some next)
    (htrigger : parent ∈ (live.1.stage1 A (word n)).stage2Triggers A)
    (hfresh : (livePlan A live (word n)).stage2Plan.freshChild parent = node)
    (hparentThreshold : threshold ≤ (live.1.name parent).val)
    (htarget : target ∈ next.1.label node)
    (hdrop : (next.1.name node).val < threshold) :
    let t1 := live.1.stage1 A (word n)
    let plan := (livePlan A live (word n)).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    let t4 := t3.stage4 A
    let t5 := t4.stage5 A (t3.greenRemovedNodes A)
    let removed := t3.greenRemovedNodes A ∪ t4.emptyActiveNodes A
    ∃ old,
      old ∈ removed ∧ (t5.name old).val < threshold := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let stage4Removed := t3.greenRemovedNodes A
  let t5 := t4.stage5 A stage4Removed
  let stage5Removed := stage4Removed ∪ t4.emptyActiveNodes A
  have hnextTree : next.1 = liveNextTree A live (word n) :=
    automaton_run_live_nextTree A word hrun hrunNext
  have htargetFinal :
      target ∈ (t5.stage6 A stage5Removed).label node := by
    rw [hnextTree] at htarget
    simpa [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed] using htarget
  have hlabelT5 : t5.label node ≠ ∅ := by
    intro hempty
    rw [stage6_preserves_label A t5 stage5Removed node, hempty] at htargetFinal
    simp at htargetFinal
  have hparentActiveT1 : t1.active parent = true :=
    (mem_stage2Triggers A t1).mp (by simpa [t1] using htrigger) |>.1
  have hparentNameT1 :
      (t1.name parent).val = (live.1.name parent).val := by
    simpa [t1, stage1_name A live.1 (word n) parent]
  have hfreshNameGtParent :
      (t1.name parent).val < (plan.freshName parent).val :=
    stage2_fresh_name_gt_active_name A t1 plan
      (by simpa [t1] using htrigger) hparentActiveT1
  have hnameT5 :
      (t5.name node).val = (plan.freshName parent).val := by
    rw [show t5.name node = t4.name node from
      stage5_name A t4 stage4Removed node]
    rw [show t4.name node = t3.name node from stage4_name A t3 node]
    rw [show t3.name node = t2.name node from stage3_name A t2 node]
    rw [← hfresh]
    rw [show t2.name (plan.freshChild parent) = plan.freshName parent from
      stage2_freshChild_name A t1 plan (by simpa [t1] using htrigger)]
  have hnextNameStage6 :
      next.1.name node = (t5.stage6 A stage5Removed).name node := by
    rw [hnextTree]
    simp [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed]
  have hstage6Drop :
      ((t5.stage6 A stage5Removed).name node).val < threshold := by
    rwa [← hnextNameStage6]
  rcases live.2 with
    ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
      _hinactiveLabel, _hbound, hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have ht1_injective :
      ∀ left right,
        t1.active left = true ->
        t1.active right = true ->
        t1.name left = t1.name right ->
          left = right := by
    simpa [t1] using
      (stage1_preserves_name_injective A live.1 (word n) hinjective)
  have ht2_injective :
      ∀ left right,
        t2.active left = true ->
        t2.active right = true ->
        t2.name left = t2.name right ->
          left = right := by
    simpa [t2] using
      (stage2_preserves_name_injective A t1 plan ht1_injective)
  have ht3_injective :
      ∀ left right,
        t3.active left = true ->
        t3.active right = true ->
        t3.name left = t3.name right ->
          left = right := by
    simpa [t3] using
      (stage3_preserves_name_injective A t2 ht2_injective)
  have hremovedInjective :
      ∀ left right,
        left ∈ stage5Removed ->
        right ∈ stage5Removed ->
        t5.name left = t5.name right ->
          left = right := by
    intro left right hleft hright hname
    exact
      stage4_stage5_name_injective_on_removed_or_active A t3 ht3_injective
        left right
        (Or.inl (by simpa [t4, stage4Removed, t5, stage5Removed] using hleft))
        (Or.inl (by simpa [t4, stage4Removed, t5, stage5Removed] using hright))
        (by simpa [t4, stage4Removed, t5, stage5Removed] using hname)
  have hthresholdT5 : threshold ≤ (t5.name node).val := by
    omega
  rcases
      stage6_nonempty_name_val_lt_threshold_exists_removedBeforeName
        A t5 stage5Removed hlabelT5 hremovedInjective hthresholdT5
        hstage6Drop with
    ⟨old, hold, hnameOldLt⟩
  refine ⟨old, ?_, ?_⟩
  · simpa [t4, stage4Removed, t5, stage5Removed] using hold
  · exact hnameOldLt

/--
Run-level stage-(6) converse: if a node still carries a state in the successor
tree and its numeric name did not decrease from the stage-(3) tree, then the
transition's deletion register `e` is strictly above that name.  Otherwise a
removed node of name at most this one would force compaction to lower the name
(or would be the same node, contradicting survival).
-/
theorem automaton_run_live_stage3_same_name_e_gt
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live next : LiveState A}
    {node : Node A} {target : A.State}
    (hrun : (automaton A).run word n = some live)
    (hrunNext : (automaton A).run word (n + 1) = some next)
    (htarget : target ∈ next.1.label node)
    (hnameSame :
      (next.1.name node).val =
        ((((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).stage3 A).name node).val) :
    ((((live.1.stage1 A (word n)).stage2 A
      (livePlan A live (word n)).stage2Plan).stage3 A).name node).val <
      next.1.e.val := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let stage4Removed := t3.greenRemovedNodes A
  let t5 := t4.stage5 A stage4Removed
  let stage5Removed := stage4Removed ∪ t4.emptyActiveNodes A
  have hnextTree : next.1 = liveNextTree A live (word n) :=
    automaton_run_live_nextTree A word hrun hrunNext
  have htargetFinal :
      target ∈ (t5.stage6 A stage5Removed).label node := by
    rw [hnextTree] at htarget
    simpa [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed] using htarget
  have hlabelT5 : t5.label node ≠ ∅ := by
    intro hempty
    rw [stage6_preserves_label A t5 stage5Removed node, hempty] at htargetFinal
    simp at htargetFinal
  rcases live.2 with
    ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
      hinactiveLabel, _hbound, hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have ht1_inactive :
      ∀ node, t1.active node = false -> t1.label node = ∅ := by
    simpa [t1] using
      (stage1_preserves_inactive_label A live.1 (word n) hinactiveLabel)
  have ht3_inactive :
      ∀ node, t3.active node = false -> t3.label node = ∅ := by
    simpa [t1, plan, t2, t3] using
      (stage2_stage3_preserves_inactive_label A t1 plan ht1_inactive)
  have ht5_inactive :
      ∀ node, t5.active node = false -> t5.label node = ∅ := by
    simpa [t4, t5, stage4Removed] using
      (stage4_stage5_preserves_inactive_label A t3 stage4Removed ht3_inactive)
  have hactiveT5 : t5.active node = true := by
    by_contra hnot
    have hfalse : t5.active node = false := by
      cases hact : t5.active node with
      | true => exact (hnot hact).elim
      | false => rfl
    exact hlabelT5 (ht5_inactive node hfalse)
  have hnotRemoved : node ∉ stage5Removed := by
    simpa [t4, t5, stage4Removed, stage5Removed] using
      (stage4_stage5_active_not_removed A t3 node hactiveT5)
  have ht1_injective :
      ∀ left right,
        t1.active left = true ->
        t1.active right = true ->
        t1.name left = t1.name right ->
          left = right := by
    simpa [t1] using
      (stage1_preserves_name_injective A live.1 (word n) hinjective)
  have ht2_injective :
      ∀ left right,
        t2.active left = true ->
        t2.active right = true ->
        t2.name left = t2.name right ->
          left = right := by
    simpa [t2] using
      (stage2_preserves_name_injective A t1 plan ht1_injective)
  have ht3_injective :
      ∀ left right,
        t3.active left = true ->
        t3.active right = true ->
        t3.name left = t3.name right ->
          left = right := by
    simpa [t3] using
      (stage3_preserves_name_injective A t2 ht2_injective)
  have hinjectiveRemovedOrActive :
      ∀ left right,
        (left ∈ stage5Removed ∨ t5.active left = true) ->
        (right ∈ stage5Removed ∨ t5.active right = true) ->
        t5.name left = t5.name right ->
          left = right := by
    simpa [t4, t5, stage4Removed, stage5Removed] using
      (stage4_stage5_name_injective_on_removed_or_active A t3 ht3_injective)
  have hnextActive : next.1.active node = true := by
    by_contra hnot
    have hfalse : next.1.active node = false := by
      cases hact : next.1.active node with
      | true => exact (hnot hact).elim
      | false => rfl
    rcases next.2 with
      ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
        hinactiveLabelNext, _hbound, _hinjective, _hconsecutive, _hproper,
        _hchildSubset, _hsiblingDisjoint⟩
    rw [hinactiveLabelNext node hfalse] at htarget
    simp at htarget
  have hnextBound : (next.1.name node).val < Fintype.card A.State := by
    rcases next.2 with
      ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
        _hinactiveLabel, hbound, _hinjective, _hconsecutive, _hproper,
        _hchildSubset, _hsiblingDisjoint⟩
    exact hbound node hnextActive
  have hnameT5T3 : (t5.name node).val = (t3.name node).val := by
    simp [t5, t4, stage5_name A t4 stage4Removed node,
      stage4_name A t3 node]
  have hnodeBound : (t5.name node).val < Fintype.card A.State := by
    have hsame' :
        (next.1.name node).val = (t3.name node).val := by
      simpa [t1, plan, t2, t3] using hnameSame
    omega
  have hstage6Same :
      ((t5.stage6 A stage5Removed).name node).val = (t5.name node).val := by
    have hnextNameStage6 :
        next.1.name node = (t5.stage6 A stage5Removed).name node := by
      rw [hnextTree]
      simp [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
        stage4Removed, t5, stage5Removed]
    have hsame' :
        (next.1.name node).val = (t3.name node).val := by
      simpa [t1, plan, t2, t3] using hnameSame
    rw [← hnextNameStage6]
    omega
  have hminGt :
      (t5.name node).val < (t5.minBoundedNameOf A stage5Removed).val :=
    stage6_nonempty_same_name_minBoundedNameOf_gt A t5 stage5Removed
      hlabelT5 hactiveT5 hnodeBound hnotRemoved hinjectiveRemovedOrActive
      hstage6Same
  have heqE :
      next.1.e.val = (t5.minBoundedNameOf A stage5Removed).val := by
    have hminEq :
        (t4.minBoundedNameOf A stage5Removed).val =
          (t5.minBoundedNameOf A stage5Removed).val := by
      simp [t5, minBoundedNameOf, stage5_name A t4 stage4Removed]
    rw [hnextTree]
    simp [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed, stage5_e_val, stage6_e_val,
      hminEq]
  have hgt : (t3.name node).val < next.1.e.val := by
    rw [heqE]
    rwa [hnameT5T3] at hminGt
  simpa [t1, plan, t2, t3] using hgt

theorem automaton_run_live_next_label_subset_stage3
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live next : LiveState A}
    (hrun : (automaton A).run word n = some live)
    (hrunNext : (automaton A).run word (n + 1) = some next)
    {node : Node A} :
    next.1.label node ⊆
      (((live.1.stage1 A (word n)).stage2 A
        (livePlan A live (word n)).stage2Plan).stage3 A).label node := by
  intro state hstate
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let stage4Removed := t3.greenRemovedNodes A
  let t5 := t4.stage5 A stage4Removed
  let stage5Removed := stage4Removed ∪ t4.emptyActiveNodes A
  have hnextTree : next.1 = liveNextTree A live (word n) :=
    automaton_run_live_nextTree A word hrun hrunNext
  have hstate_final :
      state ∈ (t5.stage6 A stage5Removed).label node := by
    rw [hnextTree] at hstate
    simpa [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed] using hstate
  have hstate_t5 : state ∈ t5.label node := by
    rwa [stage6_preserves_label A t5 stage5Removed node] at hstate_final
  have hstate_t4 : state ∈ t4.label node :=
    stage5_label_subset A t4 stage4Removed node hstate_t5
  exact stage4_label_subset A t3 node hstate_t4

theorem automaton_run_live_next_active_stage3_and_ancestor
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live next : LiveState A}
    (hrun : (automaton A).run word n = some live)
    (hrunNext : (automaton A).run word (n + 1) = some next)
    {ancestor descendant : Node A}
    (hactiveNext : next.1.active descendant = true)
    (hancestorNext : next.1.IsAncestorOrSelf A ancestor descendant) :
    let t3 :=
      (((live.1.stage1 A (word n)).stage2 A
        (livePlan A live (word n)).stage2Plan).stage3 A)
    t3.active descendant = true ∧
      t3.IsAncestorOrSelf A ancestor descendant := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let stage4Removed := t3.greenRemovedNodes A
  let t5 := t4.stage5 A stage4Removed
  let stage5Removed := stage4Removed ∪ t4.emptyActiveNodes A
  have hnextTree : next.1 = liveNextTree A live (word n) :=
    automaton_run_live_nextTree A word hrun hrunNext
  have hactiveFinal :
      (t5.stage6 A stage5Removed).active descendant = true := by
    rw [hnextTree] at hactiveNext
    simpa [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed] using hactiveNext
  have ht5Active : t5.active descendant = true := by
    simpa [stage6_active A t5 stage5Removed descendant] using hactiveFinal
  have ht4Active : t4.active descendant = true :=
    (stage5_active_cases A t4 stage4Removed ht5Active).1
  have ht3Active : t3.active descendant = true :=
    (stage4_active_cases A t3 ht4Active).1
  have hancestorFinal :
      (t5.stage6 A stage5Removed).IsAncestorOrSelf A ancestor descendant := by
    rw [hnextTree] at hancestorNext
    simpa [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed] using hancestorNext
  have ht3Ancestor : t3.IsAncestorOrSelf A ancestor descendant := by
    rcases hancestorFinal with ⟨steps, hsteps⟩
    refine ⟨steps, ?_⟩
    simpa [stage6_parent A t5 stage5Removed, stage5_parent A t4 stage4Removed,
      stage4_parent A t3] using hsteps
  exact ⟨by simpa [t1, plan, t2, t3] using ht3Active,
    by simpa [t1, plan, t2, t3] using ht3Ancestor⟩

theorem automaton_run_interval_active_label_segment_from_same_node
    [DecidableEq A.State]
    (word : OmegaWord Alphabet) (start length : Nat)
    (lives : Nat -> LiveState A)
    {node : Node A} {target : A.State}
    (hrun :
      ∀ i : Nat, i ≤ length ->
        (automaton A).run word (start + i) = some (lives i))
    (hactive :
      ∀ i : Nat, i < length ->
        (lives i).1.active node = true)
    (htarget : target ∈ (lives length).1.label node) :
    ∃ source,
      source ∈ (lives 0).1.label node ∧
        Segment A word start length source target := by
  revert target
  induction length with
  | zero =>
      intro target htarget
      exact ⟨target, by simpa using htarget,
        segment_zero A word start target⟩
  | succ length ih =>
      intro target htarget
      have hrunPrefix :
          ∀ i : Nat, i ≤ length ->
            (automaton A).run word (start + i) = some (lives i) := by
        intro i hi
        exact hrun i (by omega)
      have hactivePrefix :
          ∀ i : Nat, i < length ->
            (lives i).1.active node = true := by
        intro i hi
        exact hactive i (by omega)
      have hrunLast :
          (automaton A).run word (start + length) =
            some (lives length) :=
        hrun length (by omega)
      have hrunNext :
          (automaton A).run word ((start + length) + 1) =
            some (lives (length + 1)) := by
        have h := hrun (length + 1) (by omega)
        have hidx : start + (length + 1) = (start + length) + 1 := by
          omega
        simpa [hidx] using h
      rcases automaton_run_live_active_label_segment_from_same_node
          A word hrunLast hrunNext
          (hactive length (Nat.lt_succ_self length)) htarget with
        ⟨middle, hmiddle, hstepSegment⟩
      rcases ih hrunPrefix hactivePrefix hmiddle with
        ⟨source, hsource, hprefixSegment⟩
      refine ⟨source, hsource, ?_⟩
      have hcombined :=
        segment_append A word hprefixSegment hstepSegment
      simpa [Nat.add_assoc] using hcombined

theorem automaton_run_interval_preserves_active_name_of_no_smaller_event
    [DecidableEq A.State]
    (word : OmegaWord Alphabet) (start length : Nat)
    (lives : Nat -> LiveState A)
    {node : Node A}
    (hrun :
      ∀ i : Nat, i ≤ length ->
        (automaton A).run word (start + i) = some (lives i))
    (hactive0 : (lives 0).1.active node = true)
    (hbound0 : ((lives 0).1.name node).val < Fintype.card A.State)
    (hnoSmaller :
      ∀ i : Nat, i < length ->
        (lives i).1.active node = true ->
        ((lives i).1.name node).val = ((lives 0).1.name node).val ->
          ((lives i).1.name node).val ≤
              ((liveNextTree A (lives i) (word (start + i))).f).val ∧
            ((lives i).1.name node).val <
              ((liveNextTree A (lives i) (word (start + i))).e).val) :
    ∀ i : Nat, i ≤ length ->
      (lives i).1.active node = true ∧
        ((lives i).1.name node).val =
          ((lives 0).1.name node).val := by
  apply liveSequence_preserves_active_name_of_no_smaller_event A word start
    length lives
  · intro i hi
    have hrun_i :
        (automaton A).run word (start + i) = some (lives i) :=
      hrun i (by omega)
    have hrun_next :
        (automaton A).run word ((start + i) + 1) =
          some (lives (i + 1)) := by
      have h := hrun (i + 1) (by omega)
      have hidx : start + (i + 1) = (start + i) + 1 := by omega
      simpa [hidx] using h
    exact automaton_run_live_nextTree A word hrun_i hrun_next
  · exact hactive0
  · exact hbound0
  · exact hnoSmaller

theorem automaton_run_interval_preserves_active_name_of_next_bounds
    [DecidableEq A.State]
    (word : OmegaWord Alphabet) (start length : Nat)
    (lives : Nat -> LiveState A)
    {node : Node A}
    (hrun :
      ∀ i : Nat, i ≤ length ->
        (automaton A).run word (start + i) = some (lives i))
    (hactive0 : (lives 0).1.active node = true)
    (hbound0 : ((lives 0).1.name node).val < Fintype.card A.State)
    (hnoSmallerNext :
      ∀ i : Nat, i < length ->
        (lives i).1.active node = true ->
        ((lives i).1.name node).val = ((lives 0).1.name node).val ->
          ((lives i).1.name node).val ≤ ((lives (i + 1)).1.f).val ∧
            ((lives i).1.name node).val < ((lives (i + 1)).1.e).val) :
    ∀ i : Nat, i ≤ length ->
      (lives i).1.active node = true ∧
        ((lives i).1.name node).val =
          ((lives 0).1.name node).val := by
  apply automaton_run_interval_preserves_active_name_of_no_smaller_event
    A word start length lives
  · exact hrun
  · exact hactive0
  · exact hbound0
  · intro i hi hactive hname
    rcases hnoSmallerNext i hi hactive hname with ⟨hfNext, heNext⟩
    have hrun_i :
        (automaton A).run word (start + i) = some (lives i) :=
      hrun i (by omega)
    have hrun_next :
        (automaton A).run word ((start + i) + 1) =
          some (lives (i + 1)) := by
      have h := hrun (i + 1) (by omega)
      have hidx : start + (i + 1) = (start + i) + 1 := by omega
      simpa [hidx] using h
    have hnextTree :
        (lives (i + 1)).1 =
          liveNextTree A (lives i) (word (start + i)) :=
      automaton_run_live_nextTree A word hrun_i hrun_next
    constructor
    · simpa [hnextTree] using hfNext
    · simpa [hnextTree] using heNext

theorem automaton_run_interval_preserves_active_name_of_fixed_next_bounds
    [DecidableEq A.State]
    (word : OmegaWord Alphabet) (start length : Nat)
    (lives : Nat -> LiveState A)
    {node : Node A} {m : Nat}
    (hrun :
      ∀ i : Nat, i ≤ length ->
        (automaton A).run word (start + i) = some (lives i))
    (hactive0 : (lives 0).1.active node = true)
    (hbound0 : ((lives 0).1.name node).val < Fintype.card A.State)
    (hname0 : ((lives 0).1.name node).val = m)
    (hnoSmallerNext :
      ∀ i : Nat, i < length ->
        m ≤ ((lives (i + 1)).1.f).val ∧
          m < ((lives (i + 1)).1.e).val) :
    ∀ i : Nat, i ≤ length ->
      (lives i).1.active node = true ∧
        ((lives i).1.name node).val = m := by
  intro i hi
  have hpreserve :
      ∀ j : Nat, j ≤ length ->
        (lives j).1.active node = true ∧
          ((lives j).1.name node).val =
            ((lives 0).1.name node).val :=
    automaton_run_interval_preserves_active_name_of_next_bounds
      A word start length lives hrun hactive0 hbound0
      (by
        intro j hj _hactive hname
        rcases hnoSmallerNext j hj with ⟨hf, he⟩
        constructor <;> omega)
  rcases hpreserve i hi with ⟨hactive, hname⟩
  exact ⟨hactive, by omega⟩

theorem automaton_run_green_event_survives_to_next
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {k : Nat} {prev next : LiveState A}
    {recurrentName : Name A} {green : Node A}
    (hprev : (automaton A).run word k = some prev)
    (hnext : (automaton A).run word (k + 1) = some next)
    (hnextName : next.1.f = recurrentName)
    (hgreen :
      green ∈
        (((prev.1.stage1 A (word k)).stage2 A
          (livePlan A prev (word k)).stage2Plan).stage3 A).greenNodes A)
    (hgreenName :
      ((((prev.1.stage1 A (word k)).stage2 A
          (livePlan A prev (word k)).stage2Plan).stage3 A).name green).val =
        recurrentName.val)
    (hgreenE : recurrentName.val < next.1.e.val) :
    next.1.active green = true ∧
      (next.1.name green).val = recurrentName.val := by
  let t1 := prev.1.stage1 A (word k)
  let t2 := t1.stage2 A (livePlan A prev (word k)).stage2Plan
  let t3 := t2.stage3 A
  have hactive3 : t3.active green = true :=
    (mem_greenNodes A t3).mp (by simpa [t1, t2, t3] using hgreen) |>.1
  have hbound3 : (t3.name green).val < Fintype.card A.State := by
    have heBound : next.1.e.val < Fintype.card A.State + 1 :=
      next.1.e.2
    have hname : (t3.name green).val = recurrentName.val := by
      simpa [t1, t2, t3] using hgreenName
    omega
  have hnextTree :
      next.1 = liveNextTree A prev (word k) :=
    automaton_run_live_nextTree A word hprev hnext
  have hf :
      (t3.name green).val ≤
        ((liveNextTree A prev (word k)).f).val := by
    have hname : (t3.name green).val = recurrentName.val := by
      simpa [t1, t2, t3] using hgreenName
    have hfnext : ((liveNextTree A prev (word k)).f).val = recurrentName.val := by
      rw [← hnextTree]
      exact congrArg Fin.val hnextName
    omega
  have he :
      (t3.name green).val <
        ((liveNextTree A prev (word k)).e).val := by
    have hname : (t3.name green).val = recurrentName.val := by
      simpa [t1, t2, t3] using hgreenName
    have henext : ((liveNextTree A prev (word k)).e).val = next.1.e.val := by
      rw [← hnextTree]
    omega
  rcases liveNextTree_preserves_active_name_of_no_smaller_event
      A prev (word k) (node := green) hactive3 hbound3 hf he with
    ⟨hactiveNext, hnameNext⟩
  constructor
  · rw [hnextTree]
    exact hactiveNext
  · rw [hnextTree]
    rw [hnameNext]
    simpa [t1, t2, t3] using hgreenName

theorem automaton_run_green_event_next_no_child_of_green
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
