                prev.1.active sourceNode = true ∧
                sources i ∈ prev.1.label sourceNode ∧
                (prev.1.name sourceNode).val = smallerSourceName) :
    (automaton A).Accepts word := by
  refine
    automaton_accepts_of_accepts_of_minLowerPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorMinFixedNameCutoffNextNameRawSourceLtCutHandlers
      A haccepts eqSourceCutHandler acceptingChildSourceCutHandler ?_
  intro run hrunAccepts v a hsettle hng hsourceBranch
  rcases hsourceBranch with
    ⟨m, childName, smallerSourceName, sourceNode, child, sourceState, target,
      uncovered, N, cuts, sources, hmMem, hmLtChildName, hchildNameLe,
      hsmallerSourceMem, hnoSmallerLower, hnoSmallerChildName, hfreqSourceLt,
      hzero, hstrict, hcutsAfter, hevents, hsources⟩
  have hlabels :=
    sourcePredecessorLabelHandler run hrunAccepts v a hsettle hng
      m childName smallerSourceName sourceNode child sourceState target
      uncovered N cuts sources hmMem hmLtChildName hchildNameLe
      hsmallerSourceMem hnoSmallerLower hnoSmallerChildName hfreqSourceLt
      hzero hstrict hcutsAfter hevents hsources
  exact False.elim
    (acceptingNodeNameStateReachableCuts_predecessor_labels_contradict_no_smaller
      A run (Finset.mem_range.mp hsmallerSourceMem) hstrict hnoSmallerLower
      hevents hsources hlabels)

/--
Green-horn wrapper in the actual accepting-run shape: an accepting NBW witness
supplies the "DPW run is live at every time" premise needed by
`automaton_accepts_of_runNodeGreensIO_eventually_name_event_bounds`.
-/
theorem automaton_accepts_of_accepting_runNodeGreensIO_eventually_name_event_bounds
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hgreens : RunNodeGreensIO A run v)
    (hstable :
      ∃ N : Nat, ∀ k : Nat, N ≤ k ->
        ∀ live : LiveState A,
          (automaton A).run word k = some live ->
            (live.1.f.val < live.1.e.val -> a ≤ live.1.f.val) ∧
            (¬ live.1.f.val < live.1.e.val -> a < live.1.e.val)) :
    (automaton A).Accepts word :=
  automaton_accepts_of_runNodeGreensIO_eventually_name_event_bounds A run
    (fun k => automaton_run_some_of_accepts A ⟨run, hrunAccepts⟩ k)
    hsettle hgreens hstable

/--
Green horn reduced to the remaining lower-green exclusion.  Settling already
forces `e > a` eventually (`runSettles_eventually_next_e_gt_settled_name`), so
to close the eventual `f/e` stability condition it suffices to prove that every
sufficiently late green event has `f ≥ a`.
-/
theorem automaton_accepts_of_accepting_runNodeGreensIO_eventually_f_ge_settled_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hgreens : RunNodeGreensIO A run v)
    (hfStable :
      ∃ N : Nat, ∀ k : Nat, N ≤ k ->
        ∀ live : LiveState A,
          (automaton A).run word k = some live ->
            live.1.f.val < live.1.e.val -> a ≤ live.1.f.val) :
    (automaton A).Accepts word := by
  rcases hfStable with ⟨Nf, hfStable⟩
  rcases runSettles_eventually_next_e_gt_settled_name A run hsettle with
    ⟨Ne, heStableNext⟩
  refine
    automaton_accepts_of_accepting_runNodeGreensIO_eventually_name_event_bounds
      A run hrunAccepts hsettle hgreens ?_
  refine ⟨max Nf (Ne + 1), ?_⟩
  intro k hk live hrun
  constructor
  · intro hfe
    exact hfStable k (le_trans (le_max_left Nf (Ne + 1)) hk) live hrun hfe
  · intro _hnfe
    have hkpos : 0 < k := by
      have hNe1 : Ne + 1 ≤ k := le_trans (le_max_right Nf (Ne + 1)) hk
      omega
    let j := k - 1
    have hjEq : j + 1 = k := by
      omega
    have hNej : Ne ≤ j := by
      have hNe1 : Ne + 1 ≤ k := le_trans (le_max_right Nf (Ne + 1)) hk
      omega
    rcases automaton_run_some_of_accepts A ⟨run, hrunAccepts⟩ j with
      ⟨prev, hprev⟩
    have he :=
      heStableNext j hNej prev live hprev (by simpa [hjEq] using hrun)
    exact he

/--
Even-priority packaging: a live state with `f < e` recurring with fixed `f = m`
makes the even priority `2 m` recur.
-/
theorem automaton_prioritySeenInfinitelyOften_two_mul_of_frequently_f_lt_e
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {m : Nat}
    (hfreq : ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      ∃ live : LiveState A, (automaton A).run word k = some live ∧
        live.1.f.val < live.1.e.val ∧ live.1.f.val = m) :
    (automaton A).PrioritySeenInfinitelyOften word (2 * m) := by
  intro n
  obtain ⟨k, hk, live, hrun, hfe, hfm⟩ := hfreq n
  refine ⟨k, hk, ?_⟩
  rw [hrun, automaton_priority_live]
  unfold priority
  rw [if_pos hfe, hfm]

/--
Odd-priority extraction: an odd priority recurring along an accepting run is
realized infinitely often by a live state with `f ≥ e` (a same-name deletion).
-/
theorem exists_frequently_f_ge_e_of_prioritySeenInfinitelyOften_odd
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {p : Nat}
    (haccepts : A.Accepts word)
    (hp : (automaton A).PrioritySeenInfinitelyOften word p)
    (hodd : ¬ DetParityAutomaton.NatEven p) :
    ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      ∃ live : LiveState A, (automaton A).run word k = some live ∧
        ¬ live.1.f.val < live.1.e.val ∧ priority A live.1 = p := by
  intro n
  obtain ⟨k, hk, hkprio⟩ := hp n
  obtain ⟨live, hrun⟩ := automaton_run_some_of_accepts A haccepts k
  refine ⟨k, hk, live, hrun, ?_, ?_⟩
  · intro hfe
    apply hodd
    rw [← hkprio, hrun, automaton_priority_live]
    exact priority_even_of_f_lt_e A live.1 hfe
  · rw [← hkprio, hrun, automaton_priority_live]

/-!
### Forward direction (NBW ⟹ DPW): descent skeleton

`accepts_of_automaton_accepts` is the reverse direction.  The forward direction
`A.Accepts word -> (automaton A).Accepts word` is, by
`DetParityAutomaton.accepts_iff_natEven_of_min`, equivalent to: *whenever the NBW
accepts, the minimum priority seen infinitely often along the DPW run is even*.

The standard Piterman/parity argument proves that minimum is even by a finite
descent over names `0..n` (the construction's `f`/`e` events).  The recurrent
priorities are `2 m` for a green event at name `m` (`f = m < e`, even) and the
odd `2 m - 1` for a same-name deletion at name `m` (`f ≥ e`).  Suppose the
minimal recurrent priority `p` were odd, i.e. a same-name deletion at the
minimal recurrent name happens infinitely often.  Following the accepting NBW
run inside the root label (the König step
`exists_seq_forall_proj_of_forall_finite`, already used for the reverse
direction) down to a label frontier produces a recurrent *green* event at a name
no larger than that of the deletion, hence an even priority `p' ≤ p` seen
infinitely often.  Minimality forces `p' = p`, contradicting the oddness of `p`.

The skeleton below discharges everything except that green-descent step, which is
exposed as the single hypothesis `hDescent` and is the genuine remaining content
of Piterman completeness.  It is filled incrementally on top of the checked
root-frontier / survives / lower-name scaffolding
(`automaton_accepts_rootStage2Survives_or_lowerName_cuts_of_accepts`,
`automaton_accepts_acceptingTransitionFrontierNameEvent_cuts_of_accepts`, and
the green-event interval cover lemmas).
-/

/--
Forward direction reduced to the parity minimum: if, whenever the NBW accepts,
the minimum infinitely-often DPW priority is even, then the NBW language embeds
into the DPW.  Pure parity-acceptance bookkeeping; no construction specifics.
-/
theorem automaton_accepts_of_accepts_of_minEven
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (hMinEven :
      A.Accepts word ->
        ∀ p : Nat,
          (automaton A).PrioritySeenInfinitelyOften word p ->
            (∀ q : Nat,
              (automaton A).PrioritySeenInfinitelyOften word q -> p ≤ q) ->
            DetParityAutomaton.NatEven p)
    (haccepts : A.Accepts word) :
    (automaton A).Accepts word := by
  obtain ⟨p, hpInf, hpMin⟩ :=
    DetParityAutomaton.exists_min_prioritySeenInfinitelyOften (automaton A) word
  exact (DetParityAutomaton.accepts_iff_natEven_of_min (automaton A) word hpInf
    hpMin).mpr (hMinEven haccepts p hpInf hpMin)

/--
The green-descent restated: it suffices that every *odd* recurrent priority is
dominated by an *even* recurrent priority `≤` it.  This is the exact shape the
König green-descent produces, and it discharges `automaton_accepts_of_accepts_of_minEven`.
-/
theorem automaton_accepts_of_accepts_of_recurrentEvenBelowOdd
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (hDescent :
      A.Accepts word ->
        ∀ p : Nat,
          (automaton A).PrioritySeenInfinitelyOften word p ->
            ¬ DetParityAutomaton.NatEven p ->
            ∃ p' : Nat,
              DetParityAutomaton.NatEven p' ∧
                p' ≤ p ∧
                (automaton A).PrioritySeenInfinitelyOften word p')
    (haccepts : A.Accepts word) :
    (automaton A).Accepts word := by
  refine automaton_accepts_of_accepts_of_minEven A word ?_ haccepts
  intro hacc p hpInf hpMin
  by_contra hodd
  obtain ⟨p', hp'Even, hp'le, hp'Inf⟩ := hDescent hacc p hpInf hodd
  have hple : p ≤ p' := hpMin p' hp'Inf
  exact hodd (le_antisymm hp'le hple ▸ hp'Even)

/--
Full Piterman compiler `NondetBuchiToDPACompilation A`, conditional on the single
green-descent obligation `hDescent`.  The reverse direction is unconditional
(`accepts_of_automaton_accepts`); filling `hDescent` makes the whole compiler
unconditional, superseding `toDPACompilationOfCompleteness`.
-/
noncomputable def toDPACompilationOfDescent
    [DecidableEq A.State]
    (hDescent :
      ∀ word : OmegaWord Alphabet,
        A.Accepts word ->
          ∀ p : Nat,
            (automaton A).PrioritySeenInfinitelyOften word p ->
              ¬ DetParityAutomaton.NatEven p ->
              ∃ p' : Nat,
                DetParityAutomaton.NatEven p' ∧
                  p' ≤ p ∧
                  (automaton A).PrioritySeenInfinitelyOften word p') :
    NondetBuchiToDPACompilation A :=
  toDPACompilationOfCompleteness A
    (fun word haccepts =>
      automaton_accepts_of_accepts_of_recurrentEvenBelowOdd A word
        (hDescent word) haccepts)

/--
Construction-level descent obligation: all priority↔event bookkeeping is now
discharged, so the remaining content is purely about the compact-tree `f`/`e`
events.  It suffices that, whenever a same-name deletion (`f ≥ e`) of fixed
priority `p` recurs along an accepting run, some green event (`f < e`) of a fixed
name `m` with `2 m ≤ p` also recurs.  This is exactly the green-descent the
checked root-frontier / survives / lower-name scaffolding is built to supply.
-/
theorem automaton_accepts_of_accepts_of_liveGreenDescent
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (hLiveDescent :
      A.Accepts word ->
        ∀ p : Nat,
          (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
            ∃ live : LiveState A, (automaton A).run word k = some live ∧
              ¬ live.1.f.val < live.1.e.val ∧ priority A live.1 = p) ->
          ∃ m : Nat,
            2 * m ≤ p ∧
              ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                ∃ live : LiveState A, (automaton A).run word k = some live ∧
                  live.1.f.val < live.1.e.val ∧ live.1.f.val = m)
    (haccepts : A.Accepts word) :
    (automaton A).Accepts word := by
  refine automaton_accepts_of_accepts_of_recurrentEvenBelowOdd A word ?_ haccepts
  intro hacc p hpInf hodd
  obtain ⟨m, hle, hfreqGreen⟩ :=
    hLiveDescent hacc p
      (exists_frequently_f_ge_e_of_prioritySeenInfinitelyOften_odd A hacc hpInf hodd)
  exact ⟨2 * m, ⟨m, rfl⟩, hle,
    automaton_prioritySeenInfinitelyOften_two_mul_of_frequently_f_lt_e A hfreqGreen⟩

/--
Full Piterman compiler conditional on the construction-level green-descent
`hLiveDescent` -- the current strongest forward endpoint, with every
priority-acceptance step proved.
-/
noncomputable def toDPACompilationOfLiveGreenDescent
    [DecidableEq A.State]
    (hLiveDescent :
      ∀ word : OmegaWord Alphabet,
        A.Accepts word ->
          ∀ p : Nat,
            (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
              ∃ live : LiveState A, (automaton A).run word k = some live ∧
                ¬ live.1.f.val < live.1.e.val ∧ priority A live.1 = p) ->
            ∃ m : Nat,
              2 * m ≤ p ∧
                ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                  ∃ live : LiveState A, (automaton A).run word k = some live ∧
                    live.1.f.val < live.1.e.val ∧ live.1.f.val = m) :
    NondetBuchiToDPACompilation A :=
  toDPACompilationOfCompleteness A
    (fun word haccepts =>
      automaton_accepts_of_accepts_of_liveGreenDescent A word
        (hLiveDescent word) haccepts)

/-!
#### Stable-name greens (general descent) and the root base case

The correct forward argument is the *minimal stable name* König argument: an
accepting NBW run settles into a stable node whose name `m` greens (`f = m < e`)
infinitely often, with no smaller priority recurring; then priority `2 m` is the
even minimum.  The name `m` is general (`automaton_accepts_frequently_stable_green_min_name_child_prefix_survives`,
the proved reverse direction, exhibits exactly such a general `recurrentName`).

Caveat against an earlier mis-framing: the survives fork (root's fresh child
survives) does **not** by itself make the root a green node.  A freshly created
node has no children, so its `childLabelUnion` is empty while a survives event
gives it a *nonempty* label; greenness (`label = childLabelUnion`) at that name
is a later breakpoint.  So the survives branch greens at the stabilized
fresh-child name `≥ 1`, not at the root -- it feeds the general descent below,
not the root base case.  The root base case (`f = 0`) is the special situation
where the run settles at the root itself.

`exists_frequently_fixed_green_name_of_frequently_green` is the framing-independent
pigeonhole turning "greens recur" into "a fixed green name recurs"; combined with
`automaton_prioritySeenInfinitelyOften_two_mul_of_frequently_f_lt_e` it yields a
recurrent even priority `2 m`.  The remaining content is *minimality* of `m`
(no smaller priority recurs), i.e. the `liveGreenDescent` obligation.
-/

/--
Pigeonhole over the finite `Name` type: if a green live state (`f < e`) recurs,
then some fixed green name `m` recurs.  Framing-independent building block of the
descent.
-/
theorem exists_frequently_fixed_green_name_of_frequently_green
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (hgreen :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A, (automaton A).run word k = some live ∧
          live.1.f.val < live.1.e.val) :
    ∃ m : Name A,
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A, (automaton A).run word k = some live ∧
          live.1.f = m ∧ live.1.f.val < live.1.e.val := by
  classical
  have hfreq :
      ∃ᶠ k in Filter.atTop,
        ∃ m ∈ (Finset.univ : Finset (Name A)),
          ∃ live : LiveState A, (automaton A).run word k = some live ∧
            live.1.f = m ∧ live.1.f.val < live.1.e.val := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hgreen n with ⟨k, hk, live, hrun, hfe⟩
    exact ⟨k, hk, live.1.f, Finset.mem_univ _, live, hrun, rfl, hfe⟩
  rw [Finset.frequently_exists] at hfreq
  rcases hfreq with ⟨m, _hmem, hmFreq⟩
  exact ⟨m, fun n => (Filter.frequently_atTop).1 hmFreq n⟩

/--
Root base case (the run settles at the root): if the DPW run greens at the root
(`f = 0`) with the root alive (`0 < e`) infinitely often, the automaton accepts
with minimum priority `0`.  Note the survives fork does not supply this directly
(see the section comment); it is the special stable name `m = 0`.
-/
theorem automaton_accepts_of_rootGreenRecurrent
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (hRootGreen :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A, (automaton A).run word k = some live ∧
          live.1.f.val = 0 ∧ 0 < live.1.e.val) :
    (automaton A).Accepts word := by
  have h0 : (automaton A).PrioritySeenInfinitelyOften word 0 := by
    have hfreq :
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          ∃ live : LiveState A, (automaton A).run word k = some live ∧
            live.1.f.val < live.1.e.val ∧ live.1.f.val = 0 := by
      intro n
      obtain ⟨k, hk, live, hrun, hf, he⟩ := hRootGreen n
      exact ⟨k, hk, live, hrun, by rw [hf]; exact he, hf⟩
    simpa using
      automaton_prioritySeenInfinitelyOften_two_mul_of_frequently_f_lt_e
        A (m := 0) hfreq
  exact DetParityAutomaton.accepts_of_even_seen_of_no_smaller (automaton A) word
    ⟨0, rfl⟩ h0 (fun q hq => absurd hq (Nat.not_lt_zero q))

/--
General stable-name endpoint (the correct forward target, subsuming the root base
case `m = 0`): if a green live state at a fixed minimal name `m` recurs -- `f = m`
with `f < e` infinitely often -- and no smaller priority recurs, then the
automaton accepts with even minimum priority `2 m`.  This is the canonical
minimal-stable-name conclusion; the open work is producing such an `m` with its
minimality from the accepting run.
-/
theorem automaton_accepts_of_stableGreenRecurrent
    [DecidableEq A.State]
    (word : OmegaWord Alphabet) (m : Name A)
    (hgreen :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A, (automaton A).run word k = some live ∧
          live.1.f.val < live.1.e.val ∧ live.1.f.val = m.val)
    (hmin :
      ∀ q : Nat, q < 2 * m.val ->
        ¬ (automaton A).PrioritySeenInfinitelyOften word q) :
    (automaton A).Accepts word :=
  DetParityAutomaton.accepts_of_even_seen_of_no_smaller (automaton A) word
    ⟨m.val, rfl⟩
    (automaton_prioritySeenInfinitelyOften_two_mul_of_frequently_f_lt_e A hgreen)
    hmin

/--
The same-name-delete field is positive at every position of an accepting run:
the initial `e` is the sentinel `= card`, and after a step `e > 0` by
`transitionWithPlan_e_pos_of_stage4_root_label_nonempty` (the root, the unique
name-`0` node, is never deleted).  This discharges the `0 < e` half of the
survives recurrence.
-/
theorem automaton_run_e_pos_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) (k : Nat) :
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧ 0 < live.1.e.val := by
  cases k with
  | zero =>
      refine ⟨⟨initial A, initial_wellFormed A⟩, rfl, ?_⟩
      have he : ((initial A).e).val = Fintype.card A.State := rfl
      rw [he]
      exact Fintype.card_pos_iff.mpr ⟨A.initial⟩
  | succ n =>
      obtain ⟨prev, hprev⟩ := automaton_run_some_of_accepts A haccepts n
      obtain ⟨next, hnext⟩ := automaton_run_some_of_accepts A haccepts (n + 1)
      have hstep : (automaton A).step (some prev) (word n) = some next := by
        have hrel : (automaton A).run word (n + 1) =
            (automaton A).step ((automaton A).run word n) (word n) := rfl
        rw [hprev] at hrel
        rw [← hrel]; exact hnext
      have hrootLabel : liveRootLabelNonempty A prev (word n) := by
        by_contra h
        rw [(automaton_step_live_eq_none_iff A prev (word n)).mpr h] at hstep
        simp at hstep
      have hnextTree : next.1 = liveNextTree A prev (word n) :=
        automaton_run_live_nextTree A word hprev hnext
      refine ⟨next, hnext, ?_⟩
      rw [hnextTree]
      exact transitionWithPlan_e_pos_of_stage4_root_label_nonempty A prev.1
        (word n) (livePlan A prev (word n)) prev.2
        (by simpa [liveRootLabelNonempty, liveStage4RootLabel] using hrootLabel)

/--
Survives-branch endpoint: under acceptance, it suffices that the root greens
(`f = 0`) infinitely often; positivity of `e` is supplied automatically.
-/
theorem automaton_accepts_of_accepts_of_rootGreenRecurrent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word)
    (hRootGreen :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A, (automaton A).run word k = some live ∧
          live.1.f.val = 0) :
    (automaton A).Accepts word := by
  refine automaton_accepts_of_rootGreenRecurrent A word ?_
  intro n
  obtain ⟨k, hk, live, hrun, hf⟩ := hRootGreen n
  obtain ⟨live', hrun', he⟩ := automaton_run_e_pos_of_accepts A haccepts k
  have hll : live = live' := by
    rw [hrun] at hrun'
    exact Option.some.inj hrun'
  exact ⟨k, hk, live, hrun, hf, by rw [hll]; exact he⟩

/--
Paper proof-4 top dichotomy (Piterman LMCS Section 3.2): for an accepting run,
either the root greens (`f = 0`) infinitely often -- the paper's "step 4 applied
to node 1 infinitely often", which already gives acceptance via
`automaton_accepts_of_accepts_of_rootGreenRecurrent` -- or eventually always
`f ≥ 1`, the paper's case where the run descends into a son.  This reduces the
forward direction to the descent case `hdescend`.
-/
theorem automaton_accepts_of_accepts_of_eventually_f_pos
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word)
    (hdescend :
      (∃ N : Nat, ∀ k : Nat, N ≤ k -> ∀ live : LiveState A,
          (automaton A).run word k = some live -> 0 < live.1.f.val) ->
        (automaton A).Accepts word) :
    (automaton A).Accepts word := by
  classical
  by_cases hf0 :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A, (automaton A).run word k = some live ∧
          live.1.f.val = 0
  · exact automaton_accepts_of_accepts_of_rootGreenRecurrent A haccepts hf0
  · apply hdescend
    push Not at hf0
    obtain ⟨N, hN⟩ := hf0
    exact ⟨N, fun k hk live hrun => Nat.pos_of_ne_zero (hN k hk live hrun)⟩

