theorem automaton_run_live_green_stage2Trigger_routed_accepting_segment_stage2_child_or_lower_reachable
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live : LiveState A}
    (hrun : (automaton A).run word n = some live)
    {green : Node A}
    (htrigger :
      green ∈ (live.1.stage1 A (word n)).stage2Triggers A)
    (hgreenActive :
      (((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).active green) = true)
    {acceptingState : A.State}
    (hstateFresh :
      acceptingState ∈
        ((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).label
          ((livePlan A live (word n)).stage2Plan.freshChild green))
    (hnot :
      acceptingState ∉
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label
          ((livePlan A live (word n)).stage2Plan.freshChild green)) :
    ∃ sourceNode sourceState,
      live.1.active sourceNode = true ∧
        sourceState ∈ live.1.label sourceNode ∧
        ReachableAfter A A.initial word n sourceState ∧
        SegmentVisitsAccepting A word n 1 sourceState acceptingState ∧
        ReachableAfter A A.initial word (n + 1) acceptingState ∧
        ((∃ child,
            child ∈
              ((live.1.stage1 A (word n)).stage2 A
                (livePlan A live (word n)).stage2Plan).children A green ∧
            acceptingState ∈
              ((live.1.stage1 A (word n)).stage2 A
                (livePlan A live (word n)).stage2Plan).label child) ∨
          (live.1.name sourceNode).val <
            (((live.1.stage1 A (word n)).stage2 A
              (livePlan A live (word n)).stage2Plan).name green).val) := by
  rcases live_green_stage2Trigger_routed_accepting_segment_stage2_child_or_lower
      A word live htrigger hgreenActive hstateFresh hnot with
    ⟨sourceNode, sourceState, hsourceActive, hsourceState, hsegment,
      hchildOrLower⟩
  have hsourceReachable :
      ReachableAfter A A.initial word n sourceState :=
    automaton_run_live_active_label_reachable A word hrun hsourceActive
      hsourceState
  have htargetReachable :
      ReachableAfter A A.initial word (n + 1) acceptingState :=
    reachableAfter_of_segmentVisitsAccepting A A.initial word
      hsourceReachable hsegment
  exact ⟨sourceNode, sourceState, hsourceActive, hsourceState,
    hsourceReachable, hsegment, htargetReachable, hchildOrLower⟩

theorem live_green_stage2Trigger_green_stage2_removed_accepting_segment_lower
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} (live : LiveState A)
    {green : Node A}
    (hgreenActive :
      (((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).active green) = true)
    {acceptingState : A.State}
    (haccepting : A.accepting acceptingState)
    (hstateGreen :
      acceptingState ∈
        ((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).label green)
    (hnotGreen :
      acceptingState ∉
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label green) :
    ∃ sourceNode sourceState,
      live.1.active sourceNode = true ∧
        sourceState ∈ live.1.label sourceNode ∧
        SegmentVisitsAccepting A word n 1 sourceState acceptingState ∧
        (live.1.name sourceNode).val <
          (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).name green).val := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  have hblocked : t2.BlockedByOlderSibling A green acceptingState :=
    stage3_blocked_of_mem_label_not_mem A t2
      (by simpa [t1, plan, t2] using hstateGreen)
      (by simpa [t1, plan, t2] using hnotGreen)
  rcases hblocked with ⟨ancestor, older, hancestor, holder, holderState⟩
  rcases stage1_stage2_active_label_segment_from_source_name_le
      A live.1 word plan (olderSibling_older_active A t2 holder)
      holderState with
    ⟨sourceNode, sourceState, hsourceActive, hsourceState, hsegment,
      hsourceNameLeOlder⟩
  have hlower :
      (live.1.name sourceNode).val < (t2.name green).val :=
    live_green_stage2Trigger_routed_accepting_segment_source_name_lt_green_of_above
      A word live
      (green := green) (ancestor := ancestor) (older := older)
      (sourceNode := sourceNode)
      (by simpa [t1, plan, t2] using hancestor)
      (by simpa [t1, plan, t2] using holder)
      (by simpa [t1, plan, t2] using hsourceNameLeOlder)
      (by simpa [t1, plan, t2] using hgreenActive)
  exact ⟨sourceNode, sourceState,
    by simpa [stage1] using hsourceActive, hsourceState,
    segmentVisitsAccepting_of_segment_accepting_target A word hsegment
      haccepting,
    by simpa [t1, plan, t2] using hlower⟩

theorem live_green_stage2Trigger_routed_accepting_segment_green_stage3_or_lower
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} (live : LiveState A)
    {green : Node A}
    (htrigger :
      green ∈ (live.1.stage1 A (word n)).stage2Triggers A)
    (hgreenActive :
      (((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).active green) = true)
    {acceptingState : A.State}
    (haccepting : A.accepting acceptingState)
    (hstateFresh :
      acceptingState ∈
        ((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).label
          ((livePlan A live (word n)).stage2Plan.freshChild green))
    (hnotFresh :
      acceptingState ∉
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label
          ((livePlan A live (word n)).stage2Plan.freshChild green)) :
    ∃ sourceNode sourceState,
      live.1.active sourceNode = true ∧
        sourceState ∈ live.1.label sourceNode ∧
        SegmentVisitsAccepting A word n 1 sourceState acceptingState ∧
        (acceptingState ∈
            (((live.1.stage1 A (word n)).stage2 A
              (livePlan A live (word n)).stage2Plan).stage3 A).label green ∨
          (live.1.name sourceNode).val <
            (((live.1.stage1 A (word n)).stage2 A
              (livePlan A live (word n)).stage2Plan).name green).val) := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases live_green_stage2Trigger_routed_accepting_segment_green_stage2_or_lower
      A word live htrigger hgreenActive hstateFresh hnotFresh with
    ⟨sourceNode, sourceState, hsourceActive, hsourceState, hsegment,
      hgreenOrLower⟩
  rcases hgreenOrLower with hstateGreen | hlower
  · by_cases hstateGreenStage3 : acceptingState ∈ t3.label green
    · exact ⟨sourceNode, sourceState, hsourceActive, hsourceState, hsegment,
        Or.inl (by simpa [t1, plan, t2, t3] using hstateGreenStage3)⟩
    · rcases live_green_stage2Trigger_green_stage2_removed_accepting_segment_lower
        A word live hgreenActive haccepting
