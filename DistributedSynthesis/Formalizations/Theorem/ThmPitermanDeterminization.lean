    (hgreen :
      green ∈
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).greenNodes A)
    {acceptingState : A.State}
    (hsurvives :
      acceptingState ∈
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label
          ((livePlan A live (word n)).stage2Plan.freshChild green)) :
    ∃ sourceState,
      sourceState ∈ live.1.label green ∧
        acceptingState ∈
          (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label green ∧
        A.accepting acceptingState ∧
        SegmentVisitsAccepting A word n 1 sourceState acceptingState := by
