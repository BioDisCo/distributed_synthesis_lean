              (shiftedEventFrontierCuts cuts i) state) ->
        ∀ i : Nat,
          let transportLength := cuts (i + 2) - (cuts (i + 1) + 1)
          ∀ lives : Nat -> LiveState A,
            (∀ j : Nat, j ≤ transportLength ->
              (automaton A).run word (cuts (i + 1) + 1 + j) =
                some (lives j)) ->
            (∀ j : Nat, j < transportLength ->
              ((lives (j + 1)).1.e).val ≠ recurrentName.val) ∧
            SegmentVisitsAcceptingCover A word (cuts (i + 2)) 1
              ((lives transportLength).1.label (frontierNode i))
              ((frontierLive (i + 1)).1.label (frontierNode (i + 1)))) :
