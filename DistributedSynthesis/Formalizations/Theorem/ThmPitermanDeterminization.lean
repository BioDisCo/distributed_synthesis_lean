    (hsourceNameLeOlder :
      (live.1.name sourceNode).val ≤
        (((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).name older).val)
    (hgreenActive :
      (((live.1.stage1 A (word n)).stage2 A
