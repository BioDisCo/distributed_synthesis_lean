      (by simpa [t1, plan, t2, t3] using hstateGreen)
  rw [childLabelUnion, Finset.mem_biUnion] at hstateUnion
  rcases hstateUnion with ⟨child, hchild, hstateChild⟩
  by_cases hfresh : child = plan.freshChild green
  · subst child
    rcases live_green_stage2Trigger_accepting_segment_from_green_of_fresh_survives
        A word live htrigger hgreen
        (by simpa [t1, plan, t2, t3] using hstateChild) with
