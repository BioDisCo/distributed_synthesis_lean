/--
The green-below non-stable source branch is already accepting.  If it recurs
cofinally, then cofinally the transition's `f` register is below the ambient
minimal source name `m`; since `m < a` and the run is settled at name `a`,
the same successor states have `f < e`.  A fixed even priority below `2*a`
therefore recurs, and settling rules out all recurring odd priorities below
`2*a`.
-/
theorem automaton_accepts_of_frequently_acceptingNodeNameStateGreenBelowNonacceptingAt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v sourceNode : Node A} {a nodeName m : Nat}
    {target : A.State}
    (hsettle : RunSettlesAt A run v a)
    (hmMem : m ∈ Finset.range a)
    (hfreq :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateGreenBelowNonacceptingAt A run sourceNode
          nodeName m target t) :
    (automaton A).Accepts word := by
  classical
  rcases runSettles_eventually_next_e_gt_settled_name A run hsettle with
    ⟨Ne, heStableNext⟩
  have haLeCard : a ≤ Fintype.card A.State :=
    runSettlesAtName_le_card A run ⟨v, hsettle⟩
  have hmLtA : m < a := Finset.mem_range.mp hmMem
  have hfreqF :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            live.1.f.val < m ∧ live.1.f.val < live.1.e.val := by
    intro n
    rcases hfreq (max n (Ne + 1)) with
      ⟨t, ht, hgreenBelow⟩
    have hnt : n ≤ t := le_trans (Nat.le_max_left n (Ne + 1)) ht
    have hNePred : Ne ≤ t - 1 := by
      have hNe1t : Ne + 1 ≤ t :=
        le_trans (Nat.le_max_right n (Ne + 1)) ht
      omega
    have hpos : 0 < t := by
      have hNe1t : Ne + 1 ≤ t :=
        le_trans (Nat.le_max_right n (Ne + 1)) ht
      omega
    rcases hgreenBelow with
      ⟨hevent, _hnonaccepting, prev, hprev, hgreenPayload⟩
    rcases hevent with
      ⟨live, hrunLive, _htargetEq, _haccepting, _htargetLabel,
        _hnodeName⟩
    let t1 := prev.1.stage1 A (word (t - 1))
    let plan := (livePlan A prev (word (t - 1))).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    rcases hgreenPayload with
      ⟨old, green, holdGreen, hgreen, hgreenNameLt⟩
    have hgreenNameLtT3 : (t3.name green).val < m := by
      simpa [t1, plan, t2, t3] using hgreenNameLt
    have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel hpos
    have hrunLivePrev :
        (automaton A).run word ((t - 1) + 1) = some live := by
      simpa [hsucc] using hrunLive
    have hnextTree : live.1 = liveNextTree A prev (word (t - 1)) :=
      automaton_run_live_nextTree A word hprev hrunLivePrev
    have hfMin :
        live.1.f.val = (t3.minBoundedNameOf A (t3.greenNodes A)).val := by
      rw [hnextTree]
      simp [liveNextTree, transitionWithPlan, t1, plan, t2, t3,
        stage4_f_val, stage5_f_val, stage6_f_val]
    have hgreenBound : (t3.name green).val < Fintype.card A.State := by
      omega
    have hminLe :
        (t3.minBoundedNameOf A (t3.greenNodes A)).val ≤
          (t3.name green).val :=
      minBoundedNameOf_le_of_mem A t3 (t3.greenNodes A)
        (by simpa [t1, plan, t2, t3] using hgreen)
        hgreenBound
    have hfLtM : live.1.f.val < m := by
      omega
    have heGt : a < live.1.e.val :=
      heStableNext (t - 1) hNePred prev live hprev hrunLivePrev
    have hfe : live.1.f.val < live.1.e.val := by
      omega
    exact ⟨t, hnt, live, hrunLive, hfLtM, hfe⟩
  have hfreqFiber :
      ∃ᶠ k in Filter.atTop,
        ∃ q ∈ Finset.range m,
          ∃ live : LiveState A,
            (automaton A).run word k = some live ∧
              live.1.f.val = q ∧ live.1.f.val < live.1.e.val := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreqF n with ⟨k, hnk, live, hrun, hfLtM, hfe⟩
    exact ⟨k, hnk, live.1.f.val, Finset.mem_range.mpr hfLtM,
      live, hrun, rfl, hfe⟩
  rw [Finset.frequently_exists] at hfreqFiber
  rcases hfreqFiber with ⟨q, hqMem, hqFreq⟩
  have hqLtM : q < m := Finset.mem_range.mp hqMem
  have hqLtA : q < a := lt_trans hqLtM hmLtA
  have hqSeen :
      (automaton A).PrioritySeenInfinitelyOften word (2 * q) := by
    intro n
    rcases (Filter.frequently_atTop).1 hqFreq n with
      ⟨k, hnk, live, hrun, hfEq, hfe⟩
    refine ⟨k, hnk, ?_⟩
    rw [hrun, automaton_priority_live]
    unfold priority
    rw [if_pos hfe, hfEq]
  obtain ⟨p, hpSeen, hpMin⟩ :=
    DetParityAutomaton.exists_min_prioritySeenInfinitelyOften (automaton A) word
  have hpLeEven : p ≤ 2 * q := hpMin (2 * q) hqSeen
  have hpLeSettled : p ≤ 2 * a := by omega
  have hpEven : DetParityAutomaton.NatEven p := by
    rcases Nat.lt_or_eq_of_le hpLeSettled with hpLt | hpEq
    · exact runSettles_prioritySeen_lt_two_mul_settled_name_even
        A run hrunAccepts hsettle hpSeen hpLt
    · subst p
      exact ⟨a, rfl⟩
  exact (DetParityAutomaton.accepts_iff_natEven_of_min (automaton A) word
    hpSeen hpMin).mpr hpEven

