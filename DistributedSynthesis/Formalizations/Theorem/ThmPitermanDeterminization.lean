    (lowerStateTargetHandler :
      (∃ sourceName sourceNode sourceState target,
        sourceName ∈ Finset.range a ∧
          A.accepting target ∧
            ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
              SettledLowerSourceNodeNameStateTargetEvent A run sourceNode
                sourceName sourceState target k) ->
        ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a' := by
  refine runSettles_descendHorn_of_lower_node_handler A run hrunAccepts
    hsettle hng ?_
  intro hlowerNode
  rcases hlowerNode with ⟨sourceName, sourceNode, hsourceNameMem, hfreqNode⟩
  rcases
      exists_frequently_settledLowerSourceNodeNameStateTargetEvent_of_nodeNameBranch
        A run hfreqNode with
    ⟨sourceState, target, haccepting, hfreqTarget⟩
  exact lowerStateTargetHandler
    ⟨sourceName, sourceNode, sourceState, target, hsourceNameMem, haccepting,
      hfreqTarget⟩

/--
Forward direction reduced to the green horn plus the two settled non-green branch
handlers.  This packages the checked descent branch split into the existing
`automaton_accepts_of_accepts_of_descentHorns` endpoint.
-/
theorem automaton_accepts_of_accepts_of_branchHandlers
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word)
    (greenHorn :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> RunNodeGreensIO A run v ->
          (automaton A).Accepts word)
    (coverageHandler :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ child childName,
            childName ∈ Finset.range (Fintype.card A.State) ∧
              a < childName ∧
              ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledCoverageChildNameEvent A run v child a childName k) ->
          ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a')
    (lowerHandler :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ sourceName,
            sourceName ∈ Finset.range a ∧
              ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledLowerSourceNameEvent A run sourceName k) ->
          ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    (automaton A).Accepts word := by
  refine automaton_accepts_of_accepts_of_descentHorns A haccepts
    greenHorn ?_
  intro run hrunAccepts v a hsettle hng
  exact runSettles_descendHorn_of_branch_handlers A run hrunAccepts
    hsettle hng
    (coverageHandler run hrunAccepts v a hsettle hng)
    (lowerHandler run hrunAccepts v a hsettle hng)

/--
Forward direction reduced to the green horn plus the minimal coverage branch and
the lower-source branch.  This is the current paper-shaped endpoint for closing
the accepting-run direction.
-/
theorem automaton_accepts_of_accepts_of_minimalBranchHandlers
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word)
    (greenHorn :
