theorem StableGreenTriggerSegmentEvent.frontier_proper_descendant_cover_no_same_delete
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {recurrentName : Name A} {N frontierK length : Nat}
    (hfrontierEvent :
      StableGreenTriggerSegmentEvent A word recurrentName N frontierK)
    (hstable :
      ∀ k : Nat, N ≤ k ->
        ∀ live : LiveState A,
          (automaton A).run word k = some live ->
            (live.1.f.val < live.1.e.val ->
              recurrentName.val ≤ live.1.f.val) ∧
            (¬ live.1.f.val < live.1.e.val ->
              recurrentName.val ≤ live.1.e.val))
    {frontierLive : LiveState A} {frontierNode descendant : Node A}
    (hfrontierRun :
      (automaton A).run word (frontierK + 1) = some frontierLive)
    (hfrontierActive : frontierLive.1.active frontierNode = true)
    (hfrontierName :
      (frontierLive.1.name frontierNode).val = recurrentName.val)
    (lives : Nat -> LiveState A)
    (hrun :
      ∀ i : Nat, i ≤ length ->
        (automaton A).run word (frontierK + 1 + i) = some (lives i))
    (hnoSameDelete :
      ∀ i : Nat, i < length ->
        ((lives (i + 1)).1.e).val ≠ recurrentName.val)
    (hdescendantActive : (lives length).1.active descendant = true)
    (hdescendant :
      (lives length).1.IsAncestorOrSelf A frontierNode descendant)
    (hne : frontierNode ≠ descendant) :
    SegmentVisitsAcceptingCover A word (frontierK + 1) length
      (frontierLive.1.label frontierNode)
      ((lives length).1.label descendant) := by
  induction length generalizing lives descendant with
  | zero =>
      have hlives0 : lives 0 = frontierLive := by
        have hrun0 := hrun 0 (by omega)
        have hsome : some (lives 0) = some frontierLive := by
          rw [← hrun0, hfrontierRun]
        exact Option.some.inj hsome
      simpa [hlives0] using
        (StableGreenTriggerSegmentEvent.frontier_proper_descendant_cover_base
          A word hfrontierEvent hfrontierRun hfrontierActive
          hfrontierName
          (by simpa [hlives0] using hdescendantActive)
          (by simpa [hlives0] using hdescendant)
          hne)
  | succ length ih =>
      have hrunPrefix :
          ∀ i : Nat, i ≤ length ->
            (automaton A).run word (frontierK + 1 + i) =
              some (lives i) := by
        intro i hi
        exact hrun i (by omega)
      have hnoSamePrefix :
          ∀ i : Nat, i < length ->
            ((lives (i + 1)).1.e).val ≠ recurrentName.val := by
        intro i hi
        exact hnoSameDelete i (by omega)
      have hnextRun :
          (automaton A).run word (frontierK + 1 + length + 1) =
            some (lives (length + 1)) := by
        have hrunNext := hrun (length + 1) (by omega)
        have hidx :
            frontierK + 1 + (length + 1) =
              frontierK + 1 + length + 1 := by omega
        simpa [hidx] using hrunNext
      apply
        StableGreenTriggerSegmentEvent.block_cover_from_frontier_next_proper_descendant_internal_split_child_covers_no_same_delete
          A word hfrontierEvent hstable hfrontierRun hfrontierActive
          hfrontierName lives (by rfl) hrunPrefix hnoSamePrefix hnextRun
          hdescendantActive hdescendant hne
      · intro htrigger child hchild hnotFresh
        have hchildLive :
            child ∈ (lives length).1.children A frontierNode :=
          live_green_stage2Trigger_old_child_of_stage3_child_not_fresh
            A word (lives length) htrigger hchild hnotFresh
        have hchildActive : (lives length).1.active child = true := by
          rw [children, Finset.mem_filter] at hchildLive
          exact hchildLive.2.1
        have hchildAncestor :
            (lives length).1.IsAncestorOrSelf A frontierNode child :=
          isAncestorOrSelf_of_child A (lives length).1
            (isAncestorOrSelf_refl A (lives length).1 frontierNode)
            hchildLive
        have hchildNe : frontierNode ≠ child := by
          have hlt :=
            live_child_name_gt_parent A (lives length) hchildLive
          intro hsame
          subst child
          exact Nat.lt_irrefl _ hlt
        exact
          ih lives hrunPrefix hnoSamePrefix hchildActive hchildAncestor
            hchildNe
      · intro hnotTrigger child hchild
        have hchildLive :
            child ∈ (lives length).1.children A frontierNode :=
          live_green_nontrigger_child_of_stage3_child
            A word (lives length) hnotTrigger hchild
        have hchildActive : (lives length).1.active child = true := by
          rw [children, Finset.mem_filter] at hchildLive
          exact hchildLive.2.1
        have hchildAncestor :
            (lives length).1.IsAncestorOrSelf A frontierNode child :=
          isAncestorOrSelf_of_child A (lives length).1
            (isAncestorOrSelf_refl A (lives length).1 frontierNode)
            hchildLive
        have hchildNe : frontierNode ≠ child := by
          have hlt :=
            live_child_name_gt_parent A (lives length) hchildLive
          intro hsame
          subst child
          exact Nat.lt_irrefl _ hlt
        exact
          ih lives hrunPrefix hnoSamePrefix hchildActive hchildAncestor
            hchildNe

