  let t2 := t1.stage2 A plan
  rcases live_green_stage2Trigger_routed_accepting_segment_split
      A word live htrigger hgreenActive hstateFresh hnot with
    ⟨sourceNode, sourceState, ancestor, older, hsourceActive, hsourceState,
      hsegment, _hancestor, holder, holderState, hsplit⟩
  refine ⟨sourceNode, sourceState, hsourceActive, hsourceState, hsegment, ?_⟩
  rcases hsplit with hancestorFresh | hlower
  · have hchild :
        older ∈ t2.children A green :=
      live_green_stage2Trigger_routed_freshChild_case_older_mem_children_stage2
        A word live htrigger
        (by simpa [plan] using hancestorFresh)
        (by simpa [t1, plan, t2] using holder)
    exact Or.inl
      ⟨older, by simpa [t1, plan, t2] using hchild,
