  have hactive0 : (lives 0).1.active green = true := by
    rw [hlives0]
    exact hactiveNext
  have hname0 : ((lives 0).1.name green).val = recurrentName.val := by
    rw [hlives0]
    exact hnameNext
  have hbound0 : ((lives 0).1.name green).val < Fintype.card A.State := by
    have heBound : next.1.e.val < Fintype.card A.State + 1 :=
      next.1.e.2
    rw [hname0]
    omega
  exact automaton_run_interval_preserves_active_name_of_fixed_next_bounds
