/--
Cofinal surviving-child events give cofinally many ordinary child-label coverage
events at the fixed lower source.
-/
theorem frequently_settledLowerSourceStage3ChildUnionChildSurvives_to_childLabelUnion
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionChildSurvivesEvent A run sourceNode child
          sourceName sourceState target k) :
    ∀ n : Nat, ∃ k next,
      n ≤ k ∧
        (automaton A).run word (k + 1) = some next ∧
        A.accepting target ∧
        target ∈ next.1.childLabelUnion A sourceNode := by
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  rcases
      settledLowerSourceStage3ChildUnionChildSurvivesEvent_to_next_childLabelUnion
        A run hevent with
    ⟨next, hrunNext, haccepting, hcover⟩
  exact ⟨k, next, hnk, hrunNext, haccepting, hcover⟩

/--
Surviving fixed-child lower-source events also retain the original accepting-run
payload: the fixed target is the actual witness path state at the successor time.
-/
theorem settledLowerSourceStage3ChildUnionChildSurvivesEvent_to_coverage_payload
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionChildSurvivesEvent A run sourceNode child
        sourceName sourceState target k) :
    ∃ live next,
      (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        run.path (k + 1) = target ∧
        A.accepting target ∧
        target ∈ next.1.childLabelUnion A sourceNode := by
  have hcoverEvent := hevent
  rcases
      settledLowerSourceStage3ChildUnionChildSurvivesEvent_to_next_childLabelUnion
        A run hcoverEvent with
    ⟨nextCover, hrunNextCover, hacceptingCover, hcover⟩
  rcases hevent with ⟨hchildEvent, _next, _hrunNext, _htargetNextChild⟩
  rcases hchildEvent with ⟨hchildUnionEvent, _liveChild, _hrunChild, _hchildPayload⟩
  rcases hchildUnionEvent with ⟨hbase, _liveCU, _hrunCU, _hchildUnion⟩
  rcases hbase with
    ⟨live, nextBase, hrun, hrunNextBase, htarget, _hacceptingBase,
      _hsourceActive, _hsourceState, _hsegment, _hsourceName⟩
  have hnextCoverEq : nextCover = nextBase := by
    have hsome : some nextCover = some nextBase := by
      rw [← hrunNextCover, hrunNextBase]
    exact Option.some.inj hsome
  subst nextCover
  exact ⟨live, nextBase, hrun, hrunNextBase, htarget, hacceptingCover, hcover⟩

/--
Cofinal surviving-child events give the exact ordinary coverage payload expected
by the settled coverage branch, but rooted at the lower source.
-/
theorem frequently_settledLowerSourceStage3ChildUnionChildSurvives_to_coverage_payload
    [DecidableEq A.State]
