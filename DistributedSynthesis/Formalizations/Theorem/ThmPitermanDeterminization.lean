              (∀ k j : Nat, N ≤ k -> j < m ->
                ¬ SettledLowerSourceNameEvent A run j k) ∧
              (∀ k smaller : Nat, N ≤ k -> smaller < childName ->
                m < smaller -> smaller ≤ a ->
                  ¬ SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
                    A run v sourceNode child a m smaller sourceState target
                    uncovered k) ∧
              ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
                AcceptingNodeNameStateFreshParentNonacceptingAt A run
                  sourceNode smallerSourceName m target t) ->
          (automaton A).Accepts word)
    (emptyBelowHandler :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ (m childName smallerSourceName : Nat) (sourceNode child : Node A)
              (sourceState target uncovered : A.State) (N : Nat),
            m ∈ Finset.range a ∧
              m < childName ∧ childName ≤ a ∧
              smallerSourceName ∈ Finset.range m ∧
              (∀ k j : Nat, N ≤ k -> j < m ->
                ¬ SettledLowerSourceNameEvent A run j k) ∧
              (∀ k smaller : Nat, N ≤ k -> smaller < childName ->
                m < smaller -> smaller ≤ a ->
                  ¬ SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
                    A run v sourceNode child a m smaller sourceState target
                    uncovered k) ∧
              ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
                AcceptingNodeNameStateEmptyBelowNonacceptingAt A run
                  sourceNode smallerSourceName m target t) ->
          (automaton A).Accepts word) :
    (automaton A).Accepts word := by
  refine
    automaton_accepts_of_accepts_of_minLowerPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorMinFixedNameCutoffNextNameNonstableSourceBranchHandlers
      A haccepts eqStateHandler acceptingChildHandler freshParentHandler ?_
      emptyBelowHandler
  intro run hrunAccepts v a hsettle _hng hbranch
  rcases hbranch with
    ⟨m, childName, smallerSourceName, sourceNode, child, sourceState, target,
      uncovered, N, hmMem, _hmLtChildName, _hchildNameLe, _hsmallerSourceMem,
      _hnoSmallerLower, _hnoSmallerChildName, hfreqGreen⟩
  exact
    automaton_accepts_of_frequently_acceptingNodeNameStateGreenBelowNonacceptingAt
      A run hrunAccepts hsettle hmMem hfreqGreen

/--
The active-empty non-stable source branch is also accepting.  A cofinal
stage-(5) empty-removal witness below `m` forces the successor deletion register
`e` below `m`.  Hence every corresponding successor priority is below `2*m`;
some such priority recurs, and settling at name `a` rules out a recurring odd
priority below `2*a`.
-/
theorem automaton_accepts_of_frequently_acceptingNodeNameStateEmptyBelowNonacceptingAt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v sourceNode : Node A} {a nodeName m : Nat}
    {target : A.State}
    (hsettle : RunSettlesAt A run v a)
    (hmMem : m ∈ Finset.range a)
    (hfreq :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateEmptyBelowNonacceptingAt A run sourceNode
          nodeName m target t) :
    (automaton A).Accepts word := by
  classical
  have haLeCard : a ≤ Fintype.card A.State :=
    runSettlesAtName_le_card A run ⟨v, hsettle⟩
  have hmLtA : m < a := Finset.mem_range.mp hmMem
  have hfreqPriorityBelow :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            priority A live.1 < 2 * m := by
    intro n
    rcases hfreq (max n 1) with ⟨t, ht, hemptyBelow⟩
    have hnt : n ≤ t := le_trans (Nat.le_max_left n 1) ht
    have h1t : 1 ≤ t := le_trans (Nat.le_max_right n 1) ht
    rcases hemptyBelow with
      ⟨hevent, _hnonaccepting, prev, hprev, hemptyPayload⟩
    rcases hevent with
      ⟨live, hrunLive, _htargetEq, _haccepting, _htargetLabel,
        _hnodeName⟩
    let t1 := prev.1.stage1 A (word (t - 1))
    let plan := (livePlan A prev (word (t - 1))).stage2Plan
    let t2 := t1.stage2 A plan
    let t3 := t2.stage3 A
    let t4 := t3.stage4 A
    let stage4Removed := t3.greenRemovedNodes A
    let t5 := t4.stage5 A stage4Removed
    let stage5Removed := stage4Removed ∪ t4.emptyActiveNodes A
    rcases hemptyPayload with
      ⟨old, holdActive, holdEmptyLabel, holdNameLt⟩
    have holdNameLtT5 : (t5.name old).val < m := by
      simpa [t1, plan, t2, t3, t4, stage4Removed, t5] using holdNameLt
    have holdEmpty : old ∈ t4.emptyActiveNodes A := by
      rw [mem_emptyActiveNodes A t4]
      exact ⟨holdActive, holdEmptyLabel⟩
    have holdNameLtT4 : (t4.name old).val < m := by
      have hnameEq : (t5.name old).val = (t4.name old).val := by
        simp [t5, stage5_name A t4 stage4Removed old]
      omega
    have holdBound : (t4.name old).val < Fintype.card A.State := by
      omega
    have hminLe :
        (t4.minBoundedNameOf A stage5Removed).val ≤ (t4.name old).val :=
      minBoundedNameOf_le_of_mem A t4 stage5Removed
        (by
          exact Finset.mem_union_right stage4Removed holdEmpty)
        holdBound
    have htpos : 0 < t := by
      omega
    have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel htpos
    have hrunLivePrev :
        (automaton A).run word ((t - 1) + 1) = some live := by
      simpa [hsucc] using hrunLive
    have hnextTree : live.1 = liveNextTree A prev (word (t - 1)) :=
      automaton_run_live_nextTree A word hprev hrunLivePrev
    have heEq :
        live.1.e.val = (t4.minBoundedNameOf A stage5Removed).val := by
      rw [hnextTree]
      simp [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
        stage4Removed, t5, stage5Removed, stage5_e_val, stage6_e_val]
    have heLtM : live.1.e.val < m := by
      omega
    have hprioLt : priority A live.1 < 2 * m := by
      by_cases hfe : live.1.f.val < live.1.e.val
      · have hfLtM : live.1.f.val < m := lt_trans hfe heLtM
        have hprioEq : priority A live.1 = 2 * live.1.f.val := by
          simp [priority, hfe]
        omega
      · cases heVal : live.1.e.val with
        | zero =>
            have hmpos : 0 < m := by omega
            have hprioEq : priority A live.1 = 1 := by
              simp [priority, hfe, heVal]
            omega
        | succ pred =>
            have hnotLe : ¬ live.1.f.val ≤ pred := by
              intro hle
              exact hfe (by simpa [heVal] using Nat.lt_succ_of_le hle)
            have hprioEq : priority A live.1 = 2 * pred + 1 := by
              simp [priority, hfe, heVal, hnotLe]
            omega
    exact ⟨t, hnt, live, hrunLive, hprioLt⟩
  have hfreqFilter :
      ∃ᶠ k in Filter.atTop,
        ∃ p ∈ Finset.range (2 * m),
          ∃ live : LiveState A,
            (automaton A).run word k = some live ∧
              priority A live.1 = p := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreqPriorityBelow n with
      ⟨k, hnk, live, hrun, hprioLt⟩
    exact ⟨k, hnk, priority A live.1,
      Finset.mem_range.mpr hprioLt, live, hrun, rfl⟩
  rw [Finset.frequently_exists] at hfreqFilter
  rcases hfreqFilter with ⟨pLow, hpLowMem, hpLowFreq⟩
  have hpLowLt : pLow < 2 * m := Finset.mem_range.mp hpLowMem
  have hpLowSeen :
      (automaton A).PrioritySeenInfinitelyOften word pLow := by
    intro n
    rcases (Filter.frequently_atTop).1 hpLowFreq n with
      ⟨k, hnk, live, hrun, hprioEq⟩
    refine ⟨k, hnk, ?_⟩
    rw [hrun, automaton_priority_live]
    exact hprioEq
  obtain ⟨p, hpSeen, hpMin⟩ :=
    DetParityAutomaton.exists_min_prioritySeenInfinitelyOften (automaton A) word
  have hpLeLow : p ≤ pLow := hpMin pLow hpLowSeen
  have hpLtSettled : p < 2 * a := by
    omega
  have hpEven : DetParityAutomaton.NatEven p :=
    runSettles_prioritySeen_lt_two_mul_settled_name_even
      A run hrunAccepts hsettle hpSeen hpLtSettled
  exact (DetParityAutomaton.accepts_iff_natEven_of_min (automaton A) word
    hpSeen hpMin).mpr hpEven

/--
Source-drop endpoint with all non-stable branches except fresh-parent movement
discharged.  Stable predecessor, green-below, and empty-below recurrent branches
are all accepting/contradictory internally; only the fresh-parent movement branch
remains exposed.
-/
theorem automaton_accepts_of_accepts_of_minLowerPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorMinFixedNameCutoffNextNameFreshParentSourceBranchHandler
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word)
    (eqStateHandler :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ (m childName : Nat) (sourceNode child : Node A)
              (sourceState target uncovered : A.State) (N : Nat),
            m ∈ Finset.range a ∧
              m < childName ∧ childName ≤ a ∧
              (∀ k j : Nat, N ≤ k -> j < m ->
                ¬ SettledLowerSourceNameEvent A run j k) ∧
              (∀ k smaller : Nat, N ≤ k -> smaller < childName ->
                m < smaller -> smaller ≤ a ->
                  ¬ SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
                    A run v sourceNode child a m smaller sourceState target
                    uncovered k) ∧
              ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
                AcceptingChildCoverageChildNameStateAt A run sourceNode child
                  m childName target t) ->
          (automaton A).Accepts word)
    (acceptingChildHandler :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ (m childName smallerName : Nat) (sourceNode child : Node A)
              (sourceState target uncovered : A.State) (N : Nat),
            m ∈ Finset.range a ∧
              m < childName ∧ childName ≤ a ∧
              smallerName ∈ Finset.range (Fintype.card A.State) ∧
              m < smallerName ∧ smallerName < childName ∧
              (∀ k j : Nat, N ≤ k -> j < m ->
                ¬ SettledLowerSourceNameEvent A run j k) ∧
              (∀ k smaller : Nat, N ≤ k -> smaller < childName ->
                m < smaller -> smaller ≤ a ->
                  ¬ SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
                    A run v sourceNode child a m smaller sourceState target
                    uncovered k) ∧
              ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
                AcceptingChildCoverageChildNameStateAt A run sourceNode child
                  m smallerName target t) ->
          (automaton A).Accepts word)
    (freshParentHandler :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ (m childName smallerSourceName : Nat) (sourceNode child : Node A)
              (sourceState target uncovered : A.State) (N : Nat),
            m ∈ Finset.range a ∧
              m < childName ∧ childName ≤ a ∧
              smallerSourceName ∈ Finset.range m ∧
              (∀ k j : Nat, N ≤ k -> j < m ->
                ¬ SettledLowerSourceNameEvent A run j k) ∧
              (∀ k smaller : Nat, N ≤ k -> smaller < childName ->
                m < smaller -> smaller ≤ a ->
                  ¬ SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
                    A run v sourceNode child a m smaller sourceState target
                    uncovered k) ∧
              ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
                AcceptingNodeNameStateFreshParentNonacceptingAt A run
                  sourceNode smallerSourceName m target t) ->
          (automaton A).Accepts word) :
    (automaton A).Accepts word := by
  refine
    automaton_accepts_of_accepts_of_minLowerPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorMinFixedNameCutoffNextNameFreshEmptySourceBranchHandlers
      A haccepts eqStateHandler acceptingChildHandler freshParentHandler ?_
  intro run hrunAccepts v a hsettle _hng hbranch
  rcases hbranch with
    ⟨m, childName, smallerSourceName, sourceNode, child, sourceState, target,
      uncovered, N, hmMem, _hmLtChildName, _hchildNameLe, _hsmallerSourceMem,
      _hnoSmallerLower, _hnoSmallerChildName, hfreqEmpty⟩
  exact
    automaton_accepts_of_frequently_acceptingNodeNameStateEmptyBelowNonacceptingAt
      A run hrunAccepts hsettle hmMem hfreqEmpty

/--
Paper-facing source-drop endpoint: the non-stable lower-source recurrence has
no remaining construction handler.  Stable predecessor cuts contradict the
minimal lower-source cutoff; green-below and empty-below recurrences are
accepting by the parity-register arguments; and the fresh-parent branch is
absorbed into those same green/empty branches because fresh children are born
above their predecessor parent and can only drop below `m` through stage-(6)
compaction past a real removed node.
-/
theorem automaton_accepts_of_accepts_of_minLowerPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorMinFixedNameCutoffNextNameSourceDropClosedHandlers
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word)
    (eqStateHandler :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ (m childName : Nat) (sourceNode child : Node A)
              (sourceState target uncovered : A.State) (N : Nat),
            m ∈ Finset.range a ∧
              m < childName ∧ childName ≤ a ∧
              (∀ k j : Nat, N ≤ k -> j < m ->
                ¬ SettledLowerSourceNameEvent A run j k) ∧
              (∀ k smaller : Nat, N ≤ k -> smaller < childName ->
                m < smaller -> smaller ≤ a ->
                  ¬ SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
                    A run v sourceNode child a m smaller sourceState target
                    uncovered k) ∧
              ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
                AcceptingChildCoverageChildNameStateAt A run sourceNode child
                  m childName target t) ->
          (automaton A).Accepts word)
    (acceptingChildHandler :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ (m childName smallerName : Nat) (sourceNode child : Node A)
              (sourceState target uncovered : A.State) (N : Nat),
            m ∈ Finset.range a ∧
              m < childName ∧ childName ≤ a ∧
              smallerName ∈ Finset.range (Fintype.card A.State) ∧
              m < smallerName ∧ smallerName < childName ∧
              (∀ k j : Nat, N ≤ k -> j < m ->
                ¬ SettledLowerSourceNameEvent A run j k) ∧
              (∀ k smaller : Nat, N ≤ k -> smaller < childName ->
                m < smaller -> smaller ≤ a ->
                  ¬ SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameEvent
                    A run v sourceNode child a m smaller sourceState target
                    uncovered k) ∧
              ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
                AcceptingChildCoverageChildNameStateAt A run sourceNode child
                  m smallerName target t) ->
          (automaton A).Accepts word) :
    (automaton A).Accepts word := by
  refine
    automaton_accepts_of_accepts_of_minLowerPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorMinFixedNameCutoffNextNameFreshParentSourceBranchHandler
      A haccepts eqStateHandler acceptingChildHandler ?_
  intro run hrunAccepts v a hsettle _hng hbranch
  rcases hbranch with
    ⟨m, childName, smallerSourceName, sourceNode, child, sourceState, target,
      uncovered, N, hmMem, _hmLtChildName, _hchildNameLe, hsmallerSourceMem,
      _hnoSmallerLower, _hnoSmallerChildName, hfreqFresh⟩
  rcases
      frequently_acceptingNodeNameStateFreshParentNonacceptingAt_green_or_empty_below
        A run (Finset.mem_range.mp hsmallerSourceMem) hfreqFresh with
    hgreenFreq | hemptyFreq
  · exact
      automaton_accepts_of_frequently_acceptingNodeNameStateGreenBelowNonacceptingAt
        A run hrunAccepts hsettle hmMem hgreenFreq
  · exact
      automaton_accepts_of_frequently_acceptingNodeNameStateEmptyBelowNonacceptingAt
        A run hrunAccepts hsettle hmMem hemptyFreq

/--
Direct source-drop closure.  Once lower-source events below `m` have disappeared,
a cofinal accepting occurrence of the fixed source node at a strictly smaller
name cannot be a residual construction branch: an accepting immediate successor
or stable predecessor gives a forbidden smaller lower-source event, while the
fresh-parent, green-below, and empty-below non-stable cases are discharged by the
existing parity-register arguments.
-/
theorem automaton_accepts_of_frequently_acceptingNodeNameStateAt_lt_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v sourceNode : Node A} {a m smallerSourceName N : Nat}
    {target : A.State}
    (hsettle : RunSettlesAt A run v a)
    (hmMem : m ∈ Finset.range a)
    (hsmallerSourceMem : smallerSourceName ∈ Finset.range m)
    (hnoSmallerLower :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hfreqSource :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateAt A run sourceNode smallerSourceName target t) :
    (automaton A).Accepts word := by
  rcases
      frequently_acceptingNodeNameStateAt_next_accepting_or_not
        A run hfreqSource with
    hnextAcceptingFreq | hnextNonacceptingFreq
  · rcases hnextAcceptingFreq N with
      ⟨t, hNt, hevent, hnextAccepting⟩
    have hnextLive :
        ∃ next : LiveState A,
          (automaton A).run word (t + 1) = some next :=
      automaton_run_some_of_accepts A ⟨run, hrunAccepts⟩ (t + 1)
    exact False.elim
      (acceptingNodeNameStateAt_next_accepting_contradicts_no_smaller
        A run (Finset.mem_range.mp hsmallerSourceMem) hNt hnoSmallerLower
        hevent hnextLive hnextAccepting)
  · rcases
        frequently_acceptingNodeNameStateAt_next_nonaccepting_late_prev_stable_or_fresh_parent_or_green_or_empty_below
          A run hrunAccepts (Finset.mem_range.mp hsmallerSourceMem)
          hnoSmallerLower hnextNonacceptingFreq with
      hstableFreq | hfreshFreq | hgreenFreq | hemptyFreq
    · rcases exists_strict_cuts_from_zero_of_frequently_at_or_after
          hstableFreq with
        ⟨cuts, _hzero, hstrict, hstableCuts⟩
      exact False.elim
        (acceptingNodeNameStateAt_prev_active_name_contradict_no_smaller
          A run (Finset.mem_range.mp hsmallerSourceMem) hstrict
          hnoSmallerLower
          (fun i => (hstableCuts i).1)
          (fun i => by
            rcases (hstableCuts i).2.2 with
              ⟨prev, hprev, hactive, hname⟩
            exact ⟨prev, hprev, hactive, hname⟩))
    · rcases
          frequently_acceptingNodeNameStateFreshParentNonacceptingAt_green_or_empty_below
            A run (Finset.mem_range.mp hsmallerSourceMem) hfreshFreq with
        hgreenFreshFreq | hemptyFreshFreq
      · exact
          automaton_accepts_of_frequently_acceptingNodeNameStateGreenBelowNonacceptingAt
            A run hrunAccepts hsettle hmMem hgreenFreshFreq
      · exact
          automaton_accepts_of_frequently_acceptingNodeNameStateEmptyBelowNonacceptingAt
            A run hrunAccepts hsettle hmMem hemptyFreshFreq
    · exact
        automaton_accepts_of_frequently_acceptingNodeNameStateGreenBelowNonacceptingAt
          A run hrunAccepts hsettle hmMem hgreenFreq
    · exact
        automaton_accepts_of_frequently_acceptingNodeNameStateEmptyBelowNonacceptingAt
          A run hrunAccepts hsettle hmMem hemptyFreq

/--
Strict source-name drops in the source-survives branch are closed, not exposed:
they yield a cofinal accepting occurrence of the same source node at a name
strictly below the minimal lower source, and the direct source-drop closure
finishes the parity proof.
-/
theorem automaton_accepts_of_frequently_sourceUncoveredSurvives_sourceNameLt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v sourceNode child : Node A} {a sourceName : Nat}
    {sourceState target uncovered : A.State} {N : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hsourceMem : sourceName ∈ Finset.range a)
    (hnoSmallerLower :
      ∀ k j : Nat, N ≤ k -> j < sourceName ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameLtEvent
          A run v sourceNode child sourceName sourceState target uncovered k) :
    (automaton A).Accepts word := by
  rcases
      exists_frequently_acceptingNodeNameStateAt_lt_of_sourceUncoveredSurvives_sourceNameLt
        A run hfreq with
    ⟨smallerSourceName, hsmallerSourceMem, hfreqSource⟩
  exact
    automaton_accepts_of_frequently_acceptingNodeNameStateAt_lt_no_smaller
      A run hrunAccepts hsettle hsourceMem hsmallerSourceMem
      hnoSmallerLower hfreqSource

/--
Source-survives endpoint with strict source-name drops discharged internally.
The only branch that remains for the breakpoint/countdown argument is the
same-source-name survival branch.
-/
theorem automaton_accepts_of_accepts_of_minLowerPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameEqHandler
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word)
    (sourceNameEqHandler :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ (m : Nat) (sourceNode child : Node A)
              (sourceState target uncovered : A.State) (N : Nat),
            m ∈ Finset.range a ∧
              (∀ k j : Nat, N ≤ k -> j < m ->
                ¬ SettledLowerSourceNameEvent A run j k) ∧
              ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameEqEvent
                  A run v sourceNode child m sourceState target uncovered k) ->
          (automaton A).Accepts word) :
    (automaton A).Accepts word := by
  refine
    automaton_accepts_of_accepts_of_minLowerPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesHandler
      A haccepts ?_
  intro run hrunAccepts v a hsettle hng hsourceSurvives
  rcases hsourceSurvives with
    ⟨m, sourceNode, child, sourceState, target, uncovered, N, hmMem,
      hnoSmallerLower, hfreqSurvives⟩
  rcases
      frequently_settled_positiveSameChildAncestor_sourceUncoveredSurvives_sourceName_eq_or_lt
        A run hfreqSurvives with
    hfreqEq | hfreqLt
  · exact sourceNameEqHandler run hrunAccepts v a hsettle hng
      ⟨m, sourceNode, child, sourceState, target, uncovered, N, hmMem,
        hnoSmallerLower, hfreqEq⟩
  · exact
      automaton_accepts_of_frequently_sourceUncoveredSurvives_sourceNameLt
        A run hrunAccepts hsettle hmMem hnoSmallerLower hfreqLt

/--
Strict-cut version of the sharpened source-drop endpoint.  The source-drop
handler sees only the non-accepting-immediate-successor residual branch, and the
selected cuts are all beyond the no-smaller cutoff `N`.
-/
theorem automaton_accepts_of_accepts_of_minLowerPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorMinFixedNameCutoffNextNameAllStateSourceNextNonacceptingCutHandlers
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word)
    (eqStateHandler :
