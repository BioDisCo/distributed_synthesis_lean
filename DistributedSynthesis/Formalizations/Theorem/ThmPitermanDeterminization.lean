/--
Any accepting node/name/state occurrence is reachable as an NBW prefix state.
-/
theorem acceptingNodeNameStateAt_to_reachable
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t : Nat}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t) :
    AcceptingNodeNameStateReachableAt A run v nodeName target t := by
  rcases hevent with
    ⟨live, hrun, _htargetEq, _haccepting, htargetLabel, _hname⟩
  have hactive : live.1.active v = true :=
    active_of_mem_label A live.1 live.2 htargetLabel
  have hreachable :
      ReachablePrefix A A.initial word t target :=
    automaton_run_live_active_label_reachablePrefix A word hrun hactive
      htargetLabel
  exact ⟨⟨live, hrun, _htargetEq, _haccepting, htargetLabel, _hname⟩,
    hreachable⟩

/--
Immediate accepting-successor bridge.  If an accepting run occurrence is already
in a node with name `nodeName`, and the next run state is also accepting, then
that time is a lower-source event with source state equal to the current run
state.  This is the sound same-time alternative to using an arbitrary
reachability predecessor: no reverse-determinism assumption is needed.
-/
theorem acceptingNodeNameStateAt_next_accepting_to_lowerSourceNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {k : Nat}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target k)
    (hnext :
      ∃ next : LiveState A,
        (automaton A).run word (k + 1) = some next)
    (hnextAccepting : A.accepting (run.path (k + 1))) :
    SettledLowerSourceNameEvent A run nodeName k := by
  rcases hevent with
    ⟨live, hrun, htargetEq, htargetAccepting, htargetLabel, hname⟩
  rcases hnext with ⟨next, hrunNext⟩
  have hactive : live.1.active v = true :=
    active_of_mem_label A live.1 live.2 htargetLabel
  have hstep : A.step target (word k) (run.path (k + 1)) := by
    simpa [htargetEq] using run.step_valid k
  have hsegment :
      SegmentVisitsAccepting A word k 1 target (run.path (k + 1)) :=
    segmentVisitsAccepting_of_segment_accepting_source A word
      (segment_of_step A word hstep) htargetAccepting
  exact ⟨live, next, v, target, hrun, hrunNext, hnextAccepting, hactive,
    htargetLabel, hsegment, hname⟩

/--
Contradiction form of
`acceptingNodeNameStateAt_next_accepting_to_lowerSourceNameEvent`: after a
no-smaller cutoff, a smaller-name accepting node occurrence cannot be
immediately followed by another accepting run state.
-/
theorem acceptingNodeNameStateAt_next_accepting_contradicts_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m N : Nat} {target : A.State} {k : Nat}
    (hnodeLt : nodeName < m)
    (hNk : N ≤ k)
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hevent : AcceptingNodeNameStateAt A run v nodeName target k)
    (hnext :
      ∃ next : LiveState A,
        (automaton A).run word (k + 1) = some next)
    (hnextAccepting : A.accepting (run.path (k + 1))) :
    False :=
  hnoSmaller k nodeName hNk hnodeLt
    (acceptingNodeNameStateAt_next_accepting_to_lowerSourceNameEvent
      A run hevent hnext hnextAccepting)

/--
Stage-(1) predecessor bridge for accepting node/name occurrences.  If an
accepting target is carried by node `v` at time `t`, and `v` was already active
with the same name in the previous live tree, then stage (1)'s predecessor image
supplies a source state in the previous label.  Hence `t - 1` is a genuine
lower-source node/name/source/target event.
-/
theorem acceptingNodeNameStateAt_prev_active_name_to_lowerSourceNodeNameStateTargetEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hname : (prev.1.name v).val = nodeName) :
    ∃ sourceState : A.State,
      SettledLowerSourceNodeNameStateTargetEvent A run v nodeName sourceState
        target (t - 1) := by
  rcases hevent with
    ⟨next, hrunNext, htargetEq, haccepting, htargetLabel, _hnodeName⟩
  have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel hpos
  have hrunNextPrev :
      (automaton A).run word ((t - 1) + 1) = some next := by
    simpa [hsucc] using hrunNext
  have hnextTree : next.1 = liveNextTree A prev (word (t - 1)) :=
    automaton_run_live_nextTree A word hprev hrunNextPrev
  have htargetNextTree :
      target ∈ (liveNextTree A prev (word (t - 1))).label v := by
    simpa [hnextTree] using htargetLabel
  rcases
      liveNextTree_active_label_segment_from_same_node
        A word (n := t - 1) prev hactive htargetNextTree with
    ⟨sourceState, hsource, hsegment⟩
  have hsegmentAccepting :
      SegmentVisitsAccepting A word (t - 1) 1 sourceState target :=
    segmentVisitsAccepting_of_segment_accepting_target A word hsegment
      haccepting
  exact ⟨sourceState, prev, next, hprev, hrunNextPrev,
    by simpa [hsucc] using htargetEq, haccepting,
    hactive, hsource, hsegmentAccepting, hname⟩

/--
The preceding bridge as an ordinary lower-source-name event.
-/
theorem acceptingNodeNameStateAt_prev_active_name_to_lowerSourceNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hname : (prev.1.name v).val = nodeName) :
    SettledLowerSourceNameEvent A run nodeName (t - 1) := by
  rcases
      acceptingNodeNameStateAt_prev_active_name_to_lowerSourceNodeNameStateTargetEvent
        A run hevent hpos hprev hactive hname with
    ⟨sourceState, heventSource⟩
  exact settledLowerSourceNodeNameEvent_to_nameEvent A run
    (settledLowerSourceNodeNameStateEvent_to_nodeNameEvent A run
      (settledLowerSourceNodeNameStateTargetEvent_to_stateEvent A run
        heventSource))

/--
Cut-sequence contradiction form of the stage-(1) predecessor bridge.  After a
no-smaller cutoff, a smaller accepting node/name cut sequence cannot have the
same node already active with that smaller name in every previous live tree.
-/
theorem acceptingNodeNameStateAt_prev_active_name_contradict_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m N : Nat} {target : A.State}
    {cuts : Nat -> Nat}
    (hnodeLt : nodeName < m)
    (hstrict : ∀ i : Nat, cuts i < cuts (i + 1))
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hevents :
      ∀ i : Nat,
        AcceptingNodeNameStateAt A run v nodeName target
          (cuts (i + 1)))
    (hprevs :
      ∀ i : Nat,
        ∃ prev : LiveState A,
          (automaton A).run word (cuts (i + 1) - 1) = some prev ∧
            prev.1.active v = true ∧
            (prev.1.name v).val = nodeName) :
    False := by
  let i : Nat := N
  let t : Nat := cuts (i + 1)
  have hpos : 0 < t := by
    have hle : i + 1 ≤ t := by
      simpa [t] using self_le_of_strict_succ_cuts cuts hstrict (i + 1)
    omega
  have hNk : N ≤ t - 1 := by
    have hle : i + 1 ≤ t := by
      simpa [t] using self_le_of_strict_succ_cuts cuts hstrict (i + 1)
    simp [i] at hle
    omega
  rcases hprevs i with ⟨prev, hprev, hactive, hname⟩
  have hlower :
      SettledLowerSourceNameEvent A run nodeName (t - 1) :=
    acceptingNodeNameStateAt_prev_active_name_to_lowerSourceNameEvent
      A run (by simpa [t] using hevents i) hpos
      (by simpa [t] using hprev) hactive hname
  exact hnoSmaller (t - 1) nodeName hNk hnodeLt hlower

/--
Stage-(1) source-persistence fork for accepting node/name occurrences.  Under
the no-smaller cutoff below `nodeName`, if the node was already active with that
name in the previous live tree, then the accepting transition either greens that
source in stage (3), or routes the accepting target into the source's successor
child union.
-/
theorem acceptingNodeNameStateAt_prev_active_name_source_green_or_covered_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName N : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < nodeName ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ t - 1)
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hname : (prev.1.name v).val = nodeName) :
    (∃ live : LiveState A,
      (automaton A).run word (t - 1) = some live ∧
        v ∈ (((live.1.stage1 A (word (t - 1))).stage2 A
          (livePlan A live (word (t - 1))).stage2Plan).stage3 A).greenNodes A) ∨
      ∃ next : LiveState A,
        (automaton A).run word t = some next ∧
          target ∈ next.1.childLabelUnion A v := by
  rcases hevent with
    ⟨next, hrunNext, htargetEq, haccepting, htargetLabel, hnodeName⟩
  have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel hpos
  have heventRebuilt :
      AcceptingNodeNameStateAt A run v nodeName target t :=
    ⟨next, hrunNext, htargetEq, haccepting, htargetLabel, hnodeName⟩
  rcases
      acceptingNodeNameStateAt_prev_active_name_to_lowerSourceNodeNameStateTargetEvent
        A run heventRebuilt hpos hprev hactive hname with
    ⟨sourceState, hsourceEvent⟩
  have hsettle :
      ∃ next' : LiveState A,
        (automaton A).run word ((t - 1) + 1) = some next' ∧
          target ∈ next'.1.label v :=
    ⟨next, by simpa [hsucc] using hrunNext, htargetLabel⟩
  rcases
      settledLowerSourceNodeNameStateTargetEvent_source_green_or_covered_of_no_smaller
        A run hnoSmaller hNk hsourceEvent hsettle with
    hgreen | hcovered
  · exact Or.inl hgreen
  · rcases hcovered with ⟨next', hrunNext', htargetCovered⟩
    exact Or.inr ⟨next', by simpa [hsucc] using hrunNext',
      htargetCovered⟩

/--
Actual-run-predecessor bridge.  If a fixed accepting node/name/state occurrence
holds at a positive time `t`, and the concrete run predecessor at `t - 1` is
already in the same node with the same name in the previous live tree, then
`t - 1` is a genuine lower-source event.  Unlike the reachability predecessor
bridge below, the source state here is forced to be `run.path (t - 1)`.
-/
theorem acceptingNodeNameStateAt_actual_predecessor_label_to_lowerSourceNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hsource : run.path (t - 1) ∈ prev.1.label v)
    (hname : (prev.1.name v).val = nodeName) :
    SettledLowerSourceNameEvent A run nodeName (t - 1) := by
  rcases hevent with
    ⟨next, hrunNext, htargetEq, haccepting, _htargetLabel, _hnodeName⟩
  have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel hpos
  have hstep : A.step (run.path (t - 1)) (word (t - 1)) target := by
    simpa [hsucc, htargetEq] using run.step_valid (t - 1)
  have hsegment :
      SegmentVisitsAccepting A word (t - 1) 1 (run.path (t - 1))
        target :=
    segmentVisitsAccepting_of_step_accepting_target A word hstep haccepting
  refine ⟨prev, next, v, run.path (t - 1), hprev, ?_, ?_, hactive,
    hsource, ?_, hname⟩
  · simpa [hsucc] using hrunNext
  · simpa [hsucc, htargetEq] using haccepting
  · simpa [hsucc, htargetEq] using hsegment

/--
Strict-cut contradiction form of
`acceptingNodeNameStateAt_actual_predecessor_label_to_lowerSourceNameEvent`.
Once all smaller lower-source events are cut off, a smaller-name accepting
cut sequence is impossible if every selected cut has its actual predecessor
still in the same node/name at the previous live time.
-/
theorem acceptingNodeNameStateAt_actual_predecessor_labels_contradict_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m N : Nat} {target : A.State}
    {cuts : Nat -> Nat}
    (hnodeLt : nodeName < m)
    (hstrict : ∀ i : Nat, cuts i < cuts (i + 1))
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hevents :
      ∀ i : Nat,
        AcceptingNodeNameStateAt A run v nodeName target
          (cuts (i + 1)))
    (hlabels :
      ∀ i : Nat,
        ∃ prev : LiveState A,
          (automaton A).run word (cuts (i + 1) - 1) = some prev ∧
            prev.1.active v = true ∧
            run.path (cuts (i + 1) - 1) ∈ prev.1.label v ∧
            (prev.1.name v).val = nodeName) :
    False := by
  let i : Nat := N
  let t : Nat := cuts (i + 1)
  have hpos : 0 < t := by
    have hle : i + 1 ≤ t := by
      simpa [t] using self_le_of_strict_succ_cuts cuts hstrict (i + 1)
    omega
  have hNk : N ≤ t - 1 := by
    have hle : i + 1 ≤ t := by
      simpa [t] using self_le_of_strict_succ_cuts cuts hstrict (i + 1)
    simp [i] at hle
    omega
  rcases hlabels i with
    ⟨prev, hprev, hactive, hsource, hname⟩
  have hlower :
      SettledLowerSourceNameEvent A run nodeName (t - 1) :=
    acceptingNodeNameStateAt_actual_predecessor_label_to_lowerSourceNameEvent
      A run (by simpa [t] using hevents i) hpos
      (by simpa [t] using hprev) hactive
      (by simpa [t] using hsource) hname
  exact hnoSmaller (t - 1) nodeName hNk hnodeLt hlower

/--
Non-accepting source-drop residual wrapper for the actual-run-predecessor
contradiction.  The non-accepting successor fact is retained in the event
package but is not needed by the lower-source construction itself.
-/
theorem strict_cuts_acceptingNodeNameStateAt_next_nonaccepting_actual_predecessor_labels_contradict_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m N : Nat} {target : A.State}
    {cuts : Nat -> Nat}
    (hnodeLt : nodeName < m)
    (hstrict : ∀ i : Nat, cuts i < cuts (i + 1))
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hevents :
      ∀ i : Nat,
        AcceptingNodeNameStateAt A run v nodeName target
            (cuts (i + 1)) ∧
          ¬ A.accepting (run.path (cuts (i + 1) + 1)))
    (hlabels :
      ∀ i : Nat,
        ∃ prev : LiveState A,
          (automaton A).run word (cuts (i + 1) - 1) = some prev ∧
            prev.1.active v = true ∧
            run.path (cuts (i + 1) - 1) ∈ prev.1.label v ∧
            (prev.1.name v).val = nodeName) :
    False :=
  acceptingNodeNameStateAt_actual_predecessor_labels_contradict_no_smaller
    A run hnodeLt hstrict hnoSmaller
    (fun i => (hevents i).1) hlabels

/--
Actual-predecessor source-persistence fork, phrased at an accepting cut.  After
the cutoff for lower source names below `nodeName`, if the concrete predecessor
of a fixed accepting node/name/state occurrence is still in that same node/name,
then the accepting transition either greens that source in the stage-(3) tree or
puts the accepting target in the source's successor child union.
-/
theorem acceptingNodeNameStateAt_actual_predecessor_source_green_or_covered_of_no_smaller
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName N : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < nodeName ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ t - 1)
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hsource : run.path (t - 1) ∈ prev.1.label v)
    (hname : (prev.1.name v).val = nodeName) :
    (∃ live : LiveState A,
      (automaton A).run word (t - 1) = some live ∧
        v ∈ (((live.1.stage1 A (word (t - 1))).stage2 A
          (livePlan A live (word (t - 1))).stage2Plan).stage3 A).greenNodes A) ∨
      ∃ next : LiveState A,
        (automaton A).run word t = some next ∧
          run.path t ∈ next.1.childLabelUnion A v := by
  rcases hevent with
    ⟨next, hrunNext, htargetEq, haccepting, htargetLabel, _hnodeName⟩
  have hsucc : t - 1 + 1 = t := Nat.sub_add_cancel hpos
  have hacceptingRun :
      A.accepting (run.path (t - 1 + 1)) := by
    simpa [hsucc, htargetEq] using haccepting
  have hsettle :
      run.path (t - 1 + 1) ∈ next.1.label v := by
    simpa [hsucc, htargetEq] using htargetLabel
  rcases
      run_path_succ_accepting_source_green_or_covered_of_no_smaller_lowerSource
        A run (k := t - 1) (N := N) (live := prev) (next := next)
        (v := v) (m := nodeName) hnoSmaller hNk hprev
        (by simpa [hsucc] using hrunNext) hactive hname hsource
        hacceptingRun hsettle with
    hgreen | hcovered
  · exact Or.inl hgreen
  · exact Or.inr ⟨next, hrunNext, by simpa [hsucc] using hcovered⟩

/--
Same source-persistence fork when the available no-smaller cutoff is stated
below a larger ambient name `m`.  This is the shape exposed by the source-drop
branch, where `nodeName < m`.
-/
theorem acceptingNodeNameStateAt_actual_predecessor_source_green_or_covered_of_no_smaller_ambient
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName m N : Nat} {target : A.State} {t : Nat}
    {prev : LiveState A}
    (hnodeLt : nodeName < m)
    (hnoSmaller :
      ∀ k j : Nat, N ≤ k -> j < m ->
        ¬ SettledLowerSourceNameEvent A run j k)
    (hNk : N ≤ t - 1)
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t)
    (hpos : 0 < t)
    (hprev : (automaton A).run word (t - 1) = some prev)
    (hactive : prev.1.active v = true)
    (hsource : run.path (t - 1) ∈ prev.1.label v)
    (hname : (prev.1.name v).val = nodeName) :
    (∃ live : LiveState A,
      (automaton A).run word (t - 1) = some live ∧
        v ∈ (((live.1.stage1 A (word (t - 1))).stage2 A
          (livePlan A live (word (t - 1))).stage2Plan).stage3 A).greenNodes A) ∨
      ∃ next : LiveState A,
        (automaton A).run word t = some next ∧
          run.path t ∈ next.1.childLabelUnion A v :=
  acceptingNodeNameStateAt_actual_predecessor_source_green_or_covered_of_no_smaller
    A run
    (fun k j hNk hj =>
      hnoSmaller k j hNk (lt_trans hj hnodeLt))
    hNk hevent hpos hprev hactive hsource hname

/--
Cofinal split for fixed accepting node/name/state occurrences according to
whether the next accepting-run state is accepting.  The accepting-successor side
feeds `acceptingNodeNameStateAt_next_accepting_contradicts_no_smaller`; the
non-accepting-successor side is the remaining source-drop case.
-/
theorem frequently_acceptingNodeNameStateAt_next_accepting_or_not
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateAt A run v nodeName target t) :
    (∀ n : Nat, ∃ t : Nat, n ≤ t ∧
      AcceptingNodeNameStateAt A run v nodeName target t ∧
        A.accepting (run.path (t + 1))) ∨
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateAt A run v nodeName target t ∧
          ¬ A.accepting (run.path (t + 1)) := by
  classical
  apply frequently_left_or_right_of_frequently_or
  intro n
  rcases hfreq n with ⟨t, hnt, hevent⟩
  by_cases hnextAccepting : A.accepting (run.path (t + 1))
  · exact ⟨t, hnt, Or.inl ⟨hevent, hnextAccepting⟩⟩
  · exact ⟨t, hnt, Or.inr ⟨hevent, hnextAccepting⟩⟩

/--
Interval bridge for fixed accepting node/name/state occurrences.  Once the run
state at time `t` is the fixed accepting `target`, every concrete run interval
starting at `t` is a `SegmentVisitsAccepting`; the accepting visit is at the
source endpoint.  This keeps the source-drop residual in the paper's accepting
segment language without using an arbitrary predecessor.
-/
theorem acceptingNodeNameStateAt_segmentVisitsAccepting_from
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t length : Nat}
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t) :
    SegmentVisitsAccepting A word t length target
      (run.path (t + length)) := by
  rcases hevent with
    ⟨_live, _hrun, htargetEq, haccepting, _htargetLabel, _hname⟩
  simpa [htargetEq] using
    runFrom_segmentVisitsAccepting_of_accepting_source A run
      (startTime := t) (length := length)
      (by simpa [htargetEq] using haccepting)

/--
Later-endpoint form of `acceptingNodeNameStateAt_segmentVisitsAccepting_from`.
If a fixed accepting node/name/state occurrence holds at `t`, then the concrete
run segment from `t` to any later time `u` is accepting, with the accepting visit
at its source endpoint.
-/
theorem acceptingNodeNameStateAt_segmentVisitsAccepting_to_later
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {t u : Nat}
    (htu : t ≤ u)
    (hevent : AcceptingNodeNameStateAt A run v nodeName target t) :
    SegmentVisitsAccepting A word t (u - t) target (run.path u) := by
  have hsegment :=
    acceptingNodeNameStateAt_segmentVisitsAccepting_from
      A run (t := t) (length := u - t) hevent
  have htuEq : t + (u - t) = u := Nat.add_sub_of_le htu
  simpa [htuEq] using hsegment

/--
Strict-cut interval form for fixed accepting node/name/state occurrences.  Along
a strict cut sequence, each selected accepting occurrence at `cuts (i+1)` gives
an accepting concrete run interval to the next selected cut.
-/
theorem strict_cuts_acceptingNodeNameStateAt_segmentVisitsAccepting_to_next_cut
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {cuts : Nat -> Nat}
    (hstrict : ∀ i : Nat, cuts i < cuts (i + 1))
    (hevents :
      ∀ i : Nat,
        AcceptingNodeNameStateAt A run v nodeName target
          (cuts (i + 1))) :
    ∀ i : Nat,
      SegmentVisitsAccepting A word (cuts (i + 1))
        (cuts (i + 2) - cuts (i + 1)) target
        (run.path (cuts (i + 2))) := by
  intro i
  exact
    acceptingNodeNameStateAt_segmentVisitsAccepting_to_later
      A run (t := cuts (i + 1)) (u := cuts (i + 2))
      (Nat.le_of_lt (hstrict (i + 1))) (hevents i)

/--
Exact source-drop residual interval bridge.  The non-accepting immediate
successor fact is kept available in the event package, while the accepting
interval to the next selected cut is obtained from the selected accepting source
endpoint.
-/
theorem strict_cuts_acceptingNodeNameStateAt_next_nonaccepting_segmentVisitsAccepting_to_next_cut
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {cuts : Nat -> Nat}
    (hstrict : ∀ i : Nat, cuts i < cuts (i + 1))
    (hevents :
      ∀ i : Nat,
        AcceptingNodeNameStateAt A run v nodeName target
            (cuts (i + 1)) ∧
          ¬ A.accepting (run.path (cuts (i + 1) + 1))) :
    ∀ i : Nat,
      SegmentVisitsAccepting A word (cuts (i + 1))
        (cuts (i + 2) - cuts (i + 1)) target
        (run.path (cuts (i + 2))) := by
  apply strict_cuts_acceptingNodeNameStateAt_segmentVisitsAccepting_to_next_cut
    A run hstrict
  intro i
  rcases hevents i with ⟨hevent, _hnon⟩
  exact hevent

/--
The strict source-drop residual yields a fixed-target accepting loop between
consecutive selected cuts: the run state at both selected cuts is the same fixed
accepting `target`.
-/
theorem strict_cuts_acceptingNodeNameStateAt_next_nonaccepting_segmentVisitsAccepting_loop
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {cuts : Nat -> Nat}
    (hstrict : ∀ i : Nat, cuts i < cuts (i + 1))
    (hevents :
      ∀ i : Nat,
        AcceptingNodeNameStateAt A run v nodeName target
            (cuts (i + 1)) ∧
          ¬ A.accepting (run.path (cuts (i + 1) + 1))) :
    ∀ i : Nat,
      SegmentVisitsAccepting A word (cuts (i + 1))
        (cuts (i + 2) - cuts (i + 1)) target target := by
  intro i
  have hsegment :=
    strict_cuts_acceptingNodeNameStateAt_next_nonaccepting_segmentVisitsAccepting_to_next_cut
      A run hstrict hevents i
  have htargetNext : run.path (cuts (i + 2)) = target := by
    rcases hevents (i + 1) with ⟨heventNext, _hnonNext⟩
    rcases heventNext with
      ⟨_live, _hrun, htargetEq, _haccepting, _htargetLabel, _hname⟩
    exact htargetEq
  simpa [htargetNext] using hsegment

/--
Because the immediate successor after each selected source-drop cut is
nonaccepting while the next selected cut again carries the fixed accepting
target, consecutive selected cuts cannot be adjacent.  The accepting loop has
length strictly greater than one.
-/
theorem strict_cuts_acceptingNodeNameStateAt_next_nonaccepting_gap_gt_one
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {cuts : Nat -> Nat}
    (hstrict : ∀ i : Nat, cuts i < cuts (i + 1))
    (hevents :
      ∀ i : Nat,
        AcceptingNodeNameStateAt A run v nodeName target
            (cuts (i + 1)) ∧
          ¬ A.accepting (run.path (cuts (i + 1) + 1))) :
    ∀ i : Nat, 1 < cuts (i + 2) - cuts (i + 1) := by
  intro i
  rcases (hevents i).1 with
    ⟨_live, _hrun, _htargetEq, _haccepting, _htargetLabel, _hname⟩
  rcases (hevents (i + 1)).1 with
    ⟨_nextLive, _hrunNext, htargetNextEq, htargetAcceptingNext,
      _htargetNextLabel, _hnameNext⟩
  have hnon : ¬ A.accepting (run.path (cuts (i + 1) + 1)) :=
    (hevents i).2
  by_contra hnot
  have hle : cuts (i + 2) - cuts (i + 1) ≤ 1 := by omega
  have hpos : 0 < cuts (i + 2) - cuts (i + 1) := by
    have hlt : cuts (i + 1) < cuts (i + 2) := hstrict (i + 1)
    omega
  have hdiff : cuts (i + 2) - cuts (i + 1) = 1 := by omega
  have hsuccEq : cuts (i + 1) + 1 = cuts (i + 2) := by omega
  have htargetCut :
      A.accepting (run.path (cuts (i + 2))) := by
    simpa [htargetNextEq] using htargetAcceptingNext
  exact hnon (by simpa [hsuccEq] using htargetCut)

/--
Singleton-cover form of the fixed-target accepting loop.  This packages the
source-drop residual in the same set-cover language used by the green-event
interval machinery.
-/
theorem strict_cuts_acceptingNodeNameStateAt_next_nonaccepting_loop_cover
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {cuts : Nat -> Nat}
    (hstrict : ∀ i : Nat, cuts i < cuts (i + 1))
    (hevents :
      ∀ i : Nat,
        AcceptingNodeNameStateAt A run v nodeName target
            (cuts (i + 1)) ∧
          ¬ A.accepting (run.path (cuts (i + 1) + 1))) :
    ∀ i : Nat,
      SegmentVisitsAcceptingCover A word (cuts (i + 1))
        (cuts (i + 2) - cuts (i + 1)) {target} {target} := by
  intro i
  exact segmentVisitsAcceptingCover_singleton A word
    (strict_cuts_acceptingNodeNameStateAt_next_nonaccepting_segmentVisitsAccepting_loop
      A run hstrict hevents i)

/--
Cutoff-aware strict-cut form of the remaining source-drop branch after the
immediate accepting-successor side has been eliminated.  Every selected cut is
past `N`, carries the fixed accepting node/name/state occurrence, and has a
non-accepting immediate successor.
-/
theorem exists_strict_cuts_acceptingNodeNameStateAt_next_nonaccepting_after
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {N : Nat}
    (hfreq :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateAt A run v nodeName target t ∧
          ¬ A.accepting (run.path (t + 1))) :
    ∃ cuts : Nat -> Nat,
      cuts 0 = 0 ∧
        (∀ i : Nat, cuts i < cuts (i + 1)) ∧
          (∀ i : Nat, N ≤ cuts (i + 1)) ∧
            ∀ i : Nat,
              AcceptingNodeNameStateAt A run v nodeName target
                  (cuts (i + 1)) ∧
                ¬ A.accepting (run.path (cuts (i + 1) + 1)) := by
  have hfreqAfter :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        N ≤ t ∧
          AcceptingNodeNameStateAt A run v nodeName target t ∧
            ¬ A.accepting (run.path (t + 1)) := by
    intro n
    rcases hfreq (max n N) with ⟨t, hmaxt, hevent, hnon⟩
    exact ⟨t, le_trans (Nat.le_max_left n N) hmaxt,
      le_trans (Nat.le_max_right n N) hmaxt, hevent, hnon⟩
  rcases exists_strict_cuts_from_zero_of_frequently_at_or_after
      hfreqAfter with
    ⟨cuts, hzero, hstrict, hevents⟩
  exact ⟨cuts, hzero, hstrict,
    (fun i => (hevents i).1),
    fun i => (hevents i).2⟩

/--
Packaged form of the sharpened source-drop residual.  From a cofinal recurrence
of fixed accepting node/name/state cuts with non-accepting immediate successors,
choose strict cutoff-aware cuts and expose both the fixed-target accepting loop
cover and the fact that every loop has length greater than one.
-/
theorem exists_strict_cuts_acceptingNodeNameStateAt_next_nonaccepting_after_with_loops
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    {nodeName : Nat} {target : A.State} {N : Nat}
    (hfreq :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingNodeNameStateAt A run v nodeName target t ∧
          ¬ A.accepting (run.path (t + 1))) :
    ∃ cuts : Nat -> Nat,
      cuts 0 = 0 ∧
        (∀ i : Nat, cuts i < cuts (i + 1)) ∧
          (∀ i : Nat, N ≤ cuts (i + 1)) ∧
            (∀ i : Nat,
              AcceptingNodeNameStateAt A run v nodeName target
                  (cuts (i + 1)) ∧
                ¬ A.accepting (run.path (cuts (i + 1) + 1))) ∧
              (∀ i : Nat, 1 < cuts (i + 2) - cuts (i + 1)) ∧
                ∀ i : Nat,
                  SegmentVisitsAcceptingCover A word (cuts (i + 1))
                    (cuts (i + 2) - cuts (i + 1)) {target} {target} := by
  rcases
      exists_strict_cuts_acceptingNodeNameStateAt_next_nonaccepting_after
        A run hfreq with
    ⟨cuts, hzero, hstrict, hcutoff, hevents⟩
  exact ⟨cuts, hzero, hstrict, hcutoff, hevents,
    strict_cuts_acceptingNodeNameStateAt_next_nonaccepting_gap_gt_one
      A run hstrict hevents,
    strict_cuts_acceptingNodeNameStateAt_next_nonaccepting_loop_cover
      A run hstrict hevents⟩

/--
Any accepting child/name/state occurrence is reachable as an NBW prefix state.
-/
theorem acceptingChildCoverageChildNameStateAt_to_reachable
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v child : Node A}
    {a childName : Nat} {target : A.State} {t : Nat}
    (hevent :
      AcceptingChildCoverageChildNameStateAt A run v child a childName target t) :
    AcceptingChildCoverageChildNameStateReachableAt A run v child a childName
      target t := by
  rcases hevent with
    ⟨live, hrun, _htargetEq, _haccepting, hchild, htargetLabel, hname,
      hgt⟩
  have hchildSpec := hchild
  rw [children, Finset.mem_filter] at hchildSpec
  have hactive : live.1.active child = true := hchildSpec.2.1
  have hreachable :
      ReachablePrefix A A.initial word t target :=
    automaton_run_live_active_label_reachablePrefix A word hrun hactive
      htargetLabel
  exact ⟨⟨live, hrun, _htargetEq, _haccepting, hchild, htargetLabel, hname,
      hgt⟩,
    hreachable⟩

/--
Cofinal accepting node/name/state occurrences can be enriched with NBW prefix
