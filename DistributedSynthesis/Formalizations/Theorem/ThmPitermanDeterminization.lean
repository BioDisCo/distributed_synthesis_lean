    (automaton A).Accepts word := by
  refine automaton_accepts_of_accepts_of_descentHorns A haccepts
    greenHorn ?_
  intro run hrunAccepts v a hsettle hng
  exact runSettles_descendHorn_of_minimal_branch_handlers A run hrunAccepts
