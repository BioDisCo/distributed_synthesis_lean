        hchildSubset, _hsiblingDisjoint⟩
    exact hchildSubset sourceNode child hchildNext htargetNextChild
  refine ⟨smallerName, Finset.mem_range.mpr (by simpa [smallerName] using hsourceLt),
    ?_⟩
  exact ⟨next, hrunNext, hmemSource, by simpa [htargetEq] using haccepting, rfl⟩

/--
Cofinal source-name compaction concentrates on one smaller successor source
name at accepting times.
-/
theorem exists_frequently_acceptingNodeNameAt_lt_of_sourceNameLt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextSourceNameLtEvent
