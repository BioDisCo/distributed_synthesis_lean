    have hsubset :
        t3.label (plan.freshChild green) ⊆ t3.label green := by
      simpa [t1, plan, t2, t3] using
        (stage2_stage3_green_freshChild_label_subset_parent A t1 plan
          hrootActive
          (by simpa [t1] using htrigger)
          (by simpa [t1, plan, t2, t3] using hgreen))
