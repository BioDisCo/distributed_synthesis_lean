    {n : Nat} {live : LiveState A}
    (hrun : (automaton A).run word n = some live)
    {parent : Node A}
    (hparent :
      parent ∈ (live.1.stage1 A (word n)).stage2Triggers A)
    {state : A.State}
    (hstate :
      state ∈
        ((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).label
          ((livePlan A live (word n)).stage2Plan.freshChild parent))
    (hnot :
      state ∉
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label
          ((livePlan A live (word n)).stage2Plan.freshChild parent)) :
    ∃ ancestor older,
      ((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).IsAncestorOrSelf A ancestor
        ((livePlan A live (word n)).stage2Plan.freshChild parent) ∧
        ((live.1.stage1 A (word n)).stage2 A
          (livePlan A live (word n)).stage2Plan).OlderSibling A older ancestor ∧
        state ∈
          ((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).label older ∧
        A.accepting state ∧
        ReachableAfter A A.initial word (n + 1) state := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  obtain ⟨ancestor, older, hancestor, holder, holderState, haccepting⟩ :=
    stage2_stage3_removed_freshChild_blocked_by_older A t1 plan
      hparent
      (by simpa [t1, plan] using hstate)
      (by simpa [t1, plan] using hnot)
  have hreachable :
      ReachableAfter A A.initial word (n + 1) state :=
    automaton_run_live_stage2_active_label_reachable A word hrun
      (by
        simpa [t1, plan] using holder.1)
      (by
        simpa [t1, plan] using holderState)
  exact ⟨ancestor, older, hancestor, holder, holderState, haccepting,
    hreachable⟩

theorem automaton_run_live_stage2Trigger_accepting_survives_or_routes
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live : LiveState A}
    (hrun : (automaton A).run word n = some live)
    {parent : Node A}
    (hparent :
      parent ∈ (live.1.stage1 A (word n)).stage2Triggers A) :
    ∃ state,
      A.accepting state ∧
        ReachableAfter A A.initial word (n + 1) state ∧
        (state ∈
            (((live.1.stage1 A (word n)).stage2 A
              (livePlan A live (word n)).stage2Plan).stage3 A).label
              ((livePlan A live (word n)).stage2Plan.freshChild parent) ∨
          ∃ ancestor older,
            ((live.1.stage1 A (word n)).stage2 A
                (livePlan A live (word n)).stage2Plan).IsAncestorOrSelf A
              ancestor
              ((livePlan A live (word n)).stage2Plan.freshChild parent) ∧
            ((live.1.stage1 A (word n)).stage2 A
                (livePlan A live (word n)).stage2Plan).OlderSibling A
              older ancestor ∧
            state ∈
              ((live.1.stage1 A (word n)).stage2 A
                (livePlan A live (word n)).stage2Plan).label older) := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases exists_accepting_label_of_stage2Trigger A t1
      (by simpa [t1] using hparent) with
    ⟨state, hstateParent, haccepting⟩
  have hstateFresh_t2 : state ∈ t2.label (plan.freshChild parent) := by
    simp only [t2]
    rw [stage2_freshChild_label A t1 plan (by simpa [t1] using hparent)]
    rw [mem_acceptingPart A t1]
    exact ⟨hstateParent, haccepting⟩
  by_cases hsurvives :
      state ∈ t3.label (plan.freshChild parent)
  · have hwitness :=
      automaton_run_live_stage3_freshChild_accepting_reachable A word hrun
        hparent (by simpa [t1, plan, t2, t3] using hsurvives)
    exact ⟨state, hwitness.1, hwitness.2,
      Or.inl (by simpa [t1, plan, t2, t3] using hsurvives)⟩
  · rcases automaton_run_live_removed_freshChild_routed_accepting_reachable
      A word hrun hparent
      (by simpa [t1, plan, t2] using hstateFresh_t2)
      (by simpa [t1, plan, t2, t3] using hsurvives) with
      ⟨ancestor, older, hancestor, holder, holderState, haccepting',
        hreachable⟩
    exact ⟨state, haccepting', hreachable,
      Or.inr ⟨ancestor, older,
        by simpa [t1, plan, t2] using hancestor,
        by simpa [t1, plan, t2] using holder,
        by simpa [t1, plan, t2] using holderState⟩⟩

theorem automaton_run_frequently_root_stage2Trigger_survives_or_routes_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    ∀ n : Nat,
      ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            root A ∈ (live.1.stage1 A (word k)).stage2Triggers A ∧
            ∃ state,
              A.accepting state ∧
