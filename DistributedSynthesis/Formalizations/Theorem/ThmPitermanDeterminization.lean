/-- Frontier-level survives event: the accepting transition target lands in the
fresh child of the fixed-name frontier and persists through stage (3). -/
def FrontierGreenSurvivesEvent [DecidableEq A.State]
    (word : OmegaWord Alphabet) (frontierName : Nat) (k : Nat) : Prop :=
  ∃ live : LiveState A,
    (automaton A).run word k = some live ∧
      ∃ frontier source target,
        live.1.active frontier = true ∧
          (live.1.name frontier).val = frontierName ∧
          source ∈ live.1.label frontier ∧
          source ∉ live.1.childLabelUnion A frontier ∧
          A.step source (word k) target ∧
          A.accepting target ∧
          let t1 := live.1.stage1 A (word k)
          let plan := (livePlan A live (word k)).stage2Plan
          let t2 := t1.stage2 A plan
          target ∈ t2.label (plan.freshChild frontier) ∧
            target ∈ (t2.stage3 A).label (plan.freshChild frontier)

/-- Frontier-level routed event: the accepting transition target is removed from
the fresh child at stage (3) and survives only in an older sibling of one of its
ancestors -- the case where the run descends to a smaller name. -/
def FrontierGreenRoutedEvent [DecidableEq A.State]
    (word : OmegaWord Alphabet) (frontierName : Nat) (k : Nat) : Prop :=
  ∃ live : LiveState A,
    (automaton A).run word k = some live ∧
      ∃ frontier source target,
        live.1.active frontier = true ∧
          (live.1.name frontier).val = frontierName ∧
          source ∈ live.1.label frontier ∧
          source ∉ live.1.childLabelUnion A frontier ∧
          A.step source (word k) target ∧
          A.accepting target ∧
          let t1 := live.1.stage1 A (word k)
          let plan := (livePlan A live (word k)).stage2Plan
          let t2 := t1.stage2 A plan
          target ∈ t2.label (plan.freshChild frontier) ∧
            ∃ ancestor older,
              t2.IsAncestorOrSelf A ancestor (plan.freshChild frontier) ∧
                t2.OlderSibling A older ancestor ∧
                  target ∈ t2.label older

/--
Frontier survives/routed dichotomy: from an accepting run, a fixed frontier name
recurs on which *either* the survives event holds throughout a strict cut
sequence *or* the routed event does.  Applies the descent-dichotomy combinator to
`automaton_accepts_frontierFreshChildStage3Split_cuts_of_accepts`.  This is the
locate-the-stable-name step: the survives branch feeds the breakpoint at the
frontier name, the routed branch the descent to a smaller name.
-/
theorem automaton_accepts_frontierGreenSurvives_or_routed_cuts_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    ∃ frontierName : Nat,
      frontierName ∈ Finset.range (Fintype.card A.State) ∧
        ((∃ cuts : Nat -> Nat,
            cuts 0 = 0 ∧ (∀ i : Nat, cuts i < cuts (i + 1)) ∧
              ∀ i : Nat, FrontierGreenSurvivesEvent A word frontierName
                (cuts (i + 1))) ∨
          (∃ cuts : Nat -> Nat,
            cuts 0 = 0 ∧ (∀ i : Nat, cuts i < cuts (i + 1)) ∧
              ∀ i : Nat, FrontierGreenRoutedEvent A word frontierName
                (cuts (i + 1)))) := by
  obtain ⟨frontierName, hmem, cuts, hzero, hstrict, hevents⟩ :=
    automaton_accepts_frontierFreshChildStage3Split_cuts_of_accepts A haccepts
  refine ⟨frontierName, hmem, ?_⟩
  have hsplit :
      ∀ i : Nat,
        FrontierGreenSurvivesEvent A word frontierName (cuts (i + 1)) ∨
          FrontierGreenRoutedEvent A word frontierName (cuts (i + 1)) := by
    intro i
    obtain ⟨live, hrun, frontier, source, target, hact, hname, hsrc, hpriv,
      hstep, hacc, htarget, hdisj⟩ := hevents i
    rcases hdisj with hS | hR
    · exact Or.inl ⟨live, hrun, frontier, source, target, hact, hname, hsrc,
        hpriv, hstep, hacc, htarget, hS⟩
    · exact Or.inr ⟨live, hrun, frontier, source, target, hact, hname, hsrc,
        hpriv, hstep, hacc, htarget, hR⟩
  exact exists_strict_cuts_dichotomy_of_strict_cuts cuts hstrict hsplit

theorem automaton_run_frequently_root_stage2Trigger_of_runFrom
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (haccepting : run.Accepts) :
    ∀ n : Nat,
      ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            root A ∈ (live.1.stage1 A (word k)).stage2Triggers A := by
  intro n
  rcases haccepting (n + 1) with ⟨t, ht, htAccepting⟩
  let k : Nat := t - 1
  have htpos : 0 < t := by omega
  have ht_eq : t = k + 1 := by omega
  have hnle : n ≤ k := by omega
  rcases automaton_run_exists_live_root_label_of_runFrom A run k with
    ⟨live, hrun, hpath⟩
  have hstage1 :
      run.path (k + 1) ∈ (live.1.stage1 A (word k)).label (root A) :=
    (mem_stage1_label A live.1 (word k)).mpr
      ⟨run.path k, hpath, run.step_valid k⟩
  have hrootActive : (live.1.stage1 A (word k)).active (root A) = true := by
    rcases live.2 with
      ⟨hrootActive, _hrootName, _hrootParent, _hparentInvariant,
        _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
        _hchildSubset, _hsiblingDisjoint⟩
    simpa [stage1] using hrootActive
  refine ⟨k, hnle, live, hrun, ?_⟩
  apply mem_stage2Triggers_of_accepting_label A (live.1.stage1 A (word k))
    hrootActive hstage1
  simpa [ht_eq] using htAccepting

theorem automaton_run_frequently_root_stage2Trigger_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    ∀ n : Nat,
      ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            root A ∈ (live.1.stage1 A (word k)).stage2Triggers A := by
  rcases haccepts with ⟨run, haccepting⟩
  exact automaton_run_frequently_root_stage2Trigger_of_runFrom A run haccepting

theorem automaton_run_frequently_root_stage2_freshChild_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    ∀ n : Nat,
      ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            root A ∈ (live.1.stage1 A (word k)).stage2Triggers A ∧
            let t1 := live.1.stage1 A (word k)
            let plan := (livePlan A live (word k)).stage2Plan
            ((t1.stage2 A plan).label (plan.freshChild (root A))).Nonempty ∧
              (t1.stage2 A plan).active (plan.freshChild (root A)) = true ∧
                (t1.stage2 A plan).parent (plan.freshChild (root A)) =
                  root A := by
  intro n
  rcases automaton_run_frequently_root_stage2Trigger_of_accepts A haccepts n with
    ⟨k, hk, live, hrun, htrigger⟩
  refine ⟨k, hk, live, hrun, htrigger, ?_⟩
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  exact ⟨
    by simpa [t1, plan] using
      (stage2_freshChild_label_nonempty A t1 plan
        (by simpa [t1] using htrigger)),
    by simpa [t1, plan] using
      (stage2_freshChild_active A t1 plan
        (by simpa [t1] using htrigger)),
    by simpa [t1, plan] using
      (stage2_freshChild_parent A t1 plan
        (by simpa [t1] using htrigger))⟩

theorem live_label_subset_root [DecidableEq A.State]
    (live : LiveState A) {node : Node A}
    (hactive : live.1.active node = true) :
    live.1.label node ⊆ live.1.label (root A) := by
  rcases live.2 with
    ⟨_hrootActive, _hrootName, hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      hchildSubset, _hsiblingDisjoint⟩
  exact label_subset_of_isAncestorOrSelf A live.1 hrootParent
    hparentInvariant hchildSubset hactive
    (root_isAncestorOrSelf A live.1 hparentInvariant hactive)

theorem live_descendant_label_subset_ancestor [DecidableEq A.State]
    (live : LiveState A)
    {ancestor descendant : Node A}
    (hdescendantActive : live.1.active descendant = true)
    (hancestor :
      live.1.IsAncestorOrSelf A ancestor descendant) :
    live.1.label descendant ⊆ live.1.label ancestor := by
  rcases live.2 with
    ⟨_hrootActive, _hrootName, hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      hchildSubset, _hsiblingDisjoint⟩
  exact label_subset_of_isAncestorOrSelf A live.1 hrootParent
    hparentInvariant hchildSubset hdescendantActive hancestor

theorem live_descendant_segmentCover_from_ancestor_cover
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {startTime length : Nat} {sources : Finset A.State}
    (live : LiveState A)
    {ancestor descendant : Node A}
    (hdescendantActive : live.1.active descendant = true)
    (hancestor :
      live.1.IsAncestorOrSelf A ancestor descendant)
    (hcover :
      SegmentCover A word startTime length sources
        (live.1.label ancestor)) :
    SegmentCover A word startTime length sources
      (live.1.label descendant) := by
  exact segmentCover_mono_targets A word hcover
    (live_descendant_label_subset_ancestor A live hdescendantActive
      hancestor)

theorem live_descendant_label_cover_from_ancestor_cover
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {startTime length : Nat} {sources : Finset A.State}
    (live : LiveState A)
    {ancestor descendant : Node A}
    (hdescendantActive : live.1.active descendant = true)
    (hancestor :
      live.1.IsAncestorOrSelf A ancestor descendant)
    (hcover :
      SegmentVisitsAcceptingCover A word startTime length sources
        (live.1.label ancestor)) :
    SegmentVisitsAcceptingCover A word startTime length sources
      (live.1.label descendant) := by
  exact segmentVisitsAcceptingCover_mono_targets A word hcover
    (live_descendant_label_subset_ancestor A live hdescendantActive
      hancestor)

theorem live_proper_descendant_segmentCover_from_child_covers
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {startTime length : Nat} {sources : Finset A.State}
    (live : LiveState A)
    {ancestor descendant : Node A}
    (hdescendantActive : live.1.active descendant = true)
    (hancestor :
      live.1.IsAncestorOrSelf A ancestor descendant)
    (hne : ancestor ≠ descendant)
    (hchildCover :
      ∀ child, child ∈ live.1.children A ancestor ->
        SegmentCover A word startTime length sources
          (live.1.label child)) :
    SegmentCover A word startTime length sources
      (live.1.label descendant) := by
  rcases live.2 with
    ⟨_hrootActive, _hrootName, hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  rcases exists_child_of_isAncestorOrSelf_ne A live.1 hrootParent
      hparentInvariant hdescendantActive hancestor hne with
    ⟨child, hchild, hchildAncestor⟩
  exact live_descendant_segmentCover_from_ancestor_cover A word live
    hdescendantActive hchildAncestor (hchildCover child hchild)

theorem live_proper_descendant_label_cover_from_child_covers
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {startTime length : Nat} {sources : Finset A.State}
    (live : LiveState A)
    {ancestor descendant : Node A}
    (hdescendantActive : live.1.active descendant = true)
    (hancestor :
      live.1.IsAncestorOrSelf A ancestor descendant)
    (hne : ancestor ≠ descendant)
    (hchildCover :
      ∀ child, child ∈ live.1.children A ancestor ->
        SegmentVisitsAcceptingCover A word startTime length sources
          (live.1.label child)) :
    SegmentVisitsAcceptingCover A word startTime length sources
      (live.1.label descendant) := by
  rcases live.2 with
    ⟨_hrootActive, _hrootName, hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  rcases exists_child_of_isAncestorOrSelf_ne A live.1 hrootParent
      hparentInvariant hdescendantActive hancestor hne with
    ⟨child, hchild, hchildAncestor⟩
  exact live_descendant_label_cover_from_ancestor_cover A word live
    hdescendantActive hchildAncestor (hchildCover child hchild)

theorem live_child_label_cover_from_parent_cover [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {startTime length : Nat} {sources : Finset A.State}
    (live : LiveState A)
    {parent child : Node A}
    (hchild : child ∈ live.1.children A parent)
    (hcover :
      SegmentVisitsAcceptingCover A word startTime length sources
        (live.1.label parent)) :
    SegmentVisitsAcceptingCover A word startTime length sources
      (live.1.label child) := by
  have hactiveChild : live.1.active child = true := by
    rw [children, Finset.mem_filter] at hchild
    exact hchild.2.1
  exact live_descendant_label_cover_from_ancestor_cover A word live
    hactiveChild (isAncestorOrSelf_of_child A live.1
      (isAncestorOrSelf_refl A live.1 parent) hchild) hcover

theorem live_child_name_gt_parent [DecidableEq A.State]
    (live : LiveState A)
    {parent child : Node A}
    (hchild : child ∈ live.1.children A parent) :
    (live.1.name parent).val < (live.1.name child).val := by
  rcases live.2 with
    ⟨_hrootActive, _hrootName, _hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  rw [children, Finset.mem_filter] at hchild
  have hactiveChild : live.1.active child = true := hchild.2.1
  have hnotRoot : child ≠ root A := hchild.2.2.1
  have hparentEq : live.1.parent child = parent := hchild.2.2.2
  rcases hparentInvariant child hactiveChild hnotRoot with
    ⟨_hparentActive, hnameLt⟩
  simpa [hparentEq] using hnameLt

theorem live_child_name_gt_of_parent_name [DecidableEq A.State]
    (live : LiveState A)
    {parent child : Node A} {name : Nat}
    (hchild : child ∈ live.1.children A parent)
    (hname : (live.1.name parent).val = name) :
    name < (live.1.name child).val := by
  rw [← hname]
  exact live_child_name_gt_parent A live hchild

theorem automaton_run_live_active_label_reachable [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live : LiveState A}
    (hrun : (automaton A).run word n = some live)
    {node : Node A}
    (hactive : live.1.active node = true)
    {state : A.State}
    (hstate : state ∈ live.1.label node) :
    ReachableAfter A A.initial word n state := by
  exact automaton_run_live_root_label_reachable A word n live hrun state
    ((live_label_subset_root A live hactive) hstate)

theorem automaton_run_live_active_label_reachablePrefix [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live : LiveState A}
    (hrun : (automaton A).run word n = some live)
    {node : Node A}
    (hactive : live.1.active node = true)
    {state : A.State}
    (hstate : state ∈ live.1.label node) :
    ReachablePrefix A A.initial word n state :=
  reachableAfter_to_prefix A A.initial word
    (automaton_run_live_active_label_reachable A word hrun hactive hstate)

theorem automaton_run_live_stage3_freshChild_accepting_reachable
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live : LiveState A}
    (hrun : (automaton A).run word n = some live)
    {parent : Node A}
    (hparent :
      parent ∈ (live.1.stage1 A (word n)).stage2Triggers A)
    {state : A.State}
    (hstate :
      state ∈
        (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label
          ((livePlan A live (word n)).stage2Plan.freshChild parent)) :
    A.accepting state ∧
      ReachableAfter A A.initial word (n + 1) state := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  have haccepting :
      A.accepting state :=
    stage2_stage3_freshChild_label_accepting A t1 plan hparent hstate
  have hstate_parent_t1 :
      state ∈ t1.label parent :=
    stage2_stage3_freshChild_label_mem_parent A t1 plan hparent hstate
  rcases (mem_stage1_label A live.1 (word n)).mp
      (by simpa [t1] using hstate_parent_t1) with
    ⟨prev, hprevMem, hstep⟩
  have hparent_active_t1 : t1.active parent = true :=
    (mem_stage2Triggers A t1).mp hparent |>.1
  have hparent_active_live : live.1.active parent = true := by
    simpa [t1, stage1_active A live.1 (word n) parent] using hparent_active_t1
  have hprevReachable :
      ReachableAfter A A.initial word n prev :=
    automaton_run_live_active_label_reachable A word hrun
      hparent_active_live hprevMem
  exact ⟨haccepting, ⟨prev, hprevReachable, hstep⟩⟩

theorem automaton_run_live_stage2Trigger_accepting_reachable
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live : LiveState A}
    (hrun : (automaton A).run word n = some live)
    {parent : Node A}
    (hparent :
      parent ∈ (live.1.stage1 A (word n)).stage2Triggers A) :
    ∃ state,
      state ∈ (live.1.stage1 A (word n)).label parent ∧
        A.accepting state ∧
          ReachableAfter A A.initial word (n + 1) state := by
  rcases exists_accepting_label_of_stage2Trigger A
      (live.1.stage1 A (word n)) hparent with
    ⟨state, hstateLabel, haccepting⟩
  rcases (mem_stage1_label A live.1 (word n)).mp hstateLabel with
    ⟨prev, hprevMem, hstep⟩
  have hparent_active_t1 :
      (live.1.stage1 A (word n)).active parent = true :=
    (mem_stage2Triggers A (live.1.stage1 A (word n))).mp hparent |>.1
  have hparent_active_live : live.1.active parent = true := by
    simpa [stage1_active A live.1 (word n) parent] using hparent_active_t1
  have hprevReachable :
      ReachableAfter A A.initial word n prev :=
    automaton_run_live_active_label_reachable A word hrun
      hparent_active_live hprevMem
  exact ⟨state, hstateLabel, haccepting, ⟨prev, hprevReachable, hstep⟩⟩

theorem automaton_run_live_stage2_active_label_reachable
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live : LiveState A}
    (hrun : (automaton A).run word n = some live)
    {node : Node A} {state : A.State}
    (hactive :
      ((live.1.stage1 A (word n)).stage2 A
        (livePlan A live (word n)).stage2Plan).active node = true)
    (hstate :
      state ∈ ((live.1.stage1 A (word n)).stage2 A
        (livePlan A live (word n)).stage2Plan).label node) :
    ReachableAfter A A.initial word (n + 1) state := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  rcases stage2_active_label_mem_source_label A t1 plan
      (by simpa [t1, plan] using hactive)
      (by simpa [t1, plan] using hstate) with
    ⟨source, hsourceActiveT1, hstateSourceT1⟩
  rcases (mem_stage1_label A live.1 (word n)).mp
      (by simpa [t1] using hstateSourceT1) with
    ⟨prev, hprevMem, hstep⟩
  have hsourceActiveLive : live.1.active source = true := by
    simpa [t1, stage1_active A live.1 (word n) source] using
      hsourceActiveT1
  have hprevReachable :
      ReachableAfter A A.initial word n prev :=
    automaton_run_live_active_label_reachable A word hrun
      hsourceActiveLive hprevMem
  exact ⟨prev, hprevReachable, hstep⟩

theorem automaton_accepts_frequently_transition_green_same_name_reachable
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (haccepts : (automaton A).Accepts word) :
    ∃ recurrentName : Name A,
      ∀ n : Nat,
        ∃ k : Nat, n ≤ k ∧
          ∃ prev next : LiveState A,
            (automaton A).run word k = some prev ∧
            (automaton A).run word (k + 1) = some next ∧
            next.1.f = recurrentName ∧
            ∃ green state,
              green ∈
                (((prev.1.stage1 A (word k)).stage2 A
                    (livePlan A prev (word k)).stage2Plan).stage3 A).greenNodes A ∧
              ((((prev.1.stage1 A (word k)).stage2 A
                    (livePlan A prev (word k)).stage2Plan).stage3 A).name
                  green).val =
                recurrentName.val ∧
              recurrentName.val < next.1.e.val ∧
              state ∈
                (((prev.1.stage1 A (word k)).stage2 A
                    (livePlan A prev (word k)).stage2Plan).stage3 A).label green ∧
              ReachableAfter A A.initial word (k + 1) state := by
  classical
  rcases automaton_accepts_frequently_transition_green_same_name A word
      haccepts with
    ⟨recurrentName, hfreq⟩
  refine ⟨recurrentName, ?_⟩
  intro n
  rcases hfreq n with
    ⟨k, hk, prev, next, hprev, hnext, hnextName, green, hgreen,
      hgreenName, hgreenE, hgreenNonempty⟩
  let t1 := prev.1.stage1 A (word k)
  let t2 := t1.stage2 A (livePlan A prev (word k)).stage2Plan
  let t3 := t2.stage3 A
  have hlabelNonempty : (t3.label green).Nonempty := by
    exact Finset.nonempty_iff_ne_empty.mpr
      (by simpa [t1, t2, t3] using hgreenNonempty)
  rcases hlabelNonempty with ⟨state, hstateGreen⟩
  have hgreen_t3 : green ∈ t3.greenNodes A := by
    simpa [t1, t2, t3] using hgreen
  have hgreenActive_t3 : t3.active green = true :=
    (mem_greenNodes A t3).mp hgreen_t3 |>.1
  have hgreenActive_t2 : t2.active green = true := by
    simpa [t3, stage3] using hgreenActive_t3
  have hstate_t2 : state ∈ t2.label green :=
    stage3_label_subset A t2 green hstateGreen
  have hreachable :
      ReachableAfter A A.initial word (k + 1) state :=
    automaton_run_live_stage2_active_label_reachable A word hprev
      (by simpa [t1, t2] using hgreenActive_t2)
      (by simpa [t1, t2] using hstate_t2)
  exact ⟨k, hk, prev, next, hprev, hnext, hnextName, green, state,
    hgreen, hgreenName, hgreenE, by simpa [t1, t2, t3] using hstateGreen,
    hreachable⟩

theorem automaton_accepts_frequently_transition_green_same_name_child_reachable
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (haccepts : (automaton A).Accepts word) :
    ∃ recurrentName : Name A,
      ∀ n : Nat,
        ∃ k : Nat, n ≤ k ∧
          ∃ prev next : LiveState A,
            (automaton A).run word k = some prev ∧
            (automaton A).run word (k + 1) = some next ∧
            next.1.f = recurrentName ∧
            ∃ green child state,
              green ∈
                (((prev.1.stage1 A (word k)).stage2 A
                    (livePlan A prev (word k)).stage2Plan).stage3 A).greenNodes A ∧
              child ∈
                (((prev.1.stage1 A (word k)).stage2 A
                    (livePlan A prev (word k)).stage2Plan).stage3 A).children A green ∧
              ((((prev.1.stage1 A (word k)).stage2 A
                    (livePlan A prev (word k)).stage2Plan).stage3 A).name
                  green).val =
                recurrentName.val ∧
              recurrentName.val < next.1.e.val ∧
              state ∈
                (((prev.1.stage1 A (word k)).stage2 A
                    (livePlan A prev (word k)).stage2Plan).stage3 A).label child ∧
              state ∈
                (((prev.1.stage1 A (word k)).stage2 A
                    (livePlan A prev (word k)).stage2Plan).stage3 A).label green ∧
              ReachableAfter A A.initial word (k + 1) state := by
  classical
  rcases automaton_accepts_frequently_transition_green_same_name A word
      haccepts with
    ⟨recurrentName, hfreq⟩
  refine ⟨recurrentName, ?_⟩
  intro n
  rcases hfreq n with
    ⟨k, hk, prev, next, hprev, hnext, hnextName, green, hgreen,
      hgreenName, hgreenE, hgreenNonempty⟩
  let t1 := prev.1.stage1 A (word k)
  let t2 := t1.stage2 A (livePlan A prev (word k)).stage2Plan
  let t3 := t2.stage3 A
  have hgreen_t3 : green ∈ t3.greenNodes A := by
    simpa [t1, t2, t3] using hgreen
  have hgreenNonempty_t3 : t3.label green ≠ ∅ := by
    simpa [t1, t2, t3] using hgreenNonempty
  rcases exists_child_state_of_green_label_nonempty A t3
      hgreen_t3 hgreenNonempty_t3 with
    ⟨child, state, hchild, hstateChild, hstateGreen⟩
  have hchildActive_t3 : t3.active child = true := by
    rw [children, Finset.mem_filter] at hchild
    exact hchild.2.1
