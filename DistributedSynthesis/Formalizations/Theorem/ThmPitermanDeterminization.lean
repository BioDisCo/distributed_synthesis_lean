theorem live_stage3_same_name_green_eq_active_live_node
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {k : Nat} (live : LiveState A)
    {recurrentName : Name A} {liveNode eventGreen : Node A}
    (hliveActive : live.1.active liveNode = true)
    (hliveName : (live.1.name liveNode).val = recurrentName.val)
    (heventGreen :
      eventGreen ∈
        (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (heventName :
      ((((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).name
        eventGreen).val =
        recurrentName.val) :
    eventGreen = liveNode := by
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases live.2 with
    ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
      _hinactiveLabel, _hbound, hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have ht1LiveActive : t1.active liveNode = true := by
    simpa [t1, stage1_active A live.1 (word k) liveNode] using hliveActive
  have ht2LiveActive : t2.active liveNode = true :=
    stage2_preserves_active_node_active A t1 plan ht1LiveActive
  have ht3LiveActive : t3.active liveNode = true := by
    simpa [t3, stage3_active A t2 liveNode] using ht2LiveActive
  have ht3EventActive : t3.active eventGreen = true :=
    (mem_greenNodes A t3).mp (by simpa [t1, plan, t2, t3] using heventGreen) |>.1
  have ht3LiveNameVal :
      (t3.name liveNode).val = recurrentName.val := by
    rw [show t3.name liveNode = t2.name liveNode from
      stage3_name A t2 liveNode]
    rw [show t2.name liveNode = t1.name liveNode from
      stage2_preserves_active_node_name A t1 plan ht1LiveActive]
    rw [show t1.name liveNode = live.1.name liveNode from
      stage1_name A live.1 (word k) liveNode]
    exact hliveName
  have ht3EventNameVal :
      (t3.name eventGreen).val = recurrentName.val := by
    simpa [t1, plan, t2, t3] using heventName
  have hnameEq : t3.name eventGreen = t3.name liveNode := by
    apply Fin.ext
    omega
  exact
    stage3_preserves_name_injective A t2
      (stage2_preserves_name_injective A t1 plan
        (stage1_preserves_name_injective A live.1 (word k) hinjective))
      eventGreen liveNode ht3EventActive ht3LiveActive hnameEq

theorem automaton_run_green_event_stage3_label_mem_next
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {k : Nat} {prev next : LiveState A}
    {recurrentName : Name A} {green : Node A} {state : A.State}
    (hprev : (automaton A).run word k = some prev)
    (hnext : (automaton A).run word (k + 1) = some next)
    (hnextName : next.1.f = recurrentName)
    (hgreen :
      green ∈
        (((prev.1.stage1 A (word k)).stage2 A
          (livePlan A prev (word k)).stage2Plan).stage3 A).greenNodes A)
    (hgreenName :
      ((((prev.1.stage1 A (word k)).stage2 A
          (livePlan A prev (word k)).stage2Plan).stage3 A).name green).val =
        recurrentName.val)
    (hgreenE : recurrentName.val < next.1.e.val)
    (hstate :
      state ∈
        (((prev.1.stage1 A (word k)).stage2 A
          (livePlan A prev (word k)).stage2Plan).stage3 A).label green) :
    state ∈ next.1.label green := by
  let plan := livePlan A prev (word k)
  let t1 := prev.1.stage1 A (word k)
  let t2 := t1.stage2 A plan.stage2Plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let stage4Removed := t3.greenRemovedNodes A
  let t5 := t4.stage5 A stage4Removed
  let stage5Removed := stage4Removed ∪ t4.emptyActiveNodes A
  rcases prev.2 with
    ⟨hrootActive, _hrootName, hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have hnextTree :
      next.1 = liveNextTree A prev (word k) :=
    automaton_run_live_nextTree A word hprev hnext
  have hrootActive_t1 : t1.active (root A) = true := by
    simpa [t1, stage1_active A prev.1 (word k) (root A)] using
      hrootActive
  have ht1RootParent : t1.parent (root A) = root A := by
    simpa [t1, stage1_parent A prev.1 (word k) (root A)] using
      hrootParent
  have ht2RootParent : t2.parent (root A) = root A := by
    simpa [t1, t2, plan] using
      (stage2_root_parent A t1 plan.stage2Plan hrootActive_t1).trans
        ht1RootParent
  have ht3RootParent : t3.parent (root A) = root A := by
    simpa [t3, stage3] using ht2RootParent
  have ht1ParentInvariant :
      ∀ node, t1.active node = true -> node ≠ root A ->
        t1.active (t1.parent node) = true ∧
          (t1.name (t1.parent node)).val < (t1.name node).val := by
    simpa [t1] using
      (stage1_preserves_parent_active_and_name_lt A prev.1 (word k)
        hparentInvariant)
  have ht3ParentInvariant :
      ∀ node, t3.active node = true -> node ≠ root A ->
        t3.active (t3.parent node) = true ∧
          (t3.name (t3.parent node)).val < (t3.name node).val := by
    simpa [t1, t2, t3, plan] using
      (stage2_stage3_preserves_parent_active_and_name_lt A t1
        plan.stage2Plan ht1ParentInvariant)
  have hactive3 : t3.active green = true :=
    (mem_greenNodes A t3).mp (by simpa [t1, t2, t3, plan] using hgreen) |>.1
  have hbound3 : (t3.name green).val < Fintype.card A.State := by
    have heBound : next.1.e.val < Fintype.card A.State + 1 :=
      next.1.e.2
    have hname : (t3.name green).val = recurrentName.val := by
      simpa [t1, t2, t3, plan] using hgreenName
    omega
  have hfStage4 : (t4.f).val = recurrentName.val := by
    have hfNext : ((liveNextTree A prev (word k)).f).val =
        recurrentName.val := by
      rw [← hnextTree]
      exact congrArg Fin.val hnextName
    simpa [liveNextTree, transitionWithPlan, plan, t1, t2, t3, t4,
      stage4Removed, t5, stage5Removed, stage5_f_val, stage6_f_val] using
      hfNext
  have hnotGreen : ¬ t3.RemovedByGreen A green :=
    stage4_not_removedByGreen_of_name_le_f A t3 ht3RootParent
      ht3ParentInvariant hbound3 (by
        have hname : (t3.name green).val = recurrentName.val := by
          simpa [t1, t2, t3, plan] using hgreenName
        have hfStage4' : ((t3.stage4 A).f).val = recurrentName.val := by
          simpa [t4] using hfStage4
        omega)
  have hstate_t3 : state ∈ t3.label green := by
    simpa [t1, t2, t3, plan] using hstate
  have hstate_t4 : state ∈ t4.label green := by
    rw [show t4.label green = t3.label green by
      simpa [t4] using stage4_keeps_unremoved_label A t3 hnotGreen]
    exact hstate_t3
  have hnotStage5 : ¬ t4.RemovedByStage5 A stage4Removed green := by
    intro hremoved
    rcases hremoved with hstage4Removed | hempty
    · exact hnotGreen ((mem_greenRemovedNodes A t3).mp hstage4Removed)
    · have hemptySpec := (mem_emptyActiveNodes A t4).mp hempty
      rw [hemptySpec.2] at hstate_t4
      simp at hstate_t4
  have hstate_t5 : state ∈ t5.label green := by
    rw [show t5.label green = t4.label green by
      simpa [t5] using
        stage5_keeps_unremoved_label A t4 stage4Removed hnotStage5]
    exact hstate_t4
  have hstate_final :
      state ∈ (t5.stage6 A stage5Removed).label green := by
    rw [stage6_preserves_label A t5 stage5Removed green]
    exact hstate_t5
  rw [hnextTree]
  simpa [liveNextTree, transitionWithPlan, plan, t1, t2, t3, t4,
    stage4Removed, t5, stage5Removed] using hstate_final

