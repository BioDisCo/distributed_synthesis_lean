/--
Path-level blocked fresh-child route: if the accepting successor captured in
`v`'s fresh child is blocked at stage (3), then either that same successor is
already in a stage-(2) child of `v`, or the construction exposes a strictly
lower-name source event.  This is the local blocked branch needed for the
descent's son-tracking invariant.
-/
theorem run_path_succ_freshChild_blocked_stage2_child_or_lower
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (live : LiveState A) {k : Nat} {v : Node A}
    (hactive : (live.1.stage1 A (word k)).active v = true)
    (hmem : run.path k ∈ live.1.label v)
    (haccepting : A.accepting (run.path (k + 1)))
    (hblocked :
      ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).BlockedByOlderSibling A
        ((livePlan A live (word k)).stage2Plan.freshChild v)
        (run.path (k + 1))) :
    ∃ sourceNode sourceState,
      live.1.active sourceNode = true ∧
        sourceState ∈ live.1.label sourceNode ∧
        SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) ∧
        ((∃ child,
            child ∈
              ((live.1.stage1 A (word k)).stage2 A
                (livePlan A live (word k)).stage2Plan).children A v ∧
            run.path (k + 1) ∈
              ((live.1.stage1 A (word k)).stage2 A
                (livePlan A live (word k)).stage2Plan).label child) ∨
          (live.1.name sourceNode).val <
            (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).name v).val) := by
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hstage1 : run.path (k + 1) ∈ t1.label v :=
    run_path_succ_mem_stage1_label A run live.1 hmem
  have htrigger : v ∈ t1.stage2Triggers A :=
    mem_stage2Triggers_of_accepting_label A t1 hactive hstage1 haccepting
  have hfreshT2 :
      run.path (k + 1) ∈ t2.label (plan.freshChild v) :=
    run_path_succ_mem_stage2_freshChild_label A run live hactive hmem
      haccepting
  have hnotFreshT3 :
      run.path (k + 1) ∉ t3.label (plan.freshChild v) := by
    intro hsurvives
    exact ((mem_stage3_label A t2).mp hsurvives).2
      (by simpa [t1, plan, t2] using hblocked)
  have hactiveT2 : t2.active v = true :=
    stage2_preserves_active_node_active A t1 plan hactive
  exact
    live_green_stage2Trigger_routed_accepting_segment_stage2_child_or_lower
      A word live
      (by simpa [t1] using htrigger)
      (by simpa [t1, plan, t2] using hactiveT2)
      (by simpa [t1, plan, t2] using hfreshT2)
      (by simpa [t1, plan, t2, t3] using hnotFreshT3)

/--
One-step descent fork in the settled non-green regime: an accepting successor
from `v` either is covered by a child of `v` in the next live tree, or the
blocked fresh-child route exposes the local descent alternative -- a stage-(2)
child of `v` already carries the target, or a strictly lower-name source event
has occurred.  This is the direct composition of the final-coverage fork with
the checked routed blocked branch.
-/
theorem run_path_succ_accepting_childLabelUnion_or_stage2_child_or_lower
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hactive : (live.1.stage1 A (word k)).active v = true)
    (hmem : run.path k ∈ live.1.label v)
    (haccepting : A.accepting (run.path (k + 1)))
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v ∨
      ∃ sourceNode sourceState,
        live.1.active sourceNode = true ∧
          sourceState ∈ live.1.label sourceNode ∧
          SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) ∧
          ((∃ child,
              child ∈
                ((live.1.stage1 A (word k)).stage2 A
                  (livePlan A live (word k)).stage2Plan).children A v ∧
              run.path (k + 1) ∈
                ((live.1.stage1 A (word k)).stage2 A
                  (livePlan A live (word k)).stage2Plan).label child) ∨
            (live.1.name sourceNode).val <
              (((live.1.stage1 A (word k)).stage2 A
                (livePlan A live (word k)).stage2Plan).name v).val) := by
  rcases
      run_path_succ_accepting_childLabelUnion_or_freshChild_blocked_of_not_green
        A run hrun hrunNext hactive hmem haccepting hvNotGreen hsettle with
    hcovered | hblocked
  · exact Or.inl hcovered
  · exact Or.inr
      (run_path_succ_freshChild_blocked_stage2_child_or_lower
        A run live hactive hmem haccepting hblocked)

/--
Accepting successor, final local descent fork: in the settled non-green regime,
an accepting successor from `v` either lands in final child coverage of `v`, or
there is already a live one-step accepting segment whose source name is strictly
below `v`'s stage-(2) name.  The finite child-blocker loop is discharged by
`run_path_succ_stage2_child_eventually_persists_or_lower_source`.
-/
theorem run_path_succ_accepting_childLabelUnion_or_lower_source_of_not_green
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hactive : (live.1.stage1 A (word k)).active v = true)
    (hmem : run.path k ∈ live.1.label v)
    (haccepting : A.accepting (run.path (k + 1)))
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v ∨
      ∃ sourceNode sourceState,
        live.1.active sourceNode = true ∧
          sourceState ∈ live.1.label sourceNode ∧
          SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) ∧
          (live.1.name sourceNode).val <
            (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).name v).val := by
  rcases
      run_path_succ_accepting_childLabelUnion_or_stage2_child_or_lower
        A run hrun hrunNext hactive hmem haccepting hvNotGreen hsettle with
    hcovered | hroute
  · exact Or.inl hcovered
  · rcases hroute with
      ⟨sourceNode, sourceState, hsourceActive, hsourceState, hsegment,
        hchildOrLower⟩
    rcases hchildOrLower with hchild | hlower
    · rcases hchild with ⟨child, hchild, hmemChild⟩
      exact
        run_path_succ_stage2_child_eventually_persists_or_lower_source
          A run hrun hrunNext haccepting hchild hmemChild hvNotGreen hsettle
    · exact Or.inr
        ⟨sourceNode, sourceState, hsourceActive, hsourceState, hsegment,
          hlower⟩

/--
Accepting successor in the settled-name regime: if the run is in `v` with
settled name `a`, `v` is not green, and the next state is still in `v`, then an
accepting successor either is finally covered by a child of `v`, or exposes a
live accepting segment whose source name is strictly below `a`.
-/
theorem run_path_succ_accepting_childLabelUnion_or_source_lt_settled_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k a : Nat}
    {live next : LiveState A} {v : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hmem : run.path k ∈ live.1.label v)
    (hname : (live.1.name v).val = a)
    (haccepting : A.accepting (run.path (k + 1)))
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettleNext : run.path (k + 1) ∈ next.1.label v) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v ∨
      ∃ sourceNode sourceState,
        live.1.active sourceNode = true ∧
          sourceState ∈ live.1.label sourceNode ∧
          SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) ∧
          (live.1.name sourceNode).val < a := by
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  have hactiveLive : live.1.active v = true :=
    active_of_mem_label A live.1 live.2 hmem
  have hactiveT1 : t1.active v = true := by
    simpa [t1, stage1_active A live.1 (word k) v] using hactiveLive
  have hnameT2 : (t2.name v).val = a := by
    rw [show t2.name v = t1.name v from
      stage2_preserves_active_node_name A t1 plan hactiveT1]
    simpa [t1, stage1_name A live.1 (word k) v] using hname
  rcases
      run_path_succ_accepting_childLabelUnion_or_lower_source_of_not_green
        A run hrun hrunNext hactiveT1 hmem haccepting hvNotGreen
        hsettleNext with
    hcovered | hlower
  · exact Or.inl hcovered
  · rcases hlower with
      ⟨sourceNode, sourceState, hsourceActive, hsourceState, hsegment,
        hsourceLt⟩
    exact Or.inr ⟨sourceNode, sourceState, hsourceActive, hsourceState,
      hsegment, by
        have hsourceLt' :
            (live.1.name sourceNode).val < (t2.name v).val := by
          simpa [t1, plan, t2] using hsourceLt
        omega⟩

/--
Frequency form of the settled non-green local fork: if an accepting NBW run has
settled at node `v` with name `a` and `v` does not green infinitely often, then
arbitrarily late accepting transitions either put the target in final child
coverage of `v`, or expose an accepting segment from a live source of name
strictly below `a`.
-/
theorem runSettles_not_green_frequently_accepting_childLabelUnion_or_source_lt
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hng : ¬ RunNodeGreensIO A run v) :
    ∀ n : Nat, ∃ k live next,
      n ≤ k ∧
        (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        A.accepting (run.path (k + 1)) ∧
        (run.path (k + 1) ∈ next.1.childLabelUnion A v ∨
          ∃ sourceNode sourceState,
            live.1.active sourceNode = true ∧
              sourceState ∈ live.1.label sourceNode ∧
              SegmentVisitsAccepting A word k 1 sourceState
                (run.path (k + 1)) ∧
              (live.1.name sourceNode).val < a) := by
  rcases exists_eventually_settled_not_green A run hsettle hng with
    ⟨N, hregime⟩
  intro n
  rcases hrunAccepts (max (n + 1) (N + 1)) with
    ⟨t, ht, htAccepting⟩
  let k : Nat := t - 1
  have htpos : 0 < t := by omega
  have htEq : t = k + 1 := by omega
  have hnk : n ≤ k := by omega
  have hNk : N ≤ k := by omega
  have hNk1 : N ≤ k + 1 := by omega
  rcases hregime k hNk with
    ⟨⟨live, hrun, hmem, hname⟩, hnotGreen⟩
  rcases hregime (k + 1) hNk1 with
    ⟨⟨next, hrunNext, hmemNext, _hnameNext⟩, _hnotGreenNext⟩
  have hacceptingNext : A.accepting (run.path (k + 1)) := by
    simpa [htEq] using htAccepting
  have hlocal :=
    run_path_succ_accepting_childLabelUnion_or_source_lt_settled_name
      A run hrun hrunNext hmem hname hacceptingNext
      (hnotGreen live hrun) hmemNext
  exact ⟨k, live, next, hnk, hrun, hrunNext, hacceptingNext, hlocal⟩

/--
Paper proof-4 son-entry in frequency form.  In a settled non-green node, every
sufficiently late accepting transition of the tracked Buchi run is covered by a
child of that same node in the successor compact tree.  The older-sibling
iteration is internal to
`run_path_succ_accepting_childLabelUnion_of_settled_not_green`; no lower-source
residual remains.
-/
theorem runSettles_not_green_frequently_accepting_childLabelUnion
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hng : ¬ RunNodeGreensIO A run v) :
    ∀ n : Nat, ∃ k live next,
      n ≤ k ∧
        (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        A.accepting (run.path (k + 1)) ∧
        run.path (k + 1) ∈ next.1.childLabelUnion A v := by
  rcases exists_eventually_settled_not_green A run hsettle hng with
    ⟨N, hregime⟩
  intro n
  rcases hrunAccepts (max (n + 1) (N + 1)) with
    ⟨t, ht, htAccepting⟩
  let k : Nat := t - 1
  have htpos : 0 < t := by omega
  have htEq : t = k + 1 := by omega
  have hnk : n ≤ k := by omega
  have hNk : N ≤ k := by omega
  have hNk1 : N ≤ k + 1 := by omega
  rcases hregime k hNk with
    ⟨⟨live, hrun, hmem, _hname⟩, hnotGreen⟩
  rcases hregime (k + 1) hNk1 with
    ⟨⟨next, hrunNext, hmemNext, _hnameNext⟩, _hnotGreenNext⟩
  have hacceptingNext : A.accepting (run.path (k + 1)) := by
    simpa [htEq] using htAccepting
  have hactiveT1 :
      (live.1.stage1 A (word k)).active v = true := by
    have hactiveLive : live.1.active v = true :=
      active_of_mem_label A live.1 live.2 hmem
    simpa [stage1_active A live.1 (word k) v] using hactiveLive
  have hcovered :
      run.path (k + 1) ∈ next.1.childLabelUnion A v :=
    run_path_succ_accepting_childLabelUnion_of_settled_not_green
      A run hrun hrunNext hactiveT1 hmem hacceptingNext
      (hnotGreen live hrun) hmemNext
  exact ⟨k, live, next, hnk, hrun, hrunNext, hacceptingNext, hcovered⟩

/--
Global branch split for the settled non-green regime: the local fork from
`runSettles_not_green_frequently_accepting_childLabelUnion_or_source_lt` can be
pigeonholed at the top level.  Either final child coverage of `v` happens
arbitrarily late on accepting transitions, or the lower-name source branch does.
-/
theorem runSettles_not_green_frequently_childLabelUnion_or_lower_source_branch
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hng : ¬ RunNodeGreensIO A run v) :
    (∀ n : Nat, ∃ k live next,
      n ≤ k ∧
        (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        A.accepting (run.path (k + 1)) ∧
        run.path (k + 1) ∈ next.1.childLabelUnion A v) ∨
      (∀ n : Nat, ∃ k live next sourceNode sourceState,
        n ≤ k ∧
          (automaton A).run word k = some live ∧
          (automaton A).run word (k + 1) = some next ∧
          A.accepting (run.path (k + 1)) ∧
          live.1.active sourceNode = true ∧
          sourceState ∈ live.1.label sourceNode ∧
          SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) ∧
          (live.1.name sourceNode).val < a) := by
  let P : Nat -> Prop := fun k =>
    ∃ live next,
      (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        A.accepting (run.path (k + 1)) ∧
        run.path (k + 1) ∈ next.1.childLabelUnion A v
  let Q : Nat -> Prop := fun k =>
    ∃ live next sourceNode sourceState,
      (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        A.accepting (run.path (k + 1)) ∧
        live.1.active sourceNode = true ∧
        sourceState ∈ live.1.label sourceNode ∧
        SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) ∧
        (live.1.name sourceNode).val < a
  have hfreqPQ : ∀ n : Nat, ∃ k : Nat, n ≤ k ∧ (P k ∨ Q k) := by
    intro n
    rcases
        runSettles_not_green_frequently_accepting_childLabelUnion_or_source_lt
          A run hrunAccepts hsettle hng n with
      ⟨k, live, next, hnk, hrun, hrunNext, haccepting, hcase⟩
    refine ⟨k, hnk, ?_⟩
    rcases hcase with hcovered | hlower
    · exact Or.inl ⟨live, next, hrun, hrunNext, haccepting, hcovered⟩
    · rcases hlower with
        ⟨sourceNode, sourceState, hsourceActive, hsourceState, hsegment,
          hsourceLt⟩
      exact Or.inr
        ⟨live, next, sourceNode, sourceState, hrun, hrunNext, haccepting,
          hsourceActive, hsourceState, hsegment, hsourceLt⟩
  rcases frequently_left_or_right_of_frequently_or hfreqPQ with hP | hQ
  · exact Or.inl
      (by
        intro n
        rcases hP n with ⟨k, hnk, live, next, hrun, hrunNext, haccepting,
          hcovered⟩
        exact ⟨k, live, next, hnk, hrun, hrunNext, haccepting, hcovered⟩)
  · exact Or.inr
      (by
        intro n
        rcases hQ n with
          ⟨k, hnk, live, next, sourceNode, sourceState, hrun, hrunNext,
            haccepting, hsourceActive, hsourceState, hsegment, hsourceLt⟩
        exact ⟨k, live, next, sourceNode, sourceState, hnk, hrun, hrunNext,
          haccepting, hsourceActive, hsourceState, hsegment, hsourceLt⟩)

/--
Lower-source event with a fixed source name.  This is the finite pigeonhole
payload for the lower branch of the settled non-green descent.
-/
def SettledLowerSourceNameEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceName : Nat) (k : Nat) : Prop :=
  ∃ live next sourceNode sourceState,
    (automaton A).run word k = some live ∧
      (automaton A).run word (k + 1) = some next ∧
      A.accepting (run.path (k + 1)) ∧
      live.1.active sourceNode = true ∧
      sourceState ∈ live.1.label sourceNode ∧
      SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) ∧
      (live.1.name sourceNode).val = sourceName

/--
A fixed lower-source event gives an instantaneous source-node/name witness at
time `k`.
-/
theorem settledLowerSourceNameEvent_instant_source_witness
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceName k : Nat}
    (hevent : SettledLowerSourceNameEvent A run sourceName k) :
    ∃ live sourceNode sourceState,
      (automaton A).run word k = some live ∧
        live.1.active sourceNode = true ∧
        sourceState ∈ live.1.label sourceNode ∧
        (live.1.name sourceNode).val = sourceName ∧
        SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) := by
  rcases hevent with
    ⟨live, _next, sourceNode, sourceState, hrun, _hrunNext, _haccepting,
      hsourceActive, hsourceState, hsegment, hsourceName⟩
  exact ⟨live, sourceNode, sourceState, hrun, hsourceActive, hsourceState,
    hsourceName, hsegment⟩

/--
Frequency form of lower-source witnesses for a fixed source name.
-/
theorem settledLowerSourceNameEvent_frequently_source_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceName : Nat}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNameEvent A run sourceName k) :
    ∀ n : Nat, ∃ k live sourceNode sourceState,
      n ≤ k ∧
        (automaton A).run word k = some live ∧
        live.1.active sourceNode = true ∧
        sourceState ∈ live.1.label sourceNode ∧
        (live.1.name sourceNode).val = sourceName ∧
        SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) := by
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  rcases settledLowerSourceNameEvent_instant_source_witness
      A run hevent with
    ⟨live, sourceNode, sourceState, hrun, hsourceActive, hsourceState,
      hsourceName, hsegment⟩
  exact ⟨k, live, sourceNode, sourceState, hnk, hrun, hsourceActive,
    hsourceState, hsourceName, hsegment⟩

/--
A fixed lower-source event exposes a reachable source state of the fixed lower
name, together with an accepting one-step segment from that source.
-/
theorem settledLowerSourceNameEvent_reachable_source_witness
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceName k : Nat}
    (hevent : SettledLowerSourceNameEvent A run sourceName k) :
    ∃ live sourceNode sourceState,
      (automaton A).run word k = some live ∧
        live.1.active sourceNode = true ∧
        sourceState ∈ live.1.label sourceNode ∧
        (live.1.name sourceNode).val = sourceName ∧
        ReachablePrefix A A.initial word k sourceState ∧
        SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) := by
  rcases settledLowerSourceNameEvent_instant_source_witness
      A run hevent with
    ⟨live, sourceNode, sourceState, hrun, hsourceActive, hsourceState,
      hsourceName, hsegment⟩
  have hreachable :
      ReachablePrefix A A.initial word k sourceState :=
    automaton_run_live_active_label_reachablePrefix A word hrun hsourceActive
      hsourceState
  exact ⟨live, sourceNode, sourceState, hrun, hsourceActive, hsourceState,
    hsourceName, hreachable, hsegment⟩

/--
Frequency form of reachable lower-source witnesses for a fixed lower source
name.
-/
theorem settledLowerSourceNameEvent_frequently_reachable_source
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceName : Nat}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNameEvent A run sourceName k) :
    ∀ n : Nat, ∃ k live sourceNode sourceState,
      n ≤ k ∧
        (automaton A).run word k = some live ∧
        live.1.active sourceNode = true ∧
        sourceState ∈ live.1.label sourceNode ∧
        (live.1.name sourceNode).val = sourceName ∧
        ReachablePrefix A A.initial word k sourceState ∧
        SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) := by
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  rcases settledLowerSourceNameEvent_reachable_source_witness
      A run hevent with
    ⟨live, sourceNode, sourceState, hrun, hsourceActive, hsourceState,
      hsourceName, hreachable, hsegment⟩
  exact ⟨k, live, sourceNode, sourceState, hnk, hrun, hsourceActive,
    hsourceState, hsourceName, hreachable, hsegment⟩

/--
Lower-source event with both the source node and dynamic source name fixed.
-/
def SettledLowerSourceNodeNameEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode : Node A)
    (sourceName : Nat) (k : Nat) : Prop :=
  ∃ live next sourceState,
    (automaton A).run word k = some live ∧
      (automaton A).run word (k + 1) = some next ∧
      A.accepting (run.path (k + 1)) ∧
      live.1.active sourceNode = true ∧
      sourceState ∈ live.1.label sourceNode ∧
      SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) ∧
      (live.1.name sourceNode).val = sourceName

theorem settledLowerSourceNodeNameEvent_to_nameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName k : Nat}
    (hevent :
      SettledLowerSourceNodeNameEvent A run sourceNode sourceName k) :
    SettledLowerSourceNameEvent A run sourceName k := by
  rcases hevent with
    ⟨live, next, sourceState, hrun, hrunNext, haccepting, hsourceActive,
      hsourceState, hsegment, hsourceName⟩
  exact ⟨live, next, sourceNode, sourceState, hrun, hrunNext, haccepting,
    hsourceActive, hsourceState, hsegment, hsourceName⟩

/--
Finite-node pigeonhole for the fixed lower-source-name branch: if lower-source
events recur at a fixed source name, then some fixed source node carries that
name in lower-source events arbitrarily late.
-/
theorem exists_frequently_settledLowerSourceNodeNameEvent_of_nameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceName : Nat}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNameEvent A run sourceName k) :
    ∃ sourceNode : Node A,
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNodeNameEvent A run sourceNode sourceName k := by
  classical
  have hfreqFilter :
      ∃ᶠ k in Filter.atTop,
        ∃ sourceNode ∈ (Finset.univ : Finset (Node A)),
          SettledLowerSourceNodeNameEvent A run sourceNode sourceName k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with
      ⟨k, hnk, live, next, sourceNode, sourceState, hrun, hrunNext,
        haccepting, hsourceActive, hsourceState, hsegment, hsourceName⟩
    exact ⟨k, hnk, sourceNode, Finset.mem_univ sourceNode,
      live, next, sourceState, hrun, hrunNext, haccepting, hsourceActive,
      hsourceState, hsegment, hsourceName⟩
  rw [Finset.frequently_exists] at hfreqFilter
  rcases hfreqFilter with ⟨sourceNode, _hsourceNodeMem, hsourceNodeFreq⟩
  exact ⟨sourceNode, fun n => (Filter.frequently_atTop).1 hsourceNodeFreq n⟩

/--
Frequency form of reachable witnesses for a fixed lower-source node/name.
-/
theorem settledLowerSourceNodeNameEvent_frequently_reachable_source
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A} {sourceName : Nat}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNodeNameEvent A run sourceNode sourceName k) :
    ∀ n : Nat, ∃ k live sourceState,
      n ≤ k ∧
        (automaton A).run word k = some live ∧
        live.1.active sourceNode = true ∧
        sourceState ∈ live.1.label sourceNode ∧
        (live.1.name sourceNode).val = sourceName ∧
        ReachablePrefix A A.initial word k sourceState ∧
        SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) := by
  intro n
  rcases hfreq n with
    ⟨k, hnk, live, _next, sourceState, hrun, _hrunNext, _haccepting,
      hsourceActive, hsourceState, hsegment, hsourceName⟩
  have hreachable :
      ReachablePrefix A A.initial word k sourceState :=
    automaton_run_live_active_label_reachablePrefix A word hrun hsourceActive
      hsourceState
  exact ⟨k, live, sourceState, hnk, hrun, hsourceActive, hsourceState,
    hsourceName, hreachable, hsegment⟩

/--
Target-side payload of a fixed lower-source node/name event: the accepting
successor reached by the one-step segment is reachable as an NBW prefix state.
-/
theorem settledLowerSourceNodeNameEvent_accepting_reachable_target
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName k : Nat}
    (hevent :
      SettledLowerSourceNodeNameEvent A run sourceNode sourceName k) :
    ∃ target : A.State,
      target = run.path (k + 1) ∧
        A.accepting target ∧
        ReachablePrefix A A.initial word (k + 1) target := by
  rcases hevent with
    ⟨live, _next, sourceState, hrun, _hrunNext, haccepting,
      hsourceActive, hsourceState, hsegment, _hsourceName⟩
  have hreachSource :
      ReachableAfter A A.initial word k sourceState :=
    automaton_run_live_active_label_reachable A word hrun hsourceActive
      hsourceState
  have hreachTarget :
      ReachablePrefix A A.initial word (k + 1) (run.path (k + 1)) := by
    have hreachAfter :
        ReachableAfter A A.initial word (k + 1) (run.path (k + 1)) := by
      simpa using
        reachableAfter_of_segmentVisitsAccepting A A.initial word
          hreachSource hsegment
    exact reachableAfter_to_prefix A A.initial word hreachAfter
  exact ⟨run.path (k + 1), rfl, haccepting, hreachTarget⟩

/--
Frequency form of reachable accepting targets produced by the fixed
lower-source node/name branch.
-/
theorem settledLowerSourceNodeNameEvent_frequently_accepting_reachable_target
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A} {sourceName : Nat}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNodeNameEvent A run sourceNode sourceName k) :
    ∀ n : Nat, ∃ t target,
      n ≤ t ∧
        A.accepting target ∧
        ReachablePrefix A A.initial word t target := by
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  rcases settledLowerSourceNodeNameEvent_accepting_reachable_target
      A run hevent with
    ⟨target, htargetEq, haccepting, hreachable⟩
  refine ⟨k + 1, target, by omega, haccepting, ?_⟩
  simpa [htargetEq] using hreachable

/--
Lower-source event with source node, dynamic source name, and concrete source
state fixed.  This is the next finite-pigeonhole refinement of the lower-source
branch: the node/name recurrence is still too weak for the paper's compactness
step unless the actual source state is also fixed.
-/
def SettledLowerSourceNodeNameStateEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode : Node A)
    (sourceName : Nat) (sourceState : A.State) (k : Nat) : Prop :=
  ∃ live next,
    (automaton A).run word k = some live ∧
      (automaton A).run word (k + 1) = some next ∧
      A.accepting (run.path (k + 1)) ∧
      live.1.active sourceNode = true ∧
      sourceState ∈ live.1.label sourceNode ∧
      SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) ∧
      (live.1.name sourceNode).val = sourceName

theorem settledLowerSourceNodeNameStateEvent_to_nodeNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceNodeNameStateEvent A run sourceNode sourceName
        sourceState k) :
    SettledLowerSourceNodeNameEvent A run sourceNode sourceName k := by
  rcases hevent with
    ⟨live, next, hrun, hrunNext, haccepting, hsourceActive, hsourceState,
      hsegment, hsourceName⟩
  exact ⟨live, next, sourceState, hrun, hrunNext, haccepting, hsourceActive,
    hsourceState, hsegment, hsourceName⟩

/--
Finite-state pigeonhole for the fixed lower-source node/name branch: if one
source node carries the fixed lower name in lower-source events arbitrarily late,
then some concrete source state witnesses those events arbitrarily late.
-/
theorem exists_frequently_settledLowerSourceNodeNameStateEvent_of_nodeNameEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A} {sourceName : Nat}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNodeNameEvent A run sourceNode sourceName k) :
    ∃ sourceState : A.State,
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNodeNameStateEvent A run sourceNode sourceName
          sourceState k := by
  classical
  have hfreqFilter :
      ∃ᶠ k in Filter.atTop,
        ∃ sourceState ∈ (Finset.univ : Finset A.State),
          SettledLowerSourceNodeNameStateEvent A run sourceNode sourceName
            sourceState k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with
      ⟨k, hnk, live, next, sourceState, hrun, hrunNext, haccepting,
        hsourceActive, hsourceState, hsegment, hsourceName⟩
    exact ⟨k, hnk, sourceState, Finset.mem_univ sourceState,
      live, next, hrun, hrunNext, haccepting, hsourceActive, hsourceState,
      hsegment, hsourceName⟩
  rw [Finset.frequently_exists] at hfreqFilter
  rcases hfreqFilter with ⟨sourceState, _hsourceStateMem, hsourceStateFreq⟩
  refine ⟨sourceState, ?_⟩
  intro n
  exact (Filter.frequently_atTop).1 hsourceStateFreq n

/--
Lower-source event with the one-step target state fixed as well.  The target is
the accepting successor of the original witness run at the event time; fixing it
is the target-side finite pigeonhole needed before any König-style stitching can
be attempted.
-/
def SettledLowerSourceNodeNameStateTargetEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode : Node A)
    (sourceName : Nat) (sourceState target : A.State) (k : Nat) : Prop :=
  ∃ live next,
    (automaton A).run word k = some live ∧
      (automaton A).run word (k + 1) = some next ∧
      run.path (k + 1) = target ∧
      A.accepting target ∧
      live.1.active sourceNode = true ∧
      sourceState ∈ live.1.label sourceNode ∧
      SegmentVisitsAccepting A word k 1 sourceState target ∧
      (live.1.name sourceNode).val = sourceName

theorem settledLowerSourceNodeNameStateTargetEvent_to_stateEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceNodeNameStateTargetEvent A run sourceNode sourceName
        sourceState target k) :
    SettledLowerSourceNodeNameStateEvent A run sourceNode sourceName
      sourceState k := by
  rcases hevent with
    ⟨live, next, hrun, hrunNext, htarget, haccepting, hsourceActive,
      hsourceState, hsegment, hsourceName⟩
  exact ⟨live, next, hrun, hrunNext, by simpa [htarget] using haccepting,
    hsourceActive, hsourceState, by simpa [htarget] using hsegment,
    hsourceName⟩

/--
Finite-state target pigeonhole for the fixed lower-source source-state branch:
some accepting target state is reached by those one-step accepting segments
arbitrarily late.
-/
theorem exists_frequently_settledLowerSourceNodeNameStateTargetEvent_of_stateEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNodeNameStateEvent A run sourceNode sourceName
          sourceState k) :
    ∃ target : A.State,
      A.accepting target ∧
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceNodeNameStateTargetEvent A run sourceNode
            sourceName sourceState target k := by
  classical
  have hfreqFilter :
      ∃ᶠ k in Filter.atTop,
        ∃ target ∈ (Finset.univ : Finset A.State),
          A.accepting target ∧
            SettledLowerSourceNodeNameStateTargetEvent A run sourceNode
              sourceName sourceState target k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with
      ⟨k, hnk, live, next, hrun, hrunNext, haccepting, hsourceActive,
        hsourceState, hsegment, hsourceName⟩
    let target : A.State := run.path (k + 1)
    exact ⟨k, hnk, target, Finset.mem_univ target, by simpa [target] using haccepting,
      live, next, hrun, hrunNext, by simp [target], by simpa [target] using haccepting,
      hsourceActive, hsourceState, by simpa [target] using hsegment,
      hsourceName⟩
  rw [Finset.frequently_exists] at hfreqFilter
  rcases hfreqFilter with ⟨target, _htargetMem, htargetFreq⟩
  have haccepting : A.accepting target := by
    rcases (Filter.frequently_atTop).1 htargetFreq 0 with
      ⟨_k, _hk, hacc, _hevent⟩
    exact hacc
  refine ⟨target, haccepting, ?_⟩
  intro n
  rcases (Filter.frequently_atTop).1 htargetFreq n with
    ⟨k, hnk, _hacc, hevent⟩
  exact ⟨k, hnk, hevent⟩

/--
The current lower-source branch can be focused all the way to a fixed source
node, source name, source state, and accepting target state.  This is a narrower
replacement for the remaining `lowerNodeHandler` hypothesis: the unresolved part
is no longer a finite pigeonhole issue, but the genuine compactness/stitching
argument for this fixed quadruple.
-/
theorem exists_frequently_settledLowerSourceNodeNameStateTargetEvent_of_nodeNameBranch
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A} {sourceName : Nat}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceNodeNameEvent A run sourceNode sourceName k) :
    ∃ sourceState target : A.State,
      A.accepting target ∧
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceNodeNameStateTargetEvent A run sourceNode
            sourceName sourceState target k := by
  rcases
      exists_frequently_settledLowerSourceNodeNameStateEvent_of_nodeNameEvent
        A run hfreq with
    ⟨sourceState, hfreqState⟩
  rcases
      exists_frequently_settledLowerSourceNodeNameStateTargetEvent_of_stateEvent
        A run hfreqState with
    ⟨target, haccepting, hfreqTarget⟩
  exact ⟨sourceState, target, haccepting, hfreqTarget⟩

/--
Payload of a fixed lower-source/source-state/target event: the fixed source is
reachable at the event time, the fixed accepting one-step segment reaches the
fixed target, and the fixed target is reachable at the successor time.
-/
theorem settledLowerSourceNodeNameStateTargetEvent_reachable_payload
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceNodeNameStateTargetEvent A run sourceNode sourceName
        sourceState target k) :
    ReachablePrefix A A.initial word k sourceState ∧
      SegmentVisitsAccepting A word k 1 sourceState target ∧
        ReachablePrefix A A.initial word (k + 1) target := by
  rcases hevent with
    ⟨live, _next, hrun, _hrunNext, _htarget, _haccepting, hsourceActive,
      hsourceState, hsegment, _hsourceName⟩
  have hsourceReachablePrefix :
      ReachablePrefix A A.initial word k sourceState :=
    automaton_run_live_active_label_reachablePrefix A word hrun hsourceActive
      hsourceState
  have hsourceReachableAfter :
      ReachableAfter A A.initial word k sourceState :=
    automaton_run_live_active_label_reachable A word hrun hsourceActive
      hsourceState
  have htargetReachable :
      ReachablePrefix A A.initial word (k + 1) target := by
    have hreachAfter :
        ReachableAfter A A.initial word (k + 1) target := by
      simpa using
        reachableAfter_of_segmentVisitsAccepting A A.initial word
          hsourceReachableAfter hsegment
    exact reachableAfter_to_prefix A A.initial word hreachAfter
  exact ⟨hsourceReachablePrefix, hsegment, htargetReachable⟩

/--
One-letter transition payload of a fixed lower-source/target event.  The
`SegmentVisitsAccepting` witness has length `1`, so it contains the concrete NBW
edge from the fixed source state to the fixed target over the event letter.
-/
theorem settledLowerSourceNodeNameStateTargetEvent_step
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceNodeNameStateTargetEvent A run sourceNode sourceName
        sourceState target k) :
    A.step sourceState (word k) target := by
  rcases hevent with
    ⟨_live, _next, _hrun, _hrunNext, _htarget, _haccepting, _hsourceActive,
      _hsourceState, hsegment, _hsourceName⟩
  rcases hsegment with
    ⟨path, hsource, htargetPath, hvalid, _hacceptingHit⟩
  have hstep := hvalid 0 (by omega)
  simpa [hsource, htargetPath] using hstep

/--
Stage-(1) payload of a fixed lower-source/target event: the fixed accepting
target lies in the successor label of the fixed lower source node.
-/
theorem settledLowerSourceNodeNameStateTargetEvent_stage1_label
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceNodeNameStateTargetEvent A run sourceNode sourceName
        sourceState target k) :
    ∃ live next,
      (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        live.1.active sourceNode = true ∧
        (live.1.name sourceNode).val = sourceName ∧
        target ∈ (live.1.stage1 A (word k)).label sourceNode := by
  have hstep :=
    settledLowerSourceNodeNameStateTargetEvent_step A run hevent
  rcases hevent with
    ⟨live, next, hrun, hrunNext, _htarget, _haccepting, hsourceActive,
      hsourceState, _hsegment, hsourceName⟩
  have htargetStage1 :
      target ∈ (live.1.stage1 A (word k)).label sourceNode :=
    (mem_stage1_label A live.1 (word k)).mpr
      ⟨sourceState, hsourceState, hstep⟩
  exact ⟨live, next, hrun, hrunNext, hsourceActive, hsourceName,
    htargetStage1⟩

/--
Stage-(2) trigger payload of a fixed lower-source/target event: since the fixed
target is accepting and appears in the stage-(1) label of the fixed lower source,
that lower source node triggers stage (2).
-/
theorem settledLowerSourceNodeNameStateTargetEvent_stage2Trigger
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceNodeNameStateTargetEvent A run sourceNode sourceName
        sourceState target k) :
    ∃ live next,
      (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        (live.1.name sourceNode).val = sourceName ∧
        sourceNode ∈ (live.1.stage1 A (word k)).stage2Triggers A := by
  have hstep :=
    settledLowerSourceNodeNameStateTargetEvent_step A run hevent
  rcases hevent with
    ⟨live, next, hrun, hrunNext, _htarget, haccepting, hsourceActive,
      hsourceState, _hsegment, hsourceName⟩
  have htargetStage1 :
      target ∈ (live.1.stage1 A (word k)).label sourceNode :=
    (mem_stage1_label A live.1 (word k)).mpr
      ⟨sourceState, hsourceState, hstep⟩
  have hsourceActiveStage1 :
      (live.1.stage1 A (word k)).active sourceNode = true := by
    simpa [stage1_active A live.1 (word k) sourceNode] using hsourceActive
  have htrigger :
      sourceNode ∈ (live.1.stage1 A (word k)).stage2Triggers A :=
    mem_stage2Triggers_of_accepting_label A (live.1.stage1 A (word k))
      hsourceActiveStage1 htargetStage1 haccepting
  exact ⟨live, next, hrun, hrunNext, hsourceName, htrigger⟩

/--
Stage-(2) fresh-child payload of a fixed lower-source/target event: the fixed
accepting target is copied into the fresh child created below the fixed lower
source node.
-/
theorem settledLowerSourceNodeNameStateTargetEvent_stage2_freshChild_label
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceNodeNameStateTargetEvent A run sourceNode sourceName
        sourceState target k) :
    ∃ live next,
      (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        (live.1.name sourceNode).val = sourceName ∧
        let t1 := live.1.stage1 A (word k)
        let plan := (livePlan A live (word k)).stage2Plan
        sourceNode ∈ t1.stage2Triggers A ∧
          target ∈ (t1.stage2 A plan).label (plan.freshChild sourceNode) := by
  have hstep :=
    settledLowerSourceNodeNameStateTargetEvent_step A run hevent
  rcases hevent with
    ⟨live, next, hrun, hrunNext, _htarget, haccepting, hsourceActive,
      hsourceState, _hsegment, hsourceName⟩
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  have htargetStage1 :
      target ∈ t1.label sourceNode :=
    (mem_stage1_label A live.1 (word k)).mpr
      ⟨sourceState, hsourceState, hstep⟩
  have hsourceActiveStage1 : t1.active sourceNode = true := by
    simpa [t1, stage1_active A live.1 (word k) sourceNode] using hsourceActive
  have htrigger : sourceNode ∈ t1.stage2Triggers A :=
    mem_stage2Triggers_of_accepting_label A t1 hsourceActiveStage1
      htargetStage1 haccepting
  have htargetFresh :
      target ∈ (t1.stage2 A plan).label (plan.freshChild sourceNode) := by
    exact (mem_stage2_freshChild_label A t1 plan htrigger).mpr
      ⟨htargetStage1, haccepting⟩
  exact ⟨live, next, hrun, hrunNext, hsourceName, htrigger, htargetFresh⟩

/--
Stage-(3) dichotomy for a fixed lower-source/target event: after the fixed target
is copied into the fresh child below the fixed lower source, it either survives
duplicate removal and is in the lower source's child-label union, or the fresh
child is blocked by an older sibling.
-/
theorem settledLowerSourceNodeNameStateTargetEvent_stage3_childLabelUnion_or_blocked
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceNodeNameStateTargetEvent A run sourceNode sourceName
        sourceState target k) :
    ∃ live next,
      (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        (live.1.name sourceNode).val = sourceName ∧
        let t1 := live.1.stage1 A (word k)
        let plan := (livePlan A live (word k)).stage2Plan
        let t2 := t1.stage2 A plan
        let t3 := t2.stage3 A
        (target ∈ t3.childLabelUnion A sourceNode ∨
          t2.BlockedByOlderSibling A (plan.freshChild sourceNode) target) := by
  have hstep :=
    settledLowerSourceNodeNameStateTargetEvent_step A run hevent
  rcases hevent with
    ⟨live, next, hrun, hrunNext, _htarget, haccepting, hsourceActive,
      hsourceState, _hsegment, hsourceName⟩
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have htargetStage1 :
      target ∈ t1.label sourceNode :=
    (mem_stage1_label A live.1 (word k)).mpr
      ⟨sourceState, hsourceState, hstep⟩
  have hsourceActiveStage1 : t1.active sourceNode = true := by
    simpa [t1, stage1_active A live.1 (word k) sourceNode] using hsourceActive
  have htrigger : sourceNode ∈ t1.stage2Triggers A :=
    mem_stage2Triggers_of_accepting_label A t1 hsourceActiveStage1
      htargetStage1 haccepting
  have htargetFresh :
      target ∈ t2.label (plan.freshChild sourceNode) := by
    exact (mem_stage2_freshChild_label A t1 plan htrigger).mpr
      ⟨htargetStage1, haccepting⟩
  by_cases hsurvives : target ∈ t3.label (plan.freshChild sourceNode)
  · have hrootActive_t1 : t1.active (root A) = true := by
      simpa [t1, stage1_active A live.1 (word k) (root A)] using live.2.1
    exact ⟨live, next, hrun, hrunNext, hsourceName, Or.inl
      (stage2_stage3_freshChild_label_subset_childLabelUnion A t1 plan
        hrootActive_t1 htrigger hsurvives)⟩
  · exact ⟨live, next, hrun, hrunNext, hsourceName, Or.inr
      (stage3_blocked_of_mem_label_not_mem A t2
        (by simpa [t1, plan, t2] using htargetFresh)
        (by simpa [t1, plan, t2, t3] using hsurvives))⟩

/--
Fixed lower-source event whose fixed target survives stage (3) into the
child-label union of the fixed lower source node.
-/
def SettledLowerSourceStage3ChildUnionEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode : Node A)
    (sourceName : Nat) (sourceState target : A.State) (k : Nat) : Prop :=
  SettledLowerSourceNodeNameStateTargetEvent A run sourceNode sourceName
    sourceState target k ∧
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        let t1 := live.1.stage1 A (word k)
        let plan := (livePlan A live (word k)).stage2Plan
        let t2 := t1.stage2 A plan
        let t3 := t2.stage3 A
        target ∈ t3.childLabelUnion A sourceNode

/--
Child-union event with the concrete child carrying the fixed accepting target
also fixed.  This is the lower-source analogue of the ordinary coverage-child
event used in the settled descent.
-/
def SettledLowerSourceStage3ChildUnionChildEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode child : Node A)
    (sourceName : Nat) (sourceState target : A.State) (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
    sourceState target k ∧
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        let t1 := live.1.stage1 A (word k)
        let plan := (livePlan A live (word k)).stage2Plan
        let t2 := t1.stage2 A plan
        let t3 := t2.stage3 A
        child ∈ t3.children A sourceNode ∧ target ∈ t3.label child

/--
Expose the child witnessing the `childLabelUnion` payload of a lower-source
child-union event.
-/
theorem settledLowerSourceStage3ChildUnionEvent_child_witness
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
        sourceState target k) :
    ∃ child : Node A,
      SettledLowerSourceStage3ChildUnionChildEvent A run sourceNode child
        sourceName sourceState target k := by
  rcases hevent with ⟨hbase, live, hrun, hchildUnionRaw⟩
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hchildUnion : target ∈ t3.childLabelUnion A sourceNode := by
    simpa [t1, plan, t2, t3] using hchildUnionRaw
  rw [childLabelUnion, Finset.mem_biUnion] at hchildUnion
  rcases hchildUnion with ⟨child, hchild, htargetChild⟩
  exact ⟨child, ⟨⟨hbase, live, hrun, by simpa [t1, plan, t2, t3] using hchildUnionRaw⟩,
    live, hrun, by simpa [t1, plan, t2, t3] using hchild,
    by simpa [t1, plan, t2, t3] using htargetChild⟩⟩

/--
Finite-node pigeonhole for the lower-source child-union branch: if a fixed target
is covered by some child of a fixed source node arbitrarily late, then the same
child carries that target arbitrarily late.
-/
theorem exists_frequently_settledLowerSourceStage3ChildUnionChildEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
          sourceState target k) :
    ∃ child : Node A,
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionChildEvent A run sourceNode child
          sourceName sourceState target k := by
  classical
  have hfreqFilter :
      ∃ᶠ k in Filter.atTop,
        ∃ child ∈ (Finset.univ : Finset (Node A)),
          SettledLowerSourceStage3ChildUnionChildEvent A run sourceNode child
            sourceName sourceState target k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with ⟨k, hnk, hevent⟩
    rcases settledLowerSourceStage3ChildUnionEvent_child_witness A run hevent with
      ⟨child, hchildEvent⟩
    exact ⟨k, hnk, child, Finset.mem_univ child, hchildEvent⟩
  rw [Finset.frequently_exists] at hfreqFilter
  rcases hfreqFilter with ⟨child, _hchildMem, hfreqChild⟩
  exact ⟨child, fun n => (Filter.frequently_atTop).1 hfreqChild n⟩

/--
Fixed-child lower-source event where that child is green in the same stage-(3)
tree.
-/
def SettledLowerSourceStage3ChildUnionChildGreenEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode child : Node A)
    (sourceName : Nat) (sourceState target : A.State) (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionChildEvent A run sourceNode child sourceName
    sourceState target k ∧
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        child ∈ (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A

/--
Fixed-child lower-source event where that child is not green in the same stage-(3)
tree.
-/
def SettledLowerSourceStage3ChildUnionChildNotGreenEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode child : Node A)
    (sourceName : Nat) (sourceState target : A.State) (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionChildEvent A run sourceNode child sourceName
    sourceState target k ∧
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        child ∉ (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A

/--
Fixed-child lower-source event where the child is removed by a green ancestor
during stage (4).
-/
def SettledLowerSourceStage3ChildUnionChildRemovedByGreenEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode child : Node A)
    (sourceName : Nat) (sourceState target : A.State) (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionChildEvent A run sourceNode child sourceName
    sourceState target k ∧
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen A child

/--
Fixed-child lower-source event where the accepting target survives into the next
live label of that same child.
-/
def SettledLowerSourceStage3ChildUnionChildSurvivesEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode child : Node A)
    (sourceName : Nat) (sourceState target : A.State) (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionChildEvent A run sourceNode child sourceName
    sourceState target k ∧
    ∃ next : LiveState A,
      (automaton A).run word (k + 1) = some next ∧
        target ∈ next.1.label child

/--
If the fixed child is not green-removed, the accepting target carried by that
child in the stage-(3) tree survives into the next live tree.
-/
theorem settledLowerSourceStage3ChildUnionChildEvent_target_survives_of_not_removedByGreen
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionChildEvent A run sourceNode child
        sourceName sourceState target k)
    (hnotRemoved :
      ∃ live : LiveState A,
        (automaton A).run word k = some live ∧
          ¬ (((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen A child) :
    SettledLowerSourceStage3ChildUnionChildSurvivesEvent A run sourceNode child
      sourceName sourceState target k := by
  have heventCopy := hevent
  rcases hevent with ⟨hchildUnionEvent, liveChild, hrunChild, hchildPayload⟩
  rcases hchildUnionEvent with ⟨hbase, liveCU, hrunCU, _hchildUnion⟩
  rcases hbase with
    ⟨live, next, hrun, hrunNext, _htarget, _haccepting, _hsourceActive,
      _hsourceState, _hsegment, _hsourceName⟩
  have hliveCUEq : liveCU = live := by
    have hsome : some liveCU = some live := by
      rw [← hrunCU, hrun]
    exact Option.some.inj hsome
  subst liveCU
  have hliveChildEq : liveChild = live := by
    have hsome : some liveChild = some live := by
      rw [← hrunChild, hrun]
    exact Option.some.inj hsome
  subst liveChild
  rcases hnotRemoved with ⟨liveNR, hrunNR, hnotRemovedRaw⟩
  have hliveNREq : liveNR = live := by
    have hsome : some liveNR = some live := by
      rw [← hrunNR, hrun]
    exact Option.some.inj hsome
  subst liveNR
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases hchildPayload with ⟨_hchild, htargetChild⟩
  have hnotRemovedT3 : ¬ t3.RemovedByGreen A child := by
    simpa [t1, plan, t2, t3] using hnotRemovedRaw
  have htargetFinal :
      target ∈ (liveNextTree A live (word k)).label child := by
    have hsurv :=
      mem_stage456_label_of_not_green A t3
        (by simpa [t1, plan, t2, t3] using htargetChild) hnotRemovedT3
    simpa [liveNextTree, livePlan, t1, plan, t2, t3] using hsurv
  have hnextTree : next.1 = liveNextTree A live (word k) :=
    automaton_run_live_nextTree A word hrun hrunNext
  exact ⟨heventCopy, next, hrunNext,
    by simpa [hnextTree] using htargetFinal⟩

/--
Every fixed-child child-union event either is removed by a green ancestor, or its
target survives into the next live label of the same child.
-/
theorem settledLowerSourceStage3ChildUnionChildEvent_removedByGreen_or_survives
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionChildEvent A run sourceNode child
        sourceName sourceState target k) :
    SettledLowerSourceStage3ChildUnionChildRemovedByGreenEvent A run sourceNode
        child sourceName sourceState target k ∨
      SettledLowerSourceStage3ChildUnionChildSurvivesEvent A run sourceNode child
        sourceName sourceState target k := by
  rcases hevent with ⟨hchildUnionEvent, live, hrun, hchildPayload⟩
  by_cases hremoved :
      (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen A child
  · exact Or.inl
      ⟨⟨hchildUnionEvent, live, hrun, hchildPayload⟩, live, hrun, hremoved⟩
  · exact Or.inr
      (settledLowerSourceStage3ChildUnionChildEvent_target_survives_of_not_removedByGreen
        A run ⟨hchildUnionEvent, live, hrun, hchildPayload⟩
        ⟨live, hrun, hremoved⟩)

/--
Cofinal form of the fixed-child green-removal/survival split.
-/
theorem frequently_settledLowerSourceStage3ChildUnionChild_removedByGreen_or_survives
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionChildEvent A run sourceNode child
          sourceName sourceState target k) :
    (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionChildRemovedByGreenEvent A run sourceNode
        child sourceName sourceState target k) ∨
      (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionChildSurvivesEvent A run sourceNode child
          sourceName sourceState target k) := by
  apply frequently_left_or_right_of_frequently_or
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  exact ⟨k, hnk,
    settledLowerSourceStage3ChildUnionChildEvent_removedByGreen_or_survives
      A run hevent⟩

/--
For a fixed lower-source child branch, either the child is green cofinally, or the
same child is not green cofinally.
-/
theorem frequently_settledLowerSourceStage3ChildUnionChild_green_or_notGreen
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionChildEvent A run sourceNode child
          sourceName sourceState target k) :
    (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionChildGreenEvent A run sourceNode child
        sourceName sourceState target k) ∨
      (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionChildNotGreenEvent A run sourceNode child
          sourceName sourceState target k) := by
  classical
  apply frequently_left_or_right_of_frequently_or
  intro n
  rcases hfreq n with ⟨k, hnk, hchildEvent⟩
  rcases hchildEvent with ⟨hchildUnionEvent, live, hrun, hchildPayload⟩
  by_cases hgreen :
      child ∈ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A
  · exact ⟨k, hnk, Or.inl
      ⟨⟨hchildUnionEvent, live, hrun, hchildPayload⟩, live, hrun, hgreen⟩⟩
  · exact ⟨k, hnk, Or.inr
      ⟨⟨hchildUnionEvent, live, hrun, hchildPayload⟩, live, hrun, hgreen⟩⟩

/--
Child-union event whose fixed lower source has breakpoint measure zero in the
same stage-(3) tree.  By `green_iff_uncoveredCount_zero`, this is exactly the
local source-green event needed by the final lower-source kernel.
-/
def SettledLowerSourceStage3ChildUnionZeroEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode : Node A)
    (sourceName : Nat) (sourceState target : A.State) (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
    sourceState target k ∧
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        let t1 := live.1.stage1 A (word k)
        let plan := (livePlan A live (word k)).stage2Plan
        let t2 := t1.stage2 A plan
        let t3 := t2.stage3 A
        t3.uncoveredCount A sourceNode = 0

/--
Child-union event whose fixed lower source still has positive breakpoint measure
in the same stage-(3) tree.  This is the complementary case to
`SettledLowerSourceStage3ChildUnionZeroEvent` and is the entry point for the
measure-decrease part of the paper argument.
-/
def SettledLowerSourceStage3ChildUnionPositiveEvent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode : Node A)
    (sourceName : Nat) (sourceState target : A.State) (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
    sourceState target k ∧
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        let t1 := live.1.stage1 A (word k)
        let plan := (livePlan A live (word k)).stage2Plan
        let t2 := t1.stage2 A plan
        let t3 := t2.stage3 A
        0 < t3.uncoveredCount A sourceNode

/--
Every stage-(3) child-union event is either already a breakpoint-zero event or a
positive-measure event at the same source node.
-/
theorem settledLowerSourceStage3ChildUnionEvent_zero_or_positive
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
        sourceState target k) :
    SettledLowerSourceStage3ChildUnionZeroEvent A run sourceNode sourceName
        sourceState target k ∨
      SettledLowerSourceStage3ChildUnionPositiveEvent A run sourceNode sourceName
        sourceState target k := by
  rcases hevent with ⟨hbase, live, hrun, hchildUnion⟩
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases Nat.eq_zero_or_pos (t3.uncoveredCount A sourceNode) with hzero | hpos
  · exact Or.inl
      ⟨⟨hbase, live, hrun, hchildUnion⟩, live, hrun, by simpa [t1, plan, t2, t3] using hzero⟩
  · exact Or.inr
      ⟨⟨hbase, live, hrun, hchildUnion⟩, live, hrun, by simpa [t1, plan, t2, t3] using hpos⟩

/--
Cofinal child-union events split into a cofinal zero branch or a cofinal positive
breakpoint-measure branch.
-/
theorem frequently_settledLowerSourceStage3ChildUnion_zero_or_positive
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
          sourceState target k) :
    (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionZeroEvent A run sourceNode sourceName
        sourceState target k) ∨
      (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveEvent A run sourceNode sourceName
          sourceState target k) := by
  apply frequently_left_or_right_of_frequently_or
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  exact ⟨k, hnk, settledLowerSourceStage3ChildUnionEvent_zero_or_positive A run hevent⟩

/--
A positive lower-source child-union event exposes a state in the source label
which is still not covered by its children in the same stage-(3) tree.
-/
theorem settledLowerSourceStage3ChildUnionPositiveEvent_uncovered_witness
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveEvent A run sourceNode sourceName
        sourceState target k) :
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        ∃ state : A.State,
          let t1 := live.1.stage1 A (word k)
          let plan := (livePlan A live (word k)).stage2Plan
          let t2 := t1.stage2 A plan
          let t3 := t2.stage3 A
          state ∈ t3.label sourceNode ∧
            state ∉ t3.childLabelUnion A sourceNode := by
  rcases hevent with ⟨_hchildUnionEvent, live, hrun, hposRaw⟩
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hpos : 0 < t3.uncoveredCount A sourceNode := by
    simpa [t1, plan, t2, t3] using hposRaw
  rcases exists_uncovered_state_of_uncoveredCount_pos A t3 sourceNode hpos with
    ⟨state, hlabel, hnotCovered⟩
  exact ⟨live, hrun, state, by simpa [t1, plan, t2, t3] using hlabel,
    by simpa [t1, plan, t2, t3] using hnotCovered⟩

/--
Positive child-union event with a fixed uncovered state in the same source label.
This is the finite-pigeonhole form needed before following an uncovered state
through later transitions.
-/
def SettledLowerSourceStage3ChildUnionPositiveWitnessEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode : Node A)
    (sourceName : Nat) (sourceState target uncovered : A.State)
    (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionPositiveEvent A run sourceNode sourceName
    sourceState target k ∧
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        let t1 := live.1.stage1 A (word k)
        let plan := (livePlan A live (word k)).stage2Plan
        let t2 := t1.stage2 A plan
        let t3 := t2.stage3 A
        uncovered ∈ t3.label sourceNode ∧
          uncovered ∉ t3.childLabelUnion A sourceNode

/--
In a positive lower-source child-union event, the accepting target already lies
in the source's child-label union, while the uncovered witness is outside it.
Thus the two states are distinct; the breakpoint argument has to transport the
uncovered witness or create a forbidden lower source, not identify it with the
current accepting target.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessEvent_target_ne_uncovered
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessEvent A run sourceNode
        sourceName sourceState target uncovered k) :
    target ≠ uncovered := by
  rcases hevent with
    ⟨⟨⟨_hbase, liveCU, hrunCU, htargetCoverRaw⟩, _livePos, _hrunPos,
        _hposRaw⟩,
      liveWit, hrunWit, huncoveredRaw⟩
  have hliveWit : liveWit = liveCU := by
    have hsome : some liveWit = some liveCU := by
      rw [← hrunWit, hrunCU]
    exact Option.some.inj hsome
  subst liveWit
  let t1 := liveCU.1.stage1 A (word k)
  let plan := (livePlan A liveCU (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have htargetCover : target ∈ t3.childLabelUnion A sourceNode := by
    simpa [t1, plan, t2, t3] using htargetCoverRaw
  have huncoveredNotCover :
      uncovered ∉ t3.childLabelUnion A sourceNode := by
    simpa [t1, plan, t2, t3] using huncoveredRaw.2
  intro hEq
  exact huncoveredNotCover (by simpa [hEq] using htargetCover)

/--
Finite-state pigeonhole for the positive breakpoint branch: if positive
child-union events recur, then some concrete state is uncovered at the fixed source
node in arbitrarily late such events.
-/
theorem exists_frequently_settledLowerSourceStage3ChildUnionPositiveWitnessEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveEvent A run sourceNode sourceName
          sourceState target k) :
    ∃ uncovered : A.State,
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessEvent A run sourceNode
          sourceName sourceState target uncovered k := by
  classical
  have hfreqFilter :
      ∃ᶠ k in Filter.atTop,
        ∃ uncovered ∈ (Finset.univ : Finset A.State),
          SettledLowerSourceStage3ChildUnionPositiveWitnessEvent A run sourceNode
            sourceName sourceState target uncovered k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with ⟨k, hnk, hevent⟩
    rcases
        settledLowerSourceStage3ChildUnionPositiveEvent_uncovered_witness
          A run hevent with
      ⟨live, hrun, uncovered, hlabel, hnotCovered⟩
    exact ⟨k, hnk, uncovered, Finset.mem_univ uncovered, hevent, live, hrun,
      by simpa using hlabel, by simpa using hnotCovered⟩
  rw [Finset.frequently_exists] at hfreqFilter
  rcases hfreqFilter with ⟨uncovered, _huncoveredMem, hfreqUncovered⟩
  exact ⟨uncovered, fun n => (Filter.frequently_atTop).1 hfreqUncovered n⟩

/--
Sharpened cofinal split for the breakpoint kernel: a recurrent child-union branch
either already has cofinally many zero-measure events, or it has a fixed uncovered
state witnessing cofinally many positive-measure events.
-/
theorem frequently_settledLowerSourceStage3ChildUnion_zero_or_positiveWitness
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
          sourceState target k) :
    (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionZeroEvent A run sourceNode sourceName
        sourceState target k) ∨
      ∃ uncovered : A.State,
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceStage3ChildUnionPositiveWitnessEvent A run sourceNode
            sourceName sourceState target uncovered k := by
  rcases
      frequently_settledLowerSourceStage3ChildUnion_zero_or_positive
        A run hfreq with
    hzero | hpositive
  · exact Or.inl hzero
  · exact Or.inr
      (exists_frequently_settledLowerSourceStage3ChildUnionPositiveWitnessEvent
        A run hpositive)

/--
Positive-witness event with the concrete child carrying the fixed accepting target
also fixed at the same time.
-/
def SettledLowerSourceStage3ChildUnionPositiveWitnessChildEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode child : Node A)
    (sourceName : Nat) (sourceState target uncovered : A.State)
    (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionPositiveWitnessEvent A run sourceNode
    sourceName sourceState target uncovered k ∧
    SettledLowerSourceStage3ChildUnionChildEvent A run sourceNode child
      sourceName sourceState target k

/--
Expose a child witness from a positive-witness lower-source event.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessEvent_child_witness
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessEvent A run sourceNode
        sourceName sourceState target uncovered k) :
    ∃ child : Node A,
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildEvent A run
        sourceNode child sourceName sourceState target uncovered k := by
  have heventCopy := hevent
  rcases hevent with ⟨hpositive, _live, _hrun, _huncovered⟩
  rcases hpositive with ⟨hchildUnionEvent, _livePos, _hrunPos, _hpos⟩
  rcases
      settledLowerSourceStage3ChildUnionEvent_child_witness
        A run hchildUnionEvent with
    ⟨child, hchildEvent⟩
  exact ⟨child, heventCopy, hchildEvent⟩

/--
Finite-node pigeonhole for the aligned positive-witness branch: if a fixed
uncovered state witnesses positive lower-source events cofinally, then a fixed
child carries the accepting target at cofinally many of those same events.
-/
theorem exists_frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessEvent A run sourceNode
          sourceName sourceState target uncovered k) :
    ∃ child : Node A,
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildEvent A run
          sourceNode child sourceName sourceState target uncovered k := by
  classical
  have hfreqFilter :
      ∃ᶠ k in Filter.atTop,
        ∃ child ∈ (Finset.univ : Finset (Node A)),
          SettledLowerSourceStage3ChildUnionPositiveWitnessChildEvent A run
            sourceNode child sourceName sourceState target uncovered k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with ⟨k, hnk, hevent⟩
    rcases
        settledLowerSourceStage3ChildUnionPositiveWitnessEvent_child_witness
          A run hevent with
      ⟨child, hchildEvent⟩
    exact ⟨k, hnk, child, Finset.mem_univ child, hchildEvent⟩
  rw [Finset.frequently_exists] at hfreqFilter
  rcases hfreqFilter with ⟨child, _hchildMem, hfreqChild⟩
  exact ⟨child, fun n => (Filter.frequently_atTop).1 hfreqChild n⟩

/--
Aligned positive-witness child event where the child is removed by a green
ancestor.
-/
def SettledLowerSourceStage3ChildUnionPositiveWitnessChildRemovedByGreenEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode child : Node A)
    (sourceName : Nat) (sourceState target uncovered : A.State)
    (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionPositiveWitnessChildEvent A run sourceNode
    child sourceName sourceState target uncovered k ∧
    SettledLowerSourceStage3ChildUnionChildRemovedByGreenEvent A run sourceNode
      child sourceName sourceState target k

/--
Aligned positive-witness child event where the target survives into the next live
label of that child.
-/
def SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (sourceNode child : Node A)
    (sourceName : Nat) (sourceState target uncovered : A.State)
    (k : Nat) : Prop :=
  SettledLowerSourceStage3ChildUnionPositiveWitnessChildEvent A run sourceNode
    child sourceName sourceState target uncovered k ∧
    SettledLowerSourceStage3ChildUnionChildSurvivesEvent A run sourceNode child
      sourceName sourceState target k

/--
Aligned green-removal/survival split for positive-witness child events.
-/
theorem settledLowerSourceStage3ChildUnionPositiveWitnessChildEvent_removedByGreen_or_survives
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildEvent A run
        sourceNode child sourceName sourceState target uncovered k) :
    SettledLowerSourceStage3ChildUnionPositiveWitnessChildRemovedByGreenEvent A
        run sourceNode child sourceName sourceState target uncovered k ∨
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent A run
        sourceNode child sourceName sourceState target uncovered k := by
  rcases hevent with ⟨hpositiveWitness, hchildEvent⟩
  rcases
      settledLowerSourceStage3ChildUnionChildEvent_removedByGreen_or_survives
        A run hchildEvent with
    hremoved | hsurvives
  · exact Or.inl ⟨⟨hpositiveWitness, hchildEvent⟩, hremoved⟩
  · exact Or.inr ⟨⟨hpositiveWitness, hchildEvent⟩, hsurvives⟩

/--
Cofinal aligned green-removal/survival split for a positive-witness child branch.
-/
theorem frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChild_removedByGreen_or_survives
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target uncovered : A.State}
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildEvent A run
          sourceNode child sourceName sourceState target uncovered k) :
    (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      SettledLowerSourceStage3ChildUnionPositiveWitnessChildRemovedByGreenEvent A
        run sourceNode child sourceName sourceState target uncovered k) ∨
      (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesEvent A run
          sourceNode child sourceName sourceState target uncovered k) := by
  apply frequently_left_or_right_of_frequently_or
  intro n
  rcases hfreq n with ⟨k, hnk, hevent⟩
  exact ⟨k, hnk,
    settledLowerSourceStage3ChildUnionPositiveWitnessChildEvent_removedByGreen_or_survives
      A run hevent⟩

/--
A surviving fixed-child lower-source event is ordinary child-label coverage of
the fixed lower source in the successor live tree.
-/
theorem settledLowerSourceStage3ChildUnionChildSurvivesEvent_to_next_childLabelUnion
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {sourceNode child : Node A}
    {sourceName : Nat} {sourceState target : A.State} {k : Nat}
    (hevent :
      SettledLowerSourceStage3ChildUnionChildSurvivesEvent A run sourceNode child
        sourceName sourceState target k) :
    ∃ next : LiveState A,
      (automaton A).run word (k + 1) = some next ∧
        A.accepting target ∧
        target ∈ next.1.childLabelUnion A sourceNode := by
  rcases hevent with ⟨hchildEvent, next, hrunNext, htargetNextChild⟩
  rcases hchildEvent with ⟨hchildUnionEvent, liveChild, hrunChild, hchildPayload⟩
  rcases hchildUnionEvent with ⟨hbase, liveCU, hrunCU, _hchildUnion⟩
  rcases hbase with
    ⟨live, nextBase, hrun, hrunNextBase, _htarget, haccepting,
      _hsourceActive, _hsourceState, _hsegment, _hsourceName⟩
  have hliveCUEq : liveCU = live := by
    have hsome : some liveCU = some live := by
      rw [← hrunCU, hrun]
    exact Option.some.inj hsome
  subst liveCU
  have hliveChildEq : liveChild = live := by
    have hsome : some liveChild = some live := by
      rw [← hrunChild, hrun]
    exact Option.some.inj hsome
  subst liveChild
  have hnextEq : next = nextBase := by
    have hsome : some next = some nextBase := by
      rw [← hrunNext, hrunNextBase]
    exact Option.some.inj hsome
  subst nextBase
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases hchildPayload with ⟨hchildT3, _htargetChild⟩
  have hnextTree : next.1 = liveNextTree A live (word k) :=
    automaton_run_live_nextTree A word hrun hrunNext
  have hactiveNext : next.1.active child = true :=
    active_of_mem_label A next.1 next.2 htargetNextChild
  have hchildSpec := hchildT3
  rw [children, Finset.mem_filter] at hchildSpec
  obtain ⟨_, _hactiveT3, hchildNeRoot, hparentT3⟩ := hchildSpec
  have hparentNext : next.1.parent child = sourceNode := by
    rw [hnextTree]
    change
      ((((t3.stage4 A).stage5 A (t3.greenRemovedNodes A)).stage6 A
        (t3.greenRemovedNodes A ∪ (t3.stage4 A).emptyActiveNodes A)).parent child)
        = sourceNode
    rw [stage6_parent, stage5_parent, stage4_parent]
    exact hparentT3
  have hchildNext : child ∈ next.1.children A sourceNode := by
    rw [children, Finset.mem_filter]
    exact ⟨Finset.mem_univ child, hactiveNext, hchildNeRoot, hparentNext⟩
  refine ⟨next, hrunNext, haccepting, ?_⟩
  rw [childLabelUnion, Finset.mem_biUnion]
  exact ⟨child, hchildNext, htargetNextChild⟩

