theorem stable_green_event_cuts_accepts_of_frontier_cover_chain
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {cuts : Nat -> Nat}
    (hstrict : ∀ i : Nat, cuts i < cuts (i + 1))
    (frontierLive : Nat -> LiveState A)
    (frontierNode : Nat -> Node A)
    (hfrontierReachable :
      ∀ i : Nat, ∀ state,
        state ∈ (frontierLive i).1.label (frontierNode i) ->
          ReachablePrefix A A.initial word
            (shiftedEventFrontierCuts cuts i) state)
    (hnonempty :
      ∀ i : Nat, ((frontierLive i).1.label (frontierNode i)).Nonempty)
    (hcover :
      ∀ i : Nat,
        SegmentVisitsAcceptingCover A word (shiftedEventFrontierCuts cuts i)
          (shiftedEventFrontierCuts cuts (i + 1) -
            shiftedEventFrontierCuts cuts i)
          ((frontierLive i).1.label (frontierNode i))
          ((frontierLive (i + 1)).1.label (frontierNode (i + 1)))) :
    A.Accepts word := by
  apply accepts_of_arbitrarily_long_segment_cover_chains_from_shifted_event_frontiers
    A cuts hstrict
      (fun i => (frontierLive i).1.label (frontierNode i))
  · intro source hsource
    simpa [shiftedEventFrontierCuts] using
      hfrontierReachable 0 source hsource
  · intro i
    exact hnonempty i
  · intro i
    simpa [shiftedEventFrontierCuts] using hcover i

theorem accepts_of_automaton_accepts_and_frontier_cover_chain
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (hacceptsDPW : (automaton A).Accepts word)
    (hcoverBuilder :
