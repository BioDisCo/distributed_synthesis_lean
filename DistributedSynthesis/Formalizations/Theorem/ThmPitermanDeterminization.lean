-/
theorem automaton_accepts_of_accepts_of_lowerChildUnionHandler
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word)
    (greenHorn :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
