    (coverageHandler run hrunAccepts v a hsettle hng)
    (lowerHandler run hrunAccepts v a hsettle hng)

/--
Forward direction reduced to the green horn plus the remaining lower-source
branch handler.  The coverage branch of the settled non-green descent is now
closed by `runSettles_coverage_branch_to_runSettlesAtName`.
-/
theorem automaton_accepts_of_accepts_of_lowerHandler
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word)
    (greenHorn :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
