    have htimeN : N ≤ cuts (i + 1) + 1 + (j + 1) := by
      rcases hevents i with ⟨hNk, _⟩
      omega
    have hrunj :
        (automaton A).run word (cuts (i + 1) + 1 + (j + 1)) =
          some (lives (j + 1)) :=
      hrunTransport (j + 1) (by omega)
    rcases hstableStrict (cuts (i + 1) + 1 + (j + 1)) htimeN
        (lives (j + 1)) hrunj with
      ⟨hf, he⟩
    by_cases hfe : ((lives (j + 1)).1.f).val < ((lives (j + 1)).1.e).val
    · have hmle := hf hfe
      omega
    · have hmlt := he hfe
      omega
  rcases hchildCoverBuilder recurrentName N cuts frontierLive frontierNode
      hmin hstableStrict hzero hstrict hevents hrunFrontier hactiveFrontier
      hnameFrontier hnonempty hreachable i lives hrunTransport with
    ⟨htriggerCover, hnontriggerCover⟩
  have htransportEnd :
      cuts (i + 1) + 1 + transportLength = cuts (i + 2) := by
    have hle : cuts (i + 1) + 1 ≤ cuts (i + 2) :=
      Nat.succ_le_of_lt (hstrict (i + 1))
    omega
  have hblock :
      SegmentVisitsAcceptingCover A word (cuts (i + 1) + 1)
        (transportLength + 1)
        ((frontierLive i).1.label (frontierNode i))
        ((frontierLive (i + 1)).1.label (frontierNode (i + 1))) :=
    StableGreenTriggerSegmentEvent.block_cover_from_frontier_ranked_child_covers_no_same_delete
      A word (hfrontierEvent := hevents i)
      (hgreenEvent := hevents (i + 1)) hstableWeak
      (hfrontierRun := by
        simpa [shiftedEventFrontierCuts] using hrunFrontier i)
      (hfrontierActive := hactiveFrontier i)
      (hfrontierName := hnameFrontier i)
      lives htransportEnd hrunTransport hnoSameDelete
      (hnextFrontierRun := by
        simpa [shiftedEventFrontierCuts] using hrunFrontier (i + 1))
      (hnextFrontierActive := hactiveFrontier (i + 1))
      (hnextFrontierName := hnameFrontier (i + 1))
      htriggerCover hnontriggerCover
  have hlength :
      transportLength + 1 =
        (cuts (i + 2) + 1) - (cuts (i + 1) + 1) := by
    have hle : cuts (i + 1) + 1 ≤ cuts (i + 2) :=
      Nat.succ_le_of_lt (hstrict (i + 1))
    omega
  simpa [shiftedEventFrontierCuts, ← hlength] using hblock

theorem accepts_of_automaton_accepts_and_frontier_stage3_proper_descendant_covers_strict
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (hacceptsDPW : (automaton A).Accepts word)
    (hdescendantCoverBuilder :
      ∀ (recurrentName : Name A) (N : Nat) (cuts : Nat -> Nat)
        (frontierLive : Nat -> LiveState A) (frontierNode : Nat -> Node A),
        (∀ q : Nat,
          (automaton A).PrioritySeenInfinitelyOften word q ->
            2 * recurrentName.val ≤ q) ->
        (∀ k : Nat, N ≤ k ->
          ∀ live : LiveState A,
            (automaton A).run word k = some live ->
              (live.1.f.val < live.1.e.val ->
                recurrentName.val ≤ live.1.f.val) ∧
              (¬ live.1.f.val < live.1.e.val ->
                recurrentName.val < live.1.e.val)) ->
        cuts 0 = 0 ->
        (∀ i : Nat, cuts i < cuts (i + 1)) ->
        (∀ i : Nat,
          StableGreenTriggerSegmentEvent A word recurrentName N
            (cuts (i + 1))) ->
        (∀ i : Nat,
          (automaton A).run word (shiftedEventFrontierCuts cuts i) =
            some (frontierLive i)) ->
        (∀ i : Nat, (frontierLive i).1.active (frontierNode i) = true) ->
        (∀ i : Nat,
          ((frontierLive i).1.name (frontierNode i)).val =
            recurrentName.val) ->
        (∀ i : Nat, ((frontierLive i).1.label (frontierNode i)).Nonempty) ->
        (∀ i : Nat, ∀ state,
          state ∈ (frontierLive i).1.label (frontierNode i) ->
            ReachablePrefix A A.initial word
              (shiftedEventFrontierCuts cuts i) state) ->
        ∀ i : Nat,
          let transportLength := cuts (i + 2) - (cuts (i + 1) + 1)
          ∀ lives : Nat -> LiveState A,
            (∀ j : Nat, j ≤ transportLength ->
              (automaton A).run word (cuts (i + 1) + 1 + j) =
                some (lives j)) ->
            ∀ descendant,
              ((((lives transportLength).1.stage1 A
                (word (cuts (i + 2)))).stage2 A
                  (livePlan A (lives transportLength)
                    (word (cuts (i + 2)))).stage2Plan).stage3 A).active
                  descendant = true ->
              ((((lives transportLength).1.stage1 A
                (word (cuts (i + 2)))).stage2 A
                  (livePlan A (lives transportLength)
                    (word (cuts (i + 2)))).stage2Plan).stage3 A).IsAncestorOrSelf
                    A (frontierNode i) descendant ->
              frontierNode i ≠ descendant ->
              recurrentName.val <
                (((((lives transportLength).1.stage1 A
                  (word (cuts (i + 2)))).stage2 A
                    (livePlan A (lives transportLength)
                      (word (cuts (i + 2)))).stage2Plan).stage3 A).name
                    descendant).val ->
              SegmentVisitsAcceptingCover A word (cuts (i + 1) + 1)
                (transportLength + 1)
                ((frontierLive i).1.label (frontierNode i))
                (((((lives transportLength).1.stage1 A
                  (word (cuts (i + 2)))).stage2 A
                    (livePlan A (lives transportLength)
                      (word (cuts (i + 2)))).stage2Plan).stage3 A).label
                    descendant)) :
    A.Accepts word := by
  rcases automaton_accepts_stable_green_event_cuts_with_trigger_segment_strict
      A word hacceptsDPW with
    ⟨recurrentName, hmin, N, hstableStrict, cuts, hzero, hstrict,
      hevents⟩
  rcases stable_green_event_cuts_active_name_frontiers A word hevents with
    ⟨frontierLive, frontierNode, hrunFrontier, hactiveFrontier,
      hnameFrontier, hnonempty, hreachable⟩
  apply stable_green_event_cuts_accepts_of_frontier_cover_chain
    A word hstrict frontierLive frontierNode hreachable hnonempty
  intro i
  let transportLength : Nat :=
    cuts (i + 2) - (cuts (i + 1) + 1)
  rcases automaton_run_interval_lives_of_accepts A word hacceptsDPW
      (cuts (i + 1) + 1) transportLength with
    ⟨lives, hrunTransport⟩
  have hstableWeak :
      ∀ k : Nat, N ≤ k ->
        ∀ live : LiveState A,
          (automaton A).run word k = some live ->
            (live.1.f.val < live.1.e.val ->
              recurrentName.val ≤ live.1.f.val) ∧
            (¬ live.1.f.val < live.1.e.val ->
              recurrentName.val ≤ live.1.e.val) := by
    intro k hk live hrun
    rcases hstableStrict k hk live hrun with ⟨hf, he⟩
    exact ⟨hf, fun hnot => le_of_lt (he hnot)⟩
  have hnoSameDelete :
      ∀ j : Nat, j < transportLength ->
        ((lives (j + 1)).1.e).val ≠ recurrentName.val := by
    intro j hj heq
    have htimeN : N ≤ cuts (i + 1) + 1 + (j + 1) := by
      rcases hevents i with ⟨hNk, _⟩
      omega
    have hrunj :
        (automaton A).run word (cuts (i + 1) + 1 + (j + 1)) =
          some (lives (j + 1)) :=
      hrunTransport (j + 1) (by omega)
    rcases hstableStrict (cuts (i + 1) + 1 + (j + 1)) htimeN
        (lives (j + 1)) hrunj with
      ⟨hf, he⟩
    by_cases hfe : ((lives (j + 1)).1.f).val < ((lives (j + 1)).1.e).val
    · have hmle := hf hfe
      omega
    · have hmlt := he hfe
      omega
  have htransportEnd :
      cuts (i + 1) + 1 + transportLength = cuts (i + 2) := by
    have hle : cuts (i + 1) + 1 ≤ cuts (i + 2) :=
      Nat.succ_le_of_lt (hstrict (i + 1))
    omega
  rcases StableGreenTriggerSegmentEvent.frontier_segmentCover_no_same_delete
      A word (hevents i) hstableWeak
      (hfrontierRun := by
        simpa [shiftedEventFrontierCuts] using hrunFrontier i)
      (hactive := hactiveFrontier i)
      (hname := hnameFrontier i)
      lives hrunTransport hnoSameDelete with
    ⟨_htransport, hactiveEnd, hnameEnd⟩
  have hprev :
      (automaton A).run word (cuts (i + 2)) =
        some (lives transportLength) := by
    have hrunEnd := hrunTransport transportLength (by omega)
    simpa [htransportEnd] using hrunEnd
  have hchildCover :
      ∀ child,
        child ∈
          ((((lives transportLength).1.stage1 A
            (word (cuts (i + 2)))).stage2 A
              (livePlan A (lives transportLength)
                (word (cuts (i + 2)))).stage2Plan).stage3 A).children A
              (frontierNode i) ->
        SegmentVisitsAcceptingCover A word (cuts (i + 1) + 1)
          (transportLength + 1)
          ((frontierLive i).1.label (frontierNode i))
          (((((lives transportLength).1.stage1 A
            (word (cuts (i + 2)))).stage2 A
              (livePlan A (lives transportLength)
                (word (cuts (i + 2)))).stage2Plan).stage3 A).label child) := by
    intro child hchild
    let stage3 :=
      (((lives transportLength).1.stage1 A
        (word (cuts (i + 2)))).stage2 A
          (livePlan A (lives transportLength)
            (word (cuts (i + 2)))).stage2Plan).stage3 A
    have hchildActive : stage3.active child = true := by
      have hmem := hchild
      rw [children, Finset.mem_filter] at hmem
      exact hmem.2.1
    have hancestor : stage3.IsAncestorOrSelf A (frontierNode i) child :=
      isAncestorOrSelf_of_child A stage3
        (isAncestorOrSelf_refl A stage3 (frontierNode i)) hchild
    have hne : frontierNode i ≠ child :=
      live_stage3_child_ne_parent A word (lives transportLength)
        (by simpa [stage3] using hchild)
    have hrank :
        recurrentName.val < (stage3.name child).val := by
      simpa [stage3, htransportEnd] using
        (StableGreenTriggerSegmentEvent.stage3_proper_descendant_name_gt_recurrent
          A word (hevents (i + 1)) hprev hactiveEnd hnameEnd
          (by simpa [stage3] using hchildActive)
          (by simpa [stage3] using hancestor)
          hne)
    exact
      hdescendantCoverBuilder recurrentName N cuts frontierLive frontierNode
        hmin hstableStrict hzero hstrict hevents hrunFrontier hactiveFrontier
        hnameFrontier hnonempty hreachable i lives hrunTransport child
        (by simpa [stage3] using hchildActive)
        (by simpa [stage3] using hancestor)
        hne
        (by simpa [stage3] using hrank)
  have hblock :
      SegmentVisitsAcceptingCover A word (cuts (i + 1) + 1)
        (transportLength + 1)
        ((frontierLive i).1.label (frontierNode i))
        ((frontierLive (i + 1)).1.label (frontierNode (i + 1))) :=
    StableGreenTriggerSegmentEvent.block_cover_from_frontier_stage3_child_covers_no_same_delete
      A word (hfrontierEvent := hevents i)
      (hgreenEvent := hevents (i + 1)) hstableWeak
      (hfrontierRun := by
        simpa [shiftedEventFrontierCuts] using hrunFrontier i)
      (hfrontierActive := hactiveFrontier i)
      (hfrontierName := hnameFrontier i)
      lives htransportEnd hrunTransport hnoSameDelete
      (hnextFrontierRun := by
        simpa [shiftedEventFrontierCuts] using hrunFrontier (i + 1))
      (hnextFrontierActive := hactiveFrontier (i + 1))
      (hnextFrontierName := hnameFrontier (i + 1))
      hchildCover
  have hlength :
      transportLength + 1 =
        (cuts (i + 2) + 1) - (cuts (i + 1) + 1) := by
    have hle : cuts (i + 1) + 1 ≤ cuts (i + 2) :=
      Nat.succ_le_of_lt (hstrict (i + 1))
    omega
  simpa [shiftedEventFrontierCuts, ← hlength] using hblock

theorem accepts_of_automaton_accepts
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (hacceptsDPW : (automaton A).Accepts word) :
    A.Accepts word := by
  apply accepts_of_automaton_accepts_and_frontier_stage3_proper_descendant_covers_strict
    A word hacceptsDPW
  intro recurrentName N cuts frontierLive frontierNode hmin hstableStrict
    hzero hstrict hevents hrunFrontier hactiveFrontier hnameFrontier
    hnonempty hreachable i transportLength lives hrunTransport descendant
    hdescendantActive hdescendant hne _hrank
  have hstableWeak :
      ∀ k : Nat, N ≤ k ->
        ∀ live : LiveState A,
          (automaton A).run word k = some live ->
            (live.1.f.val < live.1.e.val ->
              recurrentName.val ≤ live.1.f.val) ∧
            (¬ live.1.f.val < live.1.e.val ->
              recurrentName.val ≤ live.1.e.val) := by
    intro k hk live hrun
    rcases hstableStrict k hk live hrun with ⟨hf, he⟩
    exact ⟨hf, fun hnot => le_of_lt (he hnot)⟩
  have hnoSameDelete :
      ∀ j : Nat, j < transportLength ->
        ((lives (j + 1)).1.e).val ≠ recurrentName.val := by
    intro j hj heq
    have htimeN : N ≤ cuts (i + 1) + 1 + (j + 1) := by
      rcases hevents i with ⟨hNk, _⟩
      omega
    have hrunj :
        (automaton A).run word (cuts (i + 1) + 1 + (j + 1)) =
          some (lives (j + 1)) :=
      hrunTransport (j + 1) (by omega)
    rcases hstableStrict (cuts (i + 1) + 1 + (j + 1)) htimeN
        (lives (j + 1)) hrunj with
      ⟨hf, he⟩
    by_cases hfe : ((lives (j + 1)).1.f).val < ((lives (j + 1)).1.e).val
    · have hmle := hf hfe
      omega
    · have hmlt := he hfe
      omega
  have htransportEnd :
      cuts (i + 1) + 1 + transportLength = cuts (i + 2) := by
    have hle : cuts (i + 1) + 1 ≤ cuts (i + 2) :=
      Nat.succ_le_of_lt (hstrict (i + 1))
    omega
  have hfrontierRunI :
      (automaton A).run word (cuts (i + 1) + 1) =
        some (frontierLive i) := by
    simpa [shiftedEventFrontierCuts] using hrunFrontier i
  apply
    StableGreenTriggerSegmentEvent.block_cover_from_frontier_stage3_proper_descendant_split_child_covers_no_same_delete
      A word (hfrontierEvent := hevents i)
      (hgreenEvent := hevents (i + 1)) hstableWeak
      (hfrontierRun := hfrontierRunI)
      (hfrontierActive := hactiveFrontier i)
      (hfrontierName := hnameFrontier i)
      lives htransportEnd hrunTransport hnoSameDelete
      hdescendantActive hdescendant hne
  · intro htrigger child hchild hnotFresh
    have hchildLive :
        child ∈ (lives transportLength).1.children A (frontierNode i) :=
      live_green_stage2Trigger_old_child_of_stage3_child_not_fresh
        A word (lives transportLength) htrigger hchild hnotFresh
    have hchildActive : (lives transportLength).1.active child = true := by
      rw [children, Finset.mem_filter] at hchildLive
      exact hchildLive.2.1
    have hchildAncestor :
        (lives transportLength).1.IsAncestorOrSelf A (frontierNode i) child :=
      isAncestorOrSelf_of_child A (lives transportLength).1
        (isAncestorOrSelf_refl A (lives transportLength).1 (frontierNode i))
        hchildLive
    have hchildNe : frontierNode i ≠ child := by
      have hlt := live_child_name_gt_parent A (lives transportLength) hchildLive
      intro hsame
      subst child
      exact Nat.lt_irrefl _ hlt
    exact
      StableGreenTriggerSegmentEvent.frontier_proper_descendant_cover_no_same_delete
        A word (hevents i) hstableWeak hfrontierRunI
        (hactiveFrontier i) (hnameFrontier i) lives hrunTransport
        hnoSameDelete hchildActive hchildAncestor hchildNe
  · intro hnotTrigger child hchild
    have hchildLive :
        child ∈ (lives transportLength).1.children A (frontierNode i) :=
      live_green_nontrigger_child_of_stage3_child
        A word (lives transportLength) hnotTrigger hchild
    have hchildActive : (lives transportLength).1.active child = true := by
      rw [children, Finset.mem_filter] at hchildLive
      exact hchildLive.2.1
    have hchildAncestor :
        (lives transportLength).1.IsAncestorOrSelf A (frontierNode i) child :=
      isAncestorOrSelf_of_child A (lives transportLength).1
        (isAncestorOrSelf_refl A (lives transportLength).1 (frontierNode i))
        hchildLive
    have hchildNe : frontierNode i ≠ child := by
      have hlt := live_child_name_gt_parent A (lives transportLength) hchildLive
      intro hsame
      subst child
      exact Nat.lt_irrefl _ hlt
    exact
      StableGreenTriggerSegmentEvent.frontier_proper_descendant_cover_no_same_delete
        A word (hevents i) hstableWeak hfrontierRunI
        (hactiveFrontier i) (hnameFrontier i) lives hrunTransport
        hnoSameDelete hchildActive hchildAncestor hchildNe

theorem automaton_accepts_of_accepts_of_rootStage2Survives_or_lowerName
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word)
    (hsurvives :
      (∃ cuts : Nat -> Nat,
        cuts 0 = 0 ∧
          (∀ i : Nat, cuts i < cuts (i + 1)) ∧
            ∀ i : Nat,
              RootStage2SurvivesEvent A word (cuts (i + 1))) ->
        (automaton A).Accepts word)
    (hlower :
      (∃ sourceName,
        sourceName ∈ Finset.range (Fintype.card A.State) ∧
          ∃ cuts : Nat -> Nat,
            cuts 0 = 0 ∧
              (∀ i : Nat, cuts i < cuts (i + 1)) ∧
                ∀ i : Nat,
                  RootStage2LowerNameEvent A word sourceName
                    (cuts (i + 1))) ->
        (automaton A).Accepts word) :
    (automaton A).Accepts word := by
  rcases automaton_accepts_rootStage2Survives_or_lowerName_cuts_of_accepts
      A haccepts with hsurvivesCuts | hlowerCuts
  · exact hsurvives hsurvivesCuts
  · exact hlower hlowerCuts

theorem automaton_correct_of_accepts_automaton
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (hcomplete : A.Accepts word -> (automaton A).Accepts word) :
    (automaton A).Accepts word ↔ A.Accepts word := by
  constructor
  · exact accepts_of_automaton_accepts A word
  · exact hcomplete

noncomputable def toDPACompilationOfCompleteness
    [DecidableEq A.State]
    (hcomplete : ∀ word : OmegaWord Alphabet,
      A.Accepts word -> (automaton A).Accepts word) :
    NondetBuchiToDPACompilation A where
  dpa := automaton A
  correct := by
    intro word
    exact automaton_correct_of_accepts_automaton A (hcomplete word)

/--
Compiler endpoint conditional directly on the two construction horns for each
accepting NBW run.  This is the horn-level counterpart of
`toDPACompilationOfDescent`/`toDPACompilationOfLiveGreenDescent`: the reverse
direction is already `accepts_of_automaton_accepts`, and the forward direction
is supplied by `automaton_accepts_of_accepts_of_descentHorns`.
-/
noncomputable def toDPACompilationOfDescentHorns
    [DecidableEq A.State]
    (greenHorn :
      ∀ (word : OmegaWord Alphabet)
        (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> RunNodeGreensIO A run v ->
          (automaton A).Accepts word)
    (descendHorn :
      ∀ (word : OmegaWord Alphabet)
        (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    NondetBuchiToDPACompilation A :=
  toDPACompilationOfCompleteness A
    (fun word haccepts =>
      automaton_accepts_of_accepts_of_descentHorns A haccepts
        (greenHorn word) (descendHorn word))

/--
Compiler endpoint conditional on the green horn plus the two branch handlers for
the settled non-green descent split.
-/
noncomputable def toDPACompilationOfBranchHandlers
    [DecidableEq A.State]
    (greenHorn :
      ∀ (word : OmegaWord Alphabet)
        (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> RunNodeGreensIO A run v ->
          (automaton A).Accepts word)
    (coverageHandler :
      ∀ (word : OmegaWord Alphabet)
        (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ child childName,
            childName ∈ Finset.range (Fintype.card A.State) ∧
              a < childName ∧
              ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledCoverageChildNameEvent A run v child a childName k) ->
          ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a')
    (lowerHandler :
      ∀ (word : OmegaWord Alphabet)
        (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ sourceName,
            sourceName ∈ Finset.range a ∧
              ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledLowerSourceNameEvent A run sourceName k) ->
          ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    NondetBuchiToDPACompilation A :=
  toDPACompilationOfCompleteness A
    (fun word haccepts =>
      automaton_accepts_of_accepts_of_branchHandlers A haccepts
        (greenHorn word) (coverageHandler word) (lowerHandler word))

/--
Compiler endpoint conditional on the green horn plus the paper-shaped minimal
coverage branch handler and the lower-source branch handler.
-/
noncomputable def toDPACompilationOfMinimalBranchHandlers
    [DecidableEq A.State]
    (greenHorn :
      ∀ (word : OmegaWord Alphabet)
        (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> RunNodeGreensIO A run v ->
          (automaton A).Accepts word)
    (coverageHandler :
      ∀ (word : OmegaWord Alphabet)
        (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ child childName,
            childName ∈ Finset.range (Fintype.card A.State) ∧
              a < childName ∧
              (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledCoverageChildNameEvent A run v child a childName k) ∧
              ∀ smaller : Nat, smaller < childName ->
                ¬ (smaller ∈ Finset.range (Fintype.card A.State) ∧
                    a < smaller ∧
                    ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                      SettledCoverageNameEvent A run v a smaller k)) ->
          ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a')
    (lowerHandler :
      ∀ (word : OmegaWord Alphabet)
        (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ sourceName,
            sourceName ∈ Finset.range a ∧
              ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledLowerSourceNameEvent A run sourceName k) ->
          ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    NondetBuchiToDPACompilation A :=
  toDPACompilationOfCompleteness A
    (fun word haccepts =>
      automaton_accepts_of_accepts_of_minimalBranchHandlers A haccepts
        (greenHorn word) (coverageHandler word) (lowerHandler word))

/--
Compiler endpoint conditional on the green horn plus the remaining lower-source
branch handler.  The settled non-green coverage branch is now unconditional.
-/
noncomputable def toDPACompilationOfLowerHandler
    [DecidableEq A.State]
    (greenHorn :
      ∀ (word : OmegaWord Alphabet)
        (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> RunNodeGreensIO A run v ->
          (automaton A).Accepts word)
    (lowerHandler :
      ∀ (word : OmegaWord Alphabet)
        (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ sourceName,
            sourceName ∈ Finset.range a ∧
              ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledLowerSourceNameEvent A run sourceName k) ->
          ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    NondetBuchiToDPACompilation A :=
  toDPACompilationOfCompleteness A
    (fun word haccepts =>
      automaton_accepts_of_accepts_of_lowerHandler A haccepts
        (greenHorn word) (lowerHandler word))

/--
Compiler endpoint conditional on the green horn plus the fixed lower-source
node/name branch handler.
-/
noncomputable def toDPACompilationOfLowerNodeHandler
    [DecidableEq A.State]
    (greenHorn :
      ∀ (word : OmegaWord Alphabet)
        (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> RunNodeGreensIO A run v ->
          (automaton A).Accepts word)
    (lowerNodeHandler :
      ∀ (word : OmegaWord Alphabet)
        (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          (∃ sourceName sourceNode,
            sourceName ∈ Finset.range a ∧
              ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
                SettledLowerSourceNodeNameEvent A run sourceNode sourceName k) ->
          ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    NondetBuchiToDPACompilation A :=
  toDPACompilationOfCompleteness A
    (fun word haccepts =>
      automaton_accepts_of_accepts_of_lowerNodeHandler A haccepts
        (greenHorn word) (lowerNodeHandler word))

theorem accepts_of_automaton_accepts_and_frontier_parent_covers_strict
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (hacceptsDPW : (automaton A).Accepts word)
    (hparentCoverBuilder :
      ∀ (recurrentName : Name A) (N : Nat) (cuts : Nat -> Nat)
        (frontierLive : Nat -> LiveState A) (frontierNode : Nat -> Node A),
        (∀ q : Nat,
          (automaton A).PrioritySeenInfinitelyOften word q ->
            2 * recurrentName.val ≤ q) ->
        (∀ k : Nat, N ≤ k ->
          ∀ live : LiveState A,
            (automaton A).run word k = some live ->
              (live.1.f.val < live.1.e.val ->
                recurrentName.val ≤ live.1.f.val) ∧
              (¬ live.1.f.val < live.1.e.val ->
                recurrentName.val < live.1.e.val)) ->
        cuts 0 = 0 ->
        (∀ i : Nat, cuts i < cuts (i + 1)) ->
        (∀ i : Nat,
          StableGreenTriggerSegmentEvent A word recurrentName N
            (cuts (i + 1))) ->
        (∀ i : Nat,
          (automaton A).run word (shiftedEventFrontierCuts cuts i) =
            some (frontierLive i)) ->
        (∀ i : Nat, (frontierLive i).1.active (frontierNode i) = true) ->
        (∀ i : Nat,
          ((frontierLive i).1.name (frontierNode i)).val =
            recurrentName.val) ->
        (∀ i : Nat, ((frontierLive i).1.label (frontierNode i)).Nonempty) ->
        (∀ i : Nat, ∀ state,
          state ∈ (frontierLive i).1.label (frontierNode i) ->
            ReachablePrefix A A.initial word
              (shiftedEventFrontierCuts cuts i) state) ->
        ∀ i : Nat,
          let transportLength := cuts (i + 2) - (cuts (i + 1) + 1)
          ∀ lives : Nat -> LiveState A,
            (∀ j : Nat, j ≤ transportLength ->
              (automaton A).run word (cuts (i + 1) + 1 + j) =
                some (lives j)) ->
            SegmentVisitsAcceptingCover A word (cuts (i + 1) + 1)
              transportLength
              ((frontierLive i).1.label (frontierNode i))
              ((lives transportLength).1.label (frontierNode i))) :
    A.Accepts word := by
  apply accepts_of_automaton_accepts_and_frontier_ranked_child_covers_strict
    A word hacceptsDPW
  intro recurrentName N cuts frontierLive frontierNode hmin hstable hzero
    hstrict hevents hrunFrontier hactiveFrontier hnameFrontier hnonempty
    hreachable i transportLength lives hrunTransport
  have hparentCover :
      SegmentVisitsAcceptingCover A word (cuts (i + 1) + 1)
        transportLength
        ((frontierLive i).1.label (frontierNode i))
        ((lives transportLength).1.label (frontierNode i)) :=
    hparentCoverBuilder recurrentName N cuts frontierLive frontierNode
      hmin hstable hzero hstrict hevents hrunFrontier hactiveFrontier
      hnameFrontier hnonempty hreachable i lives hrunTransport
  constructor
  · intro htrigger child hchild hnotFresh _hgt
    have hchildLive :
        child ∈ (lives transportLength).1.children A (frontierNode i) :=
      live_green_stage2Trigger_old_child_of_stage3_child_not_fresh
        A word (lives transportLength) htrigger hchild hnotFresh
    exact
      live_child_label_cover_from_parent_cover A word
        (lives transportLength) hchildLive hparentCover
  · intro hnotTrigger child hchild _hgt
    have hchildLive :
        child ∈ (lives transportLength).1.children A (frontierNode i) :=
      live_green_nontrigger_child_of_stage3_child
        A word (lives transportLength) hnotTrigger hchild
    exact
      live_child_label_cover_from_parent_cover A word
        (lives transportLength) hchildLive hparentCover

/--
When the NBW accepts, the DPW run never reaches the rejecting sink: the sink is
absorbing, while acceptance forces a live state with an accepting root label
infinitely often, so the run is `some` at every position.
-/
theorem automaton_run_some_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) (n : Nat) :
    ∃ live : LiveState A, (automaton A).run word n = some live := by
  cases hcase : (automaton A).run word n with
  | some live => exact ⟨live, rfl⟩
  | none =>
      exfalso
      rcases automaton_run_frequently_accepting_root_label_of_accepts A haccepts n
        with ⟨k, hk, live, hrun, _⟩
      have h := DetParityAutomaton.runFrom_drop (automaton A)
        (automaton A).initial word n (k - n)
      rw [Nat.add_sub_of_le hk] at h
      have hrel :
          (automaton A).run word k =
            (automaton A).runFrom ((automaton A).run word n)
              (OmegaWord.drop word n) (k - n) :=
        h.symm
      rw [hcase, automaton_runFrom_sink A (OmegaWord.drop word n) (k - n)] at hrel
      rw [hrel] at hrun
      simp at hrun

/--
Fixed accepting visits inside a child of `v` form the paper's accepting
child-union branch for `v`.  The event is stated at successor time `t`; the
coverage-branch theorem is stated for the transition from `t-1` to `t`, so the
proof only shifts the recurrent times back one step and uses live-run totality
from the accepting NBW witness.
-/
theorem acceptingChildCoverageChildNameStateAt_to_coverage_branch
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v child : Node A} {a childName : Nat} {target : A.State}
    (hfreq :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingChildCoverageChildNameStateAt A run v child a childName
          target t) :
    ∀ n : Nat, ∃ k live next,
      n ≤ k ∧
        (automaton A).run word k = some live ∧
        (automaton A).run word (k + 1) = some next ∧
        A.accepting (run.path (k + 1)) ∧
        run.path (k + 1) ∈ next.1.childLabelUnion A v := by
  intro n
  rcases hfreq (n + 1) with
    ⟨t, hnt, next, hrunNext, htargetEq, haccepting, hchild, htargetMem,
      _hname, _hgt⟩
  let k := t - 1
  have hkSucc : k + 1 = t := by
    dsimp [k]
    omega
  have hnk : n ≤ k := by
    dsimp [k]
    omega
  rcases automaton_run_some_of_accepts A ⟨run, hrunAccepts⟩ k with
    ⟨live, hrunLive⟩
  have hcover :
      run.path (k + 1) ∈ next.1.childLabelUnion A v := by
    rw [childLabelUnion, Finset.mem_biUnion]
    refine ⟨child, hchild, ?_⟩
    simpa [hkSucc, htargetEq] using htargetMem
  exact ⟨k, live, next, hnk, hrunLive, by simpa [hkSucc] using hrunNext,
    by simpa [hkSucc, htargetEq] using haccepting, hcover⟩

/--
Paper-facing son-descent lemma.  Once a source node is settled and does not
green, recurrent accepting visits in one fixed child/name force the accepting
run to settle at some strictly larger name.  This is the formal version of the
paper step "the run eventually belongs to a son".
-/
theorem runSettles_acceptingChildCoverageChildNameStateAt_to_runSettlesAtName
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v child : Node A} {a childName : Nat} {target : A.State}
    (hsettle : RunSettlesAt A run v a)
    (hng : ¬ RunNodeGreensIO A run v)
    (hfreq :
      ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
        AcceptingChildCoverageChildNameStateAt A run v child a childName
          target t) :
    ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a' :=
  runSettles_coverage_branch_to_runSettlesAtName A run hsettle hng
    (acceptingChildCoverageChildNameStateAt_to_coverage_branch
      A run hrunAccepts hfreq)

/--
Equality branch of the lower-source kernel, in the paper's son-descent shape.
If the fixed lower source has already stabilized at its lower name and is not
green, then cofinally returning to the same successor child/name is not an open
acceptance handler: it forces descent to a strictly larger settled name.
-/
theorem runSettles_fixedNameNextNameEq_to_runSettlesAtName_of_source
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v sourceNode child : Node A}
    {a sourceName childName : Nat} {sourceState target uncovered : A.State}
    (hsourceSettle : RunSettlesAt A run sourceNode sourceName)
    (hsourceNotGreen : ¬ RunNodeGreensIO A run sourceNode)
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameEqEvent
          A run v sourceNode child a sourceName childName sourceState target
          uncovered k) :
    ∃ a' : Nat, sourceName < a' ∧ RunSettlesAtName A run a' :=
  runSettles_acceptingChildCoverageChildNameStateAt_to_runSettlesAtName
    A run hrunAccepts hsourceSettle hsourceNotGreen
    (frequently_settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextNameEq_to_acceptingChildCoverageChildNameStateAt
      A run hfreq)

/--
Same-source-name survival in the lower-source kernel is the same paper descent
case without first fixing the successor child name.  Once the lower source is
settled and non-green, the cofinal equal-name source-survival events give a
cofinal child-coverage branch for that source, hence force settlement at a
strictly larger name.
-/
theorem runSettles_sourceNameEq_to_runSettlesAtName_of_source
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    {v sourceNode child : Node A}
    {a sourceName : Nat} {sourceState target uncovered : A.State}
    (hsourceSettle : RunSettlesAt A run sourceNode sourceName)
    (hsourceNotGreen : ¬ RunNodeGreensIO A run sourceNode)
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceNameEqEvent
          A run v sourceNode child sourceName sourceState target uncovered k) :
    ∃ a' : Nat, sourceName < a' ∧ RunSettlesAtName A run a' :=
  runSettles_coverage_branch_to_runSettlesAtName A run hsourceSettle
    hsourceNotGreen
    (frequently_sourceNameEq_to_source_childCoverage_branch A run hfreq)

/--
Settling rules out recurring odd priorities below the settled name.  Once the
run has settled at name `a`, every sufficiently late successor has `e > a`.
Thus a late non-green/delete priority below `2*a` is impossible; any recurring
priority below `2*a` must be an even `f`-priority.
-/
theorem runSettles_prioritySeen_lt_two_mul_settled_name_even
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a p : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hpSeen : (automaton A).PrioritySeenInfinitelyOften word p)
    (hpLt : p < 2 * a) :
    DetParityAutomaton.NatEven p := by
  rcases runSettles_eventually_next_e_gt_settled_name A run hsettle with
    ⟨N, heStableNext⟩
  rcases hpSeen (N + 1) with ⟨k, hk, hkprio⟩
  rcases automaton_run_some_of_accepts A ⟨run, hrunAccepts⟩ k with
    ⟨live, hrun⟩
  by_cases hfe : live.1.f.val < live.1.e.val
  · have hpEq : p = 2 * live.1.f.val := by
      have hprioLive : priority A live.1 = p := by
        simpa [hrun, automaton_priority_live] using hkprio
      rw [← hprioLive]
      simp [priority, hfe]
    exact ⟨live.1.f.val, hpEq⟩
  · have hkpos : 0 < k := by omega
    let j := k - 1
    have hjEq : j + 1 = k := by omega
    have hNj : N ≤ j := by omega
    rcases automaton_run_some_of_accepts A ⟨run, hrunAccepts⟩ j with
      ⟨prev, hprev⟩
    have heGt : a < live.1.e.val :=
      heStableNext j hNj prev live hprev (by simpa [hjEq] using hrun)
    cases he : live.1.e.val with
    | zero =>
        omega
    | succ pred =>
        have hnotLe : ¬ live.1.f.val ≤ pred := by
          intro hle
          exact hfe (by simpa [he] using Nat.lt_succ_of_le hle)
        have hpEq : p = 2 * pred + 1 := by
          have hprioLive : priority A live.1 = p := by
            simpa [hrun, automaton_priority_live] using hkprio
          rw [← hprioLive]
          simp [priority, hfe, he, hnotLe]
        omega

/--
The green horn is closed: if an accepting NBW run settles at node `v` with name
`a` and `v` greens infinitely often, then the DPW accepts.  The proof uses the
settled-green recurrent even priority to bound the minimum recurring priority by
`≤ 2*a`; settling excludes recurring odd priorities below `2*a`.
-/
theorem automaton_accepts_of_accepting_runNodeGreensIO
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hgreens : RunNodeGreensIO A run v) :
    (automaton A).Accepts word := by
  rcases runNodeGreensIO_even_prioritySeen_le_settled_name
      A run hsettle hgreens with
    ⟨m, hmLe, hmSeen⟩
  obtain ⟨p, hpSeen, hpMin⟩ :=
    DetParityAutomaton.exists_min_prioritySeenInfinitelyOften (automaton A) word
  have hpLeEven : p ≤ 2 * m := hpMin (2 * m) hmSeen
  have hpLeSettled : p ≤ 2 * a := by
    omega
  have hpEven : DetParityAutomaton.NatEven p := by
    rcases Nat.lt_or_eq_of_le hpLeSettled with hpLt | hpEq
    · exact runSettles_prioritySeen_lt_two_mul_settled_name_even
        A run hrunAccepts hsettle hpSeen hpLt
    · subst p
      exact ⟨a, rfl⟩
  exact (DetParityAutomaton.accepts_iff_natEven_of_min (automaton A) word
    hpSeen hpMin).mpr hpEven

/--
Forward direction of Piterman determinization for nondeterministic Buchi
automata.  This is the paper-facing proof-4 assembly: green settled nodes accept
by the closed green horn, and non-green settled nodes descend to a larger stable
name by the closed son-entry horn.
-/
theorem automaton_accepts_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    (automaton A).Accepts word :=
  automaton_accepts_of_accepts_of_descentHorns A haccepts
    (fun run hrunAccepts _v _a hsettle hgreens =>
      automaton_accepts_of_accepting_runNodeGreensIO
        A run hrunAccepts hsettle hgreens)
    (fun run hrunAccepts _v _a hsettle hng =>
      runSettles_descendHorn A run hrunAccepts hsettle hng)

/--
Unconditional Piterman compiler for nondeterministic Buchi automata.
-/
noncomputable def toDPACompilation
    [DecidableEq A.State] :
    NondetBuchiToDPACompilation A :=
  toDPACompilationOfCompleteness A
    (fun word haccepts => automaton_accepts_of_accepts A haccepts)

/--
Uniform Piterman compiler for nondeterministic Buchi automata over a fixed
alphabet.
-/
noncomputable def toDPACompiler (Alphabet : Type u) :
    NondetBuchiToDPACompiler.{u, v, v} Alphabet where
  compile := fun A => by
    classical
    exact toDPACompilation A

/--
Ancestor-green variant of the green-horn event extraction.  The greening node
does not have to be the settled node itself: it is enough that, infinitely often,
some green node in the stage-(3) tree is an ancestor-or-self of the settled node
`v`.  The green node's name is then bounded by the settled name `a`, while
settling of `v` supplies the usual `e > a` deletion bound one step later.
-/
theorem runGreenAncestorIO_frequently_f_lt_e_le_settled_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hgreenAncestor :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        ∃ live green,
          (automaton A).run word k = some live ∧
            green ∈ (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A ∧
            (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).stage3 A).IsAncestorOrSelf A
              green v) :
    ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      ∃ live : LiveState A,
        (automaton A).run word k = some live ∧
          live.1.f.val ≤ a ∧ live.1.f.val < live.1.e.val := by
  classical
  rcases runSettles_eventually_next_e_gt_settled_name A run hsettle with
    ⟨Ne, heStableNext⟩
  rcases hsettle with ⟨Ns, hsettleAt⟩
  intro n
  rcases hgreenAncestor (max n (max Ns Ne)) with
    ⟨j, hj, live, green, hrun, hgreen, hancestor⟩
  have hnj : n ≤ j := le_trans (le_max_left n (max Ns Ne)) hj
  have hNsj : Ns ≤ j := by
    exact le_trans (le_trans (le_max_left Ns Ne) (le_max_right n (max Ns Ne))) hj
  have hNej : Ne ≤ j := by
    exact le_trans (le_trans (le_max_right Ns Ne) (le_max_right n (max Ns Ne))) hj
  rcases hsettleAt j hNsj with ⟨settledLive, hsettledRun, hmem, hname⟩
  have hliveEq : live = settledLive := by
    have hsome : some live = some settledLive := by
      rw [← hrun, hsettledRun]
    exact Option.some.inj hsome
  subst settledLive
  rcases hsettleAt (j + 1) (by omega) with
    ⟨next, hnext, _hmemNext, _hnameNext⟩
  have hactiveLive : live.1.active v = true :=
    active_of_mem_label A live.1 live.2 hmem
  have haBound : a < Fintype.card A.State := by
    rcases live.2 with
      ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
        _hinactiveLabel, hbound, _hinjective, _hconsecutive, _hproper,
        _hchildSubset, _hsiblingDisjoint⟩
    have hvBound := hbound v hactiveLive
    omega
  let t1 := live.1.stage1 A (word j)
  let plan := (livePlan A live (word j)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hactiveT1 : t1.active v = true := by
    simpa [t1, stage1_active A live.1 (word j) v] using hactiveLive
  have hactiveT2 : t2.active v = true := by
    simpa [t1, plan, t2] using
      stage2_preserves_active_node_active A t1 plan hactiveT1
  have hactiveT3 : t3.active v = true := by
    simpa [t2, t3, stage3_active A t2 v] using hactiveT2
  have hnameT1 : (t1.name v).val = a := by
    simpa [t1, stage1_name A live.1 (word j) v] using hname
  have hnameT2 : (t2.name v).val = a := by
    rw [show t2.name v = t1.name v from
      stage2_preserves_active_node_name A t1 plan hactiveT1]
    exact hnameT1
  have hnameT3 : (t3.name v).val = a := by
    rw [show t3.name v = t2.name v from stage3_name A t2 v]
    exact hnameT2
  rcases live.2 with
    ⟨hrootActive, _hrootName, hrootParent, hparentInvariant, _hinactiveLabel,
      _hbound, hinjective, _hconsecutive, _hproper, hchildSubset,
      _hsiblingDisjoint⟩
  obtain ⟨hwfRoot, hwfParent, _hwfChild, _hwfSibling⟩ :=
    stage1_stage2_stage3_invariants A live.1 (word j) plan
      hrootActive hrootParent hparentInvariant hchildSubset hinjective
  have hgreenNameLeA : (t3.name green).val ≤ a := by
    have hle :
        (t3.name green).val ≤ (t3.name v).val :=
      name_le_of_isAncestorOrSelf A t3 hwfRoot hwfParent hactiveT3
        (by simpa [t1, plan, t2, t3] using hancestor)
    omega
  have hgreenBound : (t3.name green).val < Fintype.card A.State := by
    omega
  have hfMin :
      next.1.f.val = (t3.minBoundedNameOf A (t3.greenNodes A)).val := by
    have hnextTree : next.1 = liveNextTree A live (word j) :=
      automaton_run_live_nextTree A word hrun hnext
    rw [hnextTree]
    simp [liveNextTree, transitionWithPlan, t1, plan, t2, t3,
      stage4_f_val, stage5_f_val, stage6_f_val]
  have hminLe :
      (t3.minBoundedNameOf A (t3.greenNodes A)).val ≤ (t3.name green).val :=
    minBoundedNameOf_le_of_mem A t3 (t3.greenNodes A)
      (by simpa [t1, plan, t2, t3] using hgreen)
      hgreenBound
  have hfLe : next.1.f.val ≤ a := by omega
  have heGt : a < next.1.e.val :=
    heStableNext j hNej live next hrun hnext
  have hfe : next.1.f.val < next.1.e.val := by omega
  exact ⟨j + 1, by omega, next, hnext, hfLe, hfe⟩

/--
Fixed even-priority extraction from recurrent green ancestors of a settled node.
-/
theorem runGreenAncestorIO_even_prioritySeen_le_settled_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hgreenAncestor :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        ∃ live green,
          (automaton A).run word k = some live ∧
            green ∈ (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A ∧
            (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).stage3 A).IsAncestorOrSelf A
              green v) :
    ∃ m : Nat, m ≤ a ∧
      (automaton A).PrioritySeenInfinitelyOften word (2 * m) := by
  classical
  have hfreq :=
    runGreenAncestorIO_frequently_f_lt_e_le_settled_name A run hsettle
      hgreenAncestor
  have hfreqFiber :
      ∃ᶠ k in Filter.atTop,
        ∃ m ∈ Finset.range (a + 1),
          ∃ live : LiveState A, (automaton A).run word k = some live ∧
            live.1.f.val = m ∧ live.1.f.val < live.1.e.val := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with ⟨k, hk, live, hrun, hfLe, hfe⟩
    refine ⟨k, hk, live.1.f.val, ?_, live, hrun, rfl, hfe⟩
    exact Finset.mem_range.mpr (by omega)
  rw [Finset.frequently_exists] at hfreqFiber
  rcases hfreqFiber with ⟨m, hmRange, hmFreq⟩
  have hmLe : m ≤ a := Nat.le_of_lt_succ (Finset.mem_range.mp hmRange)
  have hfreqFixed :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A, (automaton A).run word k = some live ∧
          live.1.f.val < live.1.e.val ∧ live.1.f.val = m := by
    intro n
    rcases (Filter.frequently_atTop).1 hmFreq n with
      ⟨k, hk, live, hrun, hfm, hfe⟩
    exact ⟨k, hk, live, hrun, hfe, hfm⟩
  refine ⟨m, hmLe, ?_⟩
  intro n
  rcases hfreqFixed n with ⟨k, hk, live, hrun, hfe, hfm⟩
  refine ⟨k, hk, ?_⟩
  rw [hrun, automaton_priority_live]
  unfold priority
  rw [if_pos hfe, hfm]

/--
Green horn for recurrent green ancestors of the settled node.  This is the form
needed by the lower-source child-union kernel: the source node need not itself be
proved settled, as long as its green occurrences are cofinally above the already
settled node.
-/
theorem automaton_accepts_of_accepting_greenAncestorIO
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hgreenAncestor :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        ∃ live green,
          (automaton A).run word k = some live ∧
            green ∈ (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A ∧
            (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).stage3 A).IsAncestorOrSelf A
              green v) :
    (automaton A).Accepts word := by
  rcases runGreenAncestorIO_even_prioritySeen_le_settled_name
      A run hsettle hgreenAncestor with
    ⟨m, hmLe, hmSeen⟩
  obtain ⟨p, hpSeen, hpMin⟩ :=
    DetParityAutomaton.exists_min_prioritySeenInfinitelyOften (automaton A) word
  have hpLeEven : p ≤ 2 * m := hpMin (2 * m) hmSeen
  have hpLeSettled : p ≤ 2 * a := by omega
  have hpEven : DetParityAutomaton.NatEven p := by
    rcases Nat.lt_or_eq_of_le hpLeSettled with hpLt | hpEq
    · exact runSettles_prioritySeen_lt_two_mul_settled_name_even
        A run hrunAccepts hsettle hpSeen hpLt
    · subst p
      exact ⟨a, rfl⟩
  exact (DetParityAutomaton.accepts_iff_natEven_of_min (automaton A) word
    hpSeen hpMin).mpr hpEven

/--
Child-union/green composition for the lower-source kernel.  If recurrent
stage-(3) child-union events at a fixed lower source also have that source green
at those same stage-(3) trees, then the DPW accepts.  The reason is kernel lemma
1: each sufficiently late child-union event puts the lower source above the
settled node `v`; hence those source greens are recurrent green ancestors of the
settled node, which is enough for the ancestor-green horn.
-/
theorem automaton_accepts_of_settled_childUnion_sourceNodeGreensIO
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v sourceNode : Node A} {a sourceName : Nat}
    {sourceState target : A.State}
    (hsettle : RunSettlesAt A run v a)
    (hsourceLt : sourceName ∈ Finset.range a)
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionEvent A run sourceNode sourceName
          sourceState target k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            sourceNode ∈ (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A) :
    (automaton A).Accepts word := by
  have hsettleFull := hsettle
  rcases hsettle with ⟨N, hsettleAt⟩
  refine automaton_accepts_of_accepting_greenAncestorIO A run hrunAccepts
    hsettleFull ?_
  intro n
  rcases hfreq (max n N) with
    ⟨k, hk, hevent, hgreenPayload⟩
  have hnk : n ≤ k := le_trans (le_max_left n N) hk
  have hNk : N ≤ k := le_trans (le_max_right n N) hk
  rcases hevent with ⟨hbase, liveCU, hrunCU, hchildUnion⟩
  rcases hbase with
    ⟨live, next, hrun, hrunNext, htarget, _haccepting, hsourceActive,
      _hsourceState, _hsegment, hsourceName⟩
  have hliveCUEq : liveCU = live := by
    have hsome : some liveCU = some live := by
      rw [← hrunCU, hrun]
    exact Option.some.inj hsome
  subst liveCU
  rcases hgreenPayload with ⟨liveGreen, hrunGreen, hgreen⟩
  have hliveGreenEq : liveGreen = live := by
    have hsome : some liveGreen = some live := by
      rw [← hrunGreen, hrun]
    exact Option.some.inj hsome
  subst liveGreen
  rcases hsettleAt k hNk with
    ⟨settledLive, hsettledRun, hmemV, hnameV⟩
  have hsettledLiveEq : settledLive = live := by
    have hsome : some settledLive = some live := by
      rw [← hsettledRun, hrun]
    exact Option.some.inj hsome
  subst settledLive
  rcases hsettleAt (k + 1) (by omega) with
    ⟨settledNext, hsettledNextRun, hmemNextV, _hnameNextV⟩
  have hsettledNextEq : settledNext = next := by
    have hsome : some settledNext = some next := by
      rw [← hsettledNextRun, hrunNext]
    exact Option.some.inj hsome
  subst settledNext
  have hvActive : live.1.active v = true :=
    active_of_mem_label A live.1 live.2 hmemV
  have hsourceLtNat : sourceName < a := Finset.mem_range.mp hsourceLt
  have hancestor :
      (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).IsAncestorOrSelf A
          sourceNode v :=
    stage3_sourceNode_isAncestorOrSelf_of_settled_childUnion
      A run hrun hrunNext htarget hsourceActive hsourceName hchildUnion
      hvActive hnameV hmemNextV hsourceLtNat
  exact ⟨k, hnk, live, sourceNode, hrun, hgreen, hancestor⟩

/--
Child-union/green composition for the lower-source kernel after following the
paper's son.  If recurrent child-union events can be focused to a fixed child and
that child is green cofinally in the same stage-(3) trees, then the DPW accepts:
the child is a stage-(3) ancestor of the settled node by
`stage3_child_isAncestorOrSelf_of_settled_childUnionChild`, so the ancestor-green
horn applies.
-/
theorem automaton_accepts_of_settled_childUnionChild_childGreensIO
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v sourceNode child : Node A} {a sourceName : Nat}
    {sourceState target : A.State}
    (hsettle : RunSettlesAt A run v a)
    (hsourceLt : sourceName ∈ Finset.range a)
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionChildEvent A run sourceNode child
          sourceName sourceState target k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            child ∈ (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A) :
    (automaton A).Accepts word := by
  have hsettleFull := hsettle
  rcases hsettle with ⟨N, hsettleAt⟩
  refine automaton_accepts_of_accepting_greenAncestorIO A run hrunAccepts
    hsettleFull ?_
  intro n
  rcases hfreq (max n N) with
    ⟨k, hk, hchildEvent, hgreenPayload⟩
  have hnk : n ≤ k := le_trans (le_max_left n N) hk
  have hNk : N ≤ k := le_trans (le_max_right n N) hk
  rcases hchildEvent with ⟨hchildUnionEvent, liveChild, hrunChild, hchildRaw⟩
  rcases hchildUnionEvent with ⟨hbase, liveCU, hrunCU, _hchildUnion⟩
  rcases hbase with
    ⟨live, next, hrun, hrunNext, htarget, _haccepting, hsourceActive,
      _hsourceState, _hsegment, hsourceName⟩
  have hliveCUEq : liveCU = live := by
    have hsome : some liveCU = some live := by
      rw [← hrunCU, hrun]
    exact Option.some.inj hsome
  subst liveCU
  have hliveChildEq : liveChild = live := by
    have hsome : some liveChild = some live := by
      rw [← hrunChild, hrun]
    exact Option.some.inj hsome
  subst liveChild
  rcases hgreenPayload with ⟨liveGreen, hrunGreen, hgreen⟩
  have hliveGreenEq : liveGreen = live := by
    have hsome : some liveGreen = some live := by
      rw [← hrunGreen, hrun]
    exact Option.some.inj hsome
  subst liveGreen
  rcases hsettleAt k hNk with
    ⟨settledLive, hsettledRun, hmemV, hnameV⟩
  have hsettledLiveEq : settledLive = live := by
    have hsome : some settledLive = some live := by
      rw [← hsettledRun, hrun]
    exact Option.some.inj hsome
  subst settledLive
  rcases hsettleAt (k + 1) (by omega) with
    ⟨settledNext, hsettledNextRun, hmemNextV, _hnameNextV⟩
  have hsettledNextEq : settledNext = next := by
    have hsome : some settledNext = some next := by
      rw [← hsettledNextRun, hrunNext]
    exact Option.some.inj hsome
  subst settledNext
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases hchildRaw with ⟨hchild, htargetChild⟩
  have hvActive : live.1.active v = true :=
    active_of_mem_label A live.1 live.2 hmemV
  have hsourceLtNat : sourceName < a := Finset.mem_range.mp hsourceLt
  have hancestor :
      t3.IsAncestorOrSelf A child v :=
    stage3_child_isAncestorOrSelf_of_settled_childUnionChild
      A run hrun hrunNext htarget hsourceActive hsourceName
      (by simpa [t1, plan, t2, t3] using hchild)
      (by simpa [t1, plan, t2, t3] using htargetChild)
      hvActive hnameV hmemNextV hsourceLtNat
  exact ⟨k, hnk, live, child, hrun,
    by simpa [t1, plan, t2, t3] using hgreen, hancestor⟩

/--
Event-wrapper form of the fixed-child green horn.
-/
theorem automaton_accepts_of_settled_childUnionChild_greenEventIO
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v sourceNode child : Node A} {a sourceName : Nat}
    {sourceState target : A.State}
    (hsettle : RunSettlesAt A run v a)
