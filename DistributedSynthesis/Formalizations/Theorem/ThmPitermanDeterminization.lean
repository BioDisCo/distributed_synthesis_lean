theorem live_stage3_proper_descendant_label_cover_from_child_covers
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {startTime length n : Nat} {sources : Finset A.State}
    (live : LiveState A)
    {ancestor descendant : Node A}
    (hdescendantActive :
      (((live.1.stage1 A (word n)).stage2 A
        (livePlan A live (word n)).stage2Plan).stage3 A).active
          descendant = true)
    (hancestor :
      (((live.1.stage1 A (word n)).stage2 A
        (livePlan A live (word n)).stage2Plan).stage3 A).IsAncestorOrSelf A
          ancestor descendant)
    (hne : ancestor ≠ descendant)
    (hchildCover :
      ∀ child,
        child ∈
          (((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).children A
              ancestor ->
        SegmentVisitsAcceptingCover A word startTime length sources
          ((((live.1.stage1 A (word n)).stage2 A
            (livePlan A live (word n)).stage2Plan).stage3 A).label child)) :
    SegmentVisitsAcceptingCover A word startTime length sources
      ((((live.1.stage1 A (word n)).stage2 A
        (livePlan A live (word n)).stage2Plan).stage3 A).label
          descendant) := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases live.2 with
    ⟨hrootActive, _hrootName, hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      hchildSubset, _hsiblingDisjoint⟩
  have hrootActive_t1 : t1.active (root A) = true := by
    simpa [t1, stage1_active A live.1 (word n) (root A)] using
      hrootActive
  have ht1RootParent : t1.parent (root A) = root A := by
    simpa [t1, stage1_parent A live.1 (word n) (root A)] using
      hrootParent
  have ht1ParentInvariant :
      ∀ node, t1.active node = true -> node ≠ root A ->
        t1.active (t1.parent node) = true ∧
          (t1.name (t1.parent node)).val < (t1.name node).val := by
    simpa [t1] using
      (stage1_preserves_parent_active_and_name_lt A live.1 (word n)
        hparentInvariant)
  have ht1ChildSubset :
      ∀ node child, child ∈ t1.children A node ->
        t1.label child ⊆ t1.label node := by
    simpa [t1] using
      (stage1_preserves_child_label_subset A live.1 (word n)
        hchildSubset)
  have ht2RootParent : t2.parent (root A) = root A := by
    simpa [t1, t2] using
      (stage2_root_parent A t1 plan hrootActive_t1).trans ht1RootParent
  have ht3RootParent : t3.parent (root A) = root A := by
    simpa [t3, stage3_parent A t2 (root A)] using ht2RootParent
  have ht3ParentInvariant :
      ∀ node, t3.active node = true -> node ≠ root A ->
        t3.active (t3.parent node) = true ∧
          (t3.name (t3.parent node)).val < (t3.name node).val := by
    simpa [t1, plan, t2, t3] using
      (stage2_stage3_preserves_parent_active_and_name_lt A t1 plan
        ht1ParentInvariant)
  have ht3ChildSubset :
      ∀ node child, child ∈ t3.children A node ->
        t3.label child ⊆ t3.label node := by
    simpa [t1, plan, t2, t3] using
      (stage2_stage3_preserves_child_label_subset A t1 plan
        ht1ParentInvariant ht1ChildSubset)
  rcases exists_child_of_isAncestorOrSelf_ne A t3 ht3RootParent
      ht3ParentInvariant
      (by simpa [t1, plan, t2, t3] using hdescendantActive)
      (by simpa [t1, plan, t2, t3] using hancestor)
      (by simpa using hne) with
    ⟨child, hchild, hchildAncestor⟩
  have hdescendantSubset :
      t3.label descendant ⊆ t3.label child :=
    label_subset_of_isAncestorOrSelf A t3 ht3RootParent
      ht3ParentInvariant ht3ChildSubset
      (by simpa [t1, plan, t2, t3] using hdescendantActive)
      hchildAncestor
  exact segmentVisitsAcceptingCover_mono_targets A word
    (hchildCover child (by simpa [t1, plan, t2, t3] using hchild))
    (by simpa [t1, plan, t2, t3] using hdescendantSubset)

theorem live_stage3_name_lt_of_proper_descendant
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} (live : LiveState A)
    {ancestor descendant : Node A}
    (hdescendantActive :
      (((live.1.stage1 A (word n)).stage2 A
