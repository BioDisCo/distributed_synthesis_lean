  · rcases hpositiveWitness with ⟨uncovered, hfreqWitness⟩
    exact False.elim
      (positiveWitnessContradiction run hrunAccepts v a hsettle hng
        ⟨m, sourceNode, sourceState, target, uncovered, hmMem,
          hfreqChildUnion, hnoLeak, hfreqWitness⟩)

