    exists_strict_cuts_from_zero_of_frequently_at_or_after hfreq⟩

theorem automaton_run_frontier_stage2Trigger_of_next_accepting
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    {k : Nat} {live : LiveState A} {frontier : Node A}
    (hfrontierActive : live.1.active frontier = true)
    (hfrontierState : run.path k ∈ live.1.label frontier)
    (hnextAccepting : A.accepting (run.path (k + 1))) :
    frontier ∈ (live.1.stage1 A (word k)).stage2Triggers A := by
  have hfrontierActiveStage1 :
      (live.1.stage1 A (word k)).active frontier = true := by
    simpa [stage1_active A live.1 (word k) frontier] using hfrontierActive
  have hnextState :
      run.path (k + 1) ∈
        (live.1.stage1 A (word k)).label frontier :=
    (mem_stage1_label A live.1 (word k)).mpr
      ⟨run.path k, hfrontierState, run.step_valid k⟩
  exact mem_stage2Triggers_of_accepting_label A
    (live.1.stage1 A (word k)) hfrontierActiveStage1 hnextState
    hnextAccepting

