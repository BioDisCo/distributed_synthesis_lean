    simpa [t1, plan] using
      (stage2_stage3_green_freshChild_label_subset_parent A t1 plan
        hrootActiveT1 hparent hgreen)
  have hwitness :=
    automaton_run_live_stage3_freshChild_accepting_reachable A word hrun
      hparent hstate
  exact ⟨hsubset hstate, hwitness.1, hwitness.2⟩

