          uncovered k) :
    ∃ smallerName : Nat,
      smallerName ∈ Finset.range sourceName ∧
        ∀ n : Nat, ∃ t : Nat, n ≤ t ∧
          AcceptingNodeNameAt A run sourceNode smallerName t := by
  classical
  have hfreqFilter :
      ∃ᶠ t in Filter.atTop,
        ∃ smallerName ∈ Finset.range sourceName,
          AcceptingNodeNameAt A run sourceNode smallerName t := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with ⟨k, hnk, hevent⟩
    rcases
        settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorFixedNameNextSourceNameLtEvent_to_acceptingNodeNameAt
