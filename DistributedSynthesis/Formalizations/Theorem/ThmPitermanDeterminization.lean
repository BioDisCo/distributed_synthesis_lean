theorem acceptingTransitionFrontierNameEvent_freshChild_target
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {frontierName k : Nat}
    (hevent :
      AcceptingTransitionFrontierNameEvent A word frontierName k) :
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        ∃ frontier source target,
          live.1.active frontier = true ∧
            (live.1.name frontier).val = frontierName ∧
            source ∈ live.1.label frontier ∧
            source ∉ live.1.childLabelUnion A frontier ∧
            A.step source (word k) target ∧
            A.accepting target ∧
            let t1 := live.1.stage1 A (word k)
            let plan := (livePlan A live (word k)).stage2Plan
            target ∈ (t1.stage2 A plan).label (plan.freshChild frontier) ∧
              (t1.stage2 A plan).active (plan.freshChild frontier) = true ∧
                frontierName <
                  ((t1.stage2 A plan).name (plan.freshChild frontier)).val := by
  rcases acceptingTransitionFrontierNameEvent_witness A hevent with
    ⟨live, hrun, frontier, source, target, hfrontierActive,
      hfrontierName, hsource, hprivate, hstep, htargetAccepting,
      htargetStage1, htrigger⟩
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  have htargetFresh :
      target ∈ (t1.stage2 A plan).label (plan.freshChild frontier) := by
    rw [stage2_freshChild_label A t1 plan (by simpa [t1] using htrigger)]
    rw [mem_acceptingPart A t1]
    exact ⟨by simpa [t1] using htargetStage1, htargetAccepting⟩
  have hfreshActive :
      (t1.stage2 A plan).active (plan.freshChild frontier) = true :=
    stage2_freshChild_active A t1 plan (by simpa [t1] using htrigger)
  have hfrontierActiveStage1 : t1.active frontier = true := by
    simpa [t1, stage1_active A live.1 (word k) frontier] using
      hfrontierActive
  have hnameLt :
      frontierName <
        ((t1.stage2 A plan).name (plan.freshChild frontier)).val := by
    rw [stage2_freshChild_name A t1 plan (by simpa [t1] using htrigger)]
    have hfreshGt :=
      stage2_fresh_name_gt_active_name A t1 plan
        (by simpa [t1] using htrigger) hfrontierActiveStage1
    have hfrontierNameStage1 :
        (t1.name frontier).val = frontierName := by
      simpa [t1, stage1] using hfrontierName
    omega
  exact ⟨live, hrun, frontier, source, target, hfrontierActive,
    hfrontierName, hsource, hprivate, hstep, htargetAccepting,
    htargetFresh, hfreshActive, hnameLt⟩

theorem acceptingTransitionFrontierNameEvent_stage3_survives_or_routes
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {frontierName k : Nat}
    (hevent :
      AcceptingTransitionFrontierNameEvent A word frontierName k) :
    ∃ live : LiveState A,
      (automaton A).run word k = some live ∧
        ∃ frontier source target,
          live.1.active frontier = true ∧
            (live.1.name frontier).val = frontierName ∧
            source ∈ live.1.label frontier ∧
            source ∉ live.1.childLabelUnion A frontier ∧
            A.step source (word k) target ∧
            A.accepting target ∧
            let t1 := live.1.stage1 A (word k)
            let plan := (livePlan A live (word k)).stage2Plan
            let t2 := t1.stage2 A plan
            target ∈ t2.label (plan.freshChild frontier) ∧
              (target ∈ (t2.stage3 A).label (plan.freshChild frontier) ∨
                ∃ ancestor older,
                  t2.IsAncestorOrSelf A ancestor
                      (plan.freshChild frontier) ∧
                    t2.OlderSibling A older ancestor ∧
                      target ∈ t2.label older) := by
  rcases acceptingTransitionFrontierNameEvent_witness A hevent with
    ⟨live, hrun, frontier, source, target, hfrontierActive,
      hfrontierName, hsource, hprivate, hstep, htargetAccepting,
      htargetStage1, htrigger⟩
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have htargetFresh :
      target ∈ t2.label (plan.freshChild frontier) := by
    simp only [t2]
    rw [stage2_freshChild_label A t1 plan (by simpa [t1] using htrigger)]
    rw [mem_acceptingPart A t1]
    exact ⟨by simpa [t1] using htargetStage1, htargetAccepting⟩
  by_cases hsurvives :
      target ∈ t3.label (plan.freshChild frontier)
  · exact ⟨live, hrun, frontier, source, target, hfrontierActive,
      hfrontierName, hsource, hprivate, hstep, htargetAccepting,
      htargetFresh, Or.inl (by simpa [t2, t3] using hsurvives)⟩
  · rcases stage2_stage3_removed_freshChild_blocked_by_older
      A t1 plan (by simpa [t1] using htrigger)
      (by simpa [t2] using htargetFresh)
      (by simpa [t2, t3] using hsurvives) with
      ⟨ancestor, older, hancestor, holder, holderState, _haccepting⟩
    exact ⟨live, hrun, frontier, source, target, hfrontierActive,
      hfrontierName, hsource, hprivate, hstep, htargetAccepting,
      htargetFresh, Or.inr ⟨ancestor, older,
        by simpa [t2] using hancestor,
        by simpa [t2] using holder,
        by simpa [t2] using holderState⟩⟩

