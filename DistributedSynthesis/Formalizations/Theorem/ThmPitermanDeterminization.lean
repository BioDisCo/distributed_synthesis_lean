theorem automaton_accepts_frequently_transition_green_same_name
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    (haccepts : (automaton A).Accepts word) :
    ∃ recurrentName : Name A,
      ∀ n : Nat,
        ∃ k : Nat, n ≤ k ∧
          ∃ prev next : LiveState A,
            (automaton A).run word k = some prev ∧
            (automaton A).run word (k + 1) = some next ∧
            next.1.f = recurrentName ∧
            ∃ green,
              green ∈
                (((prev.1.stage1 A (word k)).stage2 A
                    (livePlan A prev (word k)).stage2Plan).stage3 A).greenNodes A ∧
              ((((prev.1.stage1 A (word k)).stage2 A
                    (livePlan A prev (word k)).stage2Plan).stage3 A).name
                  green).val =
                recurrentName.val ∧
              recurrentName.val < next.1.e.val ∧
              (((prev.1.stage1 A (word k)).stage2 A
                  (livePlan A prev (word k)).stage2Plan).stage3 A).label green ≠
                ∅ := by
  classical
  let EventWithName : Name A -> Nat -> Prop := fun name k =>
    ∃ prev next : LiveState A,
      (automaton A).run word k = some prev ∧
      (automaton A).run word (k + 1) = some next ∧
      next.1.f = name ∧
      ∃ green,
        green ∈
          (((prev.1.stage1 A (word k)).stage2 A
              (livePlan A prev (word k)).stage2Plan).stage3 A).greenNodes A ∧
        ((((prev.1.stage1 A (word k)).stage2 A
              (livePlan A prev (word k)).stage2Plan).stage3 A).name
            green).val =
          name.val ∧
        name.val < next.1.e.val ∧
        (((prev.1.stage1 A (word k)).stage2 A
            (livePlan A prev (word k)).stage2Plan).stage3 A).label green ≠ ∅
  have hfreq :
      ∃ᶠ k in Filter.atTop, ∃ name ∈ (Finset.univ : Finset (Name A)),
        EventWithName name k := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases automaton_accepts_frequently_transition_green A word haccepts n with
      ⟨k, hk, prev, next, hprev, hnext, green, hgreen, hgreenName,
        hfe, hgreenNonempty⟩
    refine ⟨k, hk, next.1.f, Finset.mem_univ _, ?_⟩
    refine ⟨prev, next, hprev, hnext, rfl, green, hgreen, ?_, hfe,
      hgreenNonempty⟩
    exact hgreenName
  rw [Finset.frequently_exists] at hfreq
  rcases hfreq with ⟨name, _hnameUniv, hnameFreq⟩
  refine ⟨name, ?_⟩
  intro n
  rcases (Filter.frequently_atTop).1 hnameFreq n with
    ⟨k, hk, hevent⟩
  exact ⟨k, hk, hevent⟩

theorem initial_root_label_reachable [DecidableEq A.State]
    (word : OmegaWord Alphabet) {state : A.State}
    (hstate : state ∈ (initial A).label (root A)) :
    ReachableAfter A A.initial word 0 state := by
  simpa [ReachableAfter, initial] using hstate

theorem reachableAfter_of_mem_liveNextTree_root_label
    [DecidableEq A.State]
    (live : LiveState A) (word : OmegaWord Alphabet)
    {n : Nat} {state : A.State}
    (hreachable :
      ∀ q, q ∈ live.1.label (root A) ->
        ReachableAfter A A.initial word n q)
    (hstate :
      state ∈ (liveNextTree A live (word n)).label (root A)) :
    ReachableAfter A A.initial word (n + 1) state := by
  have hstepImage :
      state ∈ stepImage A (word n) (live.1.label (root A)) :=
    liveNextTree_root_label_subset_stepImage A live (word n) hstate
  rcases (mem_stepImage A).mp hstepImage with
    ⟨prev, hprevMem, hstep⟩
  exact ⟨prev, hreachable prev hprevMem, hstep⟩

theorem automaton_run_live_root_label_reachable [DecidableEq A.State]
    (word : OmegaWord Alphabet) :
    ∀ n : Nat, ∀ live : LiveState A,
      (automaton A).run word n = some live ->
        ∀ state, state ∈ live.1.label (root A) ->
          ReachableAfter A A.initial word n state := by
  intro n
  induction n with
  | zero =>
      intro live hrun state hstate
      have hsome :
          some ⟨initial A, initial_wellFormed A⟩ = some live := by
        change (automaton A).run word 0 = some live
        exact hrun
      injection hsome with hlive'
      have hlive :
          live = ⟨initial A, initial_wellFormed A⟩ := hlive'.symm
      subst live
      exact initial_root_label_reachable A word hstate
  | succ n ih =>
      intro live hrun state hstate
      let prevState := (automaton A).run word n
      have hstep :
          (automaton A).step prevState (word n) = some live := by
        simpa [prevState, DetParityAutomaton.run] using hrun
      cases hprev : prevState with
      | none =>
          rw [hprev] at hstep
          simp at hstep
      | some prevLive =>
          rw [hprev] at hstep
          by_cases hrootLabel : liveRootLabelNonempty A prevLive (word n)
          · have hsome :
                some
                  ⟨liveNextTree A prevLive (word n),
                    liveNextTree_wellFormed_of_rootLabelNonempty A
                      prevLive (word n) hrootLabel⟩ = some live := by
              rw [← automaton_step_live_eq_some_of_rootLabel_nonempty A
                prevLive (word n) hrootLabel]
              exact hstep
            injection hsome with hlive'
            have hlive :
                live =
                  ⟨liveNextTree A prevLive (word n),
                    liveNextTree_wellFormed_of_rootLabelNonempty A
                      prevLive (word n) hrootLabel⟩ := hlive'.symm
            subst live
            apply reachableAfter_of_mem_liveNextTree_root_label A prevLive word
            · intro q hq
              exact ih prevLive hprev q hq
            · exact hstate
          · have hnone :
                (automaton A).step (some prevLive) (word n) = none :=
              automaton_step_live_eq_none_of_rootLabel_empty A prevLive
                (word n) hrootLabel
            rw [hnone] at hstep
            simp at hstep

theorem automaton_run_exists_live_root_label_of_runFrom
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) :
    ∀ n : Nat,
      ∃ live : LiveState A,
        (automaton A).run word n = some live ∧
          run.path n ∈ live.1.label (root A) := by
  intro n
  induction n with
  | zero =>
      refine ⟨⟨initial A, initial_wellFormed A⟩, rfl, ?_⟩
      simp [run.initial_state]
  | succ n ih =>
      rcases ih with ⟨prevLive, hrunPrev, hpathPrev⟩
      have hstepImage :
          run.path (n + 1) ∈
            stepImage A (word n) (prevLive.1.label (root A)) :=
        (mem_stepImage A).mpr
          ⟨run.path n, hpathPrev, run.step_valid n⟩
      have hstage4 :
          run.path (n + 1) ∈
            liveStage4RootLabel A prevLive (word n) :=
        stepImage_subset_liveStage4RootLabel A prevLive (word n) hstepImage
      have hrootLabel : liveRootLabelNonempty A prevLive (word n) :=
        Finset.ne_empty_of_mem hstage4
      let nextLive : LiveState A :=
        ⟨liveNextTree A prevLive (word n),
          liveNextTree_wellFormed_of_rootLabelNonempty A prevLive (word n)
            hrootLabel⟩
      refine ⟨nextLive, ?_, ?_⟩
      · rw [DetParityAutomaton.run_succ, hrunPrev]
        exact automaton_step_live_eq_some_of_rootLabel_nonempty
          A prevLive (word n) hrootLabel
      · exact
          stepImage_subset_liveNextTree_root_label A prevLive (word n)
            hstepImage

/--
First trapping step: across a transition, stage (1) applies the NBW transition
to every node's label, so the run state stays in the *same node's* stage-(1)
label.  This is the entry point of the per-step node tracking for the descent
(paper proof 4); subsequent stages may move it to a son or an older sibling.
-/
theorem run_path_succ_mem_stage1_label
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (tree : CompactTreeData A) {k : Nat} {v : Node A}
    (hmem : run.path k ∈ tree.label v) :
    run.path (k + 1) ∈ (tree.stage1 A (word k)).label v :=
  (mem_stage1_label A tree (word k)).mpr ⟨run.path k, hmem, run.step_valid k⟩

/--
Second trapping step: stage (2) only spawns fresh children, leaving an existing
active node's label unchanged, so the run state stays in `v`'s stage-(2) label.
-/
theorem run_path_succ_mem_stage2_label
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (tree : CompactTreeData A) {k : Nat}
    (plan : Stage2Plan A (tree.stage1 A (word k)))
    {v : Node A}
    (hactive : (tree.stage1 A (word k)).active v = true)
    (hmem : run.path k ∈ tree.label v) :
    run.path (k + 1) ∈ ((tree.stage1 A (word k)).stage2 A plan).label v := by
  rw [stage2_preserves_active_node_label A (tree.stage1 A (word k)) plan hactive]
  exact run_path_succ_mem_stage1_label A run tree hmem

/--
Third trapping step (stage (3) dichotomy): after stage (3) the run state either
stays in `v`'s label, or it is blocked by an older sibling -- i.e. it survives
only in an older sibling of an ancestor of `v`, a strictly smaller name.  This is
the sideways/routed move of the descent.
-/
theorem run_path_succ_stage3_dichotomy
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (tree : CompactTreeData A) {k : Nat}
    (plan : Stage2Plan A (tree.stage1 A (word k)))
    {v : Node A}
    (hactive : (tree.stage1 A (word k)).active v = true)
    (hmem : run.path k ∈ tree.label v) :
    run.path (k + 1) ∈
        (((tree.stage1 A (word k)).stage2 A plan).stage3 A).label v ∨
      ((tree.stage1 A (word k)).stage2 A plan).BlockedByOlderSibling A v
        (run.path (k + 1)) := by
  classical
  have h2 := run_path_succ_mem_stage2_label A run tree plan hactive hmem
  by_cases hblk :
      ((tree.stage1 A (word k)).stage2 A plan).BlockedByOlderSibling A v
        (run.path (k + 1))
  · exact Or.inr hblk
  · exact Or.inl
      ((mem_stage3_label A ((tree.stage1 A (word k)).stage2 A plan)).mpr
        ⟨h2, hblk⟩)

/--
Fourth trapping step (stage (4) dichotomy): stage (4) removes the descendants of
green nodes, so a state in `v`'s label either stays in `v` or `v` was removed by
a green ancestor (`RemovedByGreen`) -- the green/escape route by which the run
leaves `v` upward.
-/
theorem mem_stage4_label_or_removedByGreen
    [DecidableEq A.State]
    (t3 : CompactTreeData A) {v : Node A} {state : A.State}
    (hmem : state ∈ t3.label v) :
    state ∈ (t3.stage4 A).label v ∨ t3.RemovedByGreen A v := by
  classical
  by_cases hrem : t3.RemovedByGreen A v
  · exact Or.inr hrem
  · exact Or.inl (by rw [stage4_keeps_unremoved_label A t3 hrem]; exact hmem)

/--
One-step trapping (composition of stages (1)-(6), paper proof 4): from an
accepting run with the run state in active node `v`'s label, after the transition
exactly one of three things happens -- the run state stays in `v`'s next label,
or it is pulled to an older sibling of an ancestor of `v` (smaller name), or `v`
is removed because an ancestor greened.  Stages (1),(2),(5),(6) preserve `v`'s
label (stage (6) only renames, stage (5) cannot drop the nonempty `v`); stage (3)
and stage (4) supply the two escape routes.
-/
theorem run_path_succ_trapping
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (live : LiveState A) {k : Nat} {v : Node A}
    (hactive : (live.1.stage1 A (word k)).active v = true)
    (hmem : run.path k ∈ live.1.label v) :
    run.path (k + 1) ∈ (liveNextTree A live (word k)).label v ∨
      ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).BlockedByOlderSibling A v
        (run.path (k + 1)) ∨
      (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen A v := by
  classical
  rcases run_path_succ_stage3_dichotomy A run live.1
      (livePlan A live (word k)).stage2Plan hactive hmem with h3 | hblk
  · rcases mem_stage4_label_or_removedByGreen A
        (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A) h3 with h4 | hgreen
    · refine Or.inl ?_
      set t3 := ((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A with ht3
      have hnotgreen : ¬ t3.RemovedByGreen A v := by
        intro hg
        rw [stage4_removed_label A t3 hg] at h4
        simp at h4
      have hnotRem5 :
          ¬ (t3.stage4 A).RemovedByStage5 A (t3.greenRemovedNodes A) v := by
        rintro (hp | he)
        · exact hnotgreen ((mem_greenRemovedNodes A t3).mp hp)
        · rw [mem_emptyActiveNodes A (t3.stage4 A)] at he
          rw [he.2] at h4
          simp at h4
      have h5 :
          run.path (k + 1) ∈
            ((t3.stage4 A).stage5 A (t3.greenRemovedNodes A)).label v := by
        rw [stage5_keeps_unremoved_label A (t3.stage4 A)
          (t3.greenRemovedNodes A) hnotRem5]
        exact h4
      have hlabel :
          (liveNextTree A live (word k)).label v =
            ((t3.stage4 A).stage5 A (t3.greenRemovedNodes A)).label v := rfl
      rw [hlabel]
      exact h5
    · exact Or.inr (Or.inr hgreen)
  · exact Or.inr (Or.inl hblk)

/--
One-step trapping, phrased on consecutive run states.  The node `v` is a stable
entity across the transition (only its name may change), so the "stays" outcome
of `run_path_succ_trapping` lands directly in the *next* run state's label at the
same node `v`.  This is the per-step inductive step of the descent.
-/
theorem run_path_succ_trapping_run
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    {k : Nat} {live next : LiveState A} {v : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hactive : live.1.active v = true)
    (hmem : run.path k ∈ live.1.label v) :
    run.path (k + 1) ∈ next.1.label v ∨
      ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).BlockedByOlderSibling A v
        (run.path (k + 1)) ∨
      (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen A v := by
  have hstage1active : (live.1.stage1 A (word k)).active v = true := by
    simpa [stage1_active A live.1 (word k) v] using hactive
  have hnext : next.1 = liveNextTree A live (word k) :=
    automaton_run_live_nextTree A word hrun hrunNext
  rcases run_path_succ_trapping A run live hstage1active hmem with h | h | h
  · exact Or.inl (by rw [hnext]; exact h)
  · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr h)

/--
In a well-formed tree a node carrying any state is active (inactive nodes have
empty labels).  Re-derives `hactive` from "run state in `v`'s label", so the
trapping step iterates without separately threading activeness.
-/
theorem active_of_mem_label
    [DecidableEq A.State]
    (tree : CompactTreeData A) (htree : tree.WellFormed A)
    {v : Node A} {state : A.State} (hmem : state ∈ tree.label v) :
    tree.active v = true := by
  by_contra h
  obtain ⟨_, _, _, _, hinactive, _, _, _, _, _, _⟩ := htree
  have hfalse : tree.active v = false := by
    cases hv : tree.active v with
    | true => exact (h hv).elim
    | false => rfl
  rw [hinactive v hfalse] at hmem
  simp at hmem

/--
The run *settles at node* `v` with name `a`: from some time `N` the run state is
always in `v`'s label and `v`'s name is constantly `a` (paper proof 4's `v_j`
with eventually-constant name `a_j`).
-/
def RunSettlesAt [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v : Node A) (a : Nat) : Prop :=
  ∃ N : Nat, ∀ k : Nat, N ≤ k ->
    ∃ live : LiveState A, (automaton A).run word k = some live ∧
      run.path k ∈ live.1.label v ∧ (live.1.name v).val = a

/-- The run settles at name `a` if it settles at some node of name `a`. -/
def RunSettlesAtName [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (a : Nat) : Prop :=
  ∃ v : Node A, RunSettlesAt A run v a

/--
Node `v` *greens infinitely often* along the run: at infinitely many steps the
post-stage-(3) tree has `v` as a green node (`label = childLabelUnion`).  This is
"step 4 applied to `v` infinitely often" (the even/good event at `v`).
-/
def RunNodeGreensIO [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (v : Node A) : Prop :=
  ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
    ∃ live : LiveState A, (automaton A).run word k = some live ∧
      v ∈ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A

/-- Base of the descent: the run settles at the root, whose name is constantly `0`. -/
theorem runSettlesAtName_zero [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) :
    RunSettlesAtName A run 0 := by
  refine ⟨root A, 0, fun k _ => ?_⟩
  obtain ⟨live, hrun, hpath⟩ :=
    automaton_run_exists_live_root_label_of_runFrom A run k
  refine ⟨live, hrun, hpath, ?_⟩
  obtain ⟨_, hrootName, _, _, _, _, _, _, _, _, _⟩ := live.2
  simp [hrootName, rootName]

/-- Settling names are bounded by `card`: a settled node is active. -/
theorem runSettlesAtName_le_card [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {a : Nat}
    (hsettle : RunSettlesAtName A run a) :
    a ≤ Fintype.card A.State := by
  obtain ⟨v, N, hsettle⟩ := hsettle
  obtain ⟨live, _hrun, hpath, hname⟩ := hsettle N (le_refl N)
  have hactive : live.1.active v = true :=
    active_of_mem_label A live.1 live.2 hpath
  obtain ⟨_, _, _, _, _, hbound, _, _, _, _, _⟩ := live.2
  have hlt := hbound v hactive
  omega

/--
Descent assembly (paper proof 4): the forward direction follows from the single
descent step -- "from a settled name `a`, either the automaton accepts, or the
run settles at a strictly larger name".  Termination is the depth bound
(`bounded_descent_accepts` with bound `card`), the base case is the root
(`runSettlesAtName_zero`).  The hypothesis `step` is the remaining
construction-specific lemma.
-/
theorem automaton_accepts_of_runSettlesDescent [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (step : ∀ a : Nat, RunSettlesAtName A run a ->
        (automaton A).Accepts word ∨
          ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    (automaton A).Accepts word :=
  bounded_descent_accepts (Fintype.card A.State)
    (fun _a ha => runSettlesAtName_le_card A run ha) step 0
    (runSettlesAtName_zero A run)

/--
The descent step splits into two horns (paper proof 4): when the run settles at
`v`, either `v` greens infinitely often -- and then the automaton accepts (green
horn) -- or it does not, and then the run settles at a strictly larger name
(descent horn).  This is the pure classical case split; the two horns are the
remaining construction lemmas.
-/
theorem runSettlesDescent_step_of_horns [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (greenHorn : ∀ (v : Node A) (a : Nat),
        RunSettlesAt A run v a -> RunNodeGreensIO A run v ->
        (automaton A).Accepts word)
    (descendHorn : ∀ (v : Node A) (a : Nat),
        RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
        ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    ∀ a : Nat, RunSettlesAtName A run a ->
      (automaton A).Accepts word ∨
        ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a' := by
  classical
  rintro a ⟨v, hsettle⟩
  by_cases hg : RunNodeGreensIO A run v
  · exact Or.inl (greenHorn v a hsettle hg)
  · exact Or.inr (descendHorn v a hsettle hg)

/--
Forward direction reduced to the two descent horns: with the green horn (settled
green node ⟹ accept) and the descent horn (settled non-green ⟹ deeper settling),
an accepting NBW run is accepted by the DPW.  Combines the descent assembly with
the horn split.
-/
theorem automaton_accepts_of_descentHorns [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (greenHorn : ∀ (v : Node A) (a : Nat),
        RunSettlesAt A run v a -> RunNodeGreensIO A run v ->
        (automaton A).Accepts word)
    (descendHorn : ∀ (v : Node A) (a : Nat),
        RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
        ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    (automaton A).Accepts word :=
  automaton_accepts_of_runSettlesDescent A run
    (runSettlesDescent_step_of_horns A run greenHorn descendHorn)

/--
Forward direction reduced directly to the two construction horns for an accepting
NBW run.  This packages the `A.Accepts` witness before entering the
name-descent assembly, so the remaining Piterman proof obligations are exactly
the green horn and the descent horn for that accepting run.
-/
theorem automaton_accepts_of_accepts_of_descentHorns [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word)
    (greenHorn :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> RunNodeGreensIO A run v ->
          (automaton A).Accepts word)
    (descendHorn :
      ∀ (run : A.RunFrom A.initial word), run.Accepts ->
        ∀ (v : Node A) (a : Nat),
          RunSettlesAt A run v a -> ¬ RunNodeGreensIO A run v ->
          ∃ a' : Nat, a < a' ∧ RunSettlesAtName A run a') :
    (automaton A).Accepts word := by
  rcases haccepts with ⟨run, hrunAccepts⟩
  exact automaton_accepts_of_descentHorns A run
    (greenHorn run hrunAccepts) (descendHorn run hrunAccepts)

/--
Green-horn bookkeeping: if an accepting-run path has settled at node `v` with
constant dynamic name `a`, and `v` greens infinitely often, then the DPW
green-name register `f` is at most `a` infinitely often (one step after those
green events).  Minimality/e-register arguments are still separate; this lemma
isolates the direct consequence of `RunNodeGreensIO`.
-/
theorem runNodeGreensIO_frequently_f_le_settled_name [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hgreens : RunNodeGreensIO A run v) :
    ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      ∃ live : LiveState A,
        (automaton A).run word k = some live ∧ live.1.f.val ≤ a := by
  classical
  rcases hsettle with ⟨N, hsettle⟩
  intro n
  rcases hgreens (max n N) with ⟨j, hj, prev, hprev, hgreen⟩
  have hNj : N ≤ j := le_trans (le_max_right n N) hj
  have hnj : n ≤ j := le_trans (le_max_left n N) hj
  rcases hsettle j hNj with ⟨settledPrev, hsettledPrev, hmem, hname⟩
  have hprevEq : prev = settledPrev := by
    have hsome : some prev = some settledPrev := by
      rw [← hprev, hsettledPrev]
    exact Option.some.inj hsome
  subst settledPrev
  have hactivePrev : prev.1.active v = true :=
    active_of_mem_label A prev.1 prev.2 hmem
  have hnameBound : a < Fintype.card A.State := by
    rcases prev.2 with
      ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
        _hinactiveLabel, hbound, _hinjective, _hconsecutive, _hproper,
        _hchildSubset, _hsiblingDisjoint⟩
    have hvBound := hbound v hactivePrev
    omega
  rcases hsettle (j + 1) (by omega) with
    ⟨next, hnext, _hmemNext, _hnameNext⟩
  let t1 := prev.1.stage1 A (word j)
  let plan := (livePlan A prev (word j)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hactiveT1 : t1.active v = true := by
    simpa [t1, stage1_active A prev.1 (word j) v] using hactivePrev
  have hnameT1 : (t1.name v).val = a := by
    simpa [t1, stage1_name A prev.1 (word j) v] using hname
  have hnameT2 : (t2.name v).val = a := by
    rw [show t2.name v = t1.name v from
      stage2_preserves_active_node_name A t1 plan hactiveT1]
    exact hnameT1
  have hnameT3 : (t3.name v).val = a := by
    rw [show t3.name v = t2.name v from stage3_name A t2 v]
    exact hnameT2
  have hfMin :
      next.1.f.val = (t3.minBoundedNameOf A (t3.greenNodes A)).val := by
    have hnextTree : next.1 = liveNextTree A prev (word j) :=
      automaton_run_live_nextTree A word hprev hnext
    rw [hnextTree]
    simp [liveNextTree, transitionWithPlan, t1, plan, t2, t3,
      stage4_f_val, stage5_f_val, stage6_f_val]
  have hminLe :
      (t3.minBoundedNameOf A (t3.greenNodes A)).val ≤ (t3.name v).val :=
    minBoundedNameOf_le_of_mem A t3 (t3.greenNodes A)
      (by simpa [t1, plan, t2, t3] using hgreen)
      (by omega)
  refine ⟨j + 1, by omega, next, hnext, ?_⟩
  omega

/--
Green-horn parity event: if the accepting-run path has settled at node `v` with
constant name `a`, and `v` greens infinitely often, then those green events give
actual even DPW events (`f < e`) infinitely often, with `f ≤ a`.

The extra `f < e` follows from the stage-(6) converse
`automaton_run_live_stage3_same_name_e_gt`: settling says `v` keeps the same
name in the successor, so no deletion at or below `a` occurred.
-/
theorem runNodeGreensIO_frequently_f_lt_e_le_settled_name [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hgreens : RunNodeGreensIO A run v) :
    ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
      ∃ live : LiveState A,
        (automaton A).run word k = some live ∧
          live.1.f.val ≤ a ∧ live.1.f.val < live.1.e.val := by
  classical
  rcases hsettle with ⟨N, hsettle⟩
  intro n
  rcases hgreens (max n N) with ⟨j, hj, prev, hprev, hgreen⟩
  have hNj : N ≤ j := le_trans (le_max_right n N) hj
  have hnj : n ≤ j := le_trans (le_max_left n N) hj
  rcases hsettle j hNj with ⟨settledPrev, hsettledPrev, hmem, hname⟩
  have hprevEq : prev = settledPrev := by
    have hsome : some prev = some settledPrev := by
      rw [← hprev, hsettledPrev]
    exact Option.some.inj hsome
  subst settledPrev
  have hactivePrev : prev.1.active v = true :=
    active_of_mem_label A prev.1 prev.2 hmem
  have hnameBound : a < Fintype.card A.State := by
    rcases prev.2 with
      ⟨_hrootActive, _hrootName, _hrootParent, _hparentInvariant,
        _hinactiveLabel, hbound, _hinjective, _hconsecutive, _hproper,
        _hchildSubset, _hsiblingDisjoint⟩
    have hvBound := hbound v hactivePrev
    omega
  rcases hsettle (j + 1) (by omega) with
    ⟨next, hnext, hmemNext, hnameNext⟩
  let t1 := prev.1.stage1 A (word j)
  let plan := (livePlan A prev (word j)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hactiveT1 : t1.active v = true := by
    simpa [t1, stage1_active A prev.1 (word j) v] using hactivePrev
  have hnameT1 : (t1.name v).val = a := by
    simpa [t1, stage1_name A prev.1 (word j) v] using hname
  have hnameT2 : (t2.name v).val = a := by
    rw [show t2.name v = t1.name v from
      stage2_preserves_active_node_name A t1 plan hactiveT1]
    exact hnameT1
  have hnameT3 : (t3.name v).val = a := by
    rw [show t3.name v = t2.name v from stage3_name A t2 v]
    exact hnameT2
  have hfMin :
      next.1.f.val = (t3.minBoundedNameOf A (t3.greenNodes A)).val := by
    have hnextTree : next.1 = liveNextTree A prev (word j) :=
      automaton_run_live_nextTree A word hprev hnext
    rw [hnextTree]
    simp [liveNextTree, transitionWithPlan, t1, plan, t2, t3,
      stage4_f_val, stage5_f_val, stage6_f_val]
  have hminLe :
      (t3.minBoundedNameOf A (t3.greenNodes A)).val ≤ (t3.name v).val :=
    minBoundedNameOf_le_of_mem A t3 (t3.greenNodes A)
      (by simpa [t1, plan, t2, t3] using hgreen)
      (by omega)
  have hfLe : next.1.f.val ≤ a := by
    omega
  have hsameName :
      (next.1.name v).val = (t3.name v).val := by
    omega
  have heGtT3 :
      (t3.name v).val < next.1.e.val :=
    automaton_run_live_stage3_same_name_e_gt A word hprev hnext hmemNext
      (by simpa [t1, plan, t2, t3] using hsameName)
  have hfe : next.1.f.val < next.1.e.val := by
    omega
  refine ⟨j + 1, by omega, next, hnext, hfLe, hfe⟩

/--
Fixed even-priority extraction from the settled-green horn: among the
infinitely many even events supplied by
`runNodeGreensIO_frequently_f_lt_e_le_settled_name`, some fixed `f = m ≤ a`
recurs infinitely often, hence priority `2*m` is seen infinitely often.
-/
theorem runNodeGreensIO_even_prioritySeen_le_settled_name [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hgreens : RunNodeGreensIO A run v) :
    ∃ m : Nat, m ≤ a ∧
      (automaton A).PrioritySeenInfinitelyOften word (2 * m) := by
  classical
  have hfreq :=
    runNodeGreensIO_frequently_f_lt_e_le_settled_name A run hsettle hgreens
  have hfreqFiber :
      ∃ᶠ k in Filter.atTop,
        ∃ m ∈ Finset.range (a + 1),
          ∃ live : LiveState A, (automaton A).run word k = some live ∧
            live.1.f.val = m ∧ live.1.f.val < live.1.e.val := by
    refine (Filter.frequently_atTop).2 ?_
    intro n
    rcases hfreq n with ⟨k, hk, live, hrun, hfLe, hfe⟩
    refine ⟨k, hk, live.1.f.val, ?_, live, hrun, rfl, hfe⟩
    exact Finset.mem_range.mpr (by omega)
  rw [Finset.frequently_exists] at hfreqFiber
  rcases hfreqFiber with ⟨m, hmRange, hmFreq⟩
  have hmLe : m ≤ a := by
    exact Nat.le_of_lt_succ (Finset.mem_range.mp hmRange)
  have hfreqFixed :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A, (automaton A).run word k = some live ∧
          live.1.f.val < live.1.e.val ∧ live.1.f.val = m := by
    intro n
    rcases (Filter.frequently_atTop).1 hmFreq n with
      ⟨k, hk, live, hrun, hfm, hfe⟩
    exact ⟨k, hk, live, hrun, hfe, hfm⟩
  refine ⟨m, hmLe, ?_⟩
  intro n
  rcases hfreqFixed n with ⟨k, hk, live, hrun, hfe, hfm⟩
  refine ⟨k, hk, ?_⟩
  rw [hrun, automaton_priority_live]
  unfold priority
  rw [if_pos hfe, hfm]

/--
Green horn with the remaining minimality premise made explicit.  The construction
now supplies the recurrent even priority from settled greening; if no smaller
priority recurs, parity acceptance follows immediately.
-/
theorem automaton_accepts_of_runNodeGreensIO_no_smaller_than_settled_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hgreens : RunNodeGreensIO A run v)
    (hnoSmaller :
      ∀ q : Nat, q < 2 * a ->
        ¬ (automaton A).PrioritySeenInfinitelyOften word q) :
    (automaton A).Accepts word := by
  rcases runNodeGreensIO_even_prioritySeen_le_settled_name
      A run hsettle hgreens with
    ⟨m, hmLe, hmSeen⟩
  exact DetParityAutomaton.accepts_of_even_seen_of_no_smaller (automaton A) word
    ⟨m, rfl⟩ hmSeen
    (fun q hq =>
      hnoSmaller q (by omega))

/--
Eventual `f/e` lower bounds rule out smaller recurring priorities.  This is the
priority-level form of the paper's "no smaller names occur after the cutoff":
late green events have `f ≥ m`, and late delete events have `e > m`.
-/
theorem no_smaller_priorities_of_eventually_name_event_bounds
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {m : Nat}
    (hlive :
      ∀ k : Nat, ∃ live : LiveState A,
        (automaton A).run word k = some live)
    (hstable :
      ∃ N : Nat, ∀ k : Nat, N ≤ k ->
        ∀ live : LiveState A,
          (automaton A).run word k = some live ->
            (live.1.f.val < live.1.e.val -> m ≤ live.1.f.val) ∧
            (¬ live.1.f.val < live.1.e.val -> m < live.1.e.val)) :
    ∀ q : Nat, q < 2 * m ->
      ¬ (automaton A).PrioritySeenInfinitelyOften word q := by
  rcases hstable with ⟨N, hstable⟩
  intro q hq hseen
  rcases hseen N with ⟨k, hk, hkprio⟩
  rcases hlive k with ⟨live, hrun⟩
  have hprio : priority A live.1 = q := by
    simpa [hrun, automaton_priority_live] using hkprio
  rcases hstable k hk live hrun with ⟨hgreen, hdelete⟩
  by_cases hfe : live.1.f.val < live.1.e.val
  · have hmf : m ≤ live.1.f.val := hgreen hfe
    have hqeq : q = 2 * live.1.f.val := by
      rw [← hprio]
      simp [priority, hfe]
    omega
  · have hme : m < live.1.e.val := hdelete hfe
    cases he : live.1.e.val with
    | zero =>
        omega
    | succ pred =>
        have hnotLe : ¬ live.1.f.val ≤ pred := by
          intro hle
          exact hfe (by simpa [he] using Nat.lt_succ_of_le hle)
        have hqeq : q = 2 * pred + 1 := by
          rw [← hprio]
          simp [priority, hfe, he, hnotLe]
        omega

/--
Green horn under the checked stability premise used by the interval/minimality
machinery: if the run is always live, the node settles and greens infinitely
often, and all sufficiently late events are bounded below by the settled name,
then the DPW accepts.
-/
theorem automaton_accepts_of_runNodeGreensIO_eventually_name_event_bounds
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hlive :
      ∀ k : Nat, ∃ live : LiveState A,
        (automaton A).run word k = some live)
    (hsettle : RunSettlesAt A run v a)
    (hgreens : RunNodeGreensIO A run v)
    (hstable :
      ∃ N : Nat, ∀ k : Nat, N ≤ k ->
        ∀ live : LiveState A,
          (automaton A).run word k = some live ->
            (live.1.f.val < live.1.e.val -> a ≤ live.1.f.val) ∧
            (¬ live.1.f.val < live.1.e.val -> a < live.1.e.val)) :
    (automaton A).Accepts word :=
  automaton_accepts_of_runNodeGreensIO_no_smaller_than_settled_name
    A run hsettle hgreens
    (no_smaller_priorities_of_eventually_name_event_bounds A hlive hstable)

/--
Settling supplies the deletion half of the eventual stability condition:
after the settling cutoff, the successor state's `e` register is always strictly
above the settled name.  Otherwise stage-(6) would compact the settled node's
name downward, contradicting the next-time settled-name equality.
-/
theorem runSettles_eventually_next_e_gt_settled_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a) :
    ∃ N : Nat, ∀ k : Nat, N ≤ k ->
      ∀ live next : LiveState A,
        (automaton A).run word k = some live ->
          (automaton A).run word (k + 1) = some next ->
            a < next.1.e.val := by
  rcases hsettle with ⟨N, hsettle⟩
  refine ⟨N, ?_⟩
  intro k hk live next hrun hnext
  rcases hsettle k hk with
    ⟨settledLive, hsettledRun, hmem, hname⟩
  rcases hsettle (k + 1) (by omega) with
    ⟨settledNext, hsettledNextRun, hmemNext, hnameNext⟩
  have hliveEq : live = settledLive := by
    have hsome : some live = some settledLive := by
      rw [← hrun, hsettledRun]
    exact Option.some.inj hsome
  have hnextEq : next = settledNext := by
    have hsome : some next = some settledNext := by
      rw [← hnext, hsettledNextRun]
    exact Option.some.inj hsome
  subst settledLive
  subst settledNext
  have hactiveLive : live.1.active v = true :=
    active_of_mem_label A live.1 live.2 hmem
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hactiveT1 : t1.active v = true := by
    simpa [t1, stage1_active A live.1 (word k) v] using hactiveLive
  have hnameT1 : (t1.name v).val = a := by
    simpa [t1, stage1_name A live.1 (word k) v] using hname
  have hnameT2 : (t2.name v).val = a := by
    rw [show t2.name v = t1.name v from
      stage2_preserves_active_node_name A t1 plan hactiveT1]
    exact hnameT1
  have hnameT3 : (t3.name v).val = a := by
    rw [show t3.name v = t2.name v from stage3_name A t2 v]
    exact hnameT2
  have hsameName :
      (next.1.name v).val = (t3.name v).val := by
    omega
  have heGt :
      (t3.name v).val < next.1.e.val :=
    automaton_run_live_stage3_same_name_e_gt A word hrun hnext hmemNext
      (by simpa [t1, plan, t2, t3] using hsameName)
  omega

/--
First step of the descent horn: a node that does not green infinitely often is
eventually never green.  (`¬ RunNodeGreensIO` unfolded.)
-/
theorem exists_eventually_not_green_of_not_greensIO [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A}
    (hng : ¬ RunNodeGreensIO A run v) :
    ∃ N : Nat, ∀ k : Nat, N ≤ k -> ∀ live : LiveState A,
      (automaton A).run word k = some live ->
        v ∉ (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A := by
  unfold RunNodeGreensIO at hng
  push Not at hng
  exact hng

/--
Second step of the descent horn: from settling at `v` and `v` not greening
infinitely often, there is a time `N` past which simultaneously the run is in
`v`'s label with constant name `a` AND `v` is never green.  This is the regime in
which the run descends into a son.
-/
theorem exists_eventually_settled_not_green [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {v : Node A} {a : Nat}
    (hsettle : RunSettlesAt A run v a)
    (hng : ¬ RunNodeGreensIO A run v) :
    ∃ N : Nat, ∀ k : Nat, N ≤ k ->
      (∃ live : LiveState A, (automaton A).run word k = some live ∧
        run.path k ∈ live.1.label v ∧ (live.1.name v).val = a) ∧
      (∀ live : LiveState A, (automaton A).run word k = some live ->
        v ∉ (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A) := by
  obtain ⟨N0, hsettle⟩ := hsettle
  obtain ⟨N1, hng⟩ := exists_eventually_not_green_of_not_greensIO A run hng
  refine ⟨max N0 N1, fun k hk => ⟨hsettle k ?_, hng k ?_⟩⟩
  · exact le_trans (le_max_left _ _) hk
  · exact le_trans (le_max_right _ _) hk

/--
A state in a *proper descendant* `w` of `v` is covered by a child of `v`: take
the child of `v` on the path to `w`; its label contains `w`'s label.  This is the
nesting fact behind "the run stays covered by `v`'s sons" in the descent horn.
-/
theorem mem_childLabelUnion_of_mem_label_descendant [DecidableEq A.State]
    (tree : CompactTreeData A) (hwf : tree.WellFormed A)
    {v w : Node A} {state : A.State}
    (hactive : tree.active w = true)
    (hanc : tree.IsAncestorOrSelf A v w) (hne : v ≠ w)
    (hmem : state ∈ tree.label w) :
    state ∈ tree.childLabelUnion A v := by
  obtain ⟨_, _, hrootParent, hparentInv, _, _, _, _, _, hchildSubset, _⟩ := hwf
  obtain ⟨c, hc_child, hc_anc⟩ :=
    exists_child_of_isAncestorOrSelf_ne A tree hrootParent hparentInv hactive hanc hne
  have hsub : tree.label w ⊆ tree.label c :=
    label_subset_of_isAncestorOrSelf A tree hrootParent hparentInv hchildSubset
      hactive hc_anc
  rw [childLabelUnion, Finset.mem_biUnion]
  exact ⟨c, hc_child, hsub hmem⟩

/--
Child-coverage witness with name progress: if a state is covered by a child of
`v`, and `v` has name `a`, then some covering child has name strictly larger
than `a`.
-/
theorem childLabelUnion_witness_name_gt
    [DecidableEq A.State]
    (tree : CompactTreeData A) (hwf : tree.WellFormed A)
    {v : Node A} {state : A.State} {a : Nat}
    (hname : (tree.name v).val = a)
    (hcover : state ∈ tree.childLabelUnion A v) :
    ∃ child,
      child ∈ tree.children A v ∧
        state ∈ tree.label child ∧
        a < (tree.name child).val := by
  rw [childLabelUnion, Finset.mem_biUnion] at hcover
  rcases hcover with ⟨child, hchild, hstateChild⟩
  rw [children, Finset.mem_filter] at hchild
  obtain ⟨_, hchildActive, hchildNotRoot, hchildParent⟩ := hchild
  rcases hwf with
    ⟨_hrootActive, _hrootName, _hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have hnameLt :
      (tree.name v).val < (tree.name child).val := by
    have hp := (hparentInvariant child hchildActive hchildNotRoot).2
    simpa [hchildParent] using hp
  refine ⟨child, ?_, hstateChild, ?_⟩
  · rw [children, Finset.mem_filter]
    exact ⟨Finset.mem_univ child, hchildActive, hchildNotRoot, hchildParent⟩
  · omega

/--
Son-capture (the descent mechanism): if the run is in node `v` at step `k` (with
`v` active after stage (1)) and the next run state is accepting, then that next
state is captured into `v`'s freshly created child at stage (2).  The fresh child
is a son of `v` with a strictly larger name, so this is the entry into a deeper
node.
-/
theorem run_path_succ_mem_stage2_freshChild_label [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (live : LiveState A) {k : Nat} {v : Node A}
    (hactive : (live.1.stage1 A (word k)).active v = true)
    (hmem : run.path k ∈ live.1.label v)
    (haccepting : A.accepting (run.path (k + 1))) :
    run.path (k + 1) ∈
      ((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).label
        ((livePlan A live (word k)).stage2Plan.freshChild v) := by
  have hstage1 : run.path (k + 1) ∈ (live.1.stage1 A (word k)).label v :=
    run_path_succ_mem_stage1_label A run live.1 hmem
  have htrigger : v ∈ (live.1.stage1 A (word k)).stage2Triggers A :=
    mem_stage2Triggers_of_accepting_label A (live.1.stage1 A (word k)) hactive
      hstage1 haccepting
  rw [mem_stage2_freshChild_label A (live.1.stage1 A (word k))
    (livePlan A live (word k)).stage2Plan htrigger]
  exact ⟨hstage1, haccepting⟩

/--
Stage-(3) entry dichotomy for the accepting run path: after stage (2) captures
an accepting successor in `v`'s fresh child, either that successor survives stage
(3) and is already covered by a child of `v`, or the exact older-sibling blocker
for the fresh child is exposed.
-/
theorem run_path_succ_stage3_childLabelUnion_or_freshChild_blocked
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (live : LiveState A) {k : Nat} {v : Node A}
    (hactive : (live.1.stage1 A (word k)).active v = true)
    (hmem : run.path k ∈ live.1.label v)
    (haccepting : A.accepting (run.path (k + 1))) :
    run.path (k + 1) ∈
        (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).childLabelUnion A v ∨
      ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).BlockedByOlderSibling A
        ((livePlan A live (word k)).stage2Plan.freshChild v)
        (run.path (k + 1)) := by
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hstage1 : run.path (k + 1) ∈ t1.label v :=
    run_path_succ_mem_stage1_label A run live.1 hmem
  have htrigger : v ∈ t1.stage2Triggers A :=
    mem_stage2Triggers_of_accepting_label A t1 hactive hstage1 haccepting
  have hfreshT2 :
      run.path (k + 1) ∈ t2.label (plan.freshChild v) :=
    run_path_succ_mem_stage2_freshChild_label A run live hactive hmem
      haccepting
  by_cases hsurvives : run.path (k + 1) ∈ t3.label (plan.freshChild v)
  · have hrootActive_t1 : t1.active (root A) = true := by
      simpa [t1, stage1_active A live.1 (word k) (root A)] using live.2.1
    exact Or.inl
      (stage2_stage3_freshChild_label_subset_childLabelUnion A t1 plan
        hrootActive_t1 htrigger hsurvives)
  · exact Or.inr
      (stage3_blocked_of_mem_label_not_mem A t2
        (by simpa [t1, plan, t2] using hfreshT2)
        (by simpa [t1, plan, t2, t3] using hsurvives))

/--
Stage (3)→(6) survival (happy path): a state in `t2`'s label of node `w` that is
not blocked at stage (3) and whose node is not green-removed survives, with its
label unchanged, all the way to the final tree `t2.stage3.stage4.stage5.stage6`
(the tail of `transitionWithPlan`).  Composes the stage keep-lemmas; the two
escape-avoidance conditions stay explicit.
-/
theorem mem_stage3456_label_of_not_blocked_not_green [DecidableEq A.State]
    (t2 : CompactTreeData A) {w : Node A} {x : A.State}
    (hmem : x ∈ t2.label w)
    (hnotBlocked : ¬ t2.BlockedByOlderSibling A w x)
    (hnotGreen : ¬ (t2.stage3 A).RemovedByGreen A w) :
    x ∈ ((((t2.stage3 A).stage4 A).stage5 A
            ((t2.stage3 A).greenRemovedNodes A)).stage6 A
          ((t2.stage3 A).greenRemovedNodes A ∪
            ((t2.stage3 A).stage4 A).emptyActiveNodes A)).label w := by
  classical
  have h3 : x ∈ (t2.stage3 A).label w :=
    (mem_stage3_label A t2).mpr ⟨hmem, hnotBlocked⟩
  have h4 : x ∈ ((t2.stage3 A).stage4 A).label w := by
    rw [stage4_keeps_unremoved_label A (t2.stage3 A) hnotGreen]; exact h3
  have hnotRem5 :
      ¬ ((t2.stage3 A).stage4 A).RemovedByStage5 A
        ((t2.stage3 A).greenRemovedNodes A) w := by
    rintro (hp | he)
    · exact hnotGreen ((mem_greenRemovedNodes A (t2.stage3 A)).mp hp)
    · rw [mem_emptyActiveNodes A ((t2.stage3 A).stage4 A)] at he
      rw [he.2] at h4
      simp at h4
  have h5 :
      x ∈ (((t2.stage3 A).stage4 A).stage5 A
        ((t2.stage3 A).greenRemovedNodes A)).label w := by
    rw [stage5_keeps_unremoved_label A ((t2.stage3 A).stage4 A)
      ((t2.stage3 A).greenRemovedNodes A) hnotRem5]
    exact h4
  exact h5

/--
Stage (4)→(6) survival from a stage-(3) label: if a node is not green-removed,
then a state already in its stage-(3) label survives the remaining stages.
-/
theorem mem_stage456_label_of_not_green [DecidableEq A.State]
    (t3 : CompactTreeData A) {w : Node A} {x : A.State}
    (hmem : x ∈ t3.label w)
    (hnotGreen : ¬ t3.RemovedByGreen A w) :
    x ∈ (((t3.stage4 A).stage5 A (t3.greenRemovedNodes A)).stage6 A
          (t3.greenRemovedNodes A ∪
            (t3.stage4 A).emptyActiveNodes A)).label w := by
  classical
  have h4 : x ∈ (t3.stage4 A).label w := by
    rw [stage4_keeps_unremoved_label A t3 hnotGreen]
    exact hmem
  have hnotRem5 :
      ¬ (t3.stage4 A).RemovedByStage5 A (t3.greenRemovedNodes A) w := by
    rintro (hp | he)
    · exact hnotGreen ((mem_greenRemovedNodes A t3).mp hp)
    · rw [mem_emptyActiveNodes A (t3.stage4 A)] at he
      rw [he.2] at h4
      simp at h4
  have h5 :
      x ∈ ((t3.stage4 A).stage5 A (t3.greenRemovedNodes A)).label w := by
    rw [stage5_keeps_unremoved_label A (t3.stage4 A)
      (t3.greenRemovedNodes A) hnotRem5]
    exact h4
  exact h5

/--
A node that is green-removed at stage (3) is inactive in the final tree
`t2.stage3.stage4.stage5.stage6`: stage (4) deactivates it and stages (5)/(6)
keep it inactive.  This is the deactivation half (for `v`) of the green-removed
case of "covered persists".
-/
theorem stage3456_inactive_of_removedByGreen [DecidableEq A.State]
    (t2 : CompactTreeData A) {v : Node A}
    (hrem : (t2.stage3 A).RemovedByGreen A v) :
    ((((t2.stage3 A).stage4 A).stage5 A
        ((t2.stage3 A).greenRemovedNodes A)).stage6 A
      ((t2.stage3 A).greenRemovedNodes A ∪
        ((t2.stage3 A).stage4 A).emptyActiveNodes A)).active v = false := by
  have h4 : ((t2.stage3 A).stage4 A).active v = false :=
    stage4_removed_inactive A (t2.stage3 A) hrem
  have h5 :
      (((t2.stage3 A).stage4 A).stage5 A
        ((t2.stage3 A).greenRemovedNodes A)).active v = false := by
    by_contra hne
    have ht :
        (((t2.stage3 A).stage4 A).stage5 A
          ((t2.stage3 A).greenRemovedNodes A)).active v = true := by
      cases h : (((t2.stage3 A).stage4 A).stage5 A
          ((t2.stage3 A).greenRemovedNodes A)).active v
      · exact absurd h hne
      · rfl
    have hcc := (stage5_active_cases A ((t2.stage3 A).stage4 A)
      ((t2.stage3 A).greenRemovedNodes A) ht).1
    rw [h4] at hcc
    simp at hcc
  rw [stage6_active]
  exact h5

/--
Labels only shrink through stages (3)→(6): the final tree's label of a node is
contained in the stage-(2) tree's label.  Used to rule out the run "moving up" out
of `v`'s subtree in the blocked case (sibling labels are disjoint).
-/
theorem stage3456_label_subset [DecidableEq A.State]
    (t2 : CompactTreeData A) (node : Node A) :
    ((((t2.stage3 A).stage4 A).stage5 A
        ((t2.stage3 A).greenRemovedNodes A)).stage6 A
      ((t2.stage3 A).greenRemovedNodes A ∪
        ((t2.stage3 A).stage4 A).emptyActiveNodes A)).label node ⊆ t2.label node := by
  intro x hx
  rw [stage6_preserves_label] at hx
  exact stage3_label_subset A t2 node
    (stage4_label_subset A (t2.stage3 A) node
      (stage5_label_subset A ((t2.stage3 A).stage4 A)
        ((t2.stage3 A).greenRemovedNodes A) node hx))

/--
Enters a son (happy path): composing son-capture with stage-(3)→(6) survival, if
the run is in `v` at step `k`, the next state is accepting, it is not blocked at
stage (3), and `v`'s fresh child is not green-removed, then the next run state
lands in `v`'s fresh child in the next tree `d_{k+1}` -- i.e. the run descends one
level.
-/
theorem run_path_succ_mem_freshChild_label_of_accepting [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (live : LiveState A) {k : Nat} {v : Node A}
    (hactive : (live.1.stage1 A (word k)).active v = true)
    (hmem : run.path k ∈ live.1.label v)
    (haccepting : A.accepting (run.path (k + 1)))
    (hnotBlocked :
      ¬ ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).BlockedByOlderSibling A
          ((livePlan A live (word k)).stage2Plan.freshChild v)
          (run.path (k + 1)))
    (hnotGreen :
      ¬ (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen A
          ((livePlan A live (word k)).stage2Plan.freshChild v)) :
    run.path (k + 1) ∈ (liveNextTree A live (word k)).label
      ((livePlan A live (word k)).stage2Plan.freshChild v) := by
  have hcap :
      run.path (k + 1) ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).label
          ((livePlan A live (word k)).stage2Plan.freshChild v) :=
    run_path_succ_mem_stage2_freshChild_label A run live hactive hmem haccepting
  exact mem_stage3456_label_of_not_blocked_not_green A
    ((live.1.stage1 A (word k)).stage2 A (livePlan A live (word k)).stage2Plan)
    hcap hnotBlocked hnotGreen

/--
Happy-path son entry, phrased as coverage: if an accepting successor is captured
by `v`'s fresh child and that fresh child is neither blocked at stage (3) nor
green-removed, then in the next live tree the run state is covered by a child of
`v`.
-/
theorem run_path_succ_mem_childLabelUnion_of_accepting_freshChild_happy
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hactive : (live.1.stage1 A (word k)).active v = true)
    (hmem : run.path k ∈ live.1.label v)
    (haccepting : A.accepting (run.path (k + 1)))
    (hnotBlocked :
      ¬ ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).BlockedByOlderSibling A
          ((livePlan A live (word k)).stage2Plan.freshChild v)
          (run.path (k + 1)))
    (hnotGreen :
      ¬ (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen A
          ((livePlan A live (word k)).stage2Plan.freshChild v)) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v := by
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let fresh := plan.freshChild v
  have hnextTree : next.1 = liveNextTree A live (word k) :=
    automaton_run_live_nextTree A word hrun hrunNext
  have hfreshMem :
      run.path (k + 1) ∈ next.1.label fresh := by
    rw [hnextTree]
    simpa [fresh, plan] using
      run_path_succ_mem_freshChild_label_of_accepting A run live hactive hmem
        haccepting hnotBlocked hnotGreen
  have hfreshActive : next.1.active fresh = true :=
    active_of_mem_label A next.1 next.2 hfreshMem
  have htrigger : v ∈ t1.stage2Triggers A := by
    have hstage1 : run.path (k + 1) ∈ t1.label v :=
      run_path_succ_mem_stage1_label A run live.1 hmem
    exact mem_stage2Triggers_of_accepting_label A t1 hactive hstage1 haccepting
  have hrootActive_t1 : t1.active (root A) = true := by
    simpa [t1, stage1_active A live.1 (word k) (root A)] using live.2.1
  have hfreshNotRoot : fresh ≠ root A := by
    simpa [t1, plan, fresh] using
      stage2_freshChild_ne_root A t1 plan hrootActive_t1 htrigger
  have hparentNext : next.1.parent fresh = v := by
    rw [hnextTree]
    simp only [liveNextTree]
    change
      (((((t1.stage2 A plan).stage3 A).stage4 A).stage5 A
          (((t1.stage2 A plan).stage3 A).greenRemovedNodes A)).stage6 A
        (((t1.stage2 A plan).stage3 A).greenRemovedNodes A ∪
          ((((t1.stage2 A plan).stage3 A).stage4 A).emptyActiveNodes A))).parent
          fresh = v
    rw [stage6_parent, stage5_parent, stage4_parent, stage3_parent]
    simpa [t1, plan, fresh] using
      stage2_freshChild_parent A t1 plan htrigger
  have hchild : fresh ∈ next.1.children A v := by
    rw [children, Finset.mem_filter]
    exact ⟨Finset.mem_univ fresh, hfreshActive, hfreshNotRoot, hparentNext⟩
  rw [childLabelUnion, Finset.mem_biUnion]
  exact ⟨fresh, hchild, hfreshMem⟩

/--
The transition preserves the parent of an active node: stages (1),(3),(4),(5),(6)
keep `parent := tree.parent`, and stage (2) preserves active nodes' parents.  So a
child of `v` remains a child of `v` (its name may change, but its parent does
not).
-/
theorem transitionWithPlan_preserves_active_node_parent [DecidableEq A.State]
    (tree : CompactTreeData A) (letter : Alphabet)
    (plan : TransitionPlan A tree letter)
    {w : Node A} (hactive : tree.active w = true) :
    (tree.transitionWithPlan A letter plan).parent w = tree.parent w := by
  have hactive1 : (tree.stage1 A letter).active w = true := by
    simpa [stage1_active A tree letter w] using hactive
  have hstep :
      (tree.transitionWithPlan A letter plan).parent w =
        ((tree.stage1 A letter).stage2 A plan.stage2Plan).parent w := rfl
  rw [hstep, stage2_preserves_active_node_parent A (tree.stage1 A letter)
    plan.stage2Plan hactive1, stage1_parent]

/--
Stages (1)-(3) preserve an active node's parent (needed to locate a child of `v`
inside the intermediate tree `t3` for the green-removed case of persistence).
-/
theorem stage1_stage2_stage3_preserves_active_node_parent [DecidableEq A.State]
    (tree : CompactTreeData A) (letter : Alphabet)
    (plan : Stage2Plan A (tree.stage1 A letter))
    {w : Node A} (hactive : tree.active w = true) :
    (((tree.stage1 A letter).stage2 A plan).stage3 A).parent w = tree.parent w := by
  have hactive1 : (tree.stage1 A letter).active w = true := by
    simpa [stage1_active A tree letter w] using hactive
  rw [stage3_parent, stage2_preserves_active_node_parent A (tree.stage1 A letter)
    plan hactive1, stage1_parent]

/--
Covered persists, "stays" case: if at step `k` the run is in a child `w` of `v`,
and at step `k+1` the run stays in `w` (the trapping's stays outcome), then the
run is still covered by a child of `v` at step `k+1` -- because `w` persists as a
child of `v` (parent-preservation) and is active (it carries the run state).
-/
theorem run_path_succ_covered_of_stays [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (live next : LiveState A) {k : Nat} {v w : Node A}
    (hnext : next.1 = liveNextTree A live (word k))
    (hchild : w ∈ live.1.children A v)
    (hstays : run.path (k + 1) ∈ next.1.label w) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v := by
  rw [children, Finset.mem_filter] at hchild
  obtain ⟨_, hactive_k, hne, hparent_k⟩ := hchild
  have hactive_next : next.1.active w = true :=
    active_of_mem_label A next.1 next.2 hstays
  have hparent_next : next.1.parent w = v := by
    rw [hnext]
    simp only [liveNextTree]
    rw [transitionWithPlan_preserves_active_node_parent A live.1 (word k)
      (livePlan A live (word k)) hactive_k]
    exact hparent_k
  have hw : w ∈ next.1.children A v := by
    rw [children, Finset.mem_filter]
    exact ⟨Finset.mem_univ w, hactive_next, hne, hparent_next⟩
  rw [childLabelUnion, Finset.mem_biUnion]
  exact ⟨w, hw, hstays⟩

/--
Green-removed case of "covered persists" is impossible: if at step `k` the run is
in a child `w` of `v`, `v` is not green, and `w` is green-removed, then the
removing green node is a proper ancestor of `v`, so `v` is green-removed too,
hence inactive at `k+1` -- contradicting the run being in `v` at `k+1`.
-/
theorem run_path_succ_green_case_contradiction [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (live next : LiveState A) {k : Nat} {v w : Node A}
    (hnext : next.1 = liveNextTree A live (word k))
    (hchild : w ∈ live.1.children A v)
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hrem :
      (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen A w)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    False := by
  classical
  rw [children, Finset.mem_filter] at hchild
  obtain ⟨_, hw_active_k, hw_ne_root, hw_parent_k⟩ := hchild
  obtain ⟨_, _, _, hparentInv, _, _, _, _, _, _, _⟩ := live.2
  have hv_active_k : live.1.active v = true := by
    have hh := (hparentInv w hw_active_k hw_ne_root).1
    rwa [hw_parent_k] at hh
  have hv_active_t2 :
      ((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).active v = true :=
    stage2_preserves_active_node_active A (live.1.stage1 A (word k))
      (livePlan A live (word k)).stage2Plan
      (by simpa [stage1_active A live.1 (word k) v] using hv_active_k)
  have hparent_t3_w :
      (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).parent w = v := by
    rw [stage1_stage2_stage3_preserves_active_node_parent A live.1 (word k)
      (livePlan A live (word k)).stage2Plan hw_active_k]
    exact hw_parent_k
  obtain ⟨_, g, hg_green, c, hc_child, hc_anc⟩ := hrem
  have hc_ne_w : c ≠ w := by
    intro hcw
    subst hcw
    rw [children, Finset.mem_filter] at hc_child
    obtain ⟨_, _, _, hc_parent⟩ := hc_child
    have hgv : g = v := hc_parent.symm.trans hparent_t3_w
    exact hvNotGreen (hgv ▸ hg_green)
  have hc_anc_v :
      (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).IsAncestorOrSelf A c v := by
    have hh := isAncestorOrSelf_parent_of_ne A
      (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A) hc_anc hc_ne_w
    rwa [hparent_t3_w] at hh
  have hv_rem :
      (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen A v :=
    ⟨hv_active_t2, g, hg_green, c, hc_child, hc_anc_v⟩
  have hv_inactive : next.1.active v = false := by
    rw [hnext]
    exact stage3456_inactive_of_removedByGreen A
      ((live.1.stage1 A (word k)).stage2 A (livePlan A live (word k)).stage2Plan)
      hv_rem
  have hv_active_next : next.1.active v = true :=
    active_of_mem_label A next.1 next.2 hsettle
  rw [hv_inactive] at hv_active_next
  exact absurd hv_active_next (by simp)

/--
Stage-(3) child green-removal contradiction: the previous contradiction for an
old child of `v` also holds for any child of `v` in the stage-(3) tree,
including a freshly created child.  If such a child is removed by a green
ancestor while `v` itself is not green, then `v` is removed too, contradicting
the settled next-state membership in `v`.
-/
theorem run_path_succ_stage3_child_green_case_contradiction
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (live next : LiveState A) {k : Nat} {v w : Node A}
    (hnext : next.1 = liveNextTree A live (word k))
    (hchild :
      w ∈ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).children A v)
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hrem :
      (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen A w)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    False := by
  classical
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hchild' : w ∈ t3.children A v := by
    simpa [t1, plan, t2, t3] using hchild
  rw [children, Finset.mem_filter] at hchild'
  obtain ⟨_, hw_active_t3, hw_ne_root, hw_parent_t3⟩ := hchild'
  rcases live.2 with
    ⟨hrootActive, _hrootName, hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have hrootActive_t1 : t1.active (root A) = true := by
    simpa [t1, stage1_active A live.1 (word k) (root A)] using hrootActive
  have ht1RootParent : t1.parent (root A) = root A := by
    simpa [t1, stage1_parent A live.1 (word k) (root A)] using hrootParent
  have ht1ParentInvariant :
      ∀ node, t1.active node = true -> node ≠ root A ->
        t1.active (t1.parent node) = true ∧
          (t1.name (t1.parent node)).val < (t1.name node).val := by
    simpa [t1] using
      (stage1_preserves_parent_active_and_name_lt A live.1 (word k)
        hparentInvariant)
  have ht2RootParent : t2.parent (root A) = root A := by
    simpa [t1, t2] using
      (stage2_root_parent A t1 plan hrootActive_t1).trans ht1RootParent
  have ht3RootParent : t3.parent (root A) = root A := by
    simpa [t3, stage3_parent A t2 (root A)] using ht2RootParent
  have ht3ParentInvariant :
      ∀ node, t3.active node = true -> node ≠ root A ->
        t3.active (t3.parent node) = true ∧
          (t3.name (t3.parent node)).val < (t3.name node).val := by
    simpa [t1, plan, t2, t3] using
      (stage2_stage3_preserves_parent_active_and_name_lt A t1 plan
        ht1ParentInvariant)
  have hv_active_t3 : t3.active v = true := by
    have hh := (ht3ParentInvariant w hw_active_t3 hw_ne_root).1
    rwa [hw_parent_t3] at hh
  obtain ⟨_, g, hg_green, c, hc_child, hc_anc⟩ :=
    (by simpa [t1, plan, t2, t3] using hrem :
      t3.RemovedByGreen A w)
  have hc_ne_w : c ≠ w := by
    intro hcw
    subst hcw
    rw [children, Finset.mem_filter] at hc_child
    obtain ⟨_, _, _, hc_parent⟩ := hc_child
    have hgv : g = v := hc_parent.symm.trans hw_parent_t3
    exact hvNotGreen (by simpa [t1, plan, t2, t3, hgv] using hg_green)
  have hc_anc_v : t3.IsAncestorOrSelf A c v := by
    have hh := isAncestorOrSelf_parent_of_ne A t3 hc_anc hc_ne_w
    rwa [hw_parent_t3] at hh
  have hv_rem : t3.RemovedByGreen A v :=
    ⟨hv_active_t3, g, hg_green, c, hc_child, hc_anc_v⟩
  have hv_inactive : next.1.active v = false := by
    rw [hnext]
    exact stage3456_inactive_of_removedByGreen A t2
      (by simpa [t3] using hv_rem)
  have hv_active_next : next.1.active v = true :=
    active_of_mem_label A next.1 next.2 hsettle
  rw [hv_inactive] at hv_active_next
  exact absurd hv_active_next (by simp)

/--
Stage-(3) covered-successor persistence: if the next run state is already covered
by a child of `v` in the stage-(3) tree, `v` is not green, and the settled
membership keeps the run in `v` at the next live state, then that successor is
covered by a child of `v` in the next live tree.  This is the survival branch for
fresh-child entry in the descent horn.
-/
theorem run_path_succ_stage3_childLabelUnion_persists_of_not_green
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v)
    (hcover3 :
      run.path (k + 1) ∈
        (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).stage3 A).childLabelUnion A v) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v := by
  classical
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hnext : next.1 = liveNextTree A live (word k) :=
    automaton_run_live_nextTree A word hrun hrunNext
  rw [childLabelUnion, Finset.mem_biUnion] at hcover3
  rcases hcover3 with ⟨w, hchild3, hmemw3⟩
  have hchild3' : w ∈ t3.children A v := by
    simpa [t1, plan, t2, t3] using hchild3
  rw [children, Finset.mem_filter] at hchild3'
  obtain ⟨_, _hw_active_t3, hw_ne_root, hw_parent_t3⟩ := hchild3'
  by_cases hrem : t3.RemovedByGreen A w
  · exact (run_path_succ_stage3_child_green_case_contradiction
      A run live next hnext
      (by simpa [t1, plan, t2, t3] using hchild3)
      (by simpa [t1, plan, t2, t3] using hvNotGreen)
      (by simpa [t1, plan, t2, t3] using hrem)
      hsettle).elim
  · have hmemNextW : run.path (k + 1) ∈ next.1.label w := by
      rw [hnext]
      change run.path (k + 1) ∈
        (((t3.stage4 A).stage5 A (t3.greenRemovedNodes A)).stage6 A
          (t3.greenRemovedNodes A ∪
            (t3.stage4 A).emptyActiveNodes A)).label w
      exact mem_stage456_label_of_not_green A t3
        (by simpa [t1, plan, t2, t3] using hmemw3) hrem
    have hactiveNextW : next.1.active w = true :=
      active_of_mem_label A next.1 next.2 hmemNextW
    have hparentNextW : next.1.parent w = v := by
      rw [hnext]
      change
        (((t3.stage4 A).stage5 A (t3.greenRemovedNodes A)).stage6 A
          (t3.greenRemovedNodes A ∪
            (t3.stage4 A).emptyActiveNodes A)).parent w = v
      rw [stage6_parent, stage5_parent, stage4_parent]
      exact hw_parent_t3
    have hchildNext : w ∈ next.1.children A v := by
      rw [children, Finset.mem_filter]
      exact ⟨Finset.mem_univ w, hactiveNextW, hw_ne_root, hparentNextW⟩
    rw [childLabelUnion, Finset.mem_biUnion]
    exact ⟨w, hchildNext, hmemNextW⟩

/--
Accepting successor, settled non-green fork: if the run is settled in `v` across
the transition and the successor is accepting, then either the successor is
already covered by a child of `v` in the next live tree, or the only obstruction
is the stage-(3) older-sibling block of `v`'s fresh child.  This packages the
fresh-child stage-(3) dichotomy with the stage-(3)-coverage persistence lemma.
-/
theorem run_path_succ_accepting_childLabelUnion_or_freshChild_blocked_of_not_green
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hactive : (live.1.stage1 A (word k)).active v = true)
    (hmem : run.path k ∈ live.1.label v)
    (haccepting : A.accepting (run.path (k + 1)))
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v ∨
      ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).BlockedByOlderSibling A
        ((livePlan A live (word k)).stage2Plan.freshChild v)
        (run.path (k + 1)) := by
  rcases run_path_succ_stage3_childLabelUnion_or_freshChild_blocked
      A run live hactive hmem haccepting with hcover3 | hblocked
  · exact Or.inl
      (run_path_succ_stage3_childLabelUnion_persists_of_not_green
        A run hrun hrunNext hvNotGreen hsettle hcover3)
  · exact Or.inr hblocked

/--
Stage-(2) child branch persistence fork: if the next run state lies in a
stage-(2) child of `v`, then either it is covered by a child of `v` in the final
next tree, or that child is itself blocked at stage (3).  This is the local
iteration primitive for the stage-(2)-child-or-lower branch.
-/
theorem run_path_succ_stage2_child_or_blocked_persists_of_not_green
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v child : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hchild :
      child ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).children A v)
    (hmemChild :
      run.path (k + 1) ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).label child)
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v ∨
      ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).BlockedByOlderSibling A child
        (run.path (k + 1)) := by
  classical
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  by_cases hblocked : t2.BlockedByOlderSibling A child (run.path (k + 1))
  · exact Or.inr (by simpa [t1, plan, t2] using hblocked)
  · have hmem3 : run.path (k + 1) ∈ t3.label child :=
      (mem_stage3_label A t2).mpr
        ⟨by simpa [t1, plan, t2] using hmemChild, hblocked⟩
    have hchild3 : child ∈ t3.children A v := by
      simpa [t1, plan, t2, t3, stage3_children A t2 v] using hchild
    have hcover3 : run.path (k + 1) ∈ t3.childLabelUnion A v := by
      rw [childLabelUnion, Finset.mem_biUnion]
      exact ⟨child, hchild3, hmem3⟩
    exact Or.inl
      (run_path_succ_stage3_childLabelUnion_persists_of_not_green
        A run hrun hrunNext
        (by simpa [t1, plan, t2, t3] using hvNotGreen)
        hsettle
        (by simpa [t1, plan, t2, t3] using hcover3))

/--
Live stage-(2) blocker split for a child of `v`: a blocked child branch either
moves to an older child of `v` (strictly smaller child name) or has already
exposed a blocker whose name is below `v`.  This instantiates the generic
`blocked_child_same_parent_or_lower_name` on the stage-(2) tree.
-/
theorem run_path_succ_stage2_child_blocked_same_parent_or_lower_name
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {k : Nat} {live : LiveState A}
    {v child : Node A} {state : A.State}
    (hchild :
      child ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).children A v)
    (hblocked :
      ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).BlockedByOlderSibling A child
        state) :
    (∃ older,
        older ∈
          ((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).children A v ∧
          state ∈
            ((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).label older ∧
          (((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).name older).val <
            (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).name child).val) ∨
      (∃ lower,
        ((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).active lower = true ∧
          state ∈
            ((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).label lower ∧
          (((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).name lower).val <
            (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).name v).val) := by
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  rcases live.2 with
    ⟨hrootActive, _hrootName, hrootParent, hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  have hrootActive_t1 : t1.active (root A) = true := by
    simpa [t1, stage1_active A live.1 (word k) (root A)] using hrootActive
  have ht1RootParent : t1.parent (root A) = root A := by
    simpa [t1, stage1_parent A live.1 (word k) (root A)] using hrootParent
  have ht1ParentInvariant :
      ∀ node, t1.active node = true -> node ≠ root A ->
        t1.active (t1.parent node) = true ∧
          (t1.name (t1.parent node)).val < (t1.name node).val := by
    simpa [t1] using
      (stage1_preserves_parent_active_and_name_lt A live.1 (word k)
        hparentInvariant)
  have ht2RootParent : t2.parent (root A) = root A := by
    simpa [t1, t2] using
      (stage2_root_parent A t1 plan hrootActive_t1).trans ht1RootParent
  have ht2ParentInvariant :
      ∀ node, t2.active node = true -> node ≠ root A ->
        t2.active (t2.parent node) = true ∧
          (t2.name (t2.parent node)).val < (t2.name node).val := by
    simpa [t1, plan, t2] using
      (stage2_preserves_parent_active_and_name_lt A t1 plan
        ht1ParentInvariant)
  simpa [t1, plan, t2] using
    (blocked_child_same_parent_or_lower_name A t2 ht2RootParent
      ht2ParentInvariant
      (by simpa [t1, plan, t2] using hchild)
      (by simpa [t1, plan, t2] using hblocked))

/--
Settled blocker split for a stage-(2) child, ordinary/non-accepting form: if the
successor is still in the final label of `v`, then a blocker of a child of `v`
cannot come from an older sibling of `v` or an ancestor of `v`, because that
would also block the state from `v` at stage (3).  Hence the only possible
blocked branch is an older child of `v`, with strictly smaller child name.
-/
theorem run_path_succ_stage2_child_blocked_older_child_of_settled
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v child : Node A} {target : A.State}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hchild :
      child ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).children A v)
    (hblocked :
      ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).BlockedByOlderSibling A child
        target)
    (hsettle : target ∈ next.1.label v) :
    ∃ older,
      older ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).children A v ∧
        target ∈
          ((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).label older ∧
        (((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).name older).val <
          (((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).name child).val := by
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases hblocked with ⟨ancestor, older, hancestor, holder, hstate⟩
  have hchild' : child ∈ t2.children A v := by
    simpa [t1, plan, t2] using hchild
  rcases isAncestorOrSelf_child_cases A t2 hchild' hancestor with
    hsame | hancestorV
  · subst ancestor
    rw [children, Finset.mem_filter] at hchild'
    obtain ⟨_, _hchildActive, _hchildNotRoot, hchildParent⟩ := hchild'
    have holderParent : t2.parent older = v := by
      have hp := holder.2.2.2.2.1
      rw [hchildParent] at hp
      exact hp
    have holderNotRoot : older ≠ root A := by
      intro hroot
      subst older
      exact holder.2.2.1 (by
        rcases live.2 with
          ⟨hrootActive, _hrootName, hrootParent, _hparentInvariant,
            _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
            _hchildSubset, _hsiblingDisjoint⟩
        have hrootActive_t1 : t1.active (root A) = true := by
          simpa [t1, stage1_active A live.1 (word k) (root A)] using
            hrootActive
        have ht1RootParent : t1.parent (root A) = root A := by
          simpa [t1, stage1_parent A live.1 (word k) (root A)] using
            hrootParent
        simpa [t1, t2] using
          (stage2_root_parent A t1 plan hrootActive_t1).trans ht1RootParent)
    have holderChild : older ∈ t2.children A v := by
      rw [children, Finset.mem_filter]
      exact ⟨Finset.mem_univ older, holder.1, holderNotRoot, holderParent⟩
    exact ⟨older,
      by simpa [t1, plan, t2] using holderChild,
      by simpa [t1, plan, t2] using hstate,
      by simpa [t1, plan, t2] using olderSibling_name_lt A t2 holder⟩
  · have hblockedV : t2.BlockedByOlderSibling A v target :=
      ⟨ancestor, older, hancestorV, holder, hstate⟩
    have hstage3V : target ∈ t3.label v := by
      have hsubset :=
        automaton_run_live_next_label_subset_stage3 A word hrun hrunNext
          (node := v)
      exact hsubset hsettle
    have hnotBlockedV : ¬ t2.BlockedByOlderSibling A v target :=
      (mem_stage3_label A t2).mp hstage3V |>.2
    exact False.elim (hnotBlockedV hblockedV)

/--
Finite ordinary stage-(2) child iteration in the settled regime: from any
stage-(2) child of `v` containing the successor state, repeated blocking can
only move to older children of `v` with strictly smaller child name.  Thus the
state eventually persists to final child coverage of `v`.
-/
theorem run_path_succ_stage2_child_eventually_persists_of_settled
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v child : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hchild :
      child ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).children A v)
    (hmemChild :
      run.path (k + 1) ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).label child)
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v := by
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let target := run.path (k + 1)
  let P : Nat -> Prop := fun n =>
    ∀ child : Node A,
      (t2.name child).val = n ->
        child ∈ t2.children A v ->
          target ∈ t2.label child ->
            target ∈ next.1.childLabelUnion A v
  have hmain : ∀ n, P n := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
        intro c hcName hcChild hcMem
        rcases
            run_path_succ_stage2_child_or_blocked_persists_of_not_green
              A run hrun hrunNext
              (by simpa [t1, plan, t2] using hcChild)
              (by simpa [target, t1, plan, t2] using hcMem)
              (by simpa [t1, plan, t2] using hvNotGreen)
              hsettle with
          hcovered | hblocked
        · exact hcovered
        · rcases
            run_path_succ_stage2_child_blocked_older_child_of_settled
              A run hrun hrunNext
              (by simpa [t1, plan, t2] using hcChild)
              (by simpa [target, t1, plan, t2] using hblocked)
              (by simpa [target] using hsettle) with
            ⟨older, holderChild, holderMem, holderLt⟩
          have holderLtN : (t2.name older).val < n := by
            have holderLt' : (t2.name older).val < (t2.name c).val := by
              simpa [t1, plan, t2] using holderLt
            omega
          exact ih (t2.name older).val holderLtN older rfl
            (by simpa [t1, plan, t2] using holderChild)
            (by simpa [target, t1, plan, t2] using holderMem)
  have hresult := hmain (t2.name child).val child rfl
    (by simpa [t1, plan, t2] using hchild)
    (by simpa [target, t1, plan, t2] using hmemChild)
  simpa [target, t1, plan, t2] using hresult

/--
Direct paper son-entry step in the settled non-green regime.  If the accepting
run is already settled in `v` across this transition and `v` is not green in the
stage-(3) tree, then the accepting successor is covered by a child of `v` in the
next live tree.  The proof starts from `v`'s fresh child and uses the existing
finite older-sibling iteration; settledness rules out the lower-source escape.
-/
theorem run_path_succ_accepting_childLabelUnion_of_settled_not_green
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hactive : (live.1.stage1 A (word k)).active v = true)
    (hmem : run.path k ∈ live.1.label v)
    (haccepting : A.accepting (run.path (k + 1)))
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v := by
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let fresh := plan.freshChild v
  have hstage1 : run.path (k + 1) ∈ t1.label v :=
    run_path_succ_mem_stage1_label A run live.1 hmem
  have htrigger : v ∈ t1.stage2Triggers A :=
    mem_stage2Triggers_of_accepting_label A t1 hactive hstage1 haccepting
  have hrootActiveT1 : t1.active (root A) = true := by
    simpa [t1, stage1_active A live.1 (word k) (root A)] using live.2.1
  have hfreshChild : fresh ∈ t2.children A v := by
    simpa [t1, plan, t2, fresh] using
      stage2_freshChild_mem_children A t1 plan hrootActiveT1 htrigger
  have hmemFresh : run.path (k + 1) ∈ t2.label fresh := by
    simpa [t1, plan, t2, fresh] using
      run_path_succ_mem_stage2_freshChild_label A run live hactive hmem
        haccepting
  exact
    run_path_succ_stage2_child_eventually_persists_of_settled
      A run hrun hrunNext hfreshChild hmemFresh
      (by simpa [t1, plan, t2] using hvNotGreen) hsettle

/--
Final names never exceed the corresponding stage-(2) name for a node whose
final label is nonempty.  Stages (3)--(5) preserve names, and stage (6) only
compacts names downward.
-/
theorem automaton_run_live_next_name_val_le_stage2_of_next_label
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live next : LiveState A}
    {node : Node A} {target : A.State}
    (hrun : (automaton A).run word n = some live)
    (hrunNext : (automaton A).run word (n + 1) = some next)
    (hmem : target ∈ next.1.label node) :
    ((next.1.name node).val ≤
      (((live.1.stage1 A (word n)).stage2 A
        (livePlan A live (word n)).stage2Plan).name node).val) := by
  let t1 := live.1.stage1 A (word n)
  let plan := (livePlan A live (word n)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  let t4 := t3.stage4 A
  let stage4Removed := t3.greenRemovedNodes A
  let t5 := t4.stage5 A stage4Removed
  let stage5Removed := stage4Removed ∪ t4.emptyActiveNodes A
  have hnextTree : next.1 = liveNextTree A live (word n) :=
    automaton_run_live_nextTree A word hrun hrunNext
  have hmemFinal :
      target ∈ (t5.stage6 A stage5Removed).label node := by
    rw [hnextTree] at hmem
    simpa [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed] using hmem
  have hlabelT5 : t5.label node ≠ ∅ := by
    intro hempty
    rw [stage6_preserves_label A t5 stage5Removed node, hempty] at hmemFinal
    simp at hmemFinal
  have hnameT5 : (t5.name node).val = (t2.name node).val := by
    rw [show t5.name node = t4.name node from
      stage5_name A t4 stage4Removed node]
    rw [show t4.name node = t3.name node from stage4_name A t3 node]
    rw [show t3.name node = t2.name node from stage3_name A t2 node]
  have hnameNext :
      next.1.name node = (t5.stage6 A stage5Removed).name node := by
    rw [hnextTree]
    simp [liveNextTree, transitionWithPlan, t1, plan, t2, t3, t4,
      stage4Removed, t5, stage5Removed]
  have hcompact :
      ((t5.stage6 A stage5Removed).name node).val ≤ (t5.name node).val := by
    rw [stage6_nonempty_name A t5 stage5Removed hlabelT5]
    exact compactedName_le_oldName A t5 stage5Removed node
  have hcompactT2 :
      ((t5.stage6 A stage5Removed).name node).val ≤ (t2.name node).val := by
    rwa [hnameT5] at hcompact
  rw [hnameNext]
  simpa [t1, plan, t2] using hcompactT2

/--
Witness form of the ordinary stage-(2) child fork: if the child is not blocked,
the same child survives to the next tree, and its final name is no larger than
its stage-(2) name.
-/
theorem run_path_succ_stage2_child_or_blocked_persists_witness_of_not_green
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v child : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hchild :
      child ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).children A v)
    (hmemChild :
      run.path (k + 1) ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).label child)
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    (∃ survivor,
      survivor ∈ next.1.children A v ∧
        run.path (k + 1) ∈ next.1.label survivor ∧
        (next.1.name survivor).val ≤
          (((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).name child).val) ∨
      ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).BlockedByOlderSibling A child
        (run.path (k + 1)) := by
  classical
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  have hnext : next.1 = liveNextTree A live (word k) :=
    automaton_run_live_nextTree A word hrun hrunNext
  by_cases hblocked : t2.BlockedByOlderSibling A child (run.path (k + 1))
  · exact Or.inr (by simpa [t1, plan, t2] using hblocked)
  · have hmem3 : run.path (k + 1) ∈ t3.label child :=
      (mem_stage3_label A t2).mpr
        ⟨by simpa [t1, plan, t2] using hmemChild, hblocked⟩
    have hchild3 : child ∈ t3.children A v := by
      simpa [t1, plan, t2, t3, stage3_children A t2 v] using hchild
    rw [children, Finset.mem_filter] at hchild3
    obtain ⟨_, _hactive3, hneRoot, hparent3⟩ := hchild3
    by_cases hrem : t3.RemovedByGreen A child
    · exact False.elim
        (run_path_succ_stage3_child_green_case_contradiction
          A run live next hnext
          (by
            rw [children, Finset.mem_filter]
            exact ⟨Finset.mem_univ child, _hactive3, hneRoot, hparent3⟩)
          (by simpa [t1, plan, t2, t3] using hvNotGreen)
          (by simpa [t1, plan, t2, t3] using hrem)
          hsettle)
    · have hmemNext : run.path (k + 1) ∈ next.1.label child := by
        rw [hnext]
        change run.path (k + 1) ∈
          (((t3.stage4 A).stage5 A (t3.greenRemovedNodes A)).stage6 A
            (t3.greenRemovedNodes A ∪
              (t3.stage4 A).emptyActiveNodes A)).label child
        exact mem_stage456_label_of_not_green A t3 hmem3 hrem
      have hactiveNext : next.1.active child = true :=
        active_of_mem_label A next.1 next.2 hmemNext
      have hparentNext : next.1.parent child = v := by
        rw [hnext]
        change
          (((t3.stage4 A).stage5 A (t3.greenRemovedNodes A)).stage6 A
            (t3.greenRemovedNodes A ∪
              (t3.stage4 A).emptyActiveNodes A)).parent child = v
        rw [stage6_parent, stage5_parent, stage4_parent]
        exact hparent3
      have hchildNext : child ∈ next.1.children A v := by
        rw [children, Finset.mem_filter]
        exact ⟨Finset.mem_univ child, hactiveNext, hneRoot, hparentNext⟩
      have hnameLe :
          (next.1.name child).val ≤ (t2.name child).val := by
        exact automaton_run_live_next_name_val_le_stage2_of_next_label
          A word hrun hrunNext hmemNext
      exact Or.inl ⟨child, hchildNext, hmemNext,
        by simpa [t1, plan, t2] using hnameLe⟩

/--
Witness-strengthened finite ordinary stage-(2) child iteration.  The returned
final child has name bounded by the starting stage-(2) child name.
-/
theorem run_path_succ_stage2_child_eventually_persists_witness_of_settled
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v child : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hchild :
      child ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).children A v)
    (hmemChild :
      run.path (k + 1) ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).label child)
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    ∃ survivor,
      survivor ∈ next.1.children A v ∧
        run.path (k + 1) ∈ next.1.label survivor ∧
        (next.1.name survivor).val ≤
          (((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).name child).val := by
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let target := run.path (k + 1)
  let P : Nat -> Prop := fun n =>
    ∀ child : Node A,
      (t2.name child).val = n ->
        child ∈ t2.children A v ->
          target ∈ t2.label child ->
            ∃ survivor,
              survivor ∈ next.1.children A v ∧
                target ∈ next.1.label survivor ∧
                (next.1.name survivor).val ≤ n
  have hmain : ∀ n, P n := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
        intro c hcName hcChild hcMem
        rcases
            run_path_succ_stage2_child_or_blocked_persists_witness_of_not_green
              A run hrun hrunNext
              (by simpa [t1, plan, t2] using hcChild)
              (by simpa [target, t1, plan, t2] using hcMem)
              (by simpa [t1, plan, t2] using hvNotGreen)
              hsettle with
          hsurvives | hblocked
        · rcases hsurvives with ⟨survivor, hchildNext, hmemNext, hnameLe⟩
          refine ⟨survivor, hchildNext, hmemNext, ?_⟩
          have hnameLe' :
              (next.1.name survivor).val ≤ (t2.name c).val := by
            simpa [t1, plan, t2] using hnameLe
          omega
        · rcases
            run_path_succ_stage2_child_blocked_older_child_of_settled
              A run hrun hrunNext
              (by simpa [t1, plan, t2] using hcChild)
              (by simpa [target, t1, plan, t2] using hblocked)
              (by simpa [target] using hsettle) with
            ⟨older, holderChild, holderMem, holderLt⟩
          have holderLtN : (t2.name older).val < n := by
            have holderLt' : (t2.name older).val < (t2.name c).val := by
              simpa [t1, plan, t2] using holderLt
            omega
          rcases ih (t2.name older).val holderLtN older rfl
              (by simpa [t1, plan, t2] using holderChild)
              (by simpa [target, t1, plan, t2] using holderMem) with
            ⟨survivor, hchildNext, hmemNext, hnameLe⟩
          exact ⟨survivor, hchildNext, hmemNext, by omega⟩
  rcases hmain (t2.name child).val child rfl
      (by simpa [t1, plan, t2] using hchild)
      (by simpa [target, t1, plan, t2] using hmemChild) with
    ⟨survivor, hchildNext, hmemNext, hnameLe⟩
  exact ⟨survivor, hchildNext, hmemNext,
    by simpa [target, t1, plan, t2] using hnameLe⟩

/--
Descent-shaped live blocker split for a stage-(2) child: if an accepting target
is blocked out of a child of `v`, then either the same target is in an older
stage-(2) child of `v` (strictly smaller child name), or a live source event with
name strictly below `v` has already been exposed.
-/
theorem run_path_succ_stage2_child_blocked_older_child_or_lower_source
    [DecidableEq A.State]
    {word : OmegaWord Alphabet} {k : Nat} {live : LiveState A}
    {v child : Node A} {target : A.State}
    (haccepting : A.accepting target)
    (hchild :
      child ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).children A v)
    (hblocked :
      ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).BlockedByOlderSibling A child
        target) :
    (∃ older,
        older ∈
          ((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).children A v ∧
          target ∈
            ((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).label older ∧
          (((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).name older).val <
            (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).name child).val) ∨
      (∃ sourceNode sourceState,
        live.1.active sourceNode = true ∧
          sourceState ∈ live.1.label sourceNode ∧
          SegmentVisitsAccepting A word k 1 sourceState target ∧
          (live.1.name sourceNode).val <
            (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).name v).val) := by
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  rcases
      run_path_succ_stage2_child_blocked_same_parent_or_lower_name
        A (word := word) (k := k) (live := live)
        (v := v) (child := child) (state := target)
        hchild hblocked with
    holder | hlower
  · exact Or.inl holder
  · rcases hlower with ⟨lower, hlowerActive, hlowerState, hlowerName⟩
    rcases stage1_stage2_active_label_segment_from_source_name_le
        A live.1 word plan
        (by simpa [t1, plan, t2] using hlowerActive)
        (by simpa [t1, plan, t2] using hlowerState) with
      ⟨sourceNode, sourceState, hsourceActive, hsourceState, hsegment,
        hsourceNameLeLower⟩
    exact Or.inr ⟨sourceNode, sourceState,
      by simpa [stage1] using hsourceActive, hsourceState,
      segmentVisitsAccepting_of_segment_accepting_target A word hsegment
        haccepting,
      by
        have hsourceNameLeLower' :
            (live.1.name sourceNode).val ≤ (t2.name lower).val := by
          simpa [t1, plan, t2] using hsourceNameLeLower
        have hlowerName' :
            (t2.name lower).val < (t2.name v).val := by
          simpa [t1, plan, t2] using hlowerName
        have hlt :
            (live.1.name sourceNode).val < (t2.name v).val := by
          omega
        simpa [t1, plan, t2] using hlt⟩

/--
Composed stage-(2) child branch: an accepting target in a stage-(2) child of
`v` either persists to final child coverage, moves left to an older stage-(2)
child of `v`, or exposes a live lower-name source event.  This is the local
finite-iteration step used to discharge the child/blocker loop.
-/
theorem run_path_succ_stage2_child_persists_or_older_child_or_lower_source
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v child : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (haccepting : A.accepting (run.path (k + 1)))
    (hchild :
      child ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).children A v)
    (hmemChild :
      run.path (k + 1) ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).label child)
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v ∨
      (∃ older,
        older ∈
          ((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).children A v ∧
          run.path (k + 1) ∈
            ((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).label older ∧
          (((live.1.stage1 A (word k)).stage2 A
            (livePlan A live (word k)).stage2Plan).name older).val <
            (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).name child).val) ∨
      (∃ sourceNode sourceState,
        live.1.active sourceNode = true ∧
          sourceState ∈ live.1.label sourceNode ∧
          SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) ∧
          (live.1.name sourceNode).val <
            (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).name v).val) := by
  rcases
      run_path_succ_stage2_child_or_blocked_persists_of_not_green
        A run hrun hrunNext hchild hmemChild hvNotGreen hsettle with
    hcovered | hblocked
  · exact Or.inl hcovered
  · rcases
        run_path_succ_stage2_child_blocked_older_child_or_lower_source
          A (word := word) (k := k) (live := live)
          (v := v) (child := child) haccepting hchild hblocked with
      holder | hlower
    · exact Or.inr (Or.inl holder)
    · exact Or.inr (Or.inr hlower)

/--
Finite iteration of the stage-(2) child branch: starting from any stage-(2) child
of `v` that contains the accepting target, repeated blocking can only move to
older children of strictly smaller name finitely many times.  Therefore the
branch either reaches final child coverage or exposes a lower-name source event.
-/
theorem run_path_succ_stage2_child_eventually_persists_or_lower_source
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v child : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (haccepting : A.accepting (run.path (k + 1)))
    (hchild :
      child ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).children A v)
    (hmemChild :
      run.path (k + 1) ∈
        ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).label child)
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v ∨
      ∃ sourceNode sourceState,
        live.1.active sourceNode = true ∧
          sourceState ∈ live.1.label sourceNode ∧
          SegmentVisitsAccepting A word k 1 sourceState (run.path (k + 1)) ∧
          (live.1.name sourceNode).val <
            (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).name v).val := by
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let target := run.path (k + 1)
  let P : Nat -> Prop := fun n =>
    ∀ child : Node A,
      (t2.name child).val = n ->
        child ∈ t2.children A v ->
          target ∈ t2.label child ->
            target ∈ next.1.childLabelUnion A v ∨
              ∃ sourceNode sourceState,
                live.1.active sourceNode = true ∧
                  sourceState ∈ live.1.label sourceNode ∧
                  SegmentVisitsAccepting A word k 1 sourceState target ∧
                  (live.1.name sourceNode).val < (t2.name v).val
  have hmain : ∀ n, P n := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
        intro c hcName hcChild hcMem
        rcases
            run_path_succ_stage2_child_persists_or_older_child_or_lower_source
              A run hrun hrunNext haccepting
              (by simpa [t1, plan, t2] using hcChild)
              (by simpa [target, t1, plan, t2] using hcMem)
              (by simpa [t1, plan, t2] using hvNotGreen)
              hsettle with
          hcovered | holderOrLower
        · exact Or.inl hcovered
        · rcases holderOrLower with holder | hlower
          · rcases holder with ⟨older, holderChild, holderMem, holderLt⟩
            have holderLtN : (t2.name older).val < n := by
              have holderLt' : (t2.name older).val < (t2.name c).val := by
                simpa [t1, plan, t2] using holderLt
              omega
            exact ih (t2.name older).val holderLtN older rfl
              (by simpa [t1, plan, t2] using holderChild)
              (by simpa [target, t1, plan, t2] using holderMem)
          · exact Or.inr (by simpa [target, t1, plan, t2] using hlower)
  have hresult := hmain (t2.name child).val child rfl
    (by simpa [t1, plan, t2] using hchild)
    (by simpa [target, t1, plan, t2] using hmemChild)
  simpa [target, t1, plan, t2] using hresult

/--
Covered persists, assembled from the trapping: if the run is in a child `w` of
`v` at step `k` and `v` is not green, then at `k+1` the run is still covered by a
child of `v` -- the "stays" case keeps it in `w`, the "green-removed" case is
impossible (settling), and the "blocked" case is supplied by `hblocked` (routing
to an older sibling, still a child of `v`).
-/
theorem run_path_succ_covered_persists_of_blocked [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) {k : Nat} {live next : LiveState A}
    {v w : Node A}
    (hrun : (automaton A).run word k = some live)
    (hrunNext : (automaton A).run word (k + 1) = some next)
    (hchild : w ∈ live.1.children A v)
    (hmemw : run.path k ∈ live.1.label w)
    (hvNotGreen :
      v ∉ (((live.1.stage1 A (word k)).stage2 A
        (livePlan A live (word k)).stage2Plan).stage3 A).greenNodes A)
    (hsettle : run.path (k + 1) ∈ next.1.label v)
    (hblocked :
      ((live.1.stage1 A (word k)).stage2 A
          (livePlan A live (word k)).stage2Plan).BlockedByOlderSibling A w
          (run.path (k + 1)) ->
        run.path (k + 1) ∈ next.1.childLabelUnion A v) :
    run.path (k + 1) ∈ next.1.childLabelUnion A v := by
  have hnext : next.1 = liveNextTree A live (word k) :=
    automaton_run_live_nextTree A word hrun hrunNext
  have hw_active : live.1.active w = true := by
    have h := hchild
    rw [children, Finset.mem_filter] at h
    exact h.2.1
  rcases run_path_succ_trapping_run A run hrun hrunNext hw_active hmemw with
    hstays | hblk | hgreen
  · exact run_path_succ_covered_of_stays A run live next hnext hchild hstays
  · exact hblocked hblk
  · exact (run_path_succ_green_case_contradiction A run live next hnext hchild
      hvNotGreen hgreen hsettle).elim

theorem automaton_run_live_root_label_segmentCover
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} {live next : LiveState A}
    (hrun : (automaton A).run word n = some live)
    (hrunNext : (automaton A).run word (n + 1) = some next) :
    SegmentCover A word n 1
      (live.1.label (root A)) (next.1.label (root A)) := by
  intro target htarget
  rcases live.2 with
    ⟨hrootActive, _hrootName, _hrootParent, _hparentInvariant,
      _hinactiveLabel, _hbound, _hinjective, _hconsecutive, _hproper,
      _hchildSubset, _hsiblingDisjoint⟩
  rcases automaton_run_live_active_label_segment_from_same_node A word
      hrun hrunNext hrootActive htarget with
    ⟨source, hsource, hsegment⟩
  exact ⟨source, hsource, hsegment⟩

theorem automaton_run_interval_root_label_segmentCover
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {start length : Nat}
    (lives : Nat -> LiveState A)
    (hrun :
      ∀ i : Nat, i ≤ length ->
        (automaton A).run word (start + i) = some (lives i)) :
    SegmentCover A word start length
      ((lives 0).1.label (root A)) ((lives length).1.label (root A)) := by
  induction length with
  | zero =>
      intro target htarget
      refine ⟨target, ?_, ?_⟩
      · simpa using htarget
      · simpa using segment_zero A word start target
  | succ length ih =>
      have hprefix :
          SegmentCover A word start length
            ((lives 0).1.label (root A)) ((lives length).1.label (root A)) :=
        ih (fun i hi => hrun i (Nat.le_trans hi (Nat.le_succ _)))
      have hstep :
          SegmentCover A word (start + length) 1
            ((lives length).1.label (root A))
            ((lives (length + 1)).1.label (root A)) := by
        apply automaton_run_live_root_label_segmentCover A word
        · exact hrun length (Nat.le_succ _)
        · simpa [Nat.add_assoc] using hrun (length + 1) (Nat.le_refl _)
      simpa [Nat.add_assoc] using segmentCover_append A word hprefix hstep

theorem automaton_run_frequently_accepting_root_label_of_runFrom
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (haccepting : run.Accepts) :
    ∀ n : Nat,
      ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            run.path k ∈ live.1.label (root A) ∧
              A.accepting (run.path k) := by
  intro n
  rcases haccepting n with ⟨k, hk, hkAccepting⟩
  rcases automaton_run_exists_live_root_label_of_runFrom A run k with
    ⟨live, hrun, hpath⟩
  exact ⟨k, hk, live, hrun, hpath, hkAccepting⟩

theorem automaton_run_frequently_accepting_root_label_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    ∀ n : Nat,
      ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            ∃ state, state ∈ live.1.label (root A) ∧ A.accepting state := by
  rcases haccepts with ⟨run, haccepting⟩
  intro n
  rcases automaton_run_frequently_accepting_root_label_of_runFrom
      A run haccepting n with
    ⟨k, hk, live, hrun, hpath, hkAccepting⟩
  exact ⟨k, hk, live, hrun, run.path k, hpath, hkAccepting⟩

theorem automaton_run_accepting_root_label_frontier_of_runFrom
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    {k : Nat} {live : LiveState A}
    (hrun : (automaton A).run word k = some live)
    (hpath : run.path k ∈ live.1.label (root A))
    (haccepting : A.accepting (run.path k)) :
    ∃ frontier,
      live.1.active frontier = true ∧
        live.1.IsAncestorOrSelf A (root A) frontier ∧
          run.path k ∈ live.1.label frontier ∧
            run.path k ∉ live.1.childLabelUnion A frontier ∧
              A.accepting (run.path k) := by
  rcases live_exists_root_label_frontier A live hpath with
    ⟨frontier, hfrontierActive, hancestor, hfrontierState,
      hfrontierPrivate⟩
  exact ⟨frontier, hfrontierActive, hancestor, hfrontierState,
    hfrontierPrivate, haccepting⟩

theorem automaton_run_frequently_accepting_frontier_of_runFrom
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word)
    (haccepting : run.Accepts) :
    ∀ n : Nat,
      ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            ∃ frontier,
              live.1.active frontier = true ∧
                live.1.IsAncestorOrSelf A (root A) frontier ∧
                  run.path k ∈ live.1.label frontier ∧
                    run.path k ∉ live.1.childLabelUnion A frontier ∧
                      A.accepting (run.path k) := by
  intro n
  rcases automaton_run_frequently_accepting_root_label_of_runFrom
      A run haccepting n with
    ⟨k, hk, live, hrun, hpath, hkAccepting⟩
  rcases automaton_run_accepting_root_label_frontier_of_runFrom
      A run hrun hpath hkAccepting with
    ⟨frontier, hfrontierActive, hancestor, hfrontierState,
      hfrontierPrivate, hfrontierAccepting⟩
  exact ⟨k, hk, live, hrun, frontier, hfrontierActive, hancestor,
    hfrontierState, hfrontierPrivate, hfrontierAccepting⟩

theorem automaton_run_frequently_accepting_frontier_of_accepts
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (haccepts : A.Accepts word) :
    ∀ n : Nat,
      ∃ k : Nat, n ≤ k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            ∃ frontier state,
              live.1.active frontier = true ∧
                live.1.IsAncestorOrSelf A (root A) frontier ∧
                  state ∈ live.1.label frontier ∧
                    state ∉ live.1.childLabelUnion A frontier ∧
                      A.accepting state := by
  rcases haccepts with ⟨run, haccepting⟩
  intro n
  rcases automaton_run_frequently_accepting_frontier_of_runFrom
      A run haccepting n with
    ⟨k, hk, live, hrun, frontier, hfrontierActive, hancestor,
      hfrontierState, hfrontierPrivate, hfrontierAccepting⟩
  exact ⟨k, hk, live, hrun, frontier, run.path k, hfrontierActive,
    hancestor, hfrontierState, hfrontierPrivate, hfrontierAccepting⟩

