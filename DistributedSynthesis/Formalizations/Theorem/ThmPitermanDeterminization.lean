      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionChildGreenEvent A run sourceNode child
          sourceName sourceState target k) :
    (automaton A).Accepts word :=
  automaton_accepts_of_settled_childUnionChild_childGreensIO
    A run hrunAccepts hsettle hsourceLt
    (by
      intro n
      rcases hfreq n with ⟨k, hnk, hgreenEvent⟩
      rcases hgreenEvent with ⟨hchildEvent, hgreenPayload⟩
      exact ⟨k, hnk, hchildEvent, hgreenPayload⟩)

/--
If the fixed child is green-removed cofinally, then some green ancestor of that
child fires cofinally.  Since the child is on the path to the settled node `v`,
those greens are recurrent green ancestors of `v`, and the ancestor-green horn
accepts.
-/
theorem automaton_accepts_of_settled_childUnionChild_removedByGreenIO
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v sourceNode child : Node A} {a sourceName : Nat}
    {sourceState target : A.State}
    (hsettle : RunSettlesAt A run v a)
    (hsourceLt : sourceName ∈ Finset.range a)
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionChildRemovedByGreenEvent A run
          sourceNode child sourceName sourceState target k) :
    (automaton A).Accepts word := by
  have hsettleFull := hsettle
  rcases hsettle with ⟨N, hsettleAt⟩
  refine automaton_accepts_of_accepting_greenAncestorIO A run hrunAccepts
    hsettleFull ?_
  intro n
  rcases hfreq (max n N) with ⟨k, hk, hremovedEvent⟩
  have hnk : n ≤ k := le_trans (le_max_left n N) hk
  have hNk : N ≤ k := le_trans (le_max_right n N) hk
  rcases hremovedEvent with ⟨hchildEvent, liveRemoved, hrunRemoved, hremovedRaw⟩
  rcases hchildEvent with ⟨hchildUnionEvent, liveChild, hrunChild, hchildRaw⟩
  rcases hchildUnionEvent with ⟨hbase, liveCU, hrunCU, _hchildUnion⟩
  rcases hbase with
    ⟨live, next, hrun, hrunNext, htarget, _haccepting, hsourceActive,
      _hsourceState, _hsegment, hsourceName⟩
  have hliveCUEq : liveCU = live := by
    have hsome : some liveCU = some live := by
      rw [← hrunCU, hrun]
    exact Option.some.inj hsome
  subst liveCU
  have hliveChildEq : liveChild = live := by
    have hsome : some liveChild = some live := by
      rw [← hrunChild, hrun]
    exact Option.some.inj hsome
  subst liveChild
  have hliveRemovedEq : liveRemoved = live := by
    have hsome : some liveRemoved = some live := by
      rw [← hrunRemoved, hrun]
    exact Option.some.inj hsome
  subst liveRemoved
  rcases hsettleAt k hNk with
    ⟨settledLive, hsettledRun, hmemV, hnameV⟩
  have hsettledLiveEq : settledLive = live := by
    have hsome : some settledLive = some live := by
      rw [← hsettledRun, hrun]
    exact Option.some.inj hsome
  subst settledLive
  rcases hsettleAt (k + 1) (by omega) with
    ⟨settledNext, hsettledNextRun, hmemNextV, _hnameNextV⟩
  have hsettledNextEq : settledNext = next := by
    have hsome : some settledNext = some next := by
      rw [← hsettledNextRun, hrunNext]
    exact Option.some.inj hsome
  subst settledNext
  let t1 := live.1.stage1 A (word k)
  let plan := (livePlan A live (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases hchildRaw with ⟨hchild, htargetChild⟩
  have hvActive : live.1.active v = true :=
    active_of_mem_label A live.1 live.2 hmemV
  have hsourceLtNat : sourceName < a := Finset.mem_range.mp hsourceLt
  have hchildAncestorV :
      t3.IsAncestorOrSelf A child v :=
    stage3_child_isAncestorOrSelf_of_settled_childUnionChild
      A run hrun hrunNext htarget hsourceActive hsourceName
      (by simpa [t1, plan, t2, t3] using hchild)
      (by simpa [t1, plan, t2, t3] using htargetChild)
      hvActive hnameV hmemNextV hsourceLtNat
  have hremoved : t3.RemovedByGreen A child := by
    simpa [t1, plan, t2, t3] using hremovedRaw
  rcases hremoved with
    ⟨_hchildActive, green, hgreen, removedChild, hremovedChild,
      hremovedChildAncestor⟩
  have hgreenAncestorRemovedChild :
      t3.IsAncestorOrSelf A green removedChild :=
    isAncestorOrSelf_of_child A t3 (isAncestorOrSelf_refl A t3 green)
      hremovedChild
  have hgreenAncestorChild :
      t3.IsAncestorOrSelf A green child :=
    isAncestorOrSelf_trans A t3 hgreenAncestorRemovedChild
      hremovedChildAncestor
  have hgreenAncestorV :
      t3.IsAncestorOrSelf A green v :=
    isAncestorOrSelf_trans A t3 hgreenAncestorChild hchildAncestorV
  exact ⟨k, hnk, live, green, hrun,
    by simpa [t1, plan, t2, t3] using hgreen, hgreenAncestorV⟩

/--
Source-removal branch for the positive same-child/ancestor kernel.  If the fixed
lower source is green-removed cofinally in the stage-(3) trees where the fixed
child is already known to be an ancestor of the settled node `v`, then the
removing green node is itself a stage-(3) ancestor of `v` cofinally.  The
green-ancestor horn therefore accepts.
-/
theorem automaton_accepts_of_settled_positiveSameChildAncestor_sourceRemovedByGreenIO
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v sourceNode child : Node A} {a sourceName : Nat}
    {sourceState target uncovered : A.State}
    (hsettle : RunSettlesAt A run v a)
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorEvent
          A run v sourceNode child sourceName sourceState target uncovered k ∧
        ∃ live : LiveState A,
          (automaton A).run word k = some live ∧
            (((live.1.stage1 A (word k)).stage2 A
              (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen A
              sourceNode) :
    (automaton A).Accepts word := by
  refine automaton_accepts_of_accepting_greenAncestorIO A run hrunAccepts
    hsettle ?_
  intro n
  rcases hfreq n with
    ⟨k, hnk, hancestorEvent, liveRemoved, hrunRemoved, hremovedRaw⟩
  rcases hancestorEvent with
    ⟨hsameChildEvent, liveAncestor, hrunAncestor, hchildAncestorRaw⟩
  rcases hsameChildEvent with
    ⟨hmeasureEvent, _nextSame, _hrunNextSame, _hchildNext, _htargetSame⟩
  rcases hmeasureEvent with
    ⟨hcoveredEvent, _liveMeasure, _nextMeasure, _hrunMeasure,
      _hrunNextMeasure, _huncoveredLabel, _huncoveredPrivate,
      _htargetCovered⟩
  rcases hcoveredEvent with
    ⟨hsurvivesEvent, _nextCovered, _hrunNextCovered, _htargetCoveredNext⟩
  rcases hsurvivesEvent with ⟨hpositiveChildEvent, _hchildSurvives⟩
  rcases hpositiveChildEvent with ⟨_hpositiveWitness, hchildEvent⟩
  rcases hchildEvent with ⟨_hchildUnionEvent, liveChild, hrunChild, hchildPayload⟩
  have hliveChildEq : liveChild = liveAncestor := by
    have hsome : some liveChild = some liveAncestor := by
      rw [← hrunChild, hrunAncestor]
    exact Option.some.inj hsome
  subst liveChild
  have hliveRemovedEq : liveRemoved = liveAncestor := by
    have hsome : some liveRemoved = some liveAncestor := by
      rw [← hrunRemoved, hrunAncestor]
    exact Option.some.inj hsome
  subst liveRemoved
  let t1 := liveAncestor.1.stage1 A (word k)
  let plan := (livePlan A liveAncestor (word k)).stage2Plan
  let t2 := t1.stage2 A plan
  let t3 := t2.stage3 A
  rcases hchildPayload with ⟨hchildT3, _htargetChild⟩
  have hremoved : t3.RemovedByGreen A sourceNode := by
    simpa [t1, plan, t2, t3] using hremovedRaw
  rcases hremoved with
    ⟨_hsourceActive, green, hgreen, removedChild, hremovedChild,
      hremovedChildAncestorSource⟩
  have hgreenAncestorRemovedChild :
      t3.IsAncestorOrSelf A green removedChild :=
    isAncestorOrSelf_of_child A t3 (isAncestorOrSelf_refl A t3 green)
      hremovedChild
  have hgreenAncestorSource :
      t3.IsAncestorOrSelf A green sourceNode :=
    isAncestorOrSelf_trans A t3 hgreenAncestorRemovedChild
      hremovedChildAncestorSource
  have hsourceAncestorChild :
      t3.IsAncestorOrSelf A sourceNode child :=
    isAncestorOrSelf_of_child A t3
      (isAncestorOrSelf_refl A t3 sourceNode)
      (by simpa [t1, plan, t2, t3] using hchildT3)
  have hgreenAncestorChild :
      t3.IsAncestorOrSelf A green child :=
    isAncestorOrSelf_trans A t3 hgreenAncestorSource hsourceAncestorChild
  have hchildAncestorV :
      t3.IsAncestorOrSelf A child v := by
    simpa [t1, plan, t2, t3] using hchildAncestorRaw
  have hgreenAncestorV :
      t3.IsAncestorOrSelf A green v :=
    isAncestorOrSelf_trans A t3 hgreenAncestorChild hchildAncestorV
  exact ⟨k, hnk, liveAncestor, green, hrunAncestor,
    by simpa [t1, plan, t2, t3] using hgreen, hgreenAncestorV⟩

/--
Cofinal one-step source-persistence split for the positive same-child/ancestor
kernel.  From a cofinal branch either green-removal of the fixed lower source
already makes the DPW accept, or a cofinal subbranch preserves the uncovered
witness in the successor source label.
-/
theorem automaton_accepts_or_frequently_settled_positiveSameChildAncestor_sourceUncoveredSurvives
    [DecidableEq A.State]
    {word : OmegaWord Alphabet}
    (run : A.RunFrom A.initial word) (hrunAccepts : run.Accepts)
    {v sourceNode child : Node A} {a sourceName : Nat}
    {sourceState target uncovered : A.State}
    (hsettle : RunSettlesAt A run v a)
    (hfreq :
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorEvent
          A run v sourceNode child sourceName sourceState target uncovered k) :
    (automaton A).Accepts word ∨
      ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent
          A run v sourceNode child sourceName sourceState target uncovered k := by
  classical
  have hsplit :
      (∀ n : Nat, ∃ k : Nat, n ≤ k ∧
        (SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorEvent
            A run v sourceNode child sourceName sourceState target uncovered k ∧
          ∃ live : LiveState A,
            (automaton A).run word k = some live ∧
              (((live.1.stage1 A (word k)).stage2 A
                (livePlan A live (word k)).stage2Plan).stage3 A).RemovedByGreen
                A sourceNode)) ∨
        ∀ n : Nat, ∃ k : Nat, n ≤ k ∧
          SettledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorSourceUncoveredSurvivesEvent
            A run v sourceNode child sourceName sourceState target uncovered k := by
    apply frequently_left_or_right_of_frequently_or
    intro n
    rcases hfreq n with ⟨k, hnk, hevent⟩
    exact ⟨k, hnk,
      settledLowerSourceStage3ChildUnionPositiveWitnessChildSurvivesCoveredMeasureSameChildAncestorEvent_sourceRemovedByGreen_or_uncovered_survives
        A run hevent⟩
  rcases hsplit with hremoved | hsurvives
  · exact Or.inl
