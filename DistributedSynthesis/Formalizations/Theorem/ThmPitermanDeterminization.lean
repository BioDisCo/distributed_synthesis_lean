theorem live_green_stage2Trigger_accepting_segment_from_green_of_fresh_survives
    [DecidableEq A.State]
    (word : OmegaWord Alphabet)
    {n : Nat} (live : LiveState A)
    {green : Node A}
    (htrigger :
